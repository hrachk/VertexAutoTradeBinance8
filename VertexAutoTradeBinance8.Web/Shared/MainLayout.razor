@inherits LayoutComponentBase
@implements IDisposable
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Shared.Ui
@inject ProtectionUiService Protection
@inject EngineStateService EngineState

<PageTitle>Vertex Console</PageTitle>

<div class="v-shell">

    @*  Шапка — приборный рельс. Слева идентификация, справа три факта,
        которые оператор должен видеть всегда: жив ли движок, сколько денег
        на счету и есть ли позиция без стопа. Последний факт важнее остальных,
        поэтому он единственный меняет цвет. *@
    <header class="v-header">
        <button class="v-header__burger" @onclick="ToggleNav" aria-label="Открыть меню">☰</button>

        <div class="v-header__brand">
            <img src="images/vertexailogo.png" class="v-header__logo" alt="" />
            <span class="v-header__name">Vertex Console</span>
        </div>

        <div class="v-header__rail">
            <VBadge Tone="@EngineTone" Dot="true">@EngineLabel</VBadge>

            @if (Balance > 0)
            {
                <VBadge>@Balance.ToString("N2") USDT</VBadge>
            }

            @if (Snapshot.Unprotected > 0)
            {
                <VBadge Tone="VBadge.BadgeTone.Bad" Dot="true">
                    @Snapshot.Unprotected без стопа
                </VBadge>
            }
            else if (Snapshot.Total > 0)
            {
                <VBadge Tone="VBadge.BadgeTone.Ok">@Snapshot.Total под защитой</VBadge>
            }
        </div>
    </header>

    <div class="v-body">
        <aside class="v-sidebar @(NavOpen ? "v-sidebar--open" : null)">
            <NavMenu Unprotected="Snapshot.Unprotected" OnNavigate="CloseNav" />
        </aside>

        @if (NavOpen)
        {
            <div class="v-backdrop" @onclick="CloseNav"></div>
        }

        <main class="v-main">
            @Body
        </main>
    </div>
</div>

@code {
    private IDisposable? _sub;
    private bool NavOpen;

    private ProtectionSummary Snapshot => Protection.Snapshot;

    private decimal Balance;
    private string EngineLabel = "Движок: нет данных";
    private VBadge.BadgeTone EngineTone = VBadge.BadgeTone.Warn;

    protected override void OnInitialized()
    {
        _sub = Protection.Subscribe(OnChanged);
        ReadEngineState();
    }

    private void OnChanged()
    {
        ReadEngineState();
        InvokeAsync(StateHasChanged);
    }

    private void ReadEngineState()
    {
        var s = EngineState.Load();

        if (s == null)
        {
            EngineLabel = "Движок: нет данных";
            EngineTone = VBadge.BadgeTone.Warn;
            return;
        }

        Balance = s.BalanceUsdt;

        // Файл состояния старше двух минут — движок, скорее всего, не пишет
        var age = DateTime.UtcNow - s.LastUpdate;

        if (age > TimeSpan.FromMinutes(2))
        {
            EngineLabel = $"Движок молчит {FormatAge(age)}";
            EngineTone = VBadge.BadgeTone.Bad;
        }
        else
        {
            EngineLabel = string.IsNullOrWhiteSpace(s.Status) ? "Движок работает" : $"Движок: {s.Status}";
            EngineTone = VBadge.BadgeTone.Ok;
        }
    }

    private static string FormatAge(TimeSpan age) =>
        age.TotalHours >= 1 ? $"{(int)age.TotalHours} ч" : $"{(int)age.TotalMinutes} мин";

    private void ToggleNav() => NavOpen = !NavOpen;
    private void CloseNav() => NavOpen = false;

    public void Dispose() => _sub?.Dispose();
}
