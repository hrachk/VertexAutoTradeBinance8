@using VertexAutoTradeBinance8.Web.Confs
@inherits LayoutComponentBase
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject AuthSessionService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle> AUTOTRADE AI</PageTitle>

<header class="vertex-header">
    <div class="vertex-left">
        <button class="menu-toggle" @onclick="ToggleMobileMenu" aria-label="Menu">
            <span class="burger"></span>
        </button>

        <!-- Signature hexagon logo mark -->
        <div class="vx-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="13,1 24,7 24,19 13,25 2,19 2,7" stroke="#06b6d4" stroke-width="1.4" fill="rgba(6,182,212,.05)"/>
                <polygon points="13,5.5 20.5,9.5 20.5,16.5 13,20.5 5.5,16.5 5.5,9.5" stroke="#22d3ee" stroke-width=".9" fill="rgba(6,182,212,.09)"/>
                <circle cx="13" cy="13" r="2.5" fill="#06b6d4" opacity=".95"/>
                <line x1="13" y1="5.5" x2="13" y2="20.5" stroke="#06b6d4" stroke-width=".4" opacity=".35"/>
                <line x1="5.5" y1="9.5" x2="20.5" y2="16.5" stroke="#06b6d4" stroke-width=".4" opacity=".35"/>
                <line x1="20.5" y1="9.5" x2="5.5" y2="16.5" stroke="#06b6d4" stroke-width=".4" opacity=".35"/>
            </svg>
        </div>

        <div class="vertex-brand">
            <div class="vertex-title">VERTEX</div>
            <div class="vertex-subtitle">AutoTrade AI</div>
        </div>
    </div>

    <div class="vertex-right">
        <!-- User menu dropdown -->
        @if (Auth.IsAuthenticated)
        {
            <div class="vx-user-menu @(_userMenuOpen ? "open" : "")">
                <button class="vx-user-btn" @onclick="ToggleUserMenu" @onclick:stopPropagation="true">
                    <span class="vx-dot @(_demoModeEnabled ? "vx-dot-yel" : "vx-dot-grn") vx-dot-pulse"></span>
                    <span class="vx-user-name">@Auth.CurrentClient!.DisplayName</span>
                    <span class="vx-user-plan @(_demoModeEnabled ? "plan-demo" : "plan-live")">@(_demoModeEnabled ? "DEMO" : "LIVE")</span>
                    <svg class="vx-user-caret @(_userMenuOpen ? "open" : "")" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 4-4"/></svg>
                </button>
                @if (_userMenuOpen)
                {
                    <div class="vx-user-dropdown" @onclick:stopPropagation="true">
                        <div class="vx-user-dd-header">
                            <div class="vx-user-dd-name">@Auth.CurrentClient!.DisplayName</div>
                            <div class="vx-user-dd-email">@Auth.CurrentClient!.Email</div>
                            <div style="display:flex;align-items:center;gap:6px;margin-top:6px;">
                                <span class="vx-dd-mode-badge @(_demoModeEnabled ? "badge-demo" : "badge-live")">
                                    @(_demoModeEnabled ? "🟡 Demo Mode" : "🟢 Live Mode")
                                </span>
                            </div>
                            <div class="vx-user-dd-id" style="margin-top:3px">ID: @Auth.CurrentClient!.Id</div>
                        </div>
                        <div class="vx-user-dd-sep"></div>
                        <a class="vx-user-dd-item" href="/dashboard">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="7" r="3"/><path d="M3 17c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg>
                            Мой кабинет
                        </a>
                        <a class="vx-user-dd-item" href="/dashboard/settings">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="10" r="3"/><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.5 3.5l1.4 1.4M15.1 15.1l1.4 1.4M3.5 16.5l1.4-1.4M15.1 4.9l1.4-1.4"/></svg>
                            Binance API ключи
                            @if (!Auth.CurrentClient!.IsLiveEnabled)
                            {
                                <span class="vx-dd-badge">Не настроено</span>
                            }
                            else
                            {
                                <span class="vx-dd-badge vx-dd-badge-ok">✓ Live</span>
                            }
                        </a>
                        <div class="vx-user-dd-sep"></div>
                        <a class="vx-user-dd-item" href="/market">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 14l4-4 4 3 4-6 4 3"/></svg>
                            Market
                        </a>
                        <a class="vx-user-dd-item" href="/market/multi">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="7" height="7" rx="1"/><rect x="11" y="2" width="7" height="7" rx="1"/><rect x="2" y="11" width="7" height="7" rx="1"/><rect x="11" y="11" width="7" height="7" rx="1"/></svg>
                            Multi-Chart
                        </a>
                        <a class="vx-user-dd-item" href="/statistics">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 16V8M7 16V4M12 16V10M17 16V6"/></svg>
                            Статистика
                        </a>
                        <a class="vx-user-dd-item" href="/settings">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="10" r="3"/><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.5 3.5l1.4 1.4M15.1 15.1l1.4 1.4M3.5 16.5l1.4-1.4M15.1 4.9l1.4-1.4"/></svg>
                            Настройки
                        </a>
                        <div class="vx-user-dd-sep"></div>
                        <button class="vx-user-dd-item vx-dd-logout" @onclick="DoLogout">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 15l4-5-4-5M17 10H7"/><path d="M7 3H4a1 1 0 00-1 1v12a1 1 0 001 1h3"/></svg>
                            Выйти
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <a class="vx-login-topbtn" href="/login">Войти</a>
        }

        <!-- LIVE / DEMO toggle -->
        <button class="vx-chip @(_demoModeEnabled ? "vx-chip-demo" : "vx-chip-live")"
                @onclick="ToggleDemoModeHeader"
                title="@(_demoModeEnabled ? "Demo trading active. Click to return to Live." : "Switch to Demo trading (risk-free)")">
            <span class="vx-dot @(_demoModeEnabled ? "vx-dot-yel" : "vx-dot-grn")"></span>
            @(_demoModeEnabled ? "DEMO" : "LIVE")
        </button>

        <!-- AutoTrade toggle -->
        <button class="vx-chip @(_autoTradeEnabled ? "vx-chip-autoon" : "vx-chip-autooff")"
                @onclick="ToggleAutoTrade"
                title="@(_autoTradeEnabled ? "Bot opens real positions automatically. Click to pause." : "Bot is signal-only. Click to resume.")">
            <span class="vx-dot @(_autoTradeEnabled ? "vx-dot-grn" : "vx-dot-red")"></span>
            AutoTrade @(_autoTradeEnabled ? "ON" : "OFF")
        </button>

        <!-- Strategy mode -->
        <div class="vx-chip vx-chip-mode">
            <span class="vx-chip-mode-icon">⚙</span>
            <select class="vx-mode-select" title="Strategy Mode" value="@_strategyMode" @onchange="OnStrategyModeChanged">
                <option value="Auto">Auto · Regime-based</option>
                <option value="TrendOnly">Trend Only</option>
                <option value="MeanReversionOnly">MeanReversion Only</option>
            </select>
        </div>
    </div>
</header>

<style>
    .vx-user-menu { position: relative; }
    .vx-user-btn {
        display: flex; align-items: center; gap: 7px; height: 30px;
        padding: 0 10px 0 8px; background: var(--bg1, #0d1117);
        border: 1px solid var(--bdr, #1e2d47); border-radius: 6px;
        cursor: pointer; color: var(--t0, #f0f6ff); font-size: 12px;
        font-weight: 700; transition: all .15s; font-family: inherit;
    }
    .vx-user-btn:hover, .vx-user-menu.open .vx-user-btn {
        border-color: #3b82f6; background: rgba(59,130,246,.06);
    }
    .vx-user-name { max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .vx-user-plan {
        font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px;
    }
    .plan-demo { background: rgba(245,158,11,.12); color: #fbbf24; border: 1px solid rgba(245,158,11,.2); }
    .plan-live { background: rgba(16,185,129,.12); color: #34d399; border: 1px solid rgba(16,185,129,.2); }
    .vx-user-caret { width: 12px; height: 12px; color: var(--t2, #6e90b2); transition: transform .2s; }
    .vx-user-caret.open { transform: rotate(180deg); }
    .vx-user-dropdown {
        position: absolute; top: calc(100% + 8px); right: 0; width: 240px;
        background: #0a1220; border: 1px solid #1e3050; border-radius: 10px;
        box-shadow: 0 16px 48px rgba(0,0,0,.6); z-index: 1000; overflow: hidden;
        animation: ddFadeIn .15s ease;
    }
    @@keyframes ddFadeIn {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .vx-user-dd-header { padding: 14px 16px 12px; background: rgba(255,255,255,.02); }
    .vx-user-dd-name  { font-size: 14px; font-weight: 800; color: #f0f6ff; margin-bottom: 2px; }
    .vx-user-dd-email { font-size: 11px; color: #6e90b2; margin-bottom: 1px; }
    .vx-user-dd-id    { font-size: 10px; color: #334e68; font-family: monospace; }
    .vx-user-dd-sep   { height: 1px; background: #1a2e44; margin: 4px 0; }
    .vx-user-dd-item {
        display: flex; align-items: center; gap: 10px; padding: 9px 16px;
        font-size: 12px; font-weight: 600; color: #94a3b8; cursor: pointer;
        transition: all .12s; text-decoration: none; width: 100%;
        text-align: left; background: transparent; border: none; font-family: inherit;
    }
    .vx-user-dd-item svg { width: 15px; height: 15px; flex-shrink: 0; color: #475569; }
    .vx-user-dd-item:hover { background: rgba(255,255,255,.04); color: #f0f6ff; }
    .vx-user-dd-item:hover svg { color: #3b82f6; }
    .vx-dd-badge {
        margin-left: auto; font-size: 9px; font-weight: 700; padding: 1px 6px;
        border-radius: 3px; background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2); color: #f87171;
    }
    .vx-dd-badge-ok { background: rgba(16,185,129,.1); border-color: rgba(16,185,129,.2); color: #34d399; }
    .vx-dd-logout { color: #f87171 !important; }
    .vx-dd-logout:hover { background: rgba(239,68,68,.08) !important; }
    .vx-dd-logout svg { color: #f87171 !important; }
    .vx-dd-mode-badge {
        font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px;
    }
    .badge-demo { background: rgba(245,158,11,.12); color: #fbbf24; border: 1px solid rgba(245,158,11,.25); }
    .badge-live { background: rgba(16,185,129,.12); color: #34d399; border: 1px solid rgba(16,185,129,.25); }
    .vx-login-topbtn {
        height: 28px; padding: 0 12px; background: #3b82f6; border-radius: 5px;
        color: #fff; font-size: 11px; font-weight: 700;
        text-decoration: none; display: inline-flex; align-items: center;
    }
</style>

<!-- Desktop top menu — replaces the sidebar on wide screens. The
     sidebar (NavMenu inside <aside>) still exists in the DOM for
     tablet/mobile, but is hidden via CSS on desktop widths; this nav
     is the inverse (hidden on tablet/mobile, shown on desktop). -->
<nav class="vertex-topnav">
    <NavLink href="/market" class="vt-link vt-link-feature" Match="NavLinkMatch.All" title="Market">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 17l5-5 4 4 8-8" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 7h7v7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Market
    </NavLink>
    <span class="vt-sep"></span>
    <NavLink href="/statistics" class="vt-link" Match="NavLinkMatch.All" title="Statistics">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 20V10M12 20V4M6 20v-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Statistics
    </NavLink>
    <NavLink href="/ai-dashboard" class="vt-link" Match="NavLinkMatch.All" title="AI Dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="4" height="9" rx="1"/><rect x="10" y="6" width="4" height="14" rx="1"/><rect x="17" y="3" width="4" height="17" rx="1"/></svg>
        AI Dashboard
    </NavLink>
    <NavLink href="/ai-learning" class="vt-link" Match="NavLinkMatch.All" title="AI Learning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        AI Learning
    </NavLink>
    <NavLink href="/missed-trades" class="vt-link" Match="NavLinkMatch.All" title="Signals">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Signals
    </NavLink>
    <NavLink href="/ai-pulse" class="vt-link" Match="NavLinkMatch.All" title="AI Pulse">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="2,12 6,12 8,4 10,20 12,10 14,16 16,8 18,12 22,12" stroke-linecap="round" stroke-linejoin="round"/></svg>
        AI Pulse
    </NavLink>
    <NavLink href="/positions" class="vt-link" Match="NavLinkMatch.All" title="Positions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <path d="M14 17.5h7M17.5 14v7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Positions
    </NavLink>
    <NavLink href="/market/multi" class="vt-link" Match="NavLinkMatch.All" title="Multi Chart — TradingView grid like Bybit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/>
            <rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>
        </svg>
        Multi
    </NavLink>
    <NavLink href="/positions/grid" class="vt-link" Match="NavLinkMatch.All" title="Position Grid — live multi-chart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Grid
    </NavLink>
    <NavLink href="/settings" class="vt-link" Match="NavLinkMatch.All" title="Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Settings
