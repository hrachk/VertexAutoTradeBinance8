@using VertexAutoTradeBinance8.Web.Confs
@inherits LayoutComponentBase

<PageTitle> AUTOTRADE AI</PageTitle>

<header class="vertex-header">
    <div class="vertex-left">
        <button class="menu-toggle" @onclick="ToggleMobileMenu" aria-label="Menu">
            <span class="burger"></span>
        </button>

        <img src="images/vertexailogo.png" class="vertex-logo" alt="Vertex" />

        <div class="vertex-brand">
            <div class="vertex-title">VERTEX AUTOTRADE AI</div>
            <div class="vertex-subtitle">Quant Engine v8</div>
        </div>

        <div class="user-badge">
            <div class="user-badge-avatar">@(Client.Name?.Length > 0 ? Client.Name[0].ToString().ToUpper() : "?")</div>
            <div class="user-badge-info">
                <div class="user-badge-name">@Client.Name</div>
                <div class="user-badge-id">@Client.Id</div>
            </div>
        </div>
    </div>

    <div class="vertex-right">
        <div class="strategy-mode-pill">
            <span class="strategy-mode-icon">⚙</span>
            <select class="strategy-mode-select" title="Strategy Mode" value="@_strategyMode" @onchange="OnStrategyModeChanged">
                <option value="Auto">Auto (Regime-based)</option>
                <option value="TrendOnly">Trend Only</option>
                <option value="MeanReversionOnly">Mean-Reversion Only</option>
            </select>
        </div>
    </div>
</header>

<!-- Desktop top menu — replaces the sidebar on wide screens. The
     sidebar (NavMenu inside <aside>) still exists in the DOM for
     tablet/mobile, but is hidden via CSS on desktop widths; this nav
     is the inverse (hidden on tablet/mobile, shown on desktop). -->
<nav class="vertex-topnav">
    <NavLink href="/positions" class="vt-link" Match="NavLinkMatch.All" title="Positions">📊 Positions</NavLink>
    <NavLink href="/overview" class="vt-link" Match="NavLinkMatch.All" title="Overview">🌐 Overview</NavLink>
    <NavLink href="/" class="vt-link" Match="NavLinkMatch.All" title="Live Dashboard">📈 Live Dashboard</NavLink>
    <NavLink href="/engine" class="vt-link" Match="NavLinkMatch.All" title="Engine State">⚙ Engine State</NavLink>
    <NavLink href="/trade-permission" class="vt-link" Match="NavLinkMatch.All" title="Trade Permission">✅ Trade Permission</NavLink>
    <span class="vt-sep"></span>
    <NavLink href="/market" class="vt-link vt-link-feature" Match="NavLinkMatch.All" title="Market">📈 Market</NavLink>
    <NavLink href="/ai-dashboard" class="vt-link" Match="NavLinkMatch.All" title="AI Dashboard">📊 AI Dashboard</NavLink>
    <NavLink href="/ai-learning" class="vt-link" Match="NavLinkMatch.All" title="AI Learning">🎓 AI Learning</NavLink>
    <NavLink href="/missed-trades" class="vt-link" Match="NavLinkMatch.All" title="Signals">⚡ Signals</NavLink>
    <NavLink href="/settings" class="vt-link" Match="NavLinkMatch.All" title="Settings">⚙ Settings</NavLink>
</nav>

<div class="app-body">
    <div class="page">
        <aside class="sidebar vertex-sidebar @(ShowMobileSidebar ? "sidebar-open" : "") @(SidebarCollapsed ? "sidebar-collapsed vertex-sidebar-collapsed" : "")">
            <NavMenu Collapsed="SidebarCollapsed" CollapsedChanged="OnCollapsedChanged" />
        </aside>

        @if (ShowMobileSidebar)
        {
            <div class="sidebar-backdrop" @onclick="ToggleMobileMenu"></div>
        }

        <main class="main-content vertex-main @(SidebarCollapsed ? "main-content-expanded vertex-main-expanded" : "")">
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@inject Microsoft.Extensions.Options.IOptions<ClientOptions> ClientOptions
@inject Microsoft.JSInterop.IJSRuntime JS
@inject VertexAutoTradeBinance8.Web.Services.StrategyModeFileService StrategyModeService

@code {
    ClientOptions Client => ClientOptions.Value;

    public decimal Balance { get; set; }
    public string EngineStatus { get; set; } = "Loading...";
    public string TradingMode { get; set; } = "Detecting...";

    private bool ShowMobileSidebar;
    private bool SidebarCollapsed;
    private string _strategyMode = "Auto";

    void ToggleMobileMenu() => ShowMobileSidebar = !ShowMobileSidebar;

    void OnCollapsedChanged(bool collapsed)
    {
        SidebarCollapsed = collapsed;
        _ = PersistCollapsed(collapsed);
    }

    async Task OnStrategyModeChanged(ChangeEventArgs e)
    {
        var newMode = e.Value?.ToString() ?? "Auto";
        _strategyMode = newMode;
        await StrategyModeService.SetModeAsync(newMode);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _strategyMode = await StrategyModeService.ReadCurrentModeAsync();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("eval",
                    "window.localStorage ? localStorage.getItem('vertex_sidebar_collapsed') : null");
                if (saved == "1")
                {
                    SidebarCollapsed = true;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    async Task PersistCollapsed(bool collapsed)
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"window.localStorage && localStorage.setItem('vertex_sidebar_collapsed', '{(collapsed ? "1" : "0")}')");
        }
        catch { }
    }
}
