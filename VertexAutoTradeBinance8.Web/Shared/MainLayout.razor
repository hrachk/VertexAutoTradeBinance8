@using VertexAutoTradeBinance8.Web.Confs
@inherits LayoutComponentBase

<PageTitle>VERTEX AUTOTRADE AI</PageTitle>

<header class="vertex-header">
    <div class="vertex-left">
        <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Menu">
            <span class="burger"></span>
        </button>

        <img src="images/vertexailogo.png" class="vertex-logo" alt="Vertex" />

        <div class="vertex-brand">
            <div class="vertex-title">VERTEX AUTOTRADE AI</div>
            <div class="vertex-subtitle">Quant Engine v8</div>
        </div>

        <span class="client-badge">
            @Client.Id (@Client.Name)
        </span>
    </div>

    <div class="vertex-right">
        <div class="status-pill">
            <span class="vertex-status-dot @(EngineStatus == "Running" ? "ok" : "bad")"></span>
            <span class="vertex-status-text">@EngineStatus</span>
        </div>

        <div class="meta-pill">
            <span class="vertex-balance">@Balance USDT</span>
            <span class="sep">•</span>
            <span class="vertex-mode">@TradingMode</span>
        </div>
    </div>
</header>

<div class="app-body">
    <div class="page">
        <aside class="sidebar @(ShowSidebar ? "sidebar-open" : "")">
            <NavMenu />
        </aside>

        @if (ShowSidebar)
        {
            <div class="sidebar-backdrop" @onclick="ToggleMenu"></div>
        }

        <main class="main-content">
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@inject Microsoft.Extensions.Options.IOptions<ClientOptions> ClientOptions

@code {
    ClientOptions Client => ClientOptions.Value;

    public decimal Balance { get; set; }
    public string EngineStatus { get; set; } = "Loading...";
    public string TradingMode { get; set; } = "Detecting...";

    private bool ShowSidebar;
    void ToggleMenu() => ShowSidebar = !ShowSidebar;
}
