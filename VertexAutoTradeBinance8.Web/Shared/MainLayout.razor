@inherits LayoutComponentBase
@using VertexAutoTradeBinance8.Web.Shared.Ui
@inject TerminalDataService Data
@implements IDisposable

<div class="vt-shell">
    <aside class="vt-sidebar">
        <div class="vt-brand">
            <div class="vt-brand-mark">V</div>
            <div>VERTEX<span class="sub">AUTOTRADE · USDⓈ-M</span></div>
        </div>
        <NavMenu />
        <div class="vt-sidebar-foot">
            <div class="vt-row" style="gap:6px;margin-bottom:6px">
                <span class="vt-badge @(snap?.Environment == "Live" ? "danger" : "info")">@(snap?.Environment ?? "—")</span>
                <span class="vt-badge @(snap?.EngineAlive == true ? "ok" : "warn")">engine @(snap?.EngineAlive == true ? "online" : "offline")</span>
            </div>
            Vertex v6 · algo SL/TP · AI regime<br />
            <span class="mono">@DateTime.UtcNow.ToString("HH:mm") UTC</span>
        </div>
    </aside>

    <header class="vt-header">
        <div class="vt-header-center">
            <div class="vt-header-stat">
                <span class="lbl">Equity</span>
                <span class="val">@(snap == null ? "—" : Fmt.Money(snap.Equity))</span>
            </div>
            <div class="vt-header-stat">
                <span class="lbl">Available</span>
                <span class="val">@(snap == null ? "—" : Fmt.Money(snap.Available))</span>
            </div>
            <div class="vt-header-stat">
                <span class="lbl">Unrealized</span>
                <span class="val @Fmt.Cls(snap?.Unrealized ?? 0)">@(snap == null ? "—" : Fmt.Signed(snap.Unrealized))</span>
            </div>
            <div class="vt-header-stat">
                <span class="lbl">Today</span>
                <span class="val @Fmt.Cls(snap?.Stats.TodayPnl ?? 0)">@(snap == null ? "—" : Fmt.Signed(snap.Stats.TodayPnl))</span>
            </div>
            <div class="vt-header-stat">
                <span class="lbl">Positions</span>
                <span class="val">@(snap?.Positions.Count ?? 0)</span>
            </div>
        </div>

        <div class="vt-header-right">
            <span class="vt-pill @(snap?.SessionOpen == true ? "info" : "warn")" title="@snap?.SessionReason">
                <span class="dot"></span>@(snap?.SessionOpen == true ? "SESSION" : "OBSERVE")
            </span>

            @if (confirmToggle)
            {
                <span class="vt-pill warn">Подтвердить?</span>
                <button class="vt-btn sm @(snap?.TradingEnabled == true ? "danger" : "success")" @onclick="ToggleTrading">Да</button>
                <button class="vt-btn sm ghost" @onclick="() => confirmToggle = false">Нет</button>
            }
            else
            {
                <button class="vt-pill @(snap?.TradingEnabled == true ? "live" : "danger")" style="cursor:pointer" @onclick="() => confirmToggle = true"
                        title="Глобальный выключатель новых входов (сопровождение позиций продолжает работать)">
                    <span class="dot"></span>@(snap?.TradingEnabled == true ? "TRADING ON" : "TRADING OFF")
                </button>
            }
        </div>
    </header>

    <main class="vt-main">
        @if (snap != null && !snap.ApiOk)
        {
            <div class="vt-alert danger"><b>Нет данных биржи.</b>&nbsp;@snap.ApiError</div>
        }
        @Body
    </main>
</div>

@code {
    private TerminalSnapshot? snap;
    private Timer? _timer;
    private bool confirmToggle;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _timer = new Timer(async _ => { await Refresh(); await InvokeAsync(StateHasChanged); }, null, 5000, 5000);
    }

    private async Task Refresh()
    {
        try { snap = await Data.GetAsync(); } catch { }
    }

    private async Task ToggleTrading()
    {
        confirmToggle = false;
        var next = !(snap?.TradingEnabled ?? false);
        Data.Control.SetTradingEnabled(next, "web-header");
        snap = await Data.GetAsync(force: true);
    }

    public void Dispose() => _timer?.Dispose();
}
