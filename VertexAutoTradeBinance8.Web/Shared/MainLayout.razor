@using VertexAutoTradeBinance8.Web.Confs
@inherits LayoutComponentBase
@implements IDisposable

<PageTitle> AUTOTRADE AI</PageTitle>

<header class="vertex-header">
    <div class="vertex-left">
        <button class="menu-toggle" @onclick="ToggleMobileMenu" aria-label="Menu">
            <span class="burger"></span>
        </button>

        <img src="images/vertexailogo.png" class="vertex-logo" alt="Vertex" />

        <div class="vertex-brand">
            <div class="vertex-title">VERTEX AUTOTRADE AI</div>
            <div class="vertex-subtitle">Quant Engine v8</div>
        </div>
    </div>

    <div class="vertex-right">
        <div class="user-badge">
            <div class="user-badge-avatar">@(Client.Name?.Length > 0 ? Client.Name[0].ToString().ToUpper() : "?")</div>
            <div class="user-badge-info">
                <div class="user-badge-name">@Client.Name</div>
                <div class="user-badge-id">@Client.Id</div>
            </div>
        </div>

        <button class="autotrade-toggle @(_demoModeEnabled ? "demo-mode-on" : "")"
                @onclick="ToggleDemoModeHeader" title="@(_demoModeEnabled ? "Demo trading active — virtual balance, real live prices. Click to return to Live." : "Switch to Demo trading (virtual balance, real live prices, risk-free)")">
            <span class="autotrade-dot"></span>
            @(_demoModeEnabled ? "DEMO" : "LIVE")
        </button>

        <button class="autotrade-toggle @(_autoTradeEnabled ? "autotrade-on" : "autotrade-off")"
                @onclick="ToggleAutoTrade" title="@(_autoTradeEnabled ? "Bot can open real positions automatically. Click to pause." : "Bot is signal-only — it will NOT open real positions automatically. Click to resume.")">
            <span class="autotrade-dot"></span>
            AutoTrade @(_autoTradeEnabled ? "ON" : "OFF")
        </button>

        <div class="strategy-mode-pill">
            <span class="strategy-mode-icon">⚙</span>
            <select class="strategy-mode-select" title="Strategy Mode" value="@_strategyMode" @onchange="OnStrategyModeChanged">
                <option value="Auto">Auto (Regime-based)</option>
                <option value="TrendOnly">Trend Only</option>
                <option value="MeanReversionOnly">Mean-Reversion Only</option>
            </select>
        </div>
    </div>
</header>

