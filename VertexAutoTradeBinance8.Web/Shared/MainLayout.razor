    <NavLink href="/positions" class="vt-link" Match="NavLinkMatch.All" title="Positions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <path d="M14 17.5h7M17.5 14v7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Positions
    </NavLink>
    <NavLink href="/market/multi" class="vt-link" Match="NavLinkMatch.All" title="Multi Chart — TradingView grid like Bybit">
