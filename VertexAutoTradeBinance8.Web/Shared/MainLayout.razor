</nav>

@if (_userMenuOpen)
{
    <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseUserMenu"></div>
}
<div class="app-body">
    <div class="page">
        <aside class="sidebar vertex-sidebar @(ShowMobileSidebar ? "sidebar-open" : "") @(SidebarCollapsed ? "sidebar-collapsed vertex-sidebar-collapsed" : "")">
            <NavMenu Collapsed="SidebarCollapsed" CollapsedChanged="OnCollapsedChanged" />
        </aside>

        @if (ShowMobileSidebar)
        {
            <div class="sidebar-backdrop" @onclick="ToggleMobileMenu"></div>
        }

        <main class="main-content vertex-main @(SidebarCollapsed ? "main-content-expanded vertex-main-expanded" : "")">
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@inject Microsoft.Extensions.Options.IOptions<ClientOptions> ClientOptions
@inject Microsoft.JSInterop.IJSRuntime JS
@inject VertexAutoTradeBinance8.Web.Services.StrategyModeFileService StrategyModeService
@inject VertexAutoTradeBinance8.Web.Services.RuntimeConfigService RuntimeCfg
@inject VertexAutoTradeBinance8.Web.Services.DemoAccountService DemoAccount

@code {
    static readonly HashSet<string> _public = new(StringComparer.OrdinalIgnoreCase)
        { "/login", "/register" };

    bool _userMenuOpen = false;

    void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;

    void DoLogout()
    {
        _userMenuOpen = false;
        Auth.Logout();
        Nav.NavigateTo("/login", replace: true);
    }

    // Close dropdown on outside click — handled by Blazor onclick on overlay
    void CloseUserMenu() => _userMenuOpen = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChange;
        GuardRoute();
    }

    void OnAuthChange() { GuardRoute(); InvokeAsync(StateHasChanged); }

    void GuardRoute()
    {
        if (Auth.IsAuthenticated) return;
        var rel = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimStart('/');
        if (!_public.Contains(rel))
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(rel)}", replace: true);
    }

    public void Dispose() => Auth.OnChange -= OnAuthChange;

    // Existing code below:
    ClientOptions Client => ClientOptions.Value;

    public decimal Balance { get; set; }
    public string EngineStatus { get; set; } = "Loading...";
    public string TradingMode { get; set; } = "Detecting...";

    private bool ShowMobileSidebar;
    private bool SidebarCollapsed;
    private string _strategyMode = "Auto";
    private bool _autoTradeEnabled = true;
    private bool _demoModeEnabled;

    void ToggleDemoModeHeader()
    {
        DemoAccount.SetDemoMode(!DemoAccount.DemoMode);
    }

    void OnDemoModeChangedInHeader()
    {
        _demoModeEnabled = DemoAccount.DemoMode;
        _ = InvokeAsync(StateHasChanged);
    }

    void ToggleMobileMenu() => ShowMobileSidebar = !ShowMobileSidebar;

    void OnCollapsedChanged(bool collapsed)
    {
        SidebarCollapsed = collapsed;
        _ = PersistCollapsed(collapsed);
    }

    async Task OnStrategyModeChanged(ChangeEventArgs e)
    {
        var newMode = e.Value?.ToString() ?? "Auto";
        _strategyMode = newMode;
        await StrategyModeService.SetModeAsync(newMode);
    }

    async Task ToggleAutoTrade()
    {
        _autoTradeEnabled = !_autoTradeEnabled;
        try
        {
            // One button controls both flags atomically:
            //   ON  → Engine opens real positions + Supervisor manages TP
            //   OFF → Engine dry-run only         + Supervisor leaves TP alone
            //
            // Path: Trading:EnableExecution (NOT the removed SignalOnlyMode section)
            // Path: Trading:SupervisorManageTP
            // Both written to appsettings.runtime.json via RuntimeConfigService.
            // Engine picks up via reloadOnChange within seconds, no restart needed.
            await RuntimeCfg.SetValueAsync("Trading:EnableExecution",    _autoTradeEnabled);
            await RuntimeCfg.SetValueAsync("Trading:SupervisorManageTP", _autoTradeEnabled);
        }
        catch
        {
            // Revert the optimistic UI flip if the write genuinely failed
            _autoTradeEnabled = !_autoTradeEnabled;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _strategyMode = await StrategyModeService.ReadCurrentModeAsync();
        }
        catch { }

        try
        {
            var cfg = await RuntimeCfg.GetEffectiveConfigAsync();
            // Read Trading:EnableExecution (the correct path).
            // Falls back to true if the key is absent (default = trading enabled).
            var node = cfg["Trading"]?["EnableExecution"];
            if (node != null) _autoTradeEnabled = node.GetValue<bool>();
        }
        catch { }

        _demoModeEnabled = DemoAccount.DemoMode;
        DemoAccount.DemoModeChanged += OnDemoModeChangedInHeader;
    }

    public void Dispose()
    {
        DemoAccount.DemoModeChanged -= OnDemoModeChangedInHeader;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("eval",
                    "window.localStorage ? localStorage.getItem('vertex_sidebar_collapsed') : null");
                if (saved == "1")
                {
                    SidebarCollapsed = true;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    async Task PersistCollapsed(bool collapsed)
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"window.localStorage && localStorage.setItem('vertex_sidebar_collapsed', '{(collapsed ? "1" : "0")}')");
        }
        catch { }
    }
}






