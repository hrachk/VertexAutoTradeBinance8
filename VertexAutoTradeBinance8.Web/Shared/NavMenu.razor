@*  Навигация сгруппирована по тому, куда оператор смотрит в разное время:
    сначала живое состояние счёта, потом история решений бота, потом обучение.
    Счётчик у «Позиций» появляется только когда есть незащищённая позиция —
    постоянный бейдж перестал бы что-либо значить. *@

<nav class="v-nav">

    <div class="v-nav__group">Сейчас</div>

    <NavLink class="v-nav__link" href="" Match="NavLinkMatch.All" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M1.5 8.5h3l2-5 3 10 2-5h3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Обзор
    </NavLink>

    <NavLink class="v-nav__link" href="positions" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" />
            <path d="M1.5 8h13" stroke-linecap="round" />
        </svg>
        Позиции
        @if (Unprotected > 0)
        {
            <span class="v-nav__count">@Unprotected</span>
        }
    </NavLink>

    <NavLink class="v-nav__link" href="engine" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="8" r="2.25" />
            <path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2l-1.4 1.4" stroke-linecap="round" />
        </svg>
        Движок
    </NavLink>

    <div class="v-nav__group">История</div>

    <NavLink class="v-nav__link" href="decisions" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 1.5v13M8 1.5L3 6M8 1.5L13 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Решения
    </NavLink>

    <NavLink class="v-nav__link" href="executed-signals" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 4h12M2 8h12M2 12h7" stroke-linecap="round" />
        </svg>
        Исполненные
    </NavLink>

    <NavLink class="v-nav__link" href="missed-signals" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="8" r="6.25" />
            <path d="M5.6 5.6l4.8 4.8" stroke-linecap="round" />
        </svg>
        Пропущенные
    </NavLink>

    <div class="v-nav__group">Обучение</div>

    <NavLink class="v-nav__link" href="ai-learning" @onclick="Navigate">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M1.5 12.5l4-5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Статистика AI
    </NavLink>

</nav>

@code {
    [Parameter] public int Unprotected { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private Task Navigate() => OnNavigate.InvokeAsync();
}
