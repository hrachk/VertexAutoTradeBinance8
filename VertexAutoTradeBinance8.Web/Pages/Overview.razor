@page "/overview"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject EngineStateService EngineState
@inject LivePnlService PnlService
@inject MissedTradeFileService MissedSvc
@inject AiLearningFileService AiSvc
@inject MarketSnapshotFileService MarketSvc
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Vertex AI — Overview</PageTitle>

<div class="ov">

    <!-- ══ GLOBAL BAR (like CMC top bar) ═══════════════════════════ -->
    <div class="ov-global">
        <div class="ov-global-inner">
            <div class="ov-gi">
                <span class="ov-gi-lab">Balance</span>
                <span class="ov-gi-val">$@(_state?.BalanceUsdt.ToString("F2") ?? "—")</span>
            </div>
            <div class="ov-gi-sep">|</div>
            <div class="ov-gi">
                <span class="ov-gi-lab">Realized PnL</span>
                <span class="ov-gi-val @(_state?.RealizedPnlUsd >= 0 ? "g" : "r")">
                    @(_state != null ? $"{(_state.RealizedPnlUsd >= 0 ? "+" : "")}{_state.RealizedPnlUsd:F2}$" : "—")
                </span>
            </div>
            <div class="ov-gi-sep">|</div>
            <div class="ov-gi">
                <span class="ov-gi-lab">Win Rate</span>
                <span class="ov-gi-val @(_winRate >= 55 ? "g" : "r")">@_winRate.ToString("F1")%</span>
            </div>
            <div class="ov-gi-sep">|</div>
            <div class="ov-gi">
                <span class="ov-gi-lab">AI Trades</span>
                <span class="ov-gi-val">@_totalTrades</span>
            </div>
            <div class="ov-gi-sep">|</div>
            <div class="ov-gi">
                <span class="ov-gi-lab">Universe</span>
                <span class="ov-gi-val">@(_state?.UniverseSize ?? 0) symbols</span>
            </div>
            <div class="ov-gi-sep">|</div>
            <div class="ov-gi">
                <span class="ov-dot @(_state != null ? "dot-on" : "dot-off")"></span>
                <span class="ov-gi-val @(_state != null ? "g" : "r")">@(_state != null ? "LIVE" : "OFFLINE")</span>
            </div>
        </div>
        <div class="ov-clock">@DateTime.Now.ToString("HH:mm:ss")</div>
    </div>

    <!-- ══ HERO HEADER ══════════════════════════════════════════════ -->
    <div class="ov-hero">
        <div class="ov-hero-title">
            <div class="ov-logo">⬡ VERTEX AI</div>
            <div class="ov-tagline">Autonomous Binance Futures Trading Bot · v5.0</div>
        </div>

        <!-- Big 3 numbers -->
        <div class="ov-hero-nums">
            <div class="ov-hn @(_state?.RealizedPnlUsd >= 0 ? "hn-up" : "hn-dn")">
                <div class="ov-hn-val">@(_state != null ? $"{(_state.RealizedPnlUsd >= 0 ? "+" : "")}{_state.RealizedPnlUsd:F2}$" : "—")</div>
                <div class="ov-hn-lab">Realized PnL</div>
            </div>
            <div class="ov-hn-div"></div>
            <div class="ov-hn">
                <div class="ov-hn-val">$@(_state?.BalanceUsdt.ToString("F2") ?? "—")</div>
                <div class="ov-hn-lab">Wallet Balance</div>
            </div>
            <div class="ov-hn-div"></div>
            <div class="ov-hn @(_winRate >= 55 ? "hn-up" : "hn-dn")">
                <div class="ov-hn-val">@_winRate.ToString("F1")%</div>
                <div class="ov-hn-lab">AI Win Rate</div>
            </div>
        </div>
    </div>

    <!-- ══ STATS STRIP ═══════════════════════════════════════════════ -->
    <div class="ov-strip">
        <div class="ov-st">
            <div class="ov-st-val @(_state?.ConfidencePercent >= 70 ? "g" : _state?.ConfidencePercent >= 50 ? "b" : "r")">
                @(_state?.ConfidencePercent ?? 0)%
            </div>
            <div class="ov-st-lab">AI Confidence</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val">@_positions.Count<span class="ov-st-sub">/4</span></div>
            <div class="ov-st-lab">Open Positions</div>
        </div>
        <div class="ov-st @(_unrPnl >= 0 ? "st-up" : "st-dn")">
            <div class="ov-st-val">@(_unrPnl >= 0 ? "+" : "")@_unrPnl.ToString("F2")$</div>
            <div class="ov-st-lab">Unrealized PnL</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val">@_wins<span class="ov-st-sub"> W</span></div>
            <div class="ov-st-lab">AI Wins</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val r">@_losses<span class="ov-st-sub"> L</span></div>
            <div class="ov-st-lab">AI Losses</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val b">@_aiSymbols</div>
            <div class="ov-st-lab">Tracked Symbols</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val">@(_state?.CyclesPerMinute ?? 0)</div>
            <div class="ov-st-lab">Cycles / min</div>
        </div>
        <div class="ov-st">
            <div class="ov-st-val">@_totalBlocked</div>
            <div class="ov-st-lab">Total Blocked</div>
        </div>
    </div>

    <!-- ══ MAIN BODY ═════════════════════════════════════════════════ -->
    <div class="ov-body">

        <!-- ── LEFT ─────────────────────────────────── -->
        <div class="ov-left">

            <!-- ENGINE STATUS CARD -->
            @if (_state != null)
            {
                <div class="ov-card ov-engine-card">
                    <div class="ov-card-hd">
                        <span class="ov-card-title">ENGINE STATE</span>
                        <span class="ov-badge @(_state.Status == "Running" ? "badge-ok" : "badge-err")">@_state.Status</span>
                    </div>
                    <div class="ov-engine-grid">
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Mode</span>
                            <span class="ov-ef-val b">@_state.Mode</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Symbol</span>
                            <span class="ov-ef-val b">@_state.Symbol</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Timeframe</span>
                            <span class="ov-ef-val">@_state.Timeframe</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Regime</span>
                            <span class="ov-ef-val @RegCls(_state.MarketRegime)">@_state.MarketRegime</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Smart</span>
                            <span class="ov-ef-val">@_state.SmartRegime</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Confidence</span>
                            <span class="ov-ef-val @(_state.ConfidencePercent>=70?"g":_state.ConfidencePercent>=50?"b":"r")">
                                @_state.ConfidencePercent% · @_state.ConfidenceLevel
                            </span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Slope</span>
                            <span class="ov-ef-val mono">@_state.Slope.ToString("F4")</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Volatility</span>
                            <span class="ov-ef-val mono">@_state.Volatility.ToString("F4")</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Liq Danger</span>
                            <span class="ov-ef-val @(_state.LiquidityDanger?"r":"g")">@(_state.LiquidityDanger?"⚠ YES":"✓ OK")</span>
                        </div>
                        <div class="ov-ef">
                            <span class="ov-ef-lab">Updated</span>
                            <span class="ov-ef-val dim">@_state.LastUpdate.ToLocalTime().ToString("HH:mm:ss")</span>
                        </div>
                    </div>
                </div>
            }

            <!-- POSITIONS -->
            @if (_positions.Any())
            {
                <div class="ov-card">
                    <div class="ov-card-hd">
                        <span class="ov-card-title">OPEN POSITIONS</span>
                        <span class="ov-badge @(_unrPnl >= 0 ? "badge-ok" : "badge-err")">
                            @(_unrPnl >= 0 ? "+" : "")@_unrPnl.ToString("F2")$ unrealized
                        </span>
                    </div>
                    @foreach (var p in _positions)
                    {
                        bool isL = p.PositionSide == "LONG";
                        var pct = p.EntryPrice > 0
                            ? (p.MarkPrice - p.EntryPrice) / p.EntryPrice * (isL ? 1 : -1) * 100m : 0m;
                        var liq = p.LiquidationPrice;
                        var buf = liq.HasValue && p.MarkPrice > 0
                            ? Math.Abs(p.MarkPrice - liq.Value) / p.MarkPrice * 100m : (decimal?)null;
                        <div class="ov-pos-row">
                            <div class="ov-pos-left">
                                <span class="ov-pos-sym">@p.Symbol</span>
                                <span class="pos-badge @(isL ? "pos-l" : "pos-s")">@p.PositionSide</span>
                            </div>
                            <div class="ov-pos-mid">
                                <div class="ov-pos-item"><span class="dim">Entry</span> <span class="mono">@FP(p.EntryPrice)</span></div>
                                <div class="ov-pos-item"><span class="dim">Mark</span> <span class="mono">@FP(p.MarkPrice)</span></div>
                                @if (liq.HasValue)
                                {
                                    <div class="ov-pos-item">
                                        <span class="dim">Liq</span>
                                        <span class="mono @(buf < 4 ? "r" : buf < 8 ? "y" : "g")">@FP(liq.Value) (@buf?.ToString("F1")%)</span>
                                    </div>
                                }
                            </div>
                            <div class="ov-pos-pnl @(p.UnrealizedPnl >= 0 ? "g" : "r")">
                                <div class="ov-pos-pnl-val">@(p.UnrealizedPnl >= 0 ? "+" : "")@p.UnrealizedPnl.ToString("F2")$</div>
                                <div class="ov-pos-pnl-pct">@(pct >= 0 ? "+" : "")@pct.ToString("F2")%</div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- MARKET TABLE (CMC style) -->
            <div class="ov-card">
                <div class="ov-card-hd">
                    <span class="ov-card-title">LIVE MARKET</span>
                    <span class="ov-badge">@_markets.Count instruments</span>
                </div>
                <div class="ov-market-tabs">
                    <button class="ov-market-tab @(_ovMarketTab=="hot"?"ov-market-tab-on":"")" @onclick="SetOvMarketTabHot">🔥 Hot</button>
                    <button class="ov-market-tab @(_ovMarketTab=="gainers"?"ov-market-tab-on":"")" @onclick="SetOvMarketTabGainers">📈 Gainers</button>
                    <button class="ov-market-tab @(_ovMarketTab=="losers"?"ov-market-tab-on":"")" @onclick="SetOvMarketTabLosers">📉 Losers</button>
                </div>
                <table class="ov-tbl">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Change</th>
                            <th>Regime</th>
                            <th>Slope</th>
                            <th>Signal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 0; }
                        @foreach (var m in OrderedMarkets())
                        {
                            rank++;
                            var sig = GetSig(m);
                            var slopeCls = m.Slope > 0.002 ? "g" : m.Slope < -0.002 ? "r" : "dim";
                            <tr @onclick="() => NavToMarket(m.Symbol)" style="cursor:pointer">
                                <td class="dim small">@rank</td>
                                <td>
                                    <div class="ov-sym-cell">
                                        <div class="ov-sym-icon">@m.Symbol[0]</div>
                                        <div>
                                            <div class="ov-sym-name">@m.Symbol.Replace("USDT","")</div>
                                            <div class="dim small">@m.Symbol</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono bold">@FP(m.LastPrice)</td>
                                <td class="@(m.ChgPct >= 0 ? "g" : "r") mono">
                                    @(m.ChgPct >= 0 ? "▲" : "▼") @Math.Abs(m.ChgPct).ToString("F2")%
                                </td>
                                <td><span class="ov-reg @RegimeN(m.Regime)">@RegStr(m.Regime)</span></td>
                                <td class="@slopeCls mono small">@m.Slope.ToString("+0.000;-0.000")</td>
                                <td><span class="ov-sig-badge @sig.cls">@sig.lbl</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <!-- ── RIGHT ─────────────────────────────────── -->
        <div class="ov-right">

            <!-- AI PERFORMANCE -->
            <div class="ov-card">
                <div class="ov-card-hd">
                    <span class="ov-card-title">🧠 AI PERFORMANCE</span>
                </div>
                <!-- Big win rate -->
                <div class="ov-wr-big @(_winRate >= 60 ? "g" : _winRate >= 50 ? "b" : "r")">
                    @_winRate.ToString("F1")%
                </div>
                <div class="ov-wr-bar">
                    <div class="ov-wr-win" style="width:@_winRate%">
                        <span>@_wins W</span>
                    </div>
                    <div class="ov-wr-loss" style="width:@(100-_winRate)%">
                        <span>@_losses L</span>
                    </div>
                </div>
                <div class="ov-wr-stats">
                    <div class="ov-ws"><div class="g bold">@_wins</div><div class="dim small">Wins</div></div>
                    <div class="ov-ws"><div class="r bold">@_losses</div><div class="dim small">Losses</div></div>
                    <div class="ov-ws"><div class="bold">@_totalTrades</div><div class="dim small">Total</div></div>
                    <div class="ov-ws"><div class="@(_totalPnl>=0?"g":"r") bold">@(_totalPnl>=0?"+":"")@_totalPnl.ToString("F3")</div><div class="dim small">AI PnL</div></div>
                </div>
            </div>

            <!-- TOP SYMBOLS -->
            <div class="ov-card">
                <div class="ov-card-hd">
                    <span class="ov-card-title">🏆 TOP SYMBOLS</span>
                    <span class="ov-badge">by signal count</span>
                </div>
                @foreach (var (sym, cnt, avgConf) in _topSymbols.Take(10))
                {
                    var barW = _topSymbols.Any() ? cnt * 100.0 / _topSymbols[0].Item2 : 0;
                    var cc = avgConf >= 70 ? "g" : avgConf >= 50 ? "b" : "r";
                    <div class="ov-sym-row">
                        <span class="ov-sr-sym">@sym</span>
                        <div class="ov-sr-track">
                            <div class="ov-sr-bar @cc" style="width:@barW%"></div>
                        </div>
                        <span class="ov-sr-n dim">@cnt</span>
                        <span class="ov-sr-conf @cc">@avgConf%</span>
                    </div>
                }
            </div>

            <!-- BLOCK REASONS -->
            <div class="ov-card">
                <div class="ov-card-hd">
                    <span class="ov-card-title">🚫 BLOCK REASONS</span>
                    <span class="ov-badge r">@_totalBlocked total</span>
                </div>
                @foreach (var (reason, cnt) in _topReasons.Take(8))
                {
                    var pct = _totalBlocked > 0 ? cnt * 100.0 / _totalBlocked : 0;
                    <div class="ov-rr">
                        <span class="ov-rr-name @RCls(reason)">@SR(reason)</span>
                        <div class="ov-rr-track">
                            <div class="ov-rr-bar @RFill(reason)" style="width:@Math.Min(100.0,pct)%"></div>
                        </div>
                        <span class="ov-rr-pct dim">@pct.ToString("F0")%</span>
                        <span class="ov-rr-n dim bold">@cnt</span>
                    </div>
                }
            </div>

            <!-- RECENT SIGNALS -->
            <div class="ov-card">
                <div class="ov-card-hd">
                    <span class="ov-card-title">⚡ RECENT SIGNALS</span>
                    <span class="ov-badge">last 12</span>
                </div>
                @foreach (var s in _recentSignals)
                {
                    bool isL = s.Side == "Buy";
                    <div class="ov-sig-row">
                        <span class="ov-sig-time dim">@s.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="ov-sig-sym @(isL?"g":"r")">@s.Symbol</span>
                        <span class="ssb @(isL?"ssb-l":"ssb-s")">@(isL?"L":"S")</span>
                        <span class="ov-sig-price dim mono">@FP(s.Entry)</span>
                        <span class="ov-sig-conf @(s.Confidence>=70?"g":s.Confidence>=50?"b":"r")">@s.Confidence%</span>
                        <span class="ov-sig-r @(s.Event.Contains("EXEC")?"r":s.Event=="OK"?"g":"y")">@SR(s.Reason)</span>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<style>
:root {
    --bg: #0d1117; --bg2: #161b22; --bg3: #21262d;
    --bdr: #30363d; --acc: #1f6feb; --grn: #3fb950;
    --red: #f85149; --yel: #e3b341; --txt: #e6edf3;
    --dim: #8b949e; --mono: 'JetBrains Mono','Fira Code',monospace;
    --r: 8px;
}
html,body { background:var(--bg)!important; color:var(--txt); font-size:14px; }
.ov { font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; background:var(--bg); min-height:100vh; padding-bottom:48px; }
.g{color:var(--grn)!important;} .r{color:var(--red)!important;} .b{color:var(--acc)!important;}
.y{color:var(--yel)!important;} .dim{color:var(--dim)!important;}
.bold{font-weight:600;} .small{font-size:12px;} .mono{font-family:var(--mono)!important;}

/* GLOBAL BAR */
.ov-global { display:flex; align-items:center; justify-content:space-between; padding:7px 24px; background:var(--bg2); border-bottom:1px solid var(--bdr); font-size:13px; }
.ov-global-inner { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.ov-gi { display:flex; align-items:center; gap:5px; }
.ov-gi-lab { color:var(--dim); }
.ov-gi-val { font-weight:600; }
.ov-gi-sep { color:var(--bdr); }
.ov-dot { width:7px; height:7px; border-radius:50%; }
.dot-on { background:var(--grn); box-shadow:0 0 6px var(--grn); animation:pulse 1.5s infinite; }
.dot-off { background:var(--red); }
@@keyframes pulse { 0%,100%{opacity:1;}50%{opacity:.4;} }
.ov-clock { font-family:var(--mono); font-size:13px; color:var(--dim); }

/* HERO */
.ov-hero { display:flex; align-items:center; justify-content:space-between; padding:28px 28px 20px; background:linear-gradient(180deg,#161b22 0%,#0d1117 100%); border-bottom:1px solid var(--bdr); }
.ov-logo { font-family:var(--mono); font-size:24px; font-weight:700; color:var(--acc); letter-spacing:3px; }
.ov-tagline { font-size:13px; color:var(--dim); margin-top:4px; }
.ov-hero-nums { display:flex; align-items:center; gap:0; }
.ov-hn { text-align:right; padding:0 24px; }
.ov-hn-val { font-size:26px; font-weight:700; font-family:var(--mono); }
.ov-hn-lab { font-size:12px; color:var(--dim); margin-top:3px; }
.ov-hn-up .ov-hn-val { color:var(--grn); }
.ov-hn-dn .ov-hn-val { color:var(--red); }
.ov-hn-div { width:1px; height:40px; background:var(--bdr); }

/* STATS STRIP */
.ov-strip { display:grid; grid-template-columns:repeat(8,1fr); background:var(--bg2); border-bottom:1px solid var(--bdr); }
.ov-st { padding:14px 16px; border-right:1px solid var(--bdr); text-align:center; }
.ov-st:last-child { border-right:none; }
.ov-st-val { font-size:20px; font-weight:700; font-family:var(--mono); }
.ov-st-sub { font-size:14px; color:var(--dim); }
.ov-st-lab { font-size:11px; color:var(--dim); margin-top:3px; letter-spacing:.5px; }
.st-up .ov-st-val { color:var(--grn); }
.st-dn .ov-st-val { color:var(--red); }

/* BODY */
.ov-body { display:grid; grid-template-columns:1fr 340px; gap:16px; padding:16px; }
.ov-left { display:flex; flex-direction:column; gap:16px; }
.ov-right { display:flex; flex-direction:column; gap:16px; }

/* CARD */
.ov-card { background:var(--bg2); border:1px solid var(--bdr); border-radius:var(--r); overflow:hidden; }
.ov-card-hd { display:flex; align-items:center; justify-content:space-between; padding:14px 16px 12px; border-bottom:1px solid var(--bdr); }
.ov-card-title { font-size:13px; font-weight:700; letter-spacing:.5px; color:var(--dim); text-transform:uppercase; }
.ov-badge { font-size:11px; padding:2px 8px; background:var(--bg3); border:1px solid var(--bdr); border-radius:20px; color:var(--dim); }
.ov-badge.badge-ok { color:var(--grn); border-color:rgba(63,185,80,.3); background:rgba(63,185,80,.1); }
.ov-badge.badge-err { color:var(--red); border-color:rgba(248,81,73,.3); background:rgba(248,81,73,.1); }
.ov-market-tabs { display:flex; gap:6px; padding:10px 16px; border-bottom:1px solid var(--bdr); }
.ov-market-tab { flex:1; padding:7px 10px; border-radius:8px; border:1px solid var(--bdr); background:var(--bg3); color:var(--dim); font-size:12px; font-weight:600; cursor:pointer; text-align:center; }
.ov-market-tab.ov-market-tab-on { background:var(--acc); color:#fff; border-color:var(--acc); }
.ov-badge.r { color:var(--red); border-color:rgba(248,81,73,.3); background:rgba(248,81,73,.1); }

/* ENGINE GRID */
.ov-engine-grid { display:grid; grid-template-columns:1fr 1fr; padding:4px 0; }
.ov-ef { display:flex; justify-content:space-between; padding:7px 16px; border-bottom:1px solid rgba(48,54,61,.5); font-size:13px; }
.ov-ef:nth-child(odd) { background:rgba(255,255,255,.01); }
.ov-ef-lab { color:var(--dim); }
.ov-ef-val { font-weight:500; }

/* POSITIONS */
.ov-pos-row { display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid rgba(48,54,61,.5); }
.ov-pos-row:last-child { border-bottom:none; }
.ov-pos-left { min-width:110px; display:flex; flex-direction:column; gap:4px; }
.ov-pos-sym { font-size:15px; font-weight:700; color:var(--txt); font-family:var(--mono); }
.pos-badge { font-size:10px; font-weight:700; padding:1px 7px; border-radius:3px; display:inline-block; width:fit-content; }
.pos-l { background:rgba(63,185,80,.15); color:var(--grn); }
.pos-s { background:rgba(248,81,73,.15); color:var(--red); }
.ov-pos-mid { flex:1; display:flex; gap:16px; font-size:12px; }
.ov-pos-item { display:flex; gap:4px; align-items:center; }
.ov-pos-pnl { text-align:right; }
.ov-pos-pnl-val { font-size:16px; font-weight:700; font-family:var(--mono); }
.ov-pos-pnl-pct { font-size:12px; margin-top:2px; }

/* MARKET TABLE (CMC style) */
.ov-tbl { width:100%; border-collapse:collapse; }
.ov-tbl th { text-align:left; padding:9px 12px; font-size:12px; color:var(--dim); border-bottom:1px solid var(--bdr); font-weight:600; letter-spacing:.3px; }
.ov-tbl td { padding:10px 12px; border-bottom:1px solid rgba(48,54,61,.4); font-size:13px; }
.ov-tbl tr:hover td { background:rgba(255,255,255,.03); }
.ov-tbl tr:last-child td { border-bottom:none; }
.ov-sym-cell { display:flex; align-items:center; gap:10px; }
.ov-sym-icon { width:32px; height:32px; border-radius:50%; background:var(--acc); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; flex-shrink:0; }
.ov-sym-name { font-weight:600; font-size:14px; }
.ov-reg { font-size:11px; font-weight:600; padding:2px 7px; border-radius:3px; }
.reg-bull { background:rgba(63,185,80,.15); color:var(--grn); }
.reg-bear { background:rgba(248,81,73,.15); color:var(--red); }
.reg-range { background:rgba(227,179,65,.15); color:var(--yel); }
.reg-sq { background:rgba(31,111,235,.15); color:var(--acc); }
.reg-unk { background:var(--bg3); color:var(--dim); }
.ov-sig-badge { font-size:11px; font-weight:700; padding:2px 8px; border-radius:3px; }
.sig-buy { background:rgba(63,185,80,.15); color:var(--grn); }
.sig-sell { background:rgba(248,81,73,.15); color:var(--red); }
.sig-watch { background:rgba(31,111,235,.15); color:var(--acc); }
.sig-none { color:var(--dim); font-weight:400; }

/* REGIME COLORS */
.rc-bull { color:var(--grn)!important; }
.rc-bear { color:var(--red)!important; }
.rc-rng  { color:var(--yel)!important; }
.rc-sq   { color:var(--acc)!important; }

/* AI WIN RATE */
.ov-wr-big { text-align:center; font-size:48px; font-weight:700; font-family:var(--mono); padding:16px 0 8px; }
.ov-wr-bar { display:flex; height:28px; margin:0 16px 12px; border-radius:4px; overflow:hidden; gap:2px; }
.ov-wr-win { background:var(--grn); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:#000; border-radius:4px 0 0 4px; transition:width .5s; }
.ov-wr-loss { background:var(--red); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:#fff; border-radius:0 4px 4px 0; transition:width .5s; }
.ov-wr-stats { display:grid; grid-template-columns:repeat(4,1fr); padding:0 16px 16px; gap:8px; }
.ov-ws { text-align:center; background:var(--bg3); border-radius:6px; padding:10px 4px; }

/* TOP SYMBOLS */
.ov-sym-row { display:flex; align-items:center; gap:8px; padding:7px 16px; border-bottom:1px solid rgba(48,54,61,.4); font-size:13px; }
.ov-sym-row:last-child { border-bottom:none; }
.ov-sr-sym { font-family:var(--mono); font-weight:700; color:var(--acc); min-width:100px; font-size:13px; }
.ov-sr-track { flex:1; height:5px; background:var(--bg3); border-radius:3px; overflow:hidden; }
.ov-sr-bar { height:100%; border-radius:3px; }
.ov-sr-bar.g { background:var(--grn); } .ov-sr-bar.b { background:var(--acc); } .ov-sr-bar.r { background:var(--red); }
.ov-sr-n { font-family:var(--mono); font-size:12px; min-width:30px; text-align:right; }
.ov-sr-conf { font-family:var(--mono); font-size:12px; min-width:34px; text-align:right; }

/* BLOCK REASONS */
.ov-rr { display:flex; align-items:center; gap:8px; padding:7px 16px; border-bottom:1px solid rgba(48,54,61,.4); font-size:13px; }
.ov-rr:last-child { border-bottom:none; }
.ov-rr-name { font-weight:600; min-width:120px; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ov-rr-track { flex:1; height:5px; background:var(--bg3); border-radius:3px; overflow:hidden; }
.ov-rr-bar { height:100%; border-radius:3px; }
.rr-exec { background:var(--red); } .rr-bal { background:var(--yel); } .rr-other { background:var(--dim); }
.ov-rr-pct { font-family:var(--mono); font-size:11px; min-width:28px; text-align:right; }
.ov-rr-n { font-family:var(--mono); font-size:12px; min-width:32px; text-align:right; }

/* SIGNALS FEED */
.ov-sig-row { display:flex; align-items:center; gap:8px; padding:7px 16px; border-bottom:1px solid rgba(48,54,61,.4); font-size:12px; }
.ov-sig-row:last-child { border-bottom:none; }
.ov-sig-time { min-width:52px; font-family:var(--mono); }
.ov-sig-sym { min-width:84px; font-family:var(--mono); font-weight:700; font-size:13px; }
.ssb { font-size:10px; font-weight:700; padding:1px 5px; border-radius:3px; }
.ssb-l { background:rgba(63,185,80,.15); color:var(--grn); }
.ssb-s { background:rgba(248,81,73,.15); color:var(--red); }
.ov-sig-price { flex:1; font-size:11px; }
.ov-sig-conf { min-width:30px; font-family:var(--mono); text-align:right; }
.ov-sig-r { font-size:11px; min-width:90px; text-align:right; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

@@media(max-width:1200px) { .ov-body { grid-template-columns:1fr; } .ov-strip { grid-template-columns:repeat(4,1fr); } }
@@media(max-width:700px) { .ov-hero { flex-direction:column; gap:16px; } .ov-strip { grid-template-columns:repeat(2,1fr); } .ov-global-inner { gap:8px; } }
</style>

@code {
    EngineStateModel? _state;
    IReadOnlyList<LivePositionModel> _positions = Array.Empty<LivePositionModel>();
    decimal _unrPnl;
    int _wins, _losses, _totalTrades, _aiSymbols, _totalBlocked;
    double _winRate, _totalPnl;
    List<MarketRow> _markets = new();
    string _ovMarketTab = "hot"; // "hot" | "gainers" | "losers" - matches the same 3-tab system on the Market page's ALL INSTRUMENTS panel

    void SetOvMarketTabHot() => _ovMarketTab = "hot";
    void SetOvMarketTabGainers() => _ovMarketTab = "gainers";
    void SetOvMarketTabLosers() => _ovMarketTab = "losers";

    // Applies the active tab's ordering - same logic as the Market
    // page's ALL INSTRUMENTS panel (top 7 by volume for Hot, biggest
    // %-up/%-down for Gainers/Losers), kept consistent across both
    // pages rather than diverging into a different ranking here.
    IEnumerable<MarketRow> OrderedMarkets()
    {
        if (_ovMarketTab == "gainers") return _markets.OrderByDescending(m => m.ChgPct);
        if (_ovMarketTab == "losers") return _markets.OrderBy(m => m.ChgPct);

        var topHot = _markets.OrderByDescending(m => m.Volume).Take(7).Select(m => m.Symbol).ToHashSet();
        return _markets
            .OrderByDescending(m => topHot.Contains(m.Symbol))
            .ThenByDescending(m => topHot.Contains(m.Symbol) ? m.Volume : 0)
            .ThenByDescending(m => Math.Abs(m.Slope));
    }
    List<(string, int, int)> _topSymbols = new();
    List<(string, int)> _topReasons = new();
    List<SigRow> _recentSignals = new();
    System.Threading.Timer? _timer;

    record MarketRow(string Symbol, string Timeframe, decimal LastPrice, double Slope, int Regime, decimal ChgPct, decimal Volume);
    record SigRow(string Event, string Symbol, string Side, decimal Entry, int Confidence, string Reason, DateTime Time);

    protected override async Task OnInitializedAsync()
    {
        PnlService.Updated += OnPnl;
        PnlService.Start(null, 1500);
        await LoadAll();
        _timer = new System.Threading.Timer(async _ =>
            await InvokeAsync(async () => { await LoadAll(); StateHasChanged(); }),
            null, 3000, 3000);
    }

    void OnPnl()
    {
        _positions = PnlService.GetPositions();
        _unrPnl = _positions.Sum(p => p.UnrealizedPnl);
        InvokeAsync(StateHasChanged);
    }

    async Task LoadAll()
    {
        _state = EngineState.Load();
        _positions = PnlService.GetPositions();
        _unrPnl = _positions.Sum(p => p.UnrealizedPnl);
        await Task.WhenAll(LoadAi(), LoadSignals(), LoadMarkets());
    }

    async Task LoadAi()
    {
        try
        {
            var snap = await AiSvc.LoadSnapshot();
            if (snap == null) return;
            _aiSymbols = snap.Meta?.Symbols ?? 0;
            var t = snap.Trades ?? new();
            _wins = t.Count(x => x.Pnl > 0);
            _losses = t.Count(x => x.Pnl <= 0);
            _totalTrades = t.Count;
            _winRate = _totalTrades > 0 ? _wins * 100.0 / _totalTrades : 0;
            _totalPnl = (double)t.Sum(x => x.Pnl);
        }
        catch { }
    }

    async Task LoadSignals()
    {
        try
        {
            var d = await MissedSvc.LoadAsync();
            if (d == null) return;
            _totalBlocked = d.Count;
            _topSymbols = d.GroupBy(r => r.Symbol)
                .Select(g => (g.Key, g.Count(), (int)g.Average(x => x.Confidence)))
                .OrderByDescending(x => x.Item2).ToList();
            _topReasons = d.GroupBy(r => string.IsNullOrEmpty(r.Reason) ? "Unknown" : r.Reason)
                .Select(g => (g.Key, g.Count()))
                .OrderByDescending(x => x.Item2).ToList();
            _recentSignals = d.OrderByDescending(r => r.Time).Take(12)
                .Select(r => new SigRow("BLOCKED", r.Symbol, r.Side, r.Entry, r.Confidence, r.Reason, r.Time))
                .ToList();
        }
        catch { }
    }

    async Task LoadMarkets()
    {
        try
        {
            var series = await MarketSvc.LoadAsync();
            if (series == null) return;
            _markets = series.GroupBy(s => s.Symbol)
                .Select(g =>
                {
                    var s = g.FirstOrDefault(x => x.Timeframe == "FiveMinutes") ?? g.First();
                    var kl = s.Klines;
                    var last = kl.Count > 0 ? kl[^1].Close : 0m;
                    var open = kl.Count > 0 ? kl[0].Close : 0m;
                    var chgPct = open > 0 ? (last - open) / open * 100m : 0m;
                    var volume = kl.Sum(k => k.Volume);
                    var slope = kl.Count >= 5
                        ? (double)(kl[^1].Close - kl[^5].Close) / (double)kl[^5].Close : 0.0;
                    int regime = slope > 0.01 ? 2 : slope > 0.002 ? 1
                               : slope < -0.01 ? 4 : slope < -0.002 ? 3 : 5;
                    return new MarketRow(s.Symbol, s.Timeframe, last, slope, regime, chgPct, volume);
                })
                .OrderByDescending(m => Math.Abs(m.Slope))
                .ToList();
        }
        catch { }
    }

    async Task NavToMarket(string sym)
    {
        try
        {
            // Default timeframe to whatever this symbol's row used
            // (FiveMinutes, confirmed in LoadMarkets above) so the
            // Market page lands on a timeframe that genuinely has
            // data for this symbol, not a guess.
            var tfLabel = "FiveMinutes";

            var existingJson = await JS.InvokeAsync<string?>("sessionStorage.getItem", "vertexMarketState");
            System.Text.Json.Nodes.JsonObject state;
            try
            {
                state = !string.IsNullOrEmpty(existingJson)
                    ? (System.Text.Json.Nodes.JsonNode.Parse(existingJson) as System.Text.Json.Nodes.JsonObject) ?? new()
                    : new();
            }
            catch { state = new(); }

            state["sym"] = sym;
            state["tf"] = tfLabel;

            await JS.InvokeVoidAsync("sessionStorage.setItem", "vertexMarketState", state.ToJsonString());
        }
        catch { /* sessionStorage unavailable — navigate anyway, Market page just falls back to its own default symbol */ }

        Nav.NavigateTo("/market");
    }

    string FP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1) return v.ToString("F4");
        return v.ToString("G5");
    }

    string RegCls(string r) => r?.ToLower() switch
    {
        "stronguptrend" or "uptrend" => "rc-bull",
        "strongdowntrend" or "downtrend" => "rc-bear",
        "range" => "rc-rng",
        "squeeze" => "rc-sq",
        _ => "dim"
    };

    string RegStr(int r) => r switch
    {
        1 => "↑ Bull", 2 => "↑↑ Strong", 3 => "↓ Bear", 4 => "↓↓ Strong",
        5 => "↔ Range", 6 => "⊞ Squeeze", 7 => "~ Volatile", _ => "—"
    };

    string RegimeN(int r) => r switch
    {
        1 or 2 => "ov-reg reg-bull",
        3 or 4 => "ov-reg reg-bear",
        5 => "ov-reg reg-range",
        6 => "ov-reg reg-sq",
        _ => "ov-reg reg-unk"
    };

    (string lbl, string cls) GetSig(MarketRow m) => m.Regime switch
    {
        2 => ("▲ BUY", "ov-sig-badge sig-buy"),
        4 => ("▼ SELL", "ov-sig-badge sig-sell"),
        6 => ("◈ WATCH", "ov-sig-badge sig-watch"),
        _ => ("—", "ov-sig-badge sig-none")
    };

    string RCls(string r)
    {
        if (r.Contains("Exec") || r.Contains("EXEC") || r.Contains("Failed")) return "r";
        if (r.Contains("Balance") || r.Contains("balance") || r.Contains("Notional")) return "y";
        return "dim";
    }

    string RFill(string r)
    {
        if (r.Contains("Exec") || r.Contains("EXEC")) return "rr-exec";
        if (r.Contains("Balance") || r.Contains("Notional")) return "rr-bal";
        return "rr-other";
    }

    string SR(string r) => r switch
    {
        _ when r.Contains("EXECUTION_FAILED") || r.Contains("ExecFailed") => "Exec Failed",
        _ when r.Contains("Balance is zero") => "Balance Zero",
        _ when r.Contains("InsufficientBalance") => "Low Balance",
        _ when r.Contains("MinNotional") || r.Contains("TOO_SMALL") => "Min Notional",
        _ when r.Contains("DRY_RUN") => "Dry Run",
        _ when r.Contains("COOLDOWN") => "Cooldown",
        _ when r.Contains("AI_BLOCK") || r.Contains("AI_PNL") => "AI Block",
        _ when r.Contains("SIDE_NOT") => "Side Blocked",
        _ when r.Contains("OrderBook") => "OB Imbalance",
        _ when string.IsNullOrEmpty(r) => "Unknown",
        _ => r.Length > 16 ? r[..16] + "…" : r
    };

    public void Dispose()
    {
        PnlService.Updated -= OnPnl;
        PnlService.Stop();
        _timer?.Dispose();
    }
}
