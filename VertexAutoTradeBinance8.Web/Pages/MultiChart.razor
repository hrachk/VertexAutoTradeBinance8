@page "/market/multi"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Services
@using Binance.Net.Enums
@inject MarketDataLiveState LiveState
@inject BinanceClientFactory Factory
@inject BinanceAlgoOrderService AlgoOrders
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Vertex · Multi Chart</PageTitle>

<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#0a0d12;--bg1:#0d1117;--bg2:#111827;--bdr:#1a1f2e;--bdr2:#263148;
  --acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#f59e0b;
  --t0:#f1f5f9;--t1:#94a3b8;--t2:#475569;--t3:#1e2d47;
}
html,body{background:var(--bg);overflow:hidden;}
.mc-root{display:flex;flex-direction:column;height:100vh;overflow:hidden;background:var(--bg);}

/* ── TOPBAR ── */
.mc-bar{
  display:flex;align-items:center;gap:6px;
  height:40px;padding:0 10px;flex-shrink:0;
  background:var(--bg1);border-bottom:1px solid var(--bdr);
}
.mc-logo{font-size:13px;font-weight:900;color:var(--t0);letter-spacing:-.3px;margin-right:2px;}
.mc-logo span{color:#38bdf8;}
.mc-sep{width:1px;height:16px;background:var(--bdr2);margin:0 2px;}
.mc-live{width:7px;height:7px;border-radius:50%;background:var(--grn);
  box-shadow:0 0 5px var(--grn);animation:pulse 2s infinite;flex-shrink:0;}
@@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}

/* Layout buttons */
.mc-layouts{display:flex;gap:2px;}
.mc-lay{width:28px;height:24px;border-radius:4px;border:1px solid var(--bdr2);
  background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:all .12s;font-size:10px;font-weight:700;color:var(--t2);}
.mc-lay:hover{border-color:var(--acc);color:var(--t0);}
.mc-lay.on{border-color:var(--acc);background:rgba(59,130,246,.15);color:#93c5fd;}

/* TF buttons */
.mc-tfs{display:flex;gap:1px;}
.mc-tf{height:22px;padding:0 7px;border-radius:3px;border:none;
  background:transparent;color:var(--t2);font-size:11px;font-weight:700;
  cursor:pointer;transition:all .12s;}
.mc-tf:hover{color:var(--t0);background:var(--bg2);}
.mc-tf.on{color:var(--acc);background:rgba(59,130,246,.1);}

/* Position pills */
.mc-pos-pill{display:flex;align-items:center;gap:4px;height:20px;padding:0 7px;
  border-radius:3px;font-size:10px;font-weight:700;font-family:monospace;cursor:default;}
.mc-pos-l{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);color:#4ade80;}
.mc-pos-s{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);color:#f87171;}
.up{color:#4ade80;}.dn{color:#f87171;}

.mc-back{margin-left:auto;display:flex;align-items:center;gap:4px;height:22px;padding:0 9px;
  background:transparent;border:1px solid var(--bdr2);border-radius:4px;
  color:var(--t2);font-size:11px;font-weight:700;cursor:pointer;text-decoration:none;
  transition:all .12s;}
.mc-back:hover{color:var(--t0);border-color:var(--acc);}

/* ── GRID ── */
.mc-grid{flex:1;display:grid;gap:2px;background:var(--bdr);padding:2px;min-height:0;}
.mc-grid.c1{grid-template-columns:1fr;grid-template-rows:1fr;}
.mc-grid.c2{grid-template-columns:1fr 1fr;grid-template-rows:1fr;}
.mc-grid.c3{grid-template-columns:1fr 1fr 1fr;grid-template-rows:1fr;}
.mc-grid.c4{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;}
.mc-grid.c6{grid-template-columns:1fr 1fr 1fr;grid-template-rows:1fr 1fr;}

/* ── PANEL ── */
.mc-panel{background:var(--bg);display:flex;flex-direction:column;min-height:0;
  position:relative;cursor:pointer;}
.mc-panel.active{outline:1.5px solid var(--acc);outline-offset:-1px;z-index:2;}

/* Panel header */
.mc-ph{display:flex;align-items:center;gap:5px;height:28px;padding:0 8px;flex-shrink:0;
  background:var(--bg1);border-bottom:1px solid var(--bdr);user-select:none;}
.mc-ph-sym{font-size:12px;font-weight:800;color:var(--t0);}
.mc-ph-tf{font-size:9px;font-weight:700;color:var(--t2);background:var(--bdr);
  padding:1px 5px;border-radius:2px;}
.mc-ph-price{font-size:11px;font-weight:700;font-family:monospace;margin-left:auto;}
.mc-ph-chg{font-size:10px;font-family:monospace;font-weight:700;}
.mc-ph-x{width:16px;height:16px;border:none;background:transparent;color:var(--t2);
  cursor:pointer;font-size:12px;line-height:1;border-radius:2px;
  display:flex;align-items:center;justify-content:center;}
.mc-ph-x:hover{background:rgba(239,68,68,.15);color:var(--red);}
.mc-pos-tag{font-size:9.5px;font-family:monospace;font-weight:800;
  padding:1px 5px;border-radius:2px;white-space:nowrap;}
.mc-pt-l{background:rgba(34,197,94,.1);color:#4ade80;}
.mc-pt-s{background:rgba(239,68,68,.1);color:#f87171;}

/* Panel TF row */
.mc-ptfs{display:flex;gap:1px;padding:2px 6px;flex-shrink:0;
  background:rgba(10,13,18,.9);border-bottom:1px solid var(--bdr);}
.mc-ptf{height:16px;padding:0 5px;background:none;border:none;
  color:var(--t2);font-size:9px;font-weight:700;cursor:pointer;border-radius:2px;}
.mc-ptf:hover{color:var(--t0);background:var(--bdr2);}
.mc-ptf.on{color:var(--acc);}

/* Chart canvas */
.mc-chart{flex:1;min-height:0;position:relative;}
.mc-chart > div{width:100%;height:100%;}

/* Loading overlay */
.mc-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(10,13,18,.8);z-index:10;}
.mc-spin{width:20px;height:20px;border:2px solid var(--bdr2);
  border-top-color:var(--acc);border-radius:50%;animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}
.mc-err{font-size:10px;color:var(--red);font-family:monospace;padding:8px;text-align:center;}

/* Add panel slot */
.mc-add{background:var(--bg);display:flex;flex-direction:column;
  align-items:center;justify-content:center;cursor:pointer;gap:6px;
  border:1.5px dashed var(--bdr2);transition:all .15s;}
.mc-add:hover{border-color:var(--acc);background:rgba(59,130,246,.04);}
.mc-add-icon{font-size:22px;color:var(--t3);}
.mc-add-txt{font-size:11px;color:var(--t2);}

/* Symbol picker */
.mc-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);
  display:flex;align-items:center;justify-content:center;z-index:200;}
.mc-picker{background:var(--bg1);border:1px solid var(--bdr2);border-radius:10px;
  width:340px;max-height:460px;display:flex;flex-direction:column;overflow:hidden;}
.mc-picker-head{display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px;border-bottom:1px solid var(--bdr);
  font-size:13px;font-weight:700;color:var(--t0);}
.mc-picker-head button{background:none;border:none;color:var(--t2);cursor:pointer;font-size:16px;}
.mc-picker-inp{padding:10px 12px;border-bottom:1px solid var(--bdr);}
.mc-picker-inp input{width:100%;background:var(--bg2);border:1px solid var(--bdr2);
  border-radius:5px;padding:6px 10px;color:var(--t0);font-size:12px;outline:none;font-family:inherit;}
.mc-picker-list{flex:1;overflow-y:auto;}
.mc-picker-item{display:flex;align-items:center;justify-content:space-between;
  padding:8px 16px;cursor:pointer;border-bottom:1px solid var(--bdr);transition:background .1s;}
.mc-picker-item:hover{background:var(--bg2);}
.mc-picker-sym{font-size:12px;font-weight:700;color:var(--t0);}
.mc-picker-price{font-size:11px;font-family:monospace;color:var(--t2);}
</style>

<div class="mc-root">

  <!-- TOP BAR -->
  <div class="mc-bar">
    <div class="mc-logo">VERTEX <span>AI</span></div>
    <div class="mc-sep"></div>
    <div class="mc-live"></div>
    <div class="mc-sep"></div>

    <!-- Layout presets -->
    <div class="mc-layouts">
      @foreach (var (lay, label) in new[]{("c1","1"),("c2","2"),("c3","3"),("c4","4"),("c6","6")})
      {
        var l = lay;
        <button class="mc-lay @(_layout==l?"on":"")" @onclick="()=>SetLayout(l)" title="@label charts">@label</button>
      }
    </div>
    <div class="mc-sep"></div>

    <!-- Global TF -->
    <div class="mc-tfs">
      @foreach (var tf in new[]{"1m","3m","5m","15m","30m","1h","4h","1d"})
      {
        var t = tf;
        <button class="mc-tf @(_globalTf==t?"on":"")" @onclick="()=>SetGlobalTf(t)">@t</button>
      }
    </div>

    <!-- Position pills -->
    @if (_positions.Any())
    {
      <div class="mc-sep"></div>
      @foreach (var pos in _positions.Take(6))
      {
        bool pl = pos.Side == "LONG";
        <div class="mc-pos-pill @(pl?"mc-pos-l":"mc-pos-s")" title="@PosPillTitle(pos)">
          @pos.Symbol.Replace("USDT","")
          <span class="@(pos.Pnl>=0?"up":"dn")">@(pos.Pnl>=0?"+":"")@pos.Pnl.ToString("F1")</span>
        </div>
      }
    }

    <a class="mc-back" href="/market">← Market</a>
  </div>

  <!-- CHART GRID -->
  <div class="mc-grid @_layout">
    @for (int slot = 0; slot < SlotCount(); slot++)
    {
      var s = slot;
      @if (s < _panels.Count)
      {
        var panel = _panels[s];
        decimal lp   = _prices.TryGetValue(panel.Symbol, out var plp) ? plp : 0m;
        decimal prev = _prevPrices.TryGetValue(panel.Symbol, out var pp) ? pp : lp;
        bool    pUp  = lp >= prev;
        decimal chg  = prev > 0 && prev != lp ? (lp - prev) / prev * 100m : 0m;
        var myPos = _positions.Where(p =>
            p.Symbol == panel.Symbol &&
            (!panel.IsPositionPanel || p.Side == panel.Side)
        ).ToList();

        <div class="mc-panel @(_activeSlot==s?"active":"")" @onclick="()=>_activeSlot=s">

          <!-- Header -->
          <div class="mc-ph">
            <span class="mc-ph-sym">@panel.Symbol.Replace("USDT","")<span style="color:var(--t3);font-size:10px">/USDT</span></span>
            <span class="mc-ph-tf">@panel.Tf</span>
            @foreach (var pos in myPos)
            {
              <span class="mc-pos-tag @(pos.Side=="LONG"?"mc-pt-l":"mc-pt-s")">
                @(pos.Side=="LONG"?"▲":"▼") @(pos.Pnl>=0?"+":"")@pos.Pnl.ToString("F1")
              </span>
            }
            @if (lp > 0)
            {
              <span class="mc-ph-price @(pUp?"up":"dn")" style="margin-left:auto">@FP(lp)</span>
              @if (chg != 0)
              {
                <span class="mc-ph-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F2")%</span>
              }
            }
            else { <span style="margin-left:auto"></span> }
            <button class="mc-ph-x" @onclick:stopPropagation="true" @onclick="()=>RemovePanel(s)" title="Close">✕</button>
          </div>

          <!-- Per-panel TF -->
          <div class="mc-ptfs" @onclick:stopPropagation="true">
            @foreach (var tf in new[]{"1m","3m","5m","15m","30m","1h","4h","1d"})
            {
              var t2 = tf;
              <button class="mc-ptf @(panel.Tf==t2?"on":"")" @onclick="()=>ChangePanelTf(s,t2)">@t2</button>
            }
          </div>

          <!-- Chart container -->
          <div class="mc-chart">
            <div id="mc-chart-@(s)"></div>
            @if (panel.Loading)
            {
              <div class="mc-loading"><div class="mc-spin"></div></div>
            }
            @if (!string.IsNullOrEmpty(panel.Error))
            {
              <div class="mc-loading"><div class="mc-err">@panel.Error</div></div>
            }
          </div>

        </div>
      }
      else
      {
        <div class="mc-add" @onclick="()=>OpenPicker(s)">
          <div class="mc-add-icon">+</div>
          <div class="mc-add-txt">Add chart</div>
        </div>
      }
    }
  </div>

  <!-- Symbol picker -->
  @if (_pickerOpen)
  {
    <div class="mc-overlay" @onclick="ClosePicker">
      <div class="mc-picker" @onclick:stopPropagation="true">
        <div class="mc-picker-head">
          <span>Select Symbol</span>
          <button @onclick="ClosePicker">✕</button>
        </div>
        <div class="mc-picker-inp">
          <input placeholder="Search BTCUSDT, ETH…"
                 @bind="_pickerSearch" @bind:event="oninput" autofocus />
        </div>
        <div class="mc-picker-list">
          @foreach (var sym in FilteredSymbols())
          {
            var sym2 = sym;
            var symPos = _positions.FirstOrDefault(p => p.Symbol == sym2);
            <div class="mc-picker-item" @onclick="()=>PickSymbol(sym2)">
              <div style="display:flex;align-items:center;gap:6px;">
                <span class="mc-picker-sym">@sym2.Replace("USDT","")<span style="color:var(--t2);font-size:10px"> /USDT</span></span>
                @if (symPos != null)
                {
                  <span class="mc-pos-tag @(symPos.Side=="LONG"?"mc-pt-l":"mc-pt-s")" style="font-size:9px">
                    @(symPos.Side=="LONG"?"▲":"▼")
                  </span>
                }
              </div>
              <span class="mc-picker-price">@FP(_prices.TryGetValue(sym2, out var px) ? px : 0m)</span>
            </div>
          }
        </div>
      </div>
    </div>
  }

</div>

@code {
    // ── Layout ────────────────────────────────────────────────────
    string _layout    = "c4";
    string _globalTf  = "5m";
    int    _activeSlot = 0;

    int SlotCount() => _layout switch {
        "c1" => 1, "c2" => 2, "c3" => 3, "c4" => 4, "c6" => 6, _ => 4
    };

    // ── Panel model ───────────────────────────────────────────────
    class Panel
    {
        public string Symbol  = "";
        public string Side    = "";   // "LONG", "SHORT", or "" for manual/watch panels
        public string Tf      = "5m";
        public bool   Loading = false;
        public string Error   = "";
        public bool IsPositionPanel => !string.IsNullOrEmpty(Side);
    }
    List<Panel> _panels = new();

    // ── Position model ────────────────────────────────────────────
    record PositionInfo(string Symbol, string Side, decimal EntryPrice,
                        decimal Qty, decimal LiqPrice, decimal Pnl);
    internal List<PositionInfo> _positions = new();

    // ── Prices ───────────────────────────────────────────────────
    Dictionary<string, decimal> _prices     = new();
    Dictionary<string, decimal> _prevPrices = new();

    // ── Symbol list ───────────────────────────────────────────────
    List<string> _allSymbols = new()
    {
        "BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT","DOGEUSDT",
        "AVAXUSDT","LINKUSDT","OPUSDT","ARBUSDT","SUIUSDT","PEPEUSDT",
        "AAVEUSDT","DOTUSDT","ADAUSDT","MATICUSDT","LTCUSDT","FILUSDT"
    };

    // ── Picker ────────────────────────────────────────────────────
    bool   _pickerOpen   = false;
    int    _pickerSlot   = 0;
    string _pickerSearch = "";

    // ── Timer ─────────────────────────────────────────────────────
    System.Threading.PeriodicTimer? _timer;
    CancellationTokenSource _cts = new();

    // ── Lifecycle ─────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        LiveState.PriceTicked += OnTick;
        await LoadPositionsAsync();
        RebuildPositionPanels();
        _ = InvokeAsync(RunTimerAsync);
    }

    // Rebuilds panels from current positions.
    // One panel per POSITION (not per symbol) — so UBUSDT LONG + UBUSDT SHORT
    // get TWO separate charts, each showing its own side's entry/liq/PnL.
    void RebuildPositionPanels()
    {
        // Preserve existing TF preferences
        var tfMap = _panels.ToDictionary(p => p.Symbol + "|" + p.Side, p => p.Tf);

        var newPanels = _positions
            .Select(pos => new Panel
            {
                Symbol  = pos.Symbol,
                Side    = pos.Side,
                Tf      = tfMap.TryGetValue(pos.Symbol + "|" + pos.Side, out var tf) ? tf : _globalTf,
                Loading = false,
                Error   = "",
            })
            .ToList();

        // If no positions open — show default watch symbols
        if (!newPanels.Any())
        {
            foreach (var sym in new[]{"BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT"})
                newPanels.Add(new Panel { Symbol = sym, Side = "", Tf = _globalTf });
        }

        _panels = newPanels;

        // Auto-select layout based on panel count
        _layout = _panels.Count switch {
            1 => "c1", 2 => "c2", 3 => "c3", 4 => "c4", _ => "c6"
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Init charts in parallel — all panels simultaneously
        await Task.WhenAll(_panels.Select((p, i) => InitPanelAsync(i)));
    }

    public async ValueTask DisposeAsync()
    {
        LiveState.PriceTicked -= OnTick;
        _cts.Cancel();
        _timer?.Dispose();
        DisposeChartRefs();
        for (int i = 0; i < _panels.Count; i++)
        {
            try { await JS.InvokeVoidAsync("marketChart.dispose", $"mc-chart-{i}"); }
            catch { }
        }
    }

    async Task RunTimerAsync()
    {
        _timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(8));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                var prevCount = _positions.Count;
                var prevKeys  = _positions.Select(p => p.Symbol + p.Side).OrderBy(x => x).ToList();

                await LoadPositionsAsync();
                await LoadOpenOrdersAsync();

                var newKeys = _positions.Select(p => p.Symbol + p.Side).OrderBy(x => x).ToList();
                bool positionsChanged = !prevKeys.SequenceEqual(newKeys);

                if (positionsChanged)
                {
                    // Positions opened/closed — rebuild panels and re-init charts
                    RebuildPositionPanels();
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(80);
                    await Task.WhenAll(Enumerable.Range(0, _panels.Count).Select(i => InitPanelAsync(i)));
                }
                else
                {
                    await InvokeAsync(StateHasChanged);
                    for (int i = 0; i < _panels.Count; i++)
                        await RefreshPositionLinesAsync(i);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Positions ─────────────────────────────────────────────────
    async Task LoadPositionsAsync()
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account.GetPositionInformationAsync(ct: cts2.Token);
            if (!res.Success || res.Data == null) return;
            _positions = res.Data
                .Where(p => Math.Abs(p.Quantity) > 0.000001m)
                .Select(p => new PositionInfo(
                    p.Symbol,
                    p.Quantity > 0 ? "LONG" : "SHORT",
                    p.EntryPrice,
                    Math.Abs(p.Quantity),
                    p.LiquidationPrice,
                    p.UnrealizedPnl))
                .ToList();
        }
        catch { }
    }

    async Task RefreshPositionLinesAsync(int slot)
    {
        if (slot >= _panels.Count) return;
        var panel = _panels[slot];
        var cid   = $"mc-chart-{slot}";
        if (panel.Loading || !string.IsNullOrEmpty(panel.Error)) return;

        // Match position by BOTH Symbol AND Side (handles hedge: UBUSDT LONG + UBUSDT SHORT)
        var pos = panel.IsPositionPanel
            ? _positions.FirstOrDefault(p => p.Symbol == panel.Symbol && p.Side == panel.Side)
            : null;

        try
        {
            if (pos != null)
            {
                await JS.InvokeVoidAsync("marketChart.showPositionLines",
                    cid, (double)pos.EntryPrice, pos.Side,
                    (double)pos.Qty, (double)pos.LiqPrice, 0.0);

                decimal liveP = _prices.TryGetValue(pos.Symbol, out var lp) ? lp : pos.EntryPrice;
                if (liveP > 0)
                    await JS.InvokeVoidAsync("marketChart.updatePnl", cid, (double)liveP);
            }
            else
                await JS.InvokeVoidAsync("marketChart.hidePositionLines", cid);
        }
        catch { }
    }

    // ── Live price tick ───────────────────────────────────────────
    void OnTick(string sym, decimal price)
    {
        if (_prices.TryGetValue(sym, out var old)) _prevPrices[sym] = old;
        _prices[sym] = price;

        bool relevant = _panels.Any(p => p.Symbol == sym);
        if (!relevant) return;

        _ = InvokeAsync(async () =>
        {
            long nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            for (int i = 0; i < _panels.Count; i++)
            {
                var panel2 = _panels[i];
                if (panel2.Symbol != sym) continue;
                if (panel2.Loading || !string.IsNullOrEmpty(panel2.Error)) continue;

                // Compute openTime = start of current candle for this TF
                // This MUST match the openTime of the last kline in the chart,
                // otherwise updateLastBar creates a new bar instead of updating.
                long tfMs = TfToMilliseconds(panel2.Tf);
                long barOpenMs = tfMs > 0 ? (nowMs / tfMs) * tfMs : nowMs;

                try
                {
                    await JS.InvokeVoidAsync("marketChart.updateLastBar",
                        $"mc-chart-{i}",
                        new
                        {
                            openTime       = barOpenMs,
                            open           = (double)price,
                            high           = (double)price,
                            low            = (double)price,
                            close          = (double)price,
                            volume         = 0.0,
                            takerBuyVolume = 0.0
                        });

                    // Update PnL line — match by Symbol AND Side
                    var pos2 = panel2.IsPositionPanel
                        ? _positions.FirstOrDefault(p => p.Symbol == sym && p.Side == panel2.Side)
                        : _positions.FirstOrDefault(p => p.Symbol == sym);
                    if (pos2 != null)
                        await JS.InvokeVoidAsync("marketChart.updatePnl",
                            $"mc-chart-{i}", (double)price);
                }
                catch { }
            }
            StateHasChanged();
        });
    }

    // ── Chart init ────────────────────────────────────────────────
    async Task InitPanelAsync(int slot)
    {
        if (slot >= _panels.Count) return;
        var panel = _panels[slot];
        var cid   = $"mc-chart-{slot}";

        panel.Loading = true;
        panel.Error   = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Step 1: init the TradingView chart
            await JS.InvokeVoidAsync("marketChart.init", cid);

            // Step 2: fetch klines from Binance Futures API
            var klines = await FetchKlinesAsync(panel.Symbol, panel.Tf);

            if (klines == null || klines.Count == 0)
            {
                panel.Error   = $"No data for {panel.Symbol} {panel.Tf}";
                panel.Loading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Step 3: send to JS — MUST use openTime (ms) field name
            // toCandle(k) does: { time: Math.floor(k.openTime / 1000) ... }
            // If we send 'time' instead of 'openTime', JS gets openTime=undefined
            // → Math.floor(undefined/1000) = NaN → all bars collapse to ONE bar
            var jsData = klines.Select(k => new
            {
                openTime       = k.OpenTime,        // unix milliseconds — JS divides by 1000
                open           = (double)k.Open,
                high           = (double)k.High,
                low            = (double)k.Low,
                close          = (double)k.Close,
                volume         = (double)k.Volume,
                takerBuyVolume = 0.0
            }).ToArray();

            await JS.InvokeVoidAsync("marketChart.setData", cid, jsData);

            // Track live price
            if (!_prices.ContainsKey(panel.Symbol) && klines.Count > 0)
                _prices[panel.Symbol] = klines[^1].Close;

            panel.Loading = false;
            panel.Error   = "";
            await InvokeAsync(StateHasChanged);

            // Step 4: overlay position lines + TP/SL drag lines
            await RefreshPositionLinesAsync(slot);
            await RefreshTpSlLinesAsync(slot);

            // Step 5: bind drag callbacks so JS can call back into Blazor
            // when user drags SL/TP lines or right-clicks to add TP
            var dotNet = DotNetObjectReference.Create(new ChartCallbackBridge(
                this, slot, panel.Symbol, panel.Side));
            _chartRefs[slot] = dotNet;
            try { await JS.InvokeVoidAsync("marketChart.bindSlTpCallbacks", cid, dotNet); }
            catch { }
        }
        catch (Exception ex)
        {
            panel.Error   = $"Error: {ex.Message[..Math.Min(50, ex.Message.Length)]}";
            panel.Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Fetch klines from Binance Futures ────────────────────────
    async Task<List<KlineDto>?> FetchKlinesAsync(string symbol, string tf)
    {
        var client = Factory.TryCreateRestClient();
        if (client == null) return null;

        var interval = tf switch
        {
            "1m"  => KlineInterval.OneMinute,
            "3m"  => KlineInterval.ThreeMinutes,
            "5m"  => KlineInterval.FiveMinutes,
            "15m" => KlineInterval.FifteenMinutes,
            "30m" => KlineInterval.ThirtyMinutes,
            "1h"  => KlineInterval.OneHour,
            "4h"  => KlineInterval.FourHour,
            "1d"  => KlineInterval.OneDay,
            _     => KlineInterval.FiveMinutes,
        };

        using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(12));
        var res = await client.UsdFuturesApi.ExchangeData.GetKlinesAsync(
            symbol, interval, limit: 300, ct: cts2.Token);

        if (!res.Success || res.Data == null) return null;

        // KlineDto is positional record: KlineDto(long OpenTime, decimal Open, High, Low, Close, Volume)
        // k.OpenTime from Binance is DateTime → convert to unix milliseconds
        return res.Data.Select(k => new KlineDto(
            new DateTimeOffset(k.OpenTime, TimeSpan.Zero).ToUnixTimeMilliseconds(),
            k.OpenPrice, k.HighPrice, k.LowPrice, k.ClosePrice, k.Volume
        )).ToList();
    }

    // ── Layout / TF ───────────────────────────────────────────────
    async Task SetLayout(string layout)
    {
        _layout = layout;
        // Ensure panel count matches slot count
        while (_panels.Count < SlotCount())
        {
            var defaults = new[]{"BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT","DOGEUSDT"};
            var sym = defaults.ElementAtOrDefault(_panels.Count) ?? "BTCUSDT";
            _panels.Add(new Panel { Symbol = sym, Tf = _globalTf });
        }
        StateHasChanged();
        await Task.Delay(80); // DOM re-render
        await Task.WhenAll(Enumerable.Range(0, SlotCount()).Select(i => InitPanelAsync(i)));
    }

    async Task SetGlobalTf(string tf)
    {
        _globalTf = tf;
        _panels.ForEach(p => p.Tf = tf);
        StateHasChanged();
        await Task.Delay(40);
        await Task.WhenAll(Enumerable.Range(0, _panels.Count).Select(i => InitPanelAsync(i)));
    }

    async Task ChangePanelTf(int slot, string tf)
    {
        if (slot >= _panels.Count) return;
        _panels[slot].Tf = tf;
        await InitPanelAsync(slot);
    }

    // ── Panel management ──────────────────────────────────────────
    void OpenPicker(int slot) { _pickerSlot = slot; _pickerSearch = ""; _pickerOpen = true; }
    void ClosePicker()        { _pickerOpen = false; }

    async Task PickSymbol(string symbol)
    {
        _pickerOpen = false;
        if (_pickerSlot < _panels.Count)
            _panels[_pickerSlot].Symbol = symbol;
        else
            while (_panels.Count <= _pickerSlot)
                _panels.Add(new Panel { Symbol = symbol, Tf = _globalTf });
        StateHasChanged();
        await Task.Delay(50);
        await InitPanelAsync(_pickerSlot);
    }

    async Task RemovePanel(int slot)
    {
        if (slot >= _panels.Count) return;
        try { await JS.InvokeVoidAsync("marketChart.dispose", $"mc-chart-{slot}"); } catch { }
        _panels.RemoveAt(slot);
        StateHasChanged();
        await Task.Delay(50);
        await Task.WhenAll(Enumerable.Range(slot, _panels.Count - slot).Select(i => InitPanelAsync(i)));
    }

    // ── Helpers ───────────────────────────────────────────────────
    IEnumerable<string> FilteredSymbols()
    {
        var q = _pickerSearch.Trim().ToUpperInvariant();
        var posSyms = _positions.Select(p => p.Symbol).ToList();
        var ordered = posSyms.Concat(_allSymbols.Where(s => !posSyms.Contains(s))).Distinct();
        return string.IsNullOrEmpty(q) ? ordered.Take(40) : ordered.Where(s => s.Contains(q)).Take(40);
    }

    string PosPillTitle(PositionInfo pos) =>
        $"{pos.Symbol} {pos.Side} {(pos.Pnl >= 0 ? "+" : "")}{pos.Pnl:F2} USDT";

    // ── Open orders ──────────────────────────────────────────
    async Task LoadOpenOrdersAsync()
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Trading.GetOpenOrdersAsync(ct: cts2.Token);
            if (!res.Success || res.Data == null) return;
            _openOrders = res.Data.Select(o => new OrderRow
            {
                OrderId      = o.Id,
                Symbol       = o.Symbol,
                Side         = o.Side.ToString().ToUpperInvariant(),
                PositionSide = o.PositionSide.ToString().ToUpperInvariant(),
                Type         = o.Type.ToString().ToUpperInvariant(),
                Price        = (o.StopPrice ?? 0m) > 0 ? (o.StopPrice ?? 0m) : o.Price,
                Qty          = o.Quantity,
                ReduceOnly   = o.ReduceOnly,
            }).ToList();
        }
        catch { }
    }

    // ── TP/SL lines per panel ─────────────────────────────────
    internal async Task RefreshTpSlLinesAsync(int slot)
    {
        if (slot >= _panels.Count) return;
        var panel = _panels[slot];
        var cid   = $"mc-chart-{slot}";
        var pos   = panel.IsPositionPanel
            ? _positions.FirstOrDefault(p => p.Symbol == panel.Symbol && p.Side == panel.Side)
            : null;
        if (pos == null || panel.Loading || !string.IsNullOrEmpty(panel.Error)) return;

        bool MatchOrder(OrderRow o) =>
            o.Symbol == pos.Symbol && o.ReduceOnly &&
            (o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

        decimal sl  = _openOrders.FirstOrDefault(o => MatchOrder(o) && o.Type.Contains("STOP"))?.Price ?? 0m;
        decimal[] tps = _openOrders
            .Where(o => MatchOrder(o) && o.Type.Contains("TAKE_PROFIT"))
            .OrderBy(o => pos.Side == "LONG" ? o.Price : -o.Price)
            .Select(o => o.Price).ToArray();

        try
        {
            await JS.InvokeVoidAsync("marketChart.showTpSlLines",
                cid, (double)pos.EntryPrice, (double)sl, tps.Select(p => (double)p).ToArray(), pos.Side);
        }
        catch { }
    }

    // ── Cancel existing SL or TP order ────────────────────────
    internal async Task CancelProtectiveLevelAsync(string symbol, string side,
        bool isStopLoss, int tpIndex = -1)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            bool MatchOrder(OrderRow o) =>
                o.Symbol == symbol && o.ReduceOnly &&
                (o.PositionSide == "BOTH" || o.PositionSide == side);

            long? orderId = null;
            if (isStopLoss)
            {
                orderId = _openOrders
                    .FirstOrDefault(o => MatchOrder(o) && o.Type.Contains("STOP"))?.OrderId;
            }
            else
            {
                var tpOrders = _openOrders
                    .Where(o => MatchOrder(o) && o.Type.Contains("TAKE_PROFIT"))
                    .OrderBy(o => side == "LONG" ? o.Price : -o.Price).ToList();
                if (tpIndex >= 0 && tpIndex < tpOrders.Count)
                    orderId = tpOrders[tpIndex].OrderId;
            }

            if (orderId == null) return;
            using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            await client.UsdFuturesApi.Trading.CancelOrderAsync(symbol, orderId.Value, ct: cts2.Token);
            await LoadOpenOrdersAsync();
        }
        catch { }
    }

    // ── Place new SL or TP via Algo Orders API ────────────────
    internal async Task PlaceProtectiveLevelAsync(string symbol, string side,
        decimal qty, bool isStopLoss, decimal price)
    {
        if (price <= 0 || qty <= 0) return;
        try
        {
            var closeSide = side == "LONG"
                ? Binance.Net.Enums.OrderSide.Sell
                : Binance.Net.Enums.OrderSide.Buy;
            var posSide = side == "LONG"
                ? Binance.Net.Enums.PositionSide.Long
                : Binance.Net.Enums.PositionSide.Short;

            string algoId = $"MC_{(isStopLoss?"SL":"TP")}_{DateTime.UtcNow.Ticks}";
            if (algoId.Length > 32) algoId = algoId[..32];
            string orderType = isStopLoss ? "STOP_MARKET" : "TAKE_PROFIT_MARKET";

            await AlgoOrders.PlaceConditionalAsync(
                symbol: symbol, side: closeSide, positionSide: posSide,
                type: orderType, quantity: qty, triggerPrice: price,
                workingType: "MARK_PRICE", reduceOnly: true,
                ct: CancellationToken.None, clientAlgoId: algoId);

            await LoadOpenOrdersAsync();
        }
        catch { }
    }

    // ── Dispose chart DotNet refs ─────────────────────────────
    void DisposeChartRefs()
    {
        foreach (var kv in _chartRefs) kv.Value.Dispose();
        _chartRefs.Clear();
    }

    // Returns the candle duration in milliseconds for a given TF label.
    // Used to compute barOpenMs = floor(nowMs / tfMs) * tfMs
    // so updateLastBar always uses the correct candle start time.
    static long TfToMilliseconds(string tf) => tf switch
    {
        "1m"  => 60_000L,
        "3m"  => 180_000L,
        "5m"  => 300_000L,
        "15m" => 900_000L,
        "30m" => 1_800_000L,
        "1h"  => 3_600_000L,
        "4h"  => 14_400_000L,
        "1d"  => 86_400_000L,
        _     => 300_000L,
    };

    string FP(decimal v)
    {
        if (v <= 0)       return "—";
        if (v >= 10000)   return v.ToString("F1");
        if (v >= 1000)    return v.ToString("F2");
        if (v >= 1)       return v.ToString("F4");
        if (v >= 0.01m)   return v.ToString("F5");
        return v.ToString("G6");
    }


    // ─────────────────────────────────────────────────────────────────
    // Per-panel callback bridge — receives JS drag events for this
    // specific chart panel (Symbol + Side). Defined inside @code so
    // Razor compiles it correctly as C#, not as HTML markup.
    // ─────────────────────────────────────────────────────────────────
    class OrderRow
    {
        public long   OrderId;
        public string Symbol       = "";
        public string Side         = "";
        public string PositionSide = "";
        public string Type         = "";
        public decimal Price;
        public decimal Qty;
        public bool   ReduceOnly;
    }

    class ChartCallbackBridge
    {
        private readonly MultiChart _page;
        private readonly int        _slot;
        private readonly string     _symbol;
        private readonly string     _side;

        public ChartCallbackBridge(MultiChart page, int slot, string symbol, string side)
        {
            _page = page; _slot = slot; _symbol = symbol; _side = side;
        }

        private PositionInfo? Pos() => _page._positions
            .FirstOrDefault(p => p.Symbol == _symbol && p.Side == _side);

        [JSInvokable]
        public async Task OnSlDragged(decimal price, decimal originalPrice = 0)
        {
            if (price <= 0 || _page._slTpDragBusy) return;
            _page._slTpDragBusy = true;
            try
            {
                var pos = Pos();
                if (pos == null) return;
                await _page.CancelProtectiveLevelAsync(_symbol, _side, isStopLoss: true);
                await Task.Delay(80);
                await _page.PlaceProtectiveLevelAsync(_symbol, _side, pos.Qty, true, price);
                await _page.InvokeAsync(async () =>
                {
                    await _page.RefreshTpSlLinesAsync(_slot);
                    _page.StateHasChanged();
                });
            }
            finally { _page._slTpDragBusy = false; }
        }

        [JSInvokable]
        public async Task OnTpDragged(decimal price, decimal originalPrice = 0) =>
            await OnTpDraggedAt(0, price, originalPrice);

        [JSInvokable]
        public async Task OnTpDraggedAt(int tpIndex, decimal price, decimal originalPrice = 0)
        {
            if (price <= 0 || _page._slTpDragBusy) return;
            _page._slTpDragBusy = true;
            try
            {
                var pos = Pos();
                if (pos == null) return;
                await _page.CancelProtectiveLevelAsync(_symbol, _side, false, tpIndex);
                await Task.Delay(80);
                await _page.PlaceProtectiveLevelAsync(_symbol, _side, pos.Qty, false, price);
                await _page.InvokeAsync(async () =>
                {
                    await _page.RefreshTpSlLinesAsync(_slot);
                    _page.StateHasChanged();
                });
            }
            finally { _page._slTpDragBusy = false; }
        }

        [JSInvokable]
        public async Task OnNewTpRequested(decimal price)
        {
            if (price <= 0) return;
            var pos = Pos();
            if (pos == null) return;
            await _page.PlaceProtectiveLevelAsync(_symbol, _side, pos.Qty, false, price);
            await _page.InvokeAsync(async () =>
            {
                await _page.RefreshTpSlLinesAsync(_slot);
                _page.StateHasChanged();
            });
        }

        [JSInvokable]
        public async Task OnNewTpRequestedWithPercent(decimal price, decimal pct) =>
            await OnNewTpRequested(price);

        [JSInvokable]
        public async Task OnCancelProtectiveLevel(string kind, int index)
        {
            await _page.CancelProtectiveLevelAsync(_symbol, _side, kind == "sl", index);
            await _page.InvokeAsync(async () =>
            {
                await _page.RefreshTpSlLinesAsync(_slot);
                _page.StateHasChanged();
            });
        }

        [JSInvokable] public Task OnLimitOrderRequested(string side, decimal price, decimal qty) => Task.CompletedTask;
        [JSInvokable] public Task OnPricePicked(decimal price) => Task.CompletedTask;
        [JSInvokable] public Task<object[]> LoadMoreHistoryAsync(long b, int c) => Task.FromResult(Array.Empty<object>());
    }

}

