@page "/help"
@page "/docs"
@using System.Globalization

<div class="hx-root" data-lang="@_lang">
    <aside class="hx-nav">
        <div class="hx-brand">
            <div class="hx-logo">V</div>
            <div>
                <div class="hx-brand-title">VERTEX</div>
                <div class="hx-brand-sub">@T("help.brand_sub")</div>
            </div>
        </div>

        <div class="hx-lang">
            <button type="button" class="@(_lang=="ru"?"on":null)" @onclick='() => SetLang("ru")'>RU</button>
            <button type="button" class="@(_lang=="en"?"on":null)" @onclick='() => SetLang("en")'>EN</button>
        </div>

        <input class="hx-search" @bind="_query" @bind:event="oninput" placeholder="@T("help.search")" />

        <nav class="hx-toc">
            @foreach (var item in FilteredToc)
            {
                <button type="button" class="hx-toc-item @(_section == item.Id ? "active" : null)"
                        @onclick="() => Go(item.Id)">
                    <span class="hx-ico">@item.Icon</span>
                    <span>@item.Label</span>
                </button>
            }
        </nav>

        <div class="hx-nav-foot">
            <a href="/market">Market</a>
            <a href="/settings">Settings</a>
            <a href="/ai-dashboard">AI</a>
            <a href="/macro-news">News</a>
        </div>
    </aside>

    <main class="hx-main">
        <header class="hx-header">
            <div>
                <h1>@CurrentTitle</h1>
                <p class="hx-lead">@CurrentLead</p>
            </div>
            <div class="hx-badge">Expert v2.0 · Production</div>
        </header>

        @if (_section == "quick")
        {
            <section class="hx-section">
                <div class="hx-grid-3">
                    <div class="hx-card step">
                        <div class="hx-step">1</div>
                        <h3>@T("quick.s1_t")</h3>
                        <p>@T("quick.s1_p")</p>
                        <pre class="hx-code">SharedData:Root → same folder for Engine + Web
vertex_journal.db · vertex_system.db
client_xxx/approved_entries.json</pre>
                    </div>
                    <div class="hx-card step">
                        <div class="hx-step">2</div>
                        <h3>@T("quick.s2_t")</h3>
                        <p>@T("quick.s2_p")</p>
                        <pre class="hx-code">1) Start Engine (worker)
2) Start Web → :5101
Logs: [TIME-SYNC] [DUAL-MODE] [ROUTER]</pre>
                    </div>
                    <div class="hx-card step">
                        <div class="hx-step">3</div>
                        <h3>@T("quick.s3_t")</h3>
                        <p>@T("quick.s3_p")</p>
                        <pre class="hx-code">Demo $10,000 independent of exchange
Enable Demo AutoTrade → paper only
Then Live only after 30–50 Demo trades</pre>
                    </div>
                </div>

                <div class="hx-callout ok">
                    <strong>@T("quick.defaults_t")</strong>
                    <p>@T("quick.defaults_p")</p>
                    <ul class="hx-list">
                        <li>MaxOpenPositions = <b>4</b></li>
                        <li>MaxSameSidePositions = <b>2</b> · CorrelationFilter = <b>StaticLimit</b></li>
                        <li>SignalQuality MinThreshold = <b>78%</b> · Auction BestScore</li>
                        <li>MaxNotionalPctOfEquity = <b>28%</b> · DualMode MinVolumeRatio = <b>1.05</b></li>
                        <li>ML Hard Gate / News Hard = <b>OFF</b> (shadow until proven)</li>
                    </ul>
                </div>
            </section>
        }

        @if (_section == "pipeline")
        {
            <section class="hx-section">
                <h2>@T("pipe.title")</h2>
                <p class="hx-p">@T("pipe.intro")</p>

                <div class="hx-flow">
                    <div class="hx-flow-node">Market Data<br/><span>WS · REST · 15m+</span></div>
                    <div class="hx-flow-arrow">→</div>
                    <div class="hx-flow-node accent">CORE / MR<br/><span>signals</span></div>
                    <div class="hx-flow-arrow">→</div>
                    <div class="hx-flow-node accent2">Router<br/><span>DualMode</span></div>
                    <div class="hx-flow-arrow">→</div>
                    <div class="hx-flow-node">PROC<br/><span>Risk · SQ</span></div>
                    <div class="hx-flow-arrow">→</div>
                    <div class="hx-flow-node ok">Live + Demo<br/><span>1:1 entry</span></div>
                </div>

                <div class="hx-grid-2">
                    <div class="hx-card">
                        <h3>@T("pipe.trend_t")</h3>
                        <ol class="hx-list num">
                            <li>@T("pipe.trend_1")</li>
                            <li>@T("pipe.trend_2")</li>
                            <li>@T("pipe.trend_3")</li>
                            <li>@T("pipe.trend_4")</li>
                            <li>@T("pipe.trend_5")</li>
                        </ol>
                        <pre class="hx-code">SetupReason example:
TREND: CORE_PULLBACK_LONG</pre>
                    </div>
                    <div class="hx-card">
                        <h3>@T("pipe.range_t")</h3>
                        <ol class="hx-list num">
                            <li>@T("pipe.range_1")</li>
                            <li>@T("pipe.range_2")</li>
                            <li>@T("pipe.range_3")</li>
                            <li>@T("pipe.range_4")</li>
                        </ol>
                        <pre class="hx-code">SetupReason example:
RANGE: RANGE_SPREAD_SHORT</pre>
                    </div>
                </div>

                <div class="hx-card">
                    <h3>@T("pipe.proc_t")</h3>
                    <div class="hx-table-wrap">
                        <table class="hx-table">
                            <thead><tr><th>@T("pipe.col_stage")</th><th>@T("pipe.col_what")</th><th>@T("pipe.col_reject")</th></tr></thead>
                            <tbody>
                                <tr><td>Executable</td><td>CORE_ / TREND_ / RANGE_ only</td><td>NON_STRATEGY_BLOCKED</td></tr>
                                <tr><td>DualMode</td><td>Regime · universe · flow · size/lev</td><td>regime/universe/flow</td></tr>
                                <tr><td>Risk</td><td>1R · HardCap · notional 28% · max positions</td><td>QTY_ZERO · DIR_MAX</td></tr>
                                <tr><td>Signal Quality</td><td>Auction score ≥ threshold</td><td>BELOW_QUALITY</td></tr>
                                <tr><td>OB Guard</td><td>Spread / depth</td><td>SPREAD_WIDE</td></tr>
                                <tr><td>Exec</td><td>Binance + ApprovedEntry → Demo</td><td>EXECUTION_FAILED</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="hx-callout">
                    <strong>Demo ≡ Live (decision parity)</strong>
                    <p>@T("pipe.parity")</p>
                </div>
            </section>
        }

        @if (_section == "strategy")
        {
            <section class="hx-section">
                <h2>@T("st.title")</h2>
                <div class="hx-grid-2">
                    <div class="hx-card">
                        <div class="hx-tag green">TREND</div>
                        <h3>@T("st.trend_h")</h3>
                        <ul class="hx-list">
                            <li>@T("st.trend_1")</li>
                            <li>@T("st.trend_2")</li>
                            <li>@T("st.trend_3")</li>
                            <li>@T("st.trend_4")</li>
                            <li>@T("st.trend_5")</li>
                        </ul>
                    </div>
                    <div class="hx-card">
                        <div class="hx-tag blue">RANGE</div>
                        <h3>@T("st.range_h")</h3>
                        <ul class="hx-list">
                            <li>@T("st.range_1")</li>
                            <li>@T("st.range_2")</li>
                            <li>@T("st.range_3")</li>
                            <li>@T("st.range_4")</li>
                        </ul>
                    </div>
                </div>
                <div class="hx-card warn-border">
                    <h3>@T("st.no_t")</h3>
                    <p>@T("st.no_p")</p>
                </div>
            </section>
        }

        @if (_section == "settings")
        {
            <section class="hx-section">
                <h2>@T("set.title")</h2>
                <p class="hx-p">@T("set.intro")</p>

                <h3 class="hx-h3">@T("set.risk_h")</h3>
                <div class="hx-table-wrap">
                    <table class="hx-table">
                        <thead>
                            <tr>
                                <th>@T("set.col_param")</th>
                                <th>@T("set.col_default")</th>
                                <th>@T("set.col_mean")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><code>MaxOpenPositions</code></td><td><b>4</b></td><td>@T("set.mop")</td></tr>
                            <tr><td><code>MaxSameSidePositions</code></td><td><b>2</b></td><td>@T("set.mss")</td></tr>
                            <tr><td><code>CorrelationFilterMode</code></td><td><b>StaticLimit</b></td><td>@T("set.cfm")</td></tr>
                            <tr><td><code>MaxAllowedCorrelation</code></td><td>0.80</td><td>@T("set.mac")</td></tr>
                            <tr><td><code>DynamicLiquiditySizing</code></td><td>true</td><td>@T("set.dls")</td></tr>
                            <tr><td><code>MaxNotionalPctOfEquity</code></td><td><b>0.28</b></td><td>@T("set.mnp")</td></tr>
                            <tr><td><code>HardCapUsdMajor / Alt</code></td><td>80 / 35</td><td>@T("set.hcap")</td></tr>
                            <tr><td><code>PostCloseCooldownMinutes</code></td><td>45</td><td>@T("set.pcc")</td></tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="hx-h3">@T("set.sq_h")</h3>
                <div class="hx-table-wrap">
                    <table class="hx-table">
                        <thead><tr><th>@T("set.col_param")</th><th>@T("set.col_default")</th><th>@T("set.col_mean")</th></tr></thead>
                        <tbody>
                            <tr><td><code>MinQualityThreshold</code></td><td><b>78</b></td><td>@T("set.mqt")</td></tr>
                            <tr><td><code>SignalSelectionStrategy</code></td><td>BestScoreAuction</td><td>@T("set.sss")</td></tr>
                            <tr><td><code>AuctionWindowMs</code></td><td>400</td><td>@T("set.awm")</td></tr>
                            <tr><td><code>WeightTrend / Deriv / Vol / RR</code></td><td>0.35 / 0.20 / 0.20 / 0.25</td><td>@T("set.wts")</td></tr>
                            <tr><td><code>OrderbookGuardEnabled</code></td><td>true</td><td>@T("set.obg")</td></tr>
                            <tr><td><code>MaxSpreadPct</code></td><td>0.0008 (0.08%)</td><td>@T("set.msp")</td></tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="hx-h3">@T("set.dual_h")</h3>
                <div class="hx-table-wrap">
                    <table class="hx-table">
                        <thead><tr><th>@T("set.col_param")</th><th>@T("set.col_default")</th><th>@T("set.col_mean")</th></tr></thead>
                        <tbody>
                            <tr><td><code>Enabled</code></td><td>true</td><td>@T("set.d_en")</td></tr>
                            <tr><td><code>CoreMajorCount / TrendUniverseCount</code></td><td>5 / 18</td><td>@T("set.d_uni")</td></tr>
                            <tr><td><code>SpreadLiquidCount</code></td><td>25</td><td>@T("set.d_sp")</td></tr>
                            <tr><td><code>RangeLeverageMin–Max</code></td><td>3–5</td><td>@T("set.d_rl")</td></tr>
                            <tr><td><code>TrendLeverageMin–Max</code></td><td>5–10</td><td>@T("set.d_tl")</td></tr>
                            <tr><td><code>RangeSizeMult</code></td><td>0.35</td><td>@T("set.d_rs")</td></tr>
                            <tr><td><code>RequireFlowOnTrend / Volume</code></td><td>true / true</td><td>@T("set.d_flow")</td></tr>
                            <tr><td><code>MinVolumeRatio</code></td><td><b>1.05</b></td><td>@T("set.d_vol")</td></tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="hx-h3">@T("set.ml_h")</h3>
                <div class="hx-table-wrap">
                    <table class="hx-table">
                        <thead><tr><th>@T("set.col_param")</th><th>@T("set.col_default")</th><th>@T("set.col_mean")</th></tr></thead>
                        <tbody>
                            <tr><td><code>EnableMlSkipGate</code></td><td><b>false</b></td><td>@T("set.ml_gate")</td></tr>
                            <tr><td><code>SkipThreshold</code></td><td>0.55</td><td>@T("set.ml_th")</td></tr>
                            <tr><td><code>EnableMlHardReject</code></td><td>false</td><td>@T("set.ml_hard")</td></tr>
                            <tr><td><code>EnableNewsHardMode</code></td><td>false</td><td>@T("set.nw_hard")</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="hx-callout warn">
                    <strong>@T("set.warn_t")</strong>
                    <p>@T("set.warn_p")</p>
                </div>
            </section>
        }

        @if (_section == "risk")
        {
            <section class="hx-section">
                <h2>@T("risk.title")</h2>
                <div class="hx-grid-2">
                    <div class="hx-card">
                        <h3>@T("risk.size_h")</h3>
                        <p>@T("risk.size_p")</p>
                        <pre class="hx-code">risk$ = equity × riskFrac (~0.6–0.75%)
qty  = risk$ / |entry − SL|
then min(HardCapUsd, MaxNotional% × equity / price)</pre>
                    </div>
                    <div class="hx-card">
                        <h3>@T("risk.exit_h")</h3>
                        <ul class="hx-list">
                            <li>@T("risk.exit_1")</li>
                            <li>@T("risk.exit_2")</li>
                            <li>@T("risk.exit_3")</li>
                            <li>@T("risk.exit_4")</li>
                        </ul>
                    </div>
                </div>
            </section>
        }

        @if (_section == "ui")
        {
            <section class="hx-section">
                <h2>@T("ui.title")</h2>
                <div class="hx-grid-3">
                    <div class="hx-card">
                        <h3>/market</h3>
                        <p>@T("ui.market")</p>
                    </div>
                    <div class="hx-card">
                        <h3>/settings</h3>
                        <p>@T("ui.settings")</p>
                    </div>
                    <div class="hx-card">
                        <h3>/ai-dashboard</h3>
                        <p>@T("ui.ai")</p>
                    </div>
                    <div class="hx-card">
                        <h3>/macro-news</h3>
                        <p>@T("ui.news")</p>
                    </div>
                    <div class="hx-card">
                        <h3>History</h3>
                        <p>@T("ui.hist")</p>
                    </div>
                    <div class="hx-card">
                        <h3>Telegram / TWA</h3>
                        <p>@T("ui.tg")</p>
                    </div>
                </div>
            </section>
        }

        @if (_section == "ops")
        {
            <section class="hx-section">
                <h2>@T("ops.title")</h2>
                <div class="hx-card">
                    <h3>@T("ops.logs_h")</h3>
                    <pre class="hx-code">[CORE] SIGNAL / REJECT htf_bias|impulse_chase|no_volume_flow|rsi_fomo
[ROUTER] CORE → channel | held (regime=RANGE)
[DUAL-MODE] reject … | size× · lev=
[RISK] notional-cap …
[PROC] REJECT stage=… reason=…
[EXEC] OrderCreated · [SL_ALGO] · [TP…]</pre>
                </div>
                <div class="hx-card">
                    <h3>@T("ops.check_h")</h3>
                    <ol class="hx-list num">
                        <li>@T("ops.c1")</li>
                        <li>@T("ops.c2")</li>
                        <li>@T("ops.c3")</li>
                        <li>@T("ops.c4")</li>
                    </ol>
                </div>
            </section>
        }

        <footer class="hx-footer">
            Vertex AutoTrade · Dual Mode Expert · @_lang.ToUpperInvariant()
        </footer>
    </main>
</div>

<style>
    .hx-root { display:flex; min-height:100vh; background:#0b0f14; color:#e8eef7; font-family:Inter,system-ui,sans-serif; }
    .hx-nav { width:280px; flex-shrink:0; background:linear-gradient(180deg,#0f1520,#0b0f14); border-right:1px solid #1e2a3a; padding:16px 12px; display:flex; flex-direction:column; gap:12px; position:sticky; top:0; height:100vh; overflow:auto; }
    .hx-brand { display:flex; gap:10px; align-items:center; padding:4px 6px 12px; }
    .hx-logo { width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg,#22d3ee,#3b82f6); display:grid; place-items:center; font-weight:800; color:#041018; }
    .hx-brand-title { font-weight:800; letter-spacing:.08em; font-size:13px; }
    .hx-brand-sub { font-size:11px; color:#8b9bb4; }
    .hx-lang { display:flex; gap:6px; }
    .hx-lang button { flex:1; border:1px solid #243246; background:#121a26; color:#9fb0c9; border-radius:8px; padding:6px; cursor:pointer; font-weight:700; font-size:12px; }
    .hx-lang button.on { background:#12304a; border-color:#22d3ee; color:#7dd3fc; }
    .hx-search { width:100%; background:#121a26; border:1px solid #243246; border-radius:10px; padding:8px 10px; color:#e8eef7; font-size:13px; }
    .hx-toc { display:flex; flex-direction:column; gap:4px; flex:1; }
    .hx-toc-item { display:flex; gap:8px; align-items:center; text-align:left; border:0; background:transparent; color:#9fb0c9; padding:9px 10px; border-radius:10px; cursor:pointer; font-size:13px; }
    .hx-toc-item:hover { background:#151e2c; color:#e8eef7; }
    .hx-toc-item.active { background:#132536; color:#7dd3fc; box-shadow:inset 2px 0 0 #22d3ee; }
    .hx-ico { width:18px; opacity:.9; }
    .hx-nav-foot { display:flex; flex-wrap:wrap; gap:8px; padding-top:8px; border-top:1px solid #1e2a3a; }
    .hx-nav-foot a { color:#7dd3fc; font-size:12px; text-decoration:none; }
    .hx-main { flex:1; padding:28px 32px 48px; max-width:1100px; }
    .hx-header { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:22px; }
    .hx-header h1 { margin:0 0 6px; font-size:26px; font-weight:800; letter-spacing:-.02em; }
    .hx-lead { margin:0; color:#8b9bb4; font-size:14px; max-width:640px; line-height:1.5; }
    .hx-badge { font-size:11px; font-weight:700; color:#7dd3fc; border:1px solid #1e4a5f; background:#0d2230; padding:6px 10px; border-radius:999px; white-space:nowrap; }
    .hx-section { display:flex; flex-direction:column; gap:16px; }
    .hx-h3 { margin:8px 0 0; font-size:15px; color:#cbd5e1; }
    .hx-p { color:#a8b6c9; line-height:1.55; margin:0; }
    .hx-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .hx-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .hx-card { background:#121a26; border:1px solid #1e2a3a; border-radius:14px; padding:16px 16px 14px; box-shadow:0 8px 24px rgba(0,0,0,.25); }
    .hx-card.step { position:relative; padding-top:18px; }
    .hx-card.warn-border { border-color:#7c3a1d; background:#1a1410; }
    .hx-step { position:absolute; top:-10px; left:14px; width:26px; height:26px; border-radius:8px; background:linear-gradient(135deg,#22d3ee,#3b82f6); color:#041018; font-weight:800; display:grid; place-items:center; font-size:13px; }
    .hx-card h3 { margin:0 0 8px; font-size:15px; }
    .hx-card p { margin:0; color:#9fb0c9; font-size:13px; line-height:1.5; }
    .hx-code { margin:10px 0 0; background:#0a1018; border:1px solid #1a2535; border-radius:10px; padding:10px 12px; font-size:12px; color:#a5f3fc; overflow:auto; white-space:pre-wrap; }
    .hx-list { margin:8px 0 0; padding-left:18px; color:#b6c4d8; font-size:13px; line-height:1.55; }
    .hx-list.num { list-style:decimal; }
    .hx-callout { border-radius:12px; padding:14px 16px; border:1px solid #1e3a4a; background:#0e1a24; color:#b6c4d8; font-size:13px; line-height:1.5; }
    .hx-callout.ok { border-color:#14532d; background:#0c1a12; }
    .hx-callout.warn { border-color:#854d0e; background:#1a1508; }
    .hx-callout strong { color:#e8eef7; display:block; margin-bottom:4px; }
    .hx-flow { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:8px 0 12px; }
    .hx-flow-node { background:#121a26; border:1px solid #2a3a50; border-radius:12px; padding:10px 12px; font-size:12px; font-weight:700; text-align:center; min-width:100px; }
    .hx-flow-node span { display:block; font-weight:500; color:#8b9bb4; font-size:11px; margin-top:2px; }
    .hx-flow-node.accent { border-color:#22d3ee55; box-shadow:0 0 20px #22d3ee22; }
    .hx-flow-node.accent2 { border-color:#a78bfa55; }
    .hx-flow-node.ok { border-color:#22c55e55; }
    .hx-flow-arrow { color:#3b82f6; font-weight:800; }
    .hx-table-wrap { overflow:auto; border-radius:12px; border:1px solid #1e2a3a; }
    .hx-table { width:100%; border-collapse:collapse; font-size:13px; }
    .hx-table th { text-align:left; background:#0f1722; color:#8b9bb4; padding:10px 12px; border-bottom:1px solid #1e2a3a; font-weight:600; }
    .hx-table td { padding:10px 12px; border-bottom:1px solid #152033; color:#c5d0e0; vertical-align:top; }
    .hx-table code { color:#7dd3fc; font-size:12px; }
    .hx-tag { display:inline-block; font-size:10px; font-weight:800; letter-spacing:.06em; padding:3px 8px; border-radius:999px; margin-bottom:8px; }
    .hx-tag.green { background:#052e16; color:#4ade80; border:1px solid #166534; }
    .hx-tag.blue { background:#0c1e36; color:#60a5fa; border:1px solid #1e40af; }
    .hx-footer { margin-top:28px; color:#5b6b82; font-size:11px; }
    @@media (max-width: 960px) {
        .hx-root { flex-direction:column; }
