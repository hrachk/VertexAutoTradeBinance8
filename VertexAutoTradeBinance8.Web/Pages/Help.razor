@page "/help"
@page "/docs"
@using System.Globalization

<div class="hx-root" data-lang="@_lang">
    <aside class="hx-nav">
        <div class="hx-brand">
            <div class="hx-logo">
                <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
                    <defs>
                        <linearGradient id="vg" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#22d3ee"/>
                            <stop offset="100%" stop-color="#a78bfa"/>
                        </linearGradient>
                    </defs>
                    <rect width="40" height="40" rx="10" fill="url(#vg)" opacity="0.2"/>
                    <path d="M8 28 L20 8 L32 28 Z" fill="none" stroke="url(#vg)" stroke-width="2.5"/>
                    <circle cx="20" cy="22" r="3" fill="#22d3ee"/>
                </svg>
            </div>
            <div>
                <div class="hx-brand-title">VERTEX</div>
                <div class="hx-brand-sub">@T("help.brand_sub")</div>
            </div>
        </div>

        <div class="hx-lang">
            <button type="button" class="@(_lang=="ru"?"on":null)" @onclick='() => SetLang("ru")'>RU</button>
            <button type="button" class="@(_lang=="en"?"on":null)" @onclick='() => SetLang("en")'>EN</button>
        </div>

        <input class="hx-search" @bind="_query" @bind:event="oninput" placeholder="@T("help.search")" />

        <nav class="hx-toc">
            @foreach (var item in FilteredToc)
            {
                <button type="button" class="hx-toc-item @(_section == item.Id ? "active" : null)"
                        @onclick="() => Go(item.Id)">
                    <span class="hx-ico">@item.Icon</span>
                    <span>@item.Label</span>
                </button>
            }
        </nav>

        <div class="hx-nav-foot">
            <a href="/market" class="hx-link-pill">📈 Market</a>
            <a href="/settings" class="hx-link-pill">⚙️ Settings</a>
            <a href="/ai-dashboard" class="hx-link-pill">🧠 AI</a>
            <a href="/macro-news" class="hx-link-pill">📰 News</a>
            <a href="/twa/dashboard" class="hx-link-pill">📱 TWA</a>
        </div>
    </aside>

    <main class="hx-main">
        <header class="hx-hero">
            <div class="hx-hero-glow"></div>
            <div class="hx-hero-text">
                <div class="hx-kicker">VERTEX AutoTrade · Production</div>
                <h1>@CurrentTitle</h1>
                <p class="hx-lead">@CurrentLead</p>
                <div class="hx-hero-actions">
                    <a class="hx-btn primary" href="/settings">@T("hero.settings")</a>
                    <a class="hx-btn ghost" href="/market">@T("hero.market")</a>
                    <a class="hx-btn ghost" href="/ai-dashboard">@T("hero.ai")</a>
                </div>
            </div>
            <div class="hx-hero-art" aria-hidden="true">
                <svg viewBox="0 0 280 160" class="hx-chart-svg">
                    <defs>
                        <linearGradient id="cg" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.45"/>
                            <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    <polyline fill="none" stroke="#334155" stroke-width="1" points="10,120 40,110 70,115 100,90 130,95 160,70 190,75 220,50 250,55 270,40"/>
                    <polyline fill="none" stroke="#22d3ee" stroke-width="2.2" points="10,130 40,125 70,128 100,105 130,108 160,85 190,88 220,62 250,68 270,52"/>
                    <polygon fill="url(#cg)" points="10,140 10,130 40,125 70,128 100,105 130,108 160,85 190,88 220,62 250,68 270,52 270,140"/>
                    <line x1="160" y1="20" x2="160" y2="140" stroke="#22c55e" stroke-dasharray="4 3" opacity="0.7"/>
                    <line x1="10" y1="100" x2="270" y2="100" stroke="#ef4444" stroke-dasharray="4 3" opacity="0.55"/>
                    <text x="164" y="18" fill="#22c55e" font-size="10">TP</text>
                    <text x="12" y="96" fill="#ef4444" font-size="10">SL</text>
                    <circle cx="160" cy="85" r="5" fill="#a78bfa"/>
                    <text x="168" y="82" fill="#e2e8f0" font-size="10">Entry</text>
                </svg>
            </div>
        </header>

        @* ── QUICK ── *@
        @if (_section == "quick")
        {
            <section class="hx-section">
                <div class="hx-grid-3">
                    <article class="hx-card step">
                        <div class="hx-step">1</div>
                        <h3>@T("quick.s1_t")</h3>
                        <p>@T("quick.s1_p")</p>
                        <pre class="hx-code">SharedData:Root  (Engine + Web = same path)
vertex_journal.db · vertex_system.db
appsettings.json + runtime.json</pre>
                    </article>
                    <article class="hx-card step">
                        <div class="hx-step">2</div>
                        <h3>@T("quick.s2_t")</h3>
                        <p>@T("quick.s2_p")</p>
                        <pre class="hx-code">1) Start Engine (worker)
2) Start Web → :5101
Logs: [TIME-SYNC] [DUAL-MODE] [CORE]</pre>
                    </article>
                    <article class="hx-card step">
                        <div class="hx-step">3</div>
                        <h3>@T("quick.s3_t")</h3>
                        <p>@T("quick.s3_p")</p>
                        <pre class="hx-code">Demo ON → independent $10k
Live OFF until Demo edge is OK
AutoTrade + DualMode Enabled</pre>
                    </article>
                </div>

                <div class="hx-banner">
                    <div class="hx-banner-icon">✓</div>
                    <div>
                        <strong>@T("quick.ok_t")</strong>
                        <p>@T("quick.ok_p")</p>
                    </div>
                </div>

                <h2 class="hx-h2">@T("quick.links_t")</h2>
                <div class="hx-link-grid">
                    <a href="/market" class="hx-tile"><span>📈</span><b>Market</b><small>@T("quick.l_market")</small></a>
                    <a href="/settings" class="hx-tile"><span>⚙️</span><b>Settings</b><small>@T("quick.l_settings")</small></a>
                    <a href="/ai-dashboard" class="hx-tile"><span>🧠</span><b>AI Dashboard</b><small>@T("quick.l_ai")</small></a>
                    <a href="/macro-news" class="hx-tile"><span>📰</span><b>Macro News</b><small>@T("quick.l_news")</small></a>
                    <a href="/positions" class="hx-tile"><span>📋</span><b>Positions</b><small>@T("quick.l_pos")</small></a>
                    <a href="/twa/dashboard" class="hx-tile"><span>📱</span><b>Telegram Mini</b><small>@T("quick.l_twa")</small></a>
                </div>
            </section>
        }

        @* ── PIPELINE ── *@
        @if (_section == "pipeline")
        {
            <section class="hx-section">
                <div class="hx-flow-wrap">
                    <svg class="hx-flow-svg" viewBox="0 0 900 220" role="img" aria-label="Pipeline">
                        <defs>
                            <linearGradient id="fg" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#22d3ee"/>
                                <stop offset="50%" stop-color="#a78bfa"/>
                                <stop offset="100%" stop-color="#22c55e"/>
                            </linearGradient>
                        </defs>
                        <line x1="70" y1="110" x2="830" y2="110" stroke="url(#fg)" stroke-width="3" opacity="0.5"/>
                        @{
                            var nodes = new[] {
                                ("WS", "Market data", 70),
                                ("Dual", "BTC regime", 220),
                                ("Core", "CORE_INST", 370),
                                ("Range", "SPREAD", 520),
                                ("Risk", "1R / caps", 670),
                                ("Exec", "Demo·Live", 820)
                            };
                        }
                        @foreach (var n in nodes)
                        {
                            <g transform="translate(@n.Item3, 110)">
                                <circle r="28" fill="#0f172a" stroke="#22d3ee" stroke-width="2"/>
                                <text text-anchor="middle" y="5" fill="#e2e8f0" font-size="11" font-weight="700">@n.Item1</text>
                                <text text-anchor="middle" y="52" fill="#94a3b8" font-size="10">@n.Item2</text>
                            </g>
                        }
                    </svg>
                </div>

                <div class="hx-grid-2">
                    <article class="hx-card">
                        <div class="hx-tag cyan">TREND</div>
                        <h3>@T("pipe.trend_t")</h3>
                        <p>@T("pipe.trend_p")</p>
                        <ul class="hx-list">
                            <li><code>CORE_INST_LONG / SHORT</code></li>
                            <li>@T("pipe.trend_l2")</li>
                            <li>@T("pipe.trend_l3")</li>
                        </ul>
                    </article>
                    <article class="hx-card">
                        <div class="hx-tag violet">RANGE</div>
                        <h3>@T("pipe.range_t")</h3>
                        <p>@T("pipe.range_p")</p>
                        <ul class="hx-list">
                            <li><code>RANGE_SPREAD_LONG / SHORT</code></li>
                            <li>@T("pipe.range_l2")</li>
                            <li>@T("pipe.range_l3")</li>
                        </ul>
                    </article>
                </div>

                <div class="hx-callout">
                    <strong>@T("pipe.note_t")</strong>
                    <p>@T("pipe.note_p")</p>
                </div>
            </section>
        }

        @* ── DUAL ── *@
        @if (_section == "dual")
        {
            <section class="hx-section">
                <div class="hx-mode-row">
                    <div class="hx-mode-card trend">
                        <div class="hx-mode-head">TREND</div>
                        <p>@T("dual.trend")</p>
                        <div class="hx-chips">
                            <span>CORE_INST</span><span>flow+volume</span><span>lev ↑</span>
                        </div>
                    </div>
                    <div class="hx-mode-card range">
                        <div class="hx-mode-head">RANGE</div>
                        <p>@T("dual.range")</p>
                        <div class="hx-chips">
                            <span>SPREAD</span><span>no majors</span><span>lev 3–5×</span>
                        </div>
                    </div>
                    <div class="hx-mode-card chaos">
                        <div class="hx-mode-head">CHAOS</div>
                        <p>@T("dual.chaos")</p>
                        <div class="hx-chips">
                            <span>hold all</span>
                        </div>
                    </div>
                </div>
                <article class="hx-card">
                    <h3>@T("dual.log_t")</h3>
                    <pre class="hx-code">[DUAL-MODE] BTC regime → Trend | Range | Chaos
[ROUTER] CORE held … regime=RANGE
[ROUTER] SPREAD held … regime=TREND
[CORE][SCAN] evaluated=… emitted=…</pre>
                </article>
            </section>
        }

        @* ── STRATEGY ── *@
        @if (_section == "strategy")
        {
            <section class="hx-section">
                <div class="hx-grid-2">
                    <article class="hx-card accent">
                        <h3>@T("st.struct_t")</h3>
                        <p>@T("st.struct_p")</p>
                        <div class="hx-metric-row">
                            <div class="hx-metric"><span>4H</span><b>@T("st.m4h")</b></div>
                            <div class="hx-metric"><span>1H</span><b>@T("st.m1h")</b></div>
                            <div class="hx-metric"><span>15m</span><b>@T("st.m15")</b></div>
                        </div>
                    </article>
                    <article class="hx-card accent">
                        <h3>@T("st.geo_t")</h3>
                        <p>@T("st.geo_p")</p>
                        <ul class="hx-list">
                            <li>@T("st.geo_l1")</li>
                            <li>@T("st.geo_l2")</li>
                            <li>@T("st.geo_l3")</li>
                        </ul>
                    </article>
                </div>
                <div class="hx-banner warn">
                    <div class="hx-banner-icon">!</div>
                    <div>
                        <strong>@T("st.warn_t")</strong>
                        <p>@T("st.warn_p")</p>
                    </div>
                </div>
            </section>
        }

        @* ── DATA ── *@
        @if (_section == "data")
        {
            <section class="hx-section">
                <div class="hx-grid-3">
                    <article class="hx-card">
                        <div class="hx-ico-lg">📡</div>
                        <h3>@T("data.ws_t")</h3>
                        <p>@T("data.ws_p")</p>
                    </article>
                    <article class="hx-card">
                        <div class="hx-ico-lg">⏱</div>
                        <h3>@T("data.close_t")</h3>
                        <p>@T("data.close_p")</p>
                    </article>
                    <article class="hx-card">
                        <div class="hx-ico-lg">🛡</div>
                        <h3>@T("data.rate_t")</h3>
                        <p>@T("data.rate_p")</p>
                    </article>
                </div>
                <article class="hx-card">
                    <h3>@T("data.flow_t")</h3>
                    <p>@T("data.flow_p")</p>
                    <pre class="hx-code">WS klines → buffer → CORE / MR on CLOSE
Entry gate: volume ratio · OI delta · order book
Algo orders: global cache 45s · 429 → 3 min cooldown
REST klines: max 3 concurrent + circuit breaker</pre>
                </article>
            </section>
        }

        @* ── SETTINGS ── *@
        @if (_section == "settings")
        {
            <section class="hx-section">
                <div class="hx-table-wrap">
                    <table class="hx-table">
                        <thead>
                            <tr>
                                <th>@T("set.col_param")</th>
                                <th>@T("set.col_where")</th>
                                <th>@T("set.col_mean")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><code>DualMode.Enabled</code></td><td>Settings / JSON</td><td>@T("set.dual")</td></tr>
                            <tr><td><code>MaxOpenPositions</code></td><td>Risk UI</td><td>@T("set.maxpos")</td></tr>
                            <tr><td><code>CorrelationFilterMode</code></td><td>Risk UI</td><td>@T("set.corr")</td></tr>
                            <tr><td><code>News SoftImpact</code></td><td>News / JSON</td><td>@T("set.news")</td></tr>
                            <tr><td><code>EnableMlSkipGate</code></td><td>ML / Risk</td><td>@T("set.ml")</td></tr>
                            <tr><td><code>MinExecute</code></td><td>Confidence</td><td>@T("set.minex")</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="hx-hint">@T("set.hint") <a href="/settings">/settings</a></p>
            </section>
        }

        @* ── RISK ── *@
        @if (_section == "risk")
        {
            <section class="hx-section">
                <div class="hx-grid-2">
                    <article class="hx-card">
                        <h3>@T("risk.size_t")</h3>
                        <p>@T("risk.size_p")</p>
                    </article>
                    <article class="hx-card">
                        <h3>@T("risk.exit_t")</h3>
                        <p>@T("risk.exit_p")</p>
                    </article>
                </div>
                <div class="hx-steps-h">
                    <div class="hx-step-h"><b>TP1</b><span>@T("risk.tp1")</span></div>
                    <div class="hx-step-h"><b>BE</b><span>@T("risk.be")</span></div>
                    <div class="hx-step-h"><b>TP2+</b><span>@T("risk.tp2")</span></div>
                    <div class="hx-step-h"><b>Trail</b><span>@T("risk.trail")</span></div>
                </div>
            </section>
        }

        @* ── NEWS ── *@
        @if (_section == "news")
        {
            <section class="hx-section">
                <div class="hx-grid-2">
                    <article class="hx-card">
                        <div class="hx-tag cyan">TREND</div>
                        <h3>@T("news.trend_t")</h3>
                        <p>@T("news.trend_p")</p>
                    </article>
                    <article class="hx-card">
                        <div class="hx-tag violet">RANGE</div>
                        <h3>@T("news.range_t")</h3>
                        <p>@T("news.range_p")</p>
                    </article>
                </div>
                <a class="hx-btn primary" href="/macro-news">@T("news.open")</a>
            </section>
        }

        @* ── UI MAP ── *@
        @if (_section == "ui")
        {
            <section class="hx-section">
                <div class="hx-link-grid">
                    <a href="/market" class="hx-tile tall"><span>📈</span><b>/market</b><small>@T("ui.market")</small></a>
                    <a href="/ai-dashboard" class="hx-tile tall"><span>🧠</span><b>/ai-dashboard</b><small>@T("ui.ai")</small></a>
                    <a href="/ai-learning" class="hx-tile tall"><span>📚</span><b>/ai-learning</b><small>@T("ui.learn")</small></a>
                    <a href="/macro-news" class="hx-tile tall"><span>📰</span><b>/macro-news</b><small>@T("ui.news")</small></a>
                    <a href="/settings" class="hx-tile tall"><span>⚙️</span><b>/settings</b><small>@T("ui.set")</small></a>
                    <a href="/positions" class="hx-tile tall"><span>📋</span><b>/positions</b><small>@T("ui.pos")</small></a>
                </div>
            </section>
        }

        @* ── OPS ── *@
        @if (_section == "ops")
        {
            <section class="hx-section">
                <article class="hx-card">
                    <h3>@T("ops.logs_t")</h3>
                    <pre class="hx-code">[DUAL-MODE] BTC regime → …
[ROUTER] CORE held / SPREAD held
[CORE][SCAN] universe=… emitted=…
[STRAT][PUSH] CLOSE-only, REALTIME OFF
[ALGO-RAW] OK / 429 cooldown
[NEWS] directive …</pre>
                </article>
                <div class="hx-grid-2">
                    <article class="hx-card">
                        <h3>@T("ops.tg_t")</h3>
                        <p>@T("ops.tg_p")</p>
                        <pre class="hx-code">/status  /pause  /resume  /kill  /dashboard</pre>
                    </article>
                    <article class="hx-card">
                        <h3>@T("ops.reset_t")</h3>
                        <p>@T("ops.reset_p")</p>
                    </article>
                </div>
            </section>
        }
    </main>
</div>

<style>
.hx-root{display:flex;min-height:calc(100vh - 48px);background:#070b14;color:#e2e8f0;font-family:Inter,system-ui,sans-serif;}
.hx-nav{width:260px;flex-shrink:0;background:linear-gradient(180deg,#0b1220,#0a0f18);border-right:1px solid #1e293b;padding:18px 14px;display:flex;flex-direction:column;gap:12px;position:sticky;top:0;height:100vh;overflow:auto;}
.hx-brand{display:flex;gap:10px;align-items:center;padding:4px 6px 12px;}
.hx-brand-title{font-weight:800;letter-spacing:.12em;font-size:13px;color:#f8fafc;}
.hx-brand-sub{font-size:11px;color:#64748b;margin-top:2px;}
.hx-lang{display:flex;gap:6px;}
.hx-lang button{flex:1;border:1px solid #1e293b;background:#0f172a;color:#94a3b8;border-radius:8px;padding:6px 0;cursor:pointer;font-weight:600;font-size:12px;}
.hx-lang button.on{background:rgba(34,211,238,.12);border-color:#22d3ee;color:#22d3ee;}
.hx-search{width:100%;box-sizing:border-box;background:#0f172a;border:1px solid #1e293b;border-radius:10px;padding:9px 12px;color:#e2e8f0;font-size:13px;outline:none;}
.hx-search:focus{border-color:#22d3ee;}
.hx-toc{display:flex;flex-direction:column;gap:4px;flex:1;}
.hx-toc-item{display:flex;align-items:center;gap:10px;text-align:left;border:none;background:transparent;color:#94a3b8;padding:10px 12px;border-radius:10px;cursor:pointer;font-size:13px;transition:.15s;}
.hx-toc-item:hover{background:#111827;color:#e2e8f0;}
.hx-toc-item.active{background:linear-gradient(90deg,rgba(34,211,238,.15),rgba(167,139,250,.08));color:#f1f5f9;box-shadow:inset 3px 0 0 #22d3ee;}
.hx-ico{width:22px;text-align:center;}
.hx-nav-foot{display:flex;flex-wrap:wrap;gap:6px;padding-top:8px;border-top:1px solid #1e293b;}
.hx-link-pill{font-size:11px;color:#94a3b8;text-decoration:none;padding:5px 8px;border-radius:999px;background:#0f172a;border:1px solid #1e293b;}
.hx-link-pill:hover{color:#22d3ee;border-color:#22d3ee;}
.hx-main{flex:1;padding:24px 28px 48px;overflow:auto;max-width:1100px;}
.hx-hero{position:relative;display:flex;gap:24px;align-items:center;justify-content:space-between;padding:28px 28px 24px;border-radius:20px;background:linear-gradient(135deg,#0f172a 0%,#111827 50%,#0b1220 100%);border:1px solid #1e293b;margin-bottom:24px;overflow:hidden;}
.hx-hero-glow{position:absolute;width:280px;height:280px;right:-40px;top:-80px;background:radial-gradient(circle,rgba(34,211,238,.25),transparent 70%);pointer-events:none;}
.hx-kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#22d3ee;margin-bottom:8px;font-weight:700;}
.hx-hero h1{margin:0 0 8px;font-size:28px;font-weight:800;color:#f8fafc;}
.hx-lead{margin:0;color:#94a3b8;font-size:14px;line-height:1.55;max-width:520px;}
.hx-hero-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
.hx-btn{display:inline-flex;align-items:center;padding:9px 14px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer;}
.hx-btn.primary{background:linear-gradient(90deg,#0891b2,#22d3ee);color:#042f2e;}
.hx-btn.ghost{background:transparent;border-color:#334155;color:#e2e8f0;}
.hx-btn.ghost:hover{border-color:#22d3ee;color:#22d3ee;}
.hx-chart-svg{width:260px;max-width:100%;opacity:.95;}
.hx-section{display:flex;flex-direction:column;gap:16px;}
.hx-h2{margin:8px 0 0;font-size:16px;color:#f1f5f9;}
.hx-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.hx-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
.hx-card{background:#0f172a;border:1px solid #1e293b;border-radius:16px;padding:18px 18px 16px;box-shadow:0 8px 24px rgba(0,0,0,.25);}
.hx-card.accent{border-color:rgba(34,211,238,.25);}
.hx-card.step{position:relative;padding-top:22px;}
.hx-step{position:absolute;top:-10px;left:16px;width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#22d3ee,#a78bfa);color:#0f172a;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center;}
.hx-card h3{margin:0 0 8px;font-size:15px;color:#f8fafc;}
.hx-card p{margin:0;font-size:13px;color:#94a3b8;line-height:1.55;}
.hx-code{margin:12px 0 0;padding:12px 14px;background:#020617;border:1px solid #1e293b;border-radius:10px;font-size:11.5px;color:#67e8f9;overflow:auto;line-height:1.45;white-space:pre-wrap;}
.hx-banner{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;border-radius:14px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.25);}
.hx-banner.warn{background:rgba(234,179,8,.08);border-color:rgba(234,179,8,.3);}
.hx-banner-icon{width:28px;height:28px;border-radius:8px;background:rgba(34,197,94,.2);color:#22c55e;display:flex;align-items:center;justify-content:center;font-weight:800;flex-shrink:0;}
.hx-banner.warn .hx-banner-icon{background:rgba(234,179,8,.2);color:#eab308;}
.hx-banner strong{color:#f1f5f9;font-size:13px;}
.hx-banner p{margin:4px 0 0;font-size:12.5px;color:#94a3b8;}
.hx-link-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.hx-tile{display:flex;flex-direction:column;gap:4px;padding:16px;border-radius:14px;background:#0f172a;border:1px solid #1e293b;text-decoration:none;color:inherit;transition:.15s;}
.hx-tile:hover{border-color:#22d3ee;transform:translateY(-2px);box-shadow:0 10px 24px rgba(34,211,238,.08);}
.hx-tile span{font-size:22px;}
.hx-tile b{font-size:14px;color:#f1f5f9;}
.hx-tile small{font-size:12px;color:#64748b;}
.hx-tile.tall{min-height:110px;}
.hx-flow-wrap{background:#0f172a;border:1px solid #1e293b;border-radius:16px;padding:12px;overflow:auto;}
.hx-flow-svg{width:100%;min-width:640px;height:auto;}
.hx-tag{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.08em;padding:3px 8px;border-radius:6px;margin-bottom:8px;}
.hx-tag.cyan{background:rgba(34,211,238,.12);color:#22d3ee;}
.hx-tag.violet{background:rgba(167,139,250,.12);color:#a78bfa;}
.hx-list{margin:10px 0 0;padding-left:18px;color:#94a3b8;font-size:13px;line-height:1.6;}
.hx-list code{color:#67e8f9;font-size:12px;}
.hx-callout{padding:14px 16px;border-radius:12px;background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.25);}
.hx-callout strong{color:#e9d5ff;font-size:13px;}
.hx-callout p{margin:6px 0 0;font-size:13px;color:#94a3b8;}
.hx-mode-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.hx-mode-card{border-radius:16px;padding:16px;border:1px solid #1e293b;background:#0f172a;}
.hx-mode-card.trend{border-color:rgba(34,197,94,.35);box-shadow:inset 0 0 40px rgba(34,197,94,.05);}
.hx-mode-card.range{border-color:rgba(167,139,250,.35);box-shadow:inset 0 0 40px rgba(167,139,250,.05);}
.hx-mode-card.chaos{border-color:rgba(239,68,68,.35);box-shadow:inset 0 0 40px rgba(239,68,68,.05);}
.hx-mode-head{font-weight:800;letter-spacing:.1em;font-size:13px;margin-bottom:8px;}
.hx-mode-card.trend .hx-mode-head{color:#22c55e;}
.hx-mode-card.range .hx-mode-head{color:#a78bfa;}
.hx-mode-card.chaos .hx-mode-head{color:#ef4444;}
.hx-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
.hx-chips span{font-size:11px;padding:3px 8px;border-radius:999px;background:#020617;border:1px solid #1e293b;color:#94a3b8;}
.hx-metric-row{display:flex;gap:10px;margin-top:12px;}
.hx-metric{flex:1;background:#020617;border-radius:10px;padding:10px;border:1px solid #1e293b;}
.hx-metric span{display:block;font-size:11px;color:#22d3ee;font-weight:700;}
.hx-metric b{display:block;font-size:12px;color:#cbd5e1;font-weight:500;margin-top:4px;}
.hx-ico-lg{font-size:28px;margin-bottom:8px;}
.hx-table-wrap{overflow:auto;border-radius:14px;border:1px solid #1e293b;}
.hx-table{width:100%;border-collapse:collapse;font-size:13px;}
.hx-table th{text-align:left;padding:12px 14px;background:#020617;color:#94a3b8;font-weight:600;border-bottom:1px solid #1e293b;}
.hx-table td{padding:12px 14px;border-bottom:1px solid #1e293b;color:#cbd5e1;}
.hx-table code{color:#67e8f9;}
.hx-hint{font-size:13px;color:#64748b;}
.hx-hint a{color:#22d3ee;}
.hx-steps-h{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.hx-step-h{background:#0f172a;border:1px solid #1e293b;border-radius:12px;padding:14px;text-align:center;}
.hx-step-h b{display:block;color:#22d3ee;font-size:14px;margin-bottom:6px;}
.hx-step-h span{font-size:12px;color:#94a3b8;}
@@media (max-width: 960px){
  .hx-root{flex-direction:column;}
  .hx-nav{width:100%;height:auto;position:relative;}
  .hx-grid-3,.hx-grid-2,.hx-link-grid,.hx-mode-row,.hx-steps-h{grid-template-columns:1fr;}
  .hx-hero{flex-direction:column;align-items:flex-start;}
}
</style>

