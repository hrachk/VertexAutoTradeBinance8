                ("settings", "⚙️", _lang=="en" ? "Settings map" : "Настройки"),
                ("risk", "🛡", _lang=="en" ? "Risk & exits" : "Риск и выходы"),
                ("news", "📰", _lang=="en" ? "News layer" : "Новости"),
                ("ui", "🖥", _lang=="en" ? "UI map" : "Карта UI"),
                ("ops", "📋", _lang=="en" ? "Ops & logs" : "Операции"),
            };
            if (string.IsNullOrWhiteSpace(_query)) return all;
            var q = _query.Trim();
            return all.Where(t => t.Label.Contains(q, StringComparison.OrdinalIgnoreCase) || t.Id.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

