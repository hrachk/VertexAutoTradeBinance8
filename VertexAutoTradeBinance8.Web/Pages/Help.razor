    private record TocItem(string Id, string Icon, string LabelRu, string LabelEn)
    {
        public string Label => LabelRu; // bound via property on instance in FilteredToc
    }

    private IEnumerable<(string Id, string Icon, string Label)> FilteredToc
    {
        get
        {
            IEnumerable<(string Id, string Icon, string Label)> all = new[]
            {
                ("quick", "⚡", _lang=="en" ? "Quick start" : "Быстрый старт"),
                ("pipeline", "🔗", _lang=="en" ? "Pipeline" : "Пайплайн"),
                ("strategy", "📈", _lang=="en" ? "Expert strategy" : "Стратегия Expert"),
                ("settings", "⚙️", _lang=="en" ? "UI settings" : "Настройки UI"),
                ("risk", "🛡", _lang=="en" ? "Risk & exits" : "Риск и выходы"),
                ("ui", "🖥", _lang=="en" ? "UI map" : "Карта интерфейса"),
                ("ops", "📋", _lang=="en" ? "Ops & logs" : "Операции и логи"),
            };
            if (string.IsNullOrWhiteSpace(_query)) return all;
            var q = _query.Trim();
            return all.Where(t => t.Label.Contains(q, StringComparison.OrdinalIgnoreCase) || t.Id.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

