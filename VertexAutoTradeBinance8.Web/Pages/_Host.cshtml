@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace VertexAutoTradeBinance8.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/positions.css" rel="stylesheet" />
    <link href="/css/missed-trades.css" rel="stylesheet" />
    <link href="/css/ai-learning.css" rel="stylesheet" />
    <link href="/css/trade-permission.css" rel="stylesheet" />
    <link href="/css/market-snapshot.css" rel="stylesheet" />
    <link href="VertexAutoTradeBinance8.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
   
    <!-- 1️⃣ ВНЕШНИЕ БИБЛИОТЕКИ -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
 
    <script src="~/js/vertex-ui.js"></script>
    <script src="~/js/vertex-bridge.js"></script>

    <!-- 4️⃣ CHARTS (ИСПОЛЬЗУЮТ Chart + vertex.*) -->
    <script src="~/js/market-chart.js"></script>
    <script src="~/js/learningchart.js"></script>

    <!-- 5️⃣ BLazor Server runtime — ВСЕГДА ПОСЛЕДНИМ -->
    <script src="_framework/blazor.server.js"></script>

</body>
</html>
