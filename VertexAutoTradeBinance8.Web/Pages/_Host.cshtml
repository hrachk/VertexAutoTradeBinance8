@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace VertexAutoTradeBinance8.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Configuration.IConfiguration Cfg

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#0c1220" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Vertex AutoTrade — Binance Futures autonomous trading" />
    <!-- iOS PWA -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Vertex" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/vertexailogo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/vertexailogo.png" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="/css/site.css" rel="stylesheet" />
    <link href="/css/positions.css" rel="stylesheet" />
    <link href="/css/missed-trades.css" rel="stylesheet" />
    <link href="/css/ai-learning.css" rel="stylesheet" />
    <link href="/css/trade-permission.css" rel="stylesheet" />
    <link href="/css/market-snapshot.css" rel="stylesheet" />
    <link href="/css/engine.css" rel="stylesheet" />
    <link href="/css/ai-pulse.css" rel="stylesheet" />
    <link href="/css/ai-dashboard.css" rel="stylesheet" />
    <link href="VertexAutoTradeBinance8.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
   
    <!-- 1️⃣ ВНЕШНИЕ БИБЛИОТЕКИ -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
 
    <script src="~/js/vertex-auth.js"></script>
    <script src="~/js/vertex-oauth.js"></script>
    @{
        var oauthGoogleClientId    = Cfg["OAuth:Google:ClientId"]    ?? "";
        var oauthTelegramBotName   = Cfg["OAuth:Telegram:BotName"]   ?? "";
        var oauthTelegramBotId     = Cfg["OAuth:Telegram:BotId"]     ?? "";
        var oauthAppleClientId     = Cfg["OAuth:Apple:ClientId"]     ?? "";
        var oauthAppleRedirectUri  = Cfg["OAuth:Apple:RedirectUri"]  ?? "";
    }
    <script>
      // OAuth provider config — injected from appsettings (server-side rendering)
      // Buttons only appear when the corresponding config value is non-empty
      window.vertexOAuthConfig = {
        google:   { clientId:    "@oauthGoogleClientId" },
        telegram: { botName:     "@oauthTelegramBotName",
                    botId:       "@oauthTelegramBotId" },
        apple:    { clientId:    "@oauthAppleClientId",
                    redirectUri: "@oauthAppleRedirectUri" }
      };
      // Remove empty values so isXxxConfigured() checks work correctly
      ['google','telegram','apple'].forEach(function(p) {
        var c = window.vertexOAuthConfig[p];
        if (c) Object.keys(c).forEach(function(k) { if (!c[k]) delete c[k]; });
      });
    </script>
    <script src="~/js/vertex-ui.js"></script>
    <script src="~/js/vertex-bridge.js"></script>
    <script src="~/js/ui-state.js"></script>

    <!-- 4️⃣ CHARTS (ИСПОЛЬЗУЮТ Chart + vertex.*) -->
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/market-chart.js"></script>
    <script src="~/js/mini-chart.js"></script>
    <script src="~/js/chart-drawing-tools.js"></script>
    <script src="~/js/sticky-stack.js"></script>
    <script src="~/js/sig-card-hover.js"></script>
    <script src="~/js/share-card.js"></script>
    <script src="~/js/auto-fit-panel.js"></script>
    <script src="~/js/ticker-drag-scroll.js"></script>
    <script src="~/js/learningchart.js"></script>
    <script src="~/js/learning-timeline.js"></script>
    <script src="~/js/ai-pulse.js"></script>
    <script src="~/js/ai-pulse-v1.js"></script>
    <script src="~/js/al-pulse.js"></script>
    <script src="~/js/market-resize.js"></script>
    <script src="~/js/ai-neural.js"></script>

    <!-- 5️⃣ BLazor Server runtime — ВСЕГДА ПОСЛЕДНИМ -->
    <script src="_framework/blazor.server.js"></script>

    <script src="/js/ai-pulse-v2.js"></script>
    <style>
      /* iOS PWA safe areas */
      html, body { min-height: 100%; min-height: -webkit-fill-available; }
      body {
        padding-top: env(safe-area-inset-top);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
        padding-bottom: env(safe-area-inset-bottom);
        background: #070b12;
        overscroll-behavior-y: none;
      }
    </style>
    <script>
      // Register PWA service worker (static assets only; Blazor Server needs network)
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function (e) {
            console.warn('[PWA] SW register failed', e);
          });
        });
      }
    </script>
</body>
</html>


