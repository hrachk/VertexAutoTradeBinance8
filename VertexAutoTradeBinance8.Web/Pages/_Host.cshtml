@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace VertexAutoTradeBinance8.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b1220" />
    <title>Vertex Console</title>
    <base href="~/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />

    <link rel="stylesheet" href="css/vertex.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Консоль потеряла связь с сервером. Перезагрузите страницу.
        </environment>
        <environment include="Development">
            Необработанное исключение. Подробности — в консоли браузера.
        </environment>
        <a href="" class="reload">Перезагрузить</a>
        <a class="dismiss">×</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
