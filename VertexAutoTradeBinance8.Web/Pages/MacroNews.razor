@page "/macro-news"
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.Extensions.Configuration
@using VertexAutoTradeBinance8.Services.Learning
@inject IConfiguration Cfg
@inject TradeJournalService Journal
@implements IDisposable

<div class="mn-root" lang="@_lang">
    <header class="mn-header">
        <div class="mn-brand">
            <span class="mn-logo">V</span>
            <div>
                <div class="mn-title">VERTEX <span class="mn-accent">MACRO NEWS</span></div>
                <div class="mn-path">@T("subtitle")</div>
            </div>
        </div>
        <div class="mn-header-right">
            <div class="mn-lang">
                <button type="button" class="@(_lang=="en"?"on":null)" @onclick='() => SetLang("en")'>EN</button>
                <button type="button" class="@(_lang=="ru"?"on":null)" @onclick='() => SetLang("ru")'>RU</button>
            </div>
            <div class="mn-shield @(_hardMode?"hard":"shadow")">
                <span class="mn-dot"></span>
                @T("shield"): @(_hardMode ? "HARD" : "SHADOW")
            </div>
        </div>
    </header>

    <section class="mn-top">
        <div class="mn-card">
            <div class="mn-k">@T("next_event")</div>
            <div class="mn-v cyan">@(_nextName ?? "—")</div>
            <div class="mn-s">@(_nextCd ?? T("no_cal"))</div>
        </div>
        <div class="mn-card">
            <div class="mn-k">Fear &amp; Greed</div>
            <div class="mn-v purple">@(_fg?.ToString() ?? "—") <span class="mn-sm">@_fgLabel</span></div>
            <div class="mn-meter"><i style="width:@(_fg ?? 0)%"></i></div>
        </div>
        <div class="mn-card">
            <div class="mn-k">@T("tape_mood")</div>
            <div class="mn-v @_moodCss">@_moodLabel</div>
            <div class="mn-s">@_moodHint</div>
        </div>
        <div class="mn-card">
            <div class="mn-k">@T("ai_bias")</div>
            <div class="mn-v @_biasCss">@_biasLabel</div>
            <div class="mn-s">@T("bias_hint")</div>
        </div>
    </section>

    <div class="mn-filters">
        @foreach (var f in _filters)
        {
            <button type="button" class="mn-chip @(_filter==f?"on":null)" @onclick="() => SetFilter(f)">@T(f)</button>
        }
        <input class="mn-search" placeholder="@T("search")" @bind="_q" @bind:event="oninput" />
    </div>

    <div class="mn-grid">
        <section class="mn-feed">
            <div class="mn-feed-hd">
                <span class="mn-live"><i></i> @T("feed")</span>
                <span class="mn-meta-hd">@_items.Count @T("stories") · @_srcCount @T("sources") · max @_maxAgeH h</span>
            </div>

            @if (_items.Count == 0)
            {
                <div class="mn-empty">
                    <strong>@T("empty_t")</strong>
                    <p>@T("empty_b")</p>
                </div>
            }
            else
            {
                @foreach (var n in View)
                {
                    <article class="mn-row impact-@n.Stars @n.Vec">
                        <div class="mn-row-top">
                            <span class="mn-imp">@ImpactTxt(n.Stars)</span>
                            <span class="mn-src">@n.Source</span>
                            <span class="mn-time">@n.Ago</span>
                            @if (n.Fresh) { <span class="mn-fresh">@T("fresh")</span> }
                        </div>
                        <h3 class="mn-hl">@n.Headline</h3>
                        @if (!string.IsNullOrWhiteSpace(n.Body))
                        {
                            <p class="mn-body">@n.Body</p>
                        }
                        <div class="mn-tags">
                            @if (!string.IsNullOrEmpty(n.Cat))
                            {
                                <span class="mn-tag cat">@n.Cat</span>
                            }
                            @foreach (var s in n.Syms.Take(6))
                            {
                                <span class="mn-tag sym">@s</span>
                            }
                            @if (!string.IsNullOrEmpty(n.Url))
                            {
                                <a class="mn-tag link" href="@n.Url" target="_blank" rel="noopener">@T("open")</a>
                            }
                        </div>
                    </article>
                }
            }
        </section>

        <aside class="mn-side">
            <div class="mn-panel">
                <div class="mn-panel-t">@T("kpi_t")</div>
                <div class="mn-kpi">
                    <div>
                        <span>@T("pf_act")</span>
                        <b>@_pfA.ToString("0.00")</b>
                        <small>@_nA @T("trades") · WR @_wrA.ToString("0")%</small>
                    </div>
                    <div>
                        <span>@T("pf_fil")</span>
                        <b>@_pfF.ToString("0.00")</b>
                        <small>@_nF @T("trades") · WR @_wrF.ToString("0")%</small>
                    </div>
                </div>
                <div class="mn-delta @(_dPf >= 0.15m ? "ok" : "")">
                    ΔPF @(_dPf >= 0 ? "+" : "")@_dPf.ToString("0.00")
                    <span>@T("kpi_goal")</span>
                </div>
                <div class="mn-status @(_recommend ? "go" : "wait")">
                    @(_recommend ? T("kpi_go") : T("kpi_wait"))
                </div>
                <p class="mn-note">@T("kpi_note")</p>
            </div>

            <div class="mn-panel">
                <div class="mn-panel-t">@T("how_t")</div>
                <ul class="mn-list">
                    <li>@T("how1")</li>
                    <li>@T("how2")</li>
                    <li>@T("how3")</li>
                </ul>
            </div>

            <div class="mn-panel muted">
                <div class="mn-panel-t">@T("leg_t")</div>
                <div class="mn-leg"><span class="r"></span> Impact 4–5</div>
                <div class="mn-leg"><span class="a"></span> Impact 3</div>
                <div class="mn-leg"><span class="g"></span> Impact 1–2</div>
            </div>
        </aside>
    </div>
</div>

<style>
.mn-root{--bg:#070b12;--card:#0d141e;--line:rgba(255,255,255,.08);--cyan:#22d3ee;--purple:#c084fc;--green:#34d399;--red:#f87171;--amber:#fbbf24;--text:#e8eef7;--muted:#8b9cb3;padding:16px 18px 28px;color:var(--text);background:radial-gradient(800px 400px at 10% -10%,rgba(34,211,238,.07),transparent 50%),var(--bg);min-height:calc(100vh - 48px);font-family:Inter,system-ui,sans-serif}
.mn-header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.mn-brand{display:flex;gap:12px;align-items:center}
.mn-logo{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#22d3ee,#7c3aed);display:grid;place-items:center;font-weight:900;color:#041018}
.mn-title{font-weight:800;font-size:14px;letter-spacing:.04em}
.mn-accent{color:var(--cyan)}
.mn-path{font-size:11px;color:var(--muted);margin-top:2px}
.mn-header-right{display:flex;gap:8px;align-items:center}
.mn-lang{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:#0a1018}
.mn-lang button{border:0;background:0;color:var(--muted);padding:6px 12px;cursor:pointer;font-size:11px;font-weight:700}
.mn-lang button.on{background:rgba(34,211,238,.15);color:var(--cyan)}
.mn-shield{display:flex;align-items:center;gap:7px;padding:6px 12px;border-radius:999px;border:1px solid var(--line);font-size:11px;font-weight:700;background:#0a1018}
.mn-shield.shadow{color:#7dd3fc}.mn-shield.hard{color:#fca5a5;border-color:rgba(248,113,113,.4)}
.mn-dot{width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}
.mn-top{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}
@@media(max-width:1100px){.mn-top{grid-template-columns:1fr 1fr}}
@@media(max-width:560px){.mn-top{grid-template-columns:1fr}}
.mn-card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.mn-k{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:700;margin-bottom:6px}
.mn-v{font-size:22px;font-weight:800;line-height:1.15;letter-spacing:-.02em}
.mn-v.cyan{color:var(--cyan)}.mn-v.purple{color:var(--purple)}.mn-v.green{color:var(--green)}
.mn-v.warn{color:var(--amber)}.mn-v.danger{color:var(--red)}.mn-v.neu{color:#cbd5e1}
.mn-s{font-size:12px;color:var(--muted);margin-top:6px;line-height:1.35}
.mn-sm{font-size:12px;font-weight:600;opacity:.85}
.mn-meter{height:6px;background:#15202e;border-radius:99px;margin-top:10px;overflow:hidden}
.mn-meter>i{display:block;height:100%;background:linear-gradient(90deg,#a855f7,#22d3ee);border-radius:99px}
.mn-filters{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-bottom:12px}
.mn-chip{border:1px solid var(--line);background:#0a1018;color:var(--muted);border-radius:999px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer}
.mn-chip.on{border-color:var(--cyan);color:var(--cyan);background:rgba(34,211,238,.1)}
.mn-search{margin-left:auto;background:#0a1018;border:1px solid var(--line);border-radius:10px;padding:7px 12px;color:var(--text);font-size:12px;min-width:140px}
.mn-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.65fr);gap:12px}
@@media(max-width:960px){.mn-grid{grid-template-columns:1fr}}
.mn-feed{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;min-height:420px}
.mn-feed-hd{display:flex;justify-content:space-between;align-items:center;padding:4px 6px 12px;border-bottom:1px solid var(--line);margin-bottom:10px}
.mn-live{display:flex;align-items:center;gap:8px;font-weight:800;font-size:13px}
.mn-live i{width:7px;height:7px;border-radius:50%;background:#f87171;box-shadow:0 0 10px #f87171;display:inline-block}
.mn-meta-hd{font-size:11px;color:var(--muted)}
.mn-empty{padding:28px 12px;color:var(--muted);font-size:13px;line-height:1.5}
.mn-empty strong{color:var(--text);display:block;margin-bottom:6px}
.mn-row{padding:12px 12px;border-radius:12px;border:1px solid var(--line);background:rgba(0,0,0,.22);margin-bottom:8px;border-left:3px solid #475569}
.mn-row.bull{border-left-color:var(--green)}.mn-row.bear{border-left-color:var(--red)}
.mn-row.impact-4,.mn-row.impact-5{background:rgba(248,113,113,.06);border-color:rgba(248,113,113,.18)}
.mn-row-top{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:11px;color:var(--muted);margin-bottom:6px}
.mn-imp{padding:2px 8px;border-radius:999px;font-weight:800;font-size:10px;background:rgba(148,163,184,.15);color:#94a3b8}
.impact-3 .mn-imp{background:rgba(251,191,36,.15);color:var(--amber)}
.impact-4 .mn-imp,.impact-5 .mn-imp{background:rgba(248,113,113,.2);color:#fca5a5}
.mn-fresh{padding:2px 7px;border-radius:999px;font-weight:800;font-size:10px;background:rgba(52,211,153,.18);color:#6ee7b7}
.mn-hl{margin:0;font-size:14.5px;line-height:1.4;font-weight:650;color:#f1f5f9}
.mn-body{margin:6px 0 0;font-size:12.5px;color:var(--muted);line-height:1.45}
.mn-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px;align-items:center}
.mn-tag{padding:2px 8px;border-radius:6px;font-size:11px;font-weight:600;background:#15202e;color:#cbd5e1}
.mn-tag.cat{background:rgba(34,211,238,.1);color:#67e8f9}
.mn-tag.link{color:var(--cyan);text-decoration:none;background:transparent;border:1px solid rgba(34,211,238,.25)}
.mn-side{display:flex;flex-direction:column;gap:10px}
.mn-panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px}
.mn-panel.muted{opacity:.95}
.mn-panel-t{font-weight:800;font-size:12px;margin-bottom:10px;letter-spacing:.03em}
.mn-kpi{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mn-kpi span{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.mn-kpi b{display:block;font-size:22px;margin:2px 0}
.mn-kpi small{font-size:11px;color:var(--muted)}
.mn-delta{margin-top:12px;font-weight:800;font-size:16px;color:var(--muted);display:flex;flex-direction:column;gap:2px}
.mn-delta span{font-size:11px;font-weight:600}
.mn-delta.ok{color:var(--green)}
.mn-status{margin-top:10px;padding:8px 10px;border-radius:10px;font-size:12px;font-weight:700}
.mn-status.wait{background:rgba(251,191,36,.08);color:#fcd34d;border:1px solid rgba(251,191,36,.2)}
.mn-status.go{background:rgba(52,211,153,.1);color:#6ee7b7;border:1px solid rgba(52,211,153,.25)}
.mn-note{font-size:11.5px;color:var(--muted);margin:10px 0 0;line-height:1.4}
.mn-list{margin:0;padding-left:16px;font-size:12.5px;color:var(--muted);line-height:1.55}
.mn-leg{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:6px}
.mn-leg span{width:9px;height:9px;border-radius:3px;display:inline-block}
.mn-leg .r{background:#f87171}.mn-leg .a{background:#fbbf24}.mn-leg .g{background:#64748b}
</style>

@code {
    string _lang = "ru";
    string _filter = "all";
    string _q = "";
    bool _hardMode, _recommend;
    int? _fg;
    string _fgLabel = "";
    string _moodLabel = "—", _moodCss = "neu", _moodHint = "";
    string _biasLabel = "—", _biasCss = "neu";
    string? _nextName, _nextCd;
    decimal _pfA, _pfF, _dPf, _wrA, _wrF;
    int _nA, _nF, _srcCount, _maxAgeH = 6;
    List<Row> _items = new();
    System.Threading.Timer? _timer;

    readonly string[] _filters = { "all", "macro", "crypto", "high" };

    static readonly Dictionary<string, (string en, string ru)> L = new()
    {
        ["subtitle"] = ("Operational macro & crypto tape", "Оперативная лента макро и крипто"),
        ["shield"] = ("Shield", "Щит"),
        ["next_event"] = ("Next macro", "След. макро"),
        ["no_cal"] = ("No event in config", "Нет в календаре конфига"),
        ["tape_mood"] = ("Tape mood", "Настроение ленты"),
        ["ai_bias"] = ("Context bias", "Контекст"),
        ["bias_hint"] = ("Not a trade signal", "Не торговый сигнал"),
        ["all"] = ("All", "Все"),
        ["macro"] = ("Macro", "Макро"),
        ["crypto"] = ("Crypto", "Крипто"),
        ["high"] = ("Impact ≥3", "Impact ≥3"),
        ["search"] = ("Search…", "Поиск…"),
        ["feed"] = ("News feed", "Лента новостей"),
        ["stories"] = ("items", "записей"),
        ["sources"] = ("sources", "источников"),
        ["empty_t"] = ("No fresh items", "Нет свежих записей"),
        ["empty_b"] = ("Engine must be running; tape fills every ~15s from Cointelegraph, CoinDesk, CryptoCompare.", "Нужен запущенный Engine; лента обновляется ~15с (Cointelegraph, CoinDesk, CryptoCompare)."),
        ["fresh"] = ("FRESH", "СВЕЖЕЕ"),
        ["open"] = ("open ↗", "открыть ↗"),
        ["kpi_t"] = ("News filter effect (same as AI Dashboard)", "Эффект фильтра (как на AI Dashboard)"),
        ["pf_act"] = ("Actual PF", "Факт PF"),
        ["pf_fil"] = ("If skip “news” closes", "Без «news»-закрытий"),
        ["trades"] = ("trades", "сделок"),
        ["kpi_goal"] = ("Hard only if ΔPF ≥ +0.15", "Hard только при ΔPF ≥ +0.15"),
        ["kpi_go"] = ("Metrics support enabling Hard gate", "Метрики допускают включение Hard"),
        ["kpi_wait"] = ("No proven edge yet — keep SHADOW", "Пользы пока нет — оставьте SHADOW"),
        ["kpi_note"] = ("PF here matches AI Dashboard journal math. News does not open positions.", "PF считается из журнала, как на AI Dashboard. Новости не открывают позиции."),
        ["how_t"] = ("How this links to trading", "Связь с торговлей"),
        ["how1"] = ("CORE still generates entries.", "Входы по-прежнему от CORE."),
        ["how2"] = ("SHADOW = observe only (current).", "SHADOW = только наблюдение (сейчас)."),
        ["how3"] = ("HARD = optional block of NEW entries (Settings → Risk).", "HARD = опциональный блок НОВЫХ входов (Settings → Risk)."),
        ["leg_t"] = ("Legend", "Легенда"),
        ["imp_hi"] = ("HIGH", "ВЫСОКИЙ"),
        ["imp_md"] = ("MED", "СРЕДНИЙ"),
        ["imp_lo"] = ("LOW", "НИЗКИЙ"),
        ["mood_neu"] = ("NEUTRAL", "НЕЙТРАЛЬНО"),
        ["mood_bull"] = ("RISK-ON", "RISK-ON"),
        ["mood_bear"] = ("RISK-OFF", "RISK-OFF"),
        ["mood_mixed"] = ("MIXED", "СМЕШАННО"),
        ["bias_calm"] = ("CALM / GREED", "СПОКОЙНО / ЖАДНОСТЬ"),
        ["bias_heat"] = ("ELEVATED RISK", "ПОВЫШЕННЫЙ РИСК"),
        ["bias_fear"] = ("FEAR REGIME", "РЕЖИМ СТРАХА"),
    };

    string T(string k) => L.TryGetValue(k, out var v) ? (_lang == "ru" ? v.ru : v.en) : k;
    string ImpactTxt(int s) => s >= 4 ? T("imp_hi") : s >= 3 ? T("imp_md") : T("imp_lo");

    IEnumerable<Row> View
    {
        get
        {
            IEnumerable<Row> q = _items;
            q = _filter switch
            {
                "macro" => q.Where(x => x.IsMacro),
                "crypto" => q.Where(x => !x.IsFg),
                "high" => q.Where(x => x.Stars >= 3),
                _ => q
            };
            if (!string.IsNullOrWhiteSpace(_q))
            {
                var s = _q.Trim();
                q = q.Where(x =>
                    x.Headline.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || x.Body.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || x.Syms.Any(z => z.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || x.Source.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    protected override void OnInitialized()
    {
        Reload();
        _timer = new System.Threading.Timer(_ =>
        {
            try { Reload(); InvokeAsync(StateHasChanged); } catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    void SetLang(string l) { _lang = l; ApplyMoodBias(); }
    void SetFilter(string f) => _filter = f;

    void Reload()
    {
        var root = Cfg["SharedData:Root"] ?? "";
        _hardMode = string.Equals(Cfg["Institutional:EnableNewsHardMode"], "true", StringComparison.OrdinalIgnoreCase);
        _maxAgeH = Math.Clamp(Cfg.GetValue("News:MaxAgeHours", 6), 1, 48);
        LoadTape(root);
        LoadKpiFromJournal();
        LoadCalendar();
        ApplyMoodBias();
    }

    void LoadTape(string root)
    {
        _items = new();
        _srcCount = 0;
        _fg = null;
        _fgLabel = "";
        if (string.IsNullOrWhiteSpace(root)) return;
        var path = Path.Combine(root, "news_tape.jsonl");
        if (!File.Exists(path)) return;

        try
        {
            var lines = File.ReadAllLines(path);
            var list = new List<Row>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var sources = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            for (int i = lines.Length - 1; i >= 0 && list.Count < 40; i--)
            {
                var line = lines[i];
                if (string.IsNullOrWhiteSpace(line)) continue;
                try
                {
                    using var doc = JsonDocument.Parse(line);
                    var r = doc.RootElement;
                    if (r.TryGetProperty("type", out var ty) && ty.GetString() == "entry_eval") continue;
                    if (!r.TryGetProperty("headline", out var hlEl)) continue;
                    var hl = (hlEl.GetString() ?? "").Trim();
                    if (hl.Length == 0) continue;

                    bool isFg = hl.Contains("Fear", StringComparison.OrdinalIgnoreCase)
                                && hl.Contains("Greed", StringComparison.OrdinalIgnoreCase);

                    var utc = DateTime.UtcNow;
                    if (r.TryGetProperty("utc", out var u) && u.ValueKind == JsonValueKind.String
                        && DateTime.TryParse(u.GetString(), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var p))
                        utc = p.ToUniversalTime();

                    if (!isFg && (DateTime.UtcNow - utc).TotalHours > _maxAgeH) continue;

                    var fp = isFg ? "FNG" : Regex.Replace(hl, @"\s+", " ").ToLowerInvariant();
                    if (!seen.Add(fp)) continue;

                    var src = r.TryGetProperty("source", out var sEl) ? (sEl.GetString() ?? "") : "";
                    if (string.IsNullOrEmpty(src) && isFg) src = "alternative.me/fng";
                    sources.Add(src);

                    int stars = 1;
                    if (r.TryGetProperty("impactStars", out var st) && st.TryGetInt32(out var si))
                        stars = Math.Clamp(si, 1, 5);
                    else if (r.TryGetProperty("impact", out var im) && im.TryGetDecimal(out var imp))
                        stars = imp >= 0.85m ? 5 : imp >= 0.7m ? 4 : imp >= 0.5m ? 3 : imp >= 0.35m ? 2 : 1;

                    // Bump regulatory headlines for display clarity
                    if (hl.Contains("SEC", StringComparison.OrdinalIgnoreCase)
                        || hl.Contains("CFTC", StringComparison.OrdinalIgnoreCase)
                        || hl.Contains("FOMC", StringComparison.OrdinalIgnoreCase)
                        || hl.Contains("CPI", StringComparison.OrdinalIgnoreCase))
                        stars = Math.Max(stars, 3);

                    var vector = r.TryGetProperty("vector", out var vEl) ? (vEl.GetString() ?? "") : "";
                    var vec = vector.Contains("Bull", StringComparison.OrdinalIgnoreCase) ? "bull"
                        : vector.Contains("Bear", StringComparison.OrdinalIgnoreCase) ? "bear" : "neu";

                    var cat = r.TryGetProperty("category", out var cEl) ? (cEl.GetString() ?? "") : "";
                    var body = r.TryGetProperty("body", out var bEl) ? (bEl.GetString() ?? "") : "";
                    if (isFg && string.IsNullOrWhiteSpace(body))
                        body = _lang == "ru"
                            ? "Индикатор режима рынка (не новость по одной монете)."
                            : "Market regime indicator (not a single-token story).";

                    var syms = new List<string>();
                    if (r.TryGetProperty("symbols", out var sy) && sy.ValueKind == JsonValueKind.Array)
                        foreach (var el in sy.EnumerateArray())
                        {
                            var ss = el.GetString();
                            if (!string.IsNullOrEmpty(ss)) syms.Add(ss);
                        }

                    if (isFg)
                    {
                        var m = Regex.Match(hl, @"(\d{1,3})");
                        if (m.Success && int.TryParse(m.Groups[1].Value, out var fg) && fg is >= 0 and <= 100)
                        {
                            _fg = fg;
                            _fgLabel = FgLabel(fg);
                        }
                        // Prefer human age for daily regime index
                        if ((DateTime.UtcNow - utc).TotalHours > 6)
                            utc = DateTime.UtcNow; // display as current regime snapshot
                    }

                    // Optional RU soft title for F&G only
                    var title = isFg && _lang == "ru"
                        ? Regex.Replace(hl, @"Crypto Fear&Greed (\d+) \(([^)]+)\)",
                            mm => $"Индекс страха и жадности {mm.Groups[1].Value} ({FgLabelRu(mm.Groups[2].Value)})",
                            RegexOptions.IgnoreCase)
                        : hl;

                    list.Add(new Row
                    {
                        Headline = title.Length > 200 ? title[..200] + "…" : title,
                        Body = body.Length > 280 ? body[..280] + "…" : body,
                        Source = src,
                        Cat = string.IsNullOrEmpty(cat) ? "" : cat.ToUpperInvariant(),
                        Stars = stars,
                        Vec = vec,
                        Syms = syms,
                        Url = r.TryGetProperty("url", out var ur) ? (ur.GetString() ?? "") : "",
                        Ago = isFg && (DateTime.UtcNow - utc).TotalHours < 1 ? (_lang == "ru" ? "режим" : "regime") : Ago(utc),
                        Fresh = !isFg && (DateTime.UtcNow - utc).TotalMinutes <= 45,
                        IsFg = isFg,
                        IsMacro = isFg || cat.Contains("Macro", StringComparison.OrdinalIgnoreCase)
                                  || hl.Contains("SEC", StringComparison.OrdinalIgnoreCase)
                                  || hl.Contains("FOMC", StringComparison.OrdinalIgnoreCase)
                                  || hl.Contains("CFTC", StringComparison.OrdinalIgnoreCase),
                        Utc = utc
                    });
                }
                catch { }
            }

            _items = list.OrderByDescending(x => x.Utc).ToList();
            _srcCount = sources.Count;
        }
        catch { }
    }

    void LoadKpiFromJournal()
    {
        _pfA = _pfF = _dPf = 0; _wrA = _wrF = 0; _nA = _nF = 0; _recommend = false;
        try
        {
            var clientId = Cfg["SharedData:DefaultClientId"] ?? "client_001";
            var trades = Journal.GetRecentEntries(clientId, null, 500)?.ToList() ?? new List<TradeJournalEntry>();
            var ordered = trades.OrderBy(x => x.ClosedAtUtc).ToList();

            (decimal pf, decimal wr, decimal dd, int n) Compute(List<TradeJournalEntry> list)
            {
                decimal gw = 0, gl = 0, eq = 0, peak = 0, maxDd = 0;
                int wins = 0;
                foreach (var tr in list)
                {
                    var p = tr.RealizedPnl;
                    if (p > 0) { gw += p; wins++; } else gl += Math.Abs(p);
                    eq += p;
                    if (eq > peak) peak = eq;
                    var d = peak - eq;
                    if (d > maxDd) maxDd = d;
                }
                decimal pf = gl > 0 ? gw / gl : (gw > 0 ? 99m : 0m);
                decimal wr = list.Count > 0 ? 100m * wins / list.Count : 0m;
                return (pf, wr, maxDd, list.Count);
            }

            var actual = Compute(ordered);
            var filtered = ordered.Where(tr =>
            {
                var r = (tr.CloseReason ?? "").ToUpperInvariant();
                return !(r.Contains("NEWS") || r.Contains("MACRO") || r.Contains("CATALYST"));
            }).ToList();
            var filt = Compute(filtered);

            _pfA = actual.pf; _pfF = filt.pf; _dPf = filt.pf - actual.pf;
            _wrA = actual.wr; _wrF = filt.wr;
            _nA = actual.n; _nF = filt.n;
            _recommend = actual.n >= 50 && _dPf >= 0.15m && filt.dd <= actual.dd;
        }
        catch { }
    }

    void LoadCalendar()
    {
        _nextName = null; _nextCd = null;
        try
        {
            DateTime? best = null; string? name = null;
            foreach (var child in Cfg.GetSection("News:MacroEvents").GetChildren())
            {
                var n = child["Name"] ?? "Event";
                var utc = child["Utc"];
                if (utc == null || !DateTime.TryParse(utc, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dt))
                    continue;
                dt = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
                if (dt < DateTime.UtcNow.AddHours(-2)) continue;
                if (best == null || dt < best) { best = dt; name = n; }
            }
            if (best != null && name != null)
            {
                _nextName = name;
                var left = best.Value - DateTime.UtcNow;
                _nextCd = left.TotalSeconds < 0 ? "—" : $"{(int)left.TotalDays}d {left.Hours:00}h {left.Minutes:00}m";
            }
        }
        catch { }
    }

    void ApplyMoodBias()
    {
        int bull = _items.Count(x => x.Vec == "bull");
        int bear = _items.Count(x => x.Vec == "bear");
        int hiBear = _items.Count(x => x.Stars >= 4 && x.Vec == "bear");
        int hiBull = _items.Count(x => x.Stars >= 4 && x.Vec == "bull");

        if (bull == 0 && bear == 0)
        {
            _moodLabel = T("mood_neu");
            _moodCss = "neu";
            _moodHint = _lang == "ru" ? "В ленте нет явного bull/bear" : "No clear bull/bear in tape";
        }
        else if (bull > bear * 1.5)
        {
            _moodLabel = T("mood_bull");
            _moodCss = "green";
            _moodHint = $"{bull} bull / {bear} bear";
        }
        else if (bear > bull * 1.5)
        {
            _moodLabel = T("mood_bear");
            _moodCss = "danger";
            _moodHint = $"{bull} bull / {bear} bear";
        }
        else
        {
            _moodLabel = T("mood_mixed");
            _moodCss = "warn";
            _moodHint = $"{bull} bull / {bear} bear";
        }

        // Bias: F&G + high-impact first (do not scream BEARISH on neutral tape + greed)
        if (hiBear >= 2 || (_fg is <= 25))
        {
            _biasLabel = T("bias_fear");
            _biasCss = "danger";
        }
        else if (hiBull >= 2)
        {
            _biasLabel = T("mood_bull");
            _biasCss = "green";
        }
        else if (_fg is >= 55)
        {
            _biasLabel = T("bias_calm");
            _biasCss = "purple";
        }
        else if (_fg is <= 40)
        {
            _biasLabel = T("bias_heat");
            _biasCss = "warn";
        }
        else
        {
            _biasLabel = T("mood_neu");
            _biasCss = "neu";
        }
    }

    static string FgLabel(int fg) => fg >= 75 ? "Extreme Greed" : fg >= 55 ? "Greed" : fg >= 45 ? "Neutral" : fg >= 25 ? "Fear" : "Extreme Fear";
    static string FgLabelRu(string s) => s.ToLowerInvariant() switch
    {
        "extreme greed" => "экстр. жадность",
        "greed" => "жадность",
        "neutral" => "нейтрально",
        "fear" => "страх",
        "extreme fear" => "экстр. страх",
        _ => s
    };

    static string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m";
        if (d.TotalHours < 48) return $"{(int)d.TotalHours}h";
        return $"{(int)d.TotalDays}d";
    }

    public void Dispose() => _timer?.Dispose();

    sealed class Row
    {
        public string Headline { get; set; } = "";
        public string Body { get; set; } = "";
        public string Source { get; set; } = "";
        public string Cat { get; set; } = "";
        public int Stars { get; set; }
        public string Vec { get; set; } = "neu";
        public List<string> Syms { get; set; } = new();
        public string Url { get; set; } = "";
        public string Ago { get; set; } = "";
        public bool Fresh { get; set; }
        public bool IsFg { get; set; }
        public bool IsMacro { get; set; }
        public DateTime Utc { get; set; }
    }
}
