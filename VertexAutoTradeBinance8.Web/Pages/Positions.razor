.p-pnl-sc-lab{font-size:11px;color:var(--dim);margin-top:4px;text-transform:uppercase;letter-spacing:.5px;}
.ps-pos{background:linear-gradient(135deg,rgba(0,214,143,.05),var(--bg2));}
.ps-neg{background:linear-gradient(135deg,rgba(255,77,106,.05),var(--bg2));}

/* ── MODAL ──────────────────────────────────────────────── */
.p-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;animation:fadeIn .2s ease;}
@@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.p-modal{background:var(--bg3);border:1px solid var(--bdr2);border-radius:16px;width:420px;box-shadow:0 24px 80px rgba(0,0,0,.6);animation:slideUp .25s ease;}
@@keyframes slideUp{from{transform:translateY(20px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.p-modal-top{display:flex;align-items:center;justify-content:space-between;padding:20px 22px 16px;border-bottom:1px solid var(--bdr);}
.p-modal-title{font-size:16px;font-weight:700;}
.p-modal-x{background:none;border:none;color:var(--dim);cursor:pointer;font-size:16px;width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.p-modal-x:hover{background:var(--bg4);color:var(--txt);}
.p-modal-body{padding:20px 22px;}
.p-modal-sym{display:flex;align-items:center;gap:14px;margin-bottom:20px;}
.p-modal-sym-name{font-size:19px;font-weight:700;font-family:var(--mono);margin-bottom:6px;}
.p-modal-rows{display:flex;flex-direction:column;gap:0;border:1px solid var(--bdr);border-radius:8px;overflow:hidden;margin-bottom:16px;}
.p-modal-row{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid var(--bdr);font-size:13px;}
.p-modal-row:last-child{border-bottom:none;}
.p-modal-row:nth-child(odd){background:rgba(255,255,255,.015);}
.p-modal-warn{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:rgba(255,209,102,.06);border:1px solid rgba(255,209,102,.15);border-radius:8px;font-size:12px;color:var(--yel);line-height:1.5;}
.p-modal-foot{display:flex;gap:10px;padding:16px 22px;border-top:1px solid var(--bdr);}
.p-modal-cancel{flex:1;background:var(--bg4);border:1px solid var(--bdr2);color:var(--txt);padding:11px;border-radius:8px;font-size:14px;cursor:pointer;font-weight:500;transition:all .15s;}
.p-modal-cancel:hover{border-color:var(--bdr);}
.p-modal-confirm{flex:1;background:linear-gradient(135deg,#ff3355,#ff6680);border:none;color:#fff;padding:11px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.p-modal-confirm:hover{box-shadow:0 4px 20px rgba(255,51,85,.4);transform:translateY(-1px);}
.p-modal-confirm:disabled{opacity:.5;cursor:not-allowed;transform:none;}
.p-spin-sm{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}

/* ── TOAST ──────────────────────────────────────────────── */
.p-toast{position:fixed;bottom:28px;right:28px;padding:13px 22px;border-radius:10px;font-size:14px;font-weight:600;z-index:10000;animation:toastIn .3s ease;display:flex;align-items:center;gap:8px;box-shadow:0 8px 32px rgba(0,0,0,.4);}
.t-ok{background:rgba(0,214,143,.15);border:1px solid rgba(0,214,143,.3);color:var(--grn);}
.t-err{background:rgba(255,77,106,.15);border:1px solid rgba(255,77,106,.3);color:var(--red);}
@@keyframes toastIn{from{transform:translateY(12px);opacity:0;}to{transform:translateY(0);opacity:1;}}

@@media(max-width:1100px){.p-card-grid{grid-template-columns:repeat(3,1fr);}
.p-hero-stats{display:none;}}
@@media(max-width:700px){.p-hero{flex-wrap:wrap;gap:12px;}.p-card-grid{grid-template-columns:repeat(2,1fr);}.p-pnl-summ{grid-template-columns:repeat(2,1fr);}}
</style>

@code {
    // ── Models ────────────────────────────────────────────────
    record PosRow(string Symbol, string Side, int Leverage,
        decimal SizeUsdt, decimal Entry, decimal Mark, decimal LiqPrice,
        decimal Margin, decimal MarginRatio, decimal Pnl, decimal Roi);

    record OrdRow(long Id, string Symbol, string Type, string Side, string PosSide,
        decimal Price, decimal StopPrice, decimal OrigQty, decimal ExecutedQty,
        bool ReduceOnly, DateTime Time)
    {
        public bool IsAlgo { get; init; }
    }

    record HistRow(long Id, string Symbol, string Type, string Side,
        decimal Price, decimal AvgPrice, decimal OrigQty, decimal ExecutedQty,
        string Status, DateTime Updated);

    record PnlRow(string Symbol, string Side, decimal Entry, decimal Exit,
        decimal Qty, decimal Pnl, decimal Roe, decimal Commission, DateTime Time);

    // ── State ─────────────────────────────────────────────────
    // ── Live prices ──────────────────────────────────────────
    // ConcurrentDictionary for live prices (written from SignalR thread,
    // read from Blazor render thread) — prevents InvalidOperationException
    // "Collection was modified" that crashed the circuit.
    readonly System.Collections.Concurrent.ConcurrentDictionary<string, decimal> _livePrices = new();
    // Sparklines: lock protects the List while it is being modified.
    // GetSparkline() returns a SNAPSHOT (new list copy) so the render
    // thread iterates a stable collection even if OnLivePriceTick fires
    // concurrently and mutates the original list.
    readonly System.Collections.Concurrent.ConcurrentDictionary<string, List<decimal>> _sparklines = new();
    readonly object _sparkLock = new();
    const int SparkMax = 60;

    decimal GetLivePrice(string sym) => _livePrices.TryGetValue(sym, out var p) ? p : 0m;

    // Returns a snapshot — safe to enumerate while the source list is mutated
    List<decimal> GetSparkline(string sym)
    {
        if (!_sparklines.TryGetValue(sym, out var s)) return new();
        lock (_sparkLock) { return new List<decimal>(s); }  // snapshot
    }

    void OnLivePriceTick(string sym, decimal price)
    {
        _livePrices[sym] = price;
        lock (_sparkLock)
        {
            var sp = _sparklines.GetOrAdd(sym, _ => new List<decimal>());
            sp.Add(price);
            if (sp.Count > SparkMax) sp.RemoveAt(0);
        }
        if (_positions.Any(p => p.Symbol == sym))
            _ = InvokeAsync(StateHasChanged);
    }

    // ── Spark helper methods ─────────────────────────────────
    // All string work done in C# — never inline inside HTML attributes
    // Each method takes a snapshot via GetSparkline so render thread
    // iterates a stable copy even if SignalR fires concurrently.

    static (decimal mn, decimal rng, double sw) SparkScale(List<decimal> s)
    {
        var mn = s.Min(); var mx = s.Max();
        var rng = mx - mn; if (rng == 0) rng = 1m;
        return (mn, rng, 200.0 / Math.Max(s.Count - 1, 1));
    }

    bool HasSparkline(string sym)
    {
        var s = GetSparkline(sym);
        return s.Count > 1;
    }

    string BuildSparkPoints(string sym)
    {
        var s = GetSparkline(sym);
        if (s.Count < 2) return "";
        var (mn, rng, sw) = SparkScale(s);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < s.Count; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append((i * sw).ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(((double)(36m - (s[i] - mn) / rng * 32m))
                .ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }

    string BuildSparkFill(string sym)
    {
        var s = GetSparkline(sym);
        if (s.Count < 2) return "";
        var (_, _, sw) = SparkScale(s);
        double lastX = (s.Count - 1) * sw;
        var pts = BuildSparkPoints(sym);
        if (string.IsNullOrEmpty(pts)) return "";
        return "M0,36 L" + pts.Replace(" ", " L") + " L"
             + lastX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + ",36 Z";
    }

    string SparkColor(string sym)
    {
        var s = GetSparkline(sym);
        return s.Count >= 2 && s.Last() >= s.First() ? "#22c55e" : "#ef4444";
    }

    string SparkFill(string sym)
    {
        var s = GetSparkline(sym);
        return s.Count >= 2 && s.Last() >= s.First()
            ? "rgba(34,197,94,.08)" : "rgba(239,68,68,.08)";
    }

    string SparkLastX(string sym)
    {
        var s = GetSparkline(sym);
        if (s.Count < 2) return "0";
        var (_, _, sw) = SparkScale(s);
        return ((s.Count - 1) * sw)
            .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    }

    string SparkLastY(string sym)
    {
        var s = GetSparkline(sym);
        if (s.Count < 2) return "18";
        var (mn, rng, _) = SparkScale(s);
        return ((double)(36m - (s.Last() - mn) / rng * 32m))
            .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    }

    // ── Mini popup ───────────────────────────────────────────
    PosRow? _miniPos;
    string  _miniTf = "FifteenMinutes";
    void OpenMiniStats(PosRow p) => _miniPos = p;

    // ── Partial close ────────────────────────────────────────
    PosRow? _partialPos;
    int _partialPct = 50;
    void OpenPartialClose(PosRow p) { _partialPos = p; _partialPct = 50; }
    void OnPartialPctInput(ChangeEventArgs e)
        => _partialPct = int.TryParse(e.Value?.ToString(), out var v) ? v : 50;

    async Task PartialCloseConfirmed()
    {
        if (_partialPos == null) return;
        _actionLoading = true; StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { ShowToast("No API credentials", false); return; }
            var p = _partialPos;
            bool isL = p.Side == "LONG";
            decimal totalQty = p.Entry > 0 ? p.SizeUsdt / p.Entry : 0m;
            decimal closeQty = Math.Round(totalQty * _partialPct / 100m, 3);
            if (closeQty <= 0) { ShowToast("Qty too small", false); return; }
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var side    = isL ? Binance.Net.Enums.OrderSide.Sell : Binance.Net.Enums.OrderSide.Buy;
            var posSide = isL ? Binance.Net.Enums.PositionSide.Long : Binance.Net.Enums.PositionSide.Short;
            var res = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                p.Symbol, side, Binance.Net.Enums.FuturesOrderType.Market,
                quantity: closeQty, positionSide: posSide, reduceOnly: true, ct: cts.Token);
            if (res.Success)
            {
                ShowToast($"✓ Closed {_partialPct}% of {p.Symbol}", true);
                _partialPos = null;
                await FetchPositions();
            }
            else ShowToast($"Error: {res.Error?.Message}", false);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _actionLoading = false; StateHasChanged(); }
    }

    int _tab;
    int _ordSubTab; // 0=Basic 1=Conditional
    bool _loading, _ordLoading, _histLoading, _actionLoading, _pnlLoading;
    DateTime _lastRefresh;
    string _error = string.Empty;
    string _toast = string.Empty;
    bool _toastOk;
    PosRow? _confirmPos;
    System.Threading.Timer? _timer;

    // These lists are replaced atomically (full reassignment, never mutated
    // in-place) so foreach in render always gets a consistent snapshot.
    // Timer thread does: _positions = newList (atomic reference swap)
    // Render thread does: foreach(var p in _positions) — sees old OR new,
    // never a partially-mutated state.
    volatile List<PosRow>  _positions  = new();
    volatile List<OrdRow>  _openOrders = new();
    volatile List<HistRow> _histOrders = new();
    volatile List<PnlRow>  _pnlRows    = new();

    decimal _totalPnl, _pnlTotal, _realizedPnlToday;
    int _pnlWins;

    protected override async Task OnInitializedAsync()
    {
        LiveState.PriceTicked += OnLivePriceTick;
        await RefreshAll();
        _timer = new System.Threading.Timer(async _ =>
            await InvokeAsync(async () => { await FetchPositions(); StateHasChanged(); }),
            null, 3000, 3000);
    }

    async Task SetTab(int t)
    {
        _tab = t;
        if (t == 1 && !_openOrders.Any()) await FetchOrders();
        if (t == 2 && !_histOrders.Any()) await FetchHistory();
        if (t == 3 && !_pnlRows.Any())   await FetchPnl();
    }

    async Task RefreshAll()
    {
        _loading = true;
        _error = string.Empty;
        StateHasChanged();
        await FetchPositions();
        if (_tab == 1) await FetchOrders();
        if (_tab == 2) await FetchHistory();
        _lastRefresh = DateTime.UtcNow;
        _loading = false;
    }

    async Task FetchPositions()
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _error = "No Binance API credentials configured."; return; }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account.GetPositionInformationAsync(ct: cts.Token);

            if (!res.Success) { _error = $"Binance error: {res.Error?.Code} — {res.Error?.Message}"; return; }

            _error = string.Empty;
            _positions = res.Data
                .Where(p => p.Quantity != 0)
                .Select(p => {
                    var side   = p.Quantity > 0 ? "LONG" : "SHORT";
                    var size   = Math.Abs(p.Quantity * p.EntryPrice);
                    var margin = p.MarginType == FuturesMarginType.Isolated
                        ? p.IsolatedMargin : size / Math.Max(p.Leverage, 1);
                    var roi    = margin > 0 ? p.UnrealizedPnl / margin : 0m;
                    return new PosRow(p.Symbol, side, p.Leverage, size,
                        p.EntryPrice, p.MarkPrice, p.LiquidationPrice,
                        margin, 0m, p.UnrealizedPnl, roi);
                })
                .OrderByDescending(p => Math.Abs(p.Pnl)).ToList();

            _totalPnl = _positions.Sum(p => p.Pnl);

            // Also fetch today's realized PnL while we have the client open
            try
            {
                using var ctsPnl = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                var pnlRes = await client.UsdFuturesApi.Account.GetIncomeHistoryAsync(
                    incomeType: "REALIZED_PNL",
                    startTime: DateTime.UtcNow.Date,
                    limit: 1000, ct: ctsPnl.Token);
                if (pnlRes.Success && pnlRes.Data != null)
                    _realizedPnlToday = pnlRes.Data.Sum(x => x.Income);
            }
            catch { /* non-blocking — don't fail positions if this one fails */ }
        }
        catch (OperationCanceledException) { _error = "Request timed out."; }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
    }

    async Task<List<OrdRow>> FetchAlgoOrdersRawAsync()
    {
        var result = new List<OrdRow>();
        try
        {
            var opt = BinanceOpts.CurrentValue;
            if (string.IsNullOrWhiteSpace(opt.ApiKey) || string.IsNullOrWhiteSpace(opt.SecretKey))
                return result;

            var http = HttpClientFactory.CreateClient("AlgoOrdersRaw");
            http.Timeout = TimeSpan.FromSeconds(8);

            var baseUrl = opt.UseTestnet ? "https://testnet.binancefuture.com" : "https://fapi.binance.com";
            var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

            var q = new List<KeyValuePair<string, string>> { new("timestamp", ts.ToString(System.Globalization.CultureInfo.InvariantCulture)) };
            var raw = string.Join("&", q.Select(kv => $"{kv.Key}={kv.Value}"));
            var encoded = string.Join("&", q.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

            using var hmac = new System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(opt.SecretKey));
            var hash = hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
            var sig = string.Concat(hash.Select(b => b.ToString("x2")));

            var url = $"{baseUrl}/fapi/v1/openAlgoOrders?{encoded}&signature={sig}";
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.TryAddWithoutValidation("X-MBX-APIKEY", opt.ApiKey);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            using var resp = await http.SendAsync(req, cts.Token);
            var body = await resp.Content.ReadAsStringAsync(cts.Token);
            if (!resp.IsSuccessStatusCode) return result;

            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return result;

            foreach (var o in doc.RootElement.EnumerateArray())
            {
                decimal GetDec(string name) =>
                    o.TryGetProperty(name, out var v) && decimal.TryParse(v.GetString(), System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;
                string GetStr(string name) => o.TryGetProperty(name, out var v) ? (v.GetString() ?? "") : "";
                long GetLong(string name) =>
                    o.TryGetProperty(name, out var v)
                        ? (v.ValueKind == System.Text.Json.JsonValueKind.Number && v.TryGetInt64(out var l) ? l
                           : long.TryParse(v.GetString(), out var l2) ? l2 : 0L)
                        : 0L;

                result.Add(new OrdRow(
                    Id: GetLong("algoId"),
                    Symbol: GetStr("symbol"),
                    Type: GetStr("orderType"),
                    Side: GetStr("side").ToUpperInvariant(),
                    PosSide: GetStr("positionSide").ToUpperInvariant(),
                    Price: GetDec("triggerPrice"),
                    StopPrice: GetDec("triggerPrice"),
                    OrigQty: GetDec("quantity"),
                    ExecutedQty: GetDec("executedQty"),
                    ReduceOnly: o.TryGetProperty("reduceOnly", out var ro) && ro.GetBoolean(),
                    Time: DateTime.UtcNow)
                { IsAlgo = true });
            }
        }
        catch { /* algo orders are an addition; never block the regular orders list on this failing */ }
        return result;
    }

    async Task FetchOrders()
    {
        _ordLoading = true; StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Trading.GetOpenOrdersAsync(ct: cts.Token);

            var regular = new List<OrdRow>();
            if (res.Success && res.Data != null)
                regular = res.Data
                    .Select(o => new OrdRow(o.Id, o.Symbol, o.Type.ToString(),
                        o.Side.ToString().ToUpperInvariant(),
                        o.PositionSide.ToString().ToUpperInvariant(),
                        o.Price, o.StopPrice ?? 0m, o.Quantity, o.QuantityFilled,
                        o.ReduceOnly, o.CreateTime))
                    .ToList();
            else if (!res.Success)
                ShowToast($"Orders: {res.Error?.Message}", false);

            // Conditional/algo orders (STOP_MARKET/TAKE_PROFIT_MARKET) live in
            // a separate Binance API service since the Dec 2025 migration —
            // GetOpenOrdersAsync above genuinely cannot see them at all, same
            // root cause already found and fixed for /market's Open Orders.
            var algo = await FetchAlgoOrdersRawAsync();

            _openOrders = regular.Concat(algo)
                .GroupBy(o => o.Id)
                .Select(g => g.First())
                .OrderBy(o => o.Symbol)
                .ToList();
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _ordLoading = false; }
    }

    async Task FetchHistory()
    {
        _histLoading = true; StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            var syms = _positions.Select(p => p.Symbol)
                .Concat(new[]{"BTCUSDT","ETHUSDT"}).Distinct().Take(8).ToList();
            var results = new List<HistRow>();
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            foreach (var sym in syms)
            {
                try
                {
                    var r = await client.UsdFuturesApi.Trading.GetOrdersAsync(sym, limit: 20, ct: cts.Token);
                    if (r.Success && r.Data != null)
                        foreach (var o in r.Data)
                            results.Add(new HistRow(o.Id, o.Symbol, o.Type.ToString(),
                                o.Side.ToString().ToUpperInvariant(),
                                o.Price, o.AveragePrice, o.Quantity, o.QuantityFilled,
                                o.Status.ToString().ToUpperInvariant(), o.UpdateTime));
                } catch { }
            }
            _histOrders = results.OrderByDescending(o => o.Updated).Take(50).ToList();
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _histLoading = false; }
    }

    async Task FetchPnl()
    {
        _pnlLoading = true; StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            var syms = _positions.Select(p => p.Symbol)
                .Concat(new[]{"BTCUSDT","ETHUSDT"}).Distinct().Take(8).ToList();
            var results = new List<PnlRow>();
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(12));
            foreach (var sym in syms)
            {
                try
                {
                    var r = await client.UsdFuturesApi.Trading.GetUserTradesAsync(sym, limit: 30, ct: cts.Token);
                    if (!r.Success || r.Data == null) continue;
                    foreach (var t in r.Data.OrderByDescending(x => x.Timestamp))
                    {
                        var roe = t.Quantity > 0 && t.Price > 0
                            ? t.RealizedPnl / (t.Quantity * t.Price) * 100m : 0m;
                        results.Add(new PnlRow(t.Symbol, t.Buyer ? "BUY" : "SELL",
                            t.Price, t.Price, t.Quantity, t.RealizedPnl, roe, t.Fee, t.Timestamp));
                    }
                } catch { }
            }
            _pnlRows   = results.OrderByDescending(r => r.Time).Take(100).ToList();
            _pnlTotal  = _pnlRows.Sum(r => r.Pnl);
            _pnlWins   = _pnlRows.Count(r => r.Pnl > 0);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _pnlLoading = false; }
    }

    async Task CloseConfirmed()
    {
        if (_confirmPos == null) return;
        _actionLoading = true; StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { ShowToast("No API connection", false); return; }
            var p    = _confirmPos;
            var isL  = p.Side == "LONG";
            var side = isL ? OrderSide.Sell : OrderSide.Buy;
            var pos  = isL ? PositionSide.Long : PositionSide.Short;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            decimal stepSize = 0.001m;
            try
            {
                var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
                if (ei.Success)
                {
                    var sym = ei.Data.Symbols.FirstOrDefault(s => s.Name == p.Symbol);
                    if (sym?.LotSizeFilter?.StepSize > 0) stepSize = sym.LotSizeFilter.StepSize;
                }
            } catch { }
            decimal rawQty = p.SizeUsdt / (p.Mark > 0 ? p.Mark : p.Entry);
            decimal qty = Math.Floor(rawQty / stepSize) * stepSize;
            var res = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: p.Symbol, side: side, type: FuturesOrderType.Market,
                quantity: qty, positionSide: pos, ct: cts.Token);
            if (res.Success)
            {
                ShowToast($"✓ {p.Symbol} {p.Side} closed", true);
                _confirmPos = null;
                await Task.Delay(600);
                await FetchPositions();
            }
            else ShowToast($"Failed: {res.Error?.Code} {res.Error?.Message}", false);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _actionLoading = false; }
    }

    async Task CancelOrder(OrdRow o)
    {
        try
        {
            if (o.IsAlgo)
            {
                var ok = await CancelAlgoOrderRawAsync(o.Id);
                if (ok) { ShowToast("✓ Order cancelled", true); await FetchOrders(); }
                else ShowToast("Cancel failed", false);
                return;
            }

            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            var res = await client.UsdFuturesApi.Trading.CancelOrderAsync(o.Symbol, o.Id, ct: cts.Token);
            if (res.Success) { ShowToast("✓ Order cancelled", true); await FetchOrders(); }
            else ShowToast($"Cancel failed: {res.Error?.Message}", false);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
    }

    async Task<bool> CancelAlgoOrderRawAsync(long algoId)
    {
        try
        {
            var opt = BinanceOpts.CurrentValue;
            if (string.IsNullOrWhiteSpace(opt.ApiKey) || string.IsNullOrWhiteSpace(opt.SecretKey)) return false;

            var http = HttpClientFactory.CreateClient("AlgoOrdersRaw");
            http.Timeout = TimeSpan.FromSeconds(8);
            var baseUrl = opt.UseTestnet ? "https://testnet.binancefuture.com" : "https://fapi.binance.com";
            var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

            var q = new List<KeyValuePair<string, string>>
            {
                new("algoId", algoId.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                new("timestamp", ts.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            };
            var raw = string.Join("&", q.Select(kv => $"{kv.Key}={kv.Value}"));
            var encoded = string.Join("&", q.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

            using var hmac = new System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(opt.SecretKey));
            var hash = hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
            var sig = string.Concat(hash.Select(b => b.ToString("x2")));

            var url = $"{baseUrl}/fapi/v1/algoOrder?{encoded}&signature={sig}";
            using var req = new HttpRequestMessage(HttpMethod.Delete, url);
            req.Headers.TryAddWithoutValidation("X-MBX-APIKEY", opt.ApiKey);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            using var resp = await http.SendAsync(req, cts.Token);
            return resp.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    void ShowToast(string msg, bool ok)
    {
        _toast = msg; _toastOk = ok; InvokeAsync(StateHasChanged);
        Task.Delay(3500).ContinueWith(_ => { _toast = ""; InvokeAsync(StateHasChanged); });
    }

    string FP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 10000) return v.ToString("F2");
        if (v >= 100)   return v.ToString("F3");
        if (v >= 1)     return v.ToString("F4");
        return v.ToString("G5");
    }

    public void Dispose()
    {
        LiveState.PriceTicked -= OnLivePriceTick;
        _timer?.Dispose();
    }
}
