@page "/positions"
@using Binance.Net.Enums
@using VertexAutoTradeBinance8.Services
@inject BinanceClientFactory Factory
@implements IDisposable

<PageTitle>Positions & Orders — Vertex</PageTitle>

<div class="bp">

    <!-- ═══ HEADER ═══════════════════════════════════════════ -->
    <div class="bp-header">
        <div class="bp-header-left">
            <span class="bp-title">Futures</span>
            <span class="bp-sub">USDⓈ-M Perpetual</span>
        </div>
        <div class="bp-header-right">
            <div class="bp-accsumm">
                <div class="bp-as">
                    <div class="bp-as-val @(_totalPnl >= 0 ? "bp-up" : "bp-dn")">
                        @(_totalPnl >= 0 ? "+" : "")@_totalPnl.ToString("F4") USDT
                    </div>
                    <div class="bp-as-lab">Unrealized PnL</div>
                </div>
                <div class="bp-as">
                    <div class="bp-as-val">@_positions.Count</div>
                    <div class="bp-as-lab">Open Positions</div>
                </div>
                <div class="bp-as">
                    <div class="bp-as-val">@_openOrders.Count</div>
                    <div class="bp-as-lab">Open Orders</div>
                </div>
            </div>
            <button class="bp-refresh @(_loading?"bp-spinning":"")" @onclick="RefreshAll" disabled="@_loading">⟳</button>
            <span class="bp-ts">@_lastRefresh.ToLocalTime().ToString("HH:mm:ss")</span>
        </div>
    </div>

    <!-- ═══ ERROR ════════════════════════════════════════════ -->
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="bp-error">⚠ @_error</div>
    }

    <!-- ═══ TABS ══════════════════════════════════════════════ -->
    <div class="bp-tabs">
        <button class="bp-tab @(_tab==0?"bp-tab-on":"")" @onclick="()=>SetTab(0)">
            Positions @if(_positions.Any()){<span class="bp-badge">@_positions.Count</span>}
        </button>
        <button class="bp-tab @(_tab==1?"bp-tab-on":"")" @onclick="()=>SetTab(1)">
            Open Orders @if(_openOrders.Any()){<span class="bp-badge">@_openOrders.Count</span>}
        </button>
        <button class="bp-tab @(_tab==2?"bp-tab-on":"")" @onclick="()=>SetTab(2)">
            Order History
        </button>
    </div>

    <!-- ═══ LOADING ═══════════════════════════════════════════ -->
    @if (_loading && !_positions.Any() && !_openOrders.Any())
    {
        <div class="bp-loading"><div class="bp-spin"></div> Connecting to Binance...</div>
    }

    <!-- ═══ TAB: POSITIONS ════════════════════════════════════ -->
    @if (_tab == 0)
    {
        <div class="bp-panel">
            @if (!_loading && !_positions.Any())
            {
                <div class="bp-empty">
                    <div style="font-size:44px">📭</div>
                    <div>No open positions</div>
                    <div class="bp-dim">Fetched directly from Binance USDⓈ-M Futures</div>
                </div>
            }
            else if (_positions.Any())
            {
                <div class="bp-pnl-strip @(_totalPnl>=0?"strip-up":"strip-dn")">
                    <span class="bp-dim">Total Unrealized P&L</span>
                    <span class="bp-pnl-big @(_totalPnl>=0?"bp-up":"bp-dn")">
                        @(_totalPnl>=0?"+":"")@_totalPnl.ToString("F4") USDT
                    </span>
                </div>

                <!-- TABLE -->
                <div class="bp-tbl-wrap">
                    <div class="bp-pos-grid bp-head">
                        <div>Symbol</div><div>Size</div><div>Entry Price</div>
                        <div>Mark Price</div><div>Liq. Price</div><div>Margin</div>
                        <div>PnL (ROE%)</div><div>Action</div>
                    </div>

                    @foreach (var p in _positions)
                    {
                        bool isL = p.Side == "LONG";
                        bool pUp = p.Pnl >= 0;
                        decimal liqDist = p.LiqPrice > 0 && p.Mark > 0
                            ? Math.Abs(p.Mark - p.LiqPrice) / p.Mark * 100m : 0m;
                        bool danger = liqDist > 0 && liqDist < 5m;
                        bool warn   = liqDist >= 5m && liqDist < 12m;

                        <div class="bp-pos-grid bp-row">
                            <!-- Symbol -->
                            <div>
                                <div class="bp-sym">@p.Symbol.Replace("USDT","")<span class="bp-unit">USDT</span></div>
                                <div style="display:flex;gap:5px;margin-top:3px;align-items:center">
                                    <span class="bp-side @(isL?"side-l":"side-s")">@p.Side</span>
                                    <span class="bp-lev">@p.Leverage×</span>
                                </div>
                            </div>
                            <!-- Size -->
                            <div class="mono">
                                @p.SizeUsdt.ToString("F2")
                                <span class="bp-dim"> USDT</span>
                            </div>
                            <!-- Entry -->
                            <div class="mono">@FP(p.Entry)</div>
                            <!-- Mark -->
                            <div class="mono @(isL?(p.Mark>p.Entry?"bp-up":""):(p.Mark<p.Entry?"bp-up":""))">
                                @FP(p.Mark)
                            </div>
                            <!-- Liq -->
                            <div>
                                <div class="mono @(danger?"bp-dn":warn?"bp-warn":"bp-dim")">@FP(p.LiqPrice)</div>
                                @if (liqDist > 0)
                                {
                                    <div class="@(danger?"bp-dn":warn?"bp-warn":"bp-dim")" style="font-size:11px">
                                        @(danger?"⚠ ":"")@liqDist.ToString("F1")% away
                                    </div>
                                }
                            </div>
                            <!-- Margin -->
                            <div>
                                <div class="mono">@p.Margin.ToString("F2") <span class="bp-dim">USDT</span></div>
                                @if (p.MarginRatio > 0)
                                {
                                    <div class="@(p.MarginRatio>80?"bp-dn":p.MarginRatio>50?"bp-warn":"bp-dim")" style="font-size:11px">
                                        @p.MarginRatio.ToString("F1")%
                                    </div>
                                }
                            </div>
                            <!-- PnL -->
                            <div>
                                <div class="mono @(pUp?"bp-up":"bp-dn")" style="font-weight:700">
                                    @(pUp?"+":"")@p.Pnl.ToString("F4") USDT
                                </div>
                                <div class="@(pUp?"bp-up":"bp-dn")" style="font-size:12px">
                                    @(pUp?"+":"")@((p.Roi*100m).ToString("F2"))%
                                </div>
                            </div>
                            <!-- Action -->
                            <div>
                                <button class="btn-close" @onclick="()=>_confirmPos=p">Close</button>
                            </div>
                        </div>

                        @if (danger || warn)
                        {
                            <div class="bp-liq-warn @(danger?"liq-d":"liq-w")">
                                ⚠ Liquidation @FP(p.LiqPrice) — @liqDist.ToString("F1")% from mark
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }

    <!-- ═══ TAB: OPEN ORDERS ══════════════════════════════════ -->
    @if (_tab == 1)
    {
        <div class="bp-panel">
            @if (_ordLoading) { <div class="bp-loading"><div class="bp-spin"></div> Loading...</div> }
            else if (!_openOrders.Any())
            {
                <div class="bp-empty">
                    <div style="font-size:44px">📋</div>
                    <div>No open orders</div>
                    <div class="bp-dim">TP, SL and pending orders appear here</div>
                </div>
            }
            else
            {
                <div class="bp-tbl-wrap">
                    <div class="bp-ord-grid bp-head">
                        <div>Symbol</div><div>Type</div><div>Side</div>
                        <div>Price</div><div>Qty</div><div>Filled</div>
                        <div>Reduce</div><div>Time</div><div>Action</div>
                    </div>
                    @foreach (var o in _openOrders.OrderBy(x=>x.Symbol))
                    {
                        bool buy = o.Side == "BUY";
                        decimal fpct = o.OrigQty>0 ? o.ExecutedQty/o.OrigQty*100m : 0m;
                        <div class="bp-ord-grid bp-row">
                            <div>
                                <div class="bp-sym">@o.Symbol.Replace("USDT","")<span class="bp-unit">USDT</span></div>
                            </div>
                            <div><span class="bp-badge-type">@o.Type</span></div>
                            <div>
                                <span class="bp-side @(buy?"side-l":"side-s")">@o.Side</span>
                                @if (o.PosSide != "BOTH") { <div class="bp-dim" style="font-size:10px">@o.PosSide</div> }
                            </div>
                            <div class="mono">
                                @if (o.Price > 0) { <div>@FP(o.Price)</div> }
                                @if (o.StopPrice > 0) { <div class="bp-dim" style="font-size:11px">Stop @FP(o.StopPrice)</div> }
                            </div>
                            <div class="mono">@o.OrigQty.ToString("G6")</div>
                            <div>
                                <div class="mono @(fpct>0?"bp-up":"bp-dim")">@o.ExecutedQty.ToString("G6")</div>
                                @if (fpct > 0) {
                                    <div class="fill-track"><div class="fill-bar" style="width:@fpct%"></div></div>
                                }
                            </div>
                            <div class="@(o.ReduceOnly?"bp-up":"bp-dim")">@(o.ReduceOnly?"✓":"—")</div>
                            <div class="mono bp-dim" style="font-size:11px">@o.Time.ToLocalTime().ToString("MM/dd HH:mm:ss")</div>
                            <div><button class="btn-cancel" @onclick="()=>CancelOrder(o)">Cancel</button></div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ═══ TAB: HISTORY ══════════════════════════════════════ -->
    @if (_tab == 2)
    {
        <div class="bp-panel">
            @if (_histLoading) { <div class="bp-loading"><div class="bp-spin"></div> Loading...</div> }
            else if (!_histOrders.Any())
            {
                <div class="bp-empty">
                    <div style="font-size:44px">📜</div>
                    <div>No order history</div>
                </div>
            }
            else
            {
                <div class="bp-tbl-wrap">
                    <div class="bp-hist-grid bp-head">
                        <div>Symbol</div><div>Type</div><div>Side</div>
                        <div>Price</div><div>Qty / Filled</div><div>Status</div><div>Time</div>
                    </div>
                    @foreach (var o in _histOrders)
                    {
                        bool buy = o.Side == "BUY";
                        string sc = o.Status switch {
                            "FILLED" => "st-ok", "CANCELED" or "EXPIRED" => "st-can",
                            "PARTIALLY_FILLED" => "st-part", _ => "bp-dim"
                        };
                        <div class="bp-hist-grid bp-row">
                            <div class="bp-sym">@o.Symbol.Replace("USDT","")<span class="bp-unit">USDT</span></div>
                            <div><span class="bp-badge-type">@o.Type</span></div>
                            <div><span class="bp-side @(buy?"side-l":"side-s")">@o.Side</span></div>
                            <div class="mono">@(o.AvgPrice>0?FP(o.AvgPrice):o.Price>0?FP(o.Price):"Market")</div>
                            <div class="mono">@o.ExecutedQty.ToString("G6") / @o.OrigQty.ToString("G6")</div>
                            <div><span class="bp-status @sc">@o.Status</span></div>
                            <div class="mono bp-dim" style="font-size:11px">@o.Updated.ToLocalTime().ToString("MM/dd HH:mm")</div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ═══ CLOSE CONFIRM ═════════════════════════════════════ -->
    @if (_confirmPos != null)
    {
        <div class="bp-overlay" @onclick="()=>_confirmPos=null">
            <div class="bp-dialog" @onclick:stopPropagation>
                <div class="bp-dlg-title">Close Position</div>
                <div class="bp-dlg-body">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
                        <span class="bp-sym" style="font-size:20px">@_confirmPos.Symbol</span>
                        <span class="bp-side @(_confirmPos.Side=="LONG"?"side-l":"side-s")">@_confirmPos.Side</span>
                    </div>
                    <div class="bp-dlg-row"><span class="bp-dim">Size</span><b>@_confirmPos.SizeUsdt.ToString("F2") USDT</b></div>
                    <div class="bp-dlg-row"><span class="bp-dim">PnL</span>
                        <b class="@(_confirmPos.Pnl>=0?"bp-up":"bp-dn")">
                            @(_confirmPos.Pnl>=0?"+":"")@_confirmPos.Pnl.ToString("F4") USDT
                        </b>
                    </div>
                    <div class="bp-dlg-warn">⚠ Market order will be placed to close immediately</div>
                </div>
                <div class="bp-dlg-actions">
                    <button class="btn-cancel-lg" @onclick="()=>_confirmPos=null">Cancel</button>
                    <button class="btn-close-lg" @onclick="CloseConfirmed" disabled="@_actionLoading">
                        @(_actionLoading?"Closing...":"Close Position")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="bp-toast @(_toastOk?"t-ok":"t-err")">@_toast</div>
    }
</div>

<style>
:root{--bg:#0d1117;--bg2:#161b22;--bg3:#21262d;--bdr:#30363d;
     --grn:#3fb950;--red:#f85149;--yel:#e3b341;--acc:#1f6feb;
     --txt:#e6edf3;--dim:#8b949e;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt);}
.bp{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);min-height:100vh;}
.bp-up{color:var(--grn)!important;}.bp-dn{color:var(--red)!important;}.bp-warn{color:var(--yel)!important;}.bp-dim{color:var(--dim)!important;}
.mono{font-family:var(--mono)!important;}

/* HEADER */
.bp-header{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.bp-title{font-size:18px;font-weight:700;margin-right:8px;}
.bp-sub{font-size:12px;color:var(--dim);}
.bp-header-right{display:flex;align-items:center;gap:20px;}
.bp-accsumm{display:flex;gap:24px;}
.bp-as{text-align:right;}
.bp-as-val{font-family:var(--mono);font-size:16px;font-weight:700;}
.bp-as-lab{font-size:10px;color:var(--dim);margin-top:2px;}
.bp-refresh{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);width:32px;height:32px;border-radius:6px;cursor:pointer;font-size:16px;transition:all .15s;display:flex;align-items:center;justify-content:center;}
.bp-refresh:hover{border-color:var(--acc);color:var(--acc);}
.bp-spinning{animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}
.bp-ts{font-family:var(--mono);font-size:12px;color:var(--dim);}

/* ERROR */
.bp-error{padding:12px 24px;background:rgba(248,81,73,.1);border-bottom:1px solid rgba(248,81,73,.3);color:var(--red);font-size:13px;}

/* TABS */
.bp-tabs{display:flex;background:var(--bg2);border-bottom:2px solid var(--bdr);padding:0 24px;}
.bp-tab{background:none;border:none;color:var(--dim);font-size:14px;font-weight:500;padding:12px 20px;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;display:flex;align-items:center;gap:6px;transition:all .15s;}
.bp-tab:hover{color:var(--txt);}
.bp-tab-on{color:var(--acc);border-bottom-color:var(--acc);}
.bp-badge{background:var(--acc);color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;}
.bp-panel{background:var(--bg);}

/* PNL STRIP */
.bp-pnl-strip{display:flex;align-items:center;gap:12px;padding:10px 24px;border-bottom:1px solid var(--bdr);}
.strip-up{background:rgba(63,185,80,.04);}.strip-dn{background:rgba(248,81,73,.04);}
.bp-pnl-big{font-family:var(--mono);font-size:16px;font-weight:700;}

/* TABLE */
.bp-tbl-wrap{overflow-x:auto;}
.bp-pos-grid{display:grid;grid-template-columns:180px 120px 110px 110px 110px 120px 150px 80px;}
.bp-ord-grid{display:grid;grid-template-columns:140px 120px 90px 110px 100px 110px 60px 130px 80px;}
.bp-hist-grid{display:grid;grid-template-columns:140px 120px 90px 110px 140px 140px 130px;}
.bp-head{background:var(--bg2);color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;padding:9px 24px;border-bottom:1px solid var(--bdr);}
.bp-head>div{padding:0 8px;}
.bp-row{padding:12px 24px;border-bottom:1px solid rgba(48,54,61,.4);font-size:13px;align-items:center;transition:background .1s;}
.bp-row>div{padding:0 8px;}
.bp-row:hover{background:rgba(255,255,255,.02);}

/* SYMBOL */
.bp-sym{font-family:var(--mono);font-size:15px;font-weight:700;}
.bp-unit{font-size:11px;color:var(--dim);margin-left:2px;}

/* SIDE BADGE */
.bp-side{font-size:11px;font-weight:700;padding:2px 7px;border-radius:3px;display:inline-block;}
.side-l{background:rgba(63,185,80,.15);color:var(--grn);}
.side-s{background:rgba(248,81,73,.15);color:var(--red);}
.bp-lev{font-size:11px;background:rgba(31,111,235,.12);color:var(--acc);padding:1px 5px;border-radius:3px;}

/* LIQ WARNING */
.bp-liq-warn{padding:6px 24px;font-size:12px;font-weight:600;border-left:3px solid;}
.liq-d{background:rgba(248,81,73,.1);color:var(--red);border-color:var(--red);}
.liq-w{background:rgba(227,179,65,.07);color:var(--yel);border-color:var(--yel);}

/* FILL BAR */
.fill-track{height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;margin-top:4px;}
.fill-bar{height:100%;background:var(--grn);border-radius:2px;}

/* BADGES */
.bp-badge-type{font-size:10px;background:var(--bg3);border:1px solid var(--bdr);padding:2px 6px;border-radius:3px;color:var(--dim);}
.bp-status{font-size:11px;padding:2px 8px;border-radius:3px;font-weight:600;}
.st-ok{background:rgba(63,185,80,.12);color:var(--grn);}
.st-can{background:var(--bg3);color:var(--dim);}
.st-part{background:rgba(31,111,235,.12);color:var(--acc);}

/* BUTTONS */
.btn-close{background:transparent;border:1px solid var(--red);color:var(--red);padding:4px 12px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn-close:hover{background:var(--red);color:#fff;}
.btn-cancel{background:transparent;border:1px solid var(--bdr);color:var(--dim);padding:4px 10px;border-radius:4px;font-size:12px;cursor:pointer;transition:all .15s;}
.btn-cancel:hover{border-color:var(--red);color:var(--red);}

/* EMPTY / LOADING */
.bp-empty{display:flex;flex-direction:column;align-items:center;gap:10px;padding:70px;color:var(--dim);text-align:center;}
.bp-loading{display:flex;align-items:center;gap:10px;padding:40px 24px;color:var(--dim);}
.bp-spin{width:18px;height:18px;border:2px solid var(--bdr);border-top-color:var(--acc);border-radius:50%;animation:spin .8s linear infinite;}

/* DIALOG */
.bp-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:9999;}
.bp-dialog{background:var(--bg2);border:1px solid var(--bdr);border-radius:12px;width:380px;box-shadow:0 20px 60px rgba(0,0,0,.6);}
.bp-dlg-title{padding:18px 20px;font-size:16px;font-weight:700;border-bottom:1px solid var(--bdr);}
.bp-dlg-body{padding:18px 20px;}
.bp-dlg-row{display:flex;justify-content:space-between;margin-bottom:10px;font-size:14px;color:var(--dim);}
.bp-dlg-row b{color:var(--txt);}
.bp-dlg-warn{font-size:12px;color:var(--yel);background:rgba(227,179,65,.08);border:1px solid rgba(227,179,65,.2);border-radius:6px;padding:10px 12px;margin-top:12px;}
.bp-dlg-actions{display:flex;gap:10px;padding:14px 20px;border-top:1px solid var(--bdr);}
.btn-cancel-lg{flex:1;background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:10px;border-radius:6px;font-size:14px;cursor:pointer;}
.btn-close-lg{flex:1;background:var(--red);border:none;color:#fff;padding:10px;border-radius:6px;font-size:14px;font-weight:700;cursor:pointer;}
.btn-close-lg:disabled{opacity:.5;cursor:not-allowed;}

/* TOAST */
.bp-toast{position:fixed;bottom:24px;right:24px;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:600;z-index:10000;animation:slideUp .3s ease;}
.t-ok{background:rgba(63,185,80,.15);border:1px solid var(--grn);color:var(--grn);}
.t-err{background:rgba(248,81,73,.15);border:1px solid var(--red);color:var(--red);}
@@keyframes slideUp{from{transform:translateY(16px);opacity:0;}to{transform:translateY(0);opacity:1;}}
</style>

@code {
    // ── Models ────────────────────────────────────────────────
    record PosRow(string Symbol, string Side, int Leverage,
        decimal SizeUsdt, decimal Entry, decimal Mark, decimal LiqPrice,
        decimal Margin, decimal MarginRatio, decimal Pnl, decimal Roi);

    record OrdRow(long Id, string Symbol, string Type, string Side, string PosSide,
        decimal Price, decimal StopPrice, decimal OrigQty, decimal ExecutedQty,
        bool ReduceOnly, DateTime Time);

    record HistRow(long Id, string Symbol, string Type, string Side,
        decimal Price, decimal AvgPrice, decimal OrigQty, decimal ExecutedQty,
        string Status, DateTime Updated);

    // ── State ─────────────────────────────────────────────────
    int _tab;
    bool _loading, _ordLoading, _histLoading, _actionLoading;
    DateTime _lastRefresh;
    string _error = string.Empty;
    string _toast = string.Empty;
    bool _toastOk;
    PosRow? _confirmPos;
    System.Threading.Timer? _timer;

    List<PosRow>  _positions  = new();
    List<OrdRow>  _openOrders = new();
    List<HistRow> _histOrders = new();

    decimal _totalPnl;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
        _timer = new System.Threading.Timer(async _ =>
            await InvokeAsync(async () => { await FetchPositions(); StateHasChanged(); }),
            null, 3000, 3000);
    }

    async Task SetTab(int t)
    {
        _tab = t;
        if (t == 1 && !_openOrders.Any()) await FetchOrders();
        if (t == 2 && !_histOrders.Any()) await FetchHistory();
    }

    async Task RefreshAll()
    {
        _loading = true;
        _error = string.Empty;
        StateHasChanged();
        await FetchPositions();
        if (_tab == 1) await FetchOrders();
        if (_tab == 2) await FetchHistory();
        _lastRefresh = DateTime.UtcNow;
        _loading = false;
    }

    // ── POSITIONS (direct Binance REST) ───────────────────────
    async Task FetchPositions()
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null)
            {
                _error = "No Binance API credentials configured.";
                return;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account
                .GetPositionInformationAsync(ct: cts.Token);

            if (!res.Success)
            {
                _error = $"Binance error: {res.Error?.Code} — {res.Error?.Message}";
                return;
            }

            _error = string.Empty;
            _positions = res.Data
                .Where(p => p.Quantity != 0)
                .Select(p =>
                {
                    var side   = p.Quantity > 0 ? "LONG" : "SHORT";
                    var size   = Math.Abs(p.Quantity * p.EntryPrice);
                    var margin = p.MarginType == FuturesMarginType.Isolated
                        ? p.IsolatedMargin
                        : size / Math.Max(p.Leverage, 1);
                    var roi    = margin > 0 ? p.UnrealizedPnl / margin : 0m;
                    return new PosRow(p.Symbol, side, p.Leverage,
                        size, p.EntryPrice, p.MarkPrice, p.LiquidationPrice,
                        margin, 0m, p.UnrealizedPnl, roi);
                })
                .OrderByDescending(p => Math.Abs(p.Pnl))
                .ToList();

            _totalPnl = _positions.Sum(p => p.Pnl);
        }
        catch (OperationCanceledException)
        {
            _error = "Request timed out — Binance API slow to respond.";
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
    }

    // ── OPEN ORDERS ───────────────────────────────────────────
    async Task FetchOrders()
    {
        _ordLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Trading
                .GetOpenOrdersAsync(ct: cts.Token);  // все символы сразу

            if (res.Success && res.Data != null)
            {
                _openOrders = res.Data
                    .Select(o => new OrdRow(
                        o.Id, o.Symbol,
                        o.Type.ToString(),
                        o.Side.ToString().ToUpperInvariant(),
                        o.PositionSide.ToString().ToUpperInvariant(),
                        o.Price, o.StopPrice ?? 0m,
                        o.Quantity, o.QuantityFilled,
                        o.ReduceOnly, o.CreateTime))
                    .OrderBy(o => o.Symbol)
                    .ToList();
            }
            else
            {
                ShowToast($"Orders: {res.Error?.Message}", false);
            }
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _ordLoading = false; }
    }

    // ── ORDER HISTORY ─────────────────────────────────────────
    async Task FetchHistory()
    {
        _histLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            var results = new List<HistRow>();
            // Берём символы из открытых позиций + BTC/ETH для контекста
            var syms = _positions.Select(p => p.Symbol)
                .Concat(new[]{"BTCUSDT","ETHUSDT"})
                .Distinct().Take(8).ToList();

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            foreach (var sym in syms)
            {
                try
                {
                    var r = await client.UsdFuturesApi.Trading
                        .GetOrdersAsync(sym, limit: 20, ct: cts.Token);
                    if (r.Success && r.Data != null)
                        foreach (var o in r.Data)
                            results.Add(new HistRow(o.Id, o.Symbol,
                                o.Type.ToString(),
                                o.Side.ToString().ToUpperInvariant(),
                                o.Price, o.AveragePrice,
                                o.Quantity, o.QuantityFilled,
                                o.Status.ToString().ToUpperInvariant(),
                                o.UpdateTime));
                }
                catch { }
            }

            _histOrders = results
                .OrderByDescending(o => o.Updated)
                .Take(50).ToList();
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _histLoading = false; }
    }

    // ── ACTIONS ───────────────────────────────────────────────
    async Task CloseConfirmed()
    {
        if (_confirmPos == null) return;
        _actionLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { ShowToast("No API connection", false); return; }

            var p    = _confirmPos;
            var isL  = p.Side == "LONG";
            var side = isL ? OrderSide.Sell : OrderSide.Buy;
            var pos  = isL ? PositionSide.Long : PositionSide.Short;
            // qty = size_usdt / mark_price, rounded to 3dp
            var qty  = Math.Round(p.SizeUsdt / (p.Mark > 0 ? p.Mark : p.Entry), 3);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));
            var res = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: p.Symbol, side: side,
                type: FuturesOrderType.Market,
                quantity: qty, positionSide: pos,
                reduceOnly: true, ct: cts.Token);

            if (res.Success)
            {
                ShowToast($"✓ {p.Symbol} {p.Side} closed", true);
                _confirmPos = null;
                await Task.Delay(600);
                await FetchPositions();
            }
            else ShowToast($"Failed: {res.Error?.Code} {res.Error?.Message}", false);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
        finally { _actionLoading = false; }
    }

    async Task CancelOrder(OrdRow o)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            var res = await client.UsdFuturesApi.Trading
                .CancelOrderAsync(o.Symbol, o.Id, ct: cts.Token);
            if (res.Success) { ShowToast($"✓ Order cancelled", true); await FetchOrders(); }
            else ShowToast($"Cancel failed: {res.Error?.Message}", false);
        }
        catch (Exception ex) { ShowToast(ex.Message, false); }
    }

    // ── HELPERS ───────────────────────────────────────────────
    void ShowToast(string msg, bool ok)
    {
        _toast = msg; _toastOk = ok; InvokeAsync(StateHasChanged);
        Task.Delay(3500).ContinueWith(_ => { _toast = ""; InvokeAsync(StateHasChanged); });
    }

    string FP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 10000) return v.ToString("F2");
        if (v >= 100)   return v.ToString("F3");
        if (v >= 1)     return v.ToString("F4");
        return v.ToString("G5");
    }

    public void Dispose() => _timer?.Dispose();
}
