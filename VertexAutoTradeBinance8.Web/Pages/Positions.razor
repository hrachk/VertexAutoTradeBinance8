/* ── MODAL ──────────────────────────────────────────────── */
.p-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;animation:fadeIn .2s ease;}
@@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
