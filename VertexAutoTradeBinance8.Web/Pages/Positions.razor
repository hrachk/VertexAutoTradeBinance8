.p-modal-row:last-child{border-bottom:none;}
.p-modal-row:nth-child(odd){background:rgba(255,255,255,.015);}
.p-modal-warn{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:rgba(255,209,102,.06);border:1px solid rgba(255,209,102,.15);border-radius:8px;font-size:12px;color:var(--yel);line-height:1.5;}
.p-modal-foot{display:flex;gap:10px;padding:16px 22px;border-top:1px solid var(--bdr);}
.p-modal-cancel{flex:1;background:var(--bg4);border:1px solid var(--bdr2);color:var(--txt);padding:11px;border-radius:8px;font-size:14px;cursor:pointer;font-weight:500;transition:all .15s;}
.p-modal-cancel:hover{border-color:var(--bdr);}
.p-modal-confirm{flex:1;background:linear-gradient(135deg,#ff3355,#ff6680);border:none;color:#fff;padding:11px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.p-modal-confirm:hover{box-shadow:0 4px 20px rgba(255,51,85,.4);transform:translateY(-1px);}
.p-modal-confirm:disabled{opacity:.5;cursor:not-allowed;transform:none;}
.p-spin-sm{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}

/* ── TOAST ──────────────────────────────────────────────── */
.p-toast{position:fixed;bottom:28px;right:28px;padding:13px 22px;border-radius:10px;font-size:14px;font-weight:600;z-index:10000;animation:toastIn .3s ease;display:flex;align-items:center;gap:8px;box-shadow:0 8px 32px rgba(0,0,0,.4);}
.t-ok{background:rgba(0,214,143,.15);border:1px solid rgba(0,214,143,.3);color:var(--grn);}
.t-err{background:rgba(255,77,106,.15);border:1px solid rgba(255,77,106,.3);color:var(--red);}
@@keyframes toastIn{from{transform:translateY(12px);opacity:0;}to{transform:translateY(0);opacity:1;}}

@@media(max-width:1100px){.p-card-grid{grid-template-columns:repeat(3,1fr);}
.p-hero-stats{display:none;}}
