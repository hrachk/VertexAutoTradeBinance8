/* ── PNL SUMMARY ────────────────────────────────────────── */
.p-pnl-summ{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.p-pnl-sc{background:var(--bg2);padding:20px 24px;}
