@page "/positions"
@using Binance.Net.Enums
@using VertexAutoTradeBinance8.Services
@inject BinanceClientFactory Factory
@inject VertexAutoTradeBinance8.Web.Services.MarketDataLiveState LiveState
@inject VertexAutoTradeBinance8.Web.Services.MarketSnapshotFileService SnapSvc
@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.Extensions.Options.IOptionsMonitor<VertexAutoTradeBinance8.Configuration.BinanceOptions> BinanceOpts
@implements IDisposable

<PageTitle>Positions — Vertex</PageTitle>

<div class="p-root">
    @{
        // ONE snapshot per render cycle — all template code reads only
        // these local variables, never the mutable backing fields directly.
        // This eliminates "Collection was modified" crashes caused by the
        // background timer replacing list references mid-render.
        var snapPositions  = _positions;
        var snapOrders     = _openOrders;
        var snapHistOrders = _histOrders;
        var snapPnlRows    = _pnlRows;
        var snapPosCount   = snapPositions.Count;
        var snapOrderCount = snapOrders.Count;
        // Pre-compute order splits so they're available across all tabs
        var basicOrders  = snapOrders.Where(o => !o.IsAlgo).ToList();
        var algoOrders   = snapOrders.Where(o =>  o.IsAlgo).ToList();
    }

    <!-- ══════════ HERO HEADER ══════════════════════════════════════ -->
    <div class="p-hero">
        <div class="p-hero-left">
            <div class="p-logo-mark"></div>
            <div>
                <div class="p-hero-title">USDⓈ-M Futures</div>
                <div class="p-hero-sub">Perpetual · Cross Margin</div>
            </div>
        </div>
        <div class="p-hero-stats">
            <div class="p-hstat @(_totalPnl >= 0 ? "h-pos" : "h-neg")">
                <div class="p-hstat-val">
                    @(_totalPnl >= 0 ? "+" : "")@_totalPnl.ToString("F4")
                    <span class="p-hstat-cur">USDT</span>
                </div>
                <div class="p-hstat-lab">Unrealized PnL</div>
            </div>
            <div class="p-hdiv"></div>
            <div class="p-hstat @(_realizedPnlToday >= 0 ? "h-pos" : "h-neg")">
                <div class="p-hstat-val">
                    @(_realizedPnlToday >= 0 ? "+" : "")@_realizedPnlToday.ToString("F2")
                    <span class="p-hstat-cur">USDT</span>
                </div>
                <div class="p-hstat-lab">
                    Realized Today
                    <a href="/statistics" class="p-stat-link" title="Open Statistics">↗</a>
                </div>
            </div>
            <div class="p-hdiv"></div>
            <div class="p-hstat">
                <div class="p-hstat-val @(snapPosCount > 0 ? "h-active" : "")">
                    @snapPosCount
                </div>
                <div class="p-hstat-lab">Open Positions</div>
            </div>
            <div class="p-hdiv"></div>
            <div class="p-hstat">
                <div class="p-hstat-val @(snapOrderCount > 0 ? "h-active" : "")">@snapOrderCount</div>
                <div class="p-hstat-lab">Open Orders</div>
            </div>
        </div>
        <div class="p-hero-actions">
            <div class="p-ts">@_lastRefresh.ToLocalTime().ToString("HH:mm:ss")</div>
            <button class="p-btn-refresh @(_loading ? "p-spin" : "")" @onclick="RefreshAll" disabled="@_loading" title="Refresh">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                    <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- error -->
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-alert">
            <span class="p-alert-icon">⚠</span> @_error
        </div>
    }

    <!-- ══════════ TABS ══════════════════════════════════════════════ -->
    <div class="p-tabs">
        <button class="p-tab @(_tab==0?"p-tab-on":"")" @onclick="()=>SetTab(0)">
            <span class="p-tab-label">Positions</span>
            @if (snapPosCount > 0) { <span class="p-tab-chip">@snapPosCount</span> }
        </button>
        <button class="p-tab @(_tab==1?"p-tab-on":"")" @onclick="()=>SetTab(1)">
            <span class="p-tab-label">Open Orders</span>
            @if (snapOrderCount > 0) { <span class="p-tab-chip">@snapOrderCount</span> }
        </button>
        <button class="p-tab @(_tab==2?"p-tab-on":"")" @onclick="()=>SetTab(2)">
            <span class="p-tab-label">Order History</span>
        </button>
        <button class="p-tab @(_tab==3?"p-tab-on":"")" @onclick="()=>SetTab(3)">
            <span class="p-tab-label">P&amp;L History</span>
        </button>
        <div class="p-tabs-line"></div>
    </div>

    <!-- ══════════ TAB 0: POSITIONS ═════════════════════════════════ -->
    @if (_tab == 0)
    {
        @if (_loading && snapPosCount == 0)
        {
            <div class="p-loader"><div class="p-spin-ring"></div><span>Loading positions…</span></div>
        }
        else if (!snapPositions.Any())
        {
            <div class="p-empty">
                <div class="p-empty-icon">
                    <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" stroke="#1e2535" stroke-width="2"/><path d="M20 32h24M32 20v24" stroke="#30363d" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="p-empty-title">No open positions</div>
                <div class="p-empty-sub">Your USDⓈ-M positions will appear here in real time</div>
            </div>
        }
        else
        {
            <!-- Total PnL banner -->
            <div class="p-pnl-banner @(_totalPnl >= 0 ? "ban-pos" : "ban-neg")">
                <div class="p-pnl-banner-left">
                    <span class="p-pnl-label">Total Unrealized P&L</span>
                    <span class="p-pnl-value @(_totalPnl >= 0 ? "v-pos" : "v-neg")">
                        @(_totalPnl >= 0 ? "+" : "")@_totalPnl.ToString("F4") USDT
                    </span>
                </div>
                <div class="p-pnl-banner-right">
                    <span class="p-pnl-count">@snapPosCount position@(snapPosCount != 1 ? "s" : "")</span>
                </div>
            </div>

            <!-- Position cards -->
            <div class="p-cards">
                @foreach (var p in snapPositions)
                {
                    bool isL = p.Side == "LONG";
                    bool pUp = p.Pnl >= 0;
                    decimal roe = p.Roi * 100m;
                    decimal liqDist = p.LiqPrice > 0 && p.Mark > 0
                        ? Math.Abs(p.Mark - p.LiqPrice) / p.Mark * 100m : 0m;
                    bool danger = liqDist > 0 && liqDist < 5m;
                    bool warn   = liqDist >= 5m && liqDist < 12m;
                    decimal move = p.Entry > 0 ? (p.Mark - p.Entry) / p.Entry * 100m * (isL ? 1 : -1) : 0m;

                    @{ var cardCls = "p-card " + (isL ? "card-long" : "card-short") + (danger ? " card-danger" : ""); }
                    <div class="@cardCls"
                         @onclick="() => OpenMiniStats(p)">

                        <!-- Card Header -->
                        <div class="p-card-head">
                            <div class="p-card-sym-wrap">
                                <div class="p-card-icon @(isL ? "icon-l" : "icon-s")">
                                    @p.Symbol[0]
                                </div>
                                <div>
                                    <a href="/market?sym=@p.Symbol" class="p-card-sym-link">
                                        <div class="p-card-sym">
                                            @p.Symbol.Replace("USDT", "")
                                            <span class="p-card-usdt">USDT</span>
                                        </div>
                                    </a>
                                    <div class="p-card-meta">
                                        <span class="p-side-badge @(isL ? "sb-l" : "sb-s")">
                                            @(isL ? "▲ LONG" : "▼ SHORT")
                                        </span>
                                        <span class="p-lev">@p.Leverage×</span>
                                        <span class="p-perp">Perpetual</span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-card-pnl-wrap">
                                <div class="p-card-pnl @(pUp ? "pnl-pos" : "pnl-neg")">
                                    @(pUp ? "+" : "")@p.Pnl.ToString("F4")
                                    <span style="font-size:12px;opacity:.7"> USDT</span>
                                </div>
                                <div class="p-card-roe @(pUp ? "pnl-pos" : "pnl-neg")">
                                    @(pUp ? "+" : "")@roe.ToString("F2")% ROE
                                </div>
                            </div>
                        </div>

                        <!-- Live sparkline -->
                        @if (HasSparkline(p.Symbol))
                        {
                            <div class="p-spark-wrap">
                                <svg class="p-spark-svg" viewBox="0 0 200 36" preserveAspectRatio="none">
                                    <path d="@BuildSparkFill(p.Symbol)" fill="@SparkFill(p.Symbol)"/>
                                    <polyline points="@BuildSparkPoints(p.Symbol)" fill="none"
                                              stroke="@SparkColor(p.Symbol)" stroke-width="1.5" stroke-linejoin="round"/>
                                    <circle cx="@SparkLastX(p.Symbol)" cy="@SparkLastY(p.Symbol)"
                                            r="2.5" fill="@SparkColor(p.Symbol)"/>
                                </svg>
                            </div>
                        }

                        <!-- Progress bar - price move -->
                        <div class="p-move-bar-wrap">
                            <div class="p-move-bar @(move >= 0 ? "mb-pos" : "mb-neg")"
                                 style="width:@(Math.Min(Math.Abs(move)*5,100))%"></div>
                        </div>

                        <!-- Key metrics grid -->
                        <div class="p-card-grid">
                            <div class="p-cg">
                                <div class="p-cg-lab">Entry Price</div>
                                <div class="p-cg-val mono">@FP(p.Entry)</div>
                            </div>
                            <div class="p-cg">
                                <div class="p-cg-lab">Mark Price
                                    @if (GetLivePrice(p.Symbol) > 0) { <span class="p-live-dot">●</span> }
                                </div>
                                <div class="p-cg-val mono @(isL?(p.Mark>p.Entry?"v-pos":""):(p.Mark<p.Entry?"v-pos":""))">
                                    @(GetLivePrice(p.Symbol) > 0 ? FP(GetLivePrice(p.Symbol)) : FP(p.Mark))
                                </div>
                            </div>
                            <div class="p-cg">
                                <div class="p-cg-lab">Size</div>
                                <div class="p-cg-val mono">@p.SizeUsdt.ToString("F2")<span class="p-cg-cur"> USDT</span></div>
                            </div>
                            <div class="p-cg">
                                <div class="p-cg-lab">Margin</div>
                                <div class="p-cg-val mono">@p.Margin.ToString("F2")<span class="p-cg-cur"> USDT</span></div>
                            </div>
                            <div class="p-cg">
                                <div class="p-cg-lab">Liq. Price</div>
                                <div class="p-cg-val mono @(danger ? "v-danger" : warn ? "v-warn" : "v-dim")">
                                    @FP(p.LiqPrice)
                                    @if (liqDist > 0)
                                    {
                                        <span class="p-liq-dist">(@liqDist.ToString("F1")%)</span>
                                    }
                                </div>
                            </div>
                            <div class="p-cg">
                                <div class="p-cg-lab">Move</div>
                                <div class="p-cg-val mono @(move >= 0 ? "v-pos" : "v-neg")">
                                    @(move >= 0 ? "+" : "")@move.ToString("F2")%
                                </div>
                            </div>
                        </div>

                        <!-- Liq danger bar -->
                        @if (danger || warn)
                        {
                            <div class="p-liq-alert @(danger ? "la-danger" : "la-warn")">
                                <span>@(danger ? "🚨" : "⚠")</span>
                                Liquidation @FP(p.LiqPrice) — @liqDist.ToString("F1")% from mark price
                            </div>
                        }

                        <!-- Card footer -->
                        <div class="p-card-foot">
                            <div class="p-card-foot-info">
                                <span class="v-dim" style="font-size:11px">Position value: @p.SizeUsdt.ToString("F2") USDT</span>
                            </div>
                            <div class="p-card-foot-btns">
                                <button class="p-partial-btn" @onclick:stopPropagation="true"
                                        @onclick="() => OpenPartialClose(p)">½ Partial</button>
                                <button class="p-close-btn" @onclick:stopPropagation="true"
                                        @onclick="() => _confirmPos = p">Close</button>
                            </div>
                        </div>

                    </div>
                }
            </div>
        }
    }

    <!-- ══════════ TAB 1: OPEN ORDERS ══════════════════════════════ -->
    @if (_tab == 1)
    {
        @if (_ordLoading) { <div class="p-loader"><div class="p-spin-ring"></div><span>Loading orders…</span></div> }
        else
        {
            var ordersToShow = _ordSubTab == 0 ? basicOrders : algoOrders;
            <!-- Sub-tabs: Basic / Conditional -->
            <div class="p-subtabs">
                <button class="p-subtab @(_ordSubTab==0?"p-subtab-on":"")" @onclick="()=>_ordSubTab=0">
                    Basic
                    @if (basicOrders.Any()) { <span class="p-tab-chip p-tab-chip-sm">@basicOrders.Count</span> }
                </button>
                <button class="p-subtab @(_ordSubTab==1?"p-subtab-on":"")" @onclick="()=>_ordSubTab=1">
                    Conditional
                    @if (algoOrders.Any()) { <span class="p-tab-chip p-tab-chip-sm">@algoOrders.Count</span> }
                </button>
            </div>

         
            @if (!ordersToShow.Any())
            {
                <div class="p-empty">
                    <div class="p-empty-icon"><svg viewBox="0 0 64 64" fill="none"><rect x="12" y="16" width="40" height="32" rx="4" stroke="#1e2535" stroke-width="2"/><line x1="20" y1="26" x2="44" y2="26" stroke="#30363d" stroke-width="2" stroke-linecap="round"/><line x1="20" y1="32" x2="36" y2="32" stroke="#30363d" stroke-width="2" stroke-linecap="round"/></svg></div>
                    <div class="p-empty-title">No @(_ordSubTab==0?"basic":"conditional") orders</div>
                    <div class="p-empty-sub">@(_ordSubTab==0?"Limit and market orders appear here":"TP/SL and algo orders appear here")</div>
                </div>
            }
            else
            {
                <div class="p-table-wrap">
                    <table class="p-table">
                        <thead>
                            <tr>
                                <th>Symbol</th><th>Type</th><th>Side</th>
                                <th>Price</th><th>Qty</th><th>Filled</th>
                                <th>Reduce</th><th>Time</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in ordersToShow)
                            {
                                bool buy = o.Side == "BUY";
                                decimal fp = o.OrigQty > 0 ? o.ExecutedQty / o.OrigQty * 100m : 0m;
                                <tr>
                                    <td>
                                        <div class="t-sym">@o.Symbol.Replace("USDT","")</div>
                                        <div class="t-sub v-dim">@o.Symbol</div>
                                    </td>
                                    <td>
                                        <span class="t-type">@o.Type</span>
                                        @if (o.IsAlgo) { <span class="t-algo-badge">(R)</span> }
                                    </td>
                                    <td>
                                        <span class="p-side-badge @(buy?"sb-l":"sb-s") sb-sm">@o.Side</span>
                                        @if (o.PosSide != "BOTH") { <div class="t-sub v-dim">@o.PosSide</div> }
                                    </td>
                                    <td class="mono">
                                        @if (o.Price > 0) { <div>@FP(o.Price)</div> }
                                        @if (o.StopPrice > 0 && o.StopPrice != o.Price) { <div class="t-sub v-dim">Stop @FP(o.StopPrice)</div> }
                                    </td>
                                    <td class="mono">@o.OrigQty.ToString("G6")</td>
                                    <td>
                                        <div class="mono @(fp>0?"v-pos":"v-dim")">@o.ExecutedQty.ToString("G6")</div>
                                        @if (fp > 0) { <div class="t-fill-track"><div class="t-fill-bar" style="width:@fp%"></div></div> }
                                    </td>
                                    <td class="@(o.ReduceOnly ? "v-pos" : "v-dim")">@(o.ReduceOnly ? "✓" : "—")</td>
                                    <td class="mono v-dim t-time">@o.Time.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                    <td><button class="t-cancel-btn" @onclick="()=>CancelOrder(o)">Cancel</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }

    <!-- ══════════ TAB 2: ORDER HISTORY ════════════════════════════ -->
    @if (_tab == 2)
    {
        @if (_histLoading) { <div class="p-loader"><div class="p-spin-ring"></div><span>Loading history…</span></div> }
        else if (!snapHistOrders.Any())
        {
            <div class="p-empty">
                <div class="p-empty-icon"><svg viewBox="0 0 64 64" fill="none"><path d="M32 12v8M32 44v8M12 32h8M44 32h8" stroke="#1e2535" stroke-width="2" stroke-linecap="round"/><circle cx="32" cy="32" r="12" stroke="#30363d" stroke-width="2"/></svg></div>
                <div class="p-empty-title">No order history</div>
                <div class="p-empty-sub">Last 50 orders across tracked symbols</div>
            </div>
        }
        else
        {
            <div class="p-table-wrap">
                <table class="p-table">
                    <thead>
                        <tr><th>Symbol</th><th>Type</th><th>Side</th><th>Price</th><th>Qty / Filled</th><th>Status</th><th>Time</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in snapHistOrders)
                        {
                            bool buy = o.Side == "BUY";
                            string sc = o.Status switch { "FILLED"=>"st-ok","CANCELED" or "EXPIRED"=>"st-can","PARTIALLY_FILLED"=>"st-part",_=>"v-dim" };
                            <tr>
                                <td><div class="t-sym">@o.Symbol.Replace("USDT","")</div></td>
                                <td><span class="t-type">@o.Type</span></td>
                                <td><span class="p-side-badge @(buy?"sb-l":"sb-s") sb-sm">@o.Side</span></td>
                                <td class="mono">@(o.AvgPrice>0?FP(o.AvgPrice):o.Price>0?FP(o.Price):"Market")</td>
                                <td class="mono">@o.ExecutedQty.ToString("G6") / @o.OrigQty.ToString("G6")</td>
                                <td><span class="t-status @sc">@o.Status</span></td>
                                <td class="mono v-dim t-time">@o.Updated.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <!-- ══════════ TAB 3: P&L HISTORY ══════════════════════════════ -->
    @if (_tab == 3)
    {
        @if (_pnlLoading) { <div class="p-loader"><div class="p-spin-ring"></div><span>Loading P&L…</span></div> }
        else if (!snapPnlRows.Any())
        {
            <div class="p-empty">
                <div class="p-empty-icon"><svg viewBox="0 0 64 64" fill="none"><path d="M12 48L24 36l8 8 20-24" stroke="#30363d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div class="p-empty-title">No trade history</div>
                <div class="p-empty-sub">Closed trades appear here</div>
            </div>
        }
        else
        {
            <!-- P&L Summary cards -->
            <div class="p-pnl-summ">
                <div class="p-pnl-sc @(_pnlTotal>=0?"ps-pos":"ps-neg")">
                    <div class="p-pnl-sc-val @(_pnlTotal>=0?"v-pos":"v-neg")">
                        @(_pnlTotal>=0?"+":"")@_pnlTotal.ToString("F4") USDT
                    </div>
                    <div class="p-pnl-sc-lab">Realized P&L</div>
                </div>
                <div class="p-pnl-sc">
                    <div class="p-pnl-sc-val v-pos">@_pnlWins</div>
                    <div class="p-pnl-sc-lab">Wins</div>
                </div>
                <div class="p-pnl-sc">
                    <div class="p-pnl-sc-val v-neg">@(snapPnlRows.Count - _pnlWins)</div>
                    <div class="p-pnl-sc-lab">Losses</div>
                </div>
                <div class="p-pnl-sc">
                    <div class="p-pnl-sc-val @(snapPnlRows.Count>0&&_pnlWins*100/snapPnlRows.Count>=50?"v-pos":"v-neg")">
                        @(snapPnlRows.Count > 0 ? (_pnlWins * 100.0 / snapPnlRows.Count).ToString("F0") : "0")%
                    </div>
                    <div class="p-pnl-sc-lab">Win Rate</div>
                </div>
            </div>

            <div class="p-table-wrap">
                <table class="p-table">
                    <thead>
                        <tr><th>Symbol</th><th>Side</th><th>Fill Price</th><th>Qty</th><th>Realized P&L</th><th>ROE%</th><th>Commission</th><th>Time</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in snapPnlRows)
                        {
                            bool win = t.Pnl >= 0;
                            <tr>
                                <td><div class="t-sym">@t.Symbol.Replace("USDT","")</div></td>
                                <td><span class="p-side-badge @(t.Side=="BUY"?"sb-l":"sb-s") sb-sm">@t.Side</span></td>
                                <td class="mono">@FP(t.Entry)</td>
                                <td class="mono">@t.Qty.ToString("G6")</td>
                                <td class="mono @(win?"v-pos":"v-neg")" style="font-weight:700">
                                    @(win?"+":"")@t.Pnl.ToString("F4")
                                </td>
                                <td class="@(win ? "v-pos" : "v-neg")">@(win ? "+" : "")@t.Roe.ToString("F2")%</td>
                                <td class="mono v-dim">@t.Commission.ToString("F5")</td>
                                <td class="mono v-dim t-time">@t.Time.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <!-- ══════════ CLOSE DIALOG ═════════════════════════════════════ -->
    @if (_confirmPos != null)
    {
        <div class="p-overlay" @onclick="()=>_confirmPos=null">
            <div class="p-modal" @onclick:stopPropagation>
                <div class="p-modal-top">
                    <div class="p-modal-title">Close Position</div>
                    <button class="p-modal-x" @onclick="()=>_confirmPos=null">✕</button>
                </div>
                <div class="p-modal-body">
                    <div class="p-modal-sym">
                        <div class="p-card-icon @(_confirmPos.Side=="LONG"?"icon-l":"icon-s") icon-lg">
                            @_confirmPos.Symbol[0]
                        </div>
                        <div>
                            <div class="p-modal-sym-name">@_confirmPos.Symbol</div>
                            <span class="p-side-badge @(_confirmPos.Side=="LONG"?"sb-l":"sb-s")">
                                @(_confirmPos.Side=="LONG"?"▲ LONG":"▼ SHORT")
                            </span>
                            <span class="p-lev" style="margin-left:6px">@_confirmPos.Leverage×</span>
                        </div>
                    </div>
                    <div class="p-modal-rows">
                        <div class="p-modal-row">
                            <span class="v-dim">Position Size</span>
                            <span class="mono">@_confirmPos.SizeUsdt.ToString("F2") USDT</span>
                        </div>
                        <div class="p-modal-row">
                            <span class="v-dim">Entry Price</span>
                            <span class="mono">@FP(_confirmPos.Entry)</span>
                        </div>
                        <div class="p-modal-row">
                            <span class="v-dim">Mark Price</span>
                            <span class="mono">@FP(_confirmPos.Mark)</span>
                        </div>
                        <div class="p-modal-row">
                            <span class="v-dim">Unrealized P&L</span>
                            <span class="mono @(_confirmPos.Pnl>=0?"v-pos":"v-neg")" style="font-weight:700">
                                @(_confirmPos.Pnl>=0?"+":"")@_confirmPos.Pnl.ToString("F4") USDT
                            </span>
                        </div>
                    </div>
                    <div class="p-modal-warn">
                        <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;flex-shrink:0"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        Market order will close the entire position immediately at current price
                    </div>
                </div>
                <div class="p-modal-foot">
                    <button class="p-modal-cancel" @onclick="()=>_confirmPos=null">Cancel</button>
                    <button class="p-modal-confirm" @onclick="CloseConfirmed" disabled="@_actionLoading">
                        @if (_actionLoading) { <span class="p-spin-sm"></span> } else { <span>Close Position</span> }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ══════════ MINI STATS POPUP ════════════════════════════════ -->
    @if (_miniPos != null)
    {
        <div class="p-overlay" @onclick="() => _miniPos = null">
            <div class="p-mini-modal" @onclick:stopPropagation="true">
                <div class="p-modal-top">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div class="p-card-icon @(_miniPos.Side=="LONG"?"icon-l":"icon-s") icon-lg">@_miniPos.Symbol[0]</div>
                        <div>
                            <div class="p-modal-sym-name">@_miniPos.Symbol</div>
                            <div style="display:flex;gap:6px;margin-top:4px;">
                                <span class="p-side-badge @(_miniPos.Side=="LONG"?"sb-l":"sb-s")">
                                    @(_miniPos.Side=="LONG"?"▲ LONG":"▼ SHORT")
                                </span>
                                <span class="p-lev">@_miniPos.Leverage×</span>
                            </div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
                        @foreach (var tf in new[]{("OneMinute","1m"),("FiveMinutes","5m"),("FifteenMinutes","15m"),("OneHour","1h"),("FourHour","4h"),("OneDay","1D")})
                        {
                            <button class="p-tf-btn @(_miniTf==tf.Item1?"p-tf-on":"")"
                                    @onclick="() => _miniTf = tf.Item1">@tf.Item2</button>
                        }
                        <button class="p-modal-x" @onclick="() => _miniPos = null">✕</button>
                    </div>
                </div>

                <div class="p-mini-chart-wrap">
                    <MarketMiniChart Symbol="@_miniPos.Symbol" Timeframe="@_miniTf" MaxBars="80" />
                </div>

                @{
                    var mp = _miniPos; bool mpUp = mp.Pnl >= 0;
                    decimal mpRoe = mp.Roi*100m;
                    decimal mpMove = mp.Entry>0?(mp.Mark-mp.Entry)/mp.Entry*100m*(mp.Side=="LONG"?1:-1):0m;
                    var mpLive = GetLivePrice(mp.Symbol);
                    var mpCls  = mpUp ? "v-pos" : "v-neg";
                    var mpSign = mpUp ? "+" : "";
                    var mpMoveCls  = mpMove >= 0 ? "v-pos" : "v-neg";
                    var mpMoveSign = mpMove >= 0 ? "+" : "";
                }
                <div class="p-mini-stats">
                    <div class="p-ms"><div class="p-ms-lab">Unrealized PnL</div>
                                    <div class="p-ms-val @mpCls">@mpSign@mp.Pnl.ToString("F4")</div></div>
                    <div class="p-ms"><div class="p-ms-lab">ROE</div><div class="p-ms-val @mpCls">@mpSign@mpRoe.ToString("F2")%</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Entry</div><div class="p-ms-val mono">@FP(mp.Entry)</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Mark <span class="p-live-dot">●</span></div><div class="p-ms-val mono">@(mpLive>0?FP(mpLive):FP(mp.Mark))</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Liq Price</div><div class="p-ms-val v-danger mono">@FP(mp.LiqPrice)</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Move</div><div class="p-ms-val @(mpMove>=0?"v-pos":"v-neg")">@(mpMove>=0?"+":"")@mpMove.ToString("F2")%</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Size</div><div class="p-ms-val mono">@mp.SizeUsdt.ToString("F2") USDT</div></div>
                    <div class="p-ms"><div class="p-ms-lab">Margin</div><div class="p-ms-val mono">@mp.Margin.ToString("F2") USDT</div></div>
                </div>

                <div class="p-modal-foot">
                    <a href="/market?sym=@_miniPos.Symbol" class="p-modal-cancel"
                       style="text-align:center;text-decoration:none;display:flex;align-items:center;justify-content:center;">
                        📈 Market
                    </a>
                    <button class="p-modal-cancel"
                            @onclick="() => { _partialPos = _miniPos; _miniPos = null; }">
                        ½ Partial
                    </button>
                    <button class="p-modal-confirm"
                            @onclick="() => { _confirmPos = _miniPos; _miniPos = null; }">
                        Close Position
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ══════════ PARTIAL CLOSE ═════════════════════════════════════ -->
    @if (_partialPos != null)
    {
        <div class="p-overlay" @onclick="() => _partialPos = null">
            <div class="p-modal" @onclick:stopPropagation="true">
                <div class="p-modal-top">
                    <div class="p-modal-title">½ Partial Close — @_partialPos.Symbol</div>
                    <button class="p-modal-x" @onclick="() => _partialPos = null">✕</button>
                </div>
                <div class="p-modal-body">
                    <div style="margin-bottom:16px;">
                        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--dim);margin-bottom:8px;">
                            <span>Close percentage</span>
                            <span class="mono" style="color:var(--txt);font-size:16px;font-weight:700;">@_partialPct%</span>
                        </div>
                        <input type="range" min="5" max="95" step="5"
                               style="width:100%;accent-color:var(--acc);"
                               value="@_partialPct"
                               @oninput="OnPartialPctInput" />
                        <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--dim);margin-top:4px;">
                            <span>5%</span><span>25%</span><span>50%</span><span>75%</span><span>95%</span>
                        </div>
                    </div>
                    @{ decimal closeQty = _partialPos.SizeUsdt * _partialPct / 100m; }
                    <div class="p-modal-rows">
                        <div class="p-modal-row"><span class="v-dim">Closing</span><span class="mono">@_partialPct% — @closeQty.ToString("F2") USDT</span></div>
                        <div class="p-modal-row"><span class="v-dim">Remaining</span><span class="mono">@(100-_partialPct)% — @(_partialPos.SizeUsdt - closeQty).ToString("F2") USDT</span></div>
                    </div>
                    <div class="p-modal-warn">Market order — closes @_partialPct% at current price immediately</div>
                </div>
                <div class="p-modal-foot">
                    <button class="p-modal-cancel" @onclick="() => _partialPos = null">Cancel</button>
                    <button class="p-modal-confirm" @onclick="PartialCloseConfirmed" disabled="@_actionLoading">
                        @if (_actionLoading) { <span class="p-spin-sm"></span> } else { <span>Close @_partialPct%</span> }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="p-toast @(_toastOk?"t-ok":"t-err")">
            @(_toastOk ? "✓" : "✕") @_toast
        </div>
    }

</div>

<style>
/* ── RESET / BASE ──────────────────────────────────────── */
:root{
    --bg:#080b10;--bg2:#0d1117;--bg3:#111720;--bg4:#161d27;
    --bdr:#1a2232;--bdr2:#222d40;
    --grn:#00d68f;--red:#ff4d6a;--acc:#4d9fff;--yel:#ffd166;
    --txt:#dce8f5;--dim:#4a6080;--dim2:#2d3d52;
    --mono:'JetBrains Mono','Fira Code','SF Mono',monospace;
}
html,body{background:var(--bg)!important;color:var(--txt);font-size:13px;font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;}
*{box-sizing:border-box;}
.mono{font-family:var(--mono)!important;}
.v-pos{color:var(--grn)!important;}.v-neg{color:var(--red)!important;}
.v-dim{color:var(--dim)!important;}.v-warn{color:var(--yel)!important;}
.v-danger{color:var(--red)!important;font-weight:700;}

/* ── ROOT ──────────────────────────────────────────────── */
.p-root{min-height:100vh;background:var(--bg);}

/* ── HERO ──────────────────────────────────────────────── */
.p-hero{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(135deg,#0d1420 0%,#080b10 100%);border-bottom:1px solid var(--bdr);}
.p-hero-left{display:flex;align-items:center;gap:14px;}
.p-logo-mark{width:36px;height:36px;background:linear-gradient(135deg,#1a4fff,#0090ff);border-radius:10px;flex-shrink:0;box-shadow:0 0 20px rgba(77,159,255,.3);}
.p-hero-title{font-size:17px;font-weight:700;letter-spacing:.3px;}
.p-hero-sub{font-size:11px;color:var(--dim);margin-top:2px;}
.p-hero-stats{display:flex;align-items:center;gap:0;}
.p-hstat{text-align:center;padding:0 28px;}
.p-hstat-val{font-family:var(--mono);font-size:20px;font-weight:700;}
.p-hstat-cur{font-size:12px;opacity:.6;margin-left:3px;}
.p-hstat-lab{font-size:10px;color:var(--dim);letter-spacing:.8px;margin-top:3px;text-transform:uppercase;}
.p-hdiv{width:1px;height:36px;background:var(--bdr);}
.h-pos .p-hstat-val{color:var(--grn);}
.h-neg .p-hstat-val{color:var(--red);}
.h-active .p-hstat-val{color:var(--acc);}
.p-hero-actions{display:flex;align-items:center;gap:12px;}
.p-ts{font-family:var(--mono);font-size:12px;color:var(--dim);}
.p-btn-refresh{width:36px;height:36px;background:var(--bg3);border:1px solid var(--bdr2);border-radius:8px;color:var(--dim);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;padding:0;}
.p-btn-refresh:hover{border-color:var(--acc);color:var(--acc);background:rgba(77,159,255,.08);}
.p-btn-refresh svg{width:15px;height:15px;}
.p-spin{animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}

/* ── ALERT ─────────────────────────────────────────────── */
.p-alert{display:flex;align-items:center;gap:10px;padding:12px 28px;background:rgba(255,77,106,.08);border-bottom:1px solid rgba(255,77,106,.2);color:var(--red);font-size:13px;}
.p-alert-icon{font-size:16px;}

/* ── TABS ──────────────────────────────────────────────── */
.p-tabs{position:relative;display:flex;align-items:flex-end;padding:0 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.p-tab{background:none;border:none;color:var(--dim);font-size:13px;font-weight:500;padding:14px 20px 13px;cursor:pointer;display:flex;align-items:center;gap:8px;position:relative;transition:color .15s;}
.p-tab:hover{color:var(--txt);}
.p-tab-on{color:var(--acc)!important;}
.p-tab-on::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--acc);border-radius:2px 2px 0 0;}
.p-tab-label{font-size:13px;}
.p-tab-chip{background:var(--acc);color:#fff;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;min-width:20px;text-align:center;}

/* ── LOADER / EMPTY ─────────────────────────────────────── */
.p-loader{display:flex;align-items:center;gap:14px;padding:60px 28px;color:var(--dim);}
.p-spin-ring{width:22px;height:22px;border:2px solid var(--bdr2);border-top-color:var(--acc);border-radius:50%;animation:spin .8s linear infinite;}
.p-empty{display:flex;flex-direction:column;align-items:center;gap:14px;padding:80px 20px;color:var(--dim);text-align:center;}
.p-empty-icon svg{width:64px;height:64px;}
.p-empty-title{font-size:17px;font-weight:600;color:var(--txt);}
.p-empty-sub{font-size:13px;}

/* ── PNL BANNER ─────────────────────────────────────────── */
.p-pnl-banner{display:flex;align-items:center;justify-content:space-between;padding:12px 28px;border-bottom:1px solid var(--bdr);}
.ban-pos{background:linear-gradient(90deg,rgba(0,214,143,.06),transparent);}
.ban-neg{background:linear-gradient(90deg,rgba(255,77,106,.06),transparent);}
.p-pnl-banner-left{display:flex;align-items:center;gap:16px;}
.p-pnl-label{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.p-pnl-value{font-family:var(--mono);font-size:17px;font-weight:700;}
.v-pos{color:var(--grn)!important;}.v-neg{color:var(--red)!important;}
.p-pnl-count{font-size:12px;color:var(--dim);}

/* ── POSITION CARDS ─────────────────────────────────────── */
.p-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(480px,1fr));gap:12px;padding:16px 24px;}
.p-card{background:var(--bg2);padding:0;border-left:3px solid transparent;border-radius:10px;border:1px solid var(--bdr);border-left:3px solid transparent;transition:background .15s;overflow:hidden;}
.p-card:hover{background:var(--bg3);border-color:var(--bdr2);}
.card-long{border-left-color:var(--grn);}
.card-short{border-left-color:var(--red);}
.card-danger{border-left-color:var(--red);background:rgba(255,77,106,.04)!important;}

/* Card header */
.p-card-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 8px;}
.p-card-sym-wrap{display:flex;align-items:center;gap:10px;}
.p-card-icon{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;flex-shrink:0;}
.icon-l{background:rgba(0,214,143,.15);color:var(--grn);}
.icon-s{background:rgba(255,77,106,.15);color:var(--red);}
.icon-lg{width:48px;height:48px;font-size:20px;}
.p-card-sym{font-size:18px;font-weight:700;font-family:var(--mono);}
.p-card-usdt{font-size:12px;color:var(--dim);margin-left:3px;font-family:var(--mono);}
.p-card-meta{display:flex;align-items:center;gap:6px;margin-top:4px;}
.p-side-badge{font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;letter-spacing:.3px;}
.sb-l{background:rgba(0,214,143,.15);color:var(--grn);}
.sb-s{background:rgba(255,77,106,.15);color:var(--red);}
.sb-sm{font-size:10px;padding:1px 6px;}
.p-lev{font-size:11px;background:rgba(77,159,255,.12);color:var(--acc);padding:1px 6px;border-radius:4px;font-weight:600;}
.p-perp{font-size:11px;color:var(--dim);}
.p-card-pnl-wrap{text-align:right;}
.p-card-pnl{font-family:var(--mono);font-size:19px;font-weight:700;}
.p-card-roe{font-size:13px;margin-top:3px;font-family:var(--mono);}
.pnl-pos{color:var(--grn);}
.pnl-neg{color:var(--red);}

/* Move bar */
.p-move-bar-wrap{height:3px;background:var(--bdr2);margin:6px 18px 0;}
.p-move-bar{height:100%;border-radius:2px;transition:width .5s;}
.mb-pos{background:linear-gradient(90deg,transparent,var(--grn));}
.mb-neg{background:linear-gradient(90deg,transparent,var(--red));}

/* Metrics grid */
.p-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:10px 18px;}
.p-cg{padding:8px 10px;border-right:1px solid var(--bdr2);}
.p-cg:nth-child(3),.p-cg:nth-child(6){border-right:none;}
.p-cg:nth-child(n+4){border-top:1px solid var(--bdr2);}
.p-cg-lab{font-size:11px;color:var(--dim);letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px;}
.p-cg-val{font-family:var(--mono);font-size:14px;font-weight:600;}
.p-cg-cur{font-size:10px;color:var(--dim);}
.p-liq-dist{font-size:10px;margin-left:4px;opacity:.8;}

/* Liq alert */
.p-liq-alert{display:flex;align-items:center;gap:8px;margin:4px 18px 6px;padding:7px 12px;border-radius:6px;font-size:12px;font-weight:600;}
.la-danger{background:rgba(255,77,106,.12);color:var(--red);border:1px solid rgba(255,77,106,.2);}
.la-warn{background:rgba(255,209,102,.08);color:var(--yel);border:1px solid rgba(255,209,102,.15);}

/* Card footer */
.p-card-foot{display:flex;align-items:center;justify-content:space-between;padding:8px 18px 14px;}
.p-card-foot-btns{display:flex;gap:6px;}
.p-partial-btn{background:transparent;border:1px solid var(--bdr2);color:var(--dim);padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;}
.p-partial-btn:hover{border-color:var(--acc);color:var(--acc);}
.p-spark-wrap{height:40px;overflow:hidden;position:relative;background:linear-gradient(to bottom,rgba(255,255,255,.01),transparent);}
.p-spark-svg{width:100%;height:40px;display:block;}
.p-live-dot{color:#22c55e;font-size:8px;animation:live-pulse 1.5s ease-in-out infinite;margin-left:3px;}
@@keyframes live-pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
.p-card{cursor:pointer;transition:border-color .15s;}
.p-mini-modal{background:var(--bg3);border:1px solid var(--bdr2);border-radius:16px;width:700px;max-width:95vw;box-shadow:0 24px 80px rgba(0,0,0,.7);animation:slideUp .25s ease;}
.p-mini-chart-wrap{height:260px;overflow:hidden;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);}
.p-mini-stats{display:grid;grid-template-columns:repeat(4,1fr);}
.p-ms{padding:12px 16px;border-right:1px solid var(--bdr);}
.p-ms:nth-child(4n){border-right:none;}
.p-ms:nth-child(n+5){border-top:1px solid var(--bdr);}
.p-ms-lab{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;}
.p-ms-val{font-family:var(--mono);font-size:14px;font-weight:700;}
.p-tf-btn{background:var(--bg4);border:1px solid var(--bdr2);color:var(--dim);padding:4px 9px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;transition:all .12s;}
.p-tf-btn:hover{border-color:var(--acc);color:var(--acc);}
.p-tf-on{background:rgba(77,159,255,.12)!important;border-color:var(--acc)!important;color:var(--acc)!important;}
.p-card-sym-link{text-decoration:none;color:inherit;}
.p-card-sym-link:hover .p-card-sym{color:var(--acc);}
.p-card-foot-info{font-size:11px;}
.p-close-btn{background:transparent;border:1px solid var(--red);color:var(--red);padding:6px 18px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;letter-spacing:.3px;}
.p-close-btn:hover{background:var(--red);color:#fff;box-shadow:0 0 16px rgba(255,77,106,.3);}

/* ── HERO REALIZED LINK ──────────────────────────────────── */
.p-stat-link{margin-left:5px;color:var(--acc);text-decoration:none;font-size:11px;opacity:.7;transition:opacity .15s;}
.p-stat-link:hover{opacity:1;}

/* ── SUBTABS (Basic / Conditional) ──────────────────────── */
.p-subtabs{display:flex;gap:2px;padding:12px 28px 0;border-bottom:1px solid var(--bdr);background:var(--bg2);}
.p-subtab{background:none;border:none;color:var(--dim);font-size:12px;font-weight:600;padding:8px 16px 10px;cursor:pointer;display:flex;align-items:center;gap:7px;position:relative;transition:color .15s;border-radius:6px 6px 0 0;}
.p-subtab:hover{color:var(--txt);background:rgba(255,255,255,.03);}
.p-subtab-on{color:var(--acc)!important;background:rgba(77,159,255,.06)!important;}
.p-subtab-on::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--acc);border-radius:2px 2px 0 0;}
.p-tab-chip-sm{font-size:10px;padding:1px 6px;}

/* ── SYMBOL LINK ON CARD ─────────────────────────────────── */
.p-card-sym-link{text-decoration:none;color:inherit;}
.p-card-sym-link:hover .p-card-sym{color:var(--acc);}
.p-card-sym-link:hover .p-card-usdt{color:var(--acc);}

/* ── TABLE (Orders / History / PnL) ─────────────────────── */
.p-table-wrap{overflow-x:auto;padding:8px 0;}
.p-table{width:100%;border-collapse:collapse;min-width:700px;}
.p-table th{text-align:left;padding:11px 16px;font-size:10px;letter-spacing:.8px;text-transform:uppercase;color:var(--dim);border-bottom:1px solid var(--bdr);font-weight:600;background:var(--bg2);}
.p-table td{padding:12px 16px;border-bottom:1px solid var(--bdr);font-size:13px;vertical-align:middle;}
.p-table tr:hover td{background:rgba(255,255,255,.015);}
.p-table tr:last-child td{border-bottom:none;}
.t-sym{font-family:var(--mono);font-size:14px;font-weight:700;}
.t-sub{font-size:11px;margin-top:2px;}
.t-type{font-size:10px;background:var(--bg4);border:1px solid var(--bdr2);padding:2px 7px;border-radius:3px;color:var(--dim);}
.t-algo-badge{font-size:9px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);color:#3b82f6;padding:2px 6px;border-radius:3px;margin-left:5px;}
.t-time{font-size:11px;}
