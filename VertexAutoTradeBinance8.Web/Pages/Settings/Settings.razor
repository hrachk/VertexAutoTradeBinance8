                <input title="Min Reward/Risk Ratio" class="st-input" type="number" step="0.1" value="@GetDecimal("MeanReversion:MinRewardRiskRatio", 1.2m)" @onchange="OnMrMinRrChanged" />
            </div>
            <div class="st-field">
                <label>Time-Stop (bars) <span class="st-field-hint">force-close if the mean hasn't been reached</span></label>
                <input title="Time-Stop (bars) force-close if the mean hasn't been reached" class="st-input" type="number" value="@GetInt("MeanReversion:TimeStopBars", 12)" @onchange="OnMrTimeStopChanged" />
