    private RenderFragment ExitsTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">🎯 How Exits Work</div>
            </div>
            <div class="st-card-sub">
                Exits are managed by <strong>PositionSupervisor</strong> using ATR-based dynamic logic — not static config values.
                SL/TP levels are placed at entry time by OrderExecutor, then Supervisor trails and adjusts them automatically.
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px;">
                <div style="background:var(--st-bg3);border:1px solid var(--st-bdr);border-radius:10px;padding:14px;">
                    <div style="font-size:12px;font-weight:700;color:#60a5fa;margin-bottom:8px;">📈 Signal Positions</div>
                    <div style="font-size:12px;color:var(--st-dim);line-height:1.7;">
                        BE trigger: <code>ATR × 1.3</code><br/>
                        Partial close step: <code>ATR × 2.0</code><br/>
                        Partial size: <code>34%</code> (42% toxic)<br/>
                        SL buffer: <code>ATR × 0.3–0.5</code>
                    </div>
                </div>
                <div style="background:var(--st-bg3);border:1px solid var(--st-bdr);border-radius:10px;padding:14px;">
                    <div style="font-size:12px;font-weight:700;color:#34d399;margin-bottom:8px;">📅 DCA Positions</div>
                    <div style="font-size:12px;color:var(--st-dim);line-height:1.7;">
                        BE trigger: <code>ATR × 3.0</code><br/>
                        Partial close step: <code>ATR × 5.0</code><br/>
                        Partial size: <code>20%</code><br/>
                        SL buffer: <code>ATR × 1.2</code>
                    </div>
                </div>
            </div>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">🔁 AutoTrade & Supervisor Controls</div></div>
            <div class="st-card-sub">Key execution switches — also available in the Engine tab.</div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Trading:EnableExecution", true)" @onchange="OnEnableExecutionToggle" />
                    <span>Enable real order execution (off = signal-only / dry-run)</span>
                </label>
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Trading:SupervisorManageTP", true)" @onchange="OnSupervisorManageTPToggle" />
                    <span>Supervisor manages TP orders (off = you place your own TP manually)</span>
                </label>
            </div>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">⏱ Mean-Reversion Time-Stop</div></div>
            <div class="st-card-sub">Force-close a Mean-Reversion position after N closed bars if the mean wasn't reached. Editable in the Mean-Reversion tab.</div>
            <div class="st-field">
                <label>Time-Stop (bars)</label>
                <input title="Time-Stop (bars)" class="st-input" type="number" value="@GetInt("MeanReversion:TimeStopBars", 12)" @onchange="OnMrTimeStopChanged" />
            </div>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">📐 Take Profit Levels (ATR Multipliers)</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                ATR multipliers that set how far each TP is placed from the entry price.
                TP1 should be ≥ 1.5× ATR to guarantee RR ≥ 1:1 (SL is typically 1–1.5×ATR).
                These apply to pullback/liquidity/indicator signals — PriceAction signals use R-multiples (1R/2R/3R) independently.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>TP1 Multiplier (× ATR)</label>
                    <input class="st-input" type="number" step="0.1" min="0.5" max="5"
                           value="@GetDecimal("TakeProfit:Tp1Multiplier", 1.5m)"
                           @onchange="OnTp1MultChanged" />
                </div>
                <div class="st-field">
                    <label>TP2 Multiplier (× ATR)</label>
                    <input class="st-input" type="number" step="0.1" min="1" max="8"
                           value="@GetDecimal("TakeProfit:Tp2Multiplier", 2.5m)"
                           @onchange="OnTp2MultChanged" />
                </div>
                <div class="st-field">
                    <label>TP3 Multiplier (× ATR)</label>
                    <input class="st-input" type="number" step="0.1" min="1.5" max="12"
                           value="@GetDecimal("TakeProfit:Tp3Multiplier", 3.5m)"
                           @onchange="OnTp3MultChanged" />
                </div>
            </div>
            <div class="st-card-sub" style="margin-top:10px;">
                <strong>Position allocation per TP level</strong> — how much of the position closes at each target.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>TP1 Part (fraction, e.g. 0.40 = 40%)</label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="0.8"
                           value="@GetDecimal("TakeProfit:Tp1Part", 0.40m)"
                           @onchange="OnTp1PartChanged" />
                </div>
                <div class="st-field">
                    <label>TP2 Part</label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="0.8"
                           value="@GetDecimal("TakeProfit:Tp2Part", 0.35m)"
                           @onchange="OnTp2PartChanged" />
                </div>
                <div class="st-field">
                    <label>TP3 Part (runner)</label>
                    <input class="st-input" type="number" step="0.05" min="0.05" max="0.5"
                           value="@GetDecimal("TakeProfit:Tp3Part", 0.25m)"
                           @onchange="OnTp3PartChanged" />
                </div>
            </div>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">🛡 Position Supervisor — Break-Even Triggers</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                Controls when Supervisor moves SL to break-even and closes partial positions.
                R = risk distance (|entry − SL|). Minor = smaller/newer positions. Major = larger well-confirmed positions.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>BE Trigger R — Minor <span class="st-field-hint">move SL to BE when price reaches entry + R×this</span></label>
                    <input class="st-input" type="number" step="0.05" min="0.3" max="2.0"
                           value="@GetDecimal("PositionSupervisor:BeTriggerRMinor", 0.58m)"
                           @onchange="OnBeTriggerRMinorChanged" />
                </div>
                <div class="st-field">
                    <label>BE Trigger R — Major <span class="st-field-hint">more conservative, waits for stronger confirmation</span></label>
                    <input class="st-input" type="number" step="0.05" min="0.5" max="3.0"
                           value="@GetDecimal("PositionSupervisor:BeTriggerRMajor", 1.1m)"
                           @onchange="OnBeTriggerRMajorChanged" />
                </div>
            </div>
            <div class="st-card-sub" style="margin-top:10px;">
                <strong>Stage 1 partial close size</strong> — how much of the position to close at first TP trigger.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Stage 1 Close % — Minor</label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="0.9"
                           value="@GetDecimal("PositionSupervisor:Stage1PercentMinor", 0.25m)"
                           @onchange="OnStage1MinorChanged" />
                </div>
                <div class="st-field">
                    <label>Stage 1 Close % — Major</label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="0.9"
                           value="@GetDecimal("PositionSupervisor:Stage1PercentMajor", 0.35m)"
                           @onchange="OnStage1MajorChanged" />
                </div>
            </div>
        </div>

    </div>;

    private RenderFragment EngineTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">Live-Reload Architecture</div></div>
            <div class="st-card-sub">
                This Settings page writes to <code>appsettings.runtime.json</code> under the Engine's
                SharedData:Root folder. The Engine layers that file on top of its base appsettings.json
                using .NET's built-in config reload (no restart needed). Values consumed via
                <code>IOptionsMonitor&lt;T&gt;</code> or direct <code>IConfiguration</code> reads pick up
                changes within a few seconds; classes still using a startup <code>IOptions&lt;T&gt;</code>
                snapshot do not (flagged per-tab above where relevant).
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">🔁 AutoTrade — Order Execution</div></div>
            <div class="st-card-sub">
                Controls whether the Engine places real orders on Binance.
                When OFF — signals are generated and logged as missed trades,
                but no real orders are sent. Applies within seconds, no restart needed.
                Writes to <code>Trading:EnableExecution</code> in appsettings.runtime.json.
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Trading:EnableExecution", true)" @onchange="OnEnableExecutionToggle" />
                    <span>Enable real order execution (off = signal-only / dry-run)</span>
                </label>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">🎯 Supervisor TP Management</div></div>
            <div class="st-card-sub">
                When <strong>ON</strong> — Supervisor automatically places emergency TP orders
                when none exist, and runs partial-close / trailing logic.<br/>
                When <strong>OFF</strong> — Supervisor does <em>not</em> touch any TP orders.
                Use this when you place your own TP orders manually on Binance
                and do not want the bot to interfere or overwrite them.<br/>
                <strong>SL and Break-Even management always work regardless of this setting.</strong>
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Trading:SupervisorManageTP", true)" @onchange="OnSupervisorManageTPToggle" />
                    <span>Supervisor manages TP orders (off = manual TP mode)</span>
                </label>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head">
                <div class="st-card-title">🛡 HedgeKill</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                HedgeKill manages conflicting hedge positions (simultaneous LONG+SHORT on the same symbol).
                <strong>Hybrid</strong> mode closes the losing side at a fraction when the net loss exceeds the threshold.
                <strong>Safe</strong> = only closes on hard loss. <strong>Aggressive</strong> = closes faster.
            </div>
            <div class="st-field">
                <label>Mode</label>
                <select class="st-select" value="@GetStr("HedgeKill:Mode", "Hybrid")" @onchange="OnHedgeKillModeChanged">
                    <option value="Safe">Safe — only on hard loss</option>
                    <option value="Hybrid">Hybrid — balanced (recommended)</option>
                    <option value="Aggressive">Aggressive — close faster</option>
                </select>
            </div>
            <div class="st-field-row" style="margin-top:10px;">
                <div class="st-field">
                    <label>Net OK threshold ($) <span class="st-field-hint">don't kill if net PnL ≥ this</span></label>
                    <input class="st-input" type="number" step="0.5"
                           value="@GetDecimal("HedgeKill:NetOkUsd", 3.5m)" @onchange="OnHedgeNetOkChanged" />
                </div>
                <div class="st-field">
                    <label>Hard Net loss ($) <span class="st-field-hint">negative — force kill at this loss</span></label>
                    <input class="st-input" type="number" step="0.5"
                           value="@GetDecimal("HedgeKill:HardNetUsd", -3.0m)" @onchange="OnHedgeHardNetChanged" />
                </div>
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Hard Loser ($) <span class="st-field-hint">single position loss threshold</span></label>
                    <input class="st-input" type="number" step="0.5"
                           value="@GetDecimal("HedgeKill:HardLoserUsd", 8.0m)" @onchange="OnHedgeHardLoserChanged" />
                </div>
                <div class="st-field">
                    <label>Loser Close Fraction <span class="st-field-hint">0.70 = close 70% of losing side</span></label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="1.0"
                           value="@GetDecimal("HedgeKill:LoserCloseFraction", 0.70m)" @onchange="OnHedgeLoserFracChanged" />
                </div>
            </div>
            <div class="st-toggle-row" style="margin-top:8px;">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("HedgeKill:UseCooldown", true)" @onchange="OnHedgeCooldownToggle" />
                    <span>Use cooldown between kills</span>
                </label>
            </div>
            @if (GetBool("HedgeKill:UseCooldown", true))
            {
                <div class="st-field">
                    <label>Cooldown (minutes)</label>
                    <input class="st-input" type="number" min="1" max="60"
                           value="@GetInt("HedgeKill:CooldownMinutes", 12)" @onchange="OnHedgeCooldownMinChanged" />
                </div>
            }
        </div>

        <div class="st-card">
            <div class="st-card-head">
                <div class="st-card-title">🗄 Historical Data Archive</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                Background service that builds a permanent OHLCV archive under <code>datadb/</code>.
                Used for backtesting and chart display when live data isn't available yet.
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("HistoricalData:Enabled", true)" @onchange="OnHistDataEnabledToggle" />
                    <span>Enable historical data loader</span>
                </label>
            </div>
            <div class="st-field" style="margin-top:10px;">
                <label>Fetch interval (seconds) <span class="st-field-hint">how often the loader runs</span></label>
                <input class="st-input" type="number" min="60" max="3600" step="60"
                       value="@GetInt("HistoricalData:IntervalSeconds", 300)" @onchange="OnHistIntervalChanged" />
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("HistoricalData:IncludePinnedSymbols", true)" @onchange="OnHistIncludePinnedToggle" />
                    <span>Auto-include Pinned symbols</span>
                </label>
            </div>
        </div>

        <div class="st-card st-card-muted">
            <div class="st-card-head"><div class="st-card-title">🐞 Debug</div></div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Debug:EnableStrategyDebug", true)" @onchange="OnDebugToggle" />
                    <span>Enable verbose strategy debug logging</span>
                </label>
            </div>
        </div>

    </div>;

    private Task OnEnableExecutionToggle(ChangeEventArgs e) => SetAsync("Trading:EnableExecution", (bool)(e.Value ?? true));
    private Task OnSupervisorManageTPToggle(ChangeEventArgs e) => SetAsync("Trading:SupervisorManageTP", (bool)(e.Value ?? true));
    private Task OnDebugToggle(ChangeEventArgs e) => SetAsync("Debug:EnableStrategyDebug", (bool)(e.Value ?? true));
    private Task OnHedgeKillModeChanged(ChangeEventArgs e) => SetAsync("HedgeKill:Mode", e.Value?.ToString() ?? "Hybrid");
    private Task OnHedgeNetOkChanged(ChangeEventArgs e) => SetAsync("HedgeKill:NetOkUsd", ParseDecimalOr(e.Value, 3.5m));
    private Task OnHedgeHardNetChanged(ChangeEventArgs e) => SetAsync("HedgeKill:HardNetUsd", ParseDecimalOr(e.Value, -3.0m));
    private Task OnHedgeHardLoserChanged(ChangeEventArgs e) => SetAsync("HedgeKill:HardLoserUsd", ParseDecimalOr(e.Value, 8.0m));
    private Task OnHedgeLoserFracChanged(ChangeEventArgs e) => SetAsync("HedgeKill:LoserCloseFraction", ParseDecimalOr(e.Value, 0.70m));
    private Task OnHedgeCooldownToggle(ChangeEventArgs e) => SetAsync("HedgeKill:UseCooldown", (bool)(e.Value ?? true));
    private Task OnHedgeCooldownMinChanged(ChangeEventArgs e) => SetAsync("HedgeKill:CooldownMinutes", ParseIntOr(e.Value, 12));
    private Task OnHistDataEnabledToggle(ChangeEventArgs e) => SetAsync("HistoricalData:Enabled", (bool)(e.Value ?? true));
    private Task OnHistIntervalChanged(ChangeEventArgs e) => SetAsync("HistoricalData:IntervalSeconds", ParseIntOr(e.Value, 300));
    private Task OnHistIncludePinnedToggle(ChangeEventArgs e) => SetAsync("HistoricalData:IncludePinnedSymbols", (bool)(e.Value ?? true));

    private RenderFragment DataArchiveTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">File-Based Historical Archive</div></div>
            <div class="st-card-sub">
                An independent background service (HistoricalDataLoaderService) keeps a permanent,
                portable archive of OHLCV history under <code>datadb/SYMBOL/TF.json</code> — separate from
                the live trading buffer, which only holds a few hundred recent bars. Deep backfill
                gradually extends each symbol+timeframe backward toward its actual exchange listing
                date, a bit further every hour by default. Configured under
                <code>HistoricalData</code> in appsettings.json (live-reloadable, no restart needed).
            </div>
        </div>

        @{
            var archivedSymbols = DataArchive.ListArchivedSymbols();
        }

        @if (archivedSymbols.Count == 0)
        {
            <div class="st-card st-card-wide">
                <div class="st-card-sub">No archived symbols found yet — either <code>HistoricalData:Enabled</code>
                    is false, or the loader hasn't completed its first cycle. Check the Engine logs for
                    <code>[DATADB-LOADER]</code> entries.</div>
            </div>
        }
        else
        {
            <div class="st-card st-card-wide">
                <div class="st-card-head"><div class="st-card-title">Archived Symbols (@archivedSymbols.Count)</div></div>
                <table class="st-archive-table">
                    <thead>
                        <tr><th>Symbol</th><th>Timeframes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var sym in archivedSymbols)
                        {
                            var tfs = DataArchive.ListArchivedTimeframes(sym);
                            <tr>
                                <td class="st-archive-sym">@sym</td>
                                <td>
                                    @foreach (var tf in tfs)
                                    {
                                        <span class="st-archive-tf-pill">@tf</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>;


    private RenderFragment DemoTradingTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">Demo Trading Account</div></div>
            <div class="st-card-sub">
                A single shared virtual account (real live prices, virtual money) — toggled on
                the Market page's header. While active, live Buy/Sell on that page is suspended;
                everything routes through this demo account instead. Balance changes
                <strong>permanently</strong> on every close (realistic — it can go negative), not a
                sandbox that resets your running result automatically.
            </div>
        </div>

        @{
            var demoState = DemoAccount.GetSnapshot();
        }

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Current Account State</div></div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Balance</label>
                    <div class="st-readonly mono">$@demoState.Balance.ToString("F2")</div>
                </div>
                <div class="st-field">
                    <label>Open Positions</label>
                    <div class="st-readonly mono">@demoState.Positions.Count</div>
                </div>
                <div class="st-field">
                    <label>Pending Orders</label>
                    <div class="st-readonly mono">@demoState.PendingOrders.Count</div>
                </div>
                <div class="st-field">
                    <label>Closed Trades</label>
                    <div class="st-readonly mono">@demoState.History.Count</div>
                </div>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Reset Account</div></div>
            <div class="st-field">
                <label>Starting Balance (USDT)</label>
                <input class="st-input" type="number" min="1" step="100" value="@_demoResetBalance"
                       @onchange="OnDemoResetBalanceChanged" />
            </div>
            <div class="st-card-sub" style="margin:8px 0">
                Resetting wipes ALL current demo positions, pending orders, and trade history, and
                sets the balance to the amount above. This cannot be undone.
            </div>
            @if (!_demoResetConfirm)
            {
                <button class="st-btn-danger" @onclick="() => _demoResetConfirm = true">Reset Demo Account</button>
            }
            else
            {
                <div class="st-confirm-row">
                    <span>Wipe everything and start over at $@_demoResetBalance.ToString("F2")?</span>
                    <button class="st-btn-danger" @onclick="ConfirmDemoReset">Yes, reset</button>
                    <button class="st-btn-secondary" @onclick="() => _demoResetConfirm = false">Cancel</button>
                </div>
            }
        </div>

    </div>;


    private RenderFragment DcaTab() => @<div class="st-grid">

        <div class="st-dca-lang-toggle">
            <button class="st-dca-lang-btn @(_dcaLang=="en"?"st-dca-lang-on":"")" @onclick="SetDcaLangEn">EN</button>
            <button class="st-dca-lang-btn @(_dcaLang=="ru"?"st-dca-lang-on":"")" @onclick="SetDcaLangRu">RU</button>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">@T("dca.title")</div></div>
            <div class="st-card-sub">
                @T("dca.intro") <strong>@T("dca.intro.parallel")</strong> @T("dca.intro.rest")
            </div>
        </div>

        @{
            bool dcaEnabled = GetBool("Dca:Enabled", false);
            var dcaSymbols = GetDcaSymbols();
            decimal totalWeight = dcaSymbols.Sum(s => Math.Max(0.0001m, s.Weight));
        }

        <div class="st-card st-card-wide">
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@dcaEnabled" @onchange="OnDcaEnabledToggle" />
                    <span><strong>@T("dca.enable")</strong></span>
                </label>
            </div>
            <div class="st-card-sub" style="margin-top:4px">
                @T("dca.enable.sub")
            </div>
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">@T("dca.coins.title")</div></div>
            <div class="st-card-sub">
                @T("dca.coins.sub")
            </div>

            @if (dcaSymbols.Count > 0)
            {
                <table class="st-dca-table">
                    <thead>
                        <tr><th>@T("dca.col.symbol")</th><th>@T("dca.col.weight")</th><th>@T("dca.col.share")</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (sym, weight) in dcaSymbols)
                        {
                            decimal pct = totalWeight > 0 ? weight / totalWeight * 100m : 0m;
                            <tr>
                                <td class="mono">@sym</td>
                                <td>
                                    <input class="st-input st-dca-weight-input" type="number" min="0.01" step="1" value="@weight"
                                           @onchange="@(e => OnDcaSymbolWeightChanged(sym, e))" />
                                </td>
                                <td class="mk-dim">@pct.ToString("F0")%</td>
                                <td><button class="st-btn-secondary" @onclick="() => RemoveDcaSymbol(sym)">@T("dca.col.remove")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="st-card-sub" style="font-style:italic">@T("dca.none")</div>
            }

            <div class="st-add-row" style="margin-top:10px">
                <input class="st-input" placeholder="@T("dca.add.placeholder")" value="@_dcaNewSymbol" @oninput="@(e => _dcaNewSymbol = e.Value?.ToString()?.ToUpperInvariant() ?? "")" />
                <input class="st-input st-dca-weight-input" type="number" min="0.01" step="1" placeholder="@T("dca.col.weight")" value="@_dcaNewWeight" @oninput="@(e => _dcaNewWeight = e.Value?.ToString() ?? "")" />
                <button class="st-btn-secondary" @onclick="AddDcaSymbol">@T("dca.add.button")</button>
            </div>

            <div class="st-toggle-row" style="margin-top:14px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@(GetString("Dca:AllocationMode","Weighted")=="Equal")" @onchange="OnDcaEqualAllocationToggle" />
                    <span>@T("dca.equal")</span>
                </label>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">@T("dca.schedule.title")</div></div>
            <div class="st-card-sub">@T("dca.schedule.sub")</div>

            <div class="st-field">
                <label>@T("dca.timezone")</label>
                <select class="st-select" value="@GetString("Dca:Schedule:TimeZoneId","UTC")" @onchange="OnDcaTimeZoneChanged">
                    <option value="UTC">UTC</option>
                    <option value="America/New_York">America/New_York (US Eastern — EDT/EST auto)</option>
                    <option value="America/Chicago">America/Chicago (US Central)</option>
                    <option value="America/Denver">America/Denver (US Mountain)</option>
                    <option value="America/Los_Angeles">America/Los_Angeles (US Pacific)</option>
                    <option value="Europe/London">Europe/London</option>
                    <option value="Europe/Moscow">Europe/Moscow</option>
                    <option value="Asia/Dubai">Asia/Dubai (UTC+4)</option>
                    <option value="Asia/Yerevan">Asia/Yerevan (UTC+4)</option>
                    <option value="Asia/Shanghai">Asia/Shanghai</option>
                    <option value="Asia/Tokyo">Asia/Tokyo</option>
                    <option value="__custom__">@T("dca.timezone.custom")</option>
                </select>
                @if (!_dcaKnownTimeZones.Contains(GetString("Dca:Schedule:TimeZoneId","UTC")))
                {
                    <input class="st-input" style="margin-top:6px" placeholder="e.g. America/Sao_Paulo"
                           value="@GetString("Dca:Schedule:TimeZoneId","UTC")" @onchange="OnDcaTimeZoneCustomChanged" />
                }
                <div class="st-card-sub" style="margin-top:4px">@T("dca.timezone.sub")</div>
            </div>

            <div class="st-field">
                <label>@T("dca.freq")</label>
                <select class="st-select" value="@GetString("Dca:Schedule:Frequency","Weekly")" @onchange="OnDcaFrequencyChanged">
                    <option value="Daily">@T("dca.freq.daily")</option>
                    <option value="Weekly">@T("dca.freq.weekly")</option>
                    <option value="Monthly">@T("dca.freq.monthly")</option>
                </select>
            </div>

            @if (GetString("Dca:Schedule:Frequency","Weekly") == "Weekly")
            {
                <div class="st-field">
                    <label>@T("dca.dow")</label>
                    <select class="st-select" value="@GetInt("Dca:Schedule:DayOfWeek",1)" @onchange="OnDcaDayOfWeekChanged">
                        <option value="1">@T("dca.dow.mon")</option>
                        <option value="2">@T("dca.dow.tue")</option>
                        <option value="3">@T("dca.dow.wed")</option>
                        <option value="4">@T("dca.dow.thu")</option>
                        <option value="5">@T("dca.dow.fri")</option>
                        <option value="6">@T("dca.dow.sat")</option>
                        <option value="7">@T("dca.dow.sun")</option>
                    </select>
                </div>
            }
            @if (GetString("Dca:Schedule:Frequency","Weekly") == "Monthly")
            {
                <div class="st-field">
                    <label>@T("dca.dom")</label>
                    <input class="st-input" type="number" min="1" max="28" value="@GetInt("Dca:Schedule:DayOfMonth",1)" @onchange="OnDcaDayOfMonthChanged" />
                    <div class="st-card-sub" style="margin-top:4px">@T("dca.dom.sub")</div>
                </div>
            }

            <div class="st-field">
                <label>@T("dca.hour")</label>
                <input class="st-input" type="number" min="0" max="23" value="@GetInt("Dca:Schedule:HourUtc",12)" @onchange="OnDcaHourChanged" />
            </div>

            <div class="st-field">
                <label>@T("dca.budget")</label>
                <input class="st-input" type="number" min="1" step="10" value="@GetDecimal("Dca:Schedule:BudgetPerCycle",100m)" @onchange="OnDcaBudgetChanged" />
                <div class="st-card-sub" style="margin-top:4px">@T("dca.budget.sub")</div>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">@T("dca.dip.title")</div></div>
            <div class="st-card-sub">
                @T("dca.dip.sub") <em>@T("dca.dip.sub.em")</em>@T("dca.dip.sub.rest")
            </div>

            <div class="st-toggle-row" style="margin-top:8px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Dca:DipBonus:Enabled", false)" @onchange="OnDcaDipBonusToggle" />
                    <span>@T("dca.dip.enable")</span>
                </label>
            </div>

            @if (GetBool("Dca:DipBonus:Enabled", false))
            {
                <div class="st-field-row" style="margin-top:10px">
                    <div class="st-field">
                        <label>@T("dca.dip.lookback")</label>
                        <input class="st-input" type="number" min="1" max="168" value="@GetInt("Dca:DipBonus:LookbackHours",24)" @onchange="OnDcaDipLookbackChanged" />
                    </div>
                    <div class="st-field">
                        <label>@T("dca.dip.threshold")</label>
                        <input class="st-input" type="number" min="1" max="90" value="@GetDecimal("Dca:DipBonus:DropThresholdPct",10m)" @onchange="OnDcaDipThresholdChanged" />
                    </div>
                    <div class="st-field">
                        <label>@T("dca.dip.multiplier")</label>
                        <input class="st-input" type="number" min="1" max="10" step="0.5" value="@GetDecimal("Dca:DipBonus:Multiplier",2m)" @onchange="OnDcaDipMultiplierChanged" />
                    </div>
                </div>
                <div class="st-card-sub">
                    @T("dca.dip.example")
                </div>
            }
        </div>

        <div class="st-card st-card-wide">
            <div class="st-card-head"><div class="st-card-title">@T("dca.history.title")</div></div>
            <div class="st-card-sub">@T("dca.history.sub")</div>

            @{
                var realHistory = RealDcaHistory.Read().History.Take(10).ToList();
                var demoHistory = DemoAccount.GetDcaSnapshot().History.Take(10).ToList();
            }

            <div class="st-field-row" style="align-items:flex-start">
                <div class="st-field" style="flex:1">
                    <label>@T("dca.history.real")</label>
                    @if (realHistory.Count == 0)
                    {
                        <div class="st-card-sub" style="font-style:italic">@T("dca.history.none")</div>
                    }
                    else
                    {
                        @foreach (var h in realHistory)
                        {
                            <div class="st-dca-history-row">
                                <span class="mono">@h.Symbol</span>
                                <span class="mk-dim">@h.TimeUtc.ToLocalTime().ToString("MM/dd HH:mm")</span>
                                <span class="mono">$@h.UsdtSpent.ToString("F2")</span>
                                @if (h.DipBonusApplied) { <span class="st-dca-dip-badge">DIP</span> }
                            </div>
                        }
                    }
                </div>
                <div class="st-field" style="flex:1">
                    <label>@T("dca.history.demo")</label>
                    @if (demoHistory.Count == 0)
                    {
                        <div class="st-card-sub" style="font-style:italic">@T("dca.history.none")</div>
                    }
                    else
                    {
                        @foreach (var h in demoHistory)
                        {
                            <div class="st-dca-history-row">
                                <span class="mono">@h.Symbol</span>
                                <span class="mk-dim">@h.TimeUtc.ToLocalTime().ToString("MM/dd HH:mm")</span>
                                <span class="mono">$@h.UsdtSpent.ToString("F2")</span>
                                @if (h.DipBonusApplied) { <span class="st-dca-dip-badge">DIP</span> }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>;


    // ── Tab definitions ──────────────────────────────────────
    private sealed record TabDef(string Id, string Label, string Icon, bool LiveBadge);

    private readonly List<TabDef> _tabs = new()
    {
        new("connection", "Connection",        "🔑", false),
        new("strategy",  "Strategy Routing",  "🧭", true),
        new("meanrev",   "Mean-Reversion",    "📉", true),
        new("risk",      "Risk & Leverage",   "⚖️", true),
        new("symbols",   "Symbol Selection",  "🪙", true),
        new("exits",     "Exits & TP/SL",     "🎯", false),
        new("engine",    "Engine Info",       "🖥️", false),
        new("datadb",    "Data Archive",      "🗄️", false),
        new("demo",      "Demo Trading",      "🎮", false),
        new("dca",       "DCA Strategy",      "📅", true),
    };

    private string _activeTab = "strategy";
    private string _strategyMode = "Auto";

    private decimal _demoResetBalance = 1000m;
    private bool _demoResetConfirm;

    private Task OnDemoResetBalanceChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0)
        {
            _demoResetBalance = v;
        }
        return Task.CompletedTask;
    }

    private void ConfirmDemoReset()
    {
        DemoAccount.ResetAccount(_demoResetBalance);
        _demoResetConfirm = false;
    }

    // ── DCA settings ──────────────────────────────────────────
    string _dcaNewSymbol = "";
    string _dcaLang = "en"; // "en" or "ru" — DCA tab only, per direct request; rest of Settings stays English-only.

    static readonly HashSet<string> _dcaKnownTimeZones = new()
    {
        "UTC", "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles",
        "Europe/London", "Europe/Moscow", "Asia/Dubai", "Asia/Yerevan", "Asia/Shanghai", "Asia/Tokyo",
    };

    private async Task OnDcaTimeZoneChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "UTC";
        if (val == "__custom__") return; // user picked "Other" — they'll type the real value into the text field that appears
        await SetAsync("Dca:Schedule:TimeZoneId", val);
    }

    private Task OnDcaTimeZoneCustomChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:TimeZoneId", e.Value?.ToString() ?? "UTC");

