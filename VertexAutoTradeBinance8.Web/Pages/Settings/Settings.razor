            </div>
            <div class="st-field">
                <label>Min Reward/Risk Ratio</label>
                <input title="Min Reward/Risk Ratio" class="st-input" type="number" step="0.1" value="@GetDecimal("MeanReversion:MinRewardRiskRatio", 1.2m)" @onchange="OnMrMinRrChanged" />
            </div>
