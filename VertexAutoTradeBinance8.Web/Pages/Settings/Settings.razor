@page "/settings"
@using System.Text.Json.Nodes
@using VertexAutoTradeBinance8.Web.Services
@inject RuntimeConfigService Cfg
@inject StrategyModeFileService StrategyModeSvc
@inject IJSRuntime JS
@inject VertexAutoTradeBinance8.Web.Services.HistoricalDataReaderService DataArchive
@inject VertexAutoTradeBinance8.Web.Services.DemoAccountService DemoAccount
@inject VertexAutoTradeBinance8.Web.Services.RealDcaHistoryReader RealDcaHistory

<PageTitle>Settings — Vertex AI</PageTitle>

<div class="st">

    <!-- ══ HEADER ══════════════════════════════════════════════ -->
    <div class="st-header">
        <div class="st-header-left">
            <div class="st-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="st-gear">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                </svg>
            </div>
            <div>
                <div class="st-title">Settings</div>
                <div class="st-subtitle">Live engine configuration — changes apply within seconds, no restart</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_saveToast))
        {
            <div class="st-toast @(_saveToastIsError ? "st-toast-err" : "")">
                <span class="st-toast-dot"></span>@_saveToast
            </div>
        }
    </div>

    <!-- ══ TABS ════════════════════════════════════════════════ -->
    <div class="st-tabs">
        @foreach (var tab in _tabs)
        {
            <button class="st-tab @(_activeTab == tab.Id ? "st-tab-on" : "")" @onclick="() => _activeTab = tab.Id">
                <span class="st-tab-icon">@tab.Icon</span>
                @tab.Label
                @if (tab.LiveBadge)
                {
                    <span class="st-tab-live">●</span>
                }
            </button>
        }
    </div>

    <div class="st-body">

        @if (_loading)
        {
            <div class="st-loading">
                <div class="st-spin"></div>
                Loading current configuration…
            </div>
        }
        else
        {
            @switch (_activeTab)
            {
                case "connection": { @ConnectionTab() break; }
                case "strategy": { @StrategyTab() break; }
                case "risk":     { @RiskTab() break; }
                case "symbols":  { @SymbolsTab() break; }
                case "meanrev":  { @MeanRevTab() break; }
                case "exits":    { @ExitsTab() break; }
                case "engine":   { @EngineTab() break; }
                case "datadb":   { @DataArchiveTab() break; }
                case "demo":     { @DemoTradingTab() break; }
                case "dca":      { @DcaTab() break; }
            }
        }

    </div>
</div>

@code {
    // ── Connection / Binance API tab ──────────────────────────
    bool _showSecret;
    string _pendingApiKey    = "";
    string _pendingSecretKey = "";
    bool _connSaved;
    string _connError = "";

    private RenderFragment ConnectionTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">🔑 Binance API Connection</div>
                <!-- Status badge — shows at a glance whether keys are configured -->
                @{
                    var apiKey    = GetStr("Binance:ApiKey");
                    var secretKey = GetStr("Binance:SecretKey");
                    bool keysOk   = !string.IsNullOrWhiteSpace(apiKey) && !string.IsNullOrWhiteSpace(secretKey);
                    var keyMasked = keysOk ? apiKey[..Math.Min(8, apiKey.Length)] + "••••••••" : "";
                }
                <div class="st-conn-status @(keysOk ? "st-conn-ok" : "st-conn-missing")">
                    @if (keysOk)
                    {
                        <span>✓ Keys configured — <code>@keyMasked</code></span>
                        <span class="st-conn-reload">Both Engine and Web reload automatically on save — no restart needed</span>
                    }
                    else
                    {
                        <span>⚠ No API keys — enter them below to connect to Binance</span>
                    }
                </div>
            </div>
            <div class="st-card-sub">
                Saved to <code>appsettings.runtime.json</code> — loaded by <strong>both</strong> Engine and Web
                via <code>reloadOnChange</code>, so one save updates both processes instantly.
                Use a key with <strong>Futures trading</strong> permission only. Never enable withdrawals.
            </div>

            <div class="st-field-group" style="margin-top:18px">

                <!-- API Key -->
                <div class="st-field">
                    <label class="st-label">API Key</label>
                    <div class="st-input-row">
                        <input class="st-input st-input-wide st-input-mono"
                               type="text"
                               placeholder="@(keysOk ? "Currently set — paste new key to replace" : "Paste your Binance API key…")"
                               value="@_pendingApiKey"
                               @oninput="OnApiKeyInput"
                               autocomplete="off" spellcheck="false" />
                    </div>
                </div>

                <!-- Secret Key -->
                <div class="st-field" style="margin-top:12px">
                    <label class="st-label">Secret Key</label>
                    <div class="st-input-row">
                        <input class="st-input st-input-wide st-input-mono"
                               type="@(_showSecret ? "text" : "password")"
                               placeholder="@(keysOk ? "Currently set — paste new secret to replace" : "Paste your Binance Secret key…")"
                               value="@_pendingSecretKey"
                               @oninput="OnSecretKeyInput"
                               autocomplete="new-password" spellcheck="false" />
                        <button class="st-icon-btn" title="@(_showSecret ? "Hide" : "Show")"
                                @onclick="() => _showSecret = !_showSecret">
                            @(_showSecret ? "🙈" : "👁")
                        </button>
                    </div>
                </div>

                <!-- Save button -->
                <div style="margin-top:16px; display:flex; align-items:center; gap:12px;">
                    <button class="st-btn-primary"
                            disabled="@(string.IsNullOrWhiteSpace(_pendingApiKey) && string.IsNullOrWhiteSpace(_pendingSecretKey))"
                            @onclick="SaveConnectionAsync">
                        💾 Save &amp; apply
                    </button>
                    @if (_connSaved)
                    {
                        <span style="color:#22c55e; font-size:12px; font-weight:700;">
                            ✓ Saved to appsettings.runtime.json — Engine and Web reloading…
                        </span>
                    }
                    @if (_connError != "")
                    {
                        <span style="color:#ef4444; font-size:12px; font-weight:700;">✗ @_connError</span>
                    }
                </div>
            </div>
        </div>

        <!-- Advanced connection params -->
        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Advanced</div></div>
            <div class="st-card-sub">Order book depth and update rate. Defaults are fine for most setups.</div>

            <div class="st-fields" style="margin-top:14px">
                <div class="st-field-row">
                    <label class="st-label">Use Testnet</label>
                    <input type="checkbox" class="st-checkbox"
                           checked="@GetBool("Binance:UseTestnet", false)"
                           @onchange="OnTestnetChanged" />
                    <span class="st-field-hint">Routes all orders to Binance Testnet — no real money used</span>
                </div>

                <div class="st-field-row" style="margin-top:10px">
                    <label class="st-label">Order Book Depth</label>
                    <input class="st-input" type="number" min="5" max="1000" step="5"
                           value="@GetInt("Binance:Depth", 50)"
                           @onchange="OnDepthChanged" />
                    <span class="st-field-hint">Levels of order book to subscribe to (5–1000)</span>
                </div>

                <div class="st-field-row" style="margin-top:10px">
                    <label class="st-label">Depth Update ms</label>
                    <input class="st-input" type="number" min="100" max="1000" step="100"
                           value="@GetInt("Binance:DepthUpdateMs", 300)"
                           @onchange="OnDepthUpdateMsChanged" />
                    <span class="st-field-hint">WebSocket push interval in milliseconds (100 / 300)</span>
                </div>
            </div>
        </div>

        <!-- Security notice -->
        <div class="st-card st-card-wide st-card-warn">
            <div class="st-card-head"><div class="st-card-title">⚠️ Security reminder</div></div>
            <ul style="margin:8px 0 0 16px; font-size:12px; line-height:2; color:var(--st-dim)">
                <li>Never share your Secret Key with anyone — not even Binance support.</li>
                <li>Restrict the API key to <strong>Futures trading only</strong> — disable Spot, withdrawals, and transfers.</li>
                <li>Whitelist your server IP on the Binance API key settings page.</li>
                <li>Rotate keys periodically. If leaked — delete immediately on Binance and generate new ones.</li>
            </ul>
        </div>

    </div>;

    private void OnApiKeyInput(ChangeEventArgs e)    => _pendingApiKey    = e.Value?.ToString() ?? string.Empty;
    private void OnSecretKeyInput(ChangeEventArgs e) => _pendingSecretKey = e.Value?.ToString() ?? string.Empty;
    private Task OnTestnetChanged(ChangeEventArgs e)      => SetAsync("Binance:UseTestnet",    (bool)(e.Value ?? false));
    private Task OnDepthChanged(ChangeEventArgs e)         => SetAsync("Binance:Depth",          ParseIntOr(e.Value, 50));
    private Task OnDepthUpdateMsChanged(ChangeEventArgs e) => SetAsync("Binance:DepthUpdateMs",  ParseIntOr(e.Value, 300));

    private async Task SaveConnectionAsync()
    {
        _connSaved = false;
        _connError = "";

        var apiKey    = _pendingApiKey.Trim();
        var secretKey = _pendingSecretKey.Trim();

        // Basic sanity checks — Binance API keys are always 64 chars,
        // secrets 64 chars. Warn the user rather than silently writing
        // a truncated/pasted value that will just fail auth later.
        if (!string.IsNullOrEmpty(apiKey) && apiKey.Length < 20)
        {
            _connError = "API key looks too short — check you copied it fully";
            StateHasChanged(); return;
        }
        if (!string.IsNullOrEmpty(secretKey) && secretKey.Length < 20)
        {
            _connError = "Secret key looks too short — check you copied it fully";
            StateHasChanged(); return;
        }

        try
        {
            // Write to appsettings.runtime.json via RuntimeConfigService.
            // Both Engine and Web load this file with reloadOnChange:true —
            // IOptionsMonitor<BinanceOptions> consumers in BOTH processes
            // pick up the new values within ~1 second, no restart needed.
            if (!string.IsNullOrEmpty(apiKey))
            {
                await SetAsync("Binance:ApiKey", apiKey);
                _pendingApiKey = "";
            }
            if (!string.IsNullOrEmpty(secretKey))
            {
                await SetAsync("Binance:SecretKey", secretKey);
                _pendingSecretKey = "";
            }
            _connSaved = true;
            StateHasChanged();
            await Task.Delay(5000);
            _connSaved = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _connError = $"Save failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private RenderFragment StrategyTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">Strategy Routing Mode</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">Decides whether the trend-following engine, the mean-reversion engine, or both (regime-based) generate trade signals.</div>

            <div class="st-mode-grid">
                @foreach (var (val, label, desc) in new[]
                {
                    ("Auto", "Auto (Regime-based)", "Trend engine fires in Trend/StrongTrend regimes, Mean-Reversion fires in Range/Squeeze. Recommended default."),
                    ("TrendOnly", "Trend Only", "Only the original trend-following engine runs. Mean-Reversion is fully disabled — identical to pre-v9 behavior."),
                    ("MeanReversionOnly", "Mean-Reversion Only", "Only the Z-Score mean-reversion engine runs, regardless of detected regime.")
                })
                {
                    <div class="st-mode-option @(_strategyMode == val ? "st-mode-on" : "")" @onclick="() => SetStrategyMode(val)">
                        <div class="st-mode-radio">@(_strategyMode == val ? "●" : "○")</div>
                        <div>
                            <div class="st-mode-label">@label</div>
                            <div class="st-mode-desc">@desc</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Pullback Entry</div></div>
            <div class="st-card-sub">Powers the trend engine's TryPullbackEma21 entry: waits for price to touch the EMA after a clear trend move, then enters on a rejection candle bouncing off it. Live-reloadable — no restart needed.</div>
            <div class="st-field">
                <label>EMA Period</label>
                <input title="EMA Period" class="st-input" type="number" min="5" max="100" value="@GetInt("Strategy:PullbackEntry:EmaPeriod",21)"
                       @onchange="OnEmaPeriodChanged" />
            </div>
            <div class="st-field">
                <label>Touch Zone (× ATR)</label>
                <input title="Touch Zone (ATR multiplier)" class="st-input" type="number" step="0.05" min="0.1" max="2" value="@GetDecimal("Strategy:PullbackEntry:ZoneAtrMultiplier",0.5m)"
                       @onchange="OnEmaZoneAtrMultiplierChanged" />
                <div class="st-card-sub" style="margin-top:4px">How close price must come to the EMA to count as a "touch" — expressed as a multiple of ATR (volatility-normalized, not a fixed %), so it scales correctly across symbols.</div>
            </div>

            <div class="st-toggle-row" style="margin-top:14px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Strategy:PullbackEntry:VwapConfirmationEnabled", false)" @onchange="OnVwapConfirmationToggle" />
                    <span>Require VWAP confirmation</span>
                </label>
                <div class="st-card-sub" style="margin-top:4px">Only accept a signal if price is on the expected side of the rolling-window VWAP (above it for longs, below for shorts) — an extra directional check on top of the existing EMA logic. Off by default.</div>
            </div>
            @if (GetBool("Strategy:PullbackEntry:VwapConfirmationEnabled", false))
            {
                <div class="st-field">
                    <label>VWAP Period (bars)</label>
                    <input title="VWAP rolling window (bars)" class="st-input" type="number" min="5" max="200" value="@GetInt("Strategy:PullbackEntry:VwapPeriod",20)"
                           @onchange="OnVwapPeriodChanged" />
                </div>
            }

            <div class="st-toggle-row" style="margin-top:10px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Strategy:PullbackEntry:HtfConfirmationEnabled", false)" @onchange="OnHtfConfirmationToggle" />
                    <span>Require higher-timeframe structure confirmation</span>
                </label>
                <div class="st-card-sub" style="margin-top:4px">Only accept a signal if the SAME symbol's EMA21/EMA55 relationship on a higher timeframe agrees with the signal's direction. Off by default.</div>
            </div>
            @if (GetBool("Strategy:PullbackEntry:HtfConfirmationEnabled", false))
            {
                <div class="st-field">
                    <label>Confirmation Timeframe</label>
                    <select title="Higher timeframe to confirm against" class="st-select" value="@GetStr("Strategy:PullbackEntry:HtfConfirmationTimeframe","4h")"
                            @onchange="OnHtfTimeframeChanged">
                        <option value="15m">15m</option>
                        <option value="30m">30m</option>
                        <option value="1h">1h</option>
                        <option value="4h">4h</option>
                        <option value="1d">1d</option>
                    </select>
                </div>
            }
        </div>

        <div class="st-card">
            <div class="st-card-head">
                <div class="st-card-title">⚡ Controlled Trend Engine</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                Parameters for the AdaptiveEngine in Controlled Trend regime — tight directional moves with low volatility.
                RiskBias scales position size (0.65 = 65% of normal). MinRR is the minimum acceptable Risk/Reward.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Risk Bias <span class="st-field-hint">position size multiplier in controlled trend (0.65 = 65%)</span></label>
                    <input class="st-input" type="number" step="0.05" min="0.1" max="1.0"
                           value="@GetDecimal("AdaptiveEngine:ControlledTrend:RiskBias", 0.65m)"
                           @onchange="OnCtRiskBiasChanged" />
                </div>
                <div class="st-field">
                    <label>Min RR <span class="st-field-hint">skip signal if RR below this</span></label>
                    <input class="st-input" type="number" step="0.1" min="0.5" max="3.0"
                           value="@GetDecimal("AdaptiveEngine:ControlledTrend:MinRR", 1.2m)"
                           @onchange="OnCtMinRrChanged" />
                </div>
                <div class="st-field">
                    <label>Min Slope (strong) <span class="st-field-hint">minimum trend slope to qualify</span></label>
                    <input class="st-input" type="number" step="0.001" min="0.001" max="0.05"
                           value="@GetDecimal("AdaptiveEngine:ControlledTrend:MinSlopeStrong", 0.003m)"
                           @onchange="OnCtMinSlopeChanged" />
                </div>
            </div>
        </div>

    </div>;

    private Task OnEmaPeriodChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:EmaPeriod", ParseIntOr(e.Value, 21));
    private Task OnEmaZoneAtrMultiplierChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:ZoneAtrMultiplier", ParseDecimalOr(e.Value, 0.5m));
    private Task OnVwapConfirmationToggle(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:VwapConfirmationEnabled", (bool)(e.Value ?? false));
    private Task OnVwapPeriodChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:VwapPeriod", ParseIntOr(e.Value, 20));
    private Task OnHtfConfirmationToggle(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:HtfConfirmationEnabled", (bool)(e.Value ?? false));
    private Task OnHtfTimeframeChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:HtfConfirmationTimeframe", e.Value?.ToString() ?? "4h");

    private static readonly (string Key, string Label)[] TradingProfiles =
    {
        ("Trading", "Default (all other symbols)"),
        ("Trading:BTC", "BTCUSDT"),
        ("Trading:ETH", "ETHUSDT"),
    };

    private RenderFragment RiskTab() => @<div class="st-grid">

        @foreach (var profile in TradingProfiles)
        {
            var profileKey = profile.Key;
            <div class="st-card">
                <div class="st-card-head">
                    <div class="st-card-title">@profile.Label</div>
                    <span class="st-live-pill">● live</span>
                </div>

                <div class="st-field">
                    <label>Leverage <span class="st-field-hint">automatically synced to the exchange's real per-symbol max before every order</span></label>
                    <input title="Leverage automatically synced to the exchange's real per-symbol max before every order" class="st-input" type="number" value="@GetInt($"{profileKey}:Leverage", 10)"
                           @onchange="@((ChangeEventArgs e) => OnLeverageChanged(profileKey, e))" />
                </div>

                <div class="st-field">
                    <label>Risk Per Trade (fraction of balance, e.g. 0.03 = 3%)</label>
                    <input title="Risk Per Trade (fraction of balance, e.g. 0.03 = 3%)" class="st-input" type="number" step="0.001" value="@GetDecimal($"{profileKey}:RiskPerTrade", 0.03m)"
                           @onchange="@((ChangeEventArgs e) => OnRiskPerTradeChanged(profileKey, e))" />
                </div>

                <div class="st-field-row">
                    <div class="st-field">
                        <label>Min Notional ($)</label>
                        <input title="Min Notional ($)" class="st-input" type="number" value="@GetDecimal($"{profileKey}:MinNotional", 10m)"
                               @onchange="@((ChangeEventArgs e) => OnMinNotionalChanged(profileKey, e))" />
                    </div>
                    <div class="st-field">
                        <label>Cooldown (seconds)</label>
                        <input title="Cooldown (seconds)" class="st-input" type="number" value="@GetInt($"{profileKey}:CooldownSeconds", 90)"
                               @onchange="@((ChangeEventArgs e) => OnCooldownSecondsChanged(profileKey, e))" />
                    </div>
                </div>

                <div class="st-field">
                    <label>Max Margin Per Trade <span class="st-field-hint">fraction of balance (0.12 = 12%)</span></label>
                    <input title="Max margin fraction of balance per single position" class="st-input" type="number" step="0.01" min="0.01" max="0.50"
                           value="@GetDecimal($"{profileKey}:MaxMarginPercent", 0.12m)"
                           @onchange="@((ChangeEventArgs e) => OnMaxMarginPercentChanged(profileKey, e))" />
                </div>
            </div>
        }

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">🤖 AI Signal Confidence Thresholds</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">
                Minimum AI confidence score (0–1) required for a signal to pass the AI confirmation gate (step 3 of the signal pipeline).
                Lower = more signals pass, higher = fewer but higher-quality signals.
                <strong>Default 0.40</strong> was lowered from 0.52 which was blocking too many trades.
                BTC/ETH use separate lower thresholds because the AI is better calibrated for them.
            </div>
            <!-- MinEntry row -->
            <div class="st-field-row">
                <div class="st-field">
                    <label>Min Entry — Default</label>
                    <input title="Min AI confidence for all symbols except BTC/ETH" class="st-input" type="number"
                           step="0.01" min="0.10" max="0.95"
                           value="@GetDecimal("SignalConfidence:Default:MinEntry", 0.46m)"
                           @onchange="OnConfDefaultChanged" />
                </div>
                <div class="st-field">
                    <label>Min Entry — BTC</label>
                    <input title="Min AI confidence for BTC" class="st-input" type="number"
                           step="0.01" min="0.10" max="0.95"
                           value="@GetDecimal("SignalConfidence:BTC:MinEntry", 0.40m)"
                           @onchange="OnConfBtcChanged" />
                </div>
                <div class="st-field">
                    <label>Min Entry — ETH</label>
                    <input title="Min AI confidence for ETH" class="st-input" type="number"
                           step="0.01" min="0.10" max="0.95"
                           value="@GetDecimal("SignalConfidence:ETH:MinEntry", 0.40m)"
                           @onchange="OnConfEthChanged" />
                </div>
            </div>
            <!-- Confidence Bands (Medium / High thresholds) -->
            <div class="st-card-sub" style="margin-top:12px;font-size:11px;">
                <strong>Confidence Bands</strong> — thresholds that unlock higher risk sizing.
                Medium band = confMult 1.15×, High band = confMult 1.28-1.40×.
            </div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Medium Band From — Default</label>
                    <input class="st-input" type="number" step="0.01" min="0.30" max="0.90"
                           value="@GetDecimal("SignalConfidence:Default:Bands:MediumFrom", 0.52m)"
                           @onchange="OnConfDefaultBandMediumChanged" />
                </div>
                <div class="st-field">
                    <label>High Band From — Default</label>
                    <input class="st-input" type="number" step="0.01" min="0.40" max="0.95"
                           value="@GetDecimal("SignalConfidence:Default:Bands:HighFrom", 0.65m)"
                           @onchange="OnConfDefaultBandHighChanged" />
                </div>
                <div class="st-field">
                    <label>Medium Band From — BTC</label>
                    <input class="st-input" type="number" step="0.01" min="0.30" max="0.90"
                           value="@GetDecimal("SignalConfidence:BTC:Bands:MediumFrom", 0.42m)"
                           @onchange="OnConfBtcBandMediumChanged" />
                </div>
                <div class="st-field">
                    <label>High Band From — BTC</label>
                    <input class="st-input" type="number" step="0.01" min="0.30" max="0.90"
                           value="@GetDecimal("SignalConfidence:BTC:Bands:HighFrom", 0.45m)"
                           @onchange="OnConfBtcBandHighChanged" />
                </div>
            </div>
            <!-- Early TP ATR multipliers -->
            <div class="st-card-sub" style="margin-top:12px;font-size:11px;">
                <strong>Early TP ATR Multipliers</strong> — how many ATRs from entry to set TP1 at medium/high confidence.
                Larger = TP further away, smaller = closer (quicker take profit).
            </div>
