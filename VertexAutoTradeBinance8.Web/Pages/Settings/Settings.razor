            "Real-account and Demo-account DCA run independently with separate histories, even though they share the schedule/symbol settings above.",
            "DCA на реальном и демо-счёте работают независимо, с раздельной историей, хотя используют общие настройки расписания и монет выше."),
        ["dca.history.real"] = ("Real account", "Реальный счёт"),
        ["dca.history.demo"] = ("Demo account", "Демо-счёт"),
        ["dca.history.none"] = ("No purchases yet", "Покупок пока нет"),
    };

    string _dcaNewWeight = "1";

    private Task OnDcaEnabledToggle(ChangeEventArgs e) => SetAsync("Dca:Enabled", (e.Value as bool?) ?? false);
    private Task OnDcaFrequencyChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:Frequency", e.Value?.ToString() ?? "Weekly");
    private Task OnDcaDayOfWeekChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:DayOfWeek", ParseIntOr(e.Value, 1));
    private Task OnDcaDayOfMonthChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:DayOfMonth", ParseIntOr(e.Value, 1));
    private Task OnDcaHourChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:HourUtc", ParseIntOr(e.Value, 12));
    private Task OnDcaBudgetChanged(ChangeEventArgs e) => SetAsync("Dca:Schedule:BudgetPerCycle", ParseDecimalOr(e.Value, 100m));
    private Task OnDcaDipBonusToggle(ChangeEventArgs e) => SetAsync("Dca:DipBonus:Enabled", (e.Value as bool?) ?? false);
    private Task OnDcaDipLookbackChanged(ChangeEventArgs e) => SetAsync("Dca:DipBonus:LookbackHours", ParseIntOr(e.Value, 24));
    private Task OnDcaDipThresholdChanged(ChangeEventArgs e) => SetAsync("Dca:DipBonus:DropThresholdPct", ParseDecimalOr(e.Value, 10m));
    private Task OnDcaDipMultiplierChanged(ChangeEventArgs e) => SetAsync("Dca:DipBonus:Multiplier", ParseDecimalOr(e.Value, 2m));

    private Task OnDcaEqualAllocationToggle(ChangeEventArgs e)
    {
        bool isEqual = (e.Value as bool?) ?? false;
        return SetAsync("Dca:AllocationMode", isEqual ? "Equal" : "Weighted");
    }

    private async Task OnDcaSymbolWeightChanged(string symbol, ChangeEventArgs e)
    {
        decimal newWeight = ParseDecimalOr(e.Value, 1m) ?? 1m;
        var symbols = GetDcaSymbols();
        await SaveDcaSymbolsAsync(symbols.Select(s => s.Symbol == symbol ? (s.Symbol, newWeight) : s).ToList());
    }

    private async Task RemoveDcaSymbol(string symbol)
    {
        var symbols = GetDcaSymbols().Where(s => s.Symbol != symbol).ToList();
        await SaveDcaSymbolsAsync(symbols);
    }

    private async Task AddDcaSymbol()
    {
        var sym = _dcaNewSymbol.Trim().ToUpperInvariant();
        if (sym == "") { ShowToast("Enter a symbol first", isError: true); return; }
        if (!sym.EndsWith("USDT")) sym += "USDT";
        decimal weight = ParseDecimalOr(_dcaNewWeight, 1m) ?? 1m;

        var symbols = GetDcaSymbols();
        if (symbols.Any(s => s.Symbol == sym)) { ShowToast($"{sym} is already in the list", isError: true); return; }

        symbols.Add((sym, weight));
        await SaveDcaSymbolsAsync(symbols);
        _dcaNewSymbol = "";
        _dcaNewWeight = "1";
    }

    private async Task SaveDcaSymbolsAsync(List<(string Symbol, decimal Weight)> symbols)
    {
        var arr = new JsonArray();
        foreach (var (sym, weight) in symbols)
        {
            arr.Add(new JsonObject { ["Symbol"] = sym, ["Weight"] = weight });
        }
        await SetJsonAsync("Dca:Symbols", arr);
    }

    private static int? ParseIntOr(object? raw, int fallback)
        => int.TryParse(raw?.ToString(), out var v) ? v : fallback;

    private static decimal? ParseDecimalOr(object? raw, decimal fallback)
        => decimal.TryParse(raw?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private async Task SetStrategyMode(string mode)
    {
        _strategyMode = mode;
        try
        {
            await StrategyModeSvc.SetModeAsync(mode);
            ShowToast($"Strategy mode → {mode}");
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to set mode: {ex.Message}", isError: true);
        }
    }
    private bool _loading = true;
    private JsonObject _effective = new();

    private string _saveToast = "";
    private bool _saveToastIsError;
    private System.Threading.Timer? _toastTimer;

    protected override async Task OnInitializedAsync()
    {
        _demoResetBalance = DemoAccount.GetSnapshot().InitialBalance;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _effective = await Cfg.GetEffectiveConfigAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to load config: {ex.Message}", isError: true);
            _effective = new JsonObject();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        _saveToast = message;
        _saveToastIsError = isError;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _saveToast = "";
            InvokeAsync(StateHasChanged);
        }, null, 3500, System.Threading.Timeout.Infinite);
        StateHasChanged();
    }

    // ── Generic helpers for reading/writing a config path ───────
    private string GetStr(string path, string fallback = "")
    {
        var node = GetNode(path);
        return node?.GetValue<string>() ?? fallback;
    }

    private decimal GetDecimal(string path, decimal fallback = 0)
    {
        var node = GetNode(path);
        if (node == null) return fallback;
        try { return node.GetValue<decimal>(); } catch { return fallback; }
    }

    private int GetInt(string path, int fallback = 0)
    {
        var node = GetNode(path);
        if (node == null) return fallback;
        try { return node.GetValue<int>(); } catch { return fallback; }
    }

    private bool GetBool(string path, bool fallback = false)
    {
        var node = GetNode(path);
        if (node == null) return fallback;
        try { return node.GetValue<bool>(); } catch { return fallback; }
    }

    private List<string> GetStrList(string path)
    {
        var node = GetNode(path);
        if (node is not JsonArray arr) return new();
        return arr.Select(n => n?.GetValue<string>() ?? "").Where(s => s != "").ToList();
    }

    private string GetString(string path, string fallback = "")
    {
        var node = GetNode(path);
        if (node == null) return fallback;
        try { return node.GetValue<string>() ?? fallback; } catch { return fallback; }
    }

    // DCA's Symbols list is an array of {Symbol, Weight} objects, not
    // plain strings — GetStrList doesn't fit, needs its own reader.
    private List<(string Symbol, decimal Weight)> GetDcaSymbols()
    {
        var node = GetNode("Dca:Symbols");
        if (node is not JsonArray arr) return new();
        var result = new List<(string, decimal)>();
        foreach (var item in arr)
        {
            if (item is not JsonObject obj) continue;
            var sym = obj["Symbol"]?.GetValue<string>() ?? "";
            decimal weight = 1m;
            try { weight = obj["Weight"]?.GetValue<decimal>() ?? 1m; } catch { }
            if (sym != "") result.Add((sym, weight));
        }
        return result;
    }

    private JsonNode? GetNode(string path)
    {
        var segments = path.Split(':', StringSplitOptions.RemoveEmptyEntries);
        JsonNode? current = _effective;
        foreach (var seg in segments)
        {
            if (current is not JsonObject obj) return null;
            current = obj[seg];
        }
        return current;
    }

    private async Task SetAsync(string path, object? value)
    {
        try
        {
            await Cfg.SetValueAsync(path, value);
            // optimistic local update so the UI reflects the change
            // immediately without waiting for a full reload
            SetLocalNode(path, value);
            ShowToast($"Saved — applies within a few seconds");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", isError: true);
        }
    }

    // CRITICAL: separate from SetAsync above on purpose — that method's
    // parameter is statically typed object?, so passing a JsonArray/
    // JsonObject through it resolves to SetValueAsync's SCALAR overload
    // at compile time (which stringifies anything it doesn't recognize
    // via .ToString(), silently corrupting structured data like the DCA
    // symbols array into a single garbled string). This calls the
    // JsonNode? overload explicitly instead.
    private async Task SetJsonAsync(string path, JsonNode? value)
    {
        try
        {
            await Cfg.SetValueAsync(path, value);
            SetLocalNode(path, value);
            ShowToast($"Saved — applies within a few seconds");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", isError: true);
        }
    }

    private async Task SetListAsync(string path, List<string> items)
    {
        try
        {
            await Cfg.SetArrayAsync(path, items);
            await ReloadAsync();
            ShowToast("Saved — applies within a few seconds");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", isError: true);
        }
    }

    private void SetLocalNode(string path, object? value)
    {
        var segments = path.Split(':', StringSplitOptions.RemoveEmptyEntries);
        JsonObject current = _effective;
        for (int i = 0; i < segments.Length - 1; i++)
        {
            if (current[segments[i]] is not JsonObject child)
            {
                child = new JsonObject();
                current[segments[i]] = child;
            }
            current = child;
        }

        JsonNode? node = value switch
        {
            null => null,
            JsonNode existing => existing,
            bool b => JsonValue.Create(b),
            int i => JsonValue.Create(i),
            decimal d => JsonValue.Create(d),
            string s => JsonValue.Create(s),
            _ => JsonValue.Create(value.ToString())
        };
        current[segments[^1]] = node;
    }
}

