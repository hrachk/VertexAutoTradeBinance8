                <input class="st-input" placeholder="e.g. BTCUSDT" value="@_newStrongTrendInput"
                       @onchange="OnNewStrongTrendInputChanged" />
                <button class="st-btn-add" @onclick="AddStrongTrendAsset">+ Add</button>
            </div>
        </div>

    </div>;

    private async Task AddPinnedSymbol()
    {
        var sym = _newSymbolInput.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(sym)) return;

        var list = GetStrList("SymbolSelection:Pinned");
        if (!list.Contains(sym))
        {
            list.Add(sym);
            await SetListAsync("SymbolSelection:Pinned", list);
        }
        _newSymbolInput = "";
    }

    private async Task RemovePinnedSymbol(string sym)
    {
        var list = GetStrList("SymbolSelection:Pinned");
        list.Remove(sym);
        await SetListAsync("SymbolSelection:Pinned", list);
    }

    private async Task AddToxicSymbol()
    {
        var sym = _newToxicSymbolInput.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(sym)) return;
        if (!sym.EndsWith("USDT")) sym += "USDT";
        var list = GetStrList("TradingSettings:ToxicSymbols");
        if (!list.Contains(sym)) { list.Add(sym); await SetListAsync("TradingSettings:ToxicSymbols", list); }
        _newToxicSymbolInput = "";
    }

    private async Task RemoveToxicSymbol(string sym)
    {
        var list = GetStrList("TradingSettings:ToxicSymbols");
        list.Remove(sym);
        await SetListAsync("TradingSettings:ToxicSymbols", list);
    }

    private async Task AddStrongTrendAsset()
    {
        var sym = _newStrongTrendInput.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(sym)) return;
        if (!sym.EndsWith("USDT")) sym += "USDT";
        var list = GetStrList("StrongTrendAssets");
        if (!list.Contains(sym)) { list.Add(sym); await SetListAsync("StrongTrendAssets", list); }
        _newStrongTrendInput = "";
    }

    private async Task RemoveStrongTrendAsset(string sym)
    {
        var list = GetStrList("StrongTrendAssets");
        list.Remove(sym);
        await SetListAsync("StrongTrendAssets", list);
    }

