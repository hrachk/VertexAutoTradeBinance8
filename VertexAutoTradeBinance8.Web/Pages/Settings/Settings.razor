@page "/settings"
@using System.Text.Json.Nodes
@using VertexAutoTradeBinance8.Web.Services
@inject RuntimeConfigService Cfg
@inject StrategyModeFileService StrategyModeSvc
@inject IJSRuntime JS
@inject VertexAutoTradeBinance8.Web.Services.HistoricalDataReaderService DataArchive

<PageTitle>Settings — Vertex AI</PageTitle>

<div class="st">

    <!-- ══ HEADER ══════════════════════════════════════════════ -->
    <div class="st-header">
        <div class="st-header-left">
            <div class="st-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="st-gear">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                </svg>
            </div>
            <div>
                <div class="st-title">Settings</div>
                <div class="st-subtitle">Live engine configuration — changes apply within seconds, no restart</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_saveToast))
        {
            <div class="st-toast @(_saveToastIsError ? "st-toast-err" : "")">
                <span class="st-toast-dot"></span>@_saveToast
            </div>
        }
    </div>

    <!-- ══ TABS ════════════════════════════════════════════════ -->
    <div class="st-tabs">
        @foreach (var tab in _tabs)
        {
            <button class="st-tab @(_activeTab == tab.Id ? "st-tab-on" : "")" @onclick="() => _activeTab = tab.Id">
                <span class="st-tab-icon">@tab.Icon</span>
                @tab.Label
                @if (tab.LiveBadge)
                {
                    <span class="st-tab-live">●</span>
                }
            </button>
        }
    </div>

    <div class="st-body">

        @if (_loading)
        {
            <div class="st-loading">
                <div class="st-spin"></div>
                Loading current configuration…
            </div>
        }
        else
        {
            @switch (_activeTab)
            {
                case "strategy": { @StrategyTab() break; }
                case "risk":     { @RiskTab() break; }
                case "symbols":  { @SymbolsTab() break; }
                case "meanrev":  { @MeanRevTab() break; }
                case "exits":    { @ExitsTab() break; }
                case "engine":   { @EngineTab() break; }
                case "datadb":   { @DataArchiveTab() break; }
            }
        }

    </div>
</div>

@code {
    private RenderFragment StrategyTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">Strategy Routing Mode</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">Decides whether the trend-following engine, the mean-reversion engine, or both (regime-based) generate trade signals.</div>

            <div class="st-mode-grid">
                @foreach (var (val, label, desc) in new[]
                {
                    ("Auto", "Auto (Regime-based)", "Trend engine fires in Trend/StrongTrend regimes, Mean-Reversion fires in Range/Squeeze. Recommended default."),
                    ("TrendOnly", "Trend Only", "Only the original trend-following engine runs. Mean-Reversion is fully disabled — identical to pre-v9 behavior."),
                    ("MeanReversionOnly", "Mean-Reversion Only", "Only the Z-Score mean-reversion engine runs, regardless of detected regime.")
                })
                {
                    <div class="st-mode-option @(_strategyMode == val ? "st-mode-on" : "")" @onclick="() => SetStrategyMode(val)">
                        <div class="st-mode-radio">@(_strategyMode == val ? "●" : "○")</div>
                        <div>
                            <div class="st-mode-label">@label</div>
                            <div class="st-mode-desc">@desc</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Pullback Entry</div></div>
            <div class="st-card-sub">Powers the trend engine's TryPullbackEma21 entry: waits for price to touch the EMA after a clear trend move, then enters on a rejection candle bouncing off it. Live-reloadable — no restart needed.</div>
            <div class="st-field">
                <label>EMA Period</label>
                <input title="EMA Period" class="st-input" type="number" min="5" max="100" value="@GetInt("Strategy:PullbackEntry:EmaPeriod",21)"
                       @onchange="OnEmaPeriodChanged" />
            </div>
            <div class="st-field">
                <label>Touch Zone (× ATR)</label>
                <input title="Touch Zone (ATR multiplier)" class="st-input" type="number" step="0.05" min="0.1" max="2" value="@GetDecimal("Strategy:PullbackEntry:ZoneAtrMultiplier",0.5m)"
                       @onchange="OnEmaZoneAtrMultiplierChanged" />
                <div class="st-card-sub" style="margin-top:4px">How close price must come to the EMA to count as a "touch" — expressed as a multiple of ATR (volatility-normalized, not a fixed %), so it scales correctly across symbols.</div>
            </div>

            <div class="st-toggle-row" style="margin-top:14px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Strategy:PullbackEntry:VwapConfirmationEnabled", false)" @onchange="OnVwapConfirmationToggle" />
                    <span>Require VWAP confirmation</span>
                </label>
                <div class="st-card-sub" style="margin-top:4px">Only accept a signal if price is on the expected side of the rolling-window VWAP (above it for longs, below for shorts) — an extra directional check on top of the existing EMA logic. Off by default.</div>
            </div>
            @if (GetBool("Strategy:PullbackEntry:VwapConfirmationEnabled", false))
            {
                <div class="st-field">
                    <label>VWAP Period (bars)</label>
                    <input title="VWAP rolling window (bars)" class="st-input" type="number" min="5" max="200" value="@GetInt("Strategy:PullbackEntry:VwapPeriod",20)"
                           @onchange="OnVwapPeriodChanged" />
                </div>
            }

            <div class="st-toggle-row" style="margin-top:10px">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("Strategy:PullbackEntry:HtfConfirmationEnabled", false)" @onchange="OnHtfConfirmationToggle" />
                    <span>Require higher-timeframe structure confirmation</span>
                </label>
                <div class="st-card-sub" style="margin-top:4px">Only accept a signal if the SAME symbol's EMA21/EMA55 relationship on a higher timeframe agrees with the signal's direction. Off by default.</div>
            </div>
            @if (GetBool("Strategy:PullbackEntry:HtfConfirmationEnabled", false))
            {
                <div class="st-field">
                    <label>Confirmation Timeframe</label>
                    <select title="Higher timeframe to confirm against" class="st-select" value="@GetStr("Strategy:PullbackEntry:HtfConfirmationTimeframe","4h")"
                            @onchange="OnHtfTimeframeChanged">
                        <option value="15m">15m</option>
                        <option value="30m">30m</option>
                        <option value="1h">1h</option>
                        <option value="4h">4h</option>
                        <option value="1d">1d</option>
                    </select>
                </div>
            }
        </div>

    </div>;

    private Task OnEmaPeriodChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:EmaPeriod", ParseIntOr(e.Value, 21));
    private Task OnEmaZoneAtrMultiplierChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:ZoneAtrMultiplier", ParseDecimalOr(e.Value, 0.5m));
    private Task OnVwapConfirmationToggle(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:VwapConfirmationEnabled", (bool)(e.Value ?? false));
    private Task OnVwapPeriodChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:VwapPeriod", ParseIntOr(e.Value, 20));
    private Task OnHtfConfirmationToggle(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:HtfConfirmationEnabled", (bool)(e.Value ?? false));
    private Task OnHtfTimeframeChanged(ChangeEventArgs e) => SetAsync("Strategy:PullbackEntry:HtfConfirmationTimeframe", e.Value?.ToString() ?? "4h");

    private static readonly (string Key, string Label)[] TradingProfiles =
    {
        ("Trading", "Default (all other symbols)"),
        ("Trading:BTC", "BTCUSDT"),
        ("Trading:ETH", "ETHUSDT"),
    };

    private RenderFragment RiskTab() => @<div class="st-grid">

        @foreach (var profile in TradingProfiles)
        {
            var profileKey = profile.Key;
            <div class="st-card">
                <div class="st-card-head">
                    <div class="st-card-title">@profile.Label</div>
                    <span class="st-live-pill">● live</span>
                </div>

                <div class="st-field">
                    <label>Leverage <span class="st-field-hint">automatically synced to the exchange's real per-symbol max before every order</span></label>
                    <input title="Leverage automatically synced to the exchange's real per-symbol max before every order" class="st-input" type="number" value="@GetInt($"{profileKey}:Leverage", 10)"
                           @onchange="@((ChangeEventArgs e) => OnLeverageChanged(profileKey, e))" />
                </div>

                <div class="st-field">
                    <label>Risk Per Trade (fraction of balance, e.g. 0.03 = 3%)</label>
                    <input title="Risk Per Trade (fraction of balance, e.g. 0.03 = 3%)" class="st-input" type="number" step="0.001" value="@GetDecimal($"{profileKey}:RiskPerTrade", 0.03m)"
                           @onchange="@((ChangeEventArgs e) => OnRiskPerTradeChanged(profileKey, e))" />
                </div>

                <div class="st-field-row">
                    <div class="st-field">
                        <label>Min Notional ($)</label>
                        <input title="Min Notional ($)" class="st-input" type="number" value="@GetDecimal($"{profileKey}:MinNotional", 10m)"
                               @onchange="@((ChangeEventArgs e) => OnMinNotionalChanged(profileKey, e))" />
                    </div>
                    <div class="st-field">
                        <label>Cooldown (seconds)</label>
                        <input title="Cooldown (seconds)" class="st-input" type="number" value="@GetInt($"{profileKey}:CooldownSeconds", 90)"
                               @onchange="@((ChangeEventArgs e) => OnCooldownSecondsChanged(profileKey, e))" />
                    </div>
                </div>
            </div>
        }

        <div class="st-card st-card-wide st-card-muted">
            <div class="st-card-head"><div class="st-card-title">Base Risk / Notional Guards</div></div>
            <div class="st-card-sub">Safety-net minimums for small balances. Currently set to 0 across all profiles (intentionally disabled per your prior decision).</div>
            <div class="st-field-row">
                <div class="st-field">
                    <label>Base Risk % (Default profile)</label>
                    <input title="Base Risk % (Default profile)" class="st-input" type="number" step="0.001" value="@GetDecimal("Trading:BaseRiskPercent", 0m)"
                           @onchange="OnBaseRiskPercentChanged" />
                </div>
                <div class="st-field">
                    <label>Min Notional Guard %</label>
                    <input title="Min Notional Guard %" class="st-input" type="number" step="0.001" value="@GetDecimal("Trading:MinNotionalGuardPercent", 0m)"
                           @onchange="OnMinNotionalGuardPercentChanged" />
                </div>
            </div>
        </div>

    </div>;

    private Task OnLeverageChanged(string profileKey, ChangeEventArgs e) => SetAsync($"{profileKey}:Leverage", ParseIntOr(e.Value, 10));
    private Task OnRiskPerTradeChanged(string profileKey, ChangeEventArgs e) => SetAsync($"{profileKey}:RiskPerTrade", ParseDecimalOr(e.Value, 0.03m));
    private Task OnMinNotionalChanged(string profileKey, ChangeEventArgs e) => SetAsync($"{profileKey}:MinNotional", ParseDecimalOr(e.Value, 10m));
    private Task OnCooldownSecondsChanged(string profileKey, ChangeEventArgs e) => SetAsync($"{profileKey}:CooldownSeconds", ParseIntOr(e.Value, 90));

    private Task OnBaseRiskPercentChanged(ChangeEventArgs e) => SetAsync("Trading:BaseRiskPercent", ParseDecimalOr(e.Value, 0m));
    private Task OnMinNotionalGuardPercentChanged(ChangeEventArgs e) => SetAsync("Trading:MinNotionalGuardPercent", ParseDecimalOr(e.Value, 0m));

    private RenderFragment MeanRevTab() => @<div class="st-grid">

        <div class="st-card st-card-wide">
            <div class="st-card-head">
                <div class="st-card-title">Entry Trigger</div>
                <span class="st-live-pill">● live</span>
            </div>
            <div class="st-card-sub">Z-Score is computed over a rolling window of closes — entry fires when price deviates this many standard deviations from the mean.</div>

            <div class="st-field-row">
                <div class="st-field">
                    <label>Rolling Window (bars)</label>
                    <input title="Rolling Window (bars)" class="st-input" type="number" value="@GetInt("MeanReversion:Window", 20)" @onchange="OnMrWindowChanged" />
                </div>
                <div class="st-field">
                    <label>Entry Sigma (|Z| threshold)</label>
                    <input title="Entry Sigma (|Z| threshold)" class="st-input" type="number" step="0.1" value="@GetDecimal("MeanReversion:EntrySigma", 2.0m)" @onchange="OnMrEntrySigmaChanged" />
                </div>
                <div class="st-field">
                    <label>Timeframe</label>
                    <select title="Timeframe" class="st-select" value="@GetStr("MeanReversion:Timeframe","FifteenMinutes")" @onchange="OnMrTimeframeChanged">
                        <option value="FiveMinutes">5m</option>
                        <option value="FifteenMinutes">15m</option>
                        <option value="ThirtyMinutes">30m</option>
                        <option value="OneHour">1h</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Volume Confirmation</div></div>
            <div class="st-card-sub">Filters out low-liquidity noise spikes.</div>
            <div class="st-field">
                <label>Volume Avg Period (bars)</label>
                <input title="Volume Avg Period (bars)" class="st-input" type="number" value="@GetInt("MeanReversion:VolumeAvgPeriod", 50)" @onchange="OnMrVolAvgChanged" />
            </div>
            <div class="st-field">
                <label>Surge Multiplier (× average)</label>
                <input title="Surge Multiplier (× average)" class="st-input" type="number" step="0.1" value="@GetDecimal("MeanReversion:VolumeSurgeMultiplier", 1.5m)" @onchange="OnMrVolMultChanged" />
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-head"><div class="st-card-title">Reversal & Regime Guards</div></div>
            <div class="st-toggle-row">
                <label class="st-toggle">
                    <input type="checkbox" checked="@GetBool("MeanReversion:RequireReversalConfirmation", true)" @onchange="OnMrReversalToggle" />
                    <span>Require reversal confirmation</span>
                </label>
            </div>
            <div class="st-field">
                <label>Reversal Lookback (bars)</label>
                <input title="Require reversal confirmation
                
            
            
                Reversal Lookback (bars)" class="st-input" type="number" value="@GetInt("MeanReversion:ReversalLookback", 5)" @onchange="OnMrReversalLookbackChanged" />
            </div>
            <div class="st-toggle-row">
                <label class="st-toggle">
