                <input title="Stop ATR Padding" class="st-input" type="number" step="0.05" value="@GetDecimal("MeanReversion:StopAtrPad", 0.3m)" @onchange="OnMrStopAtrPadChanged" />
            </div>
            <div class="st-field">
