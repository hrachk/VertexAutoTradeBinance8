                    <span>Skip if BTC itself is at a matching extreme</span>
                </label>
            </div>
            <div class="st-field">
                <label>Correlation Threshold</label>
                <input title="Only trade in Range/Squeeze regime
                
            
        

        
            BTC Correlation Guard
            
                
                    
                    Skip if BTC itself is at a matching extreme
                
            
            
                Correlation Threshold" class="st-input" type="number" step="0.05" value="@GetDecimal("MeanReversion:BtcCorrelationThreshold", 0.6m)" @onchange="OnMrBtcThresholdChanged" />
