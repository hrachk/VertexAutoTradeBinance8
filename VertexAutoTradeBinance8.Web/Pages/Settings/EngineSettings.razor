@page "/settings/engine"
@inject ConfigEditorService ConfigSvc

<h3>Engine Configuration</h3>

<EditForm Model="_cfg" OnValidSubmit="Save">
    <DataAnnotationsValidator />

    <fieldset>
        <legend>HedgeKill</legend>

        <label>Mode</label>
        <InputSelect @bind-Value="_cfg.HedgeKill.Mode">
            <option value="Safe">Safe</option>
            <option value="Hybrid">Hybrid</option>
            <option value="Aggressive">Aggressive</option>
        </InputSelect>

        <label>Use Cooldown</label>
        <InputCheckbox @bind-Value="_cfg.HedgeKill.UseCooldown" />

        <label>Cooldown (min)</label>
        <InputNumber @bind-Value="_cfg.HedgeKill.CooldownMinutes" />

        <label>Giveback Bucket (Low)</label>
        <InputNumber step="0.01" @bind-Value="_cfg.HedgeKill.GivebackBucketLow" />

        <label>Giveback Bucket (Mid)</label>
        <InputNumber step="0.01" @bind-Value="_cfg.HedgeKill.GivebackBucketMid" />

        <label>Giveback Bucket (High)</label>
        <InputNumber step="0.01" @bind-Value="_cfg.HedgeKill.GivebackBucketHigh" />
    </fieldset>

    <button class="btn btn-primary">Save & Apply</button>
</EditForm>

@code {
    private EngineConfigRoot _cfg = new();

    protected override void OnInitialized()
    {
        _cfg = ConfigSvc.Load();
    }

    void Save()
    {
        ConfigSvc.Save(_cfg);
    }
}
