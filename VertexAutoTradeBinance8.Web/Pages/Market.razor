@page "/market"
@using System.Net.Http.Json
@using System.Globalization
@using System.Text.Json.Serialization
@using VertexAutoTradeBinance8.Web.Services
@inject HttpClient Http
@inject EngineStateService EngineService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="vt-page-title" style="margin-bottom:10px;">
    <div>
        <h1>Market</h1>
        <p>Bybit-style · live Binance Futures · chart · real positions · manual orders</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <span class="mk-badge-live">LIVE</span>
        <button class="vt-btn" @onclick="RefreshAllAsync" disabled="@_busy">↻</button>
    </div>
</div>

<div class="mk-shell">
    <!-- SYMBOLS -->
    <aside class="mk-left">
        <div class="mk-search">
            <input placeholder="Search symbol…" @bind="_search" @bind:event="oninput" />
        </div>
        <div class="mk-tabs-mini">
            <button class="@(_listTab=="hot"?"active":"")" @onclick='() => _listTab="hot"'>🔥 Hot</button>
            <button class="@(_listTab=="up"?"active":"")" @onclick='() => _listTab="up"'>Gainers</button>
            <button class="@(_listTab=="dn"?"active":"")" @onclick='() => _listTab="dn"'>Losers</button>
        </div>
        <div class="mk-sym-list">
            @foreach (var s in FilteredSymbols)
            {
                <div class="mk-sym @(s.Symbol==_symbol?"active":"")" @onclick="() => SelectSymbolAsync(s.Symbol)">
                    <div class="mk-sym-name">@s.Symbol.Replace("USDT","")</div>
                    <div>
                        <div class="mk-sym-px">@FmtPx(s.Price)</div>
                        <div class="mk-sym-chg @(s.ChangePct>=0?"mk-up":"mk-dn")">
                            @(s.ChangePct>=0?"+":"")@s.ChangePct.ToString("0.0")%
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mk-signals">
            <div class="mk-signals-title">
                <span>Setup hints</span>
                <span style="color:var(--vt-green)">@_signals.Count</span>
            </div>
            @foreach (var sig in _signals)
            {
                <div class="mk-sig" @onclick="() => ApplySignalHintAsync(sig)">
                    <div class="mk-sig-top">
                        <span class="@(sig.Side=="LONG"?"mk-sig-side-long":"mk-sig-side-short")">▲ @sig.Side</span>
                        <span>@sig.Symbol</span>
                    </div>
                    <div class="mk-sig-meta">conf @sig.Confidence% · @sig.Reason</div>
                    <div class="mk-sig-meta">E @FmtPx(sig.Entry) · SL @FmtPx(sig.Sl) · TP @FmtPx(sig.Tp)</div>
                </div>
            }
            @if (_signals.Count == 0)
            {
                <div class="vt-hint" style="font-size:11px;">Нет подсказок — клик по символу загрузит цену</div>
            }
        </div>
    </aside>

    <!-- CHART (center) -->
    <section class="mk-center">
        <div class="mk-chart-bar">
            <span class="mk-chart-sym">@_symbol</span>
            <span class="mk-chart-px @(_changePct>=0?"mk-up":"mk-dn")">@FmtPx(_lastPrice)</span>
            <span class="@(_changePct>=0?"mk-up":"mk-dn")" style="font-family:var(--vt-mono);font-size:12px;">
                @(_changePct>=0?"+":"")@_changePct.ToString("0.00")%
            </span>
            <div class="mk-tf">
                @foreach (var tf in _tfs)
                {
                    <button class="@(_interval==tf?"active":"")" @onclick="() => SetIntervalAsync(tf)">@tf</button>
                }
            </div>
        </div>
        <div class="mk-chart-host">
            <div id="mkChart"></div>
        </div>
        <div class="mk-bal-row">
            <div class="mk-bal-item"><div class="l">Available</div><div class="v">$@_available.ToString("0.00")</div></div>
            <div class="mk-bal-item"><div class="l">Wallet</div><div class="v">$@_wallet.ToString("0.00")</div></div>
            <div class="mk-bal-item"><div class="l">Unrealized</div><div class="v @(_unrealized>=0?"mk-up":"mk-dn")">@(_unrealized>=0?"+":"")@_unrealized.ToString("0.00")</div></div>
            <div class="mk-bal-item"><div class="l">Positions</div><div class="v">@_positions.Count</div></div>
            <div class="mk-bal-item"><div class="l">Regime</div><div class="v" style="font-size:11px;">@_regime</div></div>
        </div>
    </section>

    <!-- TRADE (right) -->
    <aside class="mk-right">
        <div class="mk-panel">
            <div class="mk-panel-title">
                <span>@_symbol</span>
                <span class="vt-hint" style="font-weight:400;">Manual</span>
            </div>

            <div class="mk-real-toggle">
                <input type="checkbox" id="realOrd" @bind="_realOrders" />
                <label for="realOrd">Реальные ордера на Binance</label>
            </div>

            <div class="mk-order-types">
                <button class="@(_orderType=="Market"?"active":"")" @onclick='() => _orderType="Market"'>Market</button>
                <button class="@(_orderType=="Limit"?"active":"")" @onclick='() => _orderType="Limit"'>Limit</button>
                <button class="@(_orderType=="Stop"?"active":"")" @onclick='() => _orderType="Stop"'>Stop</button>
            </div>

            <div class="mk-field">
                <label>Leverage · @_leverage×</label>
                <input type="range" min="1" max="50" @bind="_leverage" @bind:event="oninput" style="width:100%;accent-color:#f0b90b;" />
                <div class="mk-lev-row">
                    @foreach (var l in new[]{1,5,10,20,30,50})
                    {
                        <button class="@(_leverage==l?"active":"")" @onclick="() => _leverage=l">@l×</button>
                    }
                </div>
            </div>

            <div class="mk-field">
                <label>Quantity · ≈ @Notional.ToString("0.00") USDT · margin ≈ @MarginNeed.ToString("0.00")</label>
                <input type="number" step="any" @bind="_qty" />
                <div class="mk-qty-pct">
                    <button @onclick="() => SetQtyPct(0.25m)">25%</button>
                    <button @onclick="() => SetQtyPct(0.50m)">50%</button>
                    <button @onclick="() => SetQtyPct(0.75m)">75%</button>
                    <button @onclick="() => SetQtyPct(1.00m)">100%</button>
                </div>
            </div>

            @if (_orderType != "Market")
            {
                <div class="mk-field">
                    <label>Price</label>
                    <input type="number" step="any" @bind="_limitPrice" />
                </div>
            }

            <div class="mk-field">
                <label>Stop Loss</label>
                <input type="number" step="any" @bind="_sl" />
            </div>
            <div class="mk-field">
                <label>Take Profit</label>
                <input type="number" step="any" @bind="_tp" />
            </div>

            <div class="mk-side-btns">
                <button class="mk-buy" disabled="@_busy" @onclick="() => PlaceAsync(true)">Buy @(_orderType)</button>
                <button class="mk-sell" disabled="@_busy" @onclick="() => PlaceAsync(false)">Sell @(_orderType)</button>
            </div>

            @if (!string.IsNullOrEmpty(_actionMsg))
            {
                <div class="@(_actionOk?"mk-ok":"mk-err")">@_actionMsg</div>
            }

            <div class="mk-hint-box">
                <strong>Как это работает</strong><br/>
                График и цены — live Futures Binance.<br/>
                Баланс и позиции — с твоего аккаунта (ключи бота).<br/>
                Включи «Реальные ордера» → Buy/Sell шлёт market/limit + Algo SL/TP.
            </div>
        </div>

        @if (_selectedPos != null)
        {
            <div class="mk-pos-card">
                <div class="mk-panel-title" style="margin-bottom:8px;">
                    <span>@_selectedPos.Symbol</span>
                    <span class="@(_selectedPos.Side=="LONG"?"mk-sig-side-long":"mk-sig-side-short")">@_selectedPos.Side @_selectedPos.Leverage×</span>
                </div>
                <div class="row"><span class="vt-hint">Entry</span><span class="mono">@FmtPx(_selectedPos.Entry)</span></div>
                <div class="row"><span class="vt-hint">Mark</span><span class="mono">@FmtPx(_selectedPos.Mark)</span></div>
                <div class="row"><span class="vt-hint">Size</span><span class="mono">@_selectedPos.Qty.ToString("0.####")</span></div>
                <div class="row"><span class="vt-hint">PnL</span>
                    <span class="mono @(_selectedPos.Pnl>=0?"mk-up":"mk-dn")">@_selectedPos.Pnl.ToString("+0.00;-0.00")</span>
                </div>
                <button class="mk-close-btn" disabled="@_busy" @onclick="() => CloseAsync(_selectedPos.Symbol)">× Close Position</button>
            </div>
        }
    </aside>

    <!-- POSITIONS BOARD -->
    <div class="mk-bottom">
        <div class="mk-bottom-tabs">
            <button class="@(_bottomTab=="pos"?"active":"")" @onclick='() => _bottomTab="pos"'>Positions @_positions.Count</button>
            <button class="@(_bottomTab=="ord"?"active":"")" @onclick='() => _bottomTab="ord"'>Orders</button>
            <span style="margin-left:auto;padding-right:10px;" class="mk-badge-live">Account</span>
        </div>
        <div class="mk-bottom-body">
            @if (_bottomTab == "pos")
            {
                <table class="vt-table">
                    <thead>
                        <tr>
                            <th>Symbol</th><th>Side</th><th>Lev</th><th>Entry</th><th>Mark</th>
                            <th>Size</th><th>Margin</th><th>PnL</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (_positions.Count == 0)
                    {
                        <tr><td colspan="9" class="vt-hint">Нет открытых позиций на Futures</td></tr>
                    }
                    @foreach (var p in _positions)
                    {
                        <tr style="cursor:pointer;" @onclick="() => OnPosClick(p)">
                            <td><span class="sym">@p.Symbol</span></td>
                            <td class="@(p.Side=="LONG"?"mk-up":"mk-dn")">@p.Side</td>
                            <td class="mono">@p.Leverage×</td>
                            <td class="mono">@FmtPx(p.Entry)</td>
                            <td class="mono">@FmtPx(p.Mark)</td>
                            <td class="mono">@p.Qty.ToString("0.####")</td>
                            <td class="mono">$@p.Margin.ToString("0.00")</td>
                            <td class="mono @(p.Pnl>=0?"mk-up":"mk-dn")">@p.Pnl.ToString("+0.00;-0.00")</td>
                            <td>
                                <div class="mk-pos-actions">
                                    <button @onclick:stopPropagation="true" @onclick="() => CloseAsync(p.Symbol)">Close</button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="vt-hint" style="padding:16px;">Условные SL/TP — Algo orders. Смотри логи worker / Open Orders.</div>
            }
        </div>
    </div>
</div>

@code {
    private string _symbol = "ETHUSDT";
    private string _interval = "15m";
    private readonly string[] _tfs = { "1m","3m","5m","15m","30m","1h","4h","1d" };
    private string _search = "";
    private string _listTab = "hot";
    private string _orderType = "Market";
    private string _bottomTab = "pos";
    private int _leverage = 10;
    private decimal _qty;
    private decimal _limitPrice;
    private decimal _sl;
    private decimal _tp;
    private decimal _lastPrice;
    private decimal _changePct;
    private decimal _available;
    private decimal _wallet;
    private decimal _unrealized;
    private string _regime = "—";
    private string _actionMsg = "";
    private bool _actionOk;
    private bool _busy;
    private bool _realOrders;
    private bool _chartReady;
    private List<SymRow> _symbols = new();
    private List<SignalHint> _signals = new();
    private List<PosDto> _positions = new();
    private PosDto? _selectedPos;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    private IEnumerable<SymRow> FilteredSymbols
    {
        get
        {
            IEnumerable<SymRow> q = _symbols;
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(s => s.Symbol.Contains(_search, StringComparison.OrdinalIgnoreCase));
            q = _listTab switch
            {
                "up" => q.OrderByDescending(s => s.ChangePct),
                "dn" => q.OrderBy(s => s.ChangePct),
                _ => q.OrderByDescending(s => Math.Abs(s.ChangePct))
            };
            return q.Take(50);
        }
    }

    private decimal Notional => _qty * (_lastPrice > 0 ? _lastPrice : 0);
    private decimal MarginNeed => _leverage > 0 ? Notional / _leverage : Notional;

    protected override async Task OnInitializedAsync()
    {
        var st = EngineService.Load();
        if (st != null)
        {
            _regime = st.SmartRegime ?? "—";
            if (!string.IsNullOrWhiteSpace(st.Symbol) && st.Symbol.EndsWith("USDT", StringComparison.OrdinalIgnoreCase))
                _symbol = st.Symbol;
            if (st.Confidence > 0)
            {
                _signals.Add(new SignalHint
                {
                    Symbol = _symbol,
                    Side = (st.SmartRegime ?? "").Contains("Down", StringComparison.OrdinalIgnoreCase) ? "SHORT" : "LONG",
                    Confidence = (int)Math.Round(st.Confidence > 1 ? st.Confidence : st.Confidence * 100),
                    Reason = st.SmartRegime ?? "ENGINE"
                });
            }
        }
        await LoadSymbolsAsync();
        await LoadAccountAsync();
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(8));
        _ = LoopAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("VertexMarketChart.init", "mkChart");
            _chartReady = true;
            await LoadTickerAsync();
            await LoadKlinesAsync();
            SetQtyPct(0.25m);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _actionMsg = "Chart: " + ex.Message;
            _actionOk = false;
        }
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        try
        {
            while (_timer != null && await _timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await LoadTickerAsync();
                    await LoadAccountAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAllAsync()
    {
        await LoadSymbolsAsync();
        await LoadAccountAsync();
        await LoadTickerAsync();
        await LoadKlinesAsync();
    }

    private async Task LoadSymbolsAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<SymRow>>("api/market/symbols");
            if (list?.Count > 0) _symbols = list;
        }
        catch { /* keep previous */ }
    }

    private async Task LoadTickerAsync()
    {
        try
        {
            var t = await Http.GetFromJsonAsync<SymRow>($"api/market/ticker?symbol={_symbol}");
            if (t != null && t.Price > 0)
            {
                _lastPrice = t.Price;
                _changePct = t.ChangePct;
                if (_limitPrice <= 0) _limitPrice = t.Price;
            }
        }
        catch { }
    }

    private async Task LoadKlinesAsync()
    {
        if (!_chartReady) return;
        try
        {
            var candles = await Http.GetFromJsonAsync<List<CandleDto>>(
                $"api/market/klines?symbol={_symbol}&interval={_interval}&limit=300");
            if (candles == null || candles.Count == 0) return;
            await JS.InvokeVoidAsync("VertexMarketChart.setData", candles);
            if (_lastPrice <= 0) _lastPrice = candles[^1].Close;
            await JS.InvokeVoidAsync("VertexMarketChart.setLevels",
                _selectedPos?.Entry ?? 0m, _sl, _tp);
        }
        catch (Exception ex)
        {
            _actionMsg = "Klines: " + ex.Message;
            _actionOk = false;
        }
    }

    private async Task LoadAccountAsync()
    {
        try
        {
            var acc = await Http.GetFromJsonAsync<AccountDto>("api/trade/account");
            if (acc == null) return;
            if (!acc.Ok && !string.IsNullOrEmpty(acc.Error))
            {
                // keys missing — keep UI alive with zeros
                return;
            }
            _available = acc.Available;
            _wallet = acc.Wallet;
            _unrealized = acc.Unrealized;
            _positions = acc.Positions ?? new();
            if (_selectedPos != null)
                _selectedPos = _positions.FirstOrDefault(p => p.Symbol == _selectedPos.Symbol) ?? _selectedPos;
        }
        catch { }
    }

    private async Task SelectSymbolAsync(string sym)
    {
        _symbol = sym;
        _sl = 0; _tp = 0;
        _selectedPos = _positions.FirstOrDefault(p => p.Symbol == sym);
        await LoadTickerAsync();
        await LoadKlinesAsync();
        SetQtyPct(0.25m);
    }

    private async Task SetIntervalAsync(string tf)
    {
        _interval = tf;
        await LoadKlinesAsync();
    }

    private void SetQtyPct(decimal pct)
    {
        if (_lastPrice <= 0 || _leverage <= 0) return;
        var free = _available > 0 ? _available : 35m;
        var maxNotional = free * _leverage * 0.95m;
        var raw = (maxNotional * pct) / _lastPrice;
        // precision by price tier (cheap alts need more decimals)
        int dec = _lastPrice >= 1000 ? 3 : _lastPrice >= 1 ? 4 : _lastPrice >= 0.01m ? 0 : 0;
        if (_lastPrice >= 1000) dec = 3;
        else if (_lastPrice >= 10) dec = 3;
        else if (_lastPrice >= 1) dec = 4;
        else if (_lastPrice >= 0.1m) dec = 2;
        else if (_lastPrice >= 0.01m) dec = 0;
        else dec = 0; // for ~0.006 coins step is often whole coins
        // use more sensible rounding for micro prices: keep integer size when huge
        if (raw >= 1000) _qty = Math.Floor(raw);
        else if (raw >= 10) _qty = Math.Round(raw, 2, MidpointRounding.ToZero);
        else if (_lastPrice < 0.01m) _qty = Math.Floor(raw); // AKE-style
        else _qty = Math.Round(raw, Math.Max(dec, 4), MidpointRounding.ToZero);
        if (_qty <= 0) _qty = _lastPrice < 0.01m ? 1 : 0.001m;
    }

    private async Task ApplySignalHintAsync(SignalHint sig)
    {
        await SelectSymbolAsync(sig.Symbol);
        _sl = sig.Sl;
        _tp = sig.Tp;
        if (sig.Entry > 0) _limitPrice = sig.Entry;
        _actionMsg = $"Setup {sig.Side} {sig.Symbol} conf={sig.Confidence}%";
        _actionOk = true;
        try { await JS.InvokeVoidAsync("VertexMarketChart.setLevels", sig.Entry > 0 ? sig.Entry : _lastPrice, _sl, _tp); } catch { }
    }

    private async Task PlaceAsync(bool isBuy)
    {
        if (_qty <= 0 || _lastPrice <= 0)
        {
            _actionMsg = "Укажи quantity и дождись цены";
            _actionOk = false;
            return;
        }

        if (!_realOrders)
        {
            _actionMsg = "Preview only. Включи «Реальные ордера» чтобы отправить на Binance.";
            _actionOk = true;
            try { await JS.InvokeVoidAsync("VertexMarketChart.setLevels", _lastPrice, _sl, _tp); } catch { }
            return;
        }

        _busy = true;
        _actionMsg = "Отправка ордера…";
        _actionOk = true;
        try
        {
            var body = new
            {
                symbol = _symbol,
                isBuy,
                quantity = _qty,
                orderType = _orderType,
                price = _orderType == "Limit" ? _limitPrice : (decimal?)null,
                leverage = _leverage,
                stopLoss = _sl > 0 ? _sl : (decimal?)null,
                takeProfit = _tp > 0 ? _tp : (decimal?)null
            };
            var res = await Http.PostAsJsonAsync("api/trade/place", body);
            var dto = await res.Content.ReadFromJsonAsync<PlaceResult>();
            if (dto?.Ok == true)
            {
                _actionMsg = $"OK order #{dto.OrderId} avg={FmtPx(dto.AvgPrice)} qty={dto.Qty} SL={dto.SlAlgoId} TP={dto.TpAlgoId}";
                _actionOk = true;
                await LoadAccountAsync();
            }
            else
            {
                _actionMsg = dto?.Error ?? "Order failed";
                _actionOk = false;
            }
        }
        catch (Exception ex)
        {
            _actionMsg = ex.Message;
            _actionOk = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync(string symbol)
    {
        if (!_realOrders)
        {
            _actionMsg = "Включи «Реальные ордера» для Close на бирже";
            _actionOk = false;
            return;
        }
        _busy = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/trade/close", new { symbol });
            var dto = await res.Content.ReadFromJsonAsync<PlaceResult>();
            _actionMsg = dto?.Ok == true ? $"Closed {symbol}" : (dto?.Error ?? "Close failed");
            _actionOk = dto?.Ok == true;
            await LoadAccountAsync();
        }
        catch (Exception ex)
        {
            _actionMsg = ex.Message;
            _actionOk = false;
        }
        finally { _busy = false; }
    }

    private void OnPosClick(PosDto p)
    {
        _selectedPos = p;
        _ = SelectSymbolAsync(p.Symbol);
    }

    private static string FmtPx(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("0.00", CultureInfo.InvariantCulture);
        if (v >= 1) return v.ToString("0.####", CultureInfo.InvariantCulture);
        return v.ToString("0.########", CultureInfo.InvariantCulture);
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        await Task.CompletedTask;
    }

    private sealed class SymRow
    {
        [JsonPropertyName("symbol")] public string Symbol { get; set; } = "";
        [JsonPropertyName("price")] public decimal Price { get; set; }
        [JsonPropertyName("changePct")] public decimal ChangePct { get; set; }
    }
    private sealed class CandleDto
    {
        [JsonPropertyName("time")] public long Time { get; set; }
        [JsonPropertyName("open")] public decimal Open { get; set; }
        [JsonPropertyName("high")] public decimal High { get; set; }
        [JsonPropertyName("low")] public decimal Low { get; set; }
        [JsonPropertyName("close")] public decimal Close { get; set; }
        [JsonPropertyName("volume")] public decimal Volume { get; set; }
    }
    private sealed class SignalHint
    {
        public string Symbol { get; set; } = "";
        public string Side { get; set; } = "LONG";
        public int Confidence { get; set; }
        public string Reason { get; set; } = "";
        public decimal Entry { get; set; }
        public decimal Sl { get; set; }
        public decimal Tp { get; set; }
    }
    private sealed class AccountDto
    {
        [JsonPropertyName("ok")] public bool Ok { get; set; }
        [JsonPropertyName("error")] public string? Error { get; set; }
        [JsonPropertyName("available")] public decimal Available { get; set; }
        [JsonPropertyName("wallet")] public decimal Wallet { get; set; }
        [JsonPropertyName("unrealized")] public decimal Unrealized { get; set; }
        [JsonPropertyName("positions")] public List<PosDto>? Positions { get; set; }
    }
    private sealed class PosDto
    {
        [JsonPropertyName("symbol")] public string Symbol { get; set; } = "";
        [JsonPropertyName("side")] public string Side { get; set; } = "";
        [JsonPropertyName("qty")] public decimal Qty { get; set; }
        [JsonPropertyName("entry")] public decimal Entry { get; set; }
        [JsonPropertyName("mark")] public decimal Mark { get; set; }
        [JsonPropertyName("pnl")] public decimal Pnl { get; set; }
        [JsonPropertyName("leverage")] public int Leverage { get; set; }
        [JsonPropertyName("margin")] public decimal Margin { get; set; }
    }
    private sealed class PlaceResult
    {
        [JsonPropertyName("ok")] public bool Ok { get; set; }
        [JsonPropertyName("error")] public string? Error { get; set; }
        [JsonPropertyName("orderId")] public long OrderId { get; set; }
        [JsonPropertyName("avgPrice")] public decimal AvgPrice { get; set; }
