@page "/trade-permission"

@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@inject TradePermissionFileService Service
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Trade Permission — Vertex AI</PageTitle>

<div class="tp">

    <div class="tp-header">
        <div class="tp-header-left">
            <div class="tp-icon-wrap">🚦</div>
            <div>
                <div class="tp-title">Trade Permission Monitor</div>
                <div class="tp-subtitle">Live view of why the AI is allowing or blocking entry, per symbol, right now</div>
            </div>
        </div>
        <div class="tp-refresh-pill">
            <span class="tp-refresh-dot"></span>
            Auto-refresh every 5s · last @LastUpdate
        </div>
    </div>

    <div class="tp-summary">
        <div class="tp-sum-card tp-sum-allow">
            <div class="tp-sum-num">@Allowed</div>
            <div class="tp-sum-label">Allowed</div>
        </div>
        <div class="tp-sum-card tp-sum-block">
            <div class="tp-sum-num">@Blocked</div>
            <div class="tp-sum-label">Blocked</div>
        </div>
        <div class="tp-sum-card tp-sum-total">
            <div class="tp-sum-num">@All.Count</div>
            <div class="tp-sum-label">Symbols Tracked</div>
        </div>
    </div>

    <div class="tp-toolbar">
        <div class="tp-filter-tabs">
            @foreach (var (val, label) in new[] { ("ALL", "All"), ("ALLOWED", "Allowed"), ("BLOCKED", "Blocked") })
            {
                <button class="tp-filter-tab @(Filter == val ? "tp-filter-tab-on" : "")" @onclick="() => SetFilter(val)">@label</button>
            }
        </div>
        <button class="tp-pin @(PinnedAllowed ? "tp-pin-on" : "")" @onclick="TogglePin">
            📌 Pin to Allowed-only
        </button>
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="tp-empty">No decision data yet — waiting for the Engine to evaluate symbols.</div>
    }
    else
    {
        <div class="tp-grid">
            @foreach (var e in Filtered)
            {
                <div class="tp-card @(e.Allow ? "tp-card-allow" : "tp-card-block") @(BlinkClass(e))">
                    <div class="tp-card-head">
                        <span class="tp-card-sym">@e.Symbol</span>
                        <span class="tp-card-tf">@Tf(e.Timeframe)</span>
                        <span class="tp-card-status @(e.Allow ? "up" : "dn")">@(e.Allow ? "✓ ALLOWED" : "✕ BLOCKED")</span>
                    </div>
                    <div class="tp-card-body">
                        @Reason(e)
                    </div>
                    <div class="tp-card-foot">
                        @if (!e.Allow && !string.IsNullOrEmpty(e.FailedGate))
                        {
                            <span class="tp-gate-pill">Gate: @e.FailedGate</span>
                        }
                        @if (e.Confidence > 0)
                        {
                            <span class="tp-conf-pill">Confidence: @((e.Confidence * 100).ToString("F0"))%</span>
                        }
                        <span class="tp-time mk-dim">@e.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
:root{--tp-bg:#0a0d12;--tp-bg2:#111520;--tp-bg3:#1a1f2e;--tp-bdr:#1e2535;--tp-acc:#3b82f6;--tp-grn:#22c55e;--tp-red:#ef4444;--tp-txt:#e2e8f0;--tp-dim:#64748b;--tp-mono:'JetBrains Mono','Fira Code',monospace;}

.tp{font-family:'Inter','Segoe UI',sans-serif;background:var(--tp-bg);min-height:100vh;color:var(--tp-txt);padding:0 0 60px;}

.tp-header{display:flex;align-items:center;justify-content:space-between;padding:24px 32px;background:linear-gradient(180deg,var(--tp-bg2),var(--tp-bg));border-bottom:1px solid var(--tp-bdr);flex-wrap:wrap;gap:12px;}
.tp-header-left{display:flex;align-items:center;gap:16px;}
.tp-icon-wrap{width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,rgba(59,130,246,0.18),rgba(59,130,246,0.04));border:1px solid rgba(59,130,246,0.3);display:flex;align-items:center;justify-content:center;font-size:22px;}
.tp-title{font-family:var(--tp-mono);font-size:20px;font-weight:700;}
.tp-subtitle{font-size:12.5px;color:var(--tp-dim);margin-top:2px;}
.tp-refresh-pill{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--tp-dim);background:var(--tp-bg3);padding:6px 14px;border-radius:20px;border:1px solid var(--tp-bdr);white-space:nowrap;}
.tp-refresh-dot{width:6px;height:6px;border-radius:50%;background:var(--tp-grn);box-shadow:0 0 8px rgba(34,197,94,.7);animation:tpPulse 1.8s ease-in-out infinite;}
@@keyframes tpPulse{0%,100%{opacity:1;}50%{opacity:.3;}}

.tp-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:20px 32px 0;max-width:600px;}
.tp-sum-card{background:var(--tp-bg2);border:1px solid var(--tp-bdr);border-radius:12px;padding:14px;text-align:center;}
.tp-sum-num{font-family:var(--tp-mono);font-size:26px;font-weight:700;}
.tp-sum-allow .tp-sum-num{color:var(--tp-grn);}
.tp-sum-block .tp-sum-num{color:var(--tp-red);}
.tp-sum-total .tp-sum-num{color:var(--tp-acc);}
.tp-sum-label{font-size:11px;color:var(--tp-dim);text-transform:uppercase;letter-spacing:.5px;margin-top:4px;}

.tp-toolbar{display:flex;align-items:center;justify-content:space-between;padding:20px 32px 0;flex-wrap:wrap;gap:12px;}
.tp-filter-tabs{display:flex;gap:4px;background:var(--tp-bg2);border:1px solid var(--tp-bdr);border-radius:10px;padding:3px;}
.tp-filter-tab{background:none;border:none;color:var(--tp-dim);font-size:12.5px;font-weight:600;padding:7px 16px;border-radius:7px;cursor:pointer;transition:all .15s;}
.tp-filter-tab:hover{color:var(--tp-txt);}
.tp-filter-tab-on{background:var(--tp-acc);color:#fff;}
.tp-pin{display:flex;align-items:center;gap:6px;background:var(--tp-bg2);border:1px solid var(--tp-bdr);color:var(--tp-dim);font-size:12.5px;font-weight:600;padding:8px 14px;border-radius:8px;cursor:pointer;transition:all .15s;}
.tp-pin:hover{color:var(--tp-txt);}
.tp-pin-on{background:rgba(234,179,8,.12);border-color:rgba(234,179,8,.4);color:#eab308;}

.tp-empty{text-align:center;padding:60px 20px;color:var(--tp-dim);font-size:13px;}

.tp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;padding:20px 32px;}
.tp-card{background:var(--tp-bg2);border:1px solid var(--tp-bdr);border-radius:12px;padding:16px;transition:border-color .2s;}
.tp-card-allow{border-left:3px solid var(--tp-grn);}
.tp-card-block{border-left:3px solid var(--tp-red);}
.tp-card-head{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.tp-card-sym{font-family:var(--tp-mono);font-size:14px;font-weight:700;}
.tp-card-tf{font-size:10px;color:var(--tp-dim);background:var(--tp-bg3);padding:2px 7px;border-radius:5px;}
.tp-card-status{margin-left:auto;font-size:11px;font-weight:700;letter-spacing:.3px;}
.tp-card-body{font-size:12.5px;color:var(--tp-txt);line-height:1.5;margin-bottom:12px;}
.tp-card-foot{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.tp-gate-pill{font-size:10px;background:rgba(239,68,68,.12);color:var(--tp-red);padding:2px 8px;border-radius:10px;font-family:var(--tp-mono);}
.tp-conf-pill{font-size:10px;background:rgba(59,130,246,.12);color:var(--tp-acc);padding:2px 8px;border-radius:10px;font-family:var(--tp-mono);}
.tp-time{font-size:10.5px;margin-left:auto;}

.tp-card.blink{animation:tpBlink 1s ease 2;}
@@keyframes tpBlink{0%,100%{background:var(--tp-bg2);}50%{background:rgba(59,130,246,.1);}}

@@media(max-width:700px){
    .tp-header{padding:18px 20px;}
    .tp-summary,.tp-toolbar,.tp-grid{padding-left:20px;padding-right:20px;}
    .tp-summary{grid-template-columns:repeat(3,1fr);max-width:none;}
}
</style>

@code {
    // ===== PIN STATE =====
    private bool PinnedAllowed;

    // ===== DATA =====
    private List<TradePermissionEvent> All = [];
    private List<TradePermissionEvent> Filtered = [];

    private Dictionary<(string Symbol, string Tf), bool> _prevAllow = new();
    private HashSet<(string Symbol, string Tf)> _justChanged = new();

    private string Filter = "ALL";

    private int Allowed;
    private int Blocked;
    private string LastUpdate = "—";

    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // ================= INIT =================
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(_cts.Token))
                {
                    await InvokeAsync(ReloadAsync);
                }
            }
            catch (OperationCanceledException) { }
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        PinnedAllowed = await JS.InvokeAsync<bool>("vertex.getPinnedAllowed");

        if (PinnedAllowed)
        {
            Filter = "ALLOWED";
            ApplyFilter();
            StateHasChanged();
        }
    }

    // ================= CORE =================
    private async Task ReloadAsync()
    {
        All = (await Service.LoadLatestAsync()).ToList();

        Allowed = All.Count(x => x.Allow);
        Blocked = All.Count(x => !x.Allow);

        LastUpdate = All
            .OrderByDescending(x => x.Time)
            .FirstOrDefault()?
            .Time.ToLocalTime().ToString("HH:mm:ss") ?? "—";

        _justChanged.Clear();

        // sync Trade Permission -> Market page
        foreach (var g in All.GroupBy(x => new { x.Symbol, x.Timeframe }))
        {
            await JS.InvokeVoidAsync(
                "vertex.tradePermission.update",
                g.Key.Symbol,
                g.Key.Timeframe,
                g
                    .Select((x, i) => new
                    {
                        index = i,      // индекс свечи
                        allow = x.Allow // true / false
                    })
                    .ToArray()
            );
        }


        ApplyFilter();
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        IEnumerable<TradePermissionEvent> q = Filter switch
        {
            "ALLOWED" => All.Where(x => x.Allow),
            "BLOCKED" => All.Where(x => !x.Allow),
            _ => All
        };

        Filtered = q
            .OrderByDescending(x => x.Allow)
            .ThenByDescending(x => x.Time)
            .ToList();
    }

    // ================= UI EVENTS =================
    private void SetFilter(string filter)
    {
        Filter = filter;
        ApplyFilter();
    }

    private async Task TogglePin()
    {
        PinnedAllowed = !PinnedAllowed;
        await JS.InvokeVoidAsync("vertex.setPinnedAllowed", PinnedAllowed);

        Filter = PinnedAllowed ? "ALLOWED" : "ALL";
        ApplyFilter();
    }

    // ================= HELPERS =================
    string BlinkClass(TradePermissionEvent e)
        => _justChanged.Contains((e.Symbol, e.Timeframe)) ? "blink" : "";

    static string Tf(string tf) => tf switch
    {
        "OneMinute" => "1m",
        "FiveMinutes" => "5m",
        _ => tf
    };

    static string Status(TradePermissionEvent e)
        => e.Allow ? "ENTRY ALLOWED" : "ENTRY BLOCKED";

    static string Reason(TradePermissionEvent e)
    {
        if (e.Allow)
            return "Market conditions acceptable. AI allows entry.";

        return e.FailedGate switch
        {
            "BASE" => "No valid market structure. Entry blocked for safety.",
            _ => e.Reason ?? "Entry blocked by risk filter."
        };
    }

    // ================= DISPOSE =================
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}
