@using static VertexAutoTradeBinance8.Web.Services.PositionsLiveService
<div class="position-card">

    <!-- TOP LINE -->
    <div class="pos-top">
        <div class="pos-symbol">
            <span class="symbol">@Symbol</span>
            <span class="tag @SideClass">@Side</span>
            <span class="tag">Cross @Leverage</span>
            <span class="ai-dot"></span>
        </div>

        <div class="pos-roi @RoiClass()">
            @($"{Roi:+0.00;-0.00}%")
        </div>
    </div>

    <!-- PNL -->
    <div class="pos-pnl @(Pnl >= 0 ? "positive" : "negative") @PnlFlashClass()">
        @($"{Pnl:+0.00;-0.00} USDT")
    </div>

    <!-- GRID -->
    <div class="pos-grid">
        <PosItem Label="Size (USDT)" Value="@Size.ToString()" />
        <PosItem Label="Margin" Value="@Margin.ToString()" />
        <PosItem Label="Entry" Value="@Entry.ToString()" />
        <PosItem Label="Mark"
                 Value="@Mark.ToString("F4")"
                 CssClass="@MarkClass()" />
        <PosItem Label="Liq. Price" Value="@LiqPrice.ToString()" Danger="true" />
        <PosItem Label="Margin Ratio" Value="@($"{MarginRatio}%")" />
    </div>

    <!-- AI -->
    <div class="ai-block">
        <div class="ai-score">AI Score: <b>@AiScore</b>/100</div>

        <div class="ai-tags">
            <span class="chip green">Liquidity: LOW</span>
            <span class="chip blue">@Regime</span>
        </div>

        <div class="risk-bar @RiskPulseClass()">
            <div class="risk-fill" style="width:@MarginRatio%"></div>
        </div>

        <div class="ai-tooltip">
            <b>AI Recommendation</b><br />
            @AiHint
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="pos-actions">
        <button class="btn-secondary">TP / SL</button>
        <button class="btn-danger">Close</button>
        <button class="btn-secondary" @onclick="ToggleExpand">
            @(IsExpanded ? "Collapse" : "Expand")
        </button>
    </div>

    <!-- === EXPANDED DETAILS === -->
    <div class="pos-expand @(IsExpanded ? "open" : "")">
        <div class="expand-grid">

            <div class="expand-item">
                <div class="label">Stop Loss</div>
                <div class="value">@StopLoss</div>
            </div>

            <div class="expand-item">
                <div class="label">Take Profit</div>
                <div class="value">@TakeProfit</div>
            </div>

            <div class="expand-item">
                <div class="label">Unrealized PnL</div>
                <div class="value">@($"{Pnl:+0.00;-0.00}")</div>
            </div>

            <div class="expand-item">
                <div class="label">AI Risk</div>
                <div class="value">@AiScore / 100</div>
            </div>

        </div>

        <div class="expand-ai-note">
            📌 AI считает позицию
            <b>@(AiScore >= 70 ? "качественной" : "рискованной")</b>.
            @AiHint
        </div>
    </div>

</div>
@code {
    [Parameter] public PositionChange ChangeMask { get; set; }
    [Parameter] public string Symbol { get; set; } = "";
    [Parameter] public string Side { get; set; } = "LONG";
    [Parameter] public int Leverage { get; set; }

    [Parameter] public decimal Pnl { get; set; }
    [Parameter] public decimal Roi { get; set; }

    [Parameter] public decimal Size { get; set; }
    [Parameter] public decimal Margin { get; set; }
    [Parameter] public decimal Entry { get; set; }
    [Parameter] public decimal Mark { get; set; }
    [Parameter] public decimal LiqPrice { get; set; }
    [Parameter] public decimal MarginRatio { get; set; }

    [Parameter] public int AiScore { get; set; }
    [Parameter] public string Regime { get; set; } = "";
    [Parameter] public string AiHint { get; set; } = "";

    // NEW
    [Parameter] public decimal StopLoss { get; set; }
    [Parameter] public decimal TakeProfit { get; set; }

    private bool IsExpanded;

    void ToggleExpand() => IsExpanded = !IsExpanded;

    string SideClass => Side == "LONG" ? "long" : "short";

    bool Changed(PositionChange f) => (ChangeMask & f) != 0;

    string PnlFlashClass()
    {
        if (!Changed(PositionChange.Pnl)) return "";
        return Pnl >= 0 ? "flash-pnl pos" : "flash-pnl neg";
    }

    string RoiClass()
    {
        if (!Changed(PositionChange.Roi)) return "roi";
        return Roi >= 0 ? "roi up" : "roi down";
    }

    string MarkClass()
    {
        return Changed(PositionChange.Mark) ? "mark-tick" : "";
    }

    string RiskPulseClass()
    {
        return Changed(PositionChange.Risk) ? "risk-pulse" : "";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        ChangeMask = PositionChange.None;
    }


}
