    async Task SelectPosition(ActivePositionInfo pos)
    {
        // No more toggle-to-deselect on a second click of the same
        // row — that's what caused the reported "different panel
        // shows on every other click": deselecting cleared
        // _selectedPosition but left _activeSym pointing at the same
        // symbol, so the right panel fell through to the unrelated
        // "Open Orders for SYMBOL" branch (since that symbol's TP/SL
        // orders still existed) instead of staying empty - looking
        // like two competing logics randomly alternating. There's
        // already a dedicated Close Panel (✕) button for explicitly
        // dismissing the panel, so clicking the same row again simply
        // re-shows the same position now, with no surprising side
        // effect.
        if (PosIdentityEquals(_selectedPosition, pos))
        {
            return; // already showing this exact position — nothing to do
        }

        // Show the panel immediately using data already available on
        // pos itself (Entry/Mark/PnL/Liq/etc - zero network calls
        // needed for any of that) - this is what actually fixes the
        // reported slowness, which came from awaiting the open-orders
        // network call BEFORE showing anything new at all. Network-
        // dependent extras (open orders list, chart, TP/SL lines)
        // load right after, in the background, updating their own
        // small pieces once ready rather than gating the whole panel.
        _selectingPosition = null;
        _selectedPosition = pos;
        _activeSignal = null;
        _orderPanelDismissed = false;
        // Auto-expand the Add to Position form immediately — previously the
        // user had to click "+" separately after the panel opened, which felt
        // like the panel was missing trade controls. The form is already
        // context-scoped to this position's side so it can only add, never flip.
        _addToPositionOpen = true;

        var sym = pos.Symbol;
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        _activeSym = sym;
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        StateHasChanged();

        // Everything below is network/chart work that updates its
        // own piece of the UI once ready - the position panel itself
        // is already visible and correct at this point.
        await LoadOpenOrdersAsync();
        // Load tickSize+stepSize so drag TP/SL works without precision errors
        _ = LoadSymbolPrecisionAsync(pos.Symbol);

        _dotNetRef ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("marketChart.bindSlTpCallbacks", $"chartContainer-{_chartInstanceId}", _dotNetRef); } catch { }

        try { await RenderCharts(); } catch { }
        await RefreshPositionLines();

        _ = JS.InvokeVoidAsync("tickerDragScroll.scrollSymbolIntoView", pos.Symbol);

        StateHasChanged();
        _ = SaveSelectionState();
    }

    async Task ClosePositionRow(ActivePositionInfo pos)
    {
        if (_demoMode)
        {
            DemoAccount.ClosePosition(pos.Id, 100m, "Manual");
            RefreshDemoSnapshot();
            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            return;
        }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            bool isLong = pos.Side == "LONG";
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;

            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: pos.Symbol,
                side: isLong ? OrderSide.Sell : OrderSide.Buy,
                type: FuturesOrderType.Market,
                quantity: pos.Qty,
                reduceOnly: isHedge ? null : true,
                positionSide: isHedge ? posSide : null,
                ct: cts.Token);

            if (PosIdentityEquals(_selectedPosition, pos)) _selectedPosition = null;
            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            await LoadAllOpenPositionsAsync();
        }
        catch { }
        finally { _orderLoading = false; }
    }

