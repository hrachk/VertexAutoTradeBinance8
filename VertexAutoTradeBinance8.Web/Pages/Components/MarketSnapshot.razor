        _ = JS.InvokeVoidAsync("marketChart.clearPriceLine", $"chartContainer-{_chartInstanceId}");
    }

    async Task QuickMarketOrder(bool isBuy)
    {
        // Quick-trade from inside the maximized chart. Reuses the exact
        // same order-placing logic as the regular order panel (qty
        // rounding, notional checks, leverage, API call) — this is
        // just a fast path to get there without leaving fullscreen.
        if (_activeSignal == null || _activeSignal.Symbol != _activeSym)
        {
            OpenManualPanelFor(_activeSym, _last);
        }
        _orderType = "Market";
        _activeSignal!.Side = isBuy ? "BUY" : "SELL";
        await PlaceManualOrder();
    }

    async Task PlaceManualOrderBuy()
    {
        if (_activeSignal != null) _activeSignal.Side = "BUY";
        await PlaceManualOrder();
    }

    async Task PlaceManualOrderSell()
    {
        if (_activeSignal != null) _activeSignal.Side = "SELL";
        await PlaceManualOrder();
    }

    async Task PlaceManualOrder()
    {
        if (_activeSignal == null) return;
        _orderError   = string.Empty;
        _orderSuccess = string.Empty;

        if (_orderQty <= 0)                                   { _orderError = "Enter quantity"; return; }
        if (_orderType != "Market" && _orderPrice <= 0)       { _orderError = "Enter price"; return; }

        // Notional check: qty × price >= minNotional
        decimal checkPrice = _orderPrice > 0 ? _orderPrice : _activeSignal.Entry;
        decimal checkNotional = _orderQty * checkPrice;
        if (checkNotional < _symMinNotional)
        {
            _orderError = $"Notional {checkNotional:F2} USDT too small — minimum is {_symMinNotional:F0} USDT. Increase quantity.";
            return;
        }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _orderError = "No API credentials configured"; return; }

            bool isBuy  = _activeSignal.Side?.ToUpper() == "BUY" ||
                          _activeSignal.Side?.ToUpper() == "LONG";
            var side    = isBuy ? OrderSide.Buy : OrderSide.Sell;
            var posSide = isBuy ? PositionSide.Long : PositionSide.Short;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

            // Round qty to stepSize
            decimal step = _symStep > 0 ? _symStep : 0.001m;
            decimal qty  = Math.Floor(_orderQty / step) * step;
            if (qty <= 0) { _orderError = "Quantity too small after rounding"; return; }

            // Round price to tickSize
            decimal tick  = _symTickSize > 0 ? _symTickSize : 0.0001m;
            decimal price = tick > 0 ? Math.Round(_orderPrice / tick) * tick : _orderPrice;

            // Set leverage
            try { await client.UsdFuturesApi.Account.ChangeInitialLeverageAsync(
                _activeSignal.Symbol, _orderLeverage, ct: cts.Token); }
            catch { }

            // Detect hedge mode
            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            long? orderId = null;

            if (_orderType == "Market")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.Market, quantity: qty,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else if (_orderType == "Limit")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.Limit, quantity: qty,
                    price: price, timeInForce: TimeInForce.GoodTillCanceled,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else // Stop
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.StopMarket, quantity: qty,
                    stopPrice: price,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }

            _orderSuccess = $"Order #{orderId} placed · {_orderType} · {qty} {_activeSignal.Symbol.Replace("USDT","")}";
            _activeSignal = null;
        }
        catch (Exception ex) { _orderError = ex.Message; }
        finally { _orderLoading = false; StateHasChanged(); }
    }

    public async ValueTask DisposeAsync()
    {
        LiveState.PriceTicked -= OnLivePriceTicked;
        LiveState.KlineClosed -= OnLiveKlineClosed;
        _cts.Cancel();
        _timer?.Dispose();
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    sealed class ActivePositionInfo
    {
        public string Symbol = "";
        public string Side = "";
        public int Leverage;
        public decimal Size;
        public decimal Qty;
        public decimal EntryPrice;
        public decimal MarkPrice;
        public decimal LiqPrice;
        public decimal Margin;
        public decimal Pnl;
        public decimal Roi;
    }
}
