    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitChartAsync();
        }

        // Render whenever chart is ready and data changed
        if (_chartInitDone && Selected != null && Selected.Klines.Count >= 5)
        {
            var lastK = Selected.Klines[^1];
            // Include last bar's OHLCV so live price ticks trigger a redraw,
            // not just when a brand new bar/candle count appears
            var key = $"{Selected.Symbol}:{Selected.Timeframe}:{Selected.Klines.Count}:{lastK.OpenTime}:{lastK.Close}:{lastK.High}:{lastK.Low}:{lastK.Volume}";
            if (key != _lastRenderedKey)
            {
                _lastRenderedKey = key;
                try { await RenderCharts(); } catch { }
            }
        }
    }

    // Initializes the chart. Lightweight Charts' own marketChart.init()
    // (JS side) disposes any previous chart instance bound to this
    // container id before creating a new one — so even in the worst
    // case (Blazor somehow calling this twice, or reusing a component
    // instance across navigation in a way that re-triggers firstRender),
    // there is never more than one live chart per container, and no
    // stale-reference bookkeeping is needed on this side at all.
    async Task InitChartAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var ok = await JS.InvokeAsync<bool>("marketChart.init", $"chartContainer-{_chartInstanceId}");
            if (ok)
            {
                await RegisterPricePickCallback();
                _chartInitDone = true;
                _jsReady = true;
                _chartInitError = "";
            }
            else
            {
                _chartInitError = "Chart container not found in DOM yet";
            }
        }
        catch (Exception ex)
        {
            _chartInitError = $"Chart init failed: {ex.Message}";
        }
        try { await JS.InvokeVoidAsync("tickerDragScroll.bind"); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                if (Frozen) continue;
                await LoadData();
                SweepExpiredSignals();
                if (_activeSignal != null)
                    await LoadCurrentPositionAsync(_activeSignal.Symbol);
                await LoadOpenOrdersAsync();
                await LoadAllOpenPositionsAsync();
                // StateHasChanged triggers OnAfterRenderAsync which calls
                // RenderCharts only when data actually changed
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // Cycles the "Analyzing SYMBOL..." text in the empty-signals scanning
    // animation, independent of the slower 5s data timer, so the panel
    // feels alive even when nothing else has changed.
    async Task ScanCycleAsync()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested)
            {
                await Task.Delay(1400, _cts.Token);
                if (!_signals.Any() && _symbols.Count > 0)
                {
                    _scanSymIdx = (_scanSymIdx + 1) % _symbols.Count;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    // Keep live-updated series unless the file snapshot has a strictly newer
    // closed candle (e.g. symbol the Engine isn't live-pushing, or cold state
    // right after a Web restart). Prevents the slower ~45s file snapshot from
    // reverting candles we've already live-updated via SignalR.
    static List<MarketSeries> MergeWithLive(List<MarketSeries> current, IReadOnlyList<MarketSeries> fresh)
    {
        var result = new List<MarketSeries>(fresh.Count);
        foreach (var f in fresh)
        {
            var existing = current.FirstOrDefault(s => s.Symbol == f.Symbol && s.Timeframe == f.Timeframe);
            if (existing == null || existing.Klines.Count == 0 || f.Klines.Count == 0)
            {
                result.Add(f);
                continue;
            }

            result.Add(f.Klines[^1].OpenTime > existing.Klines[^1].OpenTime ? f : existing);
        }
        return result;
    }

    async Task LoadData()
    {
        try
        {
            var fresh = await Service.LoadAsync();
            if (fresh == null || fresh.Count == 0) return;
            Series = MergeWithLive(Series, fresh);

            // Load recent signals (last 24h, not blocked by exchange)
            try
            {
                var allSigs = await SignalSvc.LoadAsync();
                _signals = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= DateTime.UtcNow.AddHours(-SignalLookbackHours)
                                && s.Stage != "BLOCKED"
                                && !_expiredSignals.ContainsKey(SignalKey(s))
                                && !GetSignalTtl(s).IsExpired)
                    .GroupBy(s => s.Symbol)
                    .Select(g => g.OrderByDescending(s => s.Time).First())
                    .OrderByDescending(s => s.Time)
                    .Take(12)
                    .ToList();
            }
            catch { }

            // Rebuild symbol list (unique, ordered by count)
            _symbols = Series
                .GroupBy(s => s.Symbol)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            // Select default symbol if none active
            if (string.IsNullOrEmpty(_activeSym) && _symbols.Any())
                _activeSym = _symbols[0];

            // Select default TF if none active
            if (string.IsNullOrEmpty(_activeTf))
                _activeTf = Series.FirstOrDefault(s => s.Symbol == _activeSym)?.Timeframe ?? "FiveMinutes";

            ResolveSelected();
            CalcStats();

            // Panel is visible by default for whatever symbol is active —
            // only stays hidden if the user explicitly dismissed it (✕).
            if (_activeSignal == null && !_orderPanelDismissed && !string.IsNullOrEmpty(_activeSym) && _last > 0)
                OpenManualPanelFor(_activeSym, _last);
        }
        catch { }
    }

    void ResolveSelected()
    {
        // Find series matching active symbol + TF
        var match = Series.FirstOrDefault(s =>
            s.Symbol == _activeSym && s.Timeframe == _activeTf);

        if (match != null)
        {
            Selected = match;
        }
        else if (!string.IsNullOrEmpty(_activeSym))
        {
            // Fallback: best available TF for this symbol
            Selected = Series
                .Where(s => s.Symbol == _activeSym)
                .OrderByDescending(s => s.Klines.Count)
                .FirstOrDefault();
            if (Selected != null) _activeTf = Selected.Timeframe;
        }
    }

    void PickSym(string sym)
    {
        _activeSym = sym;
        // Try to keep current TF, fallback to first available
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
    }

