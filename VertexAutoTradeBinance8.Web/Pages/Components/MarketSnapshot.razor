    // Relevance / TTL of a signal, derived from its volatility (ATR) rather than a fixed duration.
    // Higher ATR relative to entry price => market moving faster => signal goes stale sooner.
    record SignalTtlInfo(double Pct, string Label, bool IsExpiring, bool IsExpired);

    SignalTtlInfo GetSignalTtl(MissedTradeRecord sig)
    {
        var ageMin = (DateTime.UtcNow - sig.Time.ToUniversalTime()).TotalMinutes;
        if (ageMin < 0) ageMin = 0;

        // Relative volatility: ATR as a fraction of entry price.
        decimal relAtr = sig.Entry > 0 ? sig.ATR / sig.Entry : 0.003m;
        if (relAtr <= 0) relAtr = 0.003m;

        // More volatile symbols invalidate faster; calmer symbols stay relevant longer.
        // Tuned so a "typical" ~0.3% ATR signal lives ~25 min, scaling inversely with volatility.
        double lifeMinutes = (double)(0.075m / relAtr);
        lifeMinutes = Math.Clamp(lifeMinutes, 6, 90);

        double remaining = lifeMinutes - ageMin;
        double pct = Math.Clamp(remaining / lifeMinutes * 100.0, 0, 100);

        bool isExpired  = remaining <= 0;
        bool isExpiring = remaining > 0 && remaining <= lifeMinutes * 0.15;

        string label = isExpired
            ? "expired"
            : remaining >= 60
                ? $"~{(remaining / 60).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}h left"
                : $"~{Math.Max(1, (int)remaining)}m left";

        return new SignalTtlInfo(pct, label, isExpiring || isExpired, isExpired);
    }

    string FmtAgo(DateTime t)
    {
        var span = DateTime.UtcNow - t.ToUniversalTime();
        if (span.TotalMinutes < 1)  return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24)   return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    // Called on every 5s tick: marks fully-expired signals so they fade out,
    // then removes them a moment later once the fade transition has played.
    // Dismissed keys are kept (not cleared) so a concurrent/later LoadData()
    // can never bring the same signal back at full opacity.
    void SweepExpiredSignals()
    {
        // Anything this old can never reappear from LoadData() anyway
        // (same lookback window), so it's safe to forget.
        var cutoff = DateTime.UtcNow.AddHours(-SignalLookbackHours);
        foreach (var k in _expiredSignals.Where(kv => kv.Value < cutoff).Select(kv => kv.Key).ToList())
        {
            _expiredSignals.Remove(k);
        }

        var nowExpired = _signals.Where(s => GetSignalTtl(s).IsExpired).ToList();
        var newlyMarked = nowExpired.Where(s => !_expiredSignals.ContainsKey(SignalKey(s))).ToList();

        if (newlyMarked.Count == 0) return;

        // Mark immediately, not just after the fade delay below — otherwise
        // a LoadData() that lands mid-fade would still re-add the signal.
        foreach (var s in newlyMarked)
        {
            _expiredSignals[SignalKey(s)] = s.Time;
        }

        var keysToRemove = newlyMarked.Select(SignalKey).ToHashSet();

        // Give the CSS fade-out transition a moment to play, then drop them
        // from the live list entirely.
        _ = Task.Run(async () =>
        {
            await Task.Delay(900);
            _signals = _signals.Where(s => !keysToRemove.Contains(SignalKey(s))).ToList();
            _sigPage = Math.Clamp(_sigPage, 0, _sigPageCount - 1);
            await InvokeAsync(StateHasChanged);
        });
    }

