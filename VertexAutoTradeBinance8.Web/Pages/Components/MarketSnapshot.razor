    // AI sizing: given an entry price (chart-picked or signal default),
    // current free balance and the symbol's max leverage, suggest both
    // a sensible quantity AND bump leverage if the balance is too small
    // to comfortably afford the position at the current leverage.
    async Task SuggestQtyForPrice(decimal entryPrice)
    {
        if (_activeSignal == null || entryPrice <= 0) return;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));

            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            decimal balance = 0m;
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null) balance = usdt.AvailableBalance;
            }
            if (balance <= 0) return;

            decimal stopDist = _activeSignal.StopLoss > 0
                ? Math.Abs(entryPrice - _activeSignal.StopLoss)
                : (_activeSignal.ATR > 0 ? _activeSignal.ATR * 1.5m : entryPrice * 0.01m);

            decimal riskUsdt = balance * 0.02m; // 2% of balance at risk
            decimal rawQty   = stopDist > 0 ? riskUsdt / stopDist : 0m;

            // Minimum quantity to satisfy exchange minNotional.
            decimal minQtyForNotional = _symMinNotional / entryPrice;
            decimal qty = Math.Max(rawQty, minQtyForNotional);

            decimal step = _symStep > 0 ? _symStep : 0.001m;
            qty = Math.Floor(qty / step) * step;
            if (qty <= 0) qty = step;

            // Margin needed at the CURRENT leverage setting.
            decimal notional     = qty * entryPrice;
            decimal marginNeeded = notional / Math.Max(_orderLeverage, 1);

            // If the position would eat up almost the whole balance as margin,
            // the leverage is too low for this balance size — raise it
            // (capped at the symbol's real max) so margin usage settles
            // around ~50%, instead of letting the order fail on insufficient
            // margin or forcing the user to manually drag the slider.
            if (marginNeeded > balance * 0.9m)
            {
                int neededLev = (int)Math.Ceiling(notional / (balance * 0.5m));
                _orderLeverage = Math.Clamp(neededLev, _orderLeverage, _symMaxLev);
            }

            _orderQty = qty;
        }
        catch { }
    }

    void SelectSignal(MissedTradeRecord sig)
    {
        _activeSignal  = _activeSignal == sig ? null : sig;
        _orderError    = string.Empty;
        _orderSuccess  = string.Empty;
        _orderType     = "Market";
        _orderLeverage = 10;
        _orderQty      = 0;
        _orderPrice    = sig.Entry;

        if (_activeSignal != null)
        {
            _orderPanelDismissed = false;
            PickSym(sig.Symbol);
            _ = LoadSymbolInfoAndSuggestQty(sig);
            _ = LoadCurrentPositionAsync(sig.Symbol);
        }
        else
