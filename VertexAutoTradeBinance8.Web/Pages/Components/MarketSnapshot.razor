    // exists for this position with a new one at the dragged price —
    // cancel-then-place, same two-call pattern already used everywhere
    // else in this file for order changes (no new order-placement
    // primitive was invented for this).
    bool _slTpDragBusy;

    [JSInvokable]
    public async Task OnSlDragged(decimal price)
    {
        if (_selectedPosition == null || price <= 0 || _slTpDragBusy) return;
        await ReplaceProtectiveOrderAsync(_selectedPosition, isStopLoss: true, newPrice: price);
    }

    [JSInvokable]
    public async Task OnTpDragged(decimal price)
    {
