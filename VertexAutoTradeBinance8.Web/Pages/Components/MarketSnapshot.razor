    // Called from JS (right-click on the chart) with the price under the cursor.
    // Fills the order price field and re-runs the AI sizing suggestion against
    // that price, current balance, stop distance and leverage — exactly like
    // picking a signal, but driven by the user's own chosen entry.
    [JSInvokable]
    public async Task OnPricePicked(decimal price)
    {
        if (_activeSignal == null || price <= 0) return;

        // Picking a price only makes sense for Limit/Stop orders
        if (_orderType == "Market") _orderType = "Limit";

        _orderPrice = _symTickSize > 0
            ? Math.Round(price / _symTickSize) * _symTickSize
            : price;

        await SuggestQtyForPrice(_orderPrice);
        await InvokeAsync(StateHasChanged);
    }

    // AI sizing: given an entry price (chart-picked or signal default),
    // current free balance and the symbol's max leverage, suggest both
    // a sensible quantity AND bump leverage if the balance is too small
    // to comfortably afford the position at the current leverage.
    async Task SuggestQtyForPrice(decimal entryPrice)
    {
        if (_activeSignal == null || entryPrice <= 0) return;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));

            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            decimal balance = 0m;
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null) balance = usdt.AvailableBalance;
            }
            if (balance <= 0) return;

            decimal stopDist = _activeSignal.StopLoss > 0
                ? Math.Abs(entryPrice - _activeSignal.StopLoss)
                : (_activeSignal.ATR > 0 ? _activeSignal.ATR * 1.5m : entryPrice * 0.01m);

            decimal riskUsdt = balance * 0.02m; // 2% of balance at risk
            decimal rawQty   = stopDist > 0 ? riskUsdt / stopDist : 0m;

            // Minimum quantity to satisfy exchange minNotional.
            decimal minQtyForNotional = _symMinNotional / entryPrice;
            decimal qty = Math.Max(rawQty, minQtyForNotional);

            decimal step = _symStep > 0 ? _symStep : 0.001m;
            qty = Math.Floor(qty / step) * step;
            if (qty <= 0) qty = step;

            // Margin needed at the CURRENT leverage setting.
            decimal notional     = qty * entryPrice;
            decimal marginNeeded = notional / Math.Max(_orderLeverage, 1);

            // If the position would eat up almost the whole balance as margin,
            // the leverage is too low for this balance size — raise it
            // (capped at the symbol's real max) so margin usage settles
            // around ~50%, instead of letting the order fail on insufficient
            // margin or forcing the user to manually drag the slider.
            if (marginNeeded > balance * 0.9m)
            {
                int neededLev = (int)Math.Ceiling(notional / (balance * 0.5m));
                _orderLeverage = Math.Clamp(neededLev, _orderLeverage, _symMaxLev);
            }

            _orderQty = qty;
        }
        catch { }
    }

    void SelectSignal(MissedTradeRecord sig)
    {
        _activeSignal  = _activeSignal == sig ? null : sig;
        _orderError    = string.Empty;
        _orderSuccess  = string.Empty;
        _orderType     = "Market";
        _orderLeverage = 10;
        _orderQty      = 0;
        _orderPrice    = sig.Entry;

        if (_activeSignal != null)
        {
            PickSym(sig.Symbol);
            _ = LoadSymbolInfoAndSuggestQty(sig);
        }
    }

    async Task LoadSymbolInfoAndSuggestQty(MissedTradeRecord sig)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            // 1) Exchange info → tickSize, stepSize, minNotional
            var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
            if (ei.Success)
            {
                var s = ei.Data.Symbols.FirstOrDefault(x => x.Name == sig.Symbol);
                if (s != null)
                {
                    _symTickSize    = s.PriceFilter?.TickSize   ?? 0.0001m;
                    _symStep        = s.LotSizeFilter?.StepSize ?? 0.001m;
                    _symMinNotional = 5m;
                    foreach (var f in s.Filters)
                    {
                        if (f is Binance.Net.Objects.Models.Spot.BinanceSymbolMinNotionalFilter mn)
                        { _symMinNotional = mn.MinNotional; break; }
                    }
                }
            }

            // 2) Real MaxLeverage via GetBracketsAsync
            try
            {
                var br = await client.UsdFuturesApi.Account
                    .GetBracketsAsync(sig.Symbol, ct: cts.Token);
                if (br.Success && br.Data != null)
                {
                    var sb = br.Data.FirstOrDefault(b => b.Symbol == sig.Symbol);
                    if (sb?.Brackets?.Length > 0)
                    {
                        _symMaxLev = sb.Brackets.Max(b => b.InitialLeverage);
                        if (_orderLeverage > _symMaxLev)
                            _orderLeverage = Math.Min(_symMaxLev, 20);
                    }
                }
            }
            catch { }

            // 3) Round price to tickSize
            if (_symTickSize > 0 && sig.Entry > 0)
                _orderPrice = Math.Round(sig.Entry / _symTickSize) * _symTickSize;

            // 4) Suggest qty from balance with 2% risk
            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null && usdt.AvailableBalance > 0 && sig.Entry > 0)
                {
                    decimal balance  = usdt.AvailableBalance;
                    decimal riskUsdt = balance * 0.02m;
                    decimal stopDist = sig.StopLoss > 0
                        ? Math.Abs(sig.Entry - sig.StopLoss)
                        : (sig.ATR > 0 ? sig.ATR * 1.5m : sig.Entry * 0.01m);

                    decimal rawQty = stopDist > 0 ? riskUsdt / stopDist : 0m;
                    decimal minQty = sig.Entry > 0 ? _symMinNotional / sig.Entry : 0m;
                    rawQty = Math.Max(rawQty, minQty);

                    decimal step = _symStep > 0 ? _symStep : 0.001m;
                    _orderQty = Math.Floor(rawQty / step) * step;
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    void OnPriceChange(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        _orderPrice = _symTickSize > 0
            ? Math.Round(v / _symTickSize) * _symTickSize
            : v;
