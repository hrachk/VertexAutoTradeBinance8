    };

    string FmtP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1)    return v.ToString("F4");
        if (v >= 0.01m) return v.ToString("F5");
        if (v >= 0.0001m) return v.ToString("F6");
        // Genuinely cheap coins (sub-$0.0001, e.g. SHIB/PEPE-style prices)
        // need more than a fixed decimal count to show meaningful digits
        // at all — count leading zeros after the decimal point and show
        // 5 significant digits past them, in plain notation (never
        // scientific, which the previous G5 format silently fell back to
        // and is unreadable on a trading UI).
        var s = v.ToString("F12").TrimEnd('0');
        var afterDot = s.Substring(s.IndexOf('.') + 1);
        int leadingZeros = afterDot.TakeWhile(c => c == '0').Count();
        int decimals = Math.Min(12, leadingZeros + 5);
        return v.ToString("F" + decimals);
    }

    string FmtV(decimal v)
    {
        if (v >= 1_000_000) return (v/1_000_000m).ToString("F1") + "M";
        if (v >= 1_000)     return (v/1_000m).ToString("F1") + "K";
        return v.ToString("F2");
    }

