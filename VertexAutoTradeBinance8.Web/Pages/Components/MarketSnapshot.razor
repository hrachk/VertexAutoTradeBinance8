    // Called from JS (right-click on the chart) with the price under the cursor.
    // Fills the order price field and re-runs the AI sizing suggestion against
    // that price, current balance, stop distance and leverage — exactly like
    // picking a signal, but driven by the user's own chosen entry.
    [JSInvokable]
    public async Task OnPricePicked(decimal price)
    {
        if (price <= 0) return;

        // Case 1: the Add to Position form is open (a position is
        // selected) — fill its Limit price and switch it to Limit,
        // since picking a price only makes sense for a non-Market
        // order.
        if (_addToPositionOpen && _selectedPosition != null)
        {
            _addToPosType = "Limit";
            _addToPosPrice = _symTickSize > 0 ? Math.Round(price / _symTickSize) * _symTickSize : price;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Case 2: no Manual Trade panel open yet (e.g. a position is
        // selected but Add to Position isn't expanded) — open one for
        // the active symbol, matching what right-clicking used to do
        // before any position was ever selected, rather than silently
        // doing nothing.
        //
        // CRITICAL FIX: open it with the actually-clicked price right
        // from the start, not the current live market price - the
        // previous version opened with _last, then corrected to the
        // real clicked price a moment later (after an intermediate
        // await), which could render the wrong price momentarily and
        // is exactly what made right-click placement feel imprecise.
        if (_activeSignal == null && !string.IsNullOrEmpty(_activeSym) && _selectedPosition == null)
        {
            OpenManualPanelFor(_activeSym, price);
        }

        if (_activeSignal == null) return; // still nothing to fill into (e.g. a position IS selected but its Add form isn't open)

        // Picking a price only makes sense for Limit/Stop orders
        if (_orderType == "Market") _orderType = "Limit";

        _orderPrice = _symTickSize > 0
            ? Math.Round(price / _symTickSize) * _symTickSize
            : price;

        await SuggestQtyForPrice(_orderPrice);
        await InvokeAsync(StateHasChanged);
    }

