.ord-close-x:hover{background:var(--bdr);color:var(--txt);}
.ord-type-tabs{display:flex;background:var(--bg2);border-bottom:1px solid var(--bdr);gap:4px;padding:8px 12px;}
.ord-tt{flex:1;background:var(--bg3);border:1px solid var(--bdr);color:var(--dim);padding:10px 6px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;border-radius:8px;display:flex;align-items:center;justify-content:center;gap:5px;letter-spacing:.2px;}
.ord-tt:hover{color:var(--txt);border-color:var(--bdr2);background:var(--bg4);}
.ott-on{color:#fff!important;border-color:var(--acc)!important;background:linear-gradient(135deg,rgba(59,130,246,.3),rgba(59,130,246,.15))!important;box-shadow:0 0 12px rgba(59,130,246,.2);}
.ord-tt-icon{font-size:14px;}
/* Leverage */
.ord-lev-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
