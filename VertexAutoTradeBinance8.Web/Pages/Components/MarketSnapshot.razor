    // Returns the right positions list for display depending on mode -
    // converts DemoPosition to ActivePositionInfo (near-identical
    // shape) so the existing table markup works unchanged for either
    // source, rather than duplicating the whole table for two data
    // shapes.
    List<ActivePositionInfo>? _displayedPositionsCache;
    bool _displayedPositionsCacheValid;

    // CRITICAL PERFORMANCE FIX: this used to be a plain computed
    // property (=>), meaning EVERY access (and it's read 4+ separate
    // times in a single markup render pass alone, plus several more
    // in code) fully reconstructed the entire positions list with
    // brand new objects in demo mode. Cached now, invalidated
    // explicitly only when the underlying data actually changes
    // (InvalidateDisplayedPositionsCache, called from
    // RefreshDemoSnapshot and the real positions loader) rather than
    // recomputing on every single read.
    List<ActivePositionInfo> DisplayedPositions
    {
        get
        {
            if (_displayedPositionsCacheValid && _displayedPositionsCache != null) return _displayedPositionsCache;

            _displayedPositionsCache = _demoMode
                ? _demoSnapshot.Positions.Select(p =>
                {
                    decimal mark = DemoAccount.GetLastPrice(p.Symbol);
                    if (mark <= 0) mark = p.EntryPrice;
                    return new ActivePositionInfo
                    {
                        Id = p.Id, Symbol = p.Symbol, Side = p.Side, Leverage = p.Leverage,
                        Qty = p.Qty, Size = p.Notional(mark), EntryPrice = p.EntryPrice,
                        MarkPrice = mark, LiqPrice = p.LiqPrice, Margin = p.Margin,
                        Pnl = p.UnrealizedPnl(mark), Roi = p.Roi(mark),
                    };
                }).ToList()
                : _allPositions;
            _displayedPositionsCacheValid = true;
            // Re-point _selectedPosition to fresh instance if needed (DEMO mode).
            if (_pendingDemoPosRepoint && _selectedPosition != null)
            {
                _pendingDemoPosRepoint = false;
                var refreshed = _displayedPositionsCache
                    .FirstOrDefault(p => p.Symbol == _selectedPosition.Symbol && p.Side == _selectedPosition.Side);
                if (refreshed != null) _selectedPosition = refreshed;
                // if refreshed == null: position was closed (demo trade exited)
            }
            return _displayedPositionsCache;
        }
    }

    // Top exchange symbols always shown first in the left panel —
    // ordered by global market cap / trading significance, matching
    // how professional trading terminals (Binance, Bybit) structure
    // their default symbol lists.
    static readonly string[] MAJOR_SYMBOLS = {
        "BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT", "XRPUSDT",
        "DOGEUSDT", "ADAUSDT"
    };

    void InvalidateDisplayedPositionsCache()
    {
        _displayedPositionsCacheValid = false;
        // In DEMO mode: DisplayedPositions creates NEW object instances on
        // every cache rebuild, so _selectedPosition holds a stale reference.
        // Re-point it to the matching fresh instance (by Symbol+Side) so the
        // panel never disappears. Mirrors what LoadAllOpenPositionsAsync does
        // for real (non-demo) positions.
        if (_demoMode && _selectedPosition != null && _displayedPositionsCache != null)
        {
