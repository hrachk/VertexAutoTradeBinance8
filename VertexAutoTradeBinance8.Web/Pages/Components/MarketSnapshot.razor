@page "/market"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Demo
@using Binance.Net.Enums
@using VertexAutoTradeBinance8.Services
@inject MarketSnapshotFileService Service
@inject HistoricalDataReaderService HistoricalReader
@inject VertexAutoTradeBinance8.Configuration.ConfidenceResolver ConfidenceResolver
@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.Extensions.Options.IOptionsMonitor<VertexAutoTradeBinance8.Configuration.BinanceOptions> BinanceOpts
@inject MarketDataLiveState LiveState
@inject MissedTradeFileService SignalSvc
@inject BinanceClientFactory Factory
@inject VertexAutoTradeBinance8.Services.BinanceAlgoOrderService AlgoOrders
@inject VertexAutoTradeBinance8.Web.Services.BinanceTimeService BinanceTime
@inject VertexAutoTradeBinance8.Web.Services.DemoAccountService DemoAccount
@inject VertexAutoTradeBinance8.Web.Services.RealDcaHistoryReader RealDcaHistory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Market Intelligence — Vertex</PageTitle>

<div class="mk">

    <!-- HEADER -->
    <div class="mk-header">
        <div class="mk-title-block">
            <span class="mk-icon">📈</span>
            <div>
                <div class="mk-title">MARKET INTELLIGENCE</div>
                <div class="mk-sub">Candlestick · EMA · Bollinger · RSI · Volume</div>
            </div>
        </div>

        <div class="mk-hright">
            @if (_demoMode)
            {
                <div class="mk-hbal-strip">
                    <div class="mk-hbal-item">
                        <span class="mk-hbal-l">Demo Balance</span>
                        <span class="mk-hbal-v mono">$@_demoSnapshot.Balance.ToString("F2")</span>
                    </div>
                    <div class="mk-hbal-sep"></div>
                    <div class="mk-hbal-item">
                        <span class="mk-hbal-l">Demo Equity</span>
                        <span class="mk-hbal-v-main mono @(_demoUnrealizedTotal >= 0 ? "up" : "dn")">$@((_demoSnapshot.Balance + _demoUnrealizedTotal).ToString("F2"))</span>
                    </div>
                </div>
            }
            else
            {
                <div class="mk-hbal-strip">
                    <div class="mk-hbal-item">
                        <span class="mk-hbal-l">Wallet</span>
                        <span class="mk-hbal-v mono">$@_acctWalletBalance.ToString("F2")</span>
                    </div>
                    <div class="mk-hbal-sep"></div>
                    <div class="mk-hbal-item mk-hbal-item-avail">
                        <span class="mk-hbal-l mk-hbal-l-avail">Available</span>
                        <span class="mk-hbal-v-main mono">$@_acctAvailableBalance.ToString("F2")</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mk-sticky-top">
    <!-- LIVE SIGNALS — compact horizontal strip -->
    <div class="sig-panel">
            <div class="sig-panel-head">
                <div class="sig-panel-title">
                    <span class="sig-dot"></span>
                    LIVE SIGNALS
                    <span class="sig-count">@DisplayedSignals.Count</span>
                </div>
                <div class="mk-header-scan">
                    <span class="mk-header-scan-dot"></span>
                    Detecting
                    @if (_symbols.Any())
                    {
                        <span class="mk-header-scan-sym">@_symbols[_scanSymIdx % _symbols.Count]</span>
                    }
                </div>
            </div>
            <div class="sig-panel-right">
                    <div class="sig-pager @(DisplayedSignals.Count > _sigPageSize ? "" : "sig-pager-hidden")">
                        @for (int p = 0; p < _sigPageCount; p++)
                        {
                            int pageIdx = p;
                            <span class="sig-pager-dot @(pageIdx == _sigPage ? "active" : "")"
                                  @onclick="() => GoToSigPage(pageIdx)"></span>
                        }
                        <span class="sig-pager-label">@(_sigPage+1)/@_sigPageCount</span>
                    </div>
                    @if (!_showHiddenSignals)
                    {
                        <div class="sig-panel-sub">
                            @if (_signals.Any())
                            { <text>Click a signal to trade manually</text> }
                            else
                            { <text>No live signals — click History to see last hour</text> }
                        </div>
                    }
                    else
                    {
                        <div class="sig-panel-sub">Signal archive · last 1 hour</div>
                    }
                    <button class="sig-hidden-toggle @(_showHiddenSignals ? "sig-hidden-toggle-on" : "")"
                            @onclick="ToggleHiddenSignals"
                            title="@(_showHiddenSignals ? "Back to live signals" : "Show all signals from the last hour (archive)")">
                        @if (_showHiddenSignals)
                        {
                            <span>▶ Live</span>
                        }
                        else
                        {
                            <span>📋 History</span>
                            @if (_recentExpiredSignals.Count > 0)
                            {
                                <span class="sig-hidden-count">@_recentExpiredSignals.Count</span>
                            }
                        }
                    </button>
                </div>
            @if (DisplayedSignals.Any())
            {
            <div class="sig-cards" id="sigCardsScroll" @ref="_sigCardsEl">
                @foreach (var sig in DisplayedSignals)
                {
                    bool sigIsBuy = sig.Side?.ToUpper() == "BUY" || sig.Side?.ToUpper() == "LONG";
                    bool isActive = _activeSignal == sig;
                    decimal sigTp1 = sig.TakeProfits?.FirstOrDefault() ?? 0m;
                    decimal rr = sig.StopLoss > 0 && sig.Entry > 0 && sigTp1 > 0
                        ? Math.Abs(sigTp1 - sig.Entry) / Math.Abs(sig.StopLoss - sig.Entry)
                        : 0m;
                    int conf = sig.Confidence;

                    var (belowThreshold, lowRr, minRr) = IsWeakSignal(sig, conf, rr);

                    var ttl = GetSignalTtl(sig);
                    bool isRemoving = _expiredSignals.ContainsKey(SignalKey(sig));

                    <div class="sig-card @(sigIsBuy ? "sc-buy" : "sc-sell") @(isActive ? "sc-active" : "") @((belowThreshold || lowRr) ? "sc-below-threshold" : "") @(isRemoving ? "sc-removing" : ttl.IsExpiring ? "sc-fading" : "") @(_pinnedSignalKeys.Contains(SignalKey(sig)) ? "sc-pinned" : "")"
                         @key="SignalKey(sig)"
                         @onclick="() => SelectSignal(sig)">

                        @if (!_seenSignalKeys.Contains(SignalKey(sig)))
                        {
                            <span class="sc-new-dot" title="New signal — not yet viewed"></span>
                        }

                        <!-- COMPACT (always visible): symbol, side, time, confidence bar -->
                        <div class="sc-top">
                            <div class="sc-sym-wrap">
                                <span class="sc-sym">@sig.Symbol.Replace("USDT","")</span>
                                <span class="sc-usdt">USDT</span>
                            </div>
                            <span class="sc-side @(sigIsBuy ? "sc-side-b" : "sc-side-s")">
                                @(sigIsBuy ? "▲ LONG" : "▼ SHORT")
                            </span>
                            <button class="sc-pin-btn @(_pinnedSignalKeys.Contains(SignalKey(sig)) ? "sc-pin-btn-on" : "")"
                                    title="@(_pinnedSignalKeys.Contains(SignalKey(sig)) ? "Unpin (allow auto-collapse)" : "Pin (keep expanded)")"
                                    @onclick="() => TogglePinSignal(sig)" @onclick:stopPropagation="true">
                                📌
                            </button>
                            <span class="sc-ago">@FmtAgo(sig.Time)</span>
                        </div>
                        <div class="sc-conf-wrap">
                            <div class="sc-conf-bar" style="width:@conf%"
                                 style2="background:@(conf>=60?"var(--grn)":conf>=45?"var(--yel)":"var(--red)")"></div>
                        </div>
                        @if (belowThreshold || lowRr)
                        {
                            <div class="sc-warn-strip">
                                @if (belowThreshold) { <span>⚠ Below threshold</span> }
                                @if (lowRr) { <span>⚠ Weak R/R</span> }
                            </div>
                        }

                        <!-- EXPANDED: normally kept in DOM (off-screen via
                             display:none on the card itself) purely as a
                             content source for the JS-driven fixed overlay
                             (sig-card-hover.js) — that overlay only ever
                             supports one active card at a time though, so a
                             PINNED card instead renders this inline for
                             real (no display:none), achieved entirely via
                             Blazor state rather than the JS hover mechanism,
                             letting multiple cards stay expanded
                             simultaneously. -->
                        <div class="sc-expand @(_pinnedSignalKeys.Contains(SignalKey(sig)) ? "sc-expand-pinned" : "")"
                             id="sc-expand-@SignalKey(sig)"
                             style="@(_pinnedSignalKeys.Contains(SignalKey(sig)) ? "" : "display:none;")">
                            @if (belowThreshold)
                            {
                                <div class="sc-threshold-badge" title="@($"Confidence {conf}% is below this symbol's {(ConfidenceResolver.Resolve(sig.Symbol).MinEntry*100).ToString("F0")}% entry threshold — the bot would not have opened this trade")">
                                    ⚠ Below entry threshold
                                </div>
                            }
                            @if (lowRr)
                            {
                                <div class="sc-threshold-badge" title="@($"This trade risks more than it could gain compared to what the strategy normally requires in this market condition (needs at least {minRr:F1}x reward-to-risk here, this signal only offers {rr:F1}x)")">
                                    ⚠ Weak reward/risk (@(rr.ToString("F1"))x, needs @(minRr.ToString("F1"))x+)
                                </div>
                            }

                            <!-- Prices, all inline -->
                            <div class="sc-prices-row">
                                <div class="sc-p">
                                    <span class="sc-pl">Entry</span>
                                    <span class="sc-pv mono">@FmtP(sig.Entry)</span>
                                    @if (sig.EntryRangeLow.HasValue && sig.EntryRangeHigh.HasValue)
                                    {
                                        <span class="sc-entry-range mono" title="Acceptable entry zone — scale in anywhere within this range">(@FmtP(sig.EntryRangeLow.Value)–@FmtP(sig.EntryRangeHigh.Value))</span>
                                    }
                                </div>
                                <div class="sc-p"><span class="sc-pl">SL</span><span class="sc-pv mono dn">@FmtP(sig.StopLoss)</span></div>
                            </div>
                            @if (sig.TakeProfits != null && sig.TakeProfits.Count > 0)
                            {
                                <!-- ALL TP levels, not just the first — a
                                     signal carrying 2-4 TPs (common for
                                     this strategy) needs all of them
                                     visible to judge the full trade plan,
                                     not just where it first takes profit. -->
                                <div class="sc-prices-row sc-tp-row-all">
                                    @for (int tpI = 0; tpI < sig.TakeProfits.Count; tpI++)
                                    {
                                        var tpVal = sig.TakeProfits[tpI];
                                        <div class="sc-p">
                                            <span class="sc-pl">TP@(sig.TakeProfits.Count > 1 ? (tpI + 1).ToString() : "")</span>
                                            <span class="sc-pv mono up">@FmtP(tpVal)</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(sig.SmartType) || sig.Regime != VertexAutoTradeBinance8.Models.MarketRegime.Unknown)
                            {
                                <!-- Regime/strategy context — genuinely
                                     populated on every signal but
                                     previously never surfaced here, even
                                     though it's exactly the kind of
                                     context (trend vs range, which
                                     sub-strategy fired) a trader needs to
                                     judge whether to act on a signal. -->
                                <div class="sc-regime-row mk-dim">
                                    @if (sig.Regime != VertexAutoTradeBinance8.Models.MarketRegime.Unknown) { <span>@sig.Regime</span> }
                                    @if (!string.IsNullOrEmpty(sig.SmartType)) { <span>· @sig.SmartType</span> }
                                </div>
                            }

                            <!-- Footer: confidence/RR/ATR + TTL bar combined in one slim row -->
                            <div class="sc-foot">
                                <span class="sc-conf @(conf>=60?"up":conf>=45?"yel":"dn")">@conf%</span>
                                @if (rr > 0) { <span class="sc-rr">RR @rr.ToString("F1")</span> }
                                @if (sig.Reason != null && sig.Reason.Contains("_VWAP"))
                                {
                                    <span class="sc-confirm-badge" title="This signal's direction was confirmed by VWAP">VWAP✓</span>
                                }
                                @if (sig.Reason != null && sig.Reason.Contains("_HTF"))
                                {
                                    <span class="sc-confirm-badge" title="This signal's direction was confirmed by the higher-timeframe structure of the same symbol">HTF✓</span>
                                }
                                <span class="sc-atr mk-dim">ATR @FmtP(sig.ATR)</span>
                                <div class="sc-ttl-bar-wrap" title="Estimated relevance window based on volatility (ATR)">
                                    <div class="sc-ttl-bar @(ttl.IsExpiring ? "ttl-low" : ttl.Pct < 50 ? "ttl-mid" : "ttl-high")"
                                         style="width:@(ttl.Pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <span class="sc-ttl-label mk-dim">@ttl.Label</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            }
    </div> <!-- end sig-panel -->
    </div> <!-- end mk-sticky-top -->

    <!-- ROW 1: SYMBOL TICKER -->
    <div class="mk-ticker-bar">
        <div class="mk-ticker-scroll">
            @foreach (var sym in OrderedTickerSymbols)
            {
                var symSeries = Series.Where(s => s.Symbol == sym).ToList();
                var best = symSeries.OrderByDescending(s => s.Klines.Count).FirstOrDefault();
                var last  = best?.Klines.Count > 0 ? best.Klines[^1].Close : 0m;
                var first = best?.Klines.Count > 1 ? best.Klines[0].Close  : last;
                var chg   = first > 0 ? (last - first) / first * 100m : 0m;
                var isSel = sym == _activeSym;
                <button class="mk-tk @(isSel?"mk-tk-on":"")" @onclick="()=>PickSymAndTrade(sym, last)">
                    <span class="mk-tk-sym">@sym</span>
                    @if (last > 0)
                    {
                        <span class="mk-tk-price">@FmtP(last)</span>
                        <span class="mk-tk-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F1")%</span>
                    }
                </button>
            }
            @if (!Series.Any())
            {
                <span class="mk-dim" style="padding:0 16px;font-size:12px">No data — start the bot first</span>
            }
        </div>
    </div>

    @if (Selected != null && Selected.Klines.Count >= 5)
    {
        <!-- STATS BAR -->
        <div class="mk-stats">
            <div class="mk-s"><div class="mk-sl">PRICE</div><div class="mk-sv">@FmtP(_last)</div></div>
            <div class="mk-s"><div class="mk-sl">OPEN</div><div class="mk-sv mk-dim">@FmtP(Selected.Klines[^1].Open)</div></div>
            <div class="mk-s"><div class="mk-sl">HIGH</div><div class="mk-sv up">@FmtP(Selected.Klines[^1].High)</div></div>
            <div class="mk-s"><div class="mk-sl">LOW</div><div class="mk-sv dn">@FmtP(Selected.Klines[^1].Low)</div></div>
            <div class="mk-s"><div class="mk-sl">CHANGE</div><div class="mk-sv @(_chg>=0?"up":"dn")">@(_chg>=0?"+":"")@_chg.ToString("F2")%</div></div>
            <div class="mk-s"><div class="mk-sl">EMA21</div><div class="mk-sv" style="color:#38bdf8">@FmtP(_ema21)</div></div>
            <div class="mk-s"><div class="mk-sl">EMA55</div><div class="mk-sv" style="color:#a855f7">@FmtP(_ema55)</div></div>
            <div class="mk-s"><div class="mk-sl">ATR</div><div class="mk-sv">@FmtP(_atr)</div></div>
            <div class="mk-s"><div class="mk-sl">RSI</div>
                <div class="mk-sv @(_rsi>=70?"dn":_rsi<=30?"up":"")">
                    @_rsi.ToString("F1") @(_rsi>=70?"OB":_rsi<=30?"OS":"")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">TREND</div>
                <div class="mk-sv @(_last>_ema21?"up":"dn")">
                    @(_last>_ema21?"▲ BULL":"▼ BEAR")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">BARS</div><div class="mk-sv mk-dim">@Selected.Klines.Count</div></div>
            <div class="mk-s"><div class="mk-sl">VOLUME</div><div class="mk-sv mk-dim">@FmtV(Selected.Klines[^1].Volume)</div></div>
        </div>
    }

        <!-- ═══ CANVAS AREA — always rendered so canvas has real dimensions ═══ -->
    <div class="mk-charts-area">

        <!-- No-data overlay (canvas still renders behind for correct sizing) -->
        @if (Selected == null || Selected.Klines.Count < 5)
        {
            <div class="mk-no-data-overlay">
                <div style="font-size:36px">📊</div>
                <div style="font-size:15px;font-weight:600;margin-top:8px">Waiting for market data</div>
                <div class="mk-dim" style="font-size:11px;margin-top:4px">Engine writes klines_bootstrap.json on startup</div>
            </div>
        }
        else if (!_chartInitDone)
        {
            <div class="mk-no-data-overlay">
                <div style="font-size:24px">⏳</div>
                <div style="font-size:13px;margin-top:8px">Initializing chart…</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(_chartInitError))
        {
            <div class="mk-no-data-overlay" style="background:rgba(40,10,10,.92)">
                <div style="font-size:24px">⚠</div>
                <div style="font-size:13px;margin-top:8px;color:#ff4d6a">@_chartInitError</div>
            </div>
        }

        <div class="mk-body-grid mk-body-grid-with-panel">

        <!-- ALL INSTRUMENTS — relocated here per direct request, a
             dedicated left column, always visible (not collapsible,
             confirmed), independent of which panel (if any) is shown
             on the right. -->
        <div class="mk-side-tbl">
            <div class="mk-side-tbl-title">ALL INSTRUMENTS</div>
            <div class="mk-side-search-wrap">
                <span class="mk-side-search-icon">🔍</span>
                <input class="mk-side-search" type="text" placeholder="Search symbol…" title="Search instruments"
                       value="@_instrumentSearch" @oninput="OnInstrumentSearchChanged" />
                @if (!string.IsNullOrEmpty(_instrumentSearch))
                {
                    <button class="mk-side-search-clear" @onclick="ClearInstrumentSearch" title="Clear search">✕</button>
                }
            </div>
            @if (string.IsNullOrWhiteSpace(_instrumentSearch))
            {
                <div class="mk-side-tabs">
                    <button class="mk-side-tab @(_sideTblTab=="hot"?"mk-side-tab-on":"")" @onclick="SetSideTblTabHot">🔥 Hot</button>
                    <button class="mk-side-tab @(_sideTblTab=="gainers"?"mk-side-tab-on":"")" @onclick="SetSideTblTabGainers">📈 Gainers</button>
                    <button class="mk-side-tab @(_sideTblTab=="losers"?"mk-side-tab-on":"")" @onclick="SetSideTblTabLosers">📉 Losers</button>
                </div>
            }
            <div class="mk-side-tbl-scroll">
                @{
                    var allInstruments = Series
                        .GroupBy(x => x.Symbol)
                        .Select(g => g.OrderByDescending(x => x.Klines.Count).First())
                        .ToList();

                    var filtered = string.IsNullOrWhiteSpace(_instrumentSearch)
                        ? allInstruments
                        : allInstruments.Where(s => s.Symbol.Contains(_instrumentSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                    // Per direct request: an exchange-style tab system -
                    // Hot (top 7 by volume), Gainers (biggest % up),
                    // Losers (biggest % down) - only applies when not
                    // actively searching (search shows plain alphabetical
                    // matches, same as before). Open-position symbols
                    // always come first regardless of tab, matching the
                    // same priority treatment given to the maximized-mode
                    // symbol picker, since those are what the user is
                    // actively managing.
                    var sideOpenPosSymbols = DisplayedPositions.Select(p => p.Symbol).ToHashSet();

                    decimal ChgPct(MarketSeries s)
                    {
                        var last = s.Klines.Count > 0 ? s.Klines[^1].Close : 0m;
                        var open = s.Klines.Count > 0 ? s.Klines[0].Close : 0m;
                        return open > 0 ? (last - open) / open * 100m : 0m;
                    }

                    IEnumerable<MarketSeries> ordered;
                    int hotCount = 7;
                    if (!string.IsNullOrWhiteSpace(_instrumentSearch))
                    {
                        ordered = filtered.OrderBy(s => s.Symbol);
                    }
                    else if (_sideTblTab == "gainers")
                    {
                        ordered = filtered.OrderByDescending(s => sideOpenPosSymbols.Contains(s.Symbol)).ThenByDescending(s => ChgPct(s));
                    }
                    else if (_sideTblTab == "losers")
                    {
                        ordered = filtered.OrderByDescending(s => sideOpenPosSymbols.Contains(s.Symbol)).ThenBy(s => ChgPct(s));
                    }
                    else // hot
                    {
                        // Top 7 major symbols are always pinned at the very top
                        // (below open positions), regardless of tab or volume —
                        // these are the symbols users most often want quick access to.
                        // Slots 8–9 are filled by the single hottest symbol by volume
                        // that isn't already in the majors or open positions.
                        var topHot = filtered.OrderByDescending(s => s.Klines.Sum(k => k.Volume)).Take(hotCount).Select(s => s.Symbol).ToHashSet();
                        ordered = filtered
                            .OrderByDescending(s => sideOpenPosSymbols.Contains(s.Symbol))
                            .ThenBy(s =>
                            {
                                var idx = Array.IndexOf(MAJOR_SYMBOLS, s.Symbol);
                                return idx >= 0 ? idx : 999;
                            })
                            .ThenByDescending(s => topHot.Contains(s.Symbol) && !MAJOR_SYMBOLS.Contains(s.Symbol))
                            .ThenByDescending(s => (topHot.Contains(s.Symbol) && !MAJOR_SYMBOLS.Contains(s.Symbol)) ? s.Klines.Sum(k => k.Volume) : 0)
                            .ThenBy(s => s.Symbol);
                    }

                    int rank = 0;
                }
                @foreach (var s in ordered)
                {
                    rank++;
                    var last = s.Klines.Count > 0 ? s.Klines[^1].Close : 0m;
                    var chg  = ChgPct(s);
                    bool showRank = string.IsNullOrWhiteSpace(_instrumentSearch) && _sideTblTab == "hot"
                        && !sideOpenPosSymbols.Contains(s.Symbol) && rank <= hotCount + sideOpenPosSymbols.Count;
                    <div class="mk-side-row @(s.Symbol==_activeSym?"mk-side-row-sel":"")" id="sideRow-@s.Symbol" @onclick="()=>PickAndTrade(s)">
                        @if (sideOpenPosSymbols.Contains(s.Symbol))
                        {
                            <span class="mk-max-sym-pos-dot" title="Open position"></span>
                        }
                        else if (showRank)
                        {
                            <span class="mk-side-rank">@(rank - sideOpenPosSymbols.Count)</span>
                        }
                        <span class="mk-side-sym">@s.Symbol</span>
                        <span class="mk-side-price mono">@FmtP(last)</span>
                        <span class="mk-side-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F1")%</span>
                    </div>
                }
                @if (!ordered.Any())
                {
                    <div class="mk-side-empty">No instruments match "@_instrumentSearch"</div>
                }
            </div>
        </div> <!-- end mk-side-tbl -->

        <!-- LEFT: chart + RSI + Volume, then OPEN POSITIONS, then OPEN ORDERS — all share this one column's width -->
        <div class="mk-main-col">
        <div class="mk-charts-col-main">

        <!-- TIMEFRAME SELECTOR — moved here, directly above the chart -->
        @if (!string.IsNullOrEmpty(_activeSym))
        {
            <div class="mk-tf-bar mk-tf-bar-inline">
                @foreach (var tf in _allTfs)
                {
                    var hasSeries = Series.Any(s => s.Symbol == _activeSym && s.Timeframe == tf.Key)
                            // Also check the full datadb archive directly, not just the
                            // narrow klines_bootstrap.json snapshot Series is loaded from -
                            // confirmed via the user's real server that pinned symbols have
                            // archived data in datadb for timeframes (3m/2h/6h/12h/3D/1W)
                            // that klines_bootstrap.json simply doesn't carry, which is the
                            // actual reason these showed as permanently inactive.
                            || HistoricalReader.Has(_activeSym, TfLabel(tf.Key).ToLowerInvariant());
                    var isSelTf   = _activeTf == tf.Key;
                    <button class="mk-tf-btn @(isSelTf?"mk-tf-on":"") @(hasSeries?"":"mk-tf-dim")"
                            @onclick="()=>PickTf(tf.Key)">
                        @tf.Label
                    </button>
                }
            </div>
        }

        <!-- Price chart -->
        <div class="mk-chart-head">
            <div class="mk-chart-head-left">
            <div class="mk-max-sym-wrap">
                <button class="mk-max-sym" @onclick="ToggleMaxSymPicker">
                    @(Selected?.Symbol ?? "")
                    <span class="mk-max-tf">@TfLabel(Selected?.Timeframe ?? "")</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mk-max-sym-caret"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                @if (_maxSymPickerOpen)
                {
                    <div class="mk-max-sym-dropdown">
                        <input class="mk-max-sym-search" type="text" placeholder="Search symbol…"
                               value="@_instrumentSearch" @oninput="OnInstrumentSearchChanged" autofocus />
                        <div class="mk-max-sym-list">
                            @{
                                var stdAllInstruments = Series
                                    .GroupBy(x => x.Symbol)
                                    .Select(g => g.OrderByDescending(x => x.Klines.Count).First())
                                    .ToList();
                                var stdFiltered = string.IsNullOrWhiteSpace(_instrumentSearch)
                                    ? stdAllInstruments
                                    : stdAllInstruments.Where(s => s.Symbol.Contains(_instrumentSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                // Per direct request: symbols with an open position
                                // always come first, before the regular alphabetical
                                // order for everything else.
                                var stdOpenPosSymbols = DisplayedPositions.Select(p => p.Symbol).ToHashSet();
                                var stdOrdered = stdFiltered
                                    .OrderByDescending(s => stdOpenPosSymbols.Contains(s.Symbol))
                                    .ThenBy(s => s.Symbol)
                                    .ToList();
                            }
                            @foreach (var s in stdOrdered)
                            {
                                var last = s.Klines.Count > 0 ? s.Klines[^1].Close : 0m;
                                <div class="mk-max-sym-row @(s.Symbol==_activeSym?"mk-max-sym-row-sel":"")"
                                     @onclick="() => PickSymInMaximize(s.Symbol)">
                                    @if (stdOpenPosSymbols.Contains(s.Symbol))
                                    {
                                        <span class="mk-max-sym-pos-dot" title="Open position"></span>
                                    }
                                    <span>@s.Symbol</span>
                                    <span class="mono mk-dim">@FmtP(last)</span>
                                </div>
                            }
                            @if (!stdFiltered.Any())
                            {
                                <div class="mk-side-empty">No match</div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="mk-max-price @(_chg >= 0 ? "up" : "dn")">@FmtP(_last)</div>

            @if (_chartMaximized)
            {
                <div class="mk-max-trade">
                    <input class="mk-max-qty mono" type="number" title="Quantity"
                           value="@(_orderQty > 0 ? _orderQty.ToString("G8") : "")"
                           @onchange="OnQtyChange" placeholder="Qty" />
                    <button class="mk-max-buy" disabled="@_orderLoading" @onclick="() => QuickMarketOrder(true)">Buy</button>
                    <button class="mk-max-sell" disabled="@_orderLoading" @onclick="() => QuickMarketOrder(false)">Sell</button>
                </div>
            }

            <button class="mk-btn mk-btn-inline @(Frozen?"mk-btn-on":"")" @onclick="ToggleFreeze">
                @(Frozen ? "⏸ Paused" : "▶ Live")
            </button>
            </div>
        <div class="mk-legend">
                <span style="color:#38bdf8">── EMA21</span>
                <span style="color:#a855f7">── EMA55</span>
                <span style="color:#ef4444">RSI · ── OB 70 / OS 30</span>
            </div>
            <button class="mk-chart-maximize" @onclick="ToggleChartMaximized" title="Maximize chart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>

        @if (_chartMaximized)
        {
            <div class="mk-chart-maximize-backdrop" @onclick="ToggleChartMaximized"></div>
        }

        <!-- SINGLE persistent chart container — never destroyed or
             recreated by the maximize toggle. Only the wrapping CSS
             class changes (adds position:fixed etc), which Lightweight
             Charts' own autoSize ResizeObserver picks up on its own.
             Previously this used two separate container elements in
             an if/else branch, which meant Blazor actually destroyed
             and recreated the DOM node on every toggle — Lightweight
             Charts kept its session bound to the now-detached old
             node, leaving the chart blank until a full page reload
             forced re-initialization from scratch. -->
        <div class="mk-chart-container-wrap @(_chartMaximized ? "mk-chart-maximized" : "")">
            @if (_chartMaximized)
            {
                <div class="mk-max-bar">
                    <button class="mk-max-restore" @onclick="ToggleChartMaximized" title="Restore">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Restore
                    </button>
                </div>

                <div class="mk-max-tf-row">
                    @foreach (var tf in _allTfs)
                    {
                        var hasSeries = Series.Any(s => s.Symbol == _activeSym && s.Timeframe == tf.Key)
                            // Also check the full datadb archive directly, not just the
                            // narrow klines_bootstrap.json snapshot Series is loaded from -
                            // confirmed via the user's real server that pinned symbols have
                            // archived data in datadb for timeframes (3m/2h/6h/12h/3D/1W)
                            // that klines_bootstrap.json simply doesn't carry, which is the
                            // actual reason these showed as permanently inactive.
                            || HistoricalReader.Has(_activeSym, TfLabel(tf.Key).ToLowerInvariant());
                        var isSelTf   = _activeTf == tf.Key;
                        <button class="mk-tf-btn @(isSelTf?"mk-tf-on":"") @(hasSeries?"":"mk-tf-dim")"
                                @onclick="()=>PickTf(tf.Key)">
                            @tf.Label
                        </button>
                    }
                </div>

                @if (DisplayedPositions.Count > 0)
                {
                    <!-- Per direct request: quick position switcher in
                         maximized mode - lets the user flip between
                         everything currently open without leaving
                         maximized mode. New, separate block; doesn't
                         touch the TF row or restore bar above it. -->
                    <div class="mk-max-pos-row">
                        @foreach (var p in DisplayedPositions)
                        {
                            <button class="mk-max-pos-pill @(p.Side == "LONG" ? "mk-max-pos-long" : "mk-max-pos-short") @(PosIdentityEquals(_selectedPosition, p) ? "mk-max-pos-active" : "")"
                                    @onclick="() => SelectPosition(p)">
                                <span class="mk-max-pos-side">@(p.Side == "LONG" ? "▲" : "▼")</span>
                                @p.Symbol.Replace("USDT","")
                                <span class="mk-max-pos-pnl @(p.Pnl >= 0 ? "up" : "dn")">@(p.Pnl >= 0 ? "+" : "")@p.Pnl.ToString("F2")</span>
                            </button>
                        }
                    </div>
                }
            }
            <div id="chartContainer-@_chartInstanceId" @key="_chartInstanceId" style="width:100%;height:@(_chartMaximized ? $"calc(100% - {(DisplayedPositions.Count > 0 ? 126 : 88)}px)" : "100%");"></div>

            @if (_selectedPosition != null)
            {
            <!-- position exists — chart lines active -->
            }
            <!-- Drawing tools toolbar is injected by chart-drawing-tools.js
                 via injectToolbar(containerId) during chartDrawingTools.init().
                 It is self-contained with its own buttons, state, and event listeners.
                 We make it draggable after init via InitDraggableElementsAsync(). -->

            <!-- TP/SL toggle button — draggable, outside mk-tpsl-overlay -->
            <div class="mk-tpsl-btn-wrapper" id="mk-tpsl-btn-wrapper">
                <div class="mk-tpsl-drag-grip" title="Drag to move">
                    <span></span><span></span><span></span>
                </div>
                <button class="mk-tpsl-btn @(_tpSlEditMode ? "mk-tpsl-btn-on" : "")" @onclick="ToggleTpSlEdit" title="Show/hide existing TP/SL lines">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6M9 8h6M17 16h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    TP/SL
                </button>
            </div>
            <div class="mk-tpsl-overlay">
                </div>
            }
        </div>

        <div class="mk-hints">
            <span>🖱 Drag to pan</span>
            <span>⚲ Scroll to zoom</span>
            <span>🖱 Right-click to pick a price</span>
        </div>

        @* ── TP Percent Modal ─────────────────────────────────────── *@
        @if (_tpModalOpen)
        {
            <div class="vx-modal-backdrop" @onclick="TpModalCancel">
                <div class="vx-modal" @onclick:stopPropagation="true">
                    <div class="vx-modal-header">
                        <div class="vx-modal-icon">🎯</div>
                        <div>
                            <div class="vx-modal-title">Set Take Profit</div>
                            <div class="vx-modal-sub">How much of the position to close at this level?</div>
                        </div>
                        <button class="vx-modal-close" @onclick="TpModalCancel">×</button>
                    </div>

                    <div class="vx-modal-body">
                        <div class="vx-modal-label">Close % of position</div>
                        <div class="vx-modal-input-row">
                            <input class="vx-modal-input"
                                   type="number" min="1" max="100" step="1"
                                   @bind="_tpModalPctStr"
                                   @bind:event="oninput"
                                   @onkeydown="@(async (e) => { if (e.Key == "Enter") TpModalConfirm(); if (e.Key == "Escape") TpModalCancel(); })"
                                   placeholder="e.g. 35"
                                   autofocus />
                            <span class="vx-modal-input-sfx">%</span>
                        </div>

                        <div class="vx-modal-presets">
                            @foreach (var p in new[] { 25, 33, 50, 75, 100 })
                            {
                                var pCopy = p;
                                <button class="vx-modal-preset @(_tpModalPctStr == pCopy.ToString() ? "vx-modal-preset-on" : "")"
                                        @onclick="() => { _tpModalPctStr = pCopy.ToString(); }">@p%</button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_tpModalError))
                        {
                            <div class="vx-modal-error">@_tpModalError</div>
                        }
                    </div>

                    <div class="vx-modal-footer">
                        <button class="vx-modal-cancel" @onclick="TpModalCancel">Cancel</button>
                        <button class="vx-modal-confirm" @onclick="TpModalConfirm">Set TP</button>
                    </div>
                </div>
            </div>
        }

        </div> <!-- end mk-charts-col-main -->

        <!-- ACCOUNT SUMMARY — margin balance, today's realized PnL,
             wallet balance, unrealized PnL, open positions count+total.
             Compact, single row, sits right above the positions table. -->
        <div class="mk-acct-summary">
            @if (_demoMode)
            {
            <div class="mk-acct-item">
                <div class="mk-acct-label">Demo Balance</div>
                <div class="mk-acct-value mono">$@_demoSnapshot.Balance.ToString("F2")</div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Realized PnL (demo)</div>
                @{ var demoRealized = _demoSnapshot.History.Sum(t => t.RealizedPnl); }
                <div class="mk-acct-value mono @(demoRealized >= 0 ? "up" : "dn")">
                    @(demoRealized >= 0 ? "+" : "")@demoRealized.ToString("F2")
                </div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Demo Equity</div>
                <div class="mk-acct-value mono @(_demoUnrealizedTotal >= 0 ? "up" : "dn")">
                    $@((_demoSnapshot.Balance + _demoUnrealizedTotal).ToString("F2"))
                </div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Unrealized PnL</div>
                <div class="mk-acct-value mono @(_demoUnrealizedTotal >= 0 ? "up" : "dn")">
                    @(_demoUnrealizedTotal >= 0 ? "+" : "")@_demoUnrealizedTotal.ToString("F2")
                </div>
            </div>
            }
            else
            {
            <div class="mk-acct-item">
                <div class="mk-acct-label">Margin Balance</div>
                <div class="mk-acct-value mono">$@_acctMarginBalance.ToString("F2")</div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Realized PnL (today)</div>
                <div class="mk-acct-value mono @(_acctRealizedPnlToday >= 0 ? "up" : "dn")">
                    @(_acctRealizedPnlToday >= 0 ? "+" : "")@_acctRealizedPnlToday.ToString("F2")
                </div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Wallet Balance</div>
                <div class="mk-acct-value mono">$@_acctWalletBalance.ToString("F2")</div>
            </div>
            <div class="mk-acct-item">
                <div class="mk-acct-label">Unrealized PnL</div>
                <div class="mk-acct-value mono @(_acctUnrealizedPnl >= 0 ? "up" : "dn")">
                    @(_acctUnrealizedPnl >= 0 ? "+" : "")@_acctUnrealizedPnl.ToString("F2")
                </div>
            </div>
            }
            <div class="mk-acct-item">
                <div class="mk-acct-label">Open Positions</div>
                <div class="mk-acct-value mono">@DisplayedPositions.Count <span class="mk-acct-sub">($@DisplayedPositions.Sum(p => p.Size).ToString("F2"))</span></div>
            </div>
        </div>

        <!-- OPEN POSITIONS / OPEN ORDERS — tabbed, share one panel -->
        <div class="mk-oo-panel" id="mkOoPanel">
            <div class="mk-oo-tabs">
                <button class="mk-oo-tab @(_ooActiveTab == "positions" ? "mk-oo-tab-on" : "")"
                        @onclick="ShowPositionsTab">
                    Positions
                    <span class="mk-oo-count">@DisplayedPositions.Count</span>
                </button>
                <button class="mk-oo-tab @(_ooActiveTab == "orders" ? "mk-oo-tab-on" : "")"
                        @onclick="ShowOrdersTab">
                    Orders
                    <span class="mk-oo-count">@(_demoMode ? _demoSnapshot.PendingOrders.Count : _openOrders.Count)</span>
                </button>
                <button class="mk-oo-tab @(_ooActiveTab == "history" ? "mk-oo-tab-on" : "")"
                        @onclick="ShowHistoryTab">
                    History
                    <span class="mk-oo-count">@(_demoMode ? _demoSnapshot.History.Count : _realHistory.Count)</span>
                </button>
                <span class="mk-oo-mode-badge @(_demoMode ? "mk-oo-mode-demo" : "mk-oo-mode-live")">
                    @(_demoMode ? "DEMO" : "LIVE")
                </span>
            </div>

            @if (_ooActiveTab == "history")
            {
                <div class="mk-pos-toolbar">
                    <label class="mk-pos-filter-cb">
                        <input type="checkbox" @bind="_posFilterCurrentSym" /> Only <strong>@_activeSym</strong>
                    </label>
                </div>
                @if (_demoMode)
                {
                    @if (_demoSnapshot.History.Count == 0)
                    {
                        <div class="mk-oo-empty">No closed demo trades yet</div>
                    }
                    else
                    {
                        <table class="mk-pos-table">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Entry</th><th>Exit</th>
                                    <th>PnL</th><th>Reason</th><th>Closed</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                    var histFiltered = (_posFilterCurrentSym && !string.IsNullOrEmpty(_activeSym))
                        ? _demoSnapshot.History.Where(t => t.Symbol == _activeSym).ToList()
                        : (IEnumerable<object>)_demoSnapshot.History;
                }
                @foreach (var t in _demoSnapshot.History
                    .Where(t => !_posFilterCurrentSym || string.IsNullOrEmpty(_activeSym) || t.Symbol == _activeSym)
                    .OrderByDescending(t => t.ClosedAtUtc))
                                {
                                    <tr>
                                        <td>@t.Symbol.Replace("USDT","")</td>
                                        <td class="@(t.Side == "LONG" ? "up" : "dn")">@t.Side</td>
                                        <td class="mk-mono">@FmtP(t.EntryPrice)</td>
                                        <td class="mk-mono">@FmtP(t.ExitPrice)</td>
                                        <td class="mk-mono @(t.RealizedPnl >= 0 ? "up" : "dn")">@(t.RealizedPnl >= 0 ? "+" : "")@t.RealizedPnl.ToString("F2")</td>
                                        <td class="mk-dim">@t.CloseReason</td>
                                        <td class="mk-dim">@t.ClosedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                        <td>
                                            <button class="mk-oo-cancel"
                                                    @onclick="@(() => OpenShareCardFromHistory(t))">Share</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else
                {
                    // Real-mode history is loaded on demand (per-symbol
                    // API calls, unlike demo's always-in-memory list) -
                    // reuses the exact same GetUserTradesAsync pattern
                    // already established in Positions.razor.
                    @if (_realHistoryLoading)
                    {
                        <div class="mk-oo-empty">Loading trade history…</div>
                    }
                    else if (_realHistory.Count == 0)
                    {
                        <div class="mk-oo-empty">
                            No closed trade history loaded yet.
                            <button class="mk-oo-cancel" @onclick="LoadRealHistoryAsync">Load</button>
                        </div>
                    }
                    else
                    {
                        <table class="mk-pos-table">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Price</th><th>Qty</th>
                                    <th>PnL</th><th>Fee</th><th>Closed</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in _realHistory
                                    .Where(t => !_posFilterCurrentSym || string.IsNullOrEmpty(_activeSym) || t.Symbol == _activeSym))
                                {
                                    <tr>
                                        <td>@t.Symbol.Replace("USDT","")</td>
                                        <td class="@(t.Side == "BUY" ? "up" : "dn")">@t.Side</td>
                                        <td class="mk-mono">@FmtP(t.Price)</td>
                                        <td class="mk-mono">@t.Qty.ToString("G8")</td>
                                        <td class="mk-mono @(t.RealizedPnl >= 0 ? "up" : "dn")">@(t.RealizedPnl >= 0 ? "+" : "")@t.RealizedPnl.ToString("F2")</td>
                                        <td class="mk-dim">@t.Fee.ToString("F4")</td>
                                        <td class="mk-dim">@t.Time.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                        <td>
                                            <button class="mk-oo-cancel" @onclick="@(() => OpenShareCardFromRealHistory(t))">Share</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button class="mk-oo-cancel" style="margin-top:8px" @onclick="LoadRealHistoryAsync">Refresh</button>
                    }
                }
            }

            @if (_ooActiveTab == "positions")
            {
                @if (DisplayedPositions.Count == 0)
                {
                    <div class="mk-oo-empty">No open positions</div>
                }
                else
                {
                    <div class="mk-oo-scroll">
                        <div class="mk-pos-toolbar">
                            <label class="mk-pos-filter-cb">
                                <input type="checkbox" @bind="_posFilterCurrentSym" /> Only <strong>@_activeSym</strong>
                            </label>
                            <div class="mk-pos-sort-btns">
                                <span class="mk-dim" style="font-size:11px">Sort:</span>
                                @foreach (var (field, label) in new[]{("sym","Symbol"),("pnl","PnL"),("roi","ROI"),("size","Size")})
                                {
                                    <button class="mk-sort-btn @(_posSortField==field?"mk-sort-btn-on":"")"
                                            @onclick="() => SetPosSort(field)">
                                        @label @(_posSortField==field ? (_posSortAsc?"↑":"↓") : "")
                                    </button>
                                }
                            </div>
                        </div>
                        <table class="mk-oo-tbl">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Lev</th>
                                    <th>Entry</th><th>Mark</th><th>Liq</th><th>Size</th><th>Margin</th><th>PnL</th><th>ROI</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    // Computed once before the loop, not per-row - avoids
                                    // redundant file reads/snapshot copies on every iteration.
                                    // Per direct request: a small "(DCA)" hint on a position's
                                    // row when that symbol was recently bought via DCA (the
                                    // exchange itself has no way to distinguish a DCA buy from
                                    // a regular one once they're merged into the same position,
                                    // so this cross-references the separate DCA purchase
                                    // history instead). Bounded to the last 7 days so the hint
                                    // doesn't linger forever on a position that received a DCA
                                    // buy long ago and has since been actively traded normally.
                                    var dcaCutoff = DateTime.UtcNow.AddDays(-7);
                                    HashSet<string> recentDcaSymbols;
                                    if (_demoMode)
                                    {
                                        recentDcaSymbols = DemoAccount.GetDcaSnapshot().History
                                            .Where(h => h.TimeUtc >= dcaCutoff).Select(h => h.Symbol).ToHashSet();
                                    }
                                    else
                                    {
                                        recentDcaSymbols = RealDcaHistory.Read().History
                                            .Where(h => h.TimeUtc >= dcaCutoff).Select(h => h.Symbol).ToHashSet();
                                    }
                                }
                                @{
                                    // Apply filter (current symbol only) + sort
                                    var posToShow = _posFilterCurrentSym && !string.IsNullOrEmpty(_activeSym)
                                        ? DisplayedPositions.Where(p => p.Symbol == _activeSym).ToList()
                                        : DisplayedPositions;
                                    posToShow = _posSortField switch {
                                        "sym"  => _posSortAsc ? posToShow.OrderBy(p=>p.Symbol).ToList() : posToShow.OrderByDescending(p=>p.Symbol).ToList(),
                                        "roi"  => _posSortAsc ? posToShow.OrderBy(p=>p.Roi).ToList() : posToShow.OrderByDescending(p=>p.Roi).ToList(),
                                        "size" => _posSortAsc ? posToShow.OrderBy(p=>p.Size).ToList() : posToShow.OrderByDescending(p=>p.Size).ToList(),
                                        _      => _posSortAsc ? posToShow.OrderBy(p=>p.Pnl).ToList() : posToShow.OrderByDescending(p=>Math.Abs(p.Pnl)).ToList(),
                                    };
                                }
                                @foreach (var pos in posToShow)
                                {
                                    <tr class="mk-pos-row @(PosIdentityEquals(_selectedPosition, pos) ? "mk-pos-row-sel" : "") @(PosIdentityEquals(_selectingPosition, pos) ? "mk-pos-row-loading" : "")"
                                        @onclick="() => SelectPosition(pos)">
                                        <td class="mk-oo-sym">
                                            @pos.Symbol
                                            @if (recentDcaSymbols.Contains(pos.Symbol))
                                            {
                                                <span class="mk-dca-badge" title="Position includes a DCA accumulation buy within the last 7 days">DCA</span>
                                            }
                                            @if (PosIdentityEquals(_selectingPosition, pos))
                                            {
                                                <span class="mk-pos-spin">⟳</span>
                                            }
                                        </td>
                                        <td class="@(pos.Side == "LONG" ? "up" : "dn")">@pos.Side</td>
                                        <td @onclick:stopPropagation="true" style="padding:4px 8px;">
                                            <button class="mk-lev-chip" title="Change leverage"
                                                    @onclick="() => OpenLevEditor(pos)">@pos.Leverage× ✎</button>
                                        </td>
                                        <td class="mk-mono">@FmtP(pos.EntryPrice)</td>
                                        <td class="mk-mono">@FmtP(pos.MarkPrice)</td>
                                        <td class="mk-mono mk-liq">@(pos.LiqPrice > 0 ? FmtP(pos.LiqPrice) : "—")</td>
                                        <td class="mk-mono">@pos.Size.ToString("F2")</td>
                                        <td class="mk-mono mk-dim">@pos.Margin.ToString("F2")</td>
                                        <td class="mk-mono @(pos.Pnl >= 0 ? "up" : "dn")">@(pos.Pnl >= 0 ? "+" : "")@pos.Pnl.ToString("F2")</td>
                                        <td class="mk-mono @(pos.Roi >= 0 ? "up" : "dn")">@(pos.Roi >= 0 ? "+" : "")@((pos.Roi * 100).ToString("F1"))%</td>
                                        <td class="mk-pos-actions" @onclick:stopPropagation="true">
                                            @if (_partialCloseOpenKey != $"{pos.Symbol}:{pos.Side}")
                                            {
                                                <button class="mk-pos-partial-btn2" disabled="@_orderLoading"
                                                        @onclick="() => OpenPartialClose(pos)">⅟₂ Partial</button>
                                                <button class="mk-pos-close-btn" disabled="@_orderLoading"
                                                        @onclick="() => ClosePositionRow(pos)">
                                                    @(_orderLoading ? "…" : "Close")
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="mk-partial-slider-box">
                                                    <div class="mk-partial-slider-row">
                                                        <input type="range" min="1" max="100" step="1"
                                                               value="@_partialClosePct"
                                                               @oninput="@(e => OnPartialClosePctChanged(e, pos))"
                                                               class="mk-partial-slider" />
                                                        <span class="mk-partial-pct mono">@_partialClosePct%</span>
                                                    </div>
                                                    <div class="mk-partial-preview">
                                                        @{
                                                            decimal previewQty = pos.Qty * (_partialClosePct / 100m);
                                                            decimal dir = pos.Side == "LONG" ? 1m : -1m;
                                                            decimal previewPnl = (pos.MarkPrice - pos.EntryPrice) * dir * previewQty;
                                                        }
                                                        <span class="mk-dim">Closing @previewQty.ToString("G8") → PnL</span>
                                                        <span class="mono @(previewPnl >= 0 ? "up" : "dn")">@(previewPnl >= 0 ? "+" : "")@previewPnl.ToString("F2")</span>
                                                    </div>
                                                    <div class="mk-partial-actions">
                                                        <button class="mk-oo-cancel" @onclick="ClosePartialCloseSlider">Cancel</button>
                                                        <button class="mk-oo-cancel mk-partial-confirm" disabled="@_orderLoading"
                                                                @onclick="() => ConfirmPartialClose(pos)">
                                                            @if (_orderLoading) { <span class="ord-spin"></span> } else { @($"Close {_partialClosePct}%") }
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (_demoMode)
                {
                    @if (_demoSnapshot.PendingOrders.Count == 0)
                    {
                        <div class="mk-oo-empty">No open demo orders</div>
                    }
                    else
                    {
                        <div class="mk-oo-scroll">
                            <table class="mk-oo-tbl">
                                <thead>
                                    <tr>
                                        <th>Symbol</th><th>Side</th><th>Type</th>
                                        <th>Trigger</th><th>Qty</th><th>Lev</th><th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in _demoSnapshot.PendingOrders)
                                    {
                                        <tr>
                                            <td class="mk-oo-sym">@o.Symbol</td>
                                            <td class="@(o.Side == "LONG" ? "up" : "dn")">@o.Side</td>
                                            <td class="mk-dim">@(o.Type == DemoOrderType.Limit ? "LIMIT" : "STOP_MARKET")</td>
                                            <td class="mk-mono">@FmtP(o.TriggerPrice)</td>
                                            <td class="mk-mono">@o.Qty.ToString("G8")</td>
                                            <td class="mk-dim">@o.Leverage×</td>
                                            <td>
                                                <button class="mk-oo-cancel" @onclick="() => CancelDemoPendingOrder(o.Id)">
                                                    Cancel
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                @if (!string.IsNullOrEmpty(_lastAlgoOrdersDebug))
                {
                    <div class="mk-algo-debug">⚙ Algo orders fetch: @_lastAlgoOrdersDebug</div>
                }
                @if (_openOrders.Count == 0)
                {
                    <div class="mk-oo-empty">No open orders</div>
                }
                else
                {
                    <div class="mk-oo-scroll">
                        <!-- Filter + sub-tabs: Standard / Algo -->
                        <div class="mk-pos-toolbar">
                            <label class="mk-pos-filter-cb">
                                <input type="checkbox" @bind="_posFilterCurrentSym" /> Only <strong>@_activeSym</strong>
                            </label>
                            <div class="mk-ord-subtabs">
                                <button class="mk-ord-subtab @(_ordSubTab=="standard"?"mk-ord-subtab-on":"")" @onclick='()=>_ordSubTab="standard"'>Standard</button>
                                <button class="mk-ord-subtab @(_ordSubTab=="algo"?"mk-ord-subtab-on":"")" @onclick='()=>_ordSubTab="algo"'>Algo (TP/SL)</button>
                            </div>
                        </div>
                        @{
                            var ordersFiltered = (_posFilterCurrentSym && !string.IsNullOrEmpty(_activeSym))
                                ? _openOrders.Where(o => o.Symbol == _activeSym).ToList()
                                : _openOrders;
                            // Split: algo = TP/SL orders (ReduceOnly conditional), standard = everything else
                            bool isAlgoOrder(OpenOrderRow o) => o.Type.Contains("TAKE_PROFIT") || o.Type.Contains("STOP") || o.ReduceOnly;
                            var standardOrders = ordersFiltered.Where(o => !isAlgoOrder(o)).ToList();
                            var algoOrders    = ordersFiltered.Where(o =>  isAlgoOrder(o)).ToList();
                            var ordersToShow  = _ordSubTab == "algo" ? algoOrders : standardOrders;
                        }
                        <table class="mk-oo-tbl">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Type</th>
                                    <th>Price</th><th>Qty</th><th>Filled</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ordersToShow.Count == 0)
                                {
                                    <tr><td colspan="7" class="mk-oo-empty">No @_ordSubTab orders@(_posFilterCurrentSym ? $" for {_activeSym}" : "")</td></tr>
                                }
                                @foreach (var o in ordersToShow)
                                {
                                    bool isEditing = _editingOrderId == o.OrderId.ToString();
                                    <tr class="mk-oo-row-clickable @(isEditing ? "mk-oo-editing" : "")" @onclick="() => PickSym(o.Symbol)">
                                        <td class="mk-oo-sym">@o.Symbol</td>
                                        <td class="@(o.Side == "BUY" ? "up" : "dn")">@o.Side</td>
                                        <td class="mk-dim" style="font-size:11px">@o.Type @(o.ReduceOnly ? "(R)" : "")</td>
                                        @* ── Price cell ── *@
                                        <td @onclick:stopPropagation="true">
                                            @if (isEditing)
                                            {
                                                <input class="mk-oo-edit-input" type="number" step="any"
                                                       @bind="_editPrice" @bind:event="oninput"
                                                       @onkeydown="@(async (e) => { if (e.Key=="Enter") await SaveOrderEditAsync(o); if (e.Key=="Escape") CancelOrderEdit(); })"
                                                       placeholder="Price" />
                                            }
                                            else
                                            {
                                                <span class="mk-mono mk-oo-editable-val" title="Click Edit to modify">
                                                    @(o.Price > 0 ? FmtP(o.Price) : "Market")
                                                </span>
                                            }
                                        </td>
                                        @* ── Qty cell ── *@
                                        <td @onclick:stopPropagation="true">
                                            @if (isEditing)
                                            {
                                                <input class="mk-oo-edit-input" type="number" step="any"
                                                       @bind="_editQty" @bind:event="oninput"
                                                       @onkeydown="@(async (e) => { if (e.Key=="Enter") await SaveOrderEditAsync(o); if (e.Key=="Escape") CancelOrderEdit(); })"
                                                       placeholder="Qty" />
                                            }
                                            else
                                            {
                                                <span class="mk-mono mk-oo-editable-val">@o.Qty.ToString("G8")</span>
                                            }
                                        </td>
                                        <td class="mk-mono mk-dim">@o.Filled.ToString("G8")</td>
                                        <td @onclick:stopPropagation="true" style="display:flex;gap:4px;align-items:center;white-space:nowrap">
                                            @if (isEditing)
                                            {
                                                <button class="mk-oo-save" disabled="@_editSaving"
                                                        @onclick="() => SaveOrderEditAsync(o)">
                                                    @(_editSaving ? "…" : "✓ Save")
                                                </button>
                                                <button class="mk-oo-edit-cancel" @onclick="CancelOrderEdit">✕</button>
                                                @if (!string.IsNullOrEmpty(_editError))
                                                { <span class="mk-oo-edit-err">@_editError</span> }
                                            }
                                            else
                                            {
                                                <button class="mk-oo-edit-btn" title="Edit price / qty"
                                                        @onclick="() => StartOrderEdit(o)">
                                                    ✎ Edit
                                                </button>
                                                <button class="mk-oo-fill-now" title="Execute at market now"
                                                        disabled="@(_cancellingOrderId == o.OrderId)"
                                                        @onclick="() => FillOrderAtMarketAsync(o)">⚡ Fill Now</button>
                                                <button class="mk-oo-cancel" disabled="@(_cancellingOrderId == o.OrderId)"
                                                        @onclick="() => CancelOpenOrderAsync(o)">
                                                    @(_cancellingOrderId == o.OrderId ? "…" : "Cancel")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                }
            }
        </div>

        </div> <!-- end mk-main-col -->

        <div class="mk-charts-col-side">

        @if (_activeSignal != null)
        {
            // TRADE ORDER PANEL (right sidebar, exchange-style)
            bool isBuy = _activeSignal.Side?.ToUpper() == "BUY" || _activeSignal.Side?.ToUpper() == "LONG";
            decimal tp1 = _activeSignal.TakeProfits?.FirstOrDefault() ?? 0m;
            <div class="ord-panel @(_demoMode ? "ord-panel-demo" : "")">
                <div class="ord-head">
                    <div class="ord-title">
                        @if (_activeSignal.Confidence > 0)
                        {
                            <span class="sc-side @(isBuy?"sc-side-b":"sc-side-s") ord-badge">
                                @(isBuy ? "▲ LONG" : "▼ SHORT")
                            </span>
                        }
                        else
                        {
                            <span class="ord-manual-badge">Manual Trade</span>
                        }
                        <span class="ord-sym">@_activeSignal.Symbol</span>
                    </div>
                    @if (_selectedPositionForSameSymbol(_activeSignal.Symbol) != null)
                    {
                        var collapseTitle = _manualTradeCollapsed ? "Expand" : "Collapse";
                        <button class="ord-collapse-btn" @onclick="ToggleManualTradeCollapsed" title="@collapseTitle">
                            @(_manualTradeCollapsed ? "▾" : "▴")
                        </button>
                    }
                    <button class="ord-close-x" @onclick="ClosePanel">✕</button>
                </div>

                @if (!_manualTradeCollapsed)
                {

                <!-- Available balance — DEMO uses demo balance, LIVE uses acct available -->
                <div class="ord-balance-row">
                    <span class="ord-balance-l">Available</span>
                    @if (_demoMode)
                    {
                        <span class="ord-balance-v mono">$@_demoSnapshot.Balance.ToString("F2")</span>
                        <span class="ord-balance-sub mk-dim">Demo account</span>
                    }
                    else
                    {
                        <span class="ord-balance-v mono">$@_acctAvailableBalance.ToString("F2")</span>
                        @if (_acctMarginBalance != _acctWalletBalance)
                        {
                            <span class="ord-balance-sub mk-dim">Margin: $@_acctMarginBalance.ToString("F2")</span>
                        }
                    }
                </div>

                <!-- Order type tabs -->
                <div class="ord-type-tabs">
                    <button class="ord-tt @(_orderType=="Market"?"ott-on":"")" @onclick='()=>_orderType="Market"'>
                        <span class="ord-tt-icon">⚡</span> Market
                    </button>
                    <button class="ord-tt @(_orderType=="Limit"?"ott-on":"")" @onclick='()=>_orderType="Limit"'>
                        <span class="ord-tt-icon">📋</span> Limit
                    </button>
                    <button class="ord-tt @(_orderType=="StopLimit"?"ott-on":"")" @onclick='()=>_orderType="StopLimit"'>
                        <span class="ord-tt-icon">🛡</span> Stop
                    </button>
                </div>

                <div class="ord-body">
                    <!-- Leverage row -->
                    <div class="ord-row">
                        <div class="ord-lev-head">
                            <label class="ord-label">Leverage</label>
                            <span class="ord-lev-val">@_orderLeverage×
                                <span class="ord-lev-max">/ @_symMaxLev× max</span>
                            </span>
                        </div>
                        <div class="ord-lev-slider-wrap">
                            <input type="range" min="1" max="@_symMaxLev" step="1"
                                   class="ord-lev-slider" title="Leverage"
                                   @bind="_orderLeverage" @bind:event="oninput" />
                            <div class="ord-lev-ticks">
                                @foreach (var v in new[]{1,5,10,20,30,50}.Where(v => v <= _symMaxLev))
                                {
                                    <span class="ord-lev-tick @(_orderLeverage==v?"otk-on":"")"
                                          @onclick="()=>_orderLeverage=v">@v×</span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Price row (hidden for Market) -->
                    @if (_orderType != "Market")
                    {
                        <div class="ord-row">
                            <label class="ord-label">@(_orderType == "StopLimit" ? "Stop Price" : "Limit Price")</label>
                            <div class="ord-input-wrap">
                                <input class="ord-input mono" type="number" title="@(_orderType == "StopLimit" ? "Stop Price" : "Limit Price")"
                                       step="@(_symTickSize > 0 ? _symTickSize.ToString("G8") : "any")"
                                       value="@(_orderPrice > 0 ? _orderPrice.ToString("G8") : "")"
                                       @onchange="OnPriceChange" />
                                <span class="ord-input-sfx">USDT</span>
                            </div>
                            <div class="ord-price-hint">🖱️ Right-click the chart to pick a price — qty & leverage auto-adjust</div>
                        </div>
                    }

                    <!-- Quantity + notional hint -->
                    <div class="ord-row">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <label class="ord-label">Quantity</label>
                            @{ decimal notional = _orderQty * (_orderPrice > 0 ? _orderPrice : _activeSignal!.Entry); }
                            @if (notional > 0)
                            {
                                <span class="ord-notional @(notional < _symMinNotional ? "ord-notional-warn" : "ord-notional-ok")">
                                    ≈ @notional.ToString("F2") USDT @(notional < _symMinNotional ? $"(min {_symMinNotional:F0})" : "")
                                </span>
                            }
                        </div>
                        <div class="ord-input-wrap">
                            <input class="ord-input mono" type="number" title="Quantity"
                                   step="@(_symStep > 0 ? _symStep.ToString("G8") : "any")"
                                   value="@(_orderQty > 0 ? _orderQty.ToString("G8") : "")"
                                   @onchange="OnQtyChange" />
                            <span class="ord-input-sfx">@_activeSignal!.Symbol.Replace("USDT","")</span>
                        </div>
                    </div>


                    <!-- SL + multi-TP — auto-filled from the signal's own
                         levels when this is a strategy signal (one click
                         sets up the whole trade), or left blank for a
                         pure manual trade. Either way, editable before
                         submitting. Kept deliberately simple compared to
                         how other exchanges (Binance's own native multi-TP
                         UI included) make this needlessly fiddly. One SL
                         price, a short repeatable list of TP rows
                         (price + % of the position to close there), with
                         a running total so it's obvious if the
                         allocations don't add up to 100%. -->
                    <div class="ord-row">
                        <label class="ord-label">Stop Loss <span class="mk-dim">(optional)</span></label>
                        <div class="ord-input-wrap">
                            <input class="ord-input mono" type="number" title="Stop Loss price"
                                   step="@(_symTickSize > 0 ? _symTickSize.ToString("G8") : "any")"
                                   value="@(_manualSlPrice > 0 ? _manualSlPrice.ToString("G8") : "")"
                                   @onchange="OnManualSlChange" placeholder="No stop loss" />
                            <span class="ord-input-sfx">USDT</span>
                        </div>
                    </div>

                    <div class="ord-row">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <label class="ord-label">Take Profit <span class="mk-dim">(optional, multi)</span></label>
                            @if (_manualTps.Count > 0)
                            {
                                var totalPct = _manualTps.Sum(t => t.Pct);
                                <span class="ord-tp-total @(Math.Abs(totalPct - 100) < 0.01m ? "up" : "yel")">@totalPct.ToString("F0")% allocated</span>
                            }
                        </div>
                        @foreach (var (tpRow, idx) in _manualTps.Select((t, i) => (t, i)))
                        {
                            <div class="ord-tp-row">
                                <input class="ord-input mono ord-tp-price" type="number" title="Take profit price"
                                       step="@(_symTickSize > 0 ? _symTickSize.ToString("G8") : "any")"
                                       value="@(tpRow.Price > 0 ? tpRow.Price.ToString("G8") : "")"
                                       @onchange="@(e => OnManualTpPriceChange(idx, e))" placeholder="Price" />
                                <div class="ord-tp-pct-wrap">
                                    <input class="ord-input mono ord-tp-pct" type="number" title="Percent of position to close at this TP"
                                           min="1" max="100" step="1"
                                           value="@tpRow.Pct.ToString("G8")"
                                           @onchange="@(e => OnManualTpPctChange(idx, e))" />
                                    <span class="ord-tp-pct-sfx">%</span>
                                </div>
                                <button class="ord-tp-remove" title="Remove this TP" @onclick="() => RemoveManualTp(idx)">✕</button>
                            </div>
                        }
                        @if (_manualTps.Count < 5)
                        {
                            <button class="ord-tp-add" @onclick="AddManualTp">+ Add TP level</button>
                        }
                    </div>

                    <!-- Reference levels -->
                    <div class="ord-levels">
                        <div class="ord-lev">
                            <span class="ord-lev-l">@(_activeSignal.Confidence > 0 ? "Signal Entry" : "Last Price")</span>
                            <span class="ord-lev-v mono" @onclick="()=>_orderPrice=_activeSignal.Entry" title="Click to use">
                                @FmtP(_activeSignal.Entry) <span class="ord-lev-use">↑</span>
                            </span>
                        </div>
                        @if (_activeSignal.StopLoss > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Stop Loss</span>
                                <span class="ord-lev-v mono dn">@FmtP(_activeSignal.StopLoss)</span>
                            </div>
                        }
                        @if (tp1 > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Take Profit</span>
                                <span class="ord-lev-v mono up">@FmtP(tp1)</span>
                            </div>
                        }
                    </div>

                    <!-- Error -->
                    @if (!string.IsNullOrEmpty(_orderError))
                    {
                        <div class="ord-error">⚠ @_orderError</div>
                    }
                    @if (!string.IsNullOrEmpty(_orderSuccess))
                    {
                        <div class="ord-ok">✓ @_orderSuccess</div>
                    }

                    <!-- Submit -->
                    <div class="ord-actions">
                        <button class="ord-cancel-btn" @onclick="CancelOrder">Cancel</button>
                        @if (_activeSignal.Confidence > 0)
                        {
                            <!-- Strategy signal: direction is fixed, single submit button -->
                            <button class="ord-submit-btn @(isBuy?"osb-buy":"osb-sell")"
                                    @onclick="PlaceManualOrder" disabled="@_orderLoading">
                                @if (_orderLoading) { <span class="ord-spin"></span> }
                                else if (_orderType == "Market") { @((isBuy ? "Buy Market" : "Sell Market") + (_demoMode ? " (DEMO)" : "")) }
                                else { @((isBuy ? "Buy Limit" : "Sell Limit") + (_demoMode ? " (DEMO)" : "")) }
                            </button>
                        }
                        else
                        {
                            <!-- Manual trade: user picks direction at submit time -->
                            <button class="ord-submit-btn osb-buy"
                                    @onclick="PlaceManualOrderBuy" disabled="@_orderLoading">
                                @if (_orderLoading && isBuy) { <span class="ord-spin"></span> }
                                else { @((_orderType == "Market" ? "Buy Market" : "Buy Limit") + (_demoMode ? " (DEMO)" : "")) }
                            </button>
                            <button class="ord-submit-btn osb-sell"
                                    @onclick="PlaceManualOrderSell" disabled="@_orderLoading">
                                @if (_orderLoading && !isBuy) { <span class="ord-spin"></span> }
                                else { @((_orderType == "Market" ? "Sell Market" : "Sell Limit") + (_demoMode ? " (DEMO)" : "")) }
                            </button>
                        }
                    </div>
                </div>

                @if (_currentPosition != null)
                {
                    <div class="ord-position-box">
                        <div class="ord-position-head">
                            <span class="ord-position-title">📊 Открытая позиция</span>
                            <span class="sc-side @(PosIsLong ? "sc-side-b" : "sc-side-s") ord-badge">
                                @(PosIsLong ? "▲ LONG" : "▼ SHORT") @_currentPosition.Leverage×
                            </span>
                        </div>
                        <div class="ord-position-grid">
                            <div class="ord-position-cell">
                                <span class="ord-position-l">ENTRY</span>
                                <span class="ord-position-v mono">@FmtP(_currentPosition.EntryPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">MARK</span>
                                <span class="ord-position-v mono">@FmtP(_currentPosition.MarkPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">SIZE</span>
                                <span class="ord-position-v mono">@_currentPosition.Size.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">MARGIN</span>
                                <span class="ord-position-v mono">@_currentPosition.Margin.ToString("F2") USDT</span>
                            </div>
                        </div>
                        <div class="ord-position-pnl-row">
                            <span class="ord-position-pnl @(_currentPosition.Pnl >= 0 ? "up" : "dn")">
                                @(_currentPosition.Pnl >= 0 ? "+" : "")@_currentPosition.Pnl.ToString("F4") USDT
                            </span>
                            <span class="ord-position-roi @(_currentPosition.Roi >= 0 ? "up" : "dn")">
                                (@(_currentPosition.Roi >= 0 ? "+" : "")@((_currentPosition.Roi * 100).ToString("F2"))% ROI)
                            </span>
                        </div>
                        @if (_currentPosition.LiqPrice > 0)
                        {
                            <div class="ord-position-liq-warn">
                                ⚠ Liquidation @FmtP(_currentPosition.LiqPrice) — @PosLiqDistPercent.ToString("F1")% от mark price
                            </div>
                        }
                        <button class="ord-position-close-btn" @onclick="CloseCurrentPosition" disabled="@_orderLoading">
                            @if (_orderLoading) { <span class="ord-spin"></span> }
                            else { @("✕ Close Position") }
                        </button>
                    </div>
                }

                } <!-- end manualTradeCollapsed check -->
            </div>
        }
        @if (_selectedPosition != null)
        {
            // POSITION DETAILS (right sidebar): shown when a row in OPEN POSITIONS is clicked
            var pos = _selectedPosition!;
            bool posIsLong = pos.Side == "LONG";
            decimal liqDistPct = pos.LiqPrice > 0 && pos.MarkPrice > 0
                ? Math.Abs(pos.LiqPrice - pos.MarkPrice) / pos.MarkPrice * 100m
                : 0m;
            <div class="ord-panel">
                <div class="ord-selected-label">Selected Position@(_demoMode ? " (Demo)" : "")</div>
                <div class="ord-head">
                    <div class="ord-title">
                        <span class="sc-side @(posIsLong?"sc-side-b":"sc-side-s") ord-badge">
                            @(posIsLong ? "▲ LONG" : "▼ SHORT") @pos.Leverage×
                        </span>
                        <span class="ord-sym">@pos.Symbol</span>
                    </div>
                    <button class="ord-close-x" @onclick="ClosePositionPanel">✕</button>
                </div>

                @{
                    var posOrders = _openOrders.Where(o => o.Symbol == pos.Symbol &&
                        (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side)).ToList();
                }
                @if (posOrders.Any())
                {
                    <div class="ord-pos-orders">
                        <div class="ord-pos-orders-title">Open Orders for @pos.Symbol</div>
                        @foreach (var o in posOrders)
                        {
                            <div class="ord-pos-order-row">
                                <div class="ord-pos-order-top">
                                    <span class="@(o.Side == "BUY" ? "up" : "dn")">@o.Side</span>
                                    <span class="mk-dim ord-pos-order-type">@o.Type @(o.ReduceOnly ? "(R)" : "")</span>
                                    <button class="mk-oo-cancel" disabled="@(_cancellingOrderId == o.OrderId)"
                                            @onclick="() => CancelOpenOrderAsync(o)">
                                        @(_cancellingOrderId == o.OrderId ? "…" : "Cancel")
                                    </button>
                                </div>
                                <div class="ord-pos-order-bottom">
                                    <span class="mono">@(o.Price > 0 ? FmtP(o.Price) : "Market")</span>
                                    <span class="mono mk-dim">@o.Qty.ToString("G8")</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="ord-body">
                    <div class="ord-position-box" style="margin:0;border:none;padding:0;">

                        <!-- PnL/ROI as the dominant element up top, per
                             direct request for a bigger/more comfortable
                             panel — matches the share-card style. -->
                        <div class="ord-position-pnl-hero">
                            <span class="ord-position-pnl-hero-v @(pos.Pnl >= 0 ? "up" : "dn")">
                                @(pos.Pnl >= 0 ? "+" : "")@pos.Pnl.ToString("F2") USDT
                            </span>
                            <span class="ord-position-roi-hero @(pos.Roi >= 0 ? "up" : "dn")">
                                @(pos.Roi >= 0 ? "+" : "")@((pos.Roi * 100).ToString("F2"))% ROI
                            </span>
                        </div>

                        <div class="ord-position-grid">
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Entry Price</span>
                                <span class="ord-position-v mono">@FmtP(pos.EntryPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Mark Price</span>
                                <span class="ord-position-v mono">@FmtP(pos.MarkPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Size</span>
                                <span class="ord-position-v mono">@pos.Size.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Margin</span>
                                <span class="ord-position-v mono">@pos.Margin.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Quantity</span>
                                <span class="ord-position-v mono">@pos.Qty.ToString("G8")</span>
                            </div>
                            @if (pos.LiqPrice > 0)
                            {
                                <div class="ord-position-cell">
                                    <span class="ord-position-l">Liq. Price</span>
                                    <span class="ord-position-v mono dn">@FmtP(pos.LiqPrice)</span>
                                </div>
                            }
                        </div>

                        @if (pos.LiqPrice > 0)
                        {
                            decimal liqRange = Math.Abs(pos.EntryPrice - pos.LiqPrice);
                            decimal liqProgress = liqRange > 0
                                ? Math.Clamp(Math.Abs(pos.MarkPrice - pos.EntryPrice) / liqRange * 100, 0, 100)
                                : 0;
                            <div class="ord-liq-section">
                                <div class="ord-liq-head">
                                    <span class="ord-liq-title">Distance to Liquidation</span>
                                    <span class="ord-liq-pct">@liqProgress.ToString("F0")% toward liq</span>
                                </div>
                                <div class="ord-liq-track">
                                    <div class="ord-liq-fill" style="width:@(liqProgress.ToString("F1"))%"></div>
                                    <div class="ord-liq-cursor" style="left:@(liqProgress.ToString("F1"))%"></div>
                                </div>
                                <div class="ord-liq-labels">
                                    <span class="up">Entry @FmtP(pos.EntryPrice)</span>
                                    <span class="mk-dim">▼ @FmtP(pos.MarkPrice)</span>
                                    <span class="dn">Liq @FmtP(pos.LiqPrice)</span>
                                </div>
                            </div>
                        }

                        @{
                            // DEMO: TP/SL orders live in _demoSnapshot.PendingOrders
                            // LIVE: TP/SL orders live in _openOrders
                            IEnumerable<OpenOrderRow> tpslSource;
                            if (_demoMode)
                            {
                                tpslSource = _demoSnapshot.PendingOrders
                                    .Where(o => o.Symbol == pos.Symbol)
                                    .Select(o => new OpenOrderRow
                                    {
                                        Symbol     = o.Symbol,
                                        Side       = posIsLong ? "SELL" : "BUY",
                                        Type       = o.Type == DemoOrderType.Limit ? "TAKE_PROFIT" : "STOP_MARKET",
                                        Price      = o.TriggerPrice,
                                        Qty        = o.Qty,
                                        ReduceOnly = true,
                                        OrderId    = 0L, // demo orders use string Id, not used here
                                    });
                            }
                            else
                            {
                                tpslSource = _openOrders
                                    .Where(o => o.Symbol == pos.Symbol && o.ReduceOnly &&
                                        o.Side == (posIsLong ? "SELL" : "BUY"));
                            }
                            var posTps = tpslSource
                                .Where(o => o.Type == "TAKE_PROFIT_MARKET" || o.Type == "TAKE_PROFIT" || o.Type == "LIMIT")
                                .OrderBy(o => posIsLong ? o.Price : -o.Price)
                                .ToList();
                            var posSlOrder = tpslSource
                                .FirstOrDefault(o => o.Type == "STOP_MARKET" || o.Type == "STOP");
                        }
                        @if (posTps.Any() || posSlOrder != null)
                        {
                            <div class="ord-tpsl-section">
                                <div class="ord-tpsl-head">
                                    <span class="ord-tpsl-title">Take Profit · Stop Loss</span>
                                    <span class="ord-tpsl-edit" @onclick="ToggleTpSlEdit">Edit</span>
                                </div>
                                @for (int ti = 0; ti < posTps.Count; ti++)
                                {
                                    var tp = posTps[ti];
                                    decimal tpDist = pos.EntryPrice > 0
                                        ? Math.Abs(tp.Price - pos.EntryPrice) / pos.EntryPrice * 100 : 0;
                                    decimal tpBarW = Math.Min(tpDist / 15m * 100m, 100m);
                                    int tpIdx = ti + 1;
                                    <div class="ord-tp-row">
                                        <span class="ord-tp-lbl up">TP@(tpIdx)</span>
                                        <div class="ord-tp-track"><div class="ord-tp-fill ord-tp-fill-g" style="width:@(tpBarW.ToString("F1"))%"></div></div>
                                        <span class="ord-tp-price up mono">@FmtP(tp.Price)</span>
                                        <span class="ord-tp-pct up">+@(tpDist.ToString("F2"))%</span>
                                    </div>
                                }
                                @if (posSlOrder != null)
                                {
                                    <div class="ord-sl-sep"></div>
                                    decimal slDist = pos.EntryPrice > 0
                                        ? Math.Abs(posSlOrder.Price - pos.EntryPrice) / pos.EntryPrice * 100 : 0;
                                    <div class="ord-tp-row">
                                        <span class="ord-tp-lbl dn">SL</span>
                                        <div class="ord-tp-track"><div class="ord-tp-fill ord-tp-fill-r" style="width:100%"></div></div>
                                        <span class="ord-tp-price dn mono">@FmtP(posSlOrder.Price)</span>
                                        <span class="ord-tp-pct dn">-@(slDist.ToString("F2"))%</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="ord-actions" style="margin-top:12px;">
                        <button class="ord-cancel-btn" @onclick="ClosePositionPanel">Close Panel</button>
                        <button class="ord-submit-btn osb-sell" disabled="@_orderLoading"
                                @onclick="() => ClosePositionRow(pos)">
                            @if (_orderLoading) { <span class="ord-spin"></span> } else { @("Close Position") }
                        </button>
                    </div>

                    <!-- Add to Position — per direct request: there was
                         no way to add margin/quantity to an already-
                         selected position, since opening Manual Trade
                         used to clobber this panel entirely. Reuses
                         the exact same fields/submit flow, just scoped
                         to this position's own side so it can only add,
                         never accidentally flip direction. -->
                    @if (!_addToPositionOpen)
                    {
                        <button class="ord-add-to-pos-btn" @onclick="() => OpenAddToPosition(pos)">
                            + Add to Position
                        </button>
                    }
                    else
                    {
                        <div class="ord-add-to-pos-box">
                            <div class="ord-add-to-pos-head">
                                <span>Add to @(posIsLong ? "Long" : "Short") @pos.Symbol</span>
                                <button class="ord-close-x" @onclick="() => _addToPositionOpen = false">✕</button>
                            </div>

                            <div class="ord-row">
                                <div class="ord-type-tabs">
                                    <button class="ord-type-tab @(_addToPosType=="Market"?"ord-type-tab-on":"")" @onclick="SetAddToPosTypeMarket">Market</button>
                                    <button class="ord-type-tab @(_addToPosType=="Limit"?"ord-type-tab-on":"")" @onclick="SetAddToPosTypeLimit">Limit</button>
                                </div>
                            </div>

                            @if (_addToPosType == "Limit")
                            {
                                <div class="ord-row">
                                    <label class="ord-label">Limit Price</label>
                                    <input class="ord-input mono" type="number"
                                           step="@(_symTickSize > 0 ? _symTickSize.ToString("G8") : "any")"
                                           value="@(_addToPosPrice > 0 ? _addToPosPrice.ToString("G8") : "")"
                                           @onchange="@(e => _addToPosPrice = ParseDecOr(e.Value, _addToPosPrice))" />
                                </div>
                            }

                            <div class="ord-row">
                                <label class="ord-label">Leverage <span class="mono">@_orderLeverage×</span></label>
                                <input type="range" min="1" max="@_symMaxLev" step="1"
                                       class="ord-leverage-slider"
                                       @bind="_orderLeverage" @bind:event="oninput" />
                            </div>

                            <div class="ord-row">
                                <label class="ord-label">Quantity</label>
                                <div class="ord-input-wrap">
                                    <input class="ord-input mono" type="number"
                                           step="@(_symStep > 0 ? _symStep.ToString("G8") : "any")"
                                           value="@(_orderQty > 0 ? _orderQty.ToString("G8") : "")"
                                           @onchange="OnQtyChange" />
                                    <span class="ord-input-sfx">@pos.Symbol.Replace("USDT","")</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(_orderError))
                            {
                                <div class="ord-error">@_orderError</div>
                            }
                            @if (!string.IsNullOrEmpty(_orderSuccess))
                            {
                                <div class="ord-success">@_orderSuccess</div>
                            }

                            <button class="ord-submit-btn @(posIsLong ? "osb-buy" : "osb-sell")" disabled="@_orderLoading"
                                    @onclick="() => AddToPosition(pos)">
                                @if (_orderLoading) { <span class="ord-spin"></span> }
                                else { @($"{(posIsLong ? "Buy" : "Sell")} {_addToPosType}{(_demoMode ? " (DEMO)" : "")}") }
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else if (!_orderPanelDismissed && Selected != null && _openOrders.Any(o => o.Symbol == Selected.Symbol))
        {
            // No open position for this symbol, but there ARE open
            // orders (e.g. a pending limit entry that hasn't filled
            // yet) — per direct request, surface this regardless of
            // how the symbol was selected, not only when clicking a
            // row in the positions table.
            <div class="ord-panel">
                <div class="ord-selected-label">Open Orders</div>
                <div class="ord-head">
                    <div class="ord-title"><span class="ord-sym">@Selected.Symbol</span></div>
                    <button class="ord-close-x" @onclick="() => Selected = null">✕</button>
                </div>
                <div class="ord-pos-orders">
                    @foreach (var o in _openOrders.Where(o => o.Symbol == Selected.Symbol))
                    {
                        <div class="ord-pos-order-row">
                            <span class="@(o.Side == "BUY" ? "up" : "dn")">@o.Side</span>
                            <span class="mk-dim">@o.Type @(o.ReduceOnly ? "(R)" : "")</span>
                            <span class="mono">@(o.Price > 0 ? FmtP(o.Price) : "Market")</span>
                            <span class="mono mk-dim">@o.Qty.ToString("G8")</span>
                            <button class="mk-oo-cancel" disabled="@(_cancellingOrderId == o.OrderId)"
                                    @onclick="() => CancelOpenOrderAsync(o)">
                                @(_cancellingOrderId == o.OrderId ? "…" : "Cancel")
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        </div> <!-- end mk-charts-col-side (manual-trade/position-details) -->

        </div> <!-- end mk-body-grid -->
     </div>
    </div> <!-- end mk-charts-area always-in-DOM -->

    <div id="sigCardFloatOverlay" class="sc-float-overlay"></div>

    @if (_shareCard != null)
    {
        <div class="share-modal-backdrop" @onclick="CloseShareCard">
            <div class="share-modal" @onclick:stopPropagation="true">
                <canvas @ref="_shareCardCanvasEl" width="900" height="560" class="share-modal-canvas"></canvas>
                <div class="share-modal-actions">
                    <button class="share-modal-btn share-modal-btn-secondary" @onclick="CloseShareCard">Close</button>
                    <button class="share-modal-btn share-modal-btn-primary" @onclick="DownloadShareCard">⬇ Download Image</button>
                </div>
            </div>
        </div>
    }

<style>
:root{--bg:#04060e;--bg2:#080d1a;--bg3:#0d1424;--bg4:#111c30;--bg5:#162035;--bdr:#1e2d47;--bdr2:#253450;--acc:#3b82f6;--grn:#10b981;--grn-d:rgba(16,185,129,.1);--grn-b:rgba(16,185,129,.22);--red:#ef4444;--red-d:rgba(239,68,68,.1);--red-b:rgba(239,68,68,.22);--yel:#f59e0b;--yel-d:rgba(245,158,11,.1);--cyan:#22d3ee;--cyan-d:rgba(34,211,238,.1);--cyan-b:rgba(34,211,238,.22);--purp:#a78bfa;--txt:#e8eef6;--txt2:#b0bfcf;--dim:#4a6080;--dim2:#2d3f5e;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt2);-webkit-font-smoothing:antialiased;}
/* Hide ALL scrollbars globally — functional scrolling is kept via JS/CSS */
*{scrollbar-width:none!important;-ms-overflow-style:none!important;}
*::-webkit-scrollbar{display:none!important;}
.mk{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:48px;}
.up{color:var(--grn)!important;}.dn{color:var(--red)!important;}.mk-dim{color:var(--dim)!important;}

/* HEADER */
.mk-header{display:flex;align-items:center;justify-content:space-between;padding:8px 16px;background:var(--bg2);border-bottom:1px solid var(--bdr);height:44px;}
.mk-hbal-strip{display:flex;align-items:center;gap:0;background:var(--bg3);border:1px solid var(--bdr2);border-radius:8px;overflow:hidden;}
.mk-hbal-item{display:flex;flex-direction:column;align-items:flex-end;padding:4px 12px;gap:1px;}
.mk-hbal-item-avail{background:rgba(34,211,238,.05);}
.mk-hbal-sep{width:1px;height:28px;background:var(--bdr2);}
.mk-hbal-l{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;font-weight:600;}
.mk-hbal-l-avail{color:var(--cyan);opacity:.8;}
.mk-hbal-v{font-size:12px;font-weight:600;color:var(--txt2);font-family:var(--mono);}
.mk-hbal-v-main{font-size:20px;font-weight:900;color:var(--cyan);font-family:var(--mono);letter-spacing:-.3px;}
.mk-title-block{display:flex;align-items:center;gap:10px;}
.mk-icon{font-size:18px;}
.mk-title{font-family:var(--mono);font-size:11px;font-weight:800;letter-spacing:2px;color:var(--cyan);}
.mk-sub{font-size:10px;color:var(--dim2);margin-top:0px;}
.mk-hright{display:flex;align-items:center;gap:20px;}
.mk-demo-toggle{display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:1px solid var(--bdr);background:var(--bg3);color:var(--dim);font-size:11px;font-weight:700;letter-spacing:.5px;cursor:pointer;transition:all .2s;}
.mk-demo-toggle:hover{border-color:var(--acc);}
.mk-demo-toggle.mk-demo-on{background:rgba(234,179,8,.12);border-color:var(--yel);color:var(--yel);}
.mk-demo-dot{width:6px;height:6px;border-radius:50%;background:var(--grn);box-shadow:0 0 0 2px rgba(16,185,129,.2);}
.mk-demo-toggle.mk-demo-on .mk-demo-dot{background:var(--yel);}
.mk-hbal{display:flex;flex-direction:column;align-items:flex-end;gap:1px;}
.mk-hbal-l{font-size:8px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;font-weight:600;}
.mk-hbal-v{font-size:11px;font-weight:600;color:var(--txt2);font-family:var(--mono);}
.mk-hbal-v-main{font-size:18px;font-weight:700;color:var(--cyan);font-family:var(--mono);letter-spacing:-.3px;}
.mk-hbal-main{position:relative;}
.mk-hbal-main::before{content:"Available";position:absolute;right:0;top:-12px;font-size:7px;color:var(--cyan);text-transform:uppercase;letter-spacing:.6px;font-weight:700;opacity:.7;}
.mk-header-scan{display:flex;align-items:center;gap:5px;font-size:9px;color:var(--dim);background:transparent;padding:0;border-radius:0;border:none;margin-left:6px;}
.mk-header-scan-dot{width:6px;height:6px;border-radius:50%;background:#38bdf8;box-shadow:0 0 8px rgba(56,189,248,0.7);animation:mkHeaderScanPulse 1.6s ease-in-out infinite;flex-shrink:0;}
@@keyframes mkHeaderScanPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(0.7);}}
.mk-header-scan-sym{color:#38bdf8;font-family:var(--mono);font-weight:600;}
.sig-empty{display:flex;align-items:center;justify-content:center;min-height:36px;padding:8px 14px;color:var(--dim);font-size:12px;border:1px dashed var(--bdr);border-radius:8px;background:var(--bg3);}
.mk-ticker{display:flex;align-items:center;gap:10px;}
.mk-tsym{font-family:var(--mono);font-size:20px;font-weight:800;color:var(--acc);letter-spacing:-.4px;}
.mk-ttf{font-size:11px;background:var(--bg3);border:1px solid var(--bdr);padding:2px 8px;border-radius:4px;color:var(--dim);}
.mk-tprice{font-family:var(--mono);font-size:22px;font-weight:800;letter-spacing:-.5px;}
.mk-tchg{font-family:var(--mono);font-size:14px;font-weight:600;}
.mk-btn{padding:6px 16px;border:1px solid var(--bdr);background:var(--bg3);color:var(--dim);border-radius:6px;cursor:pointer;font-size:12px;transition:all .2s;}
.mk-btn-inline{padding:3px 10px;font-size:11px;margin-left:6px;}
.mk-btn:hover{border-color:var(--acc);color:var(--txt);}
.mk-btn-on{background:rgba(239,68,68,.15);border-color:var(--red);color:var(--red);}

/* TF BAR */
.mk-tf-bar{position:sticky;z-index:24;display:flex;align-items:center;gap:1px;padding:4px 14px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mk-tf-bar-inline{position:static;border-radius:8px 8px 0 0;margin-bottom:2px;}
.mk-tf-btn{padding:3px 7px;background:transparent;border:none;color:var(--dim2);font-family:var(--mono);font-size:10px;font-weight:700;cursor:pointer;border-radius:4px;transition:all .15s;}
.mk-tf-btn:hover{background:var(--bg3);color:var(--txt);}
.mk-tf-on{background:rgba(34,211,238,.15)!important;color:var(--cyan)!important;border:1px solid rgba(34,211,238,.3)!important;}
.mk-tf-dim{opacity:.35;}
.mk-tf-dim:hover{opacity:.6;}
.mk-chips{display:flex;gap:6px;padding:10px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;flex-wrap:wrap;scrollbar-width:none;}
.mk-chips::-webkit-scrollbar{display:none;}
.mk-chip{display:flex;align-items:center;gap:6px;padding:4px 10px;background:var(--bg3);border:1px solid var(--bdr2);border-radius:6px;cursor:pointer;transition:all .15s;white-space:nowrap;}
.mk-chip:hover{border-color:var(--acc);}
.mk-chip-on{background:rgba(59,130,246,.12);border-color:var(--acc);}
.mk-chip-sym{font-family:var(--mono);font-size:12px;font-weight:700;}
.mk-chip-tf{font-size:10px;color:var(--dim);}
.mk-chip-chg{font-family:var(--mono);font-size:11px;font-weight:600;}

/* EMPTY */
.mk-empty{display:flex;flex-direction:column;align-items:center;gap:14px;padding:80px;color:var(--dim);text-align:center;}

/* STATS */
.mk-stats{position:sticky;z-index:23;display:grid;grid-template-columns:repeat(12,1fr);gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.mk-s{background:var(--bg2);padding:8px 12px;}
.mk-sl{font-size:9px;letter-spacing:.8px;color:var(--dim);font-weight:700;text-transform:uppercase;}
.mk-sv{font-family:var(--mono);font-size:16px;font-weight:800;margin-top:1px;letter-spacing:-.3px;}

/* CHARTS */
.mk-charts-area{background:var(--bg2);padding:16px 20px;border-bottom:1px solid var(--bdr);position:relative;}
.mk-body-grid{display:grid;grid-template-columns:240px 1fr;gap:16px;align-items:start;}
.mk-body-grid-with-panel{grid-template-columns:240px 1fr 360px;}
@@media(max-width:1300px){.mk-body-grid{grid-template-columns:1fr;}.mk-body-grid-with-panel{grid-template-columns:1fr;}}
.mk-main-col{min-width:0;display:flex;flex-direction:column;gap:16px;}
.mk-charts-col-main{min-width:0;}
.mk-charts-col-side{min-width:0;display:flex;flex-direction:column;gap:10px;}
.mk-chart-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:10px;}

.mk-chart-maximize{flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;color:var(--dim);cursor:pointer;transition:all .15s;}
.mk-chart-maximize:hover{color:var(--txt);border-color:var(--acc);}
.mk-chart-maximize svg{width:15px;height:15px;}

.mk-chart-container-wrap{width:100%;height:540px;min-height:260px;max-height:900px;transition:none;position:relative;resize:vertical;overflow:hidden;contain:layout paint;}
.mk-chart-container-wrap:not(.mk-chart-maximized)::after{content:'';position:absolute;right:2px;bottom:2px;width:14px;height:14px;background:repeating-linear-gradient(135deg,var(--dim) 0 1.5px,transparent 1.5px 4px);opacity:.5;pointer-events:none;}

.mk-tpsl-overlay{position:absolute;top:56px;left:8px;z-index:5;pointer-events:none;display:flex;align-items:center;gap:8px;}
.mk-tpsl-btn-wrapper{position:absolute;top:8px;right:46px;z-index:9;user-select:none;touch-action:none;display:flex;align-items:center;gap:0;background:rgba(8,13,26,.92);border:1px solid var(--bdr2);border-radius:7px;overflow:hidden;backdrop-filter:blur(8px);box-shadow:0 2px 12px rgba(0,0,0,.4);cursor:grab;pointer-events:auto;}.mk-tpsl-btn-wrapper:active{cursor:grabbing;}.mk-tpsl-drag-grip{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2px;width:14px;padding:5px 3px;border-right:1px solid var(--bdr);opacity:.4;}.mk-tpsl-drag-grip span{display:block;width:8px;height:1.5px;background:var(--t1);border-radius:1px;}.mk-tpsl-btn{pointer-events:auto;display:flex;align-items:center;gap:6px;background:transparent;border:none;color:var(--dim);padding:5px 10px;font-size:11.5px;font-weight:600;cursor:pointer;transition:color .15s,background .15s;}
.mk-tpsl-btn svg{width:13px;height:13px;}

/* DRAWING TOOLS TOOLBAR */
/* mk-draw-toolbar removed — CDT chart-drawing-tools.js manages its own toolbar with inline styles */




.mk-tpsl-btn:hover{color:var(--txt);border-color:var(--acc);}
.mk-tpsl-btn-on{background:rgba(59,130,246,0.15);border-color:var(--acc);color:var(--acc);}
.mk-chart-maximized{position:fixed;inset:0;z-index:2100;height:auto;max-height:none;resize:none;background:var(--bg);display:flex;flex-direction:column;padding:6px 10px;}

.mk-max-bar{display:flex;align-items:center;justify-content:flex-end;gap:14px;padding:8px 12px;height:52px;flex-shrink:0;}
.mk-max-sym-wrap{position:relative;}
.mk-max-sym{font-family:var(--mono);font-size:16px;font-weight:700;display:flex;align-items:baseline;gap:8px;background:none;border:none;color:var(--txt);cursor:pointer;padding:4px 6px;border-radius:6px;transition:background .15s;}
.mk-max-sym:hover{background:rgba(255,255,255,0.06);}
.mk-max-sym-caret{width:13px;height:13px;align-self:center;color:var(--dim);}
.mk-max-sym-dropdown{position:absolute;top:calc(100% + 4px);left:0;width:260px;max-height:340px;background:var(--bg2);border:1px solid var(--bdr);border-radius:8px;box-shadow:0 12px 32px rgba(0,0,0,.5);z-index:20;overflow:hidden;display:flex;flex-direction:column;}
.mk-max-sym-search{background:var(--bg3);border:none;border-bottom:1px solid var(--bdr);padding:10px 12px;color:var(--txt);font-size:13px;outline:none;}
.mk-max-sym-search::placeholder{color:var(--dim);}
.mk-max-sym-list{overflow-y:auto;max-height:290px;scrollbar-width:none;}
.mk-max-sym-list::-webkit-scrollbar{display:none;}
.mk-max-sym-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;cursor:pointer;font-size:12.5px;transition:background .12s;}
.mk-max-sym-pos-dot{width:6px;height:6px;border-radius:50%;background:var(--acc);margin-right:6px;flex-shrink:0;}
.mk-max-sym-row:hover{background:rgba(255,255,255,0.05);}
.mk-max-sym-row-sel{background:rgba(59,130,246,0.12);box-shadow:inset 2px 0 0 var(--acc);}
.mk-max-tf-row{display:flex;gap:4px;padding:0 12px 8px;flex-shrink:0;overflow-x:auto;scrollbar-width:none;}
.mk-max-pos-row{display:flex;gap:6px;padding:0 12px 8px;flex-shrink:0;overflow-x:auto;scrollbar-width:none;}
.mk-max-pos-pill{display:flex;align-items:center;gap:6px;padding:5px 10px;border-radius:8px;font-size:11.5px;font-weight:600;cursor:pointer;white-space:nowrap;background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);}
.mk-max-pos-pill.mk-max-pos-long{border-color:rgba(34,197,94,.35);}
.mk-max-pos-pill.mk-max-pos-short{border-color:rgba(239,68,68,.35);}
.mk-max-pos-pill.mk-max-pos-active.mk-max-pos-long{background:rgba(34,197,94,.18);}
.mk-max-pos-pill.mk-max-pos-active.mk-max-pos-short{background:rgba(239,68,68,.18);}
.mk-max-pos-side{font-size:10px;}
.mk-max-pos-pill.mk-max-pos-long .mk-max-pos-side{color:var(--grn);}
.mk-max-pos-pill.mk-max-pos-short .mk-max-pos-side{color:var(--red);}
.mk-max-pos-pnl{font-family:var(--mono);font-size:10.5px;}
.mk-max-tf-row::-webkit-scrollbar{display:none;}
.mk-max-tf{font-size:11px;color:var(--dim);background:var(--bg3);padding:2px 8px;border-radius:5px;}
.mk-max-price{font-family:var(--mono);font-size:16px;font-weight:700;}
.mk-max-trade{display:flex;align-items:center;gap:6px;margin-left:auto;}
.mk-max-qty{width:100px;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;padding:7px 10px;color:var(--txt);font-size:12.5px;}
.mk-max-buy{background:var(--grn);border:none;color:#fff;padding:8px 18px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;}
.mk-max-buy:hover:not(:disabled){opacity:.88;}
.mk-max-sell{background:var(--red);border:none;color:#fff;padding:8px 18px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;}
.mk-max-sell:hover:not(:disabled){opacity:.88;}
.mk-max-buy:disabled,.mk-max-sell:disabled{opacity:.5;cursor:not-allowed;}
.mk-max-restore{display:flex;align-items:center;gap:6px;background:rgba(59,130,246,.12);border:1px solid var(--acc);color:var(--acc);padding:8px 14px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;transition:all .15s;}
.mk-max-restore:hover{background:rgba(59,130,246,.22);}
.mk-max-restore:hover{color:var(--txt);border-color:var(--acc);}
.mk-max-restore svg{width:14px;height:14px;}

@@media(max-width:900px){
    .mk-max-bar{flex-wrap:wrap;height:auto;gap:8px;}
    .mk-max-trade{margin-left:0;width:100%;}
    .mk-max-qty{flex:1;}
}
.mk-chart-maximize-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:999;animation:mkFadeIn .15s ease;}
@@keyframes mkFadeIn{from{opacity:0;}to{opacity:1;}}

.mk-chart-head-left{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.mk-legend{display:flex;gap:14px;font-size:11px;color:var(--dim);}
/* TICKER BAR */
.mk-ticker-bar{position:sticky;z-index:25;background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;scrollbar-width:none;cursor:grab;touch-action:pan-x;overscroll-behavior-x:contain;}
.mk-ticker-bar::-webkit-scrollbar{display:none;}
.mk-ticker-scroll{display:flex;align-items:center;padding:0 4px;width:max-content;}
.mk-tk{display:inline-flex;align-items:center;gap:5px;padding:8px 14px;background:transparent;border:none;border-right:1px solid var(--bdr);cursor:pointer;transition:background .15s;white-space:nowrap;flex-shrink:0;}
.mk-tk:hover{background:var(--bg3);}
.mk-tk-on{background:rgba(59,130,246,.1);border-bottom:2px solid var(--acc);}
.mk-tk-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--txt);}
.mk-tk-sep{font-size:10px;color:var(--bdr);}
.mk-tk-tf{font-size:10px;color:var(--dim);}
.mk-tk-chg{font-family:var(--mono);font-size:11px;font-weight:600;}
.mk-tk-price{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--t2);}

/* CANVAS */
.mk-no-data-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(10,13,18,.9);z-index:10;color:var(--dim);}
.mk-canvas-wrap{position:relative;background:#070a0f;border-radius:4px;margin-bottom:2px;overflow:hidden;}
.mk-canvas-wrap canvas{display:block;width:100%!important;height:100%!important;position:absolute;top:0;left:0;}
.mk-canvas-price{height:300px;}
.mk-canvas-rsi{height:90px;}
.mk-canvas-vol{height:90px;}

/* RESIZE HANDLE */
.mk-resize-handle{position:absolute;bottom:0;left:0;right:0;height:10px;cursor:ns-resize;display:flex;align-items:center;justify-content:center;background:rgba(30,37,53,0.5);transition:background .15s;z-index:10;-webkit-user-select:none;user-select:none;}
.mk-resize-handle:hover{background:rgba(59,130,246,0.2);}
.mk-resize-dots{font-size:12px;color:var(--dim);letter-spacing:2px;line-height:1;}

/* SIGNAL PANEL */
.mk-sticky-top{position:sticky;z-index:26;background:var(--bg2);box-shadow:0 4px 12px rgba(0,0,0,.25);}
.sig-panel{padding:6px 14px;border-bottom:1px solid var(--bdr);background:var(--bg2);display:flex;align-items:center;gap:10px;}
.sig-panel-head{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.sig-panel-title{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:1.5px;color:var(--dim);text-transform:uppercase;}
.sig-dot{width:7px;height:7px;border-radius:50%;background:var(--grn);animation:pulse 1.5s infinite;}
@@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(34,197,94,.4);}50%{box-shadow:0 0 0 6px rgba(34,197,94,0);}}
.sig-count{background:var(--cyan);color:#04060e;font-size:11px;font-weight:800;padding:1px 5px;border-radius:5px;font-family:var(--mono);}
.sig-panel-sub{font-size:11px;color:var(--t3);white-space:nowrap;}
.sig-hidden-toggle{display:flex;align-items:center;gap:5px;padding:3px 9px;border-radius:5px;border:1px solid var(--bdr2);background:var(--bg3);color:var(--dim);font-size:9px;font-weight:700;cursor:pointer;flex-shrink:0;}
.sig-hidden-toggle:hover{border-color:var(--acc);}
.sig-hidden-toggle.sig-hidden-toggle-on{background:var(--cyan-d);border-color:var(--cyan-b);color:var(--cyan);}
.sig-hidden-count{background:var(--bg2);border-radius:8px;padding:0 6px;font-size:10px;}
.sig-cards{display:flex;gap:8px;overflow-x:auto;padding-bottom:0;scrollbar-width:none;flex:1;}
.sig-cards::-webkit-scrollbar{display:none;}

/* Signal card */
.sig-card{flex-shrink:0;width:auto;max-width:280px;min-height:0;background:var(--bg3);border:1px solid var(--bdr2);border-radius:6px;padding:5px 10px;cursor:pointer;transition:border-color .15s,box-shadow .15s;position:relative;overflow:hidden;}
.sig-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:10px 0 0 10px;}
.sc-buy::before{background:var(--grn);}
.sc-sell::before{background:var(--red);}
.sig-card:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3);}
.sc-active{border-color:var(--acc)!important;background:rgba(59,130,246,.08)!important;}
.sc-below-threshold{opacity:.7;}
.sc-threshold-badge{font-size:9.5px;font-weight:700;color:#eab308;background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.3);border-radius:5px;padding:2px 7px;margin-bottom:6px;display:inline-block;cursor:help;}
.sc-top{display:flex;align-items:center;gap:6px;margin-bottom:0;}
.sc-sym-wrap{display:flex;align-items:baseline;gap:3px;}
.sc-sym{font-family:var(--mono);font-size:13px;font-weight:800;color:var(--txt);}
.sc-usdt{font-size:8px;color:var(--dim2);}
.sc-side{font-size:9px;font-weight:800;padding:1px 5px;border-radius:3px;white-space:nowrap;letter-spacing:.3px;}
.sc-side-b{background:var(--grn-d);color:var(--grn);border:1px solid rgba(16,185,129,.2);}
.sc-side-s{background:var(--red-d);color:var(--red);border:1px solid rgba(239,68,68,.2);}
.sc-ago{margin-left:auto;color:#94a3b8;font-weight:500;font-size:10px;}
.sc-conf-wrap{height:2px;background:var(--bdr);border-radius:2px;overflow:hidden;margin-top:3px;}
.sc-conf-bar{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--acc),var(--grn));}

/* Compact-state warning strip (shown collapsed; the full badges with
   tooltips live in sc-expand for hover) */
.sc-warn-strip{display:flex;gap:6px;margin-top:6px;font-size:9.5px;font-weight:700;color:#eab308;}

/* New-signal blink indicator — small dot, top-right corner, pulses
   until the card is clicked (SelectSignal marks it seen). */
.sc-new-dot{position:absolute;top:8px;right:8px;width:7px;height:7px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 0 rgba(59,130,246,.6);animation:scNewPulse 1.6s ease-out infinite;z-index:2;}
@@keyframes scNewPulse{0%{box-shadow:0 0 0 0 rgba(59,130,246,.6);}70%{box-shadow:0 0 0 7px rgba(59,130,246,0);}100%{box-shadow:0 0 0 0 rgba(59,130,246,0);}}

/* Expanded details — hidden by default (height:0, no padding), grows
   open on hover via max-height transition. Kept in the DOM always (not
   display:none) so hover doesn't have to wait on a layout reflow. */
.sig-card{flex-shrink:0;width:auto;max-width:280px;min-height:0;background:var(--bg3);border:1px solid var(--bdr2);border-radius:6px;padding:5px 10px;cursor:pointer;transition:border-color .15s,box-shadow .15s;position:relative;overflow:hidden;}
.sig-card.sc-pinned{overflow:visible;border-color:var(--acc);box-shadow:0 0 0 1px rgba(59,130,246,.2);}
.sc-pin-btn{background:none;border:none;font-size:11px;opacity:.35;cursor:pointer;padding:0 2px;line-height:1;flex-shrink:0;}
.sc-pin-btn:hover{opacity:.8;}
.sc-pin-btn.sc-pin-btn-on{opacity:1;}
.sc-expand{display:none;}
.sc-expand-pinned{display:block!important;position:static!important;margin:8px -14px -10px;padding:10px 14px;border-top:1px solid var(--bdr);}
.sc-float-overlay{position:fixed;display:none;background:var(--bg3);border:1px solid var(--bdr);border-radius:10px;padding:10px 14px;box-shadow:0 12px 28px rgba(0,0,0,.45);z-index:200;width:260px;pointer-events:none;}

.share-modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:500;padding:20px;}
.share-modal{background:var(--bg2);border:1px solid var(--bdr);border-radius:16px;padding:20px;max-width:600px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.5);}
.share-modal-canvas{width:100%;height:auto;border-radius:12px;display:block;}
.share-modal-actions{display:flex;gap:10px;margin-top:16px;}
.share-modal-btn{flex:1;padding:11px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid var(--bdr);}
.share-modal-btn-secondary{background:var(--bg3);color:var(--dim);}
.share-modal-btn-primary{background:var(--acc);color:#fff;border-color:var(--acc);}
.share-modal-btn-primary:hover{opacity:.9;}
.sc-float-overlay.sc-show{display:block;}

.sc-prices-row{display:flex;align-items:center;gap:14px;margin-bottom:6px;}
.sc-tp-row-all{flex-wrap:wrap;gap:10px;}
.sc-regime-row{font-size:11px;margin-bottom:4px;display:flex;gap:4px;}
.sc-p{display:flex;align-items:center;gap:5px;}
.sc-pl{font-size:10px;color:var(--dim);}
.sc-pv{font-size:12px;}
.sc-entry-range{font-size:9.5px;color:var(--dim);margin-left:3px;cursor:help;}
.sc-foot{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;}
.sc-conf{font-family:var(--mono);font-size:12px;font-weight:700;flex-shrink:0;}
.sc-rr{font-size:10px;background:rgba(59,130,246,.12);color:var(--acc);padding:1px 5px;border-radius:3px;flex-shrink:0;}
.sc-confirm-badge{font-size:9px;font-weight:700;background:rgba(34,197,94,.12);color:var(--grn);padding:1px 5px;border-radius:3px;flex-shrink:0;cursor:help;}
.sc-atr{font-size:10px;flex-shrink:0;white-space:nowrap;}
.yel{color:var(--yel)!important;}

/* TTL bar lives inline in the footer now, no longer its own row */
.sc-ttl-bar-wrap{flex:1;height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;min-width:24px;}
.sc-ttl-bar{height:100%;border-radius:2px;transition:width 1s linear;}
.ttl-high{background:var(--grn);}
.ttl-mid{background:var(--yel);}
.ttl-low{background:var(--red);}
.sc-ttl-label{font-size:9px;white-space:nowrap;color:var(--dim);flex-shrink:0;}

/* Fade-out when expiring */
.sig-card{transition:opacity .2s,transform .2s,border-color .2s,background .2s,max-width .6s ease,margin .6s ease,padding .6s ease;}
.sc-fading{opacity:.35;}
.sig-card.sc-removing{opacity:0!important;max-width:0!important;padding-left:0!important;padding-right:0!important;margin:0!important;overflow:hidden;border-width:0;}

/* Pager */
.sig-panel-right{display:flex;align-items:center;gap:8px;flex-shrink:0;margin-left:auto;}
.sig-pager{display:flex;align-items:center;gap:5px;}
.sig-pager-hidden{visibility:hidden;}
.sig-pager-dot{width:6px;height:6px;border-radius:50%;background:var(--bdr);cursor:pointer;transition:background .2s,transform .2s;}
.sig-pager-dot:hover{background:var(--dim);}
.sig-pager-dot.active{background:var(--acc);transform:scale(1.3);}
.sig-pager-label{font-size:10px;color:var(--dim);font-family:var(--mono);margin-left:2px;}

/* ORDER PANEL */
.ord-panel{margin:0;background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.4);contain:layout;}
.ord-panel-demo{border-color:var(--yel);box-shadow:0 0 0 1px rgba(234,179,8,.25);}
.ord-selected-label{font-size:12px;letter-spacing:1.5px;color:var(--acc);font-weight:700;text-transform:uppercase;padding:10px 18px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.ord-head{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--bdr);background:var(--bg3);}

.ord-pos-orders{padding:12px 18px;border-bottom:1px solid var(--bdr);background:rgba(59,130,246,0.04);overflow:hidden;}
.ord-pos-orders-title{font-size:11px;letter-spacing:1px;color:var(--dim);font-weight:700;margin-bottom:8px;text-transform:uppercase;}
.ord-pos-order-row{display:flex;flex-direction:column;gap:4px;padding:8px 0;font-size:12px;}
.ord-pos-order-row+.ord-pos-order-row{border-top:1px solid var(--bdr);}
.ord-pos-order-top{display:flex;align-items:center;gap:8px;min-width:0;}
.ord-pos-order-type{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ord-pos-order-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11.5px;}
.ord-title{display:flex;align-items:center;gap:10px;}
.ord-price-hint{font-size:10px;color:var(--dim);margin-top:5px;font-style:italic;}
.ord-manual-badge{font-size:12px;font-weight:700;color:var(--dim);background:var(--bg2);padding:3px 9px;border-radius:5px;letter-spacing:.3px;}
.ord-badge{font-size:12px;}
.ord-sym{font-family:var(--mono);font-size:16px;font-weight:700;}
.ord-close-x{background:none;border:none;color:var(--dim);font-size:16px;cursor:pointer;width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.ord-collapse-btn{background:none;border:none;color:var(--dim);font-size:14px;cursor:pointer;width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.ord-collapse-btn:hover{background:var(--bg3);color:var(--txt);}
.ord-close-x:hover{background:var(--bdr);color:var(--txt);}
.ord-type-tabs{display:flex;background:var(--bg2);border-bottom:1px solid var(--bdr);gap:4px;padding:8px 16px;}
.ord-tt{flex:1;background:var(--bg3);border:1px solid var(--bdr);color:var(--dim);padding:10px 6px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;border-radius:8px;display:flex;align-items:center;justify-content:center;gap:5px;letter-spacing:.2px;}
.ord-tt:hover{color:var(--txt);border-color:var(--bdr2);background:var(--bg4);}
.ott-on{color:#fff!important;border-color:var(--acc)!important;background:linear-gradient(135deg,rgba(59,130,246,.3),rgba(59,130,246,.15))!important;box-shadow:0 0 12px rgba(59,130,246,.2);}
.ord-tt-icon{font-size:14px;}
/* Leverage */
.ord-lev-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding:0 10px;}
.ord-lev-val{font-family:var(--mono);font-size:16px;font-weight:700;color:var(--cyan);}
.ord-lev-slider-wrap{display:flex;flex-direction:column;gap:6px;padding:0 10px;}
.ord-lev-slider{width:100%;accent-color:var(--acc);height:4px;cursor:pointer;}
.ord-lev-ticks{display:flex;justify-content:space-between;padding:0 10px;}
.ord-lev-tick{font-size:11px;color:var(--dim);cursor:pointer;padding:2px 6px;border-radius:4px;transition:all .15s;font-family:var(--mono);}
.ord-lev-tick:hover{color:var(--txt);}
.ord-notional{font-size:11px;font-family:var(--mono);padding:0 10px;}
.ord-notional-ok{color:var(--grn);}
.ord-notional-warn{color:var(--yel);}
.ord-lev-max{font-size:11px;color:var(--dim);font-weight:400;margin-left:4px;}
.otk-on{color:var(--acc)!important;background:rgba(59,130,246,.15);font-weight:700;}
.ord-body{padding:0 0 4px;display:flex;flex-direction:column;gap:0;}
.ord-row{display:flex;flex-direction:column;gap:5px;padding:0 10px;}
.ord-label{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-input-wrap{display:flex;align-items:center;background:var(--bg2);border:1px solid var(--bdr);border-radius:7px;overflow:hidden;transition:border-color .15s;}
.ord-input-wrap:focus-within{border-color:var(--acc);}
.ord-input{flex:1;background:transparent;border:none;color:var(--txt);padding:9px 12px;font-family:var(--mono);font-size:14px;outline:none;}
.ord-input-sfx{padding:0 12px;color:var(--dim);font-size:12px;border-left:1px solid var(--bdr);}
.ord-levels{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:10px 0;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);}
.ord-lev{display:flex;flex-direction:column;gap:3px;}
.ord-lev-l{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-lev-v{font-size:13px;cursor:pointer;transition:opacity .15s;}
.ord-lev-v:hover{opacity:.7;}
.ord-lev-use{font-size:10px;opacity:.5;}
.ord-balance-row{display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--bdr);background:rgba(34,211,238,.04);border-left:3px solid var(--cyan);}
.ord-balance-l{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.4px;}
.ord-balance-v{font-size:14px;font-weight:700;color:var(--cyan);font-family:var(--mono);}
.ord-balance-sub{font-size:10.5px;margin-left:auto;}
.ord-tp-total{font-size:11px;font-weight:700;}
.ord-tp-row{display:flex;align-items:center;gap:6px;margin-bottom:6px;}
.ord-tp-row .ord-input{border:1px solid var(--bdr);background:var(--bg2);border-radius:6px;padding:7px 10px;font-size:13px;}
.ord-tp-price{flex:2;}
.ord-tp-pct-wrap{position:relative;flex:1;min-width:0;}
.ord-tp-pct{width:100%;padding-right:20px!important;}
.ord-tp-pct-sfx{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--dim);pointer-events:none;}
.ord-tp-remove{background:none;border:none;color:var(--dim);cursor:pointer;font-size:13px;padding:4px 6px;flex-shrink:0;}
.ord-tp-remove:hover{color:var(--red);}
.ord-tp-add{width:calc(100% - 20px);padding:7px;background:rgba(59,130,246,.08);border:1px dashed var(--acc);border-radius:6px;color:var(--acc);font-size:12px;cursor:pointer;margin:2px 10px 0;}
.ord-tp-add:hover{background:rgba(59,130,246,.15);}
.ord-error{padding:8px 12px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:6px;font-size:12px;color:var(--red);}
.ord-ok{padding:8px 12px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);border-radius:6px;font-size:12px;color:var(--grn);}
.ord-actions{display:flex;gap:8px;padding:12px 16px;}
.ord-cancel-btn{flex:1;background:var(--bg2);border:1px solid var(--bdr);color:var(--dim);padding:10px;border-radius:7px;font-size:13px;cursor:pointer;transition:all .15s;}
.ord-cancel-btn:hover{color:var(--txt);border-color:var(--bdr);}
.ord-submit-btn{flex:2;border:none;padding:10px;border-radius:7px;font-size:15px;font-weight:800;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.osb-buy{background:linear-gradient(135deg,#059669,#10b981);color:#fff;font-weight:700;letter-spacing:.2px;}
.osb-buy:hover{background:linear-gradient(135deg,#047857,#059669);box-shadow:0 4px 20px rgba(16,185,129,.5);}
.osb-sell{background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;}
.osb-sell:hover{box-shadow:0 4px 16px rgba(239,68,68,.4);}
.ord-submit-btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;}
.ord-spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}

.ord-position-box{margin-top:4px;padding:14px 16px;background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;display:flex;flex-direction:column;gap:10px;}
.ord-position-head{display:flex;align-items:center;justify-content:space-between;}
.ord-position-title{font-size:12px;letter-spacing:1px;color:var(--dim);font-weight:700;text-transform:uppercase;}
.ord-position-pnl-hero{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding:14px 16px 14px 20px;border-bottom:1px solid var(--bdr);margin-bottom:0;position:relative;background:var(--bg3);}
.ord-position-pnl-hero::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:0 2px 2px 0;background:var(--red);}
.ord-position-pnl-hero-v{font-size:32px;font-weight:900;letter-spacing:-1.5px;line-height:1;font-family:var(--mono);}
.ord-position-roi-hero{font-size:16px;font-weight:800;}
.ord-position-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;background:transparent;border-radius:0;padding:12px 16px;border:none;border-bottom:1px solid var(--bdr);}
.ord-position-cell{display:flex;flex-direction:column;gap:4px;}
.ord-position-l{font-size:12px;color:var(--dim);letter-spacing:.5px;}
.ord-position-v{font-size:13px;color:var(--txt);font-weight:600;font-family:var(--mono);}
.ord-position-pnl.up,.ord-position-roi.up{color:var(--grn);}
.ord-position-pnl.dn,.ord-position-roi.dn{color:var(--red);}
.ord-position-roi{font-size:13px;font-weight:600;}
.ord-position-liq-warn{padding:6px 10px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);border-radius:6px;font-size:10px;color:var(--yel);display:flex;align-items:center;gap:6px;font-family:var(--mono);font-weight:500;}
/* Liq progress bar */
.ord-liq-section{padding:10px 16px 6px;border-top:1px solid var(--bdr);margin-top:0;}
.ord-liq-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;}
.ord-liq-title{font-size:11px;font-weight:700;color:var(--dim);text-transform:uppercase;letter-spacing:.4px;}
.ord-liq-pct{font-size:11px;font-weight:700;color:var(--yel);font-family:var(--mono);}
.ord-liq-track{height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;margin-bottom:4px;position:relative;}
.ord-liq-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--grn) 0%,var(--yel) 55%,var(--red) 100%);}
.ord-liq-cursor{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--red);border-radius:1px;}
.ord-liq-labels{display:flex;justify-content:space-between;font-size:11px;font-family:var(--mono);margin-top:3px;}
/* TP/SL bars in position panel */
.ord-tpsl-section{padding:10px 16px 8px;border-top:1px solid var(--bdr);margin-top:0;}
.ord-tpsl-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.ord-tpsl-title{font-size:11px;font-weight:700;color:var(--dim);text-transform:uppercase;letter-spacing:.4px;}
.ord-tpsl-edit{font-size:11px;color:var(--cyan);cursor:pointer;font-weight:600;}
.ord-tp-row{display:flex;align-items:center;gap:5px;margin-bottom:3px;}
.ord-tp-lbl{font-size:11px;font-weight:800;width:22px;font-family:var(--mono);flex-shrink:0;}
.ord-tp-track{flex:1;height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.ord-tp-fill{height:100%;border-radius:2px;}
.ord-tp-fill-g{background:var(--grn);opacity:.6;}
.ord-tp-fill-r{background:var(--red);opacity:.45;}
.ord-tp-price{font-size:12px;font-weight:600;width:66px;text-align:right;}
.ord-tp-pct{font-size:11px;font-family:var(--mono);width:42px;text-align:right;}
.ord-sl-sep{height:1px;background:var(--bdr);margin:5px 0;}
.ord-add-to-pos-btn{width:100%;margin-top:10px;padding:9px;background:rgba(59,130,246,.08);border:1px dashed var(--acc);border-radius:6px;color:var(--acc);font-size:12px;font-weight:600;cursor:pointer;}
.ord-add-to-pos-btn:hover{background:rgba(59,130,246,.15);}
.ord-add-to-pos-box{margin-top:10px;padding:12px;background:var(--bg2);border:1px solid var(--bdr);border-radius:8px;display:flex;flex-direction:column;gap:10px;}
.ord-type-tabs{display:flex;gap:4px;background:var(--bg3);border-radius:6px;padding:3px;}
.ord-type-tab{flex:1;padding:6px;border:none;background:none;border-radius:5px;font-size:12px;font-weight:600;color:var(--dim);cursor:pointer;}
.ord-type-tab.ord-type-tab-on{background:var(--acc);color:#fff;}
.ord-add-to-pos-head{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:600;color:var(--txt);}
.ord-leverage-slider{width:100%;}
.ord-position-close-btn{border:1px solid rgba(239,68,68,.4);background:rgba(239,68,68,.1);color:var(--red);padding:8px;border-radius:7px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:6px;letter-spacing:.2px;}
.ord-position-close-btn:hover:not(:disabled){background:rgba(239,68,68,.18);box-shadow:0 4px 14px rgba(239,68,68,.25);}
.ord-position-close-btn:disabled{opacity:.5;cursor:not-allowed;}

.mk-side-tbl{position:sticky;top:calc(var(--vertex-header-h) + 60px);background:var(--bg3);border:1px solid var(--bdr);border-radius:10px;overflow:hidden;resize:vertical;height:calc(100vh - var(--vertex-header-h) - 80px);min-height:300px;max-height:calc(100vh - var(--vertex-header-h) - 40px);scrollbar-width:none;display:flex;flex-direction:column;}
.mk-side-tbl::-webkit-scrollbar{display:none;}
.mk-side-tbl-title{font-family:var(--mono);font-size:10px;letter-spacing:1.5px;color:var(--dim);font-weight:700;padding:10px 14px 8px;flex-shrink:0;}

.mk-side-search-wrap{display:flex;align-items:center;gap:6px;margin:0 14px 8px;padding:6px 10px;background:var(--bg);border:1px solid var(--bdr);border-radius:8px;flex-shrink:0;}
.mk-side-tabs{display:flex;gap:4px;margin:0 14px 8px;flex-shrink:0;}
.mk-side-tab{flex:1;padding:5px 8px;border-radius:6px;border:1px solid var(--bdr);background:var(--bg);color:var(--dim);font-size:10.5px;font-weight:600;cursor:pointer;text-align:center;}
.mk-side-tab.mk-side-tab-on{background:rgba(34,211,238,.15);color:var(--cyan);border-color:rgba(34,211,238,.3);}
.mk-side-search-icon{font-size:11px;opacity:.5;flex-shrink:0;}
.mk-side-search{flex:1;background:none;border:none;color:var(--txt);font-size:12px;outline:none;min-width:0;}
.mk-side-search::placeholder{color:var(--dim);}
.mk-side-search-clear{background:none;border:none;color:var(--dim);cursor:pointer;font-size:11px;padding:0 2px;flex-shrink:0;}
.mk-side-search-clear:hover{color:var(--txt);}

.mk-side-rank{font-family:var(--mono);font-size:10px;color:var(--acc);font-weight:700;width:16px;flex-shrink:0;text-align:center;}
.mk-side-empty{padding:16px 14px;text-align:center;color:var(--dim);font-size:12px;}

.mk-side-tbl-scroll{flex:1;overflow-y:auto;scrollbar-width:none;}
.mk-side-tbl-scroll::-webkit-scrollbar{display:none;}
.mk-side-row{display:flex;align-items:center;gap:8px;padding:7px 14px;cursor:pointer;transition:background .1s;border-top:1px solid var(--bdr);}
.mk-side-row:first-child{border-top:none;}
.mk-side-row:hover{background:var(--bg2);}
.mk-side-row-sel{background:rgba(34,211,238,.06);box-shadow:inset 3px 0 0 var(--cyan);}
.mk-side-sym{flex:1;min-width:0;font-size:13px;font-weight:700;color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.mk-side-price{font-size:12px;color:var(--dim);}
.mk-side-chg{font-size:12px;font-weight:700;min-width:48px;text-align:right;}

/* TABLE */
.mk-tbl-wrap{padding:20px 28px;}
.mk-tbl-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--bdr);}
.mk-tbl-scroll{overflow-x:auto;scrollbar-width:none;}
.mk-tbl-scroll::-webkit-scrollbar{display:none;}
.mk-tbl{width:100%;border-collapse:collapse;}
.mk-tbl th{text-align:left;padding:7px 12px;font-size:10px;letter-spacing:1px;color:var(--dim);border-bottom:1px solid var(--bdr);white-space:nowrap;}
.mk-tbl td{padding:8px 12px;border-bottom:1px solid var(--bdr);}
.mk-tbl tr{cursor:pointer;transition:background .1s;}
.mk-tbl tr:hover td{background:var(--bg3);}
.mk-row-sel td{background:var(--bg3)!important;}
.mk-row-sel td:first-child{border-left:3px solid var(--acc);}
.mk-rsym{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--acc);}
.mk-rtf{background:var(--bg3);padding:2px 6px;border-radius:3px;font-size:10px;color:var(--dim);}
.mk-mono{font-family:var(--mono);font-size:12px;}

.mk-hints{display:flex;gap:16px;padding:8px 4px 0;font-size:11px;color:var(--dim);flex-wrap:wrap;}

/* OPEN ORDERS / POSITIONS — sized like a real exchange panel, not a compact strip */
.mk-acct-summary{display:flex;gap:0;background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;padding:12px 20px;margin-bottom:14px;}
.mk-acct-item{flex:1;padding:0 16px;border-right:1px solid var(--bdr);}
.mk-acct-item:last-child{border-right:none;}
.mk-acct-item:first-child{padding-left:0;}
.mk-acct-label{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;}
.mk-acct-value{font-size:18px;font-weight:800;letter-spacing:-.4px;}
.mk-acct-sub{font-size:12px;font-weight:500;color:var(--dim);margin-left:4px;}
@@media(max-width:900px){.mk-acct-summary{flex-wrap:wrap;gap:10px;}.mk-acct-item{flex:1 1 45%;border-right:none;border-bottom:1px solid var(--bdr);padding-bottom:8px;}}
.mk-oo-panel{background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;padding:18px 20px;overflow:auto;resize:vertical;height:480px;max-height:2000px;scrollbar-width:none;}
.mk-oo-panel::-webkit-scrollbar{display:none;}
.mk-oo-tabs{display:flex;gap:4px;margin-bottom:14px;padding:4px;background:var(--bg3);border-radius:10px;border:1px solid var(--bdr);}
.mk-oo-tab{display:flex;align-items:center;gap:7px;background:none;border:none;color:var(--dim);font-family:var(--mono);font-size:12px;letter-spacing:.4px;font-weight:700;padding:7px 14px 7px;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color .15s,border-color .15s;min-width:140px;}
.mk-oo-tab:hover{color:var(--txt);background:rgba(255,255,255,.04);border-radius:7px;}
.mk-oo-tab-on{color:#fff!important;background:var(--acc);border-radius:7px;box-shadow:0 2px 8px rgba(59,130,246,.35);}
.mk-oo-tab-on:hover{background:var(--acc)!important;}
.mk-oo-spin{color:var(--acc);animation:mkSpin 1s linear infinite;}
@@keyframes mkSpin{to{transform:rotate(360deg);}}
.mk-pos-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
.mk-pos-filter-cb{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--dim);cursor:pointer;white-space:nowrap;}
.mk-pos-filter-cb input{accent-color:var(--acc);cursor:pointer;}
.mk-pos-sort-btns{display:flex;align-items:center;gap:4px;flex-wrap:wrap;}
.mk-sort-btn{padding:3px 9px;border-radius:5px;border:1px solid var(--bdr);background:transparent;color:var(--dim);cursor:pointer;font-size:11px;font-weight:600;transition:all .12s;}
.mk-sort-btn:hover{border-color:var(--acc);color:var(--acc);}
.mk-sort-btn-on{border-color:var(--acc)!important;color:var(--acc)!important;background:rgba(59,130,246,.08)!important;}
.mk-oo-count{background:var(--bg2);color:var(--txt);font-size:11px;font-weight:700;padding:2px 8px;border-radius:10px;border:1px solid var(--bdr);}
.mk-oo-tab-on .mk-oo-count{background:rgba(255,255,255,.2);border-color:transparent;color:#fff;}
.mk-oo-mode-badge{margin-left:auto;padding:3px 10px;border-radius:6px;font-size:10px;font-weight:800;letter-spacing:1.5px;align-self:center;}
.mk-oo-mode-live{background:rgba(34,197,94,.15);color:var(--grn);border:1px solid rgba(34,197,94,.3);}
.mk-oo-mode-demo{background:rgba(234,179,8,.12);color:var(--yel);border:1px solid rgba(234,179,8,.3);}
.mk-oo-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.mk-oo-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;}
.mk-oo-empty{font-size:13px;color:var(--dim);padding:24px 2px;text-align:center;}
.mk-algo-debug{font-size:11px;color:var(--acc);background:rgba(59,130,246,0.08);padding:6px 10px;border-radius:6px;margin-bottom:10px;word-break:break-all;}
.mk-oo-scroll{overflow-y:visible;scrollbar-width:none;}
.mk-oo-scroll::-webkit-scrollbar{display:none;}
.mk-oo-tbl{width:100%;border-collapse:collapse;}
.mk-oo-tbl th{position:sticky;top:0;background:var(--bg2);text-align:left;padding:8px 14px;font-size:11px;letter-spacing:.5px;color:var(--dim);border-bottom:1px solid var(--bdr);white-space:nowrap;font-weight:600;}
.mk-oo-tbl td{padding:9px 14px;font-size:13px;border-bottom:1px solid var(--bdr);white-space:nowrap;}
.mk-pos-row{cursor:pointer;transition:background .12s;}
.mk-oo-row-clickable{cursor:pointer;transition:background .12s;}
.mk-oo-row-clickable:hover{background:rgba(255,255,255,.03);}
.mk-pos-row:hover{background:rgba(255,255,255,0.04);}
.mk-pos-row-sel{background:rgba(59,130,246,0.1);box-shadow:inset 2px 0 0 var(--acc);}
.mk-pos-row-loading{opacity:.7;cursor:wait;}
.mk-pos-spin{display:inline-block;margin-left:6px;color:var(--acc);animation:mkPosSpin .8s linear infinite;font-size:11px;}
.mk-dca-badge{margin-left:6px;font-size:9px;font-weight:800;letter-spacing:.8px;padding:1px 5px;border-radius:4px;background:rgba(99,102,241,.18);color:#818cf8;border:1px solid rgba(99,102,241,.3);vertical-align:middle;}
@@keyframes mkPosSpin{to{transform:rotate(360deg);}}
.mk-oo-sym{font-family:var(--mono);font-weight:700;color:var(--acc);font-size:13.5px;}
.mk-liq{color:#f59e0b;}
.mk-oo-cancel{background:none;border:1px solid var(--bdr);color:var(--dim);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;line-height:1;white-space:nowrap;flex-shrink:0;}
.mk-pos-actions{display:flex;flex-direction:row;align-items:center;gap:6px;position:relative;justify-content:flex-end;flex-wrap:wrap;}
.mk-pos-close-btn{padding:5px 14px;border-radius:7px;border:1px solid var(--red);background:rgba(239,68,68,.1);color:var(--red);cursor:pointer;font-size:12px;font-weight:700;white-space:nowrap;transition:all .15s;}
.mk-pos-close-btn:hover:not(:disabled){background:var(--red);color:#fff;}
.mk-pos-close-btn:disabled{opacity:.5;cursor:not-allowed;}
.mk-pos-partial-btn2{padding:5px 14px;border-radius:7px;border:1px solid var(--bdr);background:transparent;color:var(--dim);cursor:pointer;font-size:12px;font-weight:700;white-space:nowrap;transition:all .15s;}
.mk-pos-partial-btn2:hover:not(:disabled){border-color:var(--acc);color:var(--acc);background:rgba(59,130,246,.08);}
.mk-pos-partial-btn2:disabled{opacity:.5;cursor:not-allowed;}
.mk-partial-slider-box{display:flex;flex-direction:column;gap:6px;background:var(--bg2);border:1px solid var(--bdr);border-radius:8px;padding:8px 10px;min-width:220px;position:absolute;z-index:30;right:0;top:100%;margin-top:4px;box-shadow:0 8px 20px rgba(0,0,0,.4);}
.mk-partial-slider-row{display:flex;align-items:center;gap:8px;}
.mk-partial-slider{flex:1;}
.mk-partial-pct{font-size:12px;font-weight:700;width:38px;text-align:right;}
.mk-partial-preview{display:flex;justify-content:space-between;font-size:11px;}
.mk-partial-actions{display:flex;gap:6px;}
.mk-partial-confirm{flex:1;background:var(--red);color:#fff;border-color:var(--red);}
.mk-pos-partial-btn:hover:not(:disabled){border-color:var(--acc);color:var(--acc);}
.mk-pos-partial-btn:disabled{opacity:.5;cursor:not-allowed;}
.mk-oo-cancel:hover:not(:disabled){border-color:var(--red);color:var(--red);}
.mk-oo-cancel:disabled{opacity:.5;cursor:not-allowed;}

