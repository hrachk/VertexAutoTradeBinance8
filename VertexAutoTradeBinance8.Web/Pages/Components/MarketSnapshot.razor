        else
        {
            try { await JS.InvokeVoidAsync("marketChart.hideTpSlLines", $"chartContainer-{_chartInstanceId}"); } catch { }
        }
    }

    async Task ShowTpSlLinesAsync()
    {
        if (_selectedPosition == null) return;
        var pos = _selectedPosition;

        // Filter by PositionSide too, not just Symbol — critical for
        // hedge-mode accounts where the same symbol can have
        // simultaneous LONG and SHORT positions, each with their own
        // SL/TP orders. In one-way mode, PositionSide is always "BOTH"
        // regardless of actual direction, so that's accepted too
        // (matches everything, same as before this fix, for accounts
        // that don't use hedge mode).
        bool MatchesPosition(OpenOrderRow o) =>
            o.Symbol == pos.Symbol &&
            (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

        var sl = _openOrders.FirstOrDefault(o => MatchesPosition(o) && o.Type.Contains("STOP"))?.Price ?? 0m;
        var tps = _openOrders
            .Where(o => MatchesPosition(o) && o.Type.Contains("TAKE_PROFIT"))
            .OrderBy(o => pos.Side == "LONG" ? o.Price : -o.Price)
            .Select(o => o.Price)
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("marketChart.showTpSlLines",
                $"chartContainer-{_chartInstanceId}", pos.EntryPrice, sl, tps, pos.Side);
        }
        catch { }
    }

    // AI sizing: given an entry price (chart-picked or signal default),
    // current free balance and the symbol's max leverage, suggest both
    // a sensible quantity AND bump leverage if the balance is too small
    // to comfortably afford the position at the current leverage.
    async Task SuggestQtyForPrice(decimal entryPrice)
    {
        if (_activeSignal == null || entryPrice <= 0) return;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));

            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            decimal balance = 0m;
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null) balance = usdt.AvailableBalance;
            }
            if (balance <= 0) return;

            decimal stopDist = _activeSignal.StopLoss > 0
                ? Math.Abs(entryPrice - _activeSignal.StopLoss)
                : (_activeSignal.ATR > 0 ? _activeSignal.ATR * 1.5m : entryPrice * 0.01m);

            decimal riskUsdt = balance * 0.02m; // 2% of balance at risk
            decimal rawQty   = stopDist > 0 ? riskUsdt / stopDist : 0m;

            // Minimum quantity to satisfy exchange minNotional.
            decimal minQtyForNotional = _symMinNotional / entryPrice;
            decimal qty = Math.Max(rawQty, minQtyForNotional);

            decimal step = _symStep > 0 ? _symStep : 0.001m;
            qty = Math.Floor(qty / step) * step;
            if (qty <= 0) qty = step;

            // Margin needed at the CURRENT leverage setting.
            decimal notional     = qty * entryPrice;
            decimal marginNeeded = notional / Math.Max(_orderLeverage, 1);

            // If the position would eat up almost the whole balance as margin,
            // the leverage is too low for this balance size — raise it
            // (capped at the symbol's real max) so margin usage settles
            // around ~50%, instead of letting the order fail on insufficient
            // margin or forcing the user to manually drag the slider.
            if (marginNeeded > balance * 0.9m)
            {
                int neededLev = (int)Math.Ceiling(notional / (balance * 0.5m));
                _orderLeverage = Math.Clamp(neededLev, _orderLeverage, _symMaxLev);
            }

            _orderQty = qty;
        }
        catch { }
    }

    void SelectSignal(MissedTradeRecord sig)
    {
        _seenSignalKeys.Add(SignalKey(sig));
        _activeSignal  = _activeSignal == sig ? null : sig;
        _selectedPosition = null;
        _orderError    = string.Empty;
        _orderSuccess  = string.Empty;
        _orderType     = "Market";
        _orderLeverage = 10;
        _orderQty      = 0;
        _orderPrice    = sig.Entry;

        if (_activeSignal != null)
        {
            _orderPanelDismissed = false;
            PickSym(sig.Symbol);
            _ = LoadSymbolInfoAndSuggestQty(sig);
            _ = LoadCurrentPositionAsync(sig.Symbol);

            // Auto-fill SL/TP straight from the signal's own levels —
            // one click sets up the whole trade (qty, leverage already
            // computed above; SL/TP here), not just the entry price.
            // Splits evenly across however many TP levels the signal
            // actually provided.
            _manualSlPrice = sig.StopLoss;
            _manualTps = new List<ManualTpRow>();
            if (sig.TakeProfits != null && sig.TakeProfits.Count > 0)
            {
                decimal evenPct = Math.Round(100m / sig.TakeProfits.Count, 0);
                for (int i = 0; i < sig.TakeProfits.Count; i++)
                {
                    bool isLast = i == sig.TakeProfits.Count - 1;
                    decimal pct = isLast ? (100m - evenPct * i) : evenPct; // last row absorbs any rounding remainder
                    _manualTps.Add(new ManualTpRow { Price = sig.TakeProfits[i], Pct = pct });
                }
            }
        }
        else
        {
            _orderPanelDismissed = true;
            _currentPosition = null;
            _manualSlPrice = 0;
            _manualTps.Clear();
        }
    }

    async Task LoadSymbolInfoAndSuggestQty(MissedTradeRecord sig)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            // 1) Exchange info → tickSize, stepSize, minNotional
            var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
            if (ei.Success)
            {
                var s = ei.Data.Symbols.FirstOrDefault(x => x.Name == sig.Symbol);
                if (s != null)
                {
                    _symTickSize    = s.PriceFilter?.TickSize   ?? 0.0001m;
                    _symStep        = s.LotSizeFilter?.StepSize ?? 0.001m;
                    _symMinNotional = 5m;
                    foreach (var f in s.Filters)
                    {
                        if (f is Binance.Net.Objects.Models.Spot.BinanceSymbolMinNotionalFilter mn)
                        { _symMinNotional = mn.MinNotional; break; }
                    }
                }
            }

            // 2) Real MaxLeverage via GetBracketsAsync
            try
            {
                var br = await client.UsdFuturesApi.Account
                    .GetBracketsAsync(sig.Symbol, ct: cts.Token);
                if (br.Success && br.Data != null)
                {
                    var sb = br.Data.FirstOrDefault(b => b.Symbol == sig.Symbol);
                    if (sb?.Brackets?.Length > 0)
                    {
                        _symMaxLev = sb.Brackets.Max(b => b.InitialLeverage);
                        if (_orderLeverage > _symMaxLev)
                            _orderLeverage = Math.Min(_symMaxLev, 20);
                    }
                }
            }
            catch { }

            // 3) Round price to tickSize
            if (_symTickSize > 0 && sig.Entry > 0)
                _orderPrice = Math.Round(sig.Entry / _symTickSize) * _symTickSize;

            // 4) Suggest qty from balance with 2% risk
            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null && usdt.AvailableBalance > 0 && sig.Entry > 0)
                {
                    decimal balance  = usdt.AvailableBalance;
                    decimal riskUsdt = balance * 0.02m;
                    decimal stopDist = sig.StopLoss > 0
                        ? Math.Abs(sig.Entry - sig.StopLoss)
                        : (sig.ATR > 0 ? sig.ATR * 1.5m : sig.Entry * 0.01m);

                    decimal rawQty = stopDist > 0 ? riskUsdt / stopDist : 0m;
                    decimal minQty = sig.Entry > 0 ? _symMinNotional / sig.Entry : 0m;
                    rawQty = Math.Max(rawQty, minQty);

                    decimal step = _symStep > 0 ? _symStep : 0.001m;
                    _orderQty = Math.Floor(rawQty / step) * step;

                    // 5) Smart leverage — per the standard risk-management
                    // rule (confirmed via several position-sizing
                    // references): liquidation distance should be at
                    // least 2x the stop-loss distance, otherwise the
                    // exchange force-closes the position before the SL
                    // ever triggers (paying extra liquidation fees on top).
                    // Isolated-margin liquidation distance is approximately
                    // 1/leverage, so the highest safe leverage is roughly
                    // 1 / (2 × stopDistPct). Capped at a sane ceiling (20x)
                    // and the symbol's real exchange max — never suggests
                    // something reckless just because the math allows it.
                    if (sig.Entry > 0 && stopDist > 0)
                    {
                        decimal stopDistPct = stopDist / sig.Entry;
                        decimal safeLeverage = stopDistPct > 0 ? 1m / (2m * stopDistPct) : 20m;
                        int suggestedLev = (int)Math.Floor(Math.Clamp(safeLeverage, 1m, 20m));
                        _orderLeverage = Math.Min(suggestedLev, _symMaxLev > 0 ? _symMaxLev : suggestedLev);
                        if (_orderLeverage < 1) _orderLeverage = 1;
                    }
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    // Fetches ALL open positions (no symbol filter), so the positions
    // table under the chart always shows everything regardless of
    // which symbol happens to be selected on the chart.
    async Task LoadAllOpenPositionsAsync()
    {
        _positionsLoading = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account.GetPositionInformationAsync(ct: cts.Token);
            if (!res.Success || res.Data == null) { _allPositions = new(); return; }

            // Account summary (margin/wallet balance, unrealized PnL) —
            // fetched directly via the same Binance client/pattern
            // already proven working for positions just above, NOT
            // through the LivePnlService/AccountStateController path,
            // which was fundamentally broken: that relied on a Web-side
            // AccountStateService instance that the real Engine process
            // never updates (Web and Engine are separate .NET processes
            // with entirely separate DI containers — the Web-side
            // instance just sits at its default, never-updated values).
            try
            {
                using var acctCts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                var acctRes = await client.UsdFuturesApi.Account.GetAccountInfoV3Async(ct: acctCts.Token);
                if (acctRes.Success && acctRes.Data != null)
                {
                    _acctMarginBalance = acctRes.Data.TotalMarginBalance;
                    _acctWalletBalance = acctRes.Data.TotalWalletBalance;
                    _acctUnrealizedPnl = acctRes.Data.TotalUnrealizedProfit;
                    _acctAvailableBalance = acctRes.Data.AvailableBalance;
                }
            }
            catch { /* account summary is a nice-to-have on this page; don't let it block position loading */ }

            // Realized PnL today — via Binance's own Income History
            // endpoint, filtered to REALIZED_PNL entries since UTC
            // midnight. THROTTLED to once per minute, not every 5-second
            // tick: confirmed via Binance's own API docs this endpoint
            // costs 30 weight (6x heavier than Positions/Account at 5
            // each) — at the previous rate this alone consumed 360
            // weight/minute (15% of the 2400/minute Futures limit) for
            // data that only changes when a trade actually closes, not
            // continuously like live position prices. Kept in its own
            // try/catch so a failure here never affects the more
            // important balance numbers above.
            if ((DateTime.UtcNow - _lastRealizedPnlFetchUtc) >= TimeSpan.FromMinutes(1))
            {
                try
                {
                    using var pnlCts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                    var todayStartUtc = DateTime.UtcNow.Date;
                    var incomeRes = await client.UsdFuturesApi.Account.GetIncomeHistoryAsync(
                        incomeType: "REALIZED_PNL",
                        startTime: todayStartUtc,
                        limit: 1000,
                        ct: pnlCts.Token);

                    if (incomeRes.Success && incomeRes.Data != null)
                        _acctRealizedPnlToday = incomeRes.Data.Sum(x => x.Income);

                    _lastRealizedPnlFetchUtc = DateTime.UtcNow;
                }
                catch { /* same — don't block the page on this */ }
            }

            _allPositions = res.Data
                .Where(p => p.Quantity != 0)
                .Select(p =>
                {
                    var side   = p.Quantity > 0 ? "LONG" : "SHORT";
                    var size   = Math.Abs(p.Quantity * p.EntryPrice);
                    var margin = p.MarginType == FuturesMarginType.Isolated
                        ? p.IsolatedMargin : size / Math.Max(p.Leverage, 1);
                    var roi    = margin > 0 ? p.UnrealizedPnl / margin : 0m;

                    return new ActivePositionInfo
                    {
                        Symbol     = p.Symbol,
                        Side       = side,
                        Leverage   = p.Leverage,
                        Size       = size,
                        Qty        = Math.Abs(p.Quantity),
                        EntryPrice = p.EntryPrice,
                        MarkPrice  = p.MarkPrice,
                        LiqPrice   = p.LiquidationPrice,
                        Margin     = margin,
                        Pnl        = p.UnrealizedPnl,
                        Roi        = roi
                    };
                })
                .OrderByDescending(p => Math.Abs(p.Pnl))
                .ToList();

            // CRITICAL FIX: ActivePositionInfo is a plain class with
            // reference equality, and the LINQ above creates entirely
            // NEW instances every single refresh — even for the exact
            // same still-open position. _selectedPosition held onto
            // the OLD instance, which after this point matches nothing
            // in the new _allPositions list via '==' (reference
            // comparison), even though the position itself is still
            // genuinely open and was never actually deselected. This
            // silently broke the "mk-pos-row-sel" highlight and the
            // ord-panel's "is this still selected" checks on every
            // single periodic tick — exactly the "after load everything
            // is lost" symptom from the screenshots. Fix: re-point the
            // reference at the fresh matching instance (by symbol+side,
            // since a symbol can have both a LONG and a SHORT position
            // open simultaneously, as seen in the screenshots) instead
            // of leaving it dangling.
            if (_selectedPosition != null)
            {
                _selectedPosition = _allPositions.FirstOrDefault(p =>
                    p.Symbol == _selectedPosition.Symbol && p.Side == _selectedPosition.Side)
                    ?? _selectedPosition;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
        finally { _positionsLoading = false; }
    }

    // Selecting a row in the positions table shows its details in the
    // right-side panel — same ActivePositionInfo shape the order panel
    // already uses, just driven by a table click instead of a signal.
    ActivePositionInfo? _selectedPosition;
    ActivePositionInfo? _selectingPosition;

    async Task SelectPosition(ActivePositionInfo pos)
    {
        bool wasSelected = PosIdentityEquals(_selectedPosition, pos);
        var newSelection = wasSelected ? null : pos;

        if (newSelection == null)
        {
            // Deselecting: hide chart lines, clear context, one clean
            // render — no network calls needed for this direction.
            _selectedPosition = null;
            _activeSignal = null;
            try { await JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}"); } catch { }
            StateHasChanged();
            return;
        }

        // Show a small, localized loading spinner on just this row —
        // doesn't touch the side panel, chart, or ALL INSTRUMENTS list
        // at all, so there's no layout jump while data loads.
        _selectingPosition = pos;
        StateHasChanged();

        // Selecting a new position: do ALL the network/data work FIRST,
        // while the UI still shows whatever it showed before — nothing
        // else visible changes yet, so there's no intermediate "empty"
        // frame for ALL INSTRUMENTS/Manual Trade/the chart to flash
        // through. Only once everything needed is actually ready do we
        // flip the rest of the state and render once.
        await LoadOpenOrdersAsync();

        // Resolve the new symbol's series data ourselves (the same
        // lookup PickSym does) without calling PickSym itself, since
        // PickSym fires its own early StateHasChanged()/RenderCharts()
        // — exactly the extra render pass causing the visible jank.
        var sym = pos.Symbol;
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);

        // Now flip all the state and render the panel itself
        // immediately — its own data is ready, so there's no reason
        // to make the user wait through the chart-related calls below
        // before seeing it. Those finish and trigger their own
        // (cheap, chart-only) update afterward.
        _selectedPosition = pos;
        _selectingPosition = null;
        _activeSignal = null;
        _activeSym = sym;
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        StateHasChanged();

        _dotNetRef ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("marketChart.bindSlTpCallbacks", $"chartContainer-{_chartInstanceId}", _dotNetRef); } catch { }

        // Chart data + position lines together, back-to-back — the
        // position panel itself is already visible at this point.
        try { await RenderCharts(); } catch { }
        await RefreshPositionLines();

        _ = JS.InvokeVoidAsync("tickerDragScroll.scrollSymbolIntoView", pos.Symbol);

        StateHasChanged();
    }

    async Task ClosePositionRow(ActivePositionInfo pos)
    {
        if (_demoMode)
        {
            DemoAccount.ClosePosition(pos.Id, 100m, "Manual");
            RefreshDemoSnapshot();
            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            return;
        }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            bool isLong = pos.Side == "LONG";
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;

            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: pos.Symbol,
                side: isLong ? OrderSide.Sell : OrderSide.Buy,
                type: FuturesOrderType.Market,
                quantity: pos.Qty,
                reduceOnly: isHedge ? null : true,
                positionSide: isHedge ? posSide : null,
                ct: cts.Token);

            if (PosIdentityEquals(_selectedPosition, pos)) _selectedPosition = null;
            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            await LoadAllOpenPositionsAsync();
        }
        catch { }
        finally { _orderLoading = false; }
    }

    async Task ClosePositionRowPartial(ActivePositionInfo pos, int pct)
    {
        if (_demoMode)
        {
            DemoAccount.ClosePosition(pos.Id, pct, "Manual");
            RefreshDemoSnapshot();
            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            return;
        }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            bool isLong = pos.Side == "LONG";
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;

            // Round the partial quantity to the symbol's real step size
            // — an arbitrary percentage of qty almost never lands on a
            // valid precision on its own, and an invalid quantity gets
            // rejected by the exchange outright.
            decimal step = 0.001m;
            try
            {
                var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
                var s = ei.Success ? ei.Data.Symbols.FirstOrDefault(x => x.Name == pos.Symbol) : null;
                if (s?.LotSizeFilter?.StepSize > 0) step = s.LotSizeFilter.StepSize.Value;
            }
            catch { }

            decimal partialQty = Math.Floor(pos.Qty * (pct / 100m) / step) * step;
            if (partialQty <= 0) return;

            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: pos.Symbol,
                side: isLong ? OrderSide.Sell : OrderSide.Buy,
                type: FuturesOrderType.Market,
                quantity: partialQty,
                reduceOnly: isHedge ? null : true,
                positionSide: isHedge ? posSide : null,
                ct: cts.Token);

            OpenShareCard(pos.Symbol, pos.Side, pos.Leverage, pos.Roi * 100m, pos.Pnl, pos.EntryPrice, pos.MarkPrice, isOpen: false);
            await LoadAllOpenPositionsAsync();
        }
        catch { }
        finally { _orderLoading = false; StateHasChanged(); }
    }

    async Task LoadCurrentPositionAsync(string symbol)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account.GetPositionInformationAsync(symbol: symbol, ct: cts.Token);
            if (!res.Success || res.Data == null) { _currentPosition = null; return; }

            var p = res.Data.FirstOrDefault(x => x.Quantity != 0);
            if (p == null) { _currentPosition = null; return; }

            var side   = p.Quantity > 0 ? "LONG" : "SHORT";
            var size   = Math.Abs(p.Quantity * p.EntryPrice);
            var margin = p.MarginType == FuturesMarginType.Isolated
                ? p.IsolatedMargin : size / Math.Max(p.Leverage, 1);
            var roi    = margin > 0 ? p.UnrealizedPnl / margin : 0m;

            _currentPosition = new ActivePositionInfo
            {
                Symbol     = p.Symbol,
                Side       = side,
                Leverage   = p.Leverage,
                Size       = size,
                Qty        = Math.Abs(p.Quantity),
                EntryPrice = p.EntryPrice,
                MarkPrice  = p.MarkPrice,
                LiqPrice   = p.LiquidationPrice,
                Margin     = margin,
                Pnl        = p.UnrealizedPnl,
                Roi        = roi
            };

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    async Task CloseCurrentPosition()
    {
        if (_currentPosition == null) return;

        _orderLoading = true;
        _orderError   = string.Empty;
        _orderSuccess = string.Empty;
        StateHasChanged();

        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _orderError = "No API credentials configured"; return; }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

            bool isLong  = _currentPosition.Side == "LONG";
            var side     = isLong ? OrderSide.Sell : OrderSide.Buy; // opposite side flattens it
            var posSide  = isLong ? PositionSide.Long : PositionSide.Short;

            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                symbol: _currentPosition.Symbol,
                side: side,
                type: FuturesOrderType.Market,
                quantity: _currentPosition.Qty,
                reduceOnly: isHedge ? null : true,
                positionSide: isHedge ? posSide : null,
                ct: cts.Token);

            if (r.Success)
            {
                _orderSuccess    = $"Position closed · {_currentPosition.Symbol} · {_currentPosition.Qty}";
                _currentPosition = null;
            }
            else
            {
                _orderError = $"Close failed {r.Error?.Code}: {r.Error?.Message}";
            }
        }
        catch (Exception ex) { _orderError = ex.Message; }
        finally { _orderLoading = false; StateHasChanged(); }
    }

    sealed class OpenOrderRow
    {
        public long OrderId;
        public string Symbol = "";
        public string Side = "";
        public string PositionSide = ""; // "LONG"/"SHORT"/"BOTH" — critical for hedge-mode accounts where one symbol can have simultaneous LONG+SHORT positions, each with their own SL/TP orders
        public string Type = "";
        public decimal Price;
        public decimal Qty;
        public decimal Filled;
        public bool ReduceOnly;
        public bool IsAlgo;
    }

    List<OpenOrderRow> _openOrders = new();
    string _lastAlgoOrdersDebug = "";
    string _ooActiveTab = "positions";

    void ShowPositionsTab() => _ooActiveTab = "positions";
    void ShowOrdersTab() => _ooActiveTab = "orders";
    void ShowHistoryTab() => _ooActiveTab = "history";

    void OpenShareCardFromHistory(DemoClosedTrade t)
    {
        decimal roiPct = t.EntryPrice > 0 && t.Qty > 0
            ? (t.RealizedPnl / (t.EntryPrice * t.Qty)) * 100m
            : 0m;
        OpenShareCard(t.Symbol, t.Side, 1, roiPct, t.RealizedPnl, t.EntryPrice, t.ExitPrice, isOpen: false);
    }
    bool _openOrdersLoading;
    long? _cancellingOrderId;

    // Conditional/algo orders (STOP_MARKET, TAKE_PROFIT_MARKET — the
    // exact types our TP/SL drag feature and Binance's own UI both
    // create) are NOT returned by GetOpenOrdersAsync at all. Since
    // Binance's December 2025 mandatory migration, these live in a
    // completely separate "Algo Order" service with its own dedicated
    // endpoint (GET /fapi/v1/openAlgoOrders) — the regular open-orders
    // endpoint genuinely does not know about them. This is the real
    // root cause of them never showing up, regardless of how Price vs
    // StopPrice was mapped (that fix was real but insufficient on its
    // own, since the orders weren't even being fetched in the first
    // place). Binance.Net 12.13.0 doesn't yet expose a typed method
    // for this endpoint, so this calls it directly via raw signed HTTP
    // — the EXACT same signing approach the Engine's own
    // PositionSupervisorService.BinanceAlgoOrderRaw already uses
    // successfully for PLACING these orders, just for reading instead.
    async Task<List<OpenOrderRow>> LoadAlgoOpenOrdersRawAsync(string? symbol = null)
    {
        var result = new List<OpenOrderRow>();
        try
        {
            var opt = BinanceOpts.CurrentValue;
            if (string.IsNullOrWhiteSpace(opt.ApiKey) || string.IsNullOrWhiteSpace(opt.SecretKey))
            {
                _lastAlgoOrdersDebug = "No API credentials configured";
                return result;
            }

            var http = HttpClientFactory.CreateClient("AlgoOrdersRaw");
            http.Timeout = TimeSpan.FromSeconds(8);

            var baseUrl = (opt.UseTestnet ? "https://testnet.binancefuture.com" : "https://fapi.binance.com");
            var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

            var q = new List<KeyValuePair<string, string>>
            {
                new("timestamp", ts.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            };
            if (!string.IsNullOrEmpty(symbol)) q.Add(new("symbol", symbol));

            var raw = string.Join("&", q.Select(kv => $"{kv.Key}={kv.Value}"));
            var encoded = string.Join("&", q.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

            using var hmac = new System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(opt.SecretKey));
            var hash = hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
            var sig = string.Concat(hash.Select(b => b.ToString("x2")));

            var url = $"{baseUrl}/fapi/v1/openAlgoOrders?{encoded}&signature={sig}";
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.TryAddWithoutValidation("X-MBX-APIKEY", opt.ApiKey);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            using var resp = await http.SendAsync(req, cts.Token);
            var body = await resp.Content.ReadAsStringAsync(cts.Token);

            if (!resp.IsSuccessStatusCode)
            {
                _lastAlgoOrdersDebug = $"HTTP {(int)resp.StatusCode}: {body}";
                return result;
            }

            using var doc = System.Text.Json.JsonDocument.Parse(body);
            // CONFIRMED via official Binance docs: the response is a
            // plain top-level JSON array, NOT wrapped in an "orders"
            // property as initially assumed — that wrong assumption
            // was the actual bug (JsonException: "requires an element
            // of type 'Object', but the target element has type
            // 'Array'" — TryGetProperty on an array root throws
            // exactly this).
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                _lastAlgoOrdersDebug = $"Unexpected response shape (not an array): {body}";
                return result;
            }

            foreach (var o in doc.RootElement.EnumerateArray())
            {
                decimal GetDec(string name) =>
                    o.TryGetProperty(name, out var v) && decimal.TryParse(v.GetString(), System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;
                string GetStr(string name) => o.TryGetProperty(name, out var v) ? (v.GetString() ?? "") : "";
                long GetLong(string name) =>
                    o.TryGetProperty(name, out var v)
                        ? (v.ValueKind == System.Text.Json.JsonValueKind.Number && v.TryGetInt64(out var l) ? l
                           : long.TryParse(v.GetString(), out var l2) ? l2 : 0L)
                        : 0L;

                result.Add(new OpenOrderRow
                {
                    OrderId    = GetLong("algoId"),
                    Symbol     = GetStr("symbol"),
                    Side       = GetStr("side").ToUpperInvariant(),
                    PositionSide = GetStr("positionSide").ToUpperInvariant(),
                    // Real field name confirmed via docs is "orderType"
                    // (e.g. "TAKE_PROFIT"/"STOP"), not "type".
                    Type       = GetStr("orderType"),
                    Price      = GetDec("triggerPrice"),
                    Qty        = GetDec("quantity"),
                    Filled     = GetDec("executedQty"),
                    ReduceOnly = o.TryGetProperty("reduceOnly", out var ro) && ro.GetBoolean(),
                    IsAlgo     = true,
                });
            }
            _lastAlgoOrdersDebug = $"OK — {result.Count} algo order(s) found";
        }
        catch (Exception ex)
        {
            _lastAlgoOrdersDebug = $"Exception: {ex.Message}";
        }
        return result;
    }

    async Task LoadOpenOrdersAsync()
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Trading.GetOpenOrdersAsync(ct: cts.Token);
            if (!res.Success || res.Data == null) return;

            var regularOrders = res.Data
                .Select(o => new OpenOrderRow
                {
                    OrderId    = o.Id,
                    Symbol     = o.Symbol,
                    Side       = o.Side.ToString().ToUpperInvariant(),
                    PositionSide = o.PositionSide?.ToString().ToUpperInvariant() ?? "",
                    Type       = o.Type.ToString(),
                    // Conditional orders (STOP_MARKET / TAKE_PROFIT_MARKET,
                    // the ones our own TP/SL drag feature creates) store
                    // their trigger price in StopPrice — Price is 0 for
                    // these since they execute at market once triggered.
                    // Same fallback the Engine's own OrderCleanerService.cs
                    // already uses.
                    Price      = o.StopPrice.HasValue && o.StopPrice.Value > 0 ? o.StopPrice.Value : o.Price,
                    Qty        = o.Quantity,
                    Filled     = o.QuantityFilled,
                    ReduceOnly = o.ReduceOnly,
                })
                .ToList();

            // Algo (conditional) orders live in a completely separate
            // Binance service since Dec 2025 — fetched via dedicated
            // raw HTTP call, see LoadAlgoOpenOrdersRawAsync above.
            var algoOrders = await LoadAlgoOpenOrdersRawAsync();

            _openOrders = regularOrders
                .Concat(algoOrders)
                .GroupBy(o => o.OrderId)
                .Select(g => g.First())
                .OrderBy(o => o.Symbol)
                .ToList();

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    async Task CancelOpenOrderAsync(OpenOrderRow row)
    {
        _cancellingOrderId = row.OrderId;
        StateHasChanged();
        try
        {
            if (row.IsAlgo)
            {
                await CancelAlgoOrderRawAsync(row.Symbol, row.OrderId);
            }
            else
            {
                var client = Factory.TryCreateRestClient();
                if (client == null) return;

                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                await client.UsdFuturesApi.Trading.CancelOrderAsync(row.Symbol, row.OrderId, ct: cts.Token);
            }
            await LoadOpenOrdersAsync();
        }
        catch { }
        finally
        {
            _cancellingOrderId = null;
            StateHasChanged();
        }
    }

    // Algo orders (the ones returned by LoadAlgoOpenOrdersRawAsync) use
    // a different id space (algoId) and a different cancel endpoint
    // (DELETE /fapi/v1/algoOrder) than regular orders — same signing
    // pattern as everywhere else here, reused once more.
    async Task CancelAlgoOrderRawAsync(string symbol, long algoId)
    {
        var opt = BinanceOpts.CurrentValue;
        if (string.IsNullOrWhiteSpace(opt.ApiKey) || string.IsNullOrWhiteSpace(opt.SecretKey)) return;

        var http = HttpClientFactory.CreateClient("AlgoOrdersRaw");
        http.Timeout = TimeSpan.FromSeconds(8);

        var baseUrl = opt.UseTestnet ? "https://testnet.binancefuture.com" : "https://fapi.binance.com";
        var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

        var q = new List<KeyValuePair<string, string>>
        {
            new("algoId", algoId.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            new("timestamp", ts.ToString(System.Globalization.CultureInfo.InvariantCulture)),
        };
        var raw = string.Join("&", q.Select(kv => $"{kv.Key}={kv.Value}"));
        var encoded = string.Join("&", q.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

        using var hmac = new System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(opt.SecretKey));
        var hash = hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
        var sig = string.Concat(hash.Select(b => b.ToString("x2")));

        var url = $"{baseUrl}/fapi/v1/algoOrder?{encoded}&signature={sig}";
        using var req = new HttpRequestMessage(HttpMethod.Delete, url);
        req.Headers.TryAddWithoutValidation("X-MBX-APIKEY", opt.ApiKey);

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
        try { await http.SendAsync(req, cts.Token); } catch { }
    }
    void OnPriceChange(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        _orderPrice = _symTickSize > 0
            ? Math.Round(v / _symTickSize) * _symTickSize
            : v;
    }

    void OnManualSlChange(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) { _manualSlPrice = 0; return; }
        _manualSlPrice = _symTickSize > 0 ? Math.Round(v / _symTickSize) * _symTickSize : v;
    }

    void AddManualTp()
    {
        // New row defaults to splitting the remaining unallocated %
        // evenly-ish — simplest reasonable default, not trying to be
        // clever about it.
        decimal remaining = Math.Max(0, 100m - _manualTps.Sum(t => t.Pct));
        _manualTps.Add(new ManualTpRow { Pct = remaining > 0 ? remaining : 100m / (_manualTps.Count + 1) });
    }

    void RemoveManualTp(int idx)
    {
        if (idx >= 0 && idx < _manualTps.Count) _manualTps.RemoveAt(idx);
    }

    void OnManualTpPriceChange(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _manualTps.Count) return;
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) { _manualTps[idx].Price = 0; return; }
        _manualTps[idx].Price = _symTickSize > 0 ? Math.Round(v / _symTickSize) * _symTickSize : v;
    }

    void OnManualTpPctChange(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _manualTps.Count) return;
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        _manualTps[idx].Pct = Math.Clamp(v, 1m, 100m);
    }

    void OnQtyChange(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        _orderQty = _symStep > 0
            ? Math.Floor(v / _symStep) * _symStep
            : v;
    }

    void CancelOrder()
    {
        _orderError   = string.Empty;
        _orderSuccess = string.Empty;
        _ = JS.InvokeVoidAsync("marketChart.clearPriceLine", $"chartContainer-{_chartInstanceId}");

        // Panel stays visible by default — Cancel just resets the form back
        // to a clean manual-trade state for whatever symbol is active.
        if (!string.IsNullOrEmpty(_activeSym))
            OpenManualPanelFor(_activeSym, _last);
        else
            _activeSignal = null;
    }

    void ClosePanel()
    {
        _activeSignal        = null;
        _currentPosition     = null;
        _orderPanelDismissed = true;
        _ = JS.InvokeVoidAsync("marketChart.clearPriceLine", $"chartContainer-{_chartInstanceId}");
    }

    async Task QuickMarketOrder(bool isBuy)
    {
        // Quick-trade from inside the maximized chart. Reuses the exact
        // same order-placing logic as the regular order panel (qty
        // rounding, notional checks, leverage, API call) — this is
        // just a fast path to get there without leaving fullscreen.
        if (_activeSignal == null || _activeSignal.Symbol != _activeSym)
        {
            OpenManualPanelFor(_activeSym, _last);
        }
        _orderType = "Market";
        _activeSignal!.Side = isBuy ? "BUY" : "SELL";
        await PlaceManualOrder();
    }

    async Task PlaceManualOrderBuy()
    {
        if (_activeSignal != null) _activeSignal.Side = "BUY";
        await PlaceManualOrder();
    }

    async Task PlaceManualOrderSell()
    {
        if (_activeSignal != null) _activeSignal.Side = "SELL";
        await PlaceManualOrder();
    }

    // Demo order execution — mirrors PlaceManualOrder's flow but routes
    // through DemoAccountService instead of the real Binance client.
    // Market fills immediately at the real current live price (the
    // same feed driving the chart, via DemoAccount.GetLastPrice, with
    // Selected.Klines as a fallback if no tick has arrived yet for this
    // symbol); Limit/Stop become pending orders DemoAccountService
    // monitors against the live feed going forward.
    async Task PlaceDemoOrderAsync()
    {
        if (_activeSignal == null) return;
        _orderLoading = true;
        StateHasChanged();
        try
        {
            bool isBuy = _activeSignal.Side?.ToUpper() == "BUY" || _activeSignal.Side?.ToUpper() == "LONG";
            string side = isBuy ? "LONG" : "SHORT";

            decimal? slPrice = _manualSlPrice > 0 ? _manualSlPrice : null;
            var tpLevels = _manualTps.Where(t => t.Price > 0 && t.Pct > 0)
                .Select(t => new DemoTpLevel { Price = t.Price, Pct = t.Pct }).ToList();

            if (_orderType == "Market")
            {
                decimal price = DemoAccount.GetLastPrice(_activeSignal.Symbol);
                if (price <= 0) price = Selected?.Klines.LastOrDefault()?.Close ?? 0m;
                if (price <= 0) { _orderError = "No live price available yet for this symbol"; return; }

                var (ok, error) = DemoAccount.OpenMarketPosition(
                    _activeSignal.Symbol, side, _orderQty, _orderLeverage, price, slPrice, tpLevels);
                if (!ok) { _orderError = error; return; }

                _orderSuccess = $"[DEMO] Opened {side} {_orderQty} {_activeSignal.Symbol.Replace("USDT","")} @ {FmtP(price)}" +
                    (slPrice.HasValue || tpLevels.Count > 0 ? " · SL/TP set" : "");
            }
            else
            {
                decimal trigger = _orderPrice;
                if (trigger <= 0) { _orderError = "Enter a trigger price"; return; }
                var type = _orderType == "Stop" ? DemoOrderType.StopMarket : DemoOrderType.Limit;

                var (ok, error) = DemoAccount.PlacePendingOrder(
                    _activeSignal.Symbol, side, type, trigger, _orderQty, _orderLeverage, slPrice, tpLevels);
                if (!ok) { _orderError = error; return; }

                _orderSuccess = $"[DEMO] {_orderType} order placed: {side} {_orderQty} {_activeSignal.Symbol.Replace("USDT","")} @ {FmtP(trigger)}";
            }

            _manualSlPrice = 0;
            _manualTps.Clear();
            _activeSignal = null;
            RefreshDemoSnapshot();
        }
        catch (Exception ex) { _orderError = ex.Message; }
        finally { _orderLoading = false; StateHasChanged(); }
    }

    async Task PlaceManualOrder()
    {
        if (_activeSignal == null) return;
        _orderError   = string.Empty;
        _orderSuccess = string.Empty;

        if (_orderQty <= 0)                                   { _orderError = "Enter quantity"; return; }
        if (_orderType != "Market" && _orderPrice <= 0)       { _orderError = "Enter price"; return; }

        // Demo mode: route entirely through DemoAccountService, the
        // real Binance client is never touched. Uses the real live
        // current price (same feed powering the chart) for a Market
        // order's fill price, so the simulation reflects genuine
        // market conditions, not a guessed number.
        if (_demoMode)
        {
            await PlaceDemoOrderAsync();
            return;
        }

        // Notional check: qty × price >= minNotional
        decimal checkPrice = _orderPrice > 0 ? _orderPrice : _activeSignal.Entry;
        decimal checkNotional = _orderQty * checkPrice;
        if (checkNotional < _symMinNotional)
        {
            _orderError = $"Notional {checkNotional:F2} USDT too small — minimum is {_symMinNotional:F0} USDT. Increase quantity.";
            return;
        }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _orderError = "No API credentials configured"; return; }

            bool isBuy  = _activeSignal.Side?.ToUpper() == "BUY" ||
                          _activeSignal.Side?.ToUpper() == "LONG";
            var side    = isBuy ? OrderSide.Buy : OrderSide.Sell;
            var posSide = isBuy ? PositionSide.Long : PositionSide.Short;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

            // Round qty to stepSize
            decimal step = _symStep > 0 ? _symStep : 0.001m;
            decimal qty  = Math.Floor(_orderQty / step) * step;
            if (qty <= 0) { _orderError = "Quantity too small after rounding"; return; }

            // Round price to tickSize
            decimal tick  = _symTickSize > 0 ? _symTickSize : 0.0001m;
            decimal price = tick > 0 ? Math.Round(_orderPrice / tick) * tick : _orderPrice;

            // Set leverage
            try { await client.UsdFuturesApi.Account.ChangeInitialLeverageAsync(
                _activeSignal.Symbol, _orderLeverage, ct: cts.Token); }
            catch { }

            // Detect hedge mode
            bool isHedge = false;
            try
            {
                var pm = await client.UsdFuturesApi.Account.GetPositionModeAsync(ct: cts.Token);
                isHedge = pm.Success && pm.Data?.IsHedgeMode == true;
            }
            catch { }

            long? orderId = null;

            if (_orderType == "Market")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.Market, quantity: qty,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else if (_orderType == "Limit")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.Limit, quantity: qty,
                    price: price, timeInForce: TimeInForce.GoodTillCanceled,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else // Stop
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    symbol: _activeSignal.Symbol, side: side,
                    type: FuturesOrderType.StopMarket, quantity: qty,
                    stopPrice: price,
                    positionSide: isHedge ? posSide : null, ct: cts.Token);
                if (r.Success) orderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }

            string entrySummary = $"Order #{orderId} placed · {_orderType} · {qty} {_activeSignal.Symbol.Replace("USDT","")}";

            // SL/TP — placed via algo orders whenever the panel's SL/TP
            // fields are populated (auto-filled from the signal's own
            // levels when this came from a signal, or entered manually
            // otherwise — either way, this is the user explicitly
            // confirming these levels via the order panel before
            // submitting). Reuses BinanceAlgoOrderService, the exact
            // same production-proven, manually-signed Algo Order API
            // client the bot's own TP/SL placement uses — Binance.Net's
            // library calls don't properly support conditional orders
            // since the Dec 2025 Algo Order API migration.
            if (_manualSlPrice > 0 || _manualTps.Any(t => t.Price > 0))
            {
                var protectiveErrors = new List<string>();
                var closeSide = isBuy ? OrderSide.Sell : OrderSide.Buy; // closing orders go the opposite direction

                if (_manualSlPrice > 0)
                {
                    decimal slTrigger = tick > 0 ? Math.Round(_manualSlPrice / tick) * tick : _manualSlPrice;
                    string slAlgoId = $"MANSL_{DateTime.UtcNow.Ticks}";
                    if (slAlgoId.Length > 32) slAlgoId = slAlgoId.Substring(0, 32);
                    bool ok = await AlgoOrders.PlaceConditionalAsync(
                        symbol: _activeSignal.Symbol, side: closeSide, positionSide: posSide,
                        type: "STOP_MARKET", quantity: qty, triggerPrice: slTrigger,
                        workingType: "MARK_PRICE", reduceOnly: true, ct: cts.Token,
                        clientAlgoId: slAlgoId);
                    if (!ok) protectiveErrors.Add("SL");
                }

                foreach (var tpRow in _manualTps.Where(t => t.Price > 0 && t.Pct > 0))
                {
                    decimal tpQty = Math.Floor(qty * (tpRow.Pct / 100m) / step) * step;
                    if (tpQty <= 0) continue;
                    decimal tpTrigger = tick > 0 ? Math.Round(tpRow.Price / tick) * tick : tpRow.Price;
                    string tpAlgoId = $"MANTP_{DateTime.UtcNow.Ticks}";
                    if (tpAlgoId.Length > 32) tpAlgoId = tpAlgoId.Substring(0, 32);
                    bool ok = await AlgoOrders.PlaceConditionalAsync(
                        symbol: _activeSignal.Symbol, side: closeSide, positionSide: posSide,
                        type: "TAKE_PROFIT_MARKET", quantity: tpQty, triggerPrice: tpTrigger,
                        workingType: "MARK_PRICE", reduceOnly: true, ct: cts.Token,
                        clientAlgoId: tpAlgoId);
                    if (!ok) protectiveErrors.Add($"TP@{FmtP(tpRow.Price)}");
                    await Task.Delay(150); // avoid hammering the API with back-to-back signed requests
                }

                entrySummary += protectiveErrors.Count == 0
                    ? " · SL/TP placed"
                    : $" · ⚠ some protective orders failed: {string.Join(", ", protectiveErrors)} (position is open, retry these manually)";
            }

            _orderSuccess = entrySummary;
            _manualSlPrice = 0;
            _manualTps.Clear();
            _activeSignal = null;
        }
        catch (Exception ex) { _orderError = ex.Message; }
        finally { _orderLoading = false; StateHasChanged(); }
    }

    public async ValueTask DisposeAsync()
    {
        LiveState.PriceTicked -= OnLivePriceTicked;
        DemoAccount.Updated -= OnDemoAccountUpdated;
        LiveState.KlineClosed -= OnLiveKlineClosed;
        _cts.Cancel();
        _timer?.Dispose();
        _dotNetRef?.Dispose();
        try { await JS.InvokeVoidAsync("stickyStack.dispose"); } catch { }
    }

    // Stable identity comparison — needed because demo positions get
    // freshly converted to ActivePositionInfo on every DisplayedPositions
    // access (reference equality would never match the same logical
    // position twice). Symbol+Side uniquely identifies a position on
    // the real exchange too (no two simultaneous positions for the
    // same symbol+side there), so this works correctly for both modes.
    static bool PosIdentityEquals(ActivePositionInfo? a, ActivePositionInfo? b)
    {
        if (a == null || b == null) return a == b;
        return a.Symbol == b.Symbol && a.Side == b.Side;
    }

    sealed class ActivePositionInfo
    {
        public string Id = ""; // empty for real positions (Symbol+Side used as identity there); demo positions carry their real DemoPosition.Id
        public string Symbol = "";
        public string Side = "";
        public int Leverage;
        public decimal Size;
        public decimal Qty;
        public decimal EntryPrice;
        public decimal MarkPrice;
        public decimal LiqPrice;
        public decimal Margin;
        public decimal Pnl;
        public decimal Roi;
    }
}
