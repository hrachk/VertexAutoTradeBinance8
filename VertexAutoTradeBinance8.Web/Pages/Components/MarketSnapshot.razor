    // ── Signals ───────────────────────────────────────────────
    const int SignalLookbackHours = 24;

    List<MissedTradeRecord> _signals = new();

    // Keyed by Symbol+Time (not object identity/equality, which we don't
    // control on MissedTradeRecord). Value is the signal's own Time, used
    // only for pruning. An entry here means "already faded out locally" —
    // it doubles as the sc-removing CSS check while still rendered, and as
    // a permanent filter in LoadData() so the server can never resurrect a
    // signal we've already dismissed within its own lookback window.
    Dictionary<string, DateTime> _expiredSignals = new();

    static string SignalKey(MissedTradeRecord s) => $"{s.Symbol}|{s.Time:O}";

    MissedTradeRecord? _activeSignal;
    string _orderType = "Market";
    decimal _orderPrice;
    decimal _limitPrice;
    decimal _orderQty;
    int _orderLeverage = 10;
    bool _orderLoading;
    string _orderError = string.Empty;
    string _orderSuccess = string.Empty;

    // Pagination for signal cards (horizontal scroll-by-page)
    ElementReference _sigCardsEl;
    int _sigPage = 0;
    const int _sigPageSize = 6;
    int _sigPageCount => Math.Max(1, (int)Math.Ceiling(_signals.Count / (double)_sigPageSize));

    async void GoToSigPage(int page)
    {
        _sigPage = Math.Clamp(page, 0, _sigPageCount - 1);
        try
        {
            await JS.InvokeVoidAsync("vertexScrollSignalsToPage", _sigCardsEl, _sigPage, _sigPageSize);
        }
        catch { /* JS not ready yet — ignore */ }
