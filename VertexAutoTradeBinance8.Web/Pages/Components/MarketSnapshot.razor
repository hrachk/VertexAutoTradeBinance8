    async Task PickTf(string tf)
    {
        _activeTf = tf;
        ResolveSelected();

        // If ResolveSelected created an empty placeholder (this
        // timeframe has no entry in the narrow klines_bootstrap.json
        // snapshot but IS archived in datadb), load it directly here
        // - RenderCharts itself immediately returns when
        // Klines.Count < 5, so it can never be the thing that performs
        // this initial fill; this loader bypasses that gate entirely
        // for exactly this bootstrap case.
        if (Selected != null && Selected.Klines.Count == 0 && !string.IsNullOrEmpty(_activeSym))
        {
            var label = TfLabel(_activeTf).ToLowerInvariant();
            var archived = await HistoricalReader.LoadAsync(_activeSym, label);
            if (archived.Count > 0)
            {
                Selected = Selected with { Klines = archived };
                // Also register this in Series so subsequent lookups
                // (ResolveSelected, the TF-button hasSeries check,
                // etc) find it normally from now on, same as any
                // other timeframe that was present from the start.
                var idx = Series.FindIndex(s => s.Symbol == _activeSym && s.Timeframe == _activeTf);
                if (idx >= 0) Series[idx] = Selected; else Series.Add(Selected);
            }
        }

        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
        _ = JS.InvokeVoidAsync("stickyStack.recalc");
        _ = SaveSelectionState();
    }

    void CalcStats()
    {
        if (Selected == null || Selected.Klines.Count < 2) return;
        var kl = Selected.Klines;
        _last = kl[^1].Close;
        var first = kl[0].Close;
        _chg = first > 0 ? (_last - first) / first * 100m : 0m;

        var closes = kl.Select(k => (double)k.Close).ToList();

        // EMA21 + EMA55
        if (closes.Count >= 21) _ema21 = (decimal)EmaLast(closes, 21);
        if (closes.Count >= 55) _ema55 = (decimal)EmaLast(closes, 55);

        // ATR14
        if (kl.Count >= 15)
        {
            decimal s = 0;
            for (int i = kl.Count - 14; i < kl.Count; i++)
            {
                var c = kl[i]; var p = kl[i-1];
                s += Math.Max(c.High - c.Low, Math.Max(Math.Abs(c.High - p.Close), Math.Abs(c.Low - p.Close)));
            }
            _atr = s / 14;
        }

        // RSI14
        if (closes.Count >= 15)
        {
            double ag = 0, al = 0;
            for (int i = 1; i <= 14; i++) { var d = closes[i] - closes[i-1]; if (d > 0) ag += d; else al -= d; }
            ag /= 14; al /= 14;
            for (int i = 15; i < closes.Count; i++) {
                var d = closes[i] - closes[i-1];
                ag = (ag * 13 + Math.Max(d, 0)) / 14;
                al = (al * 13 + Math.Max(-d, 0)) / 14;
            }
            _rsi = al == 0 ? 100 : 100 - 100 / (1 + ag / al);
        }
    }

    static double EmaLast(List<double> arr, int period)
    {
        double k = 2.0 / (period + 1);
        double v = arr.Take(period).Average();
        for (int i = period; i < arr.Count; i++) v = arr[i] * k + v * (1 - k);
        return v;
    }

    const int DefaultBarsCount = 300;

    /// <summary>
    /// Emergency kline fetch — called when a symbol is selected that has
    /// no data in the file cache (e.g. manually opened position on a coin
    /// outside the bot universe). Fetches 1m/5m/15m/1h directly from
    /// Binance REST, injects into Series, and re-renders the chart.
    /// </summary>
    async Task EmergencyFetchKlinesAsync(string symbol)
    {
        if (_emergencyFetchInProgress) return;
        _emergencyFetchInProgress = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));

            // tfName = the string key used in _activeTf and Series.Timeframe
            // (e.g. "OneMinute", "FiveMinutes" — matches KlineInterval.ToString())
            var tfs = new[]
            {
                (KlineInterval.OneMinute,      "OneMinute",      300),
                (KlineInterval.FiveMinutes,    "FiveMinutes",    300),
                (KlineInterval.FifteenMinutes, "FifteenMinutes", 200),
                (KlineInterval.OneHour,        "OneHour",        200),
            };

            foreach (var (tf, tfName, limit) in tfs)
            {
                if (symbol != _activeSym) break; // user switched symbol
                try
                {
                    var res = await client.UsdFuturesApi.ExchangeData
                        .GetKlinesAsync(symbol, tf, limit: limit, ct: cts.Token);
                    if (!res.Success || res.Data == null) continue;

                    // KlineDto: (long OpenTime, decimal Open, High, Low, Close, Volume)
                    // OpenTime is DateTimeOffset on Binance response → ToUnixTimeMilliseconds()
                    var klines = res.Data.Select(k => new KlineDto(
                        OpenTime: new DateTimeOffset(k.OpenTime, TimeSpan.Zero).ToUnixTimeMilliseconds(),
                        Open:     k.OpenPrice,
                        High:     k.HighPrice,
                        Low:      k.LowPrice,
                        Close:    k.ClosePrice,
                        Volume:   k.Volume
                    )).ToList();

                    if (klines.Count == 0) continue;

                    // Inject into Series (type: List<MarketSeries>)
                    // MarketSeries(string Symbol, string Timeframe, IReadOnlyList<KlineDto> Klines)
                    var existingIdx = Series.FindIndex(s =>
                        s.Symbol == symbol && s.Timeframe == tfName);
                    if (existingIdx >= 0)
                    {
                        Series[existingIdx] = Series[existingIdx] with { Klines = klines };
                    }
                    else
                    {
                        Series.Add(new MarketSeries(symbol, tfName, klines));
                    }

                    // Re-render chart if this is the currently viewed TF
                    if (symbol == _activeSym && tfName == _activeTf)
                    {
                        ResolveSelected();
                        await InvokeAsync(async () =>
                        {
                            StateHasChanged();
                            await RenderCharts();
                        });
                    }
                }
                catch (Exception ex)
                {
                    // No _logger in Blazor component — write to console
                    Console.WriteLine($"[EMERGENCY] {symbol}/{tfName} failed: {ex.Message}");
                }
            }
        }
        finally
        {
            _emergencyFetchInProgress = false;
        }
    }

    async Task RenderCharts()
    {
        if (!_jsReady || Selected == null || Selected.Klines.Count < 5) return;
        try
        {
            // Merge archived history (datadb/ — deeper, but only as fresh
            // as the Engine's last backfill cycle) with the live in-memory
            // buffer (Selected.Klines — shallower at only a few hundred
            // bars, but always current to the last tick). The archive
            // provides depth for scrolling back; live data provides
            // accuracy for the most recent bars. Deduped by OpenTime with
            // live data winning on overlap, since it's always the more
            // current source for any bar both happen to cover.
            //
            // Cached by symbol+timeframe — the archive file only changes
            // once per Engine backfill cycle (minutes apart), so there's
            // no reason to re-read it from disk on every single live tick
            // this function gets called for.
            var tfLabel = TfLabel(Selected.Timeframe).ToLowerInvariant();
            var cacheKey = $"{Selected.Symbol}:{tfLabel}";
            var now = DateTime.UtcNow;
            if (_archiveCacheKey != cacheKey || (now - _archiveCacheLoadedAt) > TimeSpan.FromSeconds(90))
            {
                _archiveCache = await HistoricalReader.LoadAsync(Selected.Symbol, tfLabel);
                _archiveCacheKey = cacheKey;
                _archiveCacheLoadedAt = now;
            }

            // PERFORMANCE FIX: only rebuild the merged SortedDictionary when
            // the archive or symbol/TF actually changed. Previously this
            // created a brand-new SortedDictionary with 500-1000+ inserts +
            // ToList() of all keys + a full kline array on every single live
            // tick (every few seconds), generating thousands of heap objects
            // per tick and triggering GC pauses that made the chart feel
            // progressively heavier the longer the session ran.
            bool mergeNeeded = _mergedKlinesCacheKey != cacheKey
                            || _lastMergeTime != _archiveCacheLoadedAt
                            || _mergedKlines == null;

            if (mergeNeeded)
            {
                _mergedKlines = new SortedDictionary<long, (decimal Open, decimal High, decimal Low, decimal Close, decimal Volume, decimal? TakerBuy)>();
                foreach (var k in _archiveCache)
                    _mergedKlines[k.OpenTime] = (k.Open, k.High, k.Low, k.Close, k.Volume, k.TakerBuyBaseVolume);
                foreach (var k in Selected.Klines)
                    _mergedKlines[k.OpenTime] = (k.Open, k.High, k.Low, k.Close, k.Volume, k.TakerBuyBaseVolume); // live wins on overlap
                _mergedKlinesCacheKey = cacheKey;
                _lastMergeTime = _archiveCacheLoadedAt;
            }
            else if (Selected.Klines.Count > 0)
            {
                // Archive unchanged, same symbol/TF — just patch the last bar
                // (and the one before it, in case the previous bar just closed)
                // in the existing dictionary instead of rebuilding everything.
                var tail = Selected.Klines.Count >= 2
                    ? Selected.Klines.Skip(Selected.Klines.Count - 2).ToList()
                    : Selected.Klines.TakeLast(1).ToList();
                foreach (var k in tail)
                    _mergedKlines![k.OpenTime] = (k.Open, k.High, k.Low, k.Close, k.Volume, k.TakerBuyBaseVolume);
            }

            // PERFORMANCE FIX: only send the most recent DefaultBarsCount
            // bars on initial render/symbol switch, not the entire merged
            // set — that set can grow into the thousands of bars once
            // deep backfill has run for a while, and re-sending all of it
            // through JS interop on every single live tick (RenderCharts
            // gets called that often) is exactly the chart-gets-heavier-
            // over-time problem reported. The rest stays in _mergedKlines
            // for LoadMoreHistoryAsync to serve on demand when the user
            // scrolls back (see JS-side infinite-history handler).
            // Keys needed for rendering — only materialise the full list when
            // we're about to do a full setData (isNewSeries). On ordinary live
            // ticks we only ever need the last key for updateLastBar, so avoid
            // allocating a List<long> of 500+ entries every few seconds.
            int allKeysCount = _mergedKlines.Count;
            bool isNewSeries = cacheKey != _lastFullRenderCacheKey;

            if (isNewSeries)
            {
                // Only materialise the key list here, where we actually need
                // to slice the last DefaultBarsCount bars for setData.
                var allKeysList = _mergedKlines.Keys.ToList();
                var startIdx = Math.Max(0, allKeysList.Count - DefaultBarsCount);
                var visibleKeys = allKeysList.Skip(startIdx).ToList();
                var klines = visibleKeys.Select(k => ToJsKline(k, _mergedKlines[k])).ToArray();
                await JS.InvokeVoidAsync("marketChart.setData", $"chartContainer-{_chartInstanceId}", klines);
                _lastFullRenderCacheKey = cacheKey;

                _dotNetRef ??= DotNetObjectReference.Create(this);
                try { await JS.InvokeVoidAsync("marketChart.bindInfiniteHistory", $"chartContainer-{_chartInstanceId}", _dotNetRef); } catch { }
            }
            else if (allKeysCount > 0)
            {
                // Ordinary live tick — just update the last bar in-place.
                // _mergedKlines is a SortedDictionary so .Last() is O(log n),
                // far cheaper than ToList()[^1] which was O(n) every tick.
                var lastKey = _mergedKlines.Keys.Max();
                var lastKline = ToJsKline(lastKey, _mergedKlines[lastKey]);
                await JS.InvokeVoidAsync("marketChart.updateLastBar", $"chartContainer-{_chartInstanceId}", lastKline);
            }
        }
        catch { }
    }

    static object ToJsKline(long openTime, (decimal Open, decimal High, decimal Low, decimal Close, decimal Volume, decimal? TakerBuy) v) => new
    {
        openTime,
        open = (double)v.Open,
        high = (double)v.High,
        low = (double)v.Low,
        close = (double)v.Close,
        volume = (double)v.Volume,
        takerBuyVolume = v.TakerBuy.HasValue ? (double?)v.TakerBuy.Value : null
    };

    /// <summary>
    /// JS-invokable: serves older bars from the in-memory merged dataset
    /// (already loaded by RenderCharts, no disk/network round-trip needed
    /// here) when the user scrolls the chart back far enough to approach
    /// the start of what's currently loaded. This is the Web-side half of
    /// Lightweight Charts' own documented "infinite history" pattern
    /// (subscribeVisibleLogicalRangeChange + barsInLogicalRange on the JS
    /// side, calling back into this method).
    /// </summary>
    [JSInvokable]
    public Task<object[]> LoadMoreHistoryAsync(long beforeOpenTimeMs, int count)
    {
        if (_mergedKlines == null || _mergedKlines.Count == 0)
            return Task.FromResult(Array.Empty<object>());

        var older = _mergedKlines.Where(kv => kv.Key < beforeOpenTimeMs).ToList();
        var slice = older.Count <= count ? older : older.GetRange(older.Count - count, count);

        return Task.FromResult(slice.Select(kv => ToJsKline(kv.Key, kv.Value)).ToArray());
    }

    void Pick(MarketSeries s)
    {
        _activeSym = s.Symbol;
        _activeTf  = s.Timeframe;
        _orderPanelDismissed = false;
        Selected = s;
        CalcStats();

        var existingPos = DisplayedPositions.FirstOrDefault(p => p.Symbol == s.Symbol);
        if (existingPos != null)
        {
            _selectedPosition = existingPos;
            _activeSignal = null;
            _ = RefreshPositionLines();
        }
        else if (_selectedPosition?.Symbol != s.Symbol)
        {
            _selectedPosition = null;
            _ = JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}");
        }

        StateHasChanged();
        _ = RenderCharts();
        _ = JS.InvokeVoidAsync("stickyStack.recalc");
        _ = SaveSelectionState();
    }

    // Row click in the ALL INSTRUMENTS table: same as ticker click —
    // switch chart AND open the order panel for a manual trade,
    // unless this symbol already has an open position (Pick already
    // selected that position's own panel — see PickSymAndTrade for
