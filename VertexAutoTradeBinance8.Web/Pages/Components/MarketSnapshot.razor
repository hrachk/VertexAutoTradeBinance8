/* TICKER BAR */
.mk-ticker-bar{background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;scrollbar-width:none;cursor:grab;}
.mk-ticker-bar::-webkit-scrollbar{display:none;}
