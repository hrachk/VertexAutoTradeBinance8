@page "/market"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@using Binance.Net.Enums
@using VertexAutoTradeBinance8.Services
@inject MarketSnapshotFileService Service
@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.Extensions.Options.IOptionsMonitor<VertexAutoTradeBinance8.Configuration.BinanceOptions> BinanceOpts
@inject MarketDataLiveState LiveState
@inject MissedTradeFileService SignalSvc
@inject BinanceClientFactory Factory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Market Intelligence — Vertex</PageTitle>

<div class="mk">

    <!-- HEADER -->
    <div class="mk-header">
        <div class="mk-title-block">
            <span class="mk-icon">📈</span>
            <div>
                <div class="mk-title">MARKET INTELLIGENCE</div>
                <div class="mk-sub">Candlestick · EMA · Bollinger · RSI · Volume</div>
            </div>
        </div>

        <div class="mk-hright">
            @if (Selected != null)
            {
                <div class="mk-ticker">
                    <span class="mk-tsym">@Selected.Symbol</span>
                    <span class="mk-ttf">@TfLabel(Selected.Timeframe)</span>
                    @if (_last > 0)
                    {
                        <span class="mk-tprice">@FmtP(_last)</span>
                        <span class="mk-tchg @(_chg >= 0 ? "up" : "dn")">
                            @(_chg >= 0 ? "▲" : "▼") @Math.Abs(_chg).ToString("F2")%
                        </span>
                    }
                </div>
            }
            <button class="mk-btn @(Frozen?"mk-btn-on":"")" @onclick="ToggleFreeze">
                @(Frozen ? "⏸ Paused" : "▶ Live")
            </button>
        </div>
    </div>

    <!-- LIVE SIGNALS — moved above the ticker bar -->
    <div class="sig-panel">
            <div class="sig-panel-head">
                <div class="sig-panel-title">
                    <span class="sig-dot"></span>
                    LIVE SIGNALS
                    <span class="sig-count">@_signals.Count</span>
                </div>
                <div class="sig-panel-right">
                    @if (_signals.Any())
                    {
                        <div class="sig-panel-sub">Click a signal to trade manually</div>
                    }
                    else
                    {
                        <div class="mk-header-scan">
                            <span class="mk-header-scan-dot"></span>
                            Detecting
                            @if (_symbols.Any())
                            {
                                <span class="mk-header-scan-sym">@_symbols[_scanSymIdx % _symbols.Count]</span>
                            }
                        </div>
                    }
                    <div class="sig-pager @(_signals.Count > _sigPageSize ? "" : "sig-pager-hidden")">
                        @for (int p = 0; p < _sigPageCount; p++)
                        {
                            int pageIdx = p;
                            <span class="sig-pager-dot @(pageIdx == _sigPage ? "active" : "")"
                                  @onclick="() => GoToSigPage(pageIdx)"></span>
                        }
                        <span class="sig-pager-label">@(_sigPage+1)/@_sigPageCount</span>
                    </div>
                </div>
            </div>
            @if (_signals.Any())
            {
            <div class="sig-cards" id="sigCardsScroll" @ref="_sigCardsEl">
                @foreach (var sig in _signals)
                {
                    bool sigIsBuy = sig.Side?.ToUpper() == "BUY" || sig.Side?.ToUpper() == "LONG";
                    bool isActive = _activeSignal == sig;
                    decimal sigTp1 = sig.TakeProfits?.FirstOrDefault() ?? 0m;
                    decimal rr = sig.StopLoss > 0 && sig.Entry > 0 && sigTp1 > 0
                        ? Math.Abs(sigTp1 - sig.Entry) / Math.Abs(sig.StopLoss - sig.Entry)
                        : 0m;
                    int conf = sig.Confidence;

                    var ttl = GetSignalTtl(sig);
                    bool isRemoving = _expiredSignals.ContainsKey(SignalKey(sig));

                    <div class="sig-card @(sigIsBuy ? "sc-buy" : "sc-sell") @(isActive ? "sc-active" : "") @(isRemoving ? "sc-removing" : ttl.IsExpiring ? "sc-fading" : "")"
                         @key="SignalKey(sig)"
                         @onclick="() => SelectSignal(sig)">
                        <!-- Top row: symbol, side, time -->
                        <div class="sc-top">
                            <div class="sc-sym-wrap">
                                <span class="sc-sym">@sig.Symbol.Replace("USDT","")</span>
                                <span class="sc-usdt">USDT</span>
                            </div>
                            <span class="sc-side @(sigIsBuy ? "sc-side-b" : "sc-side-s")">
                                @(sigIsBuy ? "▲ LONG" : "▼ SHORT")
                            </span>
                            <span class="sc-ago">@FmtAgo(sig.Time)</span>
                        </div>

                        <!-- Confidence bar -->
                        <div class="sc-conf-wrap">
                            <div class="sc-conf-bar" style="width:@conf%"
                                 style2="background:@(conf>=60?"var(--grn)":conf>=45?"var(--yel)":"var(--red)")"></div>
                        </div>

                        <!-- Prices, all inline -->
                        <div class="sc-prices-row">
                            <div class="sc-p"><span class="sc-pl">Entry</span><span class="sc-pv mono">@FmtP(sig.Entry)</span></div>
                            <div class="sc-p"><span class="sc-pl">SL</span><span class="sc-pv mono dn">@FmtP(sig.StopLoss)</span></div>
                            @if (sigTp1 > 0) {
                                <div class="sc-p"><span class="sc-pl">TP1</span><span class="sc-pv mono up">@FmtP(sigTp1)</span></div>
                            }
                        </div>

                        <!-- Footer: confidence/RR/ATR + TTL bar combined in one slim row -->
                        <div class="sc-foot">
                            <span class="sc-conf @(conf>=60?"up":conf>=45?"yel":"dn")">@conf%</span>
                            @if (rr > 0) { <span class="sc-rr">RR @rr.ToString("F1")</span> }
                            <span class="sc-atr mk-dim">ATR @FmtP(sig.ATR)</span>
                            <div class="sc-ttl-bar-wrap" title="Estimated relevance window based on volatility (ATR)">
                                <div class="sc-ttl-bar @(ttl.IsExpiring ? "ttl-low" : ttl.Pct < 50 ? "ttl-mid" : "ttl-high")"
                                     style="width:@(ttl.Pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="sc-ttl-label mk-dim">@ttl.Label</span>
                        </div>
                    </div>
                }
            </div>
            }
    </div> <!-- end sig-panel -->

    <!-- ROW 1: SYMBOL TICKER -->
    <div class="mk-ticker-bar">
        <div class="mk-ticker-scroll">
            @foreach (var sym in OrderedTickerSymbols)
            {
                var symSeries = Series.Where(s => s.Symbol == sym).ToList();
                var best = symSeries.OrderByDescending(s => s.Klines.Count).FirstOrDefault();
                var last  = best?.Klines.Count > 0 ? best.Klines[^1].Close : 0m;
                var first = best?.Klines.Count > 1 ? best.Klines[0].Close  : last;
                var chg   = first > 0 ? (last - first) / first * 100m : 0m;
                var isSel = sym == _activeSym;
                <button class="mk-tk @(isSel?"mk-tk-on":"")" @onclick="()=>PickSymAndTrade(sym, last)">
                    <span class="mk-tk-sym">@sym</span>
                    @if (last > 0)
                    {
                        <span class="mk-tk-price">@FmtP(last)</span>
                        <span class="mk-tk-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F1")%</span>
                    }
                </button>
            }
            @if (!Series.Any())
            {
                <span class="mk-dim" style="padding:0 16px;font-size:12px">No data — start the bot first</span>
            }
        </div>
    </div>

    <!-- ROW 2: TIMEFRAME SELECTOR (TradingView style) -->
    @if (!string.IsNullOrEmpty(_activeSym))
    {
        <div class="mk-tf-bar">
            @foreach (var tf in _allTfs)
            {
                var hasSeries = Series.Any(s => s.Symbol == _activeSym && s.Timeframe == tf.Key);
                var isSelTf   = _activeTf == tf.Key;
                <button class="mk-tf-btn @(isSelTf?"mk-tf-on":"") @(hasSeries?"":"mk-tf-dim")"
                        @onclick="()=>PickTf(tf.Key)">
                    @tf.Label
                </button>
            }
        </div>
    }

    @if (Selected != null && Selected.Klines.Count >= 5)
    {
        <!-- STATS BAR -->
        <div class="mk-stats">
            <div class="mk-s"><div class="mk-sl">PRICE</div><div class="mk-sv">@FmtP(_last)</div></div>
            <div class="mk-s"><div class="mk-sl">OPEN</div><div class="mk-sv mk-dim">@FmtP(Selected.Klines[^1].Open)</div></div>
            <div class="mk-s"><div class="mk-sl">HIGH</div><div class="mk-sv up">@FmtP(Selected.Klines[^1].High)</div></div>
            <div class="mk-s"><div class="mk-sl">LOW</div><div class="mk-sv dn">@FmtP(Selected.Klines[^1].Low)</div></div>
            <div class="mk-s"><div class="mk-sl">CHANGE</div><div class="mk-sv @(_chg>=0?"up":"dn")">@(_chg>=0?"+":"")@_chg.ToString("F2")%</div></div>
            <div class="mk-s"><div class="mk-sl">EMA21</div><div class="mk-sv" style="color:#38bdf8">@FmtP(_ema21)</div></div>
            <div class="mk-s"><div class="mk-sl">EMA55</div><div class="mk-sv" style="color:#a855f7">@FmtP(_ema55)</div></div>
            <div class="mk-s"><div class="mk-sl">ATR</div><div class="mk-sv">@FmtP(_atr)</div></div>
            <div class="mk-s"><div class="mk-sl">RSI</div>
                <div class="mk-sv @(_rsi>=70?"dn":_rsi<=30?"up":"")">
                    @_rsi.ToString("F1") @(_rsi>=70?"OB":_rsi<=30?"OS":"")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">TREND</div>
                <div class="mk-sv @(_last>_ema21?"up":"dn")">
                    @(_last>_ema21?"▲ BULL":"▼ BEAR")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">BARS</div><div class="mk-sv mk-dim">@Selected.Klines.Count</div></div>
            <div class="mk-s"><div class="mk-sl">VOLUME</div><div class="mk-sv mk-dim">@FmtV(Selected.Klines[^1].Volume)</div></div>
        </div>
    }

        <!-- ═══ CANVAS AREA — always rendered so canvas has real dimensions ═══ -->
    <div class="mk-charts-area">

        <!-- No-data overlay (canvas still renders behind for correct sizing) -->
        @if (Selected == null || Selected.Klines.Count < 5)
        {
            <div class="mk-no-data-overlay">
                <div style="font-size:36px">📊</div>
                <div style="font-size:15px;font-weight:600;margin-top:8px">Waiting for market data</div>
                <div class="mk-dim" style="font-size:11px;margin-top:4px">Engine writes klines_bootstrap.json on startup</div>
            </div>
        }
        else if (!_chartInitDone)
        {
            <div class="mk-no-data-overlay">
                <div style="font-size:24px">⏳</div>
                <div style="font-size:13px;margin-top:8px">Initializing chart…</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(_chartInitError))
        {
            <div class="mk-no-data-overlay" style="background:rgba(40,10,10,.92)">
                <div style="font-size:24px">⚠</div>
                <div style="font-size:13px;margin-top:8px;color:#ff4d6a">@_chartInitError</div>
            </div>
        }

        <div class="mk-body-grid @(_activeSignal != null || _selectedPosition != null ? "mk-body-grid-with-panel" : "")">
        <!-- LEFT: chart + RSI + Volume, then OPEN POSITIONS, then OPEN ORDERS — all share this one column's width -->
        <div class="mk-main-col">
        <div class="mk-charts-col-main">

        <!-- Price chart -->
        <div class="mk-chart-head">
            <div class="mk-chart-title">CANDLESTICK · @(Selected?.Symbol ?? "") · @TfLabel(Selected?.Timeframe ?? "")</div>
            <div class="mk-legend">
                <span style="color:#38bdf8">── EMA21</span>
                <span style="color:#a855f7">── EMA55</span>
                <span style="color:#ef4444">RSI · ── OB 70 / OS 30</span>
            </div>
            <button class="mk-chart-maximize" @onclick="ToggleChartMaximized" title="Maximize chart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>

        @if (_chartMaximized)
        {
            <div class="mk-chart-maximize-backdrop" @onclick="ToggleChartMaximized"></div>
        }

        <!-- SINGLE persistent chart container — never destroyed or
             recreated by the maximize toggle. Only the wrapping CSS
             class changes (adds position:fixed etc), which Lightweight
             Charts' own autoSize ResizeObserver picks up on its own.
             Previously this used two separate container elements in
             an if/else branch, which meant Blazor actually destroyed
             and recreated the DOM node on every toggle — Lightweight
             Charts kept its session bound to the now-detached old
             node, leaving the chart blank until a full page reload
             forced re-initialization from scratch. -->
        <div class="mk-chart-container-wrap @(_chartMaximized ? "mk-chart-maximized" : "")">
            @if (_chartMaximized)
            {
                <div class="mk-max-bar">
                    <div class="mk-max-sym">
                        @(Selected?.Symbol ?? "")
                        <span class="mk-max-tf">@TfLabel(Selected?.Timeframe ?? "")</span>
                    </div>
                    <div class="mk-max-price @(_chg >= 0 ? "up" : "dn")">@FmtP(_last)</div>

                    <div class="mk-max-trade">
                        <input class="mk-max-qty mono" type="number" title="Quantity"
                               value="@(_orderQty > 0 ? _orderQty.ToString("G8") : "")"
                               @onchange="OnQtyChange" placeholder="Qty" />
                        <button class="mk-max-buy" disabled="@_orderLoading" @onclick="() => QuickMarketOrder(true)">Buy</button>
                        <button class="mk-max-sell" disabled="@_orderLoading" @onclick="() => QuickMarketOrder(false)">Sell</button>
                    </div>

                    <button class="mk-max-restore" @onclick="ToggleChartMaximized" title="Restore">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Restore
                    </button>
                </div>
            }
            <div id="chartContainer-@_chartInstanceId" @key="_chartInstanceId" style="width:100%;height:@(_chartMaximized ? "calc(100% - 52px)" : "100%");"></div>

            @if (_selectedPosition != null)
            {
                <div class="mk-tpsl-overlay">
                    <button class="mk-tpsl-btn @(_tpSlEditMode ? "mk-tpsl-btn-on" : "")" @onclick="ToggleTpSlEdit" title="Show/hide existing TP/SL lines">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6M9 8h6M17 16h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        TP/SL
                    </button>
                    <span class="mk-tpsl-hint">Drag near entry line to set TP/SL</span>
                </div>
            }
        </div>

        <div class="mk-hints">
            <span>🖱 Drag to pan</span>
            <span>⚲ Scroll to zoom</span>
            <span>🖱 Right-click to pick a price</span>
        </div>

        </div> <!-- end mk-charts-col-main -->

        <!-- OPEN POSITIONS / OPEN ORDERS — tabbed, share one panel -->
        <div class="mk-oo-panel">
            <div class="mk-oo-tabs">
                <button class="mk-oo-tab @(_ooActiveTab == "positions" ? "mk-oo-tab-on" : "")"
                        @onclick="ShowPositionsTab">
                    Open Positions
                    <span class="mk-oo-count">@_allPositions.Count</span>
                    @if (_positionsLoading) { <span class="mk-oo-spin">⟳</span> }
                </button>
                <button class="mk-oo-tab @(_ooActiveTab == "orders" ? "mk-oo-tab-on" : "")"
                        @onclick="ShowOrdersTab">
                    Open Orders
                    <span class="mk-oo-count">@_openOrders.Count</span>
                </button>
            </div>

            @if (_ooActiveTab == "positions")
            {
                @if (_allPositions.Count == 0)
                {
                    <div class="mk-oo-empty">No open positions</div>
                }
                else
                {
                    <div class="mk-oo-scroll">
                        <table class="mk-oo-tbl">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Lev</th>
                                    <th>Entry</th><th>Mark</th><th>Liq</th><th>Size</th><th>PnL</th><th>ROI</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pos in _allPositions)
                                {
                                    <tr class="mk-pos-row @(_selectedPosition == pos ? "mk-pos-row-sel" : "")"
                                        @onclick="() => SelectPosition(pos)">
                                        <td class="mk-oo-sym">@pos.Symbol</td>
                                        <td class="@(pos.Side == "LONG" ? "up" : "dn")">@pos.Side</td>
                                        <td class="mk-dim">@pos.Leverage×</td>
                                        <td class="mk-mono">@FmtP(pos.EntryPrice)</td>
                                        <td class="mk-mono">@FmtP(pos.MarkPrice)</td>
                                        <td class="mk-mono mk-liq">@(pos.LiqPrice > 0 ? FmtP(pos.LiqPrice) : "—")</td>
                                        <td class="mk-mono">@pos.Size.ToString("F2")</td>
                                        <td class="mk-mono @(pos.Pnl >= 0 ? "up" : "dn")">@(pos.Pnl >= 0 ? "+" : "")@pos.Pnl.ToString("F2")</td>
                                        <td class="mk-mono @(pos.Roi >= 0 ? "up" : "dn")">@(pos.Roi >= 0 ? "+" : "")@((pos.Roi * 100).ToString("F1"))%</td>
                                        <td>
                                            <button class="mk-oo-cancel" disabled="@_orderLoading"
                                                    @onclick="() => ClosePositionRow(pos)" @onclick:stopPropagation="true">
                                                @(_orderLoading ? "…" : "Close")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (_openOrders.Count == 0)
                {
                    <div class="mk-oo-empty">No open orders</div>
                }
                else
                {
                    <div class="mk-oo-scroll">
                        <table class="mk-oo-tbl">
                            <thead>
                                <tr>
                                    <th>Symbol</th><th>Side</th><th>Type</th>
                                    <th>Price</th><th>Qty</th><th>Filled</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in _openOrders)
                                {
                                    <tr>
                                        <td class="mk-oo-sym">@o.Symbol</td>
                                        <td class="@(o.Side == "BUY" ? "up" : "dn")">@o.Side</td>
                                        <td class="mk-dim">@o.Type @(o.ReduceOnly ? "(R)" : "")</td>
                                        <td class="mk-mono">@(o.Price > 0 ? FmtP(o.Price) : "Market")</td>
                                        <td class="mk-mono">@o.Qty.ToString("G8")</td>
                                        <td class="mk-mono mk-dim">@o.Filled.ToString("G8")</td>
                                        <td>
                                            <button class="mk-oo-cancel" disabled="@(_cancellingOrderId == o.OrderId)"
                                                    @onclick="() => CancelOpenOrderAsync(o)">
                                                @(_cancellingOrderId == o.OrderId ? "…" : "Cancel")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        </div> <!-- end mk-main-col -->

        @if (_activeSignal != null)
        {
        <div class="mk-charts-col-side">
        <!-- TRADE ORDER PANEL (right sidebar, exchange-style) -->
        @{
            bool isBuy = _activeSignal.Side?.ToUpper() == "BUY" || _activeSignal.Side?.ToUpper() == "LONG";
            decimal tp1 = _activeSignal.TakeProfits?.FirstOrDefault() ?? 0m;
        }
            <div class="ord-panel">
                <div class="ord-head">
                    <div class="ord-title">
                        @if (_activeSignal.Confidence > 0)
                        {
                            <span class="sc-side @(isBuy?"sc-side-b":"sc-side-s") ord-badge">
                                @(isBuy ? "▲ LONG" : "▼ SHORT")
                            </span>
                        }
                        else
                        {
                            <span class="ord-manual-badge">Manual Trade</span>
                        }
                        <span class="ord-sym">@_activeSignal.Symbol</span>
                    </div>
                    <button class="ord-close-x" @onclick="ClosePanel">✕</button>
                </div>

                <!-- Order type tabs -->
                <div class="ord-type-tabs">
                    <button class="ord-tt @(_orderType=="Market"?"ott-on":"")" @onclick='()=>_orderType="Market"'>
                        <span class="ord-tt-icon">⚡</span> Market
                    </button>
                    <button class="ord-tt @(_orderType=="Limit"?"ott-on":"")" @onclick='()=>_orderType="Limit"'>
                        <span class="ord-tt-icon">📋</span> Limit
                    </button>
                    <button class="ord-tt @(_orderType=="StopLimit"?"ott-on":"")" @onclick='()=>_orderType="StopLimit"'>
                        <span class="ord-tt-icon">🛡</span> Stop
                    </button>
                </div>

                <div class="ord-body">
                    <!-- Leverage row -->
                    <div class="ord-row">
                        <div class="ord-lev-head">
                            <label class="ord-label">Leverage</label>
                            <span class="ord-lev-val">@_orderLeverage×
                                <span class="ord-lev-max">/ @_symMaxLev× max</span>
                            </span>
                        </div>
                        <div class="ord-lev-slider-wrap">
                            <input type="range" min="1" max="@_symMaxLev" step="1"
                                   class="ord-lev-slider" title="Leverage"
                                   @bind="_orderLeverage" @bind:event="oninput" />
                            <div class="ord-lev-ticks">
                                @foreach (var v in new[]{1,5,10,20,30,50}.Where(v => v <= _symMaxLev))
                                {
                                    <span class="ord-lev-tick @(_orderLeverage==v?"otk-on":"")"
                                          @onclick="()=>_orderLeverage=v">@v×</span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Price row (hidden for Market) -->
                    @if (_orderType != "Market")
                    {
                        <div class="ord-row">
                            <label class="ord-label">@(_orderType == "StopLimit" ? "Stop Price" : "Limit Price")</label>
                            <div class="ord-input-wrap">
                                <input class="ord-input mono" type="number" title="@(_orderType == "StopLimit" ? "Stop Price" : "Limit Price")"
                                       step="@(_symTickSize > 0 ? _symTickSize.ToString("G8") : "any")"
                                       value="@(_orderPrice > 0 ? _orderPrice.ToString("G8") : "")"
                                       @onchange="OnPriceChange" />
                                <span class="ord-input-sfx">USDT</span>
                            </div>
                            <div class="ord-price-hint">🖱️ Right-click the chart to pick a price — qty & leverage auto-adjust</div>
                        </div>
                    }

                    <!-- Quantity + notional hint -->
                    <div class="ord-row">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <label class="ord-label">Quantity</label>
                            @{ decimal notional = _orderQty * (_orderPrice > 0 ? _orderPrice : _activeSignal!.Entry); }
                            @if (notional > 0)
                            {
                                <span class="ord-notional @(notional < _symMinNotional ? "ord-notional-warn" : "ord-notional-ok")">
                                    ≈ @notional.ToString("F2") USDT @(notional < _symMinNotional ? $"(min {_symMinNotional:F0})" : "")
                                </span>
                            }
                        </div>
                        <div class="ord-input-wrap">
                            <input class="ord-input mono" type="number" title="Quantity"
                                   step="@(_symStep > 0 ? _symStep.ToString("G8") : "any")"
                                   value="@(_orderQty > 0 ? _orderQty.ToString("G8") : "")"
                                   @onchange="OnQtyChange" />
                            <span class="ord-input-sfx">@_activeSignal!.Symbol.Replace("USDT","")</span>
                        </div>
                    </div>

                    <!-- Reference levels -->
                    <div class="ord-levels">
                        <div class="ord-lev">
                            <span class="ord-lev-l">@(_activeSignal.Confidence > 0 ? "Signal Entry" : "Last Price")</span>
                            <span class="ord-lev-v mono" @onclick="()=>_orderPrice=_activeSignal.Entry" title="Click to use">
                                @FmtP(_activeSignal.Entry) <span class="ord-lev-use">↑</span>
                            </span>
                        </div>
                        @if (_activeSignal.StopLoss > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Stop Loss</span>
                                <span class="ord-lev-v mono dn">@FmtP(_activeSignal.StopLoss)</span>
                            </div>
                        }
                        @if (tp1 > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Take Profit</span>
                                <span class="ord-lev-v mono up">@FmtP(tp1)</span>
                            </div>
                        }
                    </div>

                    <!-- Error -->
                    @if (!string.IsNullOrEmpty(_orderError))
                    {
                        <div class="ord-error">⚠ @_orderError</div>
                    }
                    @if (!string.IsNullOrEmpty(_orderSuccess))
                    {
                        <div class="ord-ok">✓ @_orderSuccess</div>
                    }

                    <!-- Submit -->
                    <div class="ord-actions">
                        <button class="ord-cancel-btn" @onclick="CancelOrder">Cancel</button>
                        @if (_activeSignal.Confidence > 0)
                        {
                            <!-- Strategy signal: direction is fixed, single submit button -->
                            <button class="ord-submit-btn @(isBuy?"osb-buy":"osb-sell")"
                                    @onclick="PlaceManualOrder" disabled="@_orderLoading">
                                @if (_orderLoading) { <span class="ord-spin"></span> }
                                else if (_orderType == "Market") { @(isBuy ? "Buy Market" : "Sell Market") }
                                else { @(isBuy ? "Buy Limit" : "Sell Limit") }
                            </button>
                        }
                        else
                        {
                            <!-- Manual trade: user picks direction at submit time -->
                            <button class="ord-submit-btn osb-buy"
                                    @onclick="PlaceManualOrderBuy" disabled="@_orderLoading">
                                @if (_orderLoading && isBuy) { <span class="ord-spin"></span> }
                                else { @(_orderType == "Market" ? "Buy Market" : "Buy Limit") }
                            </button>
                            <button class="ord-submit-btn osb-sell"
                                    @onclick="PlaceManualOrderSell" disabled="@_orderLoading">
                                @if (_orderLoading && !isBuy) { <span class="ord-spin"></span> }
                                else { @(_orderType == "Market" ? "Sell Market" : "Sell Limit") }
                            </button>
                        }
                    </div>
                </div>

                @if (_currentPosition != null)
                {
                    <div class="ord-position-box">
                        <div class="ord-position-head">
                            <span class="ord-position-title">📊 Открытая позиция</span>
                            <span class="sc-side @(PosIsLong ? "sc-side-b" : "sc-side-s") ord-badge">
                                @(PosIsLong ? "▲ LONG" : "▼ SHORT") @_currentPosition.Leverage×
                            </span>
                        </div>
                        <div class="ord-position-grid">
                            <div class="ord-position-cell">
                                <span class="ord-position-l">ENTRY</span>
                                <span class="ord-position-v mono">@FmtP(_currentPosition.EntryPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">MARK</span>
                                <span class="ord-position-v mono">@FmtP(_currentPosition.MarkPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">SIZE</span>
                                <span class="ord-position-v mono">@_currentPosition.Size.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">MARGIN</span>
                                <span class="ord-position-v mono">@_currentPosition.Margin.ToString("F2") USDT</span>
                            </div>
                        </div>
                        <div class="ord-position-pnl-row">
                            <span class="ord-position-pnl @(_currentPosition.Pnl >= 0 ? "up" : "dn")">
                                @(_currentPosition.Pnl >= 0 ? "+" : "")@_currentPosition.Pnl.ToString("F4") USDT
                            </span>
                            <span class="ord-position-roi @(_currentPosition.Roi >= 0 ? "up" : "dn")">
                                (@(_currentPosition.Roi >= 0 ? "+" : "")@((_currentPosition.Roi * 100).ToString("F2"))% ROI)
                            </span>
                        </div>
                        @if (_currentPosition.LiqPrice > 0)
                        {
                            <div class="ord-position-liq-warn">
                                ⚠ Liquidation @FmtP(_currentPosition.LiqPrice) — @PosLiqDistPercent.ToString("F1")% от mark price
                            </div>
                        }
                        <button class="ord-position-close-btn" @onclick="CloseCurrentPosition" disabled="@_orderLoading">
                            @if (_orderLoading) { <span class="ord-spin"></span> }
                            else { @("✕ Close Position") }
                        </button>
                    </div>
                }
            </div>

        <!-- ALL INSTRUMENTS — compact, scrollable, lives in the sidebar now -->
        <div class="mk-side-tbl">
            <div class="mk-side-tbl-title">ALL INSTRUMENTS</div>
            <div class="mk-side-search-wrap">
                <span class="mk-side-search-icon">🔍</span>
                <input class="mk-side-search" type="text" placeholder="Search symbol…" title="Search instruments"
                       value="@_instrumentSearch" @oninput="OnInstrumentSearchChanged" />
                @if (!string.IsNullOrEmpty(_instrumentSearch))
                {
                    <button class="mk-side-search-clear" @onclick="ClearInstrumentSearch" title="Clear search">✕</button>
                }
            </div>
            <div class="mk-side-tbl-scroll">
                @{
                    var allInstruments = Series
                        .GroupBy(x => x.Symbol)
                        .Select(g => g.OrderByDescending(x => x.Klines.Count).First())
                        .ToList();

                    var filtered = string.IsNullOrWhiteSpace(_instrumentSearch)
                        ? allInstruments
                        : allInstruments.Where(s => s.Symbol.Contains(_instrumentSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                    // Top 12 by total visible volume first, then the rest alphabetically —
                    // only when not actively searching (search shows plain matches).
                    var ordered = string.IsNullOrWhiteSpace(_instrumentSearch)
                        ? filtered.OrderByDescending(s => s.Klines.Sum(k => k.Volume)).Take(12)
                            .Concat(filtered.OrderByDescending(s => s.Klines.Sum(k => k.Volume)).Skip(12).OrderBy(s => s.Symbol))
                        : filtered.OrderBy(s => s.Symbol);

                    int rank = 0;
                }
                @foreach (var s in ordered)
                {
                    rank++;
                    var last = s.Klines.Count > 0 ? s.Klines[^1].Close : 0m;
                    var open = s.Klines.Count > 0 ? s.Klines[0].Close  : 0m;
                    var chg  = open > 0 ? (last - open) / open * 100m  : 0m;
                    bool isTop12 = string.IsNullOrWhiteSpace(_instrumentSearch) && rank <= 12;
                    <div class="mk-side-row @(s.Symbol==_activeSym?"mk-side-row-sel":"")" id="sideRow-@s.Symbol" @onclick="()=>PickAndTrade(s)">
                        @if (isTop12)
                        {
                            <span class="mk-side-rank">@rank</span>
                        }
                        <span class="mk-side-sym">@s.Symbol</span>
                        <span class="mk-side-price mono">@FmtP(last)</span>
                        <span class="mk-side-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F1")%</span>
                    </div>
                }
                @if (!ordered.Any())
                {
                    <div class="mk-side-empty">No instruments match "@_instrumentSearch"</div>
                }
            </div>
        </div> <!-- end mk-side-tbl -->
        </div> <!-- end mk-charts-col-side -->
        }
        else if (_selectedPosition != null)
        {
        <div class="mk-charts-col-side">
        <!-- POSITION DETAILS (right sidebar) — shown when a row in the
             OPEN POSITIONS table below the chart is clicked -->
        @{
            var pos = _selectedPosition!;
            bool posIsLong = pos.Side == "LONG";
            decimal liqDistPct = pos.LiqPrice > 0 && pos.MarkPrice > 0
                ? Math.Abs(pos.LiqPrice - pos.MarkPrice) / pos.MarkPrice * 100m
                : 0m;
        }
            <div class="ord-panel">
                <div class="ord-selected-label">Selected Position</div>
                <div class="ord-head">
                    <div class="ord-title">
                        <span class="sc-side @(posIsLong?"sc-side-b":"sc-side-s") ord-badge">
                            @(posIsLong ? "▲ LONG" : "▼ SHORT") @pos.Leverage×
                        </span>
                        <span class="ord-sym">@pos.Symbol</span>
                    </div>
                    <button class="ord-close-x" @onclick="() => SelectPosition(pos)">✕</button>
                </div>

                @{
                    var posOrders = _openOrders.Where(o => o.Symbol == pos.Symbol).ToList();
                }
                @if (posOrders.Any())
                {
                    <div class="ord-pos-orders">
                        <div class="ord-pos-orders-title">Open Orders for @pos.Symbol</div>
                        @foreach (var o in posOrders)
                        {
                            <div class="ord-pos-order-row">
                                <span class="@(o.Side == "BUY" ? "up" : "dn")">@o.Side</span>
                                <span class="mk-dim">@o.Type @(o.ReduceOnly ? "(R)" : "")</span>
                                <span class="mono">@(o.Price > 0 ? FmtP(o.Price) : "Market")</span>
                                <span class="mono mk-dim">@o.Qty.ToString("G8")</span>
                                <button class="mk-oo-cancel" disabled="@(_cancellingOrderId == o.OrderId)"
                                        @onclick="() => CancelOpenOrderAsync(o)">
                                    @(_cancellingOrderId == o.OrderId ? "…" : "Cancel")
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="ord-body">
                    <div class="ord-position-box" style="margin:0;border:none;padding:0;">
                        <div class="ord-position-grid">
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Entry Price</span>
                                <span class="ord-position-v mono">@FmtP(pos.EntryPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Mark Price</span>
                                <span class="ord-position-v mono">@FmtP(pos.MarkPrice)</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Size</span>
                                <span class="ord-position-v mono">@pos.Size.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Margin</span>
                                <span class="ord-position-v mono">@pos.Margin.ToString("F2") USDT</span>
                            </div>
                            <div class="ord-position-cell">
                                <span class="ord-position-l">Quantity</span>
                                <span class="ord-position-v mono">@pos.Qty.ToString("G8")</span>
                            </div>
                            @if (pos.LiqPrice > 0)
                            {
                                <div class="ord-position-cell">
                                    <span class="ord-position-l">Liq. Price</span>
                                    <span class="ord-position-v mono dn">@FmtP(pos.LiqPrice)</span>
                                </div>
                            }
                        </div>

                        <div class="ord-position-pnl-row">
                            <span class="ord-position-pnl @(pos.Pnl >= 0 ? "up" : "dn")">
                                @(pos.Pnl >= 0 ? "+" : "")@pos.Pnl.ToString("F4") USDT
                            </span>
                            <span class="ord-position-roi @(pos.Roi >= 0 ? "up" : "dn")">
                                (@(pos.Roi >= 0 ? "+" : "")@((pos.Roi * 100).ToString("F2"))% ROI)
                            </span>
                        </div>

                        @if (pos.LiqPrice > 0)
                        {
                            <div class="ord-position-liq-warn">
                                ⚠ Liquidation @FmtP(pos.LiqPrice) — @liqDistPct.ToString("F1")% от mark price
                            </div>
                        }
                    </div>

                    <div class="ord-actions" style="margin-top:16px;">
                        <button class="ord-cancel-btn" @onclick="() => _selectedPosition = null">Close Panel</button>
                        <button class="ord-submit-btn osb-sell" disabled="@_orderLoading"
                                @onclick="() => ClosePositionRow(pos)">
                            @if (_orderLoading) { <span class="ord-spin"></span> } else { @("Close Position") }
                        </button>
                    </div>
                </div>
            </div>
        </div> <!-- end mk-charts-col-side (position details) -->
        }
        </div> <!-- end mk-body-grid -->
     </div>
    </div> <!-- end mk-charts-area always-in-DOM -->
 

<style>
:root{--bg:#0a0d12;--bg2:#111520;--bg3:#1a1f2e;--bdr:#1e2535;--acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#eab308;--txt:#e2e8f0;--dim:#64748b;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt);}
.mk{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:48px;}
.up{color:var(--grn)!important;}.dn{color:var(--red)!important;}.mk-dim{color:var(--dim)!important;}

/* HEADER */
.mk-header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mk-title-block{display:flex;align-items:center;gap:14px;}
.mk-icon{font-size:28px;}
.mk-title{font-family:var(--mono);font-size:17px;font-weight:700;letter-spacing:2px;color:var(--acc);}
.mk-sub{font-size:11px;color:var(--dim);margin-top:3px;}
.mk-hright{display:flex;align-items:center;gap:16px;}
.mk-header-scan{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--dim);background:var(--bg3);padding:6px 14px;border-radius:20px;border:1px solid var(--bdr);}
.mk-header-scan-dot{width:6px;height:6px;border-radius:50%;background:#38bdf8;box-shadow:0 0 8px rgba(56,189,248,0.7);animation:mkHeaderScanPulse 1.6s ease-in-out infinite;flex-shrink:0;}
@@keyframes mkHeaderScanPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(0.7);}}
.mk-header-scan-sym{color:#38bdf8;font-family:var(--mono);font-weight:600;}
.sig-empty{display:flex;align-items:center;justify-content:center;min-height:36px;padding:8px 14px;color:var(--dim);font-size:12px;border:1px dashed var(--bdr);border-radius:8px;background:var(--bg3);}
.mk-ticker{display:flex;align-items:center;gap:10px;}
.mk-tsym{font-family:var(--mono);font-size:18px;font-weight:700;color:var(--acc);}
.mk-ttf{font-size:11px;background:var(--bg3);border:1px solid var(--bdr);padding:2px 8px;border-radius:4px;color:var(--dim);}
.mk-tprice{font-family:var(--mono);font-size:20px;font-weight:700;}
.mk-tchg{font-family:var(--mono);font-size:14px;font-weight:600;}
.mk-btn{padding:6px 16px;border:1px solid var(--bdr);background:var(--bg3);color:var(--dim);border-radius:6px;cursor:pointer;font-size:12px;transition:all .2s;}
.mk-btn:hover{border-color:var(--acc);color:var(--txt);}
.mk-btn-on{background:rgba(239,68,68,.15);border-color:var(--red);color:var(--red);}

/* TF BAR */
.mk-tf-bar{display:flex;align-items:center;gap:2px;padding:6px 16px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mk-tf-btn{padding:4px 10px;background:transparent;border:none;color:var(--dim);font-family:var(--mono);font-size:12px;font-weight:600;cursor:pointer;border-radius:4px;transition:all .15s;}
.mk-tf-btn:hover{background:var(--bg3);color:var(--txt);}
.mk-tf-on{background:var(--acc)!important;color:#fff!important;}
.mk-tf-dim{opacity:.35;}
.mk-tf-dim:hover{opacity:.6;}
.mk-chips{display:flex;gap:6px;padding:10px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;flex-wrap:wrap;}
.mk-chip{display:flex;align-items:center;gap:6px;padding:5px 12px;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;cursor:pointer;transition:all .15s;white-space:nowrap;}
.mk-chip:hover{border-color:var(--acc);}
.mk-chip-on{background:rgba(59,130,246,.12);border-color:var(--acc);}
.mk-chip-sym{font-family:var(--mono);font-size:12px;font-weight:700;}
.mk-chip-tf{font-size:10px;color:var(--dim);}
.mk-chip-chg{font-family:var(--mono);font-size:11px;font-weight:600;}

/* EMPTY */
.mk-empty{display:flex;flex-direction:column;align-items:center;gap:14px;padding:80px;color:var(--dim);text-align:center;}

/* STATS */
.mk-stats{display:grid;grid-template-columns:repeat(12,1fr);gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.mk-s{background:var(--bg2);padding:12px 16px;}
.mk-sl{font-size:10px;letter-spacing:1.5px;color:var(--dim);font-weight:600;}
.mk-sv{font-family:var(--mono);font-size:14px;font-weight:700;margin-top:4px;}

/* CHARTS */
.mk-charts-area{background:var(--bg2);padding:16px 20px;border-bottom:1px solid var(--bdr);position:relative;}
.mk-body-grid{display:grid;grid-template-columns:1fr;gap:16px;align-items:start;}
.mk-body-grid-with-panel{grid-template-columns:1fr 320px;}
.mk-main-col{min-width:0;display:flex;flex-direction:column;gap:16px;}
.mk-charts-col-main{min-width:0;}
.mk-charts-col-side{min-width:0;}
@@media(max-width:1000px){.mk-body-grid-with-panel{grid-template-columns:1fr;}}
.mk-chart-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:10px;}

.mk-chart-maximize{flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;color:var(--dim);cursor:pointer;transition:all .15s;}
.mk-chart-maximize:hover{color:var(--txt);border-color:var(--acc);}
.mk-chart-maximize svg{width:15px;height:15px;}

.mk-chart-container-wrap{width:100%;height:480px;transition:none;position:relative;}

.mk-tpsl-overlay{position:absolute;top:36px;left:8px;z-index:5;pointer-events:none;display:flex;align-items:center;gap:8px;}
.mk-tpsl-btn{pointer-events:auto;display:flex;align-items:center;gap:6px;background:rgba(10,13,18,0.92);border:1px solid var(--bdr);color:var(--dim);padding:5px 12px;border-radius:6px;font-size:11.5px;font-weight:600;cursor:pointer;transition:all .15s;backdrop-filter:blur(4px);}
.mk-tpsl-btn svg{width:13px;height:13px;}
.mk-tpsl-btn:hover{color:var(--txt);border-color:var(--acc);}
.mk-tpsl-btn-on{background:rgba(59,130,246,0.15);border-color:var(--acc);color:var(--acc);}
.mk-tpsl-hint{font-size:11px;color:var(--acc);background:rgba(59,130,246,0.1);padding:4px 10px;border-radius:5px;}
.mk-chart-maximized{position:fixed;top:60px;left:20px;right:20px;bottom:20px;z-index:1000;height:auto;background:var(--bg);border:1px solid var(--acc);border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.6);padding:8px;display:flex;flex-direction:column;}

.mk-max-bar{display:flex;align-items:center;gap:14px;padding:8px 12px;height:52px;flex-shrink:0;}
.mk-max-sym{font-family:var(--mono);font-size:16px;font-weight:700;display:flex;align-items:baseline;gap:8px;}
.mk-max-tf{font-size:11px;color:var(--dim);background:var(--bg3);padding:2px 8px;border-radius:5px;}
.mk-max-price{font-family:var(--mono);font-size:16px;font-weight:700;}
.mk-max-trade{display:flex;align-items:center;gap:6px;margin-left:auto;}
.mk-max-qty{width:100px;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;padding:7px 10px;color:var(--txt);font-size:12.5px;}
.mk-max-buy{background:var(--grn);border:none;color:#fff;padding:8px 18px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;}
.mk-max-buy:hover:not(:disabled){opacity:.88;}
.mk-max-sell{background:var(--red);border:none;color:#fff;padding:8px 18px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;}
.mk-max-sell:hover:not(:disabled){opacity:.88;}
.mk-max-buy:disabled,.mk-max-sell:disabled{opacity:.5;cursor:not-allowed;}
.mk-max-restore{display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--bdr);color:var(--dim);padding:8px 14px;border-radius:6px;font-size:12.5px;font-weight:600;cursor:pointer;transition:all .15s;}
.mk-max-restore:hover{color:var(--txt);border-color:var(--acc);}
.mk-max-restore svg{width:14px;height:14px;}

@@media(max-width:900px){
    .mk-max-bar{flex-wrap:wrap;height:auto;gap:8px;}
    .mk-max-trade{margin-left:0;width:100%;}
    .mk-max-qty{flex:1;}
}
.mk-chart-maximize-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:999;animation:mkFadeIn .15s ease;}
@@keyframes mkFadeIn{from{opacity:0;}to{opacity:1;}}

@@media(max-width:700px){.mk-chart-maximized{top:8px;left:8px;right:8px;bottom:8px;}}
.mk-chart-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;}
.mk-legend{display:flex;gap:14px;font-size:11px;color:var(--dim);}
/* TICKER BAR */
.mk-ticker-bar{background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;scrollbar-width:none;cursor:grab;}
.mk-ticker-bar::-webkit-scrollbar{display:none;}
.mk-ticker-scroll{display:flex;align-items:center;padding:0 4px;width:max-content;}
.mk-tk{display:inline-flex;align-items:center;gap:5px;padding:8px 14px;background:transparent;border:none;border-right:1px solid var(--bdr);cursor:pointer;transition:background .15s;white-space:nowrap;flex-shrink:0;}
.mk-tk:hover{background:var(--bg3);}
.mk-tk-on{background:rgba(59,130,246,.1);border-bottom:2px solid var(--acc);}
.mk-tk-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--txt);}
.mk-tk-sep{font-size:10px;color:var(--bdr);}
.mk-tk-tf{font-size:10px;color:var(--dim);}
.mk-tk-chg{font-family:var(--mono);font-size:11px;font-weight:600;}
.mk-tk-price{font-family:var(--mono);font-size:11px;color:var(--dim);}

/* CANVAS */
.mk-no-data-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(10,13,18,.9);z-index:10;color:var(--dim);}
.mk-canvas-wrap{position:relative;background:#070a0f;border-radius:4px;margin-bottom:2px;overflow:hidden;}
.mk-canvas-wrap canvas{display:block;width:100%!important;height:100%!important;position:absolute;top:0;left:0;}
.mk-canvas-price{height:300px;}
.mk-canvas-rsi{height:90px;}
.mk-canvas-vol{height:90px;}

/* RESIZE HANDLE */
.mk-resize-handle{position:absolute;bottom:0;left:0;right:0;height:10px;cursor:ns-resize;display:flex;align-items:center;justify-content:center;background:rgba(30,37,53,0.5);transition:background .15s;z-index:10;-webkit-user-select:none;user-select:none;}
.mk-resize-handle:hover{background:rgba(59,130,246,0.2);}
.mk-resize-dots{font-size:12px;color:var(--dim);letter-spacing:2px;line-height:1;}

/* SIGNAL PANEL */
.sig-panel{padding:10px 20px;border-bottom:1px solid var(--bdr);background:var(--bg2);}
.sig-panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.sig-panel-title{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:2px;color:var(--txt);}
.sig-dot{width:7px;height:7px;border-radius:50%;background:var(--grn);animation:pulse 1.5s infinite;}
@@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(34,197,94,.4);}50%{box-shadow:0 0 0 6px rgba(34,197,94,0);}}
.sig-count{background:var(--acc);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px;font-family:sans-serif;}
.sig-panel-sub{font-size:11px;color:var(--dim);}
.sig-cards{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin;}
.sig-cards::-webkit-scrollbar{height:3px;}
.sig-cards::-webkit-scrollbar-thumb{background:var(--bdr);}

/* Signal card */
.sig-card{flex-shrink:0;width:260px;min-height:100px;background:var(--bg3);border:1px solid var(--bdr);border-radius:10px;padding:10px 14px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;}
.sig-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;}
.sc-buy::before{background:var(--grn);}
.sc-sell::before{background:var(--red);}
.sig-card:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3);}
.sc-active{border-color:var(--acc)!important;background:rgba(59,130,246,.08)!important;}
.sc-top{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.sc-sym-wrap{display:flex;align-items:baseline;gap:3px;}
.sc-sym{font-family:var(--mono);font-size:14px;font-weight:700;}
.sc-usdt{font-size:9px;color:var(--dim);}
.sc-side{font-size:10px;font-weight:700;padding:2px 6px;border-radius:3px;white-space:nowrap;}
.sc-side-b{background:rgba(34,197,94,.15);color:var(--grn);}
.sc-side-s{background:rgba(239,68,68,.15);color:var(--red);}
.sc-ago{margin-left:auto;color:#94a3b8;font-weight:500;font-size:10px;}
.sc-conf-wrap{height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;margin-bottom:8px;}
.sc-conf-bar{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--acc),var(--grn));}
.sc-prices-row{display:flex;align-items:center;gap:14px;margin-bottom:6px;}
.sc-p{display:flex;align-items:center;gap:5px;}
.sc-pl{font-size:9px;color:var(--dim);}
.sc-pv{font-size:11.5px;}
.sc-foot{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;}
.sc-conf{font-family:var(--mono);font-size:12px;font-weight:700;flex-shrink:0;}
.sc-rr{font-size:10px;background:rgba(59,130,246,.12);color:var(--acc);padding:1px 5px;border-radius:3px;flex-shrink:0;}
.sc-atr{font-size:10px;flex-shrink:0;white-space:nowrap;}
.yel{color:var(--yel)!important;}

/* TTL bar lives inline in the footer now, no longer its own row */
.sc-ttl-bar-wrap{flex:1;height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;min-width:24px;}
.sc-ttl-bar{height:100%;border-radius:2px;transition:width 1s linear;}
.ttl-high{background:var(--grn);}
.ttl-mid{background:var(--yel);}
.ttl-low{background:var(--red);}
.sc-ttl-label{font-size:9px;white-space:nowrap;color:var(--dim);flex-shrink:0;}

/* Fade-out when expiring */
.sig-card{transition:opacity .2s,transform .2s,border-color .2s,background .2s,max-width .6s ease,margin .6s ease,padding .6s ease;}
.sc-fading{opacity:.35;}
.sig-card.sc-removing{opacity:0!important;max-width:0!important;padding-left:0!important;padding-right:0!important;margin:0!important;overflow:hidden;border-width:0;}

/* Pager */
.sig-panel-right{display:flex;align-items:center;gap:12px;}
.sig-pager{display:flex;align-items:center;gap:5px;}
.sig-pager-hidden{visibility:hidden;}
.sig-pager-dot{width:6px;height:6px;border-radius:50%;background:var(--bdr);cursor:pointer;transition:background .2s,transform .2s;}
.sig-pager-dot:hover{background:var(--dim);}
.sig-pager-dot.active{background:var(--acc);transform:scale(1.3);}
.sig-pager-label{font-size:10px;color:var(--dim);font-family:var(--mono);margin-left:2px;}

/* ORDER PANEL */
.ord-panel{margin:0;background:var(--bg3);border:1px solid var(--bdr);border-radius:12px;overflow:hidden;}
.ord-selected-label{font-size:10px;letter-spacing:1.5px;color:var(--acc);font-weight:700;text-transform:uppercase;padding:10px 18px 0;background:var(--bg2);}
.ord-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--bdr);background:var(--bg2);}

.ord-pos-orders{padding:12px 18px;border-bottom:1px solid var(--bdr);background:rgba(59,130,246,0.04);}
.ord-pos-orders-title{font-size:10px;letter-spacing:1px;color:var(--dim);font-weight:700;margin-bottom:8px;text-transform:uppercase;}
.ord-pos-order-row{display:grid;grid-template-columns:auto 1fr auto auto auto;align-items:center;gap:10px;padding:6px 0;font-size:12px;}
.ord-pos-order-row+.ord-pos-order-row{border-top:1px solid var(--bdr);}
.ord-title{display:flex;align-items:center;gap:10px;}
.ord-price-hint{font-size:10px;color:var(--dim);margin-top:5px;font-style:italic;}
.ord-manual-badge{font-size:11px;font-weight:700;color:var(--dim);background:var(--bg2);padding:3px 9px;border-radius:5px;letter-spacing:.3px;}
.ord-badge{font-size:12px;}
.ord-sym{font-family:var(--mono);font-size:16px;font-weight:700;}
.ord-close-x{background:none;border:none;color:var(--dim);font-size:16px;cursor:pointer;width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.ord-close-x:hover{background:var(--bdr);color:var(--txt);}
.ord-type-tabs{display:flex;background:var(--bg2);border-bottom:1px solid var(--bdr);gap:4px;padding:8px 12px;}
.ord-tt{flex:1;background:var(--bg3);border:1px solid var(--bdr);color:var(--dim);padding:10px 6px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;border-radius:8px;display:flex;align-items:center;justify-content:center;gap:5px;letter-spacing:.2px;}
.ord-tt:hover{color:var(--txt);border-color:var(--bdr2);background:var(--bg4);}
.ott-on{color:#fff!important;border-color:var(--acc)!important;background:linear-gradient(135deg,rgba(59,130,246,.3),rgba(59,130,246,.15))!important;box-shadow:0 0 12px rgba(59,130,246,.2);}
.ord-tt-icon{font-size:14px;}
/* Leverage */
.ord-lev-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.ord-lev-val{font-family:var(--mono);font-size:18px;font-weight:700;color:var(--acc);}
.ord-lev-slider-wrap{display:flex;flex-direction:column;gap:6px;}
.ord-lev-slider{width:100%;accent-color:var(--acc);height:4px;cursor:pointer;}
.ord-lev-ticks{display:flex;justify-content:space-between;}
.ord-lev-tick{font-size:11px;color:var(--dim);cursor:pointer;padding:2px 6px;border-radius:4px;transition:all .15s;font-family:var(--mono);}
.ord-lev-tick:hover{color:var(--txt);}
.ord-notional{font-size:11px;font-family:var(--mono);}
.ord-notional-ok{color:var(--grn);}
.ord-notional-warn{color:var(--yel);}
.ord-lev-max{font-size:11px;color:var(--dim);font-weight:400;margin-left:4px;}
.otk-on{color:var(--acc)!important;background:rgba(59,130,246,.15);font-weight:700;}
.ord-body{padding:16px 18px;display:flex;flex-direction:column;gap:12px;}
.ord-row{display:flex;flex-direction:column;gap:5px;}
.ord-label{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-input-wrap{display:flex;align-items:center;background:var(--bg2);border:1px solid var(--bdr);border-radius:7px;overflow:hidden;transition:border-color .15s;}
.ord-input-wrap:focus-within{border-color:var(--acc);}
.ord-input{flex:1;background:transparent;border:none;color:var(--txt);padding:9px 12px;font-family:var(--mono);font-size:14px;outline:none;}
.ord-input-sfx{padding:0 12px;color:var(--dim);font-size:12px;border-left:1px solid var(--bdr);}
.ord-levels{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:10px 0;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);}
.ord-lev{display:flex;flex-direction:column;gap:3px;}
.ord-lev-l{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-lev-v{font-size:12px;cursor:pointer;transition:opacity .15s;}
.ord-lev-v:hover{opacity:.7;}
.ord-lev-use{font-size:9px;opacity:.5;}
.ord-error{padding:8px 12px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:6px;font-size:12px;color:var(--red);}
.ord-ok{padding:8px 12px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);border-radius:6px;font-size:12px;color:var(--grn);}
.ord-actions{display:flex;gap:8px;}
.ord-cancel-btn{flex:1;background:var(--bg2);border:1px solid var(--bdr);color:var(--dim);padding:10px;border-radius:7px;font-size:13px;cursor:pointer;transition:all .15s;}
.ord-cancel-btn:hover{color:var(--txt);border-color:var(--bdr);}
.ord-submit-btn{flex:2;border:none;padding:10px;border-radius:7px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.osb-buy{background:linear-gradient(135deg,#059669,#10b981);color:#fff;}
.osb-buy:hover{box-shadow:0 4px 16px rgba(16,185,129,.4);}
.osb-sell{background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;}
.osb-sell:hover{box-shadow:0 4px 16px rgba(239,68,68,.4);}
.ord-submit-btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;}
.ord-spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}

.ord-position-box{margin-top:4px;padding:14px 16px;background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;display:flex;flex-direction:column;gap:10px;}
.ord-position-head{display:flex;align-items:center;justify-content:space-between;}
.ord-position-title{font-size:11px;letter-spacing:1px;color:var(--dim);font-weight:700;text-transform:uppercase;}
.ord-position-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;}
.ord-position-cell{display:flex;flex-direction:column;gap:2px;}
.ord-position-l{font-size:10px;color:var(--dim);letter-spacing:.5px;}
.ord-position-v{font-size:13px;color:var(--txt);}
.ord-position-pnl-row{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;}
.ord-position-pnl.up,.ord-position-roi.up{color:var(--grn);}
.ord-position-pnl.dn,.ord-position-roi.dn{color:var(--red);}
.ord-position-roi{font-size:12px;font-weight:600;}
.ord-position-liq-warn{padding:7px 10px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);border-radius:6px;font-size:11px;color:#f59e0b;}
.ord-position-close-btn{border:1px solid rgba(239,68,68,.4);background:rgba(239,68,68,.08);color:var(--red);padding:9px;border-radius:7px;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:8px;}
.ord-position-close-btn:hover:not(:disabled){background:rgba(239,68,68,.18);box-shadow:0 4px 14px rgba(239,68,68,.25);}
.ord-position-close-btn:disabled{opacity:.5;cursor:not-allowed;}

.mk-side-tbl{margin-top:4px;background:var(--bg3);border:1px solid var(--bdr);border-radius:10px;overflow:hidden;}
.mk-side-tbl-title{font-family:var(--mono);font-size:10px;letter-spacing:1.5px;color:var(--dim);font-weight:700;padding:10px 14px 8px;}

.mk-side-search-wrap{display:flex;align-items:center;gap:6px;margin:0 14px 8px;padding:6px 10px;background:var(--bg);border:1px solid var(--bdr);border-radius:8px;}
.mk-side-search-icon{font-size:11px;opacity:.5;flex-shrink:0;}
.mk-side-search{flex:1;background:none;border:none;color:var(--txt);font-size:12px;outline:none;min-width:0;}
.mk-side-search::placeholder{color:var(--dim);}
.mk-side-search-clear{background:none;border:none;color:var(--dim);cursor:pointer;font-size:11px;padding:0 2px;flex-shrink:0;}
.mk-side-search-clear:hover{color:var(--txt);}

.mk-side-rank{font-family:var(--mono);font-size:10px;color:var(--acc);font-weight:700;width:16px;flex-shrink:0;text-align:center;}
.mk-side-empty{padding:16px 14px;text-align:center;color:var(--dim);font-size:12px;}

.mk-side-tbl-scroll{max-height:280px;overflow-y:auto;scrollbar-width:none;}
.mk-side-tbl-scroll::-webkit-scrollbar{display:none;}
.mk-side-row{display:flex;align-items:center;gap:8px;padding:7px 14px;cursor:pointer;transition:background .1s;border-top:1px solid var(--bdr);}
.mk-side-row:first-child{border-top:none;}
.mk-side-row:hover{background:var(--bg2);}
.mk-side-row-sel{background:var(--bg2);box-shadow:inset 3px 0 0 var(--acc);}
.mk-side-sym{flex:1;min-width:0;font-size:12px;font-weight:700;color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.mk-side-price{font-size:11px;color:var(--dim);}
.mk-side-chg{font-size:11px;font-weight:700;min-width:48px;text-align:right;}

/* TABLE */
.mk-tbl-wrap{padding:20px 28px;}
.mk-tbl-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--bdr);}
.mk-tbl-scroll{overflow-x:auto;}
.mk-tbl{width:100%;border-collapse:collapse;}
.mk-tbl th{text-align:left;padding:7px 12px;font-size:10px;letter-spacing:1px;color:var(--dim);border-bottom:1px solid var(--bdr);white-space:nowrap;}
.mk-tbl td{padding:8px 12px;border-bottom:1px solid var(--bdr);}
.mk-tbl tr{cursor:pointer;transition:background .1s;}
.mk-tbl tr:hover td{background:var(--bg3);}
.mk-row-sel td{background:var(--bg3)!important;}
.mk-row-sel td:first-child{border-left:3px solid var(--acc);}
.mk-rsym{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--acc);}
.mk-rtf{background:var(--bg3);padding:2px 6px;border-radius:3px;font-size:10px;color:var(--dim);}
.mk-mono{font-family:var(--mono);font-size:12px;}

.mk-hints{display:flex;gap:16px;padding:8px 4px 0;font-size:11px;color:var(--dim);flex-wrap:wrap;}

/* OPEN ORDERS / POSITIONS — sized like a real exchange panel, not a compact strip */
.mk-oo-panel{background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;padding:18px 20px;}
.mk-oo-tabs{display:flex;gap:6px;margin-bottom:14px;border-bottom:1px solid var(--bdr);padding-bottom:0;}
.mk-oo-tab{display:flex;align-items:center;gap:8px;background:none;border:none;color:var(--dim);font-family:var(--mono);font-size:13px;letter-spacing:.5px;font-weight:700;padding:10px 6px 12px;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color .15s,border-color .15s;}
.mk-oo-tab:hover{color:var(--txt);}
.mk-oo-tab-on{color:var(--acc);border-bottom-color:var(--acc);}
.mk-oo-spin{color:var(--acc);animation:mkSpin 1s linear infinite;}
@@keyframes mkSpin{to{transform:rotate(360deg);}}
.mk-oo-count{background:var(--bg3);color:var(--txt);font-size:12px;font-weight:700;padding:2px 9px;border-radius:10px;}
.mk-oo-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.mk-oo-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;}
.mk-oo-empty{font-size:13px;color:var(--dim);padding:24px 2px;text-align:center;}
.mk-oo-scroll{max-height:280px;overflow-y:auto;scrollbar-width:none;}
.mk-oo-scroll::-webkit-scrollbar{display:none;}
.mk-oo-tbl{width:100%;border-collapse:collapse;}
.mk-oo-tbl th{position:sticky;top:0;background:var(--bg2);text-align:left;padding:8px 14px;font-size:11px;letter-spacing:.5px;color:var(--dim);border-bottom:1px solid var(--bdr);white-space:nowrap;font-weight:600;}
.mk-oo-tbl td{padding:11px 14px;font-size:13.5px;border-bottom:1px solid var(--bdr);white-space:nowrap;}
.mk-pos-row{cursor:pointer;transition:background .12s;}
.mk-pos-row:hover{background:rgba(255,255,255,0.04);}
.mk-pos-row-sel{background:rgba(59,130,246,0.1);box-shadow:inset 2px 0 0 var(--acc);}
.mk-oo-sym{font-family:var(--mono);font-weight:700;color:var(--acc);font-size:13.5px;}
.mk-liq{color:#f59e0b;}
.mk-oo-cancel{background:none;border:1px solid var(--bdr);color:var(--dim);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;line-height:1;white-space:nowrap;}
.mk-oo-cancel:hover:not(:disabled){border-color:var(--red);color:var(--red);}
.mk-oo-cancel:disabled{opacity:.5;cursor:not-allowed;}

@@media(max-width:1400px){.mk-stats{grid-template-columns:repeat(6,1fr);}}
@@media(max-width:900px){.mk-stats{grid-template-columns:repeat(3,1fr);}.mk-header{flex-direction:column;gap:12px;}}
</style>

@code {
    List<MarketSeries> Series = new();
    MarketSeries? Selected;

    // Symbol + TF selection
    string _activeSym = "";
    string _instrumentSearch = "";

    void OnInstrumentSearchChanged(ChangeEventArgs e) => _instrumentSearch = e.Value?.ToString() ?? "";
    void ClearInstrumentSearch() => _instrumentSearch = "";
    string _activeTf  = "";
    List<string> _symbols = new();

    // Puts the currently-active symbol first in the ticker bar display
    // order, without touching the underlying _symbols list itself
    // (which gets periodically rebuilt by the refresh timer and would
    // otherwise undo any direct reordering within a couple seconds).
    IEnumerable<string> OrderedTickerSymbols =>
        string.IsNullOrEmpty(_activeSym) || !_symbols.Contains(_activeSym)
            ? _symbols
            : new[] { _activeSym }.Concat(_symbols.Where(s => s != _activeSym));
    int _scanSymIdx = 0;

    // All standard TFs in TradingView order
    record TfDef(string Key, string Label);
    readonly List<TfDef> _allTfs = new()
    {
        new("OneMinute",      "1m"),
        new("ThreeMinutes",   "3m"),
        new("FiveMinutes",    "5m"),
        new("FifteenMinutes", "15m"),
        new("ThirtyMinutes",  "30m"),
        new("OneHour",        "1h"),
        new("TwoHour",        "2h"),
        new("FourHour",       "4h"),
        new("SixHour",        "6h"),
        new("TwelveHour",     "12h"),
        new("OneDay",         "1D"),
        new("ThreeDay",       "3D"),
        new("OneWeek",        "1W"),
    };
    PeriodicTimer? _timer;
    CancellationTokenSource _cts = new();
    bool Frozen, _jsReady;

    decimal _last, _chg, _ema21, _ema55, _atr;
    double _rsi;

    protected override async Task OnInitializedAsync()
    {
        // Unique per-mount suffix for the chart canvas ids. If Blazor's
        // diffing ever decides this component instance is "the same" as
        // a previous mount and tries to reuse DOM nodes (which we now
        // suspect is happening, since the JS-side generationId never
        // advances past 1 even after navigating away and back), giving
        // the canvas a genuinely different id each time it's created
        // makes that reuse structurally impossible — the diffing
        // algorithm can't match elements with different ids.
        _chartInstanceId = Guid.NewGuid().ToString("N")[..8];

        LiveState.PriceTicked += OnLivePriceTicked;
        LiveState.KlineClosed += OnLiveKlineClosed;

        await LoadData();
        _ = LoadOpenOrdersAsync();
        _ = LoadAllOpenPositionsAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = TickAsync();
        _ = ScanCycleAsync();
    }

    // ===== LIVE PUSH (from Engine via MarketDataHub) =====
    DateTime _lastLiveRender = DateTime.MinValue;
    static readonly TimeSpan LiveRenderThrottle = TimeSpan.FromMilliseconds(200);

    int _liveTickCount = 0;
    int _liveKlineCount = 0;
    string _lastTickSymbol = "";
    DateTime _lastTickTime = DateTime.MinValue;

    void OnLivePriceTicked(string symbol, decimal price)
    {
        _liveTickCount++;
        _lastTickSymbol = symbol;
        _lastTickTime = DateTime.UtcNow;

        _ = InvokeAsync(async () =>
        {
            await InvokeAsync(StateHasChanged); // always show updated tick counter

            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == _activeTf);
            if (idx < 0 || Series[idx].Klines.Count == 0) return;

            var last = Series[idx].Klines[^1];
            var updated = last with
            {
                High = Math.Max(last.High, price),
                Low = Math.Min(last.Low, price),
                Close = price
            };

            var klines = Series[idx].Klines.ToList();
            klines[^1] = updated;
            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym) return; // only re-render the chart actually on screen

            var now = DateTime.UtcNow;
            if (now - _lastLiveRender < LiveRenderThrottle) return;
            _lastLiveRender = now;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }

            // Live PnL caption on the entry line, if a position on this
            // symbol is currently selected.
            if (_selectedPosition != null && _selectedPosition.Symbol == symbol)
            {
                try { await JS.InvokeVoidAsync("marketChart.updatePnl", $"chartContainer-{_chartInstanceId}", price); } catch { }
            }

            StateHasChanged();
        });
    }

    void OnLiveKlineClosed(string symbol, string timeframe, KlineDto kline)
    {
        _liveKlineCount++;
        _ = InvokeAsync(async () =>
        {
            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == timeframe);
            if (idx < 0) return;

            var klines = Series[idx].Klines.ToList();
            if (klines.Count > 0 && klines[^1].OpenTime == kline.OpenTime)
                klines[^1] = kline;          // finalize the candle that was forming live
            else
                klines.Add(kline);           // new bar

            if (klines.Count > 500)
                klines.RemoveRange(0, klines.Count - 500);

            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym || timeframe != _activeTf) return;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }
            StateHasChanged();
        });
    }

