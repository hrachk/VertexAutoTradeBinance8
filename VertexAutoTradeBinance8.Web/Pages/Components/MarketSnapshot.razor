    async Task ReplaceProtectiveOrderAsync(
        ActivePositionInfo pos, bool isStopLoss, decimal newPrice,
        int? tpIndex = null, decimal originalPrice = 0)
    {
        // searchPrice: the OLD price of the order (before drag).
        // Used to find the existing exchange order — which is still
        // at that price until we cancel it.
        decimal searchPrice = originalPrice > 0 ? originalPrice : newPrice;
        // CRITICAL SAFETY CHECK: this previously never checked
        // _demoMode at all, meaning dragging a TP/SL line while in
        // demo mode was attempting to place a REAL order on the
        // actual Binance account — exactly why it appeared to "not
        // work" (the real exchange likely rejected a TP/SL for a
        // symbol/side with no matching real position), but more
        // importantly a genuine safety risk if conditions ever aligned
        // to let it through. Demo mode now mutates the in-memory demo
        // position's StopLoss/TakeProfits directly instead — no
        // separate order object needed, since DemoPosition already
        // embeds these levels and DemoAccountService's own price-tick
        // monitor watches them directly.
        if (_demoMode)
        {
            decimal price = _symTickSize > 0 ? Math.Round(newPrice / _symTickSize) * _symTickSize : newPrice;
            DemoAccount.UpdatePositionProtectiveLevel(pos.Id, isStopLoss, price, tpIndex);
            RefreshDemoSnapshot();
            await RefreshPositionLines();
            return;
        }

        _slTpDragBusy = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { return; }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

            // Round to the symbol's tick size if known, otherwise leave
            // as-is — better to place a slightly-off-tick order than to
            // silently snap to a wrong precision.
        // Always fetch tickSize/stepSize fresh — _symTickSize may be 0
        // (not loaded for this symbol) causing division by zero → NaN/∞
        // → Binance "Precision over maximum defined for asset" error.
        decimal tickSize = _symTickSize > 0 ? _symTickSize : 0m;
        decimal stepSize = _symStep     > 0 ? _symStep     : 0m;
        if (tickSize <= 0 || stepSize <= 0)
        {
            try
            {
                using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts2.Token);
                if (ei.Success)
                {
                    var sym = ei.Data.Symbols.FirstOrDefault(x => x.Name == pos.Symbol);
                    if (sym != null)
                    {
                        if (tickSize <= 0) tickSize = sym.PriceFilter?.TickSize   ?? 0m;
                        if (stepSize <= 0) stepSize = sym.LotSizeFilter?.StepSize ?? 0m;
                        if (tickSize > 0) _symTickSize = tickSize;
                        if (stepSize > 0) _symStep     = stepSize;
                    }
                }
            }
            catch { /* non-critical — fall back to raw precision */ }
        }

            decimal price = tickSize > 0
                ? Math.Round(newPrice / tickSize, MidpointRounding.ToEven) * tickSize
                : Math.Round(newPrice, 8);

            bool isLong = pos.Side == "LONG";
            var closeSide = isLong ? OrderSide.Sell : OrderSide.Buy;
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;

            // Find and cancel the existing protective order of the same
            // kind for this symbol AND position side — critical in
            // hedge mode, where the same symbol can have simultaneous
            // LONG and SHORT positions each with their own SL/TP.
            // Without this, dragging a line on one position could
            // cancel and replace the OTHER position's protective order
            // instead — a real financial risk, not just a display bug.
            bool MatchesThisPosition(OpenOrderRow o) =>
                o.Symbol == pos.Symbol &&
                (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

            OpenOrderRow? existing;
            if (!isStopLoss && tpIndex.HasValue)
            {
                // Match by PRICE proximity, not by array index.
                // JS tpLines[] order can differ from C# OrderBy(Price) sort
                // (e.g. when new TPs are added mid-session), causing the wrong
                // TP order to be cancelled when dragging the second or third level.
                // Using the closest-price match is always correct regardless of order.
                var tpOrders = _openOrders
                    .Where(o => MatchesThisPosition(o) && o.Type.Contains("TAKE_PROFIT"))
                    .ToList();
                // First try: exact price match (within tick size tolerance)
                // Use searchPrice (original price before drag) to find the order
                decimal tolerance = _symTickSize > 0 ? _symTickSize * 3 : searchPrice * 0.001m;
                existing = tpOrders.FirstOrDefault(o => Math.Abs(o.Price - searchPrice) <= tolerance);
                if (existing == null && tpOrders.Count > 0)
                    existing = tpOrders.MinBy(o => Math.Abs(o.Price - searchPrice));
            }
            else
            {
                existing = _openOrders.FirstOrDefault(o =>
                    MatchesThisPosition(o) &&
                    (isStopLoss ? o.Type.Contains("STOP") : o.Type.Contains("TAKE_PROFIT")));
            }

            if (existing != null)
            {
                if (existing.IsAlgo)
                    await CancelAlgoOrderRawAsync(pos.Symbol, existing.OrderId);
                else
                    await client.UsdFuturesApi.Trading.CancelOrderAsync(pos.Symbol, existing.OrderId, ct: cts.Token);
            }

            // Same conditional-order pattern the Engine itself uses for
            // placing SL/TP (see PositionSupervisorService.cs) — trigger
            // price against the Mark price, with price protection
            // enabled, rather than a plain stop order.
            var clientOrderId = $"MANUAL_{(isStopLoss ? "SL" : "TP")}_{pos.Symbol}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            // KEY FIX: preserve the ORIGINAL qty of the order being replaced.
            // When user drags TP1 (which was set at 35% of position), the new
            // order must also use 35% qty — not pos.Qty (100%).
            // For SL: always use full position qty (SL closes everything).
            // For TP: use existing order qty if found, fall back to full qty.
            decimal orderQty = isStopLoss
                ? pos.Qty  // SL always closes full position
                : (existing?.Qty ?? pos.Qty);  // TP: keep original partial qty

            // Round qty to lot step
            if (stepSize > 0 && orderQty > 0)
                orderQty = Math.Floor(orderQty / stepSize) * stepSize;
            if (orderQty <= 0) orderQty = pos.Qty; // safety fallback

            var r = await client.UsdFuturesApi.Trading.PlaceConditionalOrderAsync(
                symbol: pos.Symbol,
                side: closeSide,
                type: isStopLoss ? ConditionalOrderType.StopMarket : ConditionalOrderType.TakeProfitMarket,
                quantity: orderQty,
                positionSide: posSide,
                triggerPrice: price,
                workingType: WorkingType.Mark,
                clientOrderId: clientOrderId,
                priceProtect: true,
                ct: cts.Token);

            if (!r.Success)
            {
                await Task.Delay(800, cts.Token);
                r = await client.UsdFuturesApi.Trading.PlaceConditionalOrderAsync(
                    symbol: pos.Symbol,
                    side: closeSide,
                    type: isStopLoss ? ConditionalOrderType.StopMarket : ConditionalOrderType.TakeProfitMarket,
                    quantity: orderQty,
                    positionSide: posSide,
                    triggerPrice: price,
                    workingType: WorkingType.Mark,
                    clientOrderId: clientOrderId + "_R",
                    priceProtect: true,
                    ct: cts.Token);
                if (!r.Success)
                    _orderError = $"{(isStopLoss ? "SL" : "TP")} update failed: {r.Error?.Message}";
            }

            await LoadOpenOrdersAsync();
            await RefreshPositionLines();
        }
        catch (Exception ex)
        {
            _orderError = $"{(isStopLoss ? "SL" : "TP")} update failed: {ex.Message}";
        }
        finally
        {
            _slTpDragBusy = false; // release BEFORE StateHasChanged — prevents
                                   // next drag being blocked if SHC throws
            StateHasChanged();
        }
    }

    // Per direct confirmation: dragging from the Entry line always
    // creates a NEW TP level (never replaces an existing one - that's
    // what OnTpDragged/OnTpDraggedAt are for, when the user explicitly
    // grabs a specific existing line). Asks what % of the position to
    // allocate via a prompt, since the position may already be
    // partially allocated across existing TP levels and there's no
    // single "obviously correct" remaining share to assume.
    [JSInvokable]
    public async Task OnNewTpRequested(decimal price)
    {
        if (_selectedPosition == null || price <= 0 || _slTpDragBusy) return;
        var pos = _selectedPosition;
        decimal remaining = ComputeRemainingUnallocatedTpQty(pos);
        var pct = await PromptNewTpPercentAsync(remaining, pos.Qty);
        if (pct == null) { await RefreshPositionLines(); return; } // cancelled — redraw to clear the JS-side preview line
        await PlaceNewTpLevelAsync(pos, price, pct.Value);
    }

    // Per direct confirmation: the button-click path (no drag position
    // to derive a price from) asks for price AND percent in a single
    // combined prompt on the JS side, so this skips the separate
    // C#-side percent prompt entirely - pct is already known.
    [JSInvokable]
    public async Task OnNewTpRequestedWithPercent(decimal price, decimal pct)
    {
        if (_selectedPosition == null || price <= 0 || _slTpDragBusy) return;
        if (pct <= 0) pct = 25m; // user left the percent blank in the combined prompt — fall back to a sane default rather than rejecting
        await PlaceNewTpLevelAsync(_selectedPosition, price, Math.Clamp(pct, 1m, 100m));
    }

    decimal ComputeRemainingUnallocatedTpQty(ActivePositionInfo pos)
    {
        if (_demoMode)
        {
            decimal allocatedPctDemo = DemoAccount.GetSnapshot().Positions
                .FirstOrDefault(p => p.Id == pos.Id)?.TakeProfits?.Sum(t => t.Pct) ?? 0m;
            return Math.Max(0m, pos.Qty - pos.Qty * (allocatedPctDemo / 100m));
        }

        bool MatchesThisPosition(OpenOrderRow o) =>
            o.Symbol == pos.Symbol &&
            (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);
        decimal allocated = _openOrders.Where(o => MatchesThisPosition(o) && o.Type.Contains("TAKE_PROFIT")).Sum(o => o.Qty);
        return Math.Max(0m, pos.Qty - allocated);
    }

    async Task PlaceNewTpLevelAsync(ActivePositionInfo pos, decimal price, decimal pct)
    {
        if (_demoMode)
        {
            decimal tpDemoPrice = _symTickSize > 0 ? Math.Round(price / _symTickSize) * _symTickSize : price;
            decimal tpDemoQty = pos.Qty * (pct / 100m);
            DemoAccount.UpdatePositionProtectiveLevel(pos.Id, isStopLoss: false, tpDemoPrice, tpIndex: null, newTpQty: tpDemoQty);
            RefreshDemoSnapshot();
            await RefreshPositionLines();
            return;
        }

        _slTpDragBusy = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            // Ensure tickSize/stepSize are loaded — same fallback as ReplaceProtectiveOrderAsync
            decimal tpTickSize = _symTickSize > 0 ? _symTickSize : 0m;
            decimal tpStepSize = _symStep     > 0 ? _symStep     : 0m;
            if (tpTickSize <= 0 || tpStepSize <= 0)
            {
                try
                {
                    using var cts3 = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                    var ei3 = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts3.Token);
                    if (ei3.Success)
                    {
                        var sym3 = ei3.Data.Symbols.FirstOrDefault(x => x.Name == pos.Symbol);
                        if (sym3 != null)
                        {
                            if (tpTickSize <= 0) { tpTickSize = sym3.PriceFilter?.TickSize   ?? 0m; _symTickSize = tpTickSize; }
                            if (tpStepSize <= 0) { tpStepSize = sym3.LotSizeFilter?.StepSize ?? 0m; _symStep     = tpStepSize; }
                        }
                    }
                }
                catch { /* fall back to raw price */ }
            }

            // MidpointRounding.ToEven matches Binance tick-size enforcement
            decimal tpPrice = tpTickSize > 0
                ? Math.Round(price / tpTickSize, MidpointRounding.ToEven) * tpTickSize
                : Math.Round(price, 8);
            decimal tpQty = pos.Qty * (pct / 100m);
            if (tpStepSize > 0) tpQty = Math.Floor(tpQty / tpStepSize) * tpStepSize;
            if (tpQty <= 0) { _orderError = "New TP quantity too small after rounding"; return; }

            bool isLong = pos.Side == "LONG";
            var closeSide = isLong ? OrderSide.Sell : OrderSide.Buy;
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;
            var clientOrderId = $"MANUAL_TPNEW_{pos.Symbol}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            var r = await client.UsdFuturesApi.Trading.PlaceConditionalOrderAsync(
                symbol: pos.Symbol,
                side: closeSide,
                type: ConditionalOrderType.TakeProfitMarket,
                quantity: tpQty,
                positionSide: posSide,
                triggerPrice: tpPrice,
                workingType: WorkingType.Mark,
                clientOrderId: clientOrderId,
                priceProtect: true,
                ct: cts.Token);

            if (!r.Success)
            {
                _orderError = $"New TP failed: {r.Error?.Message}";
            }

            await LoadOpenOrdersAsync();
            await RefreshPositionLines();
        }
        catch (Exception ex)
        {
            _orderError = $"New TP failed: {ex.Message}";
        }
        finally
        {
            _slTpDragBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Per direct request: a small "×" cancel button on each SL/TP
    // pill cancels just that one specific level. For TP with multiple
    // levels, uses the same sorted-by-price index-matching pattern
    // already proven in ReplaceProtectiveOrderAsync, so "the 2nd TP
    // pill" cancels the 2nd TP order found in that same order -
    // consistent with how dragging "the 2nd TP line" already works.
    [JSInvokable]
    public async Task OnCancelProtectiveLevel(string kind, int index)
    {
        if (_selectedPosition == null) return;
        var pos = _selectedPosition;
        bool isStopLoss = kind == "sl";

        if (_demoMode)
        {
            if (isStopLoss)
            {
                DemoAccount.RemoveStopLoss(pos.Id);
            }
            else
            {
                DemoAccount.RemoveTakeProfitLevel(pos.Id, index);
            }
            RefreshDemoSnapshot();
            await RefreshPositionLines();
            return;
        }

        bool MatchesThisPosition(OpenOrderRow o) =>
            o.Symbol == pos.Symbol &&
            (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

        OpenOrderRow? toCancel;
        if (isStopLoss)
        {
            toCancel = _openOrders.FirstOrDefault(o => MatchesThisPosition(o) && o.Type.Contains("STOP"));
        }
        else
        {
            var tpOrders = _openOrders
                .Where(o => MatchesThisPosition(o) && o.Type.Contains("TAKE_PROFIT"))
                .OrderBy(o => pos.Side == "LONG" ? o.Price : -o.Price)
                .ToList();
            toCancel = index >= 0 && index < tpOrders.Count ? tpOrders[index] : null;
        }

        if (toCancel == null) return;

        try
        {
            if (toCancel.IsAlgo)
            {
                await CancelAlgoOrderRawAsync(pos.Symbol, toCancel.OrderId);
            }
            else
            {
                var client = Factory.TryCreateRestClient();
                if (client == null) return;
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                await client.UsdFuturesApi.Trading.CancelOrderAsync(pos.Symbol, toCancel.OrderId, ct: cts.Token);
            }
        }
        catch (Exception ex)
        {
            _orderError = $"Cancel {(isStopLoss ? "SL" : "TP")} failed: {ex.Message}";
        }

        await LoadOpenOrdersAsync();
        await RefreshPositionLines();
        await InvokeAsync(StateHasChanged);
    }

    // ── TP Modal state ───────────────────────────────────────────────────
    bool _tpModalOpen;
    decimal _tpModalPrice;
    decimal _tpModalPct;
    string _tpModalPctStr = "";
    string _tpModalError = "";
    TaskCompletionSource<decimal?>? _tpModalTcs;

    async Task<decimal?> PromptNewTpPercentAsync(decimal remainingQty, decimal totalQty)
    {
        decimal suggestedPct = totalQty > 0 ? Math.Round(remainingQty / totalQty * 100m, 0) : 0m;
        if (suggestedPct <= 0) suggestedPct = 25m;

        _tpModalPct    = suggestedPct;
        _tpModalPctStr = ((int)suggestedPct).ToString();
        _tpModalError  = "";
        _tpModalOpen   = true;
        _tpModalTcs    = new TaskCompletionSource<decimal?>();
        StateHasChanged();

        // Wait for user to confirm or cancel
        var result = await _tpModalTcs.Task;
        _tpModalOpen = false;
        StateHasChanged();
        return result;
    }

    void TpModalConfirm()
    {
        _tpModalError = "";
        if (!decimal.TryParse(_tpModalPctStr, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var pct) || pct <= 0 || pct > 100)
        {
            _tpModalError = "Enter a valid percentage (1-100)";
            return;
        }
        _tpModalTcs?.TrySetResult(Math.Clamp(pct, 1m, 100m));
    }

    void TpModalCancel() => _tpModalTcs?.TrySetResult(null);


    // zero, accounting for the round-trip taker fee (0.05% each way,
    // Break-even price — the level where closing now would net exactly
    // zero, accounting for the round-trip taker fee (0.05% each way,
    // Binance's own standard taker rate) on top of just the entry
    // price. A position needs to move past entry by enough to cover
    // BOTH the entry and exit fees before it's genuinely break-even,
    // not merely back at the price it was opened at.
    const decimal TakerFeeRate = 0.0005m;
    decimal ComputeBreakEvenPrice(ActivePositionInfo pos)
    {
        if (pos.EntryPrice <= 0) return 0m;
        decimal feeAdjustment = pos.EntryPrice * TakerFeeRate * 2m;
        return pos.Side == "LONG" ? pos.EntryPrice + feeAdjustment : pos.EntryPrice - feeAdjustment;
    }

    // Re-draws the entry/SL/TP lines on the chart from the currently
    // selected position's matching open orders, after any change.
    async Task RefreshPositionLines()
    {
        if (_selectedPosition == null)
        {
            try { await JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}"); } catch { }
            return;
        }

        var pos = _selectedPosition;
        decimal breakEven = ComputeBreakEvenPrice(pos);
        try
        {
            await JS.InvokeVoidAsync("marketChart.showPositionLines",
                $"chartContainer-{_chartInstanceId}", pos.EntryPrice, pos.Side, pos.Qty, pos.LiqPrice, breakEven);
        }
        catch { }

        // If TP/SL editing was already open (e.g. after a drag just
        // replaced an order), keep it open and refresh the lines to
        // reflect the new state rather than closing it.
        if (_tpSlEditMode)
        {
            await ShowTpSlLinesAsync();
        }
    }

    // Per direct request: SL/TP lines now show by DEFAULT as soon as a
    // position is selected, not only after explicitly clicking the
    // "TP/SL" toggle - overriding the previous session's deliberate
    // "matches Binance, not automatic" design choice.
    bool _tpSlEditMode = true;
    // When user drags a TP/SL line, we suppress the periodic
    // snapshot-diff redraw for 10s so the line doesn't
    // disappear between cancel-old-order and place-new-order.
    DateTime _tpSlDragFreezeUntil = DateTime.MinValue;
    bool IsTpSlDragFrozen => DateTime.UtcNow < _tpSlDragFreezeUntil;

    // ── Leverage editor ──────────────────────────────────────────────
    ActivePositionInfo? _levPos;
    int _levVal, _levMax = 125;
    bool _levSaving;
    string _levErr = "";

    async Task OpenLevEditor(ActivePositionInfo pos)
    {
        _levPos = pos; _levVal = pos.Leverage; _levErr = ""; _levMax = 125;
        try
        {
            var c = Factory.TryCreateRestClient();
            if (c != null)
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                var br = await c.UsdFuturesApi.Account.GetBracketsAsync(pos.Symbol, ct: cts.Token);
                if (br.Success && br.Data != null)
                {
                    var s = br.Data.FirstOrDefault(b => b.Symbol == pos.Symbol);
                    if (s?.Brackets?.Length > 0) _levMax = s.Brackets.Max(b => b.InitialLeverage);
                }
            }
        }
        catch { }
        StateHasChanged();
    }

    void OnLevInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            SetLevVal(v);
    }

    // Centralised lever-value setter — used by both the range slider
    // (OnLevInput) and the preset buttons. Calling StateHasChanged here
    // is required so the preset highlights and the big-number display
    // re-render immediately after a preset click (void @onclick handlers
    // do NOT auto-trigger a re-render in Blazor Server by default).
    void SetLevVal(int v)
    {
        _levVal = Math.Clamp(v, 1, _levMax);
        StateHasChanged();
    }

    async Task SaveLev()
    {
        if (_levPos == null) return;
        _levSaving = true; _levErr = ""; StateHasChanged();
        try
        {
            var c = Factory.TryCreateRestClient();
            if (c == null) { _levErr = "No API credentials"; return; }
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var r = await c.UsdFuturesApi.Account.ChangeInitialLeverageAsync(_levPos.Symbol, _levVal, ct: cts.Token);
            if (r.Success)
            {
                // ActivePositionInfo is a class, not a record — mutate directly
                var target = _allPositions.FirstOrDefault(p => p.Symbol == _levPos.Symbol && p.Side == _levPos.Side);
                if (target != null) target.Leverage = _levVal;
                _levPos = null;
            }
            else _levErr = r.Error?.Message ?? "Failed";
        }
        catch (Exception ex) { _levErr = ex.Message; }
        finally { _levSaving = false; StateHasChanged(); }
    }

    async Task ToggleTpSlEdit()
    {
        _tpSlEditMode = !_tpSlEditMode;
        if (_tpSlEditMode)
        {
            await ShowTpSlLinesAsync();
        }
        else
        {
            try { await JS.InvokeVoidAsync("marketChart.hideTpSlLines", $"chartContainer-{_chartInstanceId}"); } catch { }
        }
        _ = SaveSelectionState();
    }

    async Task ShowTpSlLinesAsync()
    {
        if (_selectedPosition == null) return;
        var pos = _selectedPosition;

        // Filter by PositionSide too, not just Symbol — critical for
        // hedge-mode accounts where the same symbol can have
        // simultaneous LONG and SHORT positions, each with their own
        // SL/TP orders. In one-way mode, PositionSide is always "BOTH"
        // regardless of actual direction, so that's accepted too
        // (matches everything, same as before this fix, for accounts
        // that don't use hedge mode).
        bool MatchesPosition(OpenOrderRow o) =>
            o.Symbol == pos.Symbol &&
            (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

        // Sync the snapshot regardless of caller (SelectPosition, a
        // drag commit, the periodic check, etc) so the periodic
        // check's comparison always reflects what's actually shown,
        // not stale state from before a position switch.
        _lastTpSlSnapshot = string.Join("|", _openOrders
            .Where(o => MatchesPosition(o) && (o.Type.Contains("STOP") || o.Type.Contains("TAKE_PROFIT")))
            .OrderBy(o => o.OrderId)
            .Select(o => $"{o.OrderId}:{o.Price}"));

        var sl = _openOrders.FirstOrDefault(o => MatchesPosition(o) && o.Type.Contains("STOP"))?.Price ?? 0m;
        var tps = _openOrders
            .Where(o => MatchesPosition(o) && o.Type.Contains("TAKE_PROFIT"))
            .OrderBy(o => pos.Side == "LONG" ? o.Price : -o.Price)
            .Select(o => o.Price)
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("marketChart.showTpSlLines",
                $"chartContainer-{_chartInstanceId}", pos.EntryPrice, sl, tps, pos.Side);
        }
        catch { }
    }

    // AI sizing: given an entry price (chart-picked or signal default),
    // current free balance and the symbol's max leverage, suggest both
    // a sensible quantity AND bump leverage if the balance is too small
    // to comfortably afford the position at the current leverage.
    async Task SuggestQtyForPrice(decimal entryPrice)
    {
        if (_activeSignal == null || entryPrice <= 0) return;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));

            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            decimal balance = 0m;
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null) balance = usdt.AvailableBalance;
            }
            if (balance <= 0) return;

            decimal stopDist = _activeSignal.StopLoss > 0
                ? Math.Abs(entryPrice - _activeSignal.StopLoss)
                : (_activeSignal.ATR > 0 ? _activeSignal.ATR * 1.5m : entryPrice * 0.01m);

            decimal riskUsdt = balance * 0.02m; // 2% of balance at risk
            decimal rawQty   = stopDist > 0 ? riskUsdt / stopDist : 0m;

            // Minimum quantity to satisfy exchange minNotional.
            decimal minQtyForNotional = _symMinNotional / entryPrice;
            decimal qty = Math.Max(rawQty, minQtyForNotional);

            decimal step = _symStep > 0 ? _symStep : 0.001m;
            qty = Math.Floor(qty / step) * step;
            if (qty <= 0) qty = step;

            // Margin needed at the CURRENT leverage setting.
            decimal notional     = qty * entryPrice;
            decimal marginNeeded = notional / Math.Max(_orderLeverage, 1);

            // If the position would eat up almost the whole balance as margin,
            // the leverage is too low for this balance size — raise it
            // (capped at the symbol's real max) so margin usage settles
            // around ~50%, instead of letting the order fail on insufficient
            // margin or forcing the user to manually drag the slider.
            if (marginNeeded > balance * 0.9m)
            {
                int neededLev = (int)Math.Ceiling(notional / (balance * 0.5m));
                _orderLeverage = Math.Clamp(neededLev, _orderLeverage, _symMaxLev);
            }

            _orderQty = qty;
        }
        catch { }
    }

    void SelectSignal(MissedTradeRecord sig)
    {
        _seenSignalKeys.Add(SignalKey(sig));
        _activeSignal  = _activeSignal == sig ? null : sig;
        // Per direct confirmation: show BOTH panels together when both
        // are available, not one clobbering the other - set to the
        // existing position for this SAME symbol (if any), rather than
        // unconditionally clearing it, which would have kept the
        // Position panel hidden even with it now being an independent
        // @if block above.
        _selectedPosition = _activeSignal != null ? _selectedPositionForSameSymbol(sig.Symbol) : null;
        _manualTradeCollapsed = false;
        _orderError    = string.Empty;
        _orderSuccess  = string.Empty;
        _orderType     = "Market";
        _orderLeverage = 10;
        _orderQty      = 0;
        _orderPrice    = sig.Entry;

        if (_activeSignal != null)
        {
            _orderPanelDismissed = false;
            PickSym(sig.Symbol, autoSelectExistingPosition: false);
            _ = LoadSymbolInfoAndSuggestQty(sig);
            _ = LoadCurrentPositionAsync(sig.Symbol);

            if (_selectedPosition != null)
            {
                _ = RefreshPositionLines();
            }

            // Auto-fill SL/TP straight from the signal's own levels —
            // one click sets up the whole trade (qty, leverage already
            // computed above; SL/TP here), not just the entry price.
            // Splits evenly across however many TP levels the signal
            // actually provided.
            _manualSlPrice = sig.StopLoss;
            _manualTps = new List<ManualTpRow>();
            if (sig.TakeProfits != null && sig.TakeProfits.Count > 0)
            {
                decimal evenPct = Math.Round(100m / sig.TakeProfits.Count, 0);
                for (int i = 0; i < sig.TakeProfits.Count; i++)
                {
                    bool isLast = i == sig.TakeProfits.Count - 1;
                    decimal pct = isLast ? (100m - evenPct * i) : evenPct; // last row absorbs any rounding remainder
                    _manualTps.Add(new ManualTpRow { Price = sig.TakeProfits[i], Pct = pct });
                }
            }
        }
        else
        {
            _orderPanelDismissed = true;
            _currentPosition = null;
            _manualSlPrice = 0;
            _noProtectionConfirmed = false;
            _manualTps.Clear();
        }
    }

    // Lightweight version: only loads tickSize + stepSize (no qty/balance).
    // Used by SelectPosition so drag TP/SL works without precision errors.
    async Task LoadSymbolPrecisionAsync(string symbol)
    {
        if (string.IsNullOrEmpty(symbol)) return;
        // Skip if already loaded for this exact symbol
        if (_symTickSize > 0 && _symStep > 0 && _activeSym == symbol) return;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));
            var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
            if (!ei.Success) return;
            var s = ei.Data.Symbols.FirstOrDefault(x => x.Name == symbol);
            if (s == null) return;
            _symTickSize = s.PriceFilter?.TickSize   ?? 0.0001m;
            _symStep     = s.LotSizeFilter?.StepSize ?? 0.001m;
        }
        catch { /* non-critical */ }
    }

    async Task LoadSymbolInfoAndSuggestQty(MissedTradeRecord sig)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            // 1) Exchange info → tickSize, stepSize, minNotional
            var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts.Token);
            if (ei.Success)
            {
                var s = ei.Data.Symbols.FirstOrDefault(x => x.Name == sig.Symbol);
                if (s != null)
                {
                    _symTickSize    = s.PriceFilter?.TickSize   ?? 0.0001m;
                    _symStep        = s.LotSizeFilter?.StepSize ?? 0.001m;
                    _symMinNotional = 5m;
                    foreach (var f in s.Filters)
                    {
                        if (f is Binance.Net.Objects.Models.Spot.BinanceSymbolMinNotionalFilter mn)
                        { _symMinNotional = mn.MinNotional; break; }
                    }
                }
            }

            // 2) Real MaxLeverage via GetBracketsAsync
            try
            {
                var br = await client.UsdFuturesApi.Account
                    .GetBracketsAsync(sig.Symbol, ct: cts.Token);
                if (br.Success && br.Data != null)
                {
                    var sb = br.Data.FirstOrDefault(b => b.Symbol == sig.Symbol);
                    if (sb?.Brackets?.Length > 0)
                    {
                        _symMaxLev = sb.Brackets.Max(b => b.InitialLeverage);
                        if (_orderLeverage > _symMaxLev)
                            _orderLeverage = Math.Min(_symMaxLev, 20);
                    }
                }
            }
            catch { }

            // 3) Round price to tickSize
            if (_symTickSize > 0 && sig.Entry > 0)
                _orderPrice = Math.Round(sig.Entry / _symTickSize) * _symTickSize;

            // 4) Suggest qty from balance with 2% risk
            var bal = await client.UsdFuturesApi.Account.GetBalancesAsync(ct: cts.Token);
            if (bal.Success && bal.Data != null)
            {
                var usdt = bal.Data.FirstOrDefault(b => b.Asset == "USDT");
                if (usdt != null && usdt.AvailableBalance > 0 && sig.Entry > 0)
                {
                    decimal balance  = usdt.AvailableBalance;
                    decimal riskUsdt = balance * 0.02m;
                    decimal stopDist = sig.StopLoss > 0
                        ? Math.Abs(sig.Entry - sig.StopLoss)
                        : (sig.ATR > 0 ? sig.ATR * 1.5m : sig.Entry * 0.01m);

                    decimal rawQty = stopDist > 0 ? riskUsdt / stopDist : 0m;
                    decimal minQty = sig.Entry > 0 ? _symMinNotional / sig.Entry : 0m;
                    rawQty = Math.Max(rawQty, minQty);

                    decimal step = _symStep > 0 ? _symStep : 0.001m;
                    _orderQty = Math.Floor(rawQty / step) * step;

                    // 5) Smart leverage — per the standard risk-management
                    // rule (confirmed via several position-sizing
                    // references): liquidation distance should be at
                    // least 2x the stop-loss distance, otherwise the
                    // exchange force-closes the position before the SL
                    // ever triggers (paying extra liquidation fees on top).
                    // Isolated-margin liquidation distance is approximately
                    // 1/leverage, so the highest safe leverage is roughly
                    // 1 / (2 × stopDistPct). Capped at a sane ceiling (20x)
                    // and the symbol's real exchange max — never suggests
                    // something reckless just because the math allows it.
                    if (sig.Entry > 0 && stopDist > 0)
                    {
                        decimal stopDistPct = stopDist / sig.Entry;
                        decimal safeLeverage = stopDistPct > 0 ? 1m / (2m * stopDistPct) : 20m;
                        int suggestedLev = (int)Math.Floor(Math.Clamp(safeLeverage, 1m, 20m));
                        _orderLeverage = Math.Min(suggestedLev, _symMaxLev > 0 ? _symMaxLev : suggestedLev);
                        if (_orderLeverage < 1) _orderLeverage = 1;
                    }
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    // Fetches ALL open positions (no symbol filter), so the positions
    // table under the chart always shows everything regardless of
    // which symbol happens to be selected on the chart.
    async Task LoadAllOpenPositionsAsync()
    {
        _positionsLoading = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _lastPositionsFetchOk = false; return; }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var res = await client.UsdFuturesApi.Account.GetPositionInformationAsync(ct: cts.Token);
            if (!res.Success || res.Data == null) { _lastPositionsFetchOk = false; return; } // keep showing the last known list rather than flashing to empty
            _lastPositionsFetchOk = true;

            // Account summary (margin/wallet balance, unrealized PnL) —
            // fetched directly via the same Binance client/pattern
            // already proven working for positions just above, NOT
            // through the LivePnlService/AccountStateController path,
            // which was fundamentally broken: that relied on a Web-side
            // AccountStateService instance that the real Engine process
            // never updates (Web and Engine are separate .NET processes
            // with entirely separate DI containers — the Web-side
            // instance just sits at its default, never-updated values).
            try
            {
                using var acctCts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                var acctRes = await client.UsdFuturesApi.Account.GetAccountInfoV3Async(ct: acctCts.Token);
                if (acctRes.Success && acctRes.Data != null)
                {
                    _acctMarginBalance = acctRes.Data.TotalMarginBalance;
                    _acctWalletBalance = acctRes.Data.TotalWalletBalance;
                    _acctUnrealizedPnl = acctRes.Data.TotalUnrealizedProfit;
                    _acctAvailableBalance = acctRes.Data.AvailableBalance;
                }
            }
            catch { /* account summary is a nice-to-have on this page; don't let it block position loading */ }

            // Realized PnL today — via Binance's own Income History
            // endpoint, filtered to REALIZED_PNL entries since UTC
            // midnight. THROTTLED to once per minute, not every 5-second
            // tick: confirmed via Binance's own API docs this endpoint
            // costs 30 weight (6x heavier than Positions/Account at 5
            // each) — at the previous rate this alone consumed 360
            // weight/minute (15% of the 2400/minute Futures limit) for
            // data that only changes when a trade actually closes, not
            // continuously like live position prices. Kept in its own
            // try/catch so a failure here never affects the more
            // important balance numbers above.
            if ((DateTime.UtcNow - _lastRealizedPnlFetchUtc) >= TimeSpan.FromMinutes(1))
            {
                try
                {
                    using var pnlCts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
                    var todayStartUtc = DateTime.UtcNow.Date;
                    var incomeRes = await client.UsdFuturesApi.Account.GetIncomeHistoryAsync(
                        incomeType: "REALIZED_PNL",
                        startTime: todayStartUtc,
                        limit: 1000,
                        ct: pnlCts.Token);

                    if (incomeRes.Success && incomeRes.Data != null)
                        _acctRealizedPnlToday = incomeRes.Data.Sum(x => x.Income);

                    _lastRealizedPnlFetchUtc = DateTime.UtcNow;
                }
                catch { /* same — don't block the page on this */ }
            }

            _allPositions = res.Data
                .Where(p => p.Quantity != 0)
                .Select(p =>
                {
                    var side   = p.Quantity > 0 ? "LONG" : "SHORT";
                    var size   = Math.Abs(p.Quantity * p.EntryPrice);
                    var margin = p.MarginType == FuturesMarginType.Isolated
                        ? p.IsolatedMargin : size / Math.Max(p.Leverage, 1);
                    var roi    = margin > 0 ? p.UnrealizedPnl / margin : 0m;

                    return new ActivePositionInfo
                    {
                        Symbol     = p.Symbol,
                        Side       = side,
                        Leverage   = p.Leverage,
                        Size       = size,
                        Qty        = Math.Abs(p.Quantity),
                        EntryPrice = p.EntryPrice,
                        MarkPrice  = p.MarkPrice,
                        LiqPrice   = p.LiquidationPrice,
                        Margin     = margin,
                        Pnl        = p.UnrealizedPnl,
                        Roi        = roi
                    };
                })
                .OrderByDescending(p => Math.Abs(p.Pnl))
                .ToList();

            // CRITICAL FIX: ActivePositionInfo is a plain class with
            // reference equality, and the LINQ above creates entirely
            // NEW instances every single refresh — even for the exact
            // same still-open position. _selectedPosition held onto
            // the OLD instance, which after this point matches nothing
            // in the new _allPositions list via '==' (reference
            // comparison), even though the position itself is still
            // genuinely open and was never actually deselected. This
            // silently broke the "mk-pos-row-sel" highlight and the
            // ord-panel's "is this still selected" checks on every
            // single periodic tick — exactly the "after load everything
            // is lost" symptom from the screenshots. Fix: re-point the
            // reference at the fresh matching instance (by symbol+side,
            // since a symbol can have both a LONG and a SHORT position
            // open simultaneously, as seen in the screenshots) instead
            // of leaving it dangling.
            if (_selectedPosition != null)
            {
                var refreshed = _allPositions.FirstOrDefault(p =>
                    p.Symbol == _selectedPosition.Symbol && p.Side == _selectedPosition.Side);

                if (refreshed == null)
                {
                    // Position was open last tick but is gone now — it closed
                    // (TP hit, SL hit, manual close, or liquidation).
                    // Clear all chart lines immediately so the user never sees
                    // stale TP/SL/Entry/PnL lines on a closed position.
                    var closedSym  = _selectedPosition.Symbol;
                    var closedSide = _selectedPosition.Side;
                    _selectedPosition  = null;
                    _activeSignal      = null;
                    _tpSlEditMode      = true;   // reset for next position
                    _lastTpSlSnapshot  = null;

                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            // Hide all position-related lines on the chart
                            await JS.InvokeVoidAsync("marketChart.hidePositionLines",
                                $"chartContainer-{_chartInstanceId}");
                            await JS.InvokeVoidAsync("marketChart.hideTpSlLines",
                                $"chartContainer-{_chartInstanceId}");
                        }
                        catch { /* JS cleanup is best-effort */ }

                        StateHasChanged();
                    });
                    return;
                }

                // Position still open — re-point reference to fresh instance.
                // No StateHasChanged here: TickAsync calls it after all tasks
                // complete, avoiding the double-render that caused panel flicker.
                _selectedPosition = refreshed;
            }
            else
            {
                // No position selected — check if chart has stale lines for
                // a symbol that no longer has an open position.
                if (!string.IsNullOrEmpty(_activeSym) &&
                    !_allPositions.Any(p => p.Symbol == _activeSym))
                {
                    try
                    {
                        await JS.InvokeVoidAsync("marketChart.hidePositionLines",
                            $"chartContainer-{_chartInstanceId}");
                        await JS.InvokeVoidAsync("marketChart.hideTpSlLines",
                            $"chartContainer-{_chartInstanceId}");
                    }
                    catch { }
                }
            }
            // StateHasChanged deferred to TickAsync which calls it
            // after all concurrent tasks complete — prevents double render.
        }
        catch { _lastPositionsFetchOk = false; }
        finally { _positionsLoading = false; _ooPanelNeedsAutoFit = true; InvalidateDisplayedPositionsCache(); TryResolvePendingPositionRestore(); }
    }

    // Selecting a row in the positions table shows its details in the
    // right-side panel — same ActivePositionInfo shape the order panel
    // already uses, just driven by a table click instead of a signal.
    ActivePositionInfo? _selectedPosition;
    ActivePositionInfo? _selectingPosition;

    async Task ClosePositionPanel()
    {
        _selectedPosition = null;
        _activeSignal = null;
        _orderPanelDismissed = true;
        _addToPositionOpen = false;
