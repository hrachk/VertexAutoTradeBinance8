@page "/market"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@using Binance.Net.Enums
@using VertexAutoTradeBinance8.Services
@inject MarketSnapshotFileService Service
@inject MissedTradeFileService SignalSvc
@inject BinanceClientFactory Factory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Market Intelligence — Vertex</PageTitle>

<div class="mk">

    <!-- HEADER -->
    <div class="mk-header">
        <div class="mk-title-block">
            <span class="mk-icon">📈</span>
            <div>
                <div class="mk-title">MARKET INTELLIGENCE</div>
                <div class="mk-sub">Candlestick · EMA · Bollinger · RSI · Volume</div>
            </div>
        </div>
        <div class="mk-hright">
            @if (Selected != null)
            {
                <div class="mk-ticker">
                    <span class="mk-tsym">@Selected.Symbol</span>
                    <span class="mk-ttf">@TfLabel(Selected.Timeframe)</span>
                    @if (_last > 0)
                    {
                        <span class="mk-tprice">@FmtP(_last)</span>
                        <span class="mk-tchg @(_chg >= 0 ? "up" : "dn")">
                            @(_chg >= 0 ? "▲" : "▼") @Math.Abs(_chg).ToString("F2")%
                        </span>
                    }
                </div>
            }
            <button class="mk-btn @(Frozen?"mk-btn-on":"")" @onclick="ToggleFreeze">
                @(Frozen ? "⏸ Paused" : "▶ Live")
            </button>
        </div>
    </div>

    <!-- ROW 1: SYMBOL TICKER -->
    <div class="mk-ticker-bar">
        <div class="mk-ticker-scroll">
            @foreach (var sym in _symbols)
            {
                var symSeries = Series.Where(s => s.Symbol == sym).ToList();
                var best = symSeries.OrderByDescending(s => s.Klines.Count).FirstOrDefault();
                var last  = best?.Klines.Count > 0 ? best.Klines[^1].Close : 0m;
                var first = best?.Klines.Count > 1 ? best.Klines[0].Close  : last;
                var chg   = first > 0 ? (last - first) / first * 100m : 0m;
                var isSel = sym == _activeSym;
                <button class="mk-tk @(isSel?"mk-tk-on":"")" @onclick="()=>PickSym(sym)">
                    <span class="mk-tk-sym">@sym</span>
                    @if (last > 0)
                    {
                        <span class="mk-tk-price">@FmtP(last)</span>
                        <span class="mk-tk-chg @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F1")%</span>
                    }
                </button>
            }
            @if (!Series.Any())
            {
                <span class="mk-dim" style="padding:0 16px;font-size:12px">No data — start the bot first</span>
            }
        </div>
    </div>

    <!-- ROW 2: TIMEFRAME SELECTOR (TradingView style) -->
    @if (!string.IsNullOrEmpty(_activeSym))
    {
        <div class="mk-tf-bar">
            @foreach (var tf in _allTfs)
            {
                var hasSeries = Series.Any(s => s.Symbol == _activeSym && s.Timeframe == tf.Key);
                var isSelTf   = _activeTf == tf.Key;
                <button class="mk-tf-btn @(isSelTf?"mk-tf-on":"") @(hasSeries?"":"mk-tf-dim")"
                        @onclick="()=>PickTf(tf.Key)">
                    @tf.Label
                </button>
            }
        </div>
    }

    @if (Selected == null || Selected.Klines.Count < 5)
    {
        <div class="mk-empty">
            <div style="font-size:48px">📊</div>
            <div style="font-size:16px;font-weight:600">Waiting for market data</div>
            <div class="mk-dim" style="font-size:13px">Bot writes klines_bootstrap.json on startup</div>
        </div>
    }
    else
    {
        <!-- STATS BAR -->
        <div class="mk-stats">
            <div class="mk-s"><div class="mk-sl">PRICE</div><div class="mk-sv">@FmtP(_last)</div></div>
            <div class="mk-s"><div class="mk-sl">OPEN</div><div class="mk-sv mk-dim">@FmtP(Selected.Klines[^1].Open)</div></div>
            <div class="mk-s"><div class="mk-sl">HIGH</div><div class="mk-sv up">@FmtP(Selected.Klines[^1].High)</div></div>
            <div class="mk-s"><div class="mk-sl">LOW</div><div class="mk-sv dn">@FmtP(Selected.Klines[^1].Low)</div></div>
            <div class="mk-s"><div class="mk-sl">CHANGE</div><div class="mk-sv @(_chg>=0?"up":"dn")">@(_chg>=0?"+":"")@_chg.ToString("F2")%</div></div>
            <div class="mk-s"><div class="mk-sl">EMA21</div><div class="mk-sv" style="color:#38bdf8">@FmtP(_ema21)</div></div>
            <div class="mk-s"><div class="mk-sl">EMA55</div><div class="mk-sv" style="color:#a855f7">@FmtP(_ema55)</div></div>
            <div class="mk-s"><div class="mk-sl">ATR</div><div class="mk-sv">@FmtP(_atr)</div></div>
            <div class="mk-s"><div class="mk-sl">RSI</div>
                <div class="mk-sv @(_rsi>=70?"dn":_rsi<=30?"up":"")">
                    @_rsi.ToString("F1") @(_rsi>=70?"OB":_rsi<=30?"OS":"")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">TREND</div>
                <div class="mk-sv @(_last>_ema21?"up":"dn")">
                    @(_last>_ema21?"▲ BULL":"▼ BEAR")
                </div>
            </div>
            <div class="mk-s"><div class="mk-sl">BARS</div><div class="mk-sv mk-dim">@Selected.Klines.Count</div></div>
            <div class="mk-s"><div class="mk-sl">VOLUME</div><div class="mk-sv mk-dim">@FmtV(Selected.Klines[^1].Volume)</div></div>
        </div>

        <!-- CHART AREA -->
        <div class="mk-charts-area">

            <!-- Price chart label -->
            <div class="mk-chart-head">
                <div class="mk-chart-title">CANDLESTICK · @Selected.Symbol · @TfLabel(Selected.Timeframe)</div>
                <div class="mk-legend">
                    <span style="color:#38bdf8">── EMA21</span>
                    <span style="color:#a855f7">── EMA55</span>
                    <span style="color:#eab308">╌╌ VWAP</span>
                    <span style="color:rgba(59,130,246,0.5)">╌╌ BB(20)</span>
                </div>
            </div>
            <div class="mk-canvas-wrap mk-canvas-price" id="priceWrap">
                <canvas id="priceChart" style="cursor:crosshair"></canvas>
                <div class="mk-resize-handle" id="resizeHandle"
                     title="Drag to resize · Ctrl+Wheel to zoom Y · Scroll to zoom X · Shift+Scroll to zoom price">
                    <div class="mk-resize-dots">⋯</div>
                </div>
            </div>

            <!-- RSI label -->
            <div class="mk-chart-head" style="padding-top:4px">
                <div class="mk-chart-title">RSI(14)</div>
                <div class="mk-legend">
                    <span style="color:#ef4444">── OB 70</span>
                    <span style="color:#22c55e">── OS 30</span>
                </div>
            </div>
            <div class="mk-canvas-wrap mk-canvas-rsi">
                <canvas id="rsiChart"></canvas>
            </div>

            <!-- Volume label -->
            <div class="mk-chart-head" style="padding-top:4px">
                <div class="mk-chart-title">VOLUME</div>
                <div class="mk-legend">
                    <span style="color:#38bdf8">● Spike ×2.2</span>
                </div>
            </div>
            <div class="mk-canvas-wrap mk-canvas-vol">
                <canvas id="volumeChart"></canvas>
            </div>

            <!-- Controls hint -->
            <div class="mk-hints">
                <span>🖱 Drag to pan</span>
                <span>⚲ Scroll to zoom X</span>
                <span>⇧+Scroll to zoom Y</span>
                <span>↕ Drag handle to resize</span>
                <span>2× click to reset</span>
            </div>

        </div>

        <!-- SIGNAL PANEL -->
        @if (_signals.Any())
        {
            <div class="sig-panel">
                <div class="sig-panel-head">
                    <div class="sig-panel-title">
                        <span class="sig-dot"></span>
                        LIVE SIGNALS
                        <span class="sig-count">@_signals.Count</span>
                    </div>
                    <div class="sig-panel-sub">Click a signal to trade manually</div>
                </div>
                <div class="sig-cards">
                    @foreach (var sig in _signals.Take(6))
                    {
                        bool isBuy = sig.Side?.ToUpper() == "BUY" || sig.Side?.ToUpper() == "LONG";
                        bool isActive = _activeSignal == sig;
                        decimal tp1 = sig.TakeProfits?.FirstOrDefault() ?? 0m;
                        decimal rr = sig.StopLoss > 0 && sig.Entry > 0 && tp1 > 0
                            ? Math.Abs(tp1 - sig.Entry) / Math.Abs(sig.StopLoss - sig.Entry)
                            : 0m;
                        int conf = sig.Confidence;

                        <div class="sig-card @(isBuy ? "sc-buy" : "sc-sell") @(isActive ? "sc-active" : "")"
                             @onclick="() => SelectSignal(sig)">
                            <!-- Card top -->
                            <div class="sc-top">
                                <div class="sc-sym-wrap">
                                    <span class="sc-sym">@sig.Symbol.Replace("USDT","")</span>
                                    <span class="sc-usdt">USDT</span>
                                </div>
                                <span class="sc-side @(isBuy ? "sc-side-b" : "sc-side-s")">
                                    @(isBuy ? "▲ LONG" : "▼ SHORT")
                                </span>
                            </div>
                            <!-- Confidence bar -->
                            <div class="sc-conf-wrap">
                                <div class="sc-conf-bar" style="width:@conf%"
                                     style2="background:@(conf>=60?"var(--grn)":conf>=45?"var(--yel)":"var(--red)")"></div>
                            </div>
                            <!-- Prices -->
                            <div class="sc-prices">
                                <div class="sc-p"><span class="sc-pl">Entry</span><span class="sc-pv mono">@FmtP(sig.Entry)</span></div>
                                <div class="sc-p"><span class="sc-pl">SL</span><span class="sc-pv mono dn">@FmtP(sig.StopLoss)</span></div>
                                @if (tp1 > 0) {
                                    <div class="sc-p"><span class="sc-pl">TP1</span><span class="sc-pv mono up">@FmtP(tp1)</span></div>
                                }
                            </div>
                            <!-- Footer -->
                            <div class="sc-foot">
                                <span class="sc-conf @(conf>=60?"up":conf>=45?"yel":"dn")">@conf%</span>
                                @if (rr > 0) { <span class="sc-rr">RR @rr.ToString("F1")</span> }
                                <span class="sc-atr mk-dim">ATR @FmtP(sig.ATR)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- TRADE ORDER PANEL (appears when signal selected) -->
        @if (_activeSignal != null)
        {
            bool isBuy = _activeSignal.Side?.ToUpper() == "BUY" || _activeSignal.Side?.ToUpper() == "LONG";
            decimal tp1 = _activeSignal.TakeProfits?.FirstOrDefault() ?? 0m;

            <div class="ord-panel">
                <div class="ord-head">
                    <div class="ord-title">
                        <span class="sc-side @(isBuy?"sc-side-b":"sc-side-s") ord-badge">
                            @(isBuy ? "▲ LONG" : "▼ SHORT")
                        </span>
                        <span class="ord-sym">@_activeSignal.Symbol</span>
                    </div>
                    <button class="ord-close-x" @onclick="()=>_activeSignal=null">✕</button>
                </div>

                <!-- Order type tabs -->
                <div class="ord-type-tabs">
                    <button class="ord-tt @(_orderType=="Market"?"ott-on":"")" @onclick='()=>_orderType="Market"'>
                        Market
                    </button>
                    <button class="ord-tt @(_orderType=="Limit"?"ott-on":"")" @onclick='()=>_orderType="Limit"'>
                        Limit
                    </button>
                    <button class="ord-tt @(_orderType=="StopLimit"?"ott-on":"")" @onclick='()=>_orderType="StopLimit"'>
                        Stop-Limit
                    </button>
                </div>

                <div class="ord-body">
                    <!-- Price row (hidden for Market) -->
                    @if (_orderType != "Market")
                    {
                        <div class="ord-row">
                            <label class="ord-label">@(_orderType == "StopLimit" ? "Stop Price" : "Limit Price")</label>
                            <div class="ord-input-wrap">
                                <input class="ord-input mono" type="number" step="any"
                                       @bind="_orderPrice" @bind:event="oninput" />
                                <span class="ord-input-sfx">USDT</span>
                            </div>
                        </div>
                        @if (_orderType == "StopLimit")
                        {
                            <div class="ord-row">
                                <label class="ord-label">Limit Price</label>
                                <div class="ord-input-wrap">
                                    <input class="ord-input mono" type="number" step="any"
                                           @bind="_limitPrice" @bind:event="oninput" />
                                    <span class="ord-input-sfx">USDT</span>
                                </div>
                            </div>
                        }
                    }

                    <!-- Quantity -->
                    <div class="ord-row">
                        <label class="ord-label">Quantity</label>
                        <div class="ord-input-wrap">
                            <input class="ord-input mono" type="number" step="any"
                                   @bind="_orderQty" @bind:event="oninput" />
                            <span class="ord-input-sfx">@_activeSignal.Symbol.Replace("USDT","")</span>
                        </div>
                    </div>

                    <!-- Signal levels reference -->
                    <div class="ord-levels">
                        <div class="ord-lev">
                            <span class="ord-lev-l">Signal Entry</span>
                            <span class="ord-lev-v mono" @onclick="()=>_orderPrice=_activeSignal.Entry" title="Click to use">
                                @FmtP(_activeSignal.Entry) <span class="ord-lev-use">↑</span>
                            </span>
                        </div>
                        @if (_activeSignal.StopLoss > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Stop Loss</span>
                                <span class="ord-lev-v mono dn">@FmtP(_activeSignal.StopLoss)</span>
                            </div>
                        }
                        @if (tp1 > 0)
                        {
                            <div class="ord-lev">
                                <span class="ord-lev-l">Take Profit</span>
                                <span class="ord-lev-v mono up">@FmtP(tp1)</span>
                            </div>
                        }
                    </div>

                    <!-- Error -->
                    @if (!string.IsNullOrEmpty(_orderError))
                    {
                        <div class="ord-error">⚠ @_orderError</div>
                    }
                    @if (!string.IsNullOrEmpty(_orderSuccess))
                    {
                        <div class="ord-ok">✓ @_orderSuccess</div>
                    }

                    <!-- Submit -->
                    <div class="ord-actions">
                        <button class="ord-cancel-btn" @onclick="()=>{_activeSignal=null;_orderError="";_orderSuccess="";}">Cancel</button>
                        <button class="ord-submit-btn @(isBuy?"osb-buy":"osb-sell")"
                                @onclick="PlaceManualOrder" disabled="@_orderLoading">
                            @if (_orderLoading) { <span class="ord-spin"></span> }
                            @(_orderType == "Market" ? (isBuy ? "Buy Market" : "Sell Market")
                                                     : (isBuy ? "Buy Limit" : "Sell Limit"))
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- SYMBOL TABLE -->
        <div class="mk-tbl-wrap">
            <div class="mk-tbl-title">ALL INSTRUMENTS</div>
            <div class="mk-tbl-scroll">
                <table class="mk-tbl">
                    <thead>
                        <tr>
                            <th>Symbol</th><th>TF</th><th>Price</th>
                            <th>Open</th><th>Change</th><th>High</th>
                            <th>Low</th><th>Volume</th><th>Bars</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Series)
                        {
                            var last = s.Klines.Count > 0 ? s.Klines[^1].Close : 0m;
                            var open = s.Klines.Count > 0 ? s.Klines[0].Close  : 0m;
                            var chg  = open > 0 ? (last - open) / open * 100m  : 0m;
                            <tr @onclick="()=>Pick(s)"
                                class="@(s==Selected?"mk-row-sel":"")">
                                <td class="mk-rsym">@s.Symbol</td>
                                <td><span class="mk-rtf">@TfLabel(s.Timeframe)</span></td>
                                <td class="mk-mono">@FmtP(last)</td>
                                <td class="mk-mono mk-dim">@FmtP(open)</td>
                                <td class="mk-mono @(chg>=0?"up":"dn")">@(chg>=0?"+":"")@chg.ToString("F2")%</td>
                                <td class="mk-mono up">@FmtP(s.Klines.Count>0?s.Klines[^1].High:0)</td>
                                <td class="mk-mono dn">@FmtP(s.Klines.Count>0?s.Klines[^1].Low:0)</td>
                                <td class="mk-mono mk-dim">@FmtV(s.Klines.Count>0?s.Klines[^1].Volume:0)</td>
                                <td class="mk-dim">@s.Klines.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
:root{--bg:#0a0d12;--bg2:#111520;--bg3:#1a1f2e;--bdr:#1e2535;--acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#eab308;--txt:#e2e8f0;--dim:#64748b;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt);}
.mk{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:48px;}
.up{color:var(--grn)!important;}.dn{color:var(--red)!important;}.mk-dim{color:var(--dim)!important;}

/* HEADER */
.mk-header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mk-title-block{display:flex;align-items:center;gap:14px;}
.mk-icon{font-size:28px;}
.mk-title{font-family:var(--mono);font-size:17px;font-weight:700;letter-spacing:2px;color:var(--acc);}
.mk-sub{font-size:11px;color:var(--dim);margin-top:3px;}
.mk-hright{display:flex;align-items:center;gap:16px;}
.mk-ticker{display:flex;align-items:center;gap:10px;}
.mk-tsym{font-family:var(--mono);font-size:18px;font-weight:700;color:var(--acc);}
.mk-ttf{font-size:11px;background:var(--bg3);border:1px solid var(--bdr);padding:2px 8px;border-radius:4px;color:var(--dim);}
.mk-tprice{font-family:var(--mono);font-size:20px;font-weight:700;}
.mk-tchg{font-family:var(--mono);font-size:14px;font-weight:600;}
.mk-btn{padding:6px 16px;border:1px solid var(--bdr);background:var(--bg3);color:var(--dim);border-radius:6px;cursor:pointer;font-size:12px;transition:all .2s;}
.mk-btn:hover{border-color:var(--acc);color:var(--txt);}
.mk-btn-on{background:rgba(239,68,68,.15);border-color:var(--red);color:var(--red);}

/* TF BAR */
.mk-tf-bar{display:flex;align-items:center;gap:2px;padding:6px 16px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mk-tf-btn{padding:4px 10px;background:transparent;border:none;color:var(--dim);font-family:var(--mono);font-size:12px;font-weight:600;cursor:pointer;border-radius:4px;transition:all .15s;}
.mk-tf-btn:hover{background:var(--bg3);color:var(--txt);}
.mk-tf-on{background:var(--acc)!important;color:#fff!important;}
.mk-tf-dim{opacity:.35;}
.mk-tf-dim:hover{opacity:.6;}
.mk-chips{display:flex;gap:6px;padding:10px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);overflow-x:auto;flex-wrap:wrap;}
.mk-chip{display:flex;align-items:center;gap:6px;padding:5px 12px;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;cursor:pointer;transition:all .15s;white-space:nowrap;}
.mk-chip:hover{border-color:var(--acc);}
.mk-chip-on{background:rgba(59,130,246,.12);border-color:var(--acc);}
.mk-chip-sym{font-family:var(--mono);font-size:12px;font-weight:700;}
.mk-chip-tf{font-size:10px;color:var(--dim);}
.mk-chip-chg{font-family:var(--mono);font-size:11px;font-weight:600;}

/* EMPTY */
.mk-empty{display:flex;flex-direction:column;align-items:center;gap:14px;padding:80px;color:var(--dim);text-align:center;}

/* STATS */
.mk-stats{display:grid;grid-template-columns:repeat(12,1fr);gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.mk-s{background:var(--bg2);padding:12px 16px;}
.mk-sl{font-size:10px;letter-spacing:1.5px;color:var(--dim);font-weight:600;}
.mk-sv{font-family:var(--mono);font-size:14px;font-weight:700;margin-top:4px;}

/* CHARTS */
.mk-charts-area{background:var(--bg2);padding:16px 20px;border-bottom:1px solid var(--bdr);}
.mk-chart-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.mk-chart-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;}
.mk-legend{display:flex;gap:14px;font-size:11px;color:var(--dim);}
/* TICKER BAR */
.mk-ticker-bar{background:var(--bg2);border-bottom:1px solid var(--bdr);overflow:hidden;}
.mk-ticker-scroll{display:flex;align-items:center;overflow-x:auto;scrollbar-width:none;padding:0 4px;}
.mk-ticker-scroll::-webkit-scrollbar{display:none;}
.mk-tk{display:inline-flex;align-items:center;gap:5px;padding:8px 14px;background:transparent;border:none;border-right:1px solid var(--bdr);cursor:pointer;transition:background .15s;white-space:nowrap;flex-shrink:0;}
.mk-tk:hover{background:var(--bg3);}
.mk-tk-on{background:rgba(59,130,246,.1);border-bottom:2px solid var(--acc);}
.mk-tk-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--txt);}
.mk-tk-sep{font-size:10px;color:var(--bdr);}
.mk-tk-tf{font-size:10px;color:var(--dim);}
.mk-tk-chg{font-family:var(--mono);font-size:11px;font-weight:600;}
.mk-tk-price{font-family:var(--mono);font-size:11px;color:var(--dim);}

/* CANVAS */
.mk-canvas-wrap{position:relative;background:#070a0f;border-radius:4px;margin-bottom:2px;overflow:hidden;}
.mk-canvas-wrap canvas{display:block;width:100%!important;height:100%!important;position:absolute;top:0;left:0;}
.mk-canvas-price{height:300px;}
.mk-canvas-rsi{height:90px;}
.mk-canvas-vol{height:90px;}

/* RESIZE HANDLE */
.mk-resize-handle{position:absolute;bottom:0;left:0;right:0;height:10px;cursor:ns-resize;display:flex;align-items:center;justify-content:center;background:rgba(30,37,53,0.5);transition:background .15s;z-index:10;user-select:none;}
.mk-resize-handle:hover{background:rgba(59,130,246,0.2);}
.mk-resize-dots{font-size:12px;color:var(--dim);letter-spacing:2px;line-height:1;}

/* SIGNAL PANEL */
.sig-panel{padding:16px 20px;border-bottom:1px solid var(--bdr);background:var(--bg2);}
.sig-panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.sig-panel-title{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:2px;color:var(--txt);}
.sig-dot{width:7px;height:7px;border-radius:50%;background:var(--grn);animation:pulse 1.5s infinite;}
@@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(34,197,94,.4);}50%{box-shadow:0 0 0 6px rgba(34,197,94,0);}}
.sig-count{background:var(--acc);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px;font-family:sans-serif;}
.sig-panel-sub{font-size:11px;color:var(--dim);}
.sig-cards{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin;}
.sig-cards::-webkit-scrollbar{height:3px;}
.sig-cards::-webkit-scrollbar-thumb{background:var(--bdr);}

/* Signal card */
.sig-card{flex-shrink:0;width:175px;background:var(--bg3);border:1px solid var(--bdr);border-radius:10px;padding:12px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;}
.sig-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;}
.sc-buy::before{background:var(--grn);}
.sc-sell::before{background:var(--red);}
.sig-card:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3);}
.sc-active{border-color:var(--acc)!important;background:rgba(59,130,246,.08)!important;}
.sc-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;}
.sc-sym-wrap{display:flex;flex-direction:column;}
.sc-sym{font-family:var(--mono);font-size:15px;font-weight:700;}
.sc-usdt{font-size:10px;color:var(--dim);}
.sc-side{font-size:10px;font-weight:700;padding:2px 6px;border-radius:3px;white-space:nowrap;}
.sc-side-b{background:rgba(34,197,94,.15);color:var(--grn);}
.sc-side-s{background:rgba(239,68,68,.15);color:var(--red);}
.sc-conf-wrap{height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;margin-bottom:10px;}
.sc-conf-bar{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--acc),var(--grn));}
.sc-prices{display:flex;flex-direction:column;gap:4px;margin-bottom:8px;}
.sc-p{display:flex;justify-content:space-between;align-items:center;}
.sc-pl{font-size:10px;color:var(--dim);}
.sc-pv{font-size:11px;}
.sc-foot{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.sc-conf{font-family:var(--mono);font-size:12px;font-weight:700;}
.sc-rr{font-size:10px;background:rgba(59,130,246,.12);color:var(--acc);padding:1px 5px;border-radius:3px;}
.sc-atr{font-size:10px;}
.yel{color:var(--yel)!important;}

/* ORDER PANEL */
.ord-panel{margin:0 20px 16px;background:var(--bg3);border:1px solid var(--bdr);border-radius:12px;overflow:hidden;}
.ord-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--bdr);background:var(--bg2);}
.ord-title{display:flex;align-items:center;gap:10px;}
.ord-badge{font-size:12px;}
.ord-sym{font-family:var(--mono);font-size:16px;font-weight:700;}
.ord-close-x{background:none;border:none;color:var(--dim);font-size:16px;cursor:pointer;width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.ord-close-x:hover{background:var(--bdr);color:var(--txt);}
.ord-type-tabs{display:flex;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.ord-tt{flex:1;background:none;border:none;color:var(--dim);padding:10px;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;border-bottom:2px solid transparent;}
.ord-tt:hover{color:var(--txt);}
.ott-on{color:var(--acc)!important;border-bottom-color:var(--acc)!important;}
.ord-body{padding:16px 18px;display:flex;flex-direction:column;gap:12px;}
.ord-row{display:flex;flex-direction:column;gap:5px;}
.ord-label{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-input-wrap{display:flex;align-items:center;background:var(--bg2);border:1px solid var(--bdr);border-radius:7px;overflow:hidden;transition:border-color .15s;}
.ord-input-wrap:focus-within{border-color:var(--acc);}
.ord-input{flex:1;background:transparent;border:none;color:var(--txt);padding:9px 12px;font-family:var(--mono);font-size:14px;outline:none;}
.ord-input-sfx{padding:0 12px;color:var(--dim);font-size:12px;border-left:1px solid var(--bdr);}
.ord-levels{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:10px 0;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);}
.ord-lev{display:flex;flex-direction:column;gap:3px;}
.ord-lev-l{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;}
.ord-lev-v{font-size:12px;cursor:pointer;transition:opacity .15s;}
.ord-lev-v:hover{opacity:.7;}
.ord-lev-use{font-size:9px;opacity:.5;}
.ord-error{padding:8px 12px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:6px;font-size:12px;color:var(--red);}
.ord-ok{padding:8px 12px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);border-radius:6px;font-size:12px;color:var(--grn);}
.ord-actions{display:flex;gap:8px;}
.ord-cancel-btn{flex:1;background:var(--bg2);border:1px solid var(--bdr);color:var(--dim);padding:10px;border-radius:7px;font-size:13px;cursor:pointer;transition:all .15s;}
.ord-cancel-btn:hover{color:var(--txt);border-color:var(--bdr);}
.ord-submit-btn{flex:2;border:none;padding:10px;border-radius:7px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.osb-buy{background:linear-gradient(135deg,#059669,#10b981);color:#fff;}
.osb-buy:hover{box-shadow:0 4px 16px rgba(16,185,129,.4);}
.osb-sell{background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;}
.osb-sell:hover{box-shadow:0 4px 16px rgba(239,68,68,.4);}
.ord-submit-btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;}
.ord-spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}

/* TABLE */
.mk-tbl-wrap{padding:20px 28px;}
.mk-tbl-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--bdr);}
.mk-tbl-scroll{overflow-x:auto;}
.mk-tbl{width:100%;border-collapse:collapse;}
.mk-tbl th{text-align:left;padding:7px 12px;font-size:10px;letter-spacing:1px;color:var(--dim);border-bottom:1px solid var(--bdr);white-space:nowrap;}
.mk-tbl td{padding:8px 12px;border-bottom:1px solid var(--bdr);}
.mk-tbl tr{cursor:pointer;transition:background .1s;}
.mk-tbl tr:hover td{background:var(--bg3);}
.mk-row-sel td{background:var(--bg3)!important;}
.mk-row-sel td:first-child{border-left:3px solid var(--acc);}
.mk-rsym{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--acc);}
.mk-rtf{background:var(--bg3);padding:2px 6px;border-radius:3px;font-size:10px;color:var(--dim);}
.mk-mono{font-family:var(--mono);font-size:12px;}

.mk-hints{display:flex;gap:16px;padding:8px 4px 0;font-size:11px;color:var(--dim);flex-wrap:wrap;}
@@media(max-width:1400px){.mk-stats{grid-template-columns:repeat(6,1fr);}}
@@media(max-width:900px){.mk-stats{grid-template-columns:repeat(3,1fr);}.mk-header{flex-direction:column;gap:12px;}}
</style>

@code {
    List<MarketSeries> Series = new();
    MarketSeries? Selected;

    // Symbol + TF selection
    string _activeSym = "";
    string _activeTf  = "";
    List<string> _symbols = new();

    // All standard TFs in TradingView order
    record TfDef(string Key, string Label);
    readonly List<TfDef> _allTfs = new()
    {
        new("OneMinute",      "1m"),
        new("ThreeMinutes",   "3m"),
        new("FiveMinutes",    "5m"),
        new("FifteenMinutes", "15m"),
        new("ThirtyMinutes",  "30m"),
        new("OneHour",        "1h"),
        new("TwoHour",        "2h"),
        new("FourHour",       "4h"),
        new("SixHour",        "6h"),
        new("TwelveHour",     "12h"),
        new("OneDay",         "1D"),
        new("ThreeDay",       "3D"),
        new("OneWeek",        "1W"),
    };
    PeriodicTimer? _timer;
    CancellationTokenSource _cts = new();
    bool Frozen, _jsReady;

    decimal _last, _chg, _ema21, _ema55, _atr;
    double _rsi;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = TickAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;

            // Даём браузеру завершить layout перед init canvas
            await Task.Delay(50);

            await JS.InvokeVoidAsync("marketChart.init",
                "priceChart", "rsiChart", "volumeChart",
                "resizeHandle", "priceWrap");

            // Ещё небольшая задержка чтобы ResizeObserver сработал
            await Task.Delay(80);
            await RenderCharts();
        }
        else if (_jsReady)
        {
            // Blazor может перерисовать DOM и затереть canvas —
            // переотрисовываем после каждого render
            await RenderCharts();
        }
    }

    async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                if (Frozen) continue;
                await LoadData();
                await InvokeAsync(StateHasChanged);
                await RenderCharts();
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task LoadData()
    {
        try
        {
            var fresh = await Service.LoadAsync();
            if (fresh == null || fresh.Count == 0) return;
            Series = fresh.ToList();

            // Load recent signals (last 24h, not blocked by exchange)
            try
            {
                var allSigs = await SignalSvc.LoadAsync();
                _signals = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= DateTime.UtcNow.AddHours(-24)
                                && s.Stage != "BLOCKED")
                    .OrderByDescending(s => s.Time)
                    .Take(12)
                    .ToList();
            }
            catch { }

            // Rebuild symbol list (unique, ordered by count)
            _symbols = Series
                .GroupBy(s => s.Symbol)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            // Select default symbol if none active
            if (string.IsNullOrEmpty(_activeSym) && _symbols.Any())
                _activeSym = _symbols[0];

            // Select default TF if none active
            if (string.IsNullOrEmpty(_activeTf))
                _activeTf = Series.FirstOrDefault(s => s.Symbol == _activeSym)?.Timeframe ?? "FiveMinutes";

            ResolveSelected();
            CalcStats();
        }
        catch { }
    }

    void ResolveSelected()
    {
        // Find series matching active symbol + TF
        var match = Series.FirstOrDefault(s =>
            s.Symbol == _activeSym && s.Timeframe == _activeTf);

        if (match != null)
        {
            Selected = match;
        }
        else if (!string.IsNullOrEmpty(_activeSym))
        {
            // Fallback: best available TF for this symbol
            Selected = Series
                .Where(s => s.Symbol == _activeSym)
                .OrderByDescending(s => s.Klines.Count)
                .FirstOrDefault();
            if (Selected != null) _activeTf = Selected.Timeframe;
        }
    }

    void PickSym(string sym)
    {
        _activeSym = sym;
        // Try to keep current TF, fallback to first available
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
    }

    void PickTf(string tf)
    {
        _activeTf = tf;
        ResolveSelected();
        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
    }

    void CalcStats()
    {
        if (Selected == null || Selected.Klines.Count < 2) return;
        var kl = Selected.Klines;
        _last = kl[^1].Close;
        var first = kl[0].Close;
        _chg = first > 0 ? (_last - first) / first * 100m : 0m;

        var closes = kl.Select(k => (double)k.Close).ToList();

        // EMA21 + EMA55
        if (closes.Count >= 21) _ema21 = (decimal)EmaLast(closes, 21);
        if (closes.Count >= 55) _ema55 = (decimal)EmaLast(closes, 55);

        // ATR14
        if (kl.Count >= 15)
        {
            decimal s = 0;
            for (int i = kl.Count - 14; i < kl.Count; i++)
            {
                var c = kl[i]; var p = kl[i-1];
                s += Math.Max(c.High - c.Low, Math.Max(Math.Abs(c.High - p.Close), Math.Abs(c.Low - p.Close)));
            }
            _atr = s / 14;
        }

        // RSI14
        if (closes.Count >= 15)
        {
            double ag = 0, al = 0;
            for (int i = 1; i <= 14; i++) { var d = closes[i] - closes[i-1]; if (d > 0) ag += d; else al -= d; }
            ag /= 14; al /= 14;
            for (int i = 15; i < closes.Count; i++) {
                var d = closes[i] - closes[i-1];
                ag = (ag * 13 + Math.Max(d, 0)) / 14;
                al = (al * 13 + Math.Max(-d, 0)) / 14;
            }
            _rsi = al == 0 ? 100 : 100 - 100 / (1 + ag / al);
        }
    }

    static double EmaLast(List<double> arr, int period)
    {
        double k = 2.0 / (period + 1);
        double v = arr.Take(period).Average();
        for (int i = period; i < arr.Count; i++) v = arr[i] * k + v * (1 - k);
        return v;
    }

    async Task RenderCharts()
    {
        if (!_jsReady || Selected == null || Selected.Klines.Count < 5) return;
        try
        {
            var klines = Selected.Klines.Select(k => new
            {
                openTime = k.OpenTime,
                open     = (double)k.Open,
                high     = (double)k.High,
                low      = (double)k.Low,
                close    = (double)k.Close,
                volume   = (double)k.Volume
            }).ToArray();

            await JS.InvokeVoidAsync("marketChart.render",
                Selected.Symbol, Selected.Timeframe, klines);
        }
        catch { }
    }

    void Pick(MarketSeries s)
    {
        _activeSym = s.Symbol;
        _activeTf  = s.Timeframe;
        Selected = s;
        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
    }

    void ToggleFreeze() => Frozen = !Frozen;

    string TfLabel(string tf) => tf switch
    {
        "OneMinute"      => "1m",
        "FiveMinutes"    => "5m",
        "FifteenMinutes" => "15m",
        "OneHour"        => "1h",
        "FourHour"       => "4h",
        "OneDay"         => "1D",
        _ => tf
    };

    string FmtP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1)    return v.ToString("F4");
        return v.ToString("G5");
    }

    string FmtV(decimal v)
    {
        if (v >= 1_000_000) return (v/1_000_000m).ToString("F1") + "M";
        if (v >= 1_000)     return (v/1_000m).ToString("F1") + "K";
        return v.ToString("F2");
    }

    // ── Signals ───────────────────────────────────────────────
    List<MissedTradeRecord> _signals = new();
    MissedTradeRecord? _activeSignal;
    string _orderType = "Market";
    decimal _orderPrice;
    decimal _limitPrice;
    decimal _orderQty;
    bool _orderLoading;
    string _orderError = string.Empty;
    string _orderSuccess = string.Empty;

    void SelectSignal(MissedTradeRecord sig)
    {
        _activeSignal = _activeSignal == sig ? null : sig;
        _orderPrice   = sig.Entry;
        _limitPrice   = sig.Entry;
        _orderQty     = 0;
        _orderError   = string.Empty;
        _orderSuccess = string.Empty;
        _orderType    = "Market";
    }

    async Task PlaceManualOrder()
    {
        if (_activeSignal == null) return;
        _orderError = string.Empty;
        _orderSuccess = string.Empty;

        if (_orderQty <= 0) { _orderError = "Enter quantity"; return; }
        if (_orderType != "Market" && _orderPrice <= 0) { _orderError = "Enter price"; return; }

        _orderLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { _orderError = "No API credentials configured"; return; }

            bool isBuy = _activeSignal.Side?.ToUpper() == "BUY" ||
                         _activeSignal.Side?.ToUpper() == "LONG";
            var side = isBuy ? OrderSide.Buy : OrderSide.Sell;

            // Get stepSize for rounding
            decimal step = 0.001m;
            try
            {
                using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                var ei = await client.UsdFuturesApi.ExchangeData.GetExchangeInfoAsync(cts2.Token);
                if (ei.Success)
                {
                    var sym = ei.Data.Symbols.FirstOrDefault(s => s.Name == _activeSignal.Symbol);
                    if (sym?.LotSizeFilter?.StepSize > 0) step = sym.LotSizeFilter.StepSize;
                }
            } catch { }

            decimal qty = Math.Floor(_orderQty / step) * step;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            long? placedOrderId = null;

            if (_orderType == "Market")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    _activeSignal.Symbol, side,
                    FuturesOrderType.Market, qty, ct: cts.Token);
                if (r.Success) placedOrderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else if (_orderType == "Limit")
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    _activeSignal.Symbol, side,
                    FuturesOrderType.Limit, qty,
                    price: _orderPrice,
                    timeInForce: TimeInForce.GoodTillCanceled,
                    ct: cts.Token);
                if (r.Success) placedOrderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }
            else
            {
                var r = await client.UsdFuturesApi.Trading.PlaceOrderAsync(
                    _activeSignal.Symbol, side,
                    FuturesOrderType.StopMarket, qty,
                    stopPrice: _orderPrice,
                    ct: cts.Token);
                if (r.Success) placedOrderId = r.Data?.Id;
                else { _orderError = $"Error {r.Error?.Code}: {r.Error?.Message}"; return; }
            }

            _orderSuccess = $"Order #{placedOrderId} placed · {_orderType} · {qty} {_activeSignal.Symbol.Replace("USDT", "")}";
            _activeSignal = null;
        }
        catch (Exception ex) { _orderError = ex.Message; }
        finally { _orderLoading = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        await Task.CompletedTask;
    }
}
