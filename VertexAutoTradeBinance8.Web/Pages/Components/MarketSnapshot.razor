    void OnQtyChange(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        _orderQty = _symStep > 0
            ? Math.Floor(v / _symStep) * _symStep
            : v;
    }

