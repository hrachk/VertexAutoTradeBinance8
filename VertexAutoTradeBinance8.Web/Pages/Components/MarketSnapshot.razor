    sealed class RealTradeRow
    {
        public string Symbol = "";
        public string Side = "";
        public decimal Price;
        public decimal Qty;
        public decimal RealizedPnl;
        public decimal Fee;
        public DateTime Time;
    }

    List<RealTradeRow> _realHistory = new();
    bool _realHistoryLoading;

    // Reuses the exact same GetUserTradesAsync pattern already
    // established in Positions.razor, rather than inventing a new
    // approach for this page. Symbol list comes from current open
    // positions plus the active symbol, since GetUserTradesAsync
    // requires a specific symbol per call (no account-wide "all
    // trades" endpoint) - this won't surface history for a symbol
    // that's been fully closed out and isn't currently open or
    // selected, which is an inherent limitation of the exchange API
    // itself, not something this page can work around.
    async Task LoadRealHistoryAsync()
    {
        if (_demoMode) return;
        _realHistoryLoading = true;
        StateHasChanged();
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) return;

            // Combine: open positions + active symbol + recently visible symbols
            // Previously only queried symbols with open positions — if no positions
            // were open, history was always empty. Now also includes the active
            // symbol and up to 10 symbols from the visible ticker list.
            var symbols = _allPositions.Select(p => p.Symbol)
                .Concat(string.IsNullOrEmpty(_activeSym) ? Array.Empty<string>() : new[] { _activeSym })
                .Concat(Series.Take(15).Select(m => m.Symbol))
                .Distinct().Take(20).ToList();

            var results = new List<RealTradeRow>();
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            foreach (var sym in symbols)
            {
                try
                {
                    var r = await client.UsdFuturesApi.Trading.GetUserTradesAsync(sym, limit: 20, ct: cts.Token);
                    if (!r.Success || r.Data == null) continue;
                    foreach (var t in r.Data)
                    {
                        if (t.RealizedPnl == 0) continue; // skip entry fills, only closing trades
                        results.Add(new RealTradeRow
                        {
                            Symbol = t.Symbol, Side = t.Buyer ? "BUY" : "SELL",
                            Price = t.Price, Qty = t.Quantity, RealizedPnl = t.RealizedPnl,
                            Fee = t.Fee, Time = t.Timestamp,
                        });
                    }
                }
                catch { }
            }
            _realHistory = results.OrderByDescending(t => t.Time).Take(100).ToList();
        }
        finally { _realHistoryLoading = false; StateHasChanged(); }
    }

    void OpenShareCardFromRealHistory(RealTradeRow t)
    {
        decimal roiPct = t.Price > 0 && t.Qty > 0 ? (t.RealizedPnl / (t.Price * t.Qty)) * 100m : 0m;
        OpenShareCard(t.Symbol, t.Side == "BUY" ? "LONG" : "SHORT", 1, roiPct, t.RealizedPnl, t.Price, t.Price, isOpen: false);
    }

