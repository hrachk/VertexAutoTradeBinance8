    // Opens (or refreshes) the Manual Trade panel for a symbol without the
    // toggle-to-close behavior SelectSignal has — used whenever we just want
    // the panel showing for whatever symbol is active, not for the explicit
    // "click a Live Signal card" gesture.
    void OpenManualPanelFor(string sym, decimal lastPrice)
