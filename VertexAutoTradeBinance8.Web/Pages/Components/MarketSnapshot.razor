@code {
    List<MarketSeries> Series = new();
    MarketSeries? Selected;

    // Symbol + TF selection
    string _activeSym = "";
    string _instrumentSearch = "";

    void OnInstrumentSearchChanged(ChangeEventArgs e) => _instrumentSearch = e.Value?.ToString() ?? "";
    void ClearInstrumentSearch() => _instrumentSearch = "";
    string _activeTf  = "";
    List<string> _symbols = new();

    // Puts the currently-active symbol first in the ticker bar display
    // order, without touching the underlying _symbols list itself
    // (which gets periodically rebuilt by the refresh timer and would
    // otherwise undo any direct reordering within a couple seconds).
    IEnumerable<string> OrderedTickerSymbols =>
        string.IsNullOrEmpty(_activeSym) || !_symbols.Contains(_activeSym)
            ? _symbols
            : new[] { _activeSym }.Concat(_symbols.Where(s => s != _activeSym));
    int _scanSymIdx = 0;

    // All standard TFs in TradingView order
    record TfDef(string Key, string Label);
    readonly List<TfDef> _allTfs = new()
    {
        new("OneMinute",      "1m"),
        new("ThreeMinutes",   "3m"),
        new("FiveMinutes",    "5m"),
        new("FifteenMinutes", "15m"),
        new("ThirtyMinutes",  "30m"),
        new("OneHour",        "1h"),
        new("TwoHour",        "2h"),
        new("FourHour",       "4h"),
        new("SixHour",        "6h"),
        new("TwelveHour",     "12h"),
        new("OneDay",         "1D"),
        new("ThreeDay",       "3D"),
        new("OneWeek",        "1W"),
    };
    PeriodicTimer? _timer;
    CancellationTokenSource _cts = new();
    bool Frozen, _jsReady;

    decimal _last, _chg, _ema21, _ema55, _atr;
    string? _archiveCacheKey;
    List<KlineDto> _archiveCache = new();
    DateTime _archiveCacheLoadedAt = DateTime.MinValue;
    SortedDictionary<long, (decimal Open, decimal High, decimal Low, decimal Close, decimal Volume, decimal? TakerBuy)>? _mergedKlines;
    string? _lastFullRenderCacheKey;
    double _rsi;

    protected override async Task OnInitializedAsync()
    {
        // Unique per-mount suffix for the chart canvas ids. If Blazor's
        // diffing ever decides this component instance is "the same" as
        // a previous mount and tries to reuse DOM nodes (which we now
        // suspect is happening, since the JS-side generationId never
        // advances past 1 even after navigating away and back), giving
        // the canvas a genuinely different id each time it's created
        // makes that reuse structurally impossible — the diffing
        // algorithm can't match elements with different ids.
        _chartInstanceId = Guid.NewGuid().ToString("N")[..8];

        LiveState.PriceTicked += OnLivePriceTicked;
        DemoAccount.Updated += OnDemoAccountUpdated;
        RefreshDemoSnapshot();
        LiveState.KlineClosed += OnLiveKlineClosed;

        await LoadData();
        _ = LoadOpenOrdersAsync();
        _ = LoadAllOpenPositionsAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = TickAsync();
        _ = ScanCycleAsync();
    }

    // ===== LIVE PUSH (from Engine via MarketDataHub) =====
    DateTime _lastLiveRender = DateTime.MinValue;
    bool _onTickBusy;
    static readonly TimeSpan LiveRenderThrottle = TimeSpan.FromMilliseconds(200);

    int _liveTickCount = 0;
    int _liveKlineCount = 0;
    string _lastTickSymbol = "";
    DateTime _lastTickTime = DateTime.MinValue;

    void ToggleDemoMode()
    {
        _demoMode = !_demoMode;
        // Per direct request: switching modes clears any in-progress
        // order panel/selection so there's no chance of a half-filled
        // form carrying over between the two accounts.
        _activeSignal = null;
        _selectedPosition = null;
        _manualSlPrice = 0;
        _manualTps.Clear();
        _orderError = "";
        _orderSuccess = "";
        RefreshDemoSnapshot();
        StateHasChanged();
    }

    void RefreshDemoSnapshot()
    {
        _demoSnapshot = DemoAccount.GetSnapshot();
        decimal total = 0m;
        foreach (var pos in _demoSnapshot.Positions)
        {
            var price = DemoAccount.GetLastPrice(pos.Symbol);
            if (price > 0) total += pos.UnrealizedPnl(price);
        }
        _demoUnrealizedTotal = total;
    }

    void OnDemoAccountUpdated()
    {
        RefreshDemoSnapshot();
        _ = InvokeAsync(StateHasChanged);
    }

    void OnLivePriceTicked(string symbol, decimal price)
    {
        _liveTickCount++;
        _lastTickSymbol = symbol;
        _lastTickTime = DateTime.UtcNow;

        if (_demoMode && _demoSnapshot.Positions.Any(p => p.Symbol == symbol))
        {
            decimal total = 0m;
            foreach (var pos in _demoSnapshot.Positions)
            {
                var p2 = pos.Symbol == symbol ? price : DemoAccount.GetLastPrice(pos.Symbol);
                if (p2 > 0) total += pos.UnrealizedPnl(p2);
            }
            _demoUnrealizedTotal = total;
        }

        if (_onTickBusy) return; // drop overlapping ticks rather than letting async chains queue up and race
        _onTickBusy = true;

        _ = InvokeAsync(async () =>
        {
            try
            {
            await InvokeAsync(StateHasChanged); // always show updated tick counter

            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == _activeTf);
            if (idx < 0 || Series[idx].Klines.Count == 0) return;

            var last = Series[idx].Klines[^1];
            var updated = last with
            {
                High = Math.Max(last.High, price),
                Low = Math.Min(last.Low, price),
                Close = price
            };

            var klines = Series[idx].Klines.ToList();
            klines[^1] = updated;
            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym) return; // only re-render the chart actually on screen

            // Live PnL caption — cheap (just an applyOptions call, not
            // a full chart redraw), so it updates on every tick rather
            // than waiting on the same throttle gate as the full
            // re-render below. This was very likely the actual reason
            // the PnL line never appeared in practice: between
            // throttled renders, it simply never got a chance to run.
            if (_selectedPosition != null && _selectedPosition.Symbol == symbol)
            {
                try { await JS.InvokeVoidAsync("marketChart.updatePnl", $"chartContainer-{_chartInstanceId}", price); } catch { }
            }

            var now = DateTime.UtcNow;
            if (now - _lastLiveRender < LiveRenderThrottle) return;
            _lastLiveRender = now;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }

            StateHasChanged();
            }
            finally { _onTickBusy = false; }
        });
    }

    void OnLiveKlineClosed(string symbol, string timeframe, KlineDto kline)
    {
        _liveKlineCount++;
        _ = InvokeAsync(async () =>
        {
            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == timeframe);
            if (idx < 0) return;

            var klines = Series[idx].Klines.ToList();
            if (klines.Count > 0 && klines[^1].OpenTime == kline.OpenTime)
                klines[^1] = kline;          // finalize the candle that was forming live
            else
                klines.Add(kline);           // new bar

            if (klines.Count > 500)
                klines.RemoveRange(0, klines.Count - 500);

            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym || timeframe != _activeTf) return;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }
            StateHasChanged();
        });
    }

    bool _chartInitDone;
    string _lastRenderedKey = "";

    string _chartInitError = "";
    string _chartInstanceId = "";
    bool _chartMaximized = false;
    bool _maxSymPickerOpen = false;

    void ToggleMaxSymPicker() => _maxSymPickerOpen = !_maxSymPickerOpen;

    void PickSymInMaximize(string sym)
    {
        PickSym(sym);
        _maxSymPickerOpen = false;
        _instrumentSearch = "";
    }

    async Task ToggleChartMaximized()
    {
        _chartMaximized = !_chartMaximized;
        StateHasChanged();
        // Give the browser a frame to apply the new CSS size before
        // asking Lightweight Charts to re-measure — autoSize's own
        // ResizeObserver normally catches this on its own, but a
        // deliberate nudge here avoids any one-frame flash of the old
        // size while the transition is mid-flight.
        await Task.Delay(50);
        try { await JS.InvokeVoidAsync("marketChart.clearWrapInlineHeight", $"chartContainer-{_chartInstanceId}"); } catch { }
        try { await JS.InvokeVoidAsync("marketChart.resize", $"chartContainer-{_chartInstanceId}"); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitChartAsync();

            // Restore the last symbol/timeframe the user was looking
            // at, if any was saved for this browser tab — avoids
            // always resetting to the default symbol on every page
            // load/navigation. Falls through silently to the existing
            // default selection if nothing was saved, or the saved
            // symbol no longer exists in the current universe (e.g.
            // it dropped out of Auto-selection).
            try
            {
                var savedSym = await JS.InvokeAsync<string?>("sessionStorage.getItem", "vertexMarketSym");
                var savedTf = await JS.InvokeAsync<string?>("sessionStorage.getItem", "vertexMarketTf");
                if (!string.IsNullOrEmpty(savedSym))
                {
                    var match = !string.IsNullOrEmpty(savedTf)
                        ? Series.FirstOrDefault(s => s.Symbol == savedSym && s.Timeframe == savedTf)
                        : null;
                    match ??= Series.FirstOrDefault(s => s.Symbol == savedSym);
                    if (match != null && (match.Symbol != _activeSym || match.Timeframe != _activeTf))
                    {
                        _activeSym = match.Symbol;
                        _activeTf = match.Timeframe;
                        ResolveSelected();
                        CalcStats();
                        StateHasChanged();
                        _ = RenderCharts();
                    }
                }
            }
            catch { /* sessionStorage unavailable or malformed — just keep the default selection */ }

            // Stack the sticky header chain (top-to-bottom order):
            // vertex-header + vertex-topnav live in MainLayout, outside
            // this component; the rest are this page's own elements.
            try
            {
                await JS.InvokeVoidAsync("stickyStack.init", new[]
                {
                    ".vertex-header",
                    ".vertex-topnav",
                    ".mk-sticky-top",
                    ".mk-ticker-bar",
                    ".mk-stats",
                });
            }
            catch { /* non-critical visual enhancement; page works without it */ }
        }

        // Render whenever chart is ready and data changed
        if (_chartInitDone && Selected != null && Selected.Klines.Count >= 5)
        {
            var lastK = Selected.Klines[^1];
            // Include last bar's OHLCV so live price ticks trigger a redraw,
            // not just when a brand new bar/candle count appears
            var key = $"{Selected.Symbol}:{Selected.Timeframe}:{Selected.Klines.Count}:{lastK.OpenTime}:{lastK.Close}:{lastK.High}:{lastK.Low}:{lastK.Volume}";
            if (key != _lastRenderedKey)
            {
                _lastRenderedKey = key;
                try { await RenderCharts(); } catch { }
            }
        }
    }

    // Initializes the chart. Lightweight Charts' own marketChart.init()
    // (JS side) disposes any previous chart instance bound to this
    // container id before creating a new one — so even in the worst
    // case (Blazor somehow calling this twice, or reusing a component
    // instance across navigation in a way that re-triggers firstRender),
    // there is never more than one live chart per container, and no
    // stale-reference bookkeeping is needed on this side at all.
    async Task InitChartAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var ok = await JS.InvokeAsync<bool>("marketChart.init", $"chartContainer-{_chartInstanceId}");
            if (ok)
            {
                await RegisterPricePickCallback();
                _chartInitDone = true;
                _jsReady = true;
                _chartInitError = "";
            }
            else
            {
                _chartInitError = "Chart container not found in DOM yet";
            }
        }
        catch (Exception ex)
        {
            _chartInitError = $"Chart init failed: {ex.Message}";
        }
        try { await JS.InvokeVoidAsync("tickerDragScroll.bind"); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                if (Frozen) continue;
                await LoadData();
                SweepExpiredSignals();
                if (_activeSignal != null)
                    await LoadCurrentPositionAsync(_activeSignal.Symbol);
                await LoadOpenOrdersAsync();
                await LoadAllOpenPositionsAsync();
                // StateHasChanged triggers OnAfterRenderAsync which calls
                // RenderCharts only when data actually changed
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // Cycles the "Analyzing SYMBOL..." text in the empty-signals scanning
    // animation, independent of the slower 5s data timer, so the panel
    // feels alive even when nothing else has changed.
    async Task ScanCycleAsync()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested)
            {
                await Task.Delay(1400, _cts.Token);
                if (!_signals.Any() && _symbols.Count > 0)
                {
                    _scanSymIdx = (_scanSymIdx + 1) % _symbols.Count;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    // Keep live-updated series unless the file snapshot has a strictly newer
    // closed candle (e.g. symbol the Engine isn't live-pushing, or cold state
    // right after a Web restart). Prevents the slower ~45s file snapshot from
    // reverting candles we've already live-updated via SignalR.
    static List<MarketSeries> MergeWithLive(List<MarketSeries> current, IReadOnlyList<MarketSeries> fresh)
    {
        var result = new List<MarketSeries>(fresh.Count);
        foreach (var f in fresh)
        {
            var existing = current.FirstOrDefault(s => s.Symbol == f.Symbol && s.Timeframe == f.Timeframe);
            if (existing == null || existing.Klines.Count == 0 || f.Klines.Count == 0)
            {
                result.Add(f);
                continue;
            }

            result.Add(f.Klines[^1].OpenTime > existing.Klines[^1].OpenTime ? f : existing);
        }
        return result;
    }

    async Task LoadData()
    {
        try
        {
            var fresh = await Service.LoadAsync();
            if (fresh == null || fresh.Count == 0) return;
            Series = MergeWithLive(Series, fresh);

            // Load recent signals (last 24h, not blocked by exchange)
            try
            {
                var allSigs = await SignalSvc.LoadAsync();
                _signals = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= DateTime.UtcNow.AddHours(-SignalLookbackHours)
                                && s.Stage != "BLOCKED"
                                && !_expiredSignals.ContainsKey(SignalKey(s))
                                && !GetSignalTtl(s).IsExpired)
                    .GroupBy(s => s.Symbol)
                    .Select(g => g.OrderByDescending(s => s.Time).First())
                    .OrderByDescending(s => s.Time)
                    .Take(12)
                    .ToList();
            }
            catch { }

            // Rebuild symbol list (unique, ordered by count)
            _symbols = Series
                .GroupBy(s => s.Symbol)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            // Select default symbol if none active
            if (string.IsNullOrEmpty(_activeSym) && _symbols.Any())
                _activeSym = _symbols[0];

            // Select default TF if none active
            if (string.IsNullOrEmpty(_activeTf))
                _activeTf = Series.FirstOrDefault(s => s.Symbol == _activeSym)?.Timeframe ?? "FiveMinutes";

            ResolveSelected();
            CalcStats();

            // Panel is visible by default for whatever symbol is active —
            // only stays hidden if the user explicitly dismissed it (✕),
            // OR if a position is currently selected (that has its own
            // distinct panel with its own TP/SL chart lines — this check
            // must not silently reopen Manual Trade on top of it on every
            // periodic tick, which is exactly what was happening before:
            // _selectedPosition has _activeSignal == null by design, so
            // without this it looked indistinguishable from "nothing
            // selected" to this check).
            if (_activeSignal == null && _selectedPosition == null && !_orderPanelDismissed && !string.IsNullOrEmpty(_activeSym) && _last > 0)
                OpenManualPanelFor(_activeSym, _last);
        }
        catch { }
    }

    void ResolveSelected()
    {
        // Find series matching active symbol + TF
        var match = Series.FirstOrDefault(s =>
            s.Symbol == _activeSym && s.Timeframe == _activeTf);

        if (match != null)
        {
            Selected = match;
        }
        else if (!string.IsNullOrEmpty(_activeSym))
        {
            // Fallback: best available TF for this symbol
            Selected = Series
                .Where(s => s.Symbol == _activeSym)
                .OrderByDescending(s => s.Klines.Count)
                .FirstOrDefault();
            if (Selected != null) _activeTf = Selected.Timeframe;
        }
    }

    void PickSym(string sym)
    {
        _activeSym = sym;
        // Try to keep current TF, fallback to first available
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();

        // Per direct request: show the position panel for THIS symbol
        // whenever it has an open position, regardless of whether the
        // user got here by clicking the positions table row or just
        // picking the symbol from the ticker/search/anywhere else.
        var existingPos = _allPositions.FirstOrDefault(p => p.Symbol == sym);
        if (existingPos != null)
        {
            _selectedPosition = existingPos;
            _activeSignal = null;
            _ = RefreshPositionLines();
        }
        else if (_selectedPosition?.Symbol != sym)
        {
            // Switched to a symbol with no position — clear any
            // stale position panel left over from the previous symbol.
            _selectedPosition = null;
            _ = JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}");
        }

        StateHasChanged();
        _ = RenderCharts();
        _ = JS.InvokeVoidAsync("stickyStack.recalc");
        _ = SaveSelectionState();
    }

    // Persists the current symbol+timeframe to sessionStorage so it
    // survives navigating away and back (or refreshing) within the same
    // browser tab — cleared automatically when the tab closes, so this
    // is a "remember where I was" convenience, not a permanent setting.
    async Task SaveSelectionState()
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "vertexMarketSym", _activeSym);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "vertexMarketTf", _activeTf);
        }
        catch { }
    }

