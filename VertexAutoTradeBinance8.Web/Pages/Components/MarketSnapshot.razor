    async Task ReplaceProtectiveOrderAsync(ActivePositionInfo pos, bool isStopLoss, decimal newPrice, int? tpIndex = null)
    {
        _slTpDragBusy = true;
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null) { return; }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));

            // Round to the symbol's tick size if known, otherwise leave
            // as-is — better to place a slightly-off-tick order than to
            // silently snap to a wrong precision.
            decimal price = _symTickSize > 0 ? Math.Round(newPrice / _symTickSize) * _symTickSize : newPrice;

            bool isLong = pos.Side == "LONG";
            var closeSide = isLong ? OrderSide.Sell : OrderSide.Buy;
            var posSide = isLong ? PositionSide.Long : PositionSide.Short;

            // Find and cancel the existing protective order of the same
            // kind for this symbol AND position side — critical in
            // hedge mode, where the same symbol can have simultaneous
            // LONG and SHORT positions each with their own SL/TP.
            // Without this, dragging a line on one position could
            // cancel and replace the OTHER position's protective order
            // instead — a real financial risk, not just a display bug.
            bool MatchesThisPosition(OpenOrderRow o) =>
                o.Symbol == pos.Symbol &&
                (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side);

            OpenOrderRow? existing;
            if (!isStopLoss && tpIndex.HasValue)
            {
                var tpOrders = _openOrders
                    .Where(o => MatchesThisPosition(o) && o.Type.Contains("TAKE_PROFIT"))
                    .OrderBy(o => pos.Side == "LONG" ? o.Price : -o.Price)
                    .ToList();
                existing = tpIndex.Value >= 0 && tpIndex.Value < tpOrders.Count ? tpOrders[tpIndex.Value] : null;
            }
            else
            {
                existing = _openOrders.FirstOrDefault(o =>
                    MatchesThisPosition(o) &&
                    (isStopLoss ? o.Type.Contains("STOP") : o.Type.Contains("TAKE_PROFIT")));
            }

            if (existing != null)
            {
                if (existing.IsAlgo)
                    await CancelAlgoOrderRawAsync(pos.Symbol, existing.OrderId);
                else
                    await client.UsdFuturesApi.Trading.CancelOrderAsync(pos.Symbol, existing.OrderId, ct: cts.Token);
            }

            // Same conditional-order pattern the Engine itself uses for
            // placing SL/TP (see PositionSupervisorService.cs) — trigger
            // price against the Mark price, with price protection
            // enabled, rather than a plain stop order.
            var clientOrderId = $"MANUAL_{(isStopLoss ? "SL" : "TP")}_{pos.Symbol}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            var r = await client.UsdFuturesApi.Trading.PlaceConditionalOrderAsync(
                symbol: pos.Symbol,
                side: closeSide,
                type: isStopLoss ? ConditionalOrderType.StopMarket : ConditionalOrderType.TakeProfitMarket,
                quantity: pos.Qty,
                positionSide: posSide,
                triggerPrice: price,
                workingType: WorkingType.Mark,
                clientOrderId: clientOrderId,
                priceProtect: true,
                ct: cts.Token);

            if (!r.Success)
            {
                // Surface the failure where the order-panel error
                // message already shows up, rather than failing silently.
                _orderError = $"{(isStopLoss ? "SL" : "TP")} update failed: {r.Error?.Message}";
            }

            await LoadOpenOrdersAsync();
            await RefreshPositionLines();
        }
        catch (Exception ex)
        {
            _orderError = $"{(isStopLoss ? "SL" : "TP")} update failed: {ex.Message}";
        }
        finally
        {
            _slTpDragBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Break-even price — the level where closing now would net exactly
    // zero, accounting for the round-trip taker fee (0.05% each way,
    // Binance's own standard taker rate) on top of just the entry
    // price. A position needs to move past entry by enough to cover
    // BOTH the entry and exit fees before it's genuinely break-even,
    // not merely back at the price it was opened at.
    const decimal TakerFeeRate = 0.0005m;
    decimal ComputeBreakEvenPrice(ActivePositionInfo pos)
    {
        if (pos.EntryPrice <= 0) return 0m;
        decimal feeAdjustment = pos.EntryPrice * TakerFeeRate * 2m;
        return pos.Side == "LONG" ? pos.EntryPrice + feeAdjustment : pos.EntryPrice - feeAdjustment;
    }

    // Re-draws the entry/SL/TP lines on the chart from the currently
    // selected position's matching open orders, after any change.
    async Task RefreshPositionLines()
    {
        if (_selectedPosition == null)
        {
            try { await JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}"); } catch { }
            _tpSlEditMode = false;
            return;
        }

        var pos = _selectedPosition;
        decimal breakEven = ComputeBreakEvenPrice(pos);
        try
        {
            await JS.InvokeVoidAsync("marketChart.showPositionLines",
                $"chartContainer-{_chartInstanceId}", pos.EntryPrice, pos.Side, pos.Qty, pos.LiqPrice, breakEven);
        }
        catch { }

        // If TP/SL editing was already open (e.g. after a drag just
        // replaced an order), keep it open and refresh the lines to
        // reflect the new state rather than closing it.
        if (_tpSlEditMode)
        {
            await ShowTpSlLinesAsync();
        }
    }

    // Matches Binance's actual interaction: the entry/PnL line is
    // always shown once a position is selected, but the SL/TP lines
    // only appear after the user explicitly clicks the "TP/SL" toggle
    // — they are not drawn automatically just from selecting a position.
    bool _tpSlEditMode;

    async Task ToggleTpSlEdit()
    {
        _tpSlEditMode = !_tpSlEditMode;
        if (_tpSlEditMode)
        {
