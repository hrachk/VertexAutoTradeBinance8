@@media(max-width:900px){.mk-stats{grid-template-columns:repeat(3,1fr);}.mk-header{flex-direction:column;gap:12px;}}
</style>

@code {
    List<MarketSeries> Series = new();
    MarketSeries? Selected;

    // Symbol + TF selection
    string _activeSym = "";
    string _activeTf  = "";
    List<string> _symbols = new();

    // All standard TFs in TradingView order
    record TfDef(string Key, string Label);
    readonly List<TfDef> _allTfs = new()
    {
        new("OneMinute",      "1m"),
        new("ThreeMinutes",   "3m"),
        new("FiveMinutes",    "5m"),
        new("FifteenMinutes", "15m"),
        new("ThirtyMinutes",  "30m"),
        new("OneHour",        "1h"),
        new("TwoHour",        "2h"),
        new("FourHour",       "4h"),
        new("SixHour",        "6h"),
        new("TwelveHour",     "12h"),
        new("OneDay",         "1D"),
        new("ThreeDay",       "3D"),
        new("OneWeek",        "1W"),
    };
    PeriodicTimer? _timer;
    CancellationTokenSource _cts = new();
    bool Frozen, _jsReady;

    decimal _last, _chg, _ema21, _ema55, _atr;
    double _rsi;

    protected override async Task OnInitializedAsync()
    {
        LiveState.PriceTicked += OnLivePriceTicked;
        LiveState.KlineClosed += OnLiveKlineClosed;

        await LoadData();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = TickAsync();
    }

    // ===== LIVE PUSH (from Engine via MarketDataHub) =====
    DateTime _lastLiveRender = DateTime.MinValue;
    static readonly TimeSpan LiveRenderThrottle = TimeSpan.FromMilliseconds(200);

    int _liveTickCount = 0;
    int _liveKlineCount = 0;
    string _lastTickSymbol = "";
    DateTime _lastTickTime = DateTime.MinValue;

    void OnLivePriceTicked(string symbol, decimal price)
    {
        _liveTickCount++;
        _lastTickSymbol = symbol;
        _lastTickTime = DateTime.UtcNow;

        _ = InvokeAsync(async () =>
        {
            await InvokeAsync(StateHasChanged); // always show updated tick counter

            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == _activeTf);
            if (idx < 0 || Series[idx].Klines.Count == 0) return;

            var last = Series[idx].Klines[^1];
            var updated = last with
            {
                High = Math.Max(last.High, price),
                Low = Math.Min(last.Low, price),
                Close = price
            };

            var klines = Series[idx].Klines.ToList();
            klines[^1] = updated;
            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym) return; // only re-render the chart actually on screen

            var now = DateTime.UtcNow;
            if (now - _lastLiveRender < LiveRenderThrottle) return;
            _lastLiveRender = now;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }
            StateHasChanged();
        });
    }

    void OnLiveKlineClosed(string symbol, string timeframe, KlineDto kline)
    {
        _liveKlineCount++;
        _ = InvokeAsync(async () =>
        {
            var idx = Series.FindIndex(s => s.Symbol == symbol && s.Timeframe == timeframe);
            if (idx < 0) return;

            var klines = Series[idx].Klines.ToList();
            if (klines.Count > 0 && klines[^1].OpenTime == kline.OpenTime)
                klines[^1] = kline;          // finalize the candle that was forming live
            else
                klines.Add(kline);           // new bar

            if (klines.Count > 500)
                klines.RemoveRange(0, klines.Count - 500);

            Series[idx] = Series[idx] with { Klines = klines };

            if (symbol != _activeSym || timeframe != _activeTf) return;

            ResolveSelected();
            CalcStats();
            try { await RenderCharts(); } catch { }
            StateHasChanged();
        });
    }

    bool _chartInitDone;
    string _lastRenderedKey = "";

    string _chartInitError = "";
    int _initAttempts = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = InitChartWithRetry();
        }

        // Render whenever chart is ready and data changed
        if (_chartInitDone && Selected != null && Selected.Klines.Count >= 5)
        {
            var lastK = Selected.Klines[^1];
            // Include last bar's OHLCV so live price ticks trigger a redraw,
            // not just when a brand new bar/candle count appears
            var key = $"{Selected.Symbol}:{Selected.Timeframe}:{Selected.Klines.Count}:{lastK.OpenTime}:{lastK.Close}:{lastK.High}:{lastK.Low}:{lastK.Volume}";
            if (key != _lastRenderedKey)
            {
                _lastRenderedKey = key;
                try { await RenderCharts(); } catch { }
            }
        }
    }

    async Task InitChartWithRetry()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);

        for (int i = 0; i < 20; i++) // up to 20 × 150ms = 3s
        {
            _initAttempts = i + 1;
            try
            {
                // Ask JS if the canvas element actually exists with real size
                var ok = await JS.InvokeAsync<bool>("marketChart.elementReady", "priceChart");
                if (ok)
                {
                    await JS.InvokeVoidAsync("marketChart.init",
                        "priceChart", "rsiChart", "volumeChart",
                        "resizeHandle", "priceWrap");
                    await RegisterPricePickCallback();
                    _chartInitDone = true;
                    _jsReady = true;
                    _chartInitError = "";
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            catch (Exception ex)
            {
                _chartInitError = $"Init attempt {i+1} failed: {ex.Message}";
            }
            await Task.Delay(150);
        }

        // Failed after all retries — force init anyway and surface the error
        try
        {
            await JS.InvokeVoidAsync("marketChart.init",
                "priceChart", "rsiChart", "volumeChart",
                "resizeHandle", "priceWrap");
            await RegisterPricePickCallback();
            _chartInitDone = true;
            _jsReady = true;
        }
        catch (Exception ex)
        {
            _chartInitError = $"Chart init failed after {_initAttempts} attempts: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                if (Frozen) continue;
                await LoadData();
                SweepExpiredSignals();
                // StateHasChanged triggers OnAfterRenderAsync which calls
                // RenderCharts only when data actually changed
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // Keep live-updated series unless the file snapshot has a strictly newer
    // closed candle (e.g. symbol the Engine isn't live-pushing, or cold state
    // right after a Web restart). Prevents the slower ~45s file snapshot from
    // reverting candles we've already live-updated via SignalR.
    static List<MarketSeries> MergeWithLive(List<MarketSeries> current, IReadOnlyList<MarketSeries> fresh)
    {
        var result = new List<MarketSeries>(fresh.Count);
        foreach (var f in fresh)
        {
            var existing = current.FirstOrDefault(s => s.Symbol == f.Symbol && s.Timeframe == f.Timeframe);
            if (existing == null || existing.Klines.Count == 0 || f.Klines.Count == 0)
            {
                result.Add(f);
                continue;
            }

            result.Add(f.Klines[^1].OpenTime > existing.Klines[^1].OpenTime ? f : existing);
        }
        return result;
    }

    async Task LoadData()
    {
        try
        {
            var fresh = await Service.LoadAsync();
            if (fresh == null || fresh.Count == 0) return;
            Series = MergeWithLive(Series, fresh);

            // Load recent signals (last 24h, not blocked by exchange)
            try
            {
                var allSigs = await SignalSvc.LoadAsync();
                _signals = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= DateTime.UtcNow.AddHours(-SignalLookbackHours)
                                && s.Stage != "BLOCKED"
                                && !_expiredSignals.ContainsKey(SignalKey(s))
                                && !GetSignalTtl(s).IsExpired)
                    .GroupBy(s => s.Symbol)
                    .Select(g => g.OrderByDescending(s => s.Time).First())
                    .OrderByDescending(s => s.Time)
                    .Take(12)
                    .ToList();
            }
            catch { }

            // Rebuild symbol list (unique, ordered by count)
            _symbols = Series
                .GroupBy(s => s.Symbol)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            // Select default symbol if none active
            if (string.IsNullOrEmpty(_activeSym) && _symbols.Any())
                _activeSym = _symbols[0];

            // Select default TF if none active
            if (string.IsNullOrEmpty(_activeTf))
                _activeTf = Series.FirstOrDefault(s => s.Symbol == _activeSym)?.Timeframe ?? "FiveMinutes";

            ResolveSelected();
            CalcStats();
        }
        catch { }
    }

    void ResolveSelected()
    {
        // Find series matching active symbol + TF
        var match = Series.FirstOrDefault(s =>
            s.Symbol == _activeSym && s.Timeframe == _activeTf);

        if (match != null)
        {
            Selected = match;
        }
        else if (!string.IsNullOrEmpty(_activeSym))
        {
            // Fallback: best available TF for this symbol
            Selected = Series
                .Where(s => s.Symbol == _activeSym)
                .OrderByDescending(s => s.Klines.Count)
                .FirstOrDefault();
            if (Selected != null) _activeTf = Selected.Timeframe;
        }
    }

    void PickSym(string sym)
    {
        _activeSym = sym;
        // Try to keep current TF, fallback to first available
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        StateHasChanged();
        _ = RenderCharts();
    }

