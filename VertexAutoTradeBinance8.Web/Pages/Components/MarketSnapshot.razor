    // Relevance / TTL of a signal, derived from its volatility (ATR) rather than a fixed duration.
    // Higher ATR relative to entry price => market moving faster => signal goes stale sooner.
    record SignalTtlInfo(double Pct, string Label, bool IsExpiring, bool IsExpired);

    // Mirrors StrategyEngine.GetDynamicMinRr's threshold logic exactly
    // (same regime/slope/volatility checks, same numbers) so the
    // "Low RR" badge reflects the strategy's REAL bar, not a guessed
    // one. Deliberately omits the AI-trend-prediction adjustment that
    // method also has (that needs live model state not available on
    // the Web side) — this is the static, regime-based floor before
    // any further tightening the live engine might also apply, so the
    // badge is a conservative "at least this strict" indicator.
    decimal GetDynamicMinRrForDisplay(MissedTradeRecord sig)
    {
        decimal atrPct = sig.Entry > 0 ? sig.ATR / sig.Entry : 0m;

        var regime = sig.Regime;
        var smartType = sig.SmartType;
        var vol = sig.Vol;
        var slope = sig.Slope;

        bool isSqueeze = regime == VertexAutoTradeBinance8.Models.MarketRegime.Range
            || smartType == "SmartSqueeze";

        bool isStrongTrendLike =
            regime == VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend ||
            regime == VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend ||
            smartType == "SmartStrongTrend";

        bool strongSlope = Math.Abs(slope) >= 0.02m;
        bool highVol = vol >= 0.015m || atrPct >= 0.015m;
        bool lowVol  = vol <= 0.005m || atrPct <= 0.005m;

        if (isSqueeze) return 2.5m;
        if (isStrongTrendLike && strongSlope) return highVol ? 1.7m : 1.8m;
        return lowVol ? 2.2m : 2.0m;
    }

    // SimulatedTradeService (which produces these "Live Signals") does
    // NOT apply the real MinEntry confidence filter — it shows every
    // signal the strategy saw, for visibility, even ones the bot would
    // never actually act on. This resolves the real per-symbol
    // threshold and the regime-based minimum RR, so both the warning
    // badges AND the TTL (signals flagged here should disappear
    // faster — they were never going to be traded) use the exact same
    // definition of "weak".
    (bool belowThreshold, bool lowRr, decimal minRr) IsWeakSignal(MissedTradeRecord sig, int conf, decimal rr)
    {
        var confProfile = ConfidenceResolver.Resolve(sig.Symbol);
        bool belowThreshold = (conf / 100m) < confProfile.MinEntry;

        decimal minRr = GetDynamicMinRrForDisplay(sig);
        bool lowRr = rr > 0 && rr < minRr;

        return (belowThreshold, lowRr, minRr);
    }

    SignalTtlInfo GetSignalTtl(MissedTradeRecord sig)
    {
        var ageMin = (DateTime.UtcNow - sig.Time.ToUniversalTime()).TotalMinutes;
        if (ageMin < 0) ageMin = 0;

        // Relative volatility: ATR as a fraction of entry price.
        decimal relAtr = sig.Entry > 0 ? sig.ATR / sig.Entry : 0.003m;
        if (relAtr <= 0) relAtr = 0.003m;

        // More volatile symbols invalidate faster; calmer symbols stay relevant longer.
        // Tuned so a "typical" ~0.3% ATR signal lives ~40 min, scaling inversely with volatility.
        double lifeMinutes = (double)(0.12m / relAtr);
        lifeMinutes = Math.Clamp(lifeMinutes, 10, 150);

        // Per direct request: a signal the bot would never actually
        // trade (below the real confidence threshold, or RR weaker
        // than the regime requires) shouldn't linger on screen as long
        // as a genuinely tradeable one — cap its max lifetime much
        // lower, regardless of how calm the symbol's volatility is.
        decimal sigTp1 = sig.TakeProfits?.FirstOrDefault() ?? 0m;
        decimal rr = sig.StopLoss > 0 && sig.Entry > 0 && sigTp1 > 0
            ? Math.Abs(sigTp1 - sig.Entry) / Math.Abs(sig.StopLoss - sig.Entry)
            : 0m;
        var (belowThreshold, lowRr, _) = IsWeakSignal(sig, sig.Confidence, rr);
        if (belowThreshold || lowRr)
            lifeMinutes = Math.Min(lifeMinutes, 8);

        double remaining = lifeMinutes - ageMin;
        double pct = Math.Clamp(remaining / lifeMinutes * 100.0, 0, 100);

        bool isExpired  = remaining <= 0;
        bool isExpiring = remaining > 0 && remaining <= lifeMinutes * 0.15;

        string label = isExpired
            ? "expired"
            : remaining >= 60
                ? $"~{(remaining / 60).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}h left"
                : $"~{Math.Max(1, (int)remaining)}m left";

        return new SignalTtlInfo(pct, label, isExpiring || isExpired, isExpired);
    }

    string FmtAgo(DateTime t)
    {
        var span = DateTime.UtcNow - t.ToUniversalTime();
        if (span.TotalMinutes < 1)  return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24)   return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    // Called on every 5s tick: marks fully-expired signals so they fade out,
    // then removes them a moment later once the fade transition has played.
    // Dismissed keys are kept (not cleared) so a concurrent/later LoadData()
    // can never bring the same signal back at full opacity.
    void SweepExpiredSignals()
    {
        // Anything this old can never reappear from LoadData() anyway
        // (same lookback window), so it's safe to forget.
        var cutoff = DateTime.UtcNow.AddHours(-SignalLookbackHours);
        foreach (var k in _expiredSignals.Where(kv => kv.Value < cutoff).Select(kv => kv.Key).ToList())
        {
            _expiredSignals.Remove(k);
        }

        var nowExpired = _signals.Where(s => GetSignalTtl(s).IsExpired).ToList();
        var newlyMarked = nowExpired.Where(s => !_expiredSignals.ContainsKey(SignalKey(s))).ToList();

        if (newlyMarked.Count == 0) return;

        // Mark immediately, not just after the fade delay below — otherwise
        // a LoadData() that lands mid-fade would still re-add the signal.
        foreach (var s in newlyMarked)
        {
            _expiredSignals[SignalKey(s)] = s.Time;
        }

        var keysToRemove = newlyMarked.Select(SignalKey).ToHashSet();

        // Give the CSS fade-out transition a moment to play, then drop them
        // from the live list entirely.
        _ = Task.Run(async () =>
        {
            await Task.Delay(900);
            _signals = _signals.Where(s => !keysToRemove.Contains(SignalKey(s))).ToList();
            _sigPage = Math.Clamp(_sigPage, 0, _sigPageCount - 1);
            await InvokeAsync(StateHasChanged);
        });
    }

