    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitChartAsync();
            // Give Blazor one render cycle to add _chartInitDone=true
            // elements to the DOM, then init draggable UI elements.
            StateHasChanged();
            await Task.Delay(80);
            await InitDraggableElementsAsync();

            // Restore the full page state the user was last looking
            // at (symbol/timeframe, demo mode, active tab, selected
            // position, maximized state), if any was saved for this
            // browser tab — avoids resetting to defaults on every
            // page load/navigation, per direct request to remember
            // everything the user did on the page. Falls through
            // silently to the existing default selection if nothing
            // was saved, or anything no longer resolves (e.g. the
            // saved symbol dropped out of Auto-selection, or the
            // saved position has since closed).
            try
            {
                var savedJson = await JS.InvokeAsync<string?>("localStorage.getItem", "vertexMarketState");
                if (!string.IsNullOrEmpty(savedJson))
                {
                    var saved = System.Text.Json.JsonSerializer.Deserialize<SavedMarketState>(savedJson);
                    if (saved != null)
                    {
                        _demoMode = saved.demoMode;
                        if (!string.IsNullOrEmpty(saved.ooTab)) _ooActiveTab = saved.ooTab;
                        _chartMaximized = saved.chartMaximized;

                        if (!string.IsNullOrEmpty(saved.sym))
                        {
                            var match = !string.IsNullOrEmpty(saved.tf)
                                ? Series.FirstOrDefault(s => s.Symbol == saved.sym && s.Timeframe == saved.tf)
                                : null;
                            match ??= Series.FirstOrDefault(s => s.Symbol == saved.sym);
                            if (match != null && (match.Symbol != _activeSym || match.Timeframe != _activeTf))
                            {
                                _activeSym = match.Symbol;
                                _activeTf = match.Timeframe;
                                ResolveSelected();
                                CalcStats();
                            }
                        }

                        if (!string.IsNullOrEmpty(saved.selectedPosKey))
                        {
                            var parts = saved.selectedPosKey.Split(':', 2);
                            if (parts.Length == 2)
                            {
                                var restoredPos = DisplayedPositions.FirstOrDefault(p => p.Symbol == parts[0] && p.Side == parts[1]);
                                if (restoredPos != null)
                                {
                                    _selectedPosition = restoredPos;
                                    _ = RefreshPositionLines();
                                }
                                else
                                {
                                    // DisplayedPositions/_allPositions are almost
                                    // certainly still empty right now - the real
                                    // Binance fetch this depends on hasn't had a
                                    // chance to complete yet at firstRender time.
                                    // Try again once positions actually finish
                                    // loading for the first time (see
                                    // LoadAllOpenPositionsAsync/RefreshDemoSnapshot).
                                    _pendingRestorePosKey = saved.selectedPosKey;
                                }
                            }
                        }

                        if (saved.tpSlEditMode) { _tpSlEditMode = true; _ = ShowTpSlLinesAsync(); }
                        if (!string.IsNullOrEmpty(saved.posSortField)) _posSortField = saved.posSortField;
                        _posSortAsc = saved.posSortAsc;
                        _posFilterCurrentSym = saved.posFilterCurrentSym;

                        StateHasChanged();
                        _ = RenderCharts();

                        if (!string.IsNullOrEmpty(_activeSym) && !string.IsNullOrEmpty(_activeTf))
                        {
                            var symForRestore = _activeSym;
                            var tfForRestore = _activeTf;
                            _ = InvokeAsync(async () =>
                            {
                                // Give RenderCharts time to actually populate
                                // the chart via setData before trying to
                                // restore a visible range against it -
                                // restoring too early would apply against an
                                // empty chart with no effect.
                                await Task.Delay(400);
                                try
                                {
                                    await JS.InvokeVoidAsync("marketChart.restoreScrollPosition",
                                        $"chartContainer-{_chartInstanceId}", $"{symForRestore}:{tfForRestore}");
                                }
                                catch { }
                            });
                        }
                    }
                }
            }
            catch { /* sessionStorage unavailable or malformed — just keep the default selection */ }

            // Stack the sticky header chain (top-to-bottom order):
            // vertex-header + vertex-topnav live in MainLayout, outside
            // this component; the rest are this page's own elements.
            try
            {
                await JS.InvokeVoidAsync("stickyStack.init", new[]
                {
                    ".vertex-header",
                    ".vertex-topnav",
                    ".mk-sticky-top",
                    ".mk-ticker-bar",
                    ".mk-stats",
                });
            }
            catch { /* non-critical visual enhancement; page works without it */ }
        }

        if (_ooPanelNeedsAutoFit)
        {
            _ooPanelNeedsAutoFit = false;
            try { await JS.InvokeVoidAsync("autoFitPanel.fit", "mkOoPanel", 2000); } catch { }
        }

        // Render whenever chart is ready and data changed
        if (_chartInitDone && Selected != null && Selected.Klines.Count >= 5)
        {
            var lastK = Selected.Klines[^1];
            // Include last bar's OHLCV so live price ticks trigger a redraw,
            // not just when a brand new bar/candle count appears
            var key = $"{Selected.Symbol}:{Selected.Timeframe}:{Selected.Klines.Count}:{lastK.OpenTime}:{lastK.Close}:{lastK.High}:{lastK.Low}:{lastK.Volume}";
            if (key != _lastRenderedKey)
            {
                _lastRenderedKey = key;
                try { await RenderCharts(); } catch { }
            }
        }
    }

    // Initializes the chart. Lightweight Charts' own marketChart.init()
    // (JS side) disposes any previous chart instance bound to this
    // container id before creating a new one — so even in the worst
    // case (Blazor somehow calling this twice, or reusing a component
    // instance across navigation in a way that re-triggers firstRender),
    // there is never more than one live chart per container, and no
    // stale-reference bookkeeping is needed on this side at all.
    async Task InitChartAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var ok = await JS.InvokeAsync<bool>("marketChart.init", $"chartContainer-{_chartInstanceId}");
            if (ok)
            {
                await RegisterPricePickCallback();
                _chartInitDone = true;
                _jsReady = true;
                _chartInitError = "";
                // Initialize drawing tools overlay for this chart container
                try { await JS.InvokeVoidAsync("chartDrawingTools.init", $"chartContainer-{_chartInstanceId}"); } catch { }
                // Draggable init deferred to OnAfterRenderAsync after DOM update
            }
            else
            {
                _chartInitError = "Chart container not found in DOM yet";
            }
        }
        catch (Exception ex)
        {
            _chartInitError = $"Chart init failed: {ex.Message}";
        }
        try { await JS.InvokeVoidAsync("tickerDragScroll.bind"); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                if (Frozen) continue;

                // Per performance audit: these three are fully
                // independent (different data sources: local file vs
                // two separate Binance endpoints, writing to different
                // fields) - running them concurrently instead of one
                // after another cuts this tick's network-bound time
                // down to whichever single call takes longest, rather
                // than the sum of all three sequential round-trips.
                var loadDataTask = LoadData();
                // DEMO: skip Binance positions/orders calls — demo data is always
                // in memory via DemoAccount, updated by OnLivePriceTicked events.
                // LIVE: run all three concurrently to minimize tick latency.
                var loadOrdersTask    = _demoMode ? Task.CompletedTask : LoadOpenOrdersAsync();
                var loadPositionsTask = _demoMode ? Task.CompletedTask : LoadAllOpenPositionsAsync();
                var loadCurrentPosTask = (!_demoMode && _activeSignal != null)
                    ? LoadCurrentPositionAsync(_activeSignal.Symbol)
                    : Task.CompletedTask;
                await Task.WhenAll(loadDataTask, loadOrdersTask, loadPositionsTask, loadCurrentPosTask);

                SweepExpiredSignals();
                // CleanupOrphanedProtectiveOrders only makes sense in LIVE mode:
                // in DEMO, _openOrders and _allPositions are always empty (demo
                // uses _demoSnapshot instead), so there's nothing to clean up.
                if (!_demoMode)
                    await CleanupOrphanedProtectiveOrdersAsync();

                // Safety net: if there is no selected position AND
                // no position open for the active symbol, make sure
                // the chart lines are gone. This catches edge cases
                // where the cleanup in LoadAllOpenPositions fires
                // but the JS call failed or was missed.
                // Safety net: hide chart lines if no position is selected AND
                // no position exists for the active symbol.
                // DEMO: uses DisplayedPositions (which reads _demoSnapshot.Positions)
                // LIVE: uses _allPositions
                if (_selectedPosition == null && _chartInitDone &&
                    !string.IsNullOrEmpty(_activeSym) &&
                    !DisplayedPositions.Any(p => p.Symbol == _activeSym))
                {
                    try
                    {
                        await JS.InvokeVoidAsync("marketChart.hidePositionLines",
                            $"chartContainer-{_chartInstanceId}");
                        await JS.InvokeVoidAsync("marketChart.hideTpSlLines",
                            $"chartContainer-{_chartInstanceId}");
                    }
                    catch { }
                }

                if (_tpSlEditMode && _selectedPosition != null)
                {
                    // Per performance audit: only redraw if the actual
                    // set of TP/SL orders for this position genuinely
                    // changed since the last tick - without this,
                    // ShowTpSlLinesAsync (a full DOM teardown+rebuild
                    // of every pill) ran every single 5-second tick
                    // unconditionally, even when nothing had changed,
                    // since TP/SL now shows by default. Still catches
                    // a TP/SL that just filled on the real exchange
                    // (which DOES change this set), just without the
                    // wasted work on every tick where nothing changed.
                    var pos = _selectedPosition;
                    bool MatchesThisPos(OpenOrderRow o) =>
                        o.Symbol == pos.Symbol &&
                        (string.IsNullOrEmpty(o.PositionSide) || o.PositionSide == "BOTH" || o.PositionSide == pos.Side) &&
                        (o.Type.Contains("STOP") || o.Type.Contains("TAKE_PROFIT"));
                    var currentTpSlSnapshot = string.Join("|", _openOrders
                        .Where(MatchesThisPos)
                        .OrderBy(o => o.OrderId)
                        .Select(o => $"{o.OrderId}:{o.Price}"));
                    // Skip redraw during drag-freeze window:
                    // user just dragged a line, old order was cancelled,
                    // new order not yet confirmed — snapshot diff would
                    // see "no TP orders" and erase the line.
                    if (currentTpSlSnapshot != _lastTpSlSnapshot && !IsTpSlDragFrozen)
                    {
                        _lastTpSlSnapshot = currentTpSlSnapshot;
                        // Re-render with the now-current order list — this
                        // is what catches a TP/SL that just filled on the
                        // real exchange and removes its now-stale line
                        // from the chart, instead of leaving it drawn
                        // forever until the user manually toggles the
                        // TP/SL view off and on again.
                        await ShowTpSlLinesAsync();
                    }
                }
                // StateHasChanged triggers OnAfterRenderAsync which calls
                // RenderCharts only when data actually changed
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // Cycles the "Analyzing SYMBOL..." text in the empty-signals scanning
    // animation, independent of the slower 5s data timer, so the panel
    // feels alive even when nothing else has changed.
    async Task ScanCycleAsync()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested)
            {
                await Task.Delay(1400, _cts.Token);
                if (!_signals.Any() && _symbols.Count > 0)
                {
                    _scanSymIdx = (_scanSymIdx + 1) % _symbols.Count;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    // Keep live-updated series unless the file snapshot has a strictly newer
    // closed candle (e.g. symbol the Engine isn't live-pushing, or cold state
    // right after a Web restart). Prevents the slower ~45s file snapshot from
    // reverting candles we've already live-updated via SignalR.
    static List<MarketSeries> MergeWithLive(List<MarketSeries> current, IReadOnlyList<MarketSeries> fresh)
    {
        var result = new List<MarketSeries>(fresh.Count);
        foreach (var f in fresh)
        {
            var existing = current.FirstOrDefault(s => s.Symbol == f.Symbol && s.Timeframe == f.Timeframe);
            if (existing == null || existing.Klines.Count == 0 || f.Klines.Count == 0)
            {
                result.Add(f);
                continue;
            }

            result.Add(f.Klines[^1].OpenTime > existing.Klines[^1].OpenTime ? f : existing);
        }
        return result;
    }

    async Task LoadData()
    {
        try
        {
            var fresh = await Service.LoadAsync();
            if (fresh == null || fresh.Count == 0) return;
            Series = MergeWithLive(Series, fresh);

            // Load recent signals (last 24h, not blocked by exchange)
            try
            {
                var allSigs = await SignalSvc.LoadAsync();
                _signals = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= DateTime.UtcNow.AddHours(-SignalLookbackHours)
                                && s.Stage != "BLOCKED"
                                && !_expiredSignals.ContainsKey(SignalKey(s))
                                && !GetSignalTtl(s).IsExpired)
                    .GroupBy(s => s.Symbol)
                    .Select(g => g.OrderByDescending(s => s.Time).First())
                    .OrderByDescending(s => s.Time)
                    .Take(12)
                    .ToList();

                // 1-hour archive: all signals in last hour regardless of TTL or expiry.
                // One entry per symbol (most recent), ordered newest first.
                // This is what the "History" button shows — a complete recent picture.
                var archiveCutoff = DateTime.UtcNow.AddHours(-ExpiredSignalArchiveHours);
                _signalArchive1h = allSigs
                    .Where(s => s.Entry > 0 && s.StopLoss > 0
                                && s.Time >= archiveCutoff
                                && s.Stage != "BLOCKED")
                    .OrderByDescending(s => s.Time)
                    .Take(ExpiredSignalArchiveMaxCount)
                    .ToList();
            }
            catch { }

            // Rebuild symbol list (unique, ordered by count)
            _symbols = Series
                .GroupBy(s => s.Symbol)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            // Select default symbol if none active
            if (string.IsNullOrEmpty(_activeSym) && _symbols.Any())
                _activeSym = _symbols[0];

            // Select default TF if none active
            if (string.IsNullOrEmpty(_activeTf))
                _activeTf = Series.FirstOrDefault(s => s.Symbol == _activeSym)?.Timeframe ?? "FiveMinutes";

            ResolveSelected();
            CalcStats();

            // Panel is visible by default for whatever symbol is active —
            // only stays hidden if the user explicitly dismissed it (✕),
            // OR if a position is currently selected (that has its own
            // distinct panel with its own TP/SL chart lines — this check
            // must not silently reopen Manual Trade on top of it on every
            // periodic tick, which is exactly what was happening before:
            // _selectedPosition has _activeSignal == null by design, so
            // without this it looked indistinguishable from "nothing
            // selected" to this check).
            if (_activeSignal == null && _selectedPosition == null && !_orderPanelDismissed && !string.IsNullOrEmpty(_activeSym) && _last > 0)
                OpenManualPanelFor(_activeSym, _last);
        }
        catch { }
    }

    void ResolveSelected()
    {
        // Find series matching active symbol + TF
        var match = Series.FirstOrDefault(s =>
            s.Symbol == _activeSym && s.Timeframe == _activeTf);

        if (match != null)
        {
            Selected = match;
        }
        else if (!string.IsNullOrEmpty(_activeSym) && HistoricalReader.Has(_activeSym, TfLabel(_activeTf).ToLowerInvariant()))
        {
            // The requested timeframe has no entry in the narrow
            // klines_bootstrap.json snapshot Series is loaded from,
            // but IS archived in datadb (confirmed: pinned symbols
            // have per-timeframe archive files there that the
            // bootstrap snapshot simply doesn't carry). Create an
            // empty placeholder with the real symbol/timeframe -
            // RenderCharts' own existing archive lazy-load mechanism
            // (already proven to work for the 6 base timeframes) will
            // fill this in for real on the next render, rather than
            // silently snapping back to a different timeframe the
            // user didn't ask for.
            Selected = new MarketSeries(_activeSym, _activeTf, Array.Empty<KlineDto>());
        }
        else if (!string.IsNullOrEmpty(_activeSym))
        {
            // Fallback: best available TF for this symbol
            Selected = Series
                .Where(s => s.Symbol == _activeSym)
                .OrderByDescending(s => s.Klines.Count)
                .FirstOrDefault();
            if (Selected != null) _activeTf = Selected.Timeframe;
        }
    }

    bool _emergencyFetchInProgress;
    // Inline order editing
    string? _editingOrderId;
    decimal _editPrice;
    decimal _editQty;
    string  _editError = string.Empty;
    bool    _editSaving;

    void PickSym(string sym, bool autoSelectExistingPosition = true)
    {
        _activeSym = sym;
        _orderPanelDismissed = false;
        // Try to keep current TF, fallback to first available
        var available = Series.FirstOrDefault(s => s.Symbol == sym && s.Timeframe == _activeTf)
            ?? Series.FirstOrDefault(s => s.Symbol == sym);
        if (available != null) _activeTf = available.Timeframe;
        ResolveSelected();
        CalcStats();
        // If this symbol has no klines (e.g. manually opened position
        // on a coin not in the bot universe), trigger emergency fetch
        if (Selected == null || Selected.Klines.Count < 5)
            _ = EmergencyFetchKlinesAsync(sym);

        if (autoSelectExistingPosition)
        {
            // Per direct request: show the position panel for THIS symbol
            // whenever it has an open position, regardless of whether the
            // user got here by clicking the positions table row or just
            // picking the symbol from the ticker/search/anywhere else.
            // Skipped when called from SelectSignal (autoSelectExistingPosition:
            // false) - that caller is about to set its own _activeSignal/
            // _selectedPosition state right after this call, and this logic
            // would otherwise immediately overwrite it, which is exactly
            // what caused the reported bug (clicking a signal for a symbol
            // that already has a position only ever showed the position
            // panel, with no way to act on the signal at all).
            var existingPos = DisplayedPositions.FirstOrDefault(p => p.Symbol == sym);
            if (existingPos != null)
            {
                _selectedPosition = existingPos;
                _activeSignal = null;
                _ = RefreshPositionLines();
            }
            else if (_selectedPosition?.Symbol != sym)
            {
                // Switched to a symbol with no position — clear any
                // stale position panel left over from the previous symbol.
                _selectedPosition = null;
                _ = JS.InvokeVoidAsync("marketChart.hidePositionLines", $"chartContainer-{_chartInstanceId}");
            }

            // Per direct request: always show Manual Trade for this
            // symbol, even with no real signal and no position. Built
            // as a "manual" MissedTradeRecord with Confidence = 0 -
            // the existing markup already distinguishes this from a
            // real signal (Confidence > 0) by showing "Last Price"
            // instead of "Signal Entry", so this activates logic that
            // was already half-built rather than introducing a new
            // branch. ATR-based SL/TP suggestion: 1.5x ATR for the
            // stop, 2x/3x for TP1/TP2 - a standard, widely-used
            // starting ratio (not a guarantee, fully editable), kept
            // simple since the Engine itself has no single canonical
            // ATR multiplier convention of its own to match here.
            if (existingPos == null && (_activeSignal == null || _activeSignal.Symbol != sym))
            {
                var currentPrice = Selected?.Klines.Count > 0 ? Selected.Klines[^1].Close : 0m;
                if (currentPrice > 0)
                {
                    decimal atrSuggest = _atr > 0 ? _atr : 0m;
                    _activeSignal = new MissedTradeRecord
                    {
                        Symbol = sym,
                        Side = "LONG",
                        Entry = currentPrice,
                        StopLoss = atrSuggest > 0 ? currentPrice - atrSuggest * 1.5m : 0m,
                        TakeProfits = atrSuggest > 0
                            ? new List<decimal> { currentPrice + atrSuggest * 2m, currentPrice + atrSuggest * 3m }
                            : new List<decimal>(),
                    };
                    _orderPrice = currentPrice;
                    _manualSlPrice = _activeSignal.StopLoss;
                    _manualTps = new List<ManualTpRow>();
                    if (_activeSignal.TakeProfits.Count > 0)
                    {
                        decimal evenPct = Math.Round(100m / _activeSignal.TakeProfits.Count, 0);
                        for (int i = 0; i < _activeSignal.TakeProfits.Count; i++)
                        {
                            bool isLast = i == _activeSignal.TakeProfits.Count - 1;
                            decimal pct = isLast ? (100m - evenPct * i) : evenPct;
                            _manualTps.Add(new ManualTpRow { Price = _activeSignal.TakeProfits[i], Pct = pct });
                        }
                    }
                    _ = LoadSymbolInfoAndSuggestQty(_activeSignal);
                }
            }
        }

        StateHasChanged();
        _ = RenderCharts();
        _ = JS.InvokeVoidAsync("stickyStack.recalc");
        _ = JS.InvokeVoidAsync("tickerDragScroll.scrollSymbolIntoView", sym);
        _ = SaveSelectionState();
    }

    // Persists the current symbol+timeframe to sessionStorage so it
    // survives navigating away and back (or refreshing) within the same
    // browser tab — cleared automatically when the tab closes, so this
    // is a "remember where I was" convenience, not a permanent setting.
    sealed class SavedMarketState
    {
        public string sym { get; set; } = "";
        public string tf { get; set; } = "";
        public bool demoMode { get; set; }
        public string ooTab { get; set; } = "";
        public string selectedPosKey { get; set; } = "";
