    List<ActivePositionInfo> _allPositions = new();
    // Position table sort: field + ascending flag
    string _posSortField = "pnl"; // default: sort by absolute PnL descending
    bool _posSortAsc = false;
    // Filter: show only positions matching the active chart symbol
    bool _posFilterCurrentSym = false;
