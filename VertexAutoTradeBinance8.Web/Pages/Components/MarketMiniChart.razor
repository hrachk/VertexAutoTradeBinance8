@* MarketMiniChart — pure JS/LightweightCharts rendering.
   Blazor only: mounts the container, calls JS to draw, and disposes.
   No SVG, no Blazor re-render loop issues, no flex/height CSS chain problems. *@
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Services
@inject VertexAutoTradeBinance8.Web.Services.MarketSnapshotFileService SnapSvc
@inject VertexAutoTradeBinance8.Services.BinanceClientFactory Factory
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_containerId" class="mc-host">
    @if (_loading)
    {
        <div class="mc-spinner-wrap"><div class="mc-spinner"></div></div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mc-error">@_error</div>
    }
</div>

<style>
.mc-host {
    position: relative;
    width: 100%;
    height: 260px;
    background: #07090f;
    overflow: hidden;
}
.mc-spinner-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
.mc-spinner {
    width: 20px; height: 20px;
    border: 2px solid #1a2535;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: mc-spin 0.7s linear infinite;
}
@@keyframes mc-spin { to { transform: rotate(360deg); } }
.mc-error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #2a3a50;
    font-family: monospace;
    padding: 8px;
    text-align: center;
}
</style>

@code {
    [Parameter] public string Symbol    { get; set; } = "";
    [Parameter] public string Timeframe { get; set; } = "FifteenMinutes";
    [Parameter] public int    MaxBars   { get; set; } = 120;

    // Stable container ID — stays the same for the lifetime of this
    // component instance so JS can always find the div.
    readonly string _containerId = "mc-" + Guid.NewGuid().ToString("N")[..8];

    bool   _loading = true;
    string _error   = "";

    // Track last rendered params to avoid redundant JS calls
    string _lastSym = "";
    string _lastTf  = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only reload when Symbol or Timeframe actually changes
        var sym = Symbol?.Trim().ToUpperInvariant() ?? "";
        var tf  = Timeframe ?? "FifteenMinutes";

        if (sym == _lastSym && tf == _lastTf && !firstRender)
            return;

        _lastSym = sym;
        _lastTf  = tf;

        await RenderChartAsync(sym, tf);
    }

    async Task RenderChartAsync(string sym, string tf)
    {
        _loading = true;
        _error   = "";
        StateHasChanged();

        if (string.IsNullOrEmpty(sym))
        {
            _loading = false;
            _error   = "no symbol";
            StateHasChanged();
            return;
        }

        // Load klines
        var klines = await LoadKlinesAsync(sym, tf);

        if (klines == null || klines.Count == 0)
        {
            _loading = false;
            _error   = $"No data: {sym}";
            StateHasChanged();
            return;
        }

        if (klines.Count > MaxBars)
            klines = klines.Skip(klines.Count - MaxBars).ToList();

        // Build JS-ready array: [{time, open, high, low, close}]
        // time must be Unix seconds (LW Charts requirement)
        var bars = klines.Select(k => new
        {
            time  = k.OpenTime / 1000,   // ms → seconds
            open  = (double)k.Open,
            high  = (double)k.High,
            low   = (double)k.Low,
            close = (double)k.Close,
        }).ToArray();

        _loading = false;
        StateHasChanged();

        // Give Blazor one frame to remove the spinner div before JS touches the container
        await Task.Delay(30);

        try
        {
            await JS.InvokeVoidAsync("miniChartInit", _containerId, bars);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MiniChart] JS init error: {ex.Message}");
            _error = "Chart init failed";
            StateHasChanged();
        }
    }

    async Task<List<KlineDto>?> LoadKlinesAsync(string sym, string tf)
    {
        // 1) Snapshot file (written by Engine every 45s)
        try
        {
            var all = await SnapSvc.LoadAsync();
            if (all?.Count > 0)
            {
                // Exact match first, then any TF for this symbol
                var s = all.FirstOrDefault(x =>
                            x.Symbol.Equals(sym, StringComparison.OrdinalIgnoreCase) &&
                            x.Timeframe.Equals(tf, StringComparison.OrdinalIgnoreCase))
                        ?? all.FirstOrDefault(x =>
                            x.Symbol.Equals(sym, StringComparison.OrdinalIgnoreCase));

                if (s?.Klines?.Count > 0)
                {
                    Console.WriteLine($"[MiniChart] Snap: {s.Symbol}/{s.Timeframe} {s.Klines.Count} bars");
                    return s.Klines.ToList();
                }
                Console.WriteLine($"[MiniChart] Snap miss: {sym}/{tf}. Have {all.Count} series: " +
                    string.Join(", ", all.Take(4).Select(x => $"{x.Symbol}:{x.Timeframe}")));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MiniChart] Snap error: {ex.Message}");
        }

        // 2) Binance REST fallback
        Console.WriteLine($"[MiniChart] REST fallback: {sym}/{tf}");
        return await FetchBinanceAsync(sym, tf);
    }

    async Task<List<KlineDto>?> FetchBinanceAsync(string sym, string tf)
    {
        try
        {
            var client = Factory.TryCreateRestClient();
            if (client == null)
            {
                Console.WriteLine("[MiniChart] REST: no client (ApiKey empty?)");
                return null;
            }
            if (!TfMap.TryGetValue(tf, out var interval))
                interval = Binance.Net.Enums.KlineInterval.FifteenMinutes;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var res = await client.UsdFuturesApi.ExchangeData.GetKlinesAsync(
                sym, interval, limit: Math.Min(MaxBars, 200), ct: cts.Token);

            if (!res.Success || res.Data == null)
            {
                Console.WriteLine($"[MiniChart] REST failed: {res.Error?.Message}");
                return null;
            }
            Console.WriteLine($"[MiniChart] REST OK: {res.Data.Count()} bars");
            return res.Data.Select(k => new KlineDto(
                ((DateTimeOffset)DateTime.SpecifyKind(k.OpenTime, DateTimeKind.Utc))
                    .ToUnixTimeMilliseconds(),
                k.OpenPrice, k.HighPrice, k.LowPrice, k.ClosePrice, k.Volume
            )).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MiniChart] REST exception: {ex.Message}");
            return null;
        }
    }

    static readonly Dictionary<string, Binance.Net.Enums.KlineInterval> TfMap = new()
    {
        ["OneMinute"]      = Binance.Net.Enums.KlineInterval.OneMinute,
        ["FiveMinutes"]    = Binance.Net.Enums.KlineInterval.FiveMinutes,
        ["FifteenMinutes"] = Binance.Net.Enums.KlineInterval.FifteenMinutes,
        ["ThirtyMinutes"]  = Binance.Net.Enums.KlineInterval.ThirtyMinutes,
        ["OneHour"]        = Binance.Net.Enums.KlineInterval.OneHour,
        ["FourHour"]       = Binance.Net.Enums.KlineInterval.FourHour,
        ["OneDay"]         = Binance.Net.Enums.KlineInterval.OneDay,
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("miniChartDestroy", _containerId); }
        catch { }
    }
}
