@using VertexAutoTradeBinance8.Services
@if (Trades == null || Trades.Count == 0)
{
    <div class="vt-hint" style="padding:12px 0;">Нет симулированных сделок в снапшоте.</div>
}
else
{
    <table class="vt-table">
        <thead>
            <tr>
                <th>Время</th>
                <th>Символ</th>
                <th>Сторона</th>
                <th>Entry</th>
                <th>Exit</th>
                <th>PnL %</th>
                <th>Режим / причина</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tr in Trades.OrderByDescending(x => x.Time).Take(40))
            {
                <tr>
                    <td class="mono">@tr.Time.ToLocalTime().ToString("dd.MM HH:mm")</td>
                    <td><span class="sym">@tr.Symbol</span></td>
                    <td>
                        <span class="pill @(IsBuy(tr.Side) ? "pill-up" : "pill-down")">
                            @tr.Side
                        </span>
                    </td>
                    <td class="mono">@FormatPx(tr.Entry)</td>
                    <td class="mono">@FormatPx(tr.Exit)</td>
                    <td class="mono @(tr.Pnl >= 0 ? "score-good" : "score-low")">@tr.Pnl.ToString("+0.00;-0.00")%</td>
                    <td><span class="reason">@tr.Regime</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<AiSelfLearningService.TradeHistoryEntry> Trades { get; set; } = new();

    private static string FormatPx(decimal v)
    {
        if (v >= 1000) return v.ToString("0.00");
        if (v >= 1) return v.ToString("0.####");
        return v.ToString("0.########");
    }

    private static bool IsBuy(object side)
    {
        var s = side?.ToString() ?? "";
        return s.Contains("Buy", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Long", StringComparison.OrdinalIgnoreCase);
    }
}
