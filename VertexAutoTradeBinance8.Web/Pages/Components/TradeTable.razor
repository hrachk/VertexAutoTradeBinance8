@using VertexAutoTradeBinance8.Services
@if (Trades == null || Trades.Count == 0)
{
    <div class="ai-empty">Нет симулированных сделок.</div>
}
else
{
    <table class="ai-table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Symbol</th>
                <th>Side</th>
                <th>Entry</th>
                <th>Exit</th>
                <th>PnL %</th>
                <th>Reason</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var t in Trades.OrderByDescending(t => t.Time))
            {
                <tr>
                    <td>@t.Time.ToLocalTime().ToString("dd.MM HH:mm")</td>
                    <td>@t.Symbol</td>
                    <td>@t.Side</td>
                    <td>@t.Entry</td>
                    <td>@t.Exit</td>
                    <td class="@(t.Pnl >= 0 ? "pnl-win" : "pnl-loss")">@t.Pnl.ToString("0.0")%</td>
                    <td>@t.Regime</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<AiSelfLearningService.TradeHistoryEntry> Trades { get; set; } = new();
}
