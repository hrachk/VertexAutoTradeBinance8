@page "/engine"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@inject EngineStateService EngineService

<div class="engine-container">

    @if (state == null)
    {
        <div class="empty">Нет данных от движка...</div>
    }
    else
    {
        <div class="engine-title">Vertex Engine — Реальное состояние</div>

        <div class="engine-grid">

            <div class="block">
                <div class="label">Статус</div>
                <div class="value">@state.Status</div>
            </div>

            <div class="block">
                <div class="label">Режим</div>
                <div class="value">@state.Mode</div>
            </div>

            <div class="block">
                <div class="label">Баланс USDT</div>
                <div class="value">@state.BalanceUsdt</div>
            </div>

            <div class="block">
                <div class="label">Символ</div>
                <div class="value">@state.Symbol</div>
            </div>

            <div class="block">
                <div class="label">TF</div>
                <div class="value">@state.Timeframe</div>
            </div>

            <div class="block">
                <div class="label">Base Regime</div>
                <div class="value">@state.MarketRegime</div>
            </div>

            <div class="block">
                <div class="label">Smart Regime</div>
                <div class="value">@state.SmartRegime</div>
            </div>

            <div class="block">
                <div class="label">Confidence</div>
                <div class="value">@state.Confidence %</div>
            </div>

            <div class="block">
                <div class="label">Slope</div>
                <div class="value">@state.Slope</div>
            </div>

            <div class="block">
                <div class="label">Volatility</div>
                <div class="value">@state.Volatility</div>
            </div>

            <div class="block danger">
                <div class="label">Liquidity Danger</div>
                <div class="value">@state.LiquidityDanger</div>
            </div>

            <div class="block reason">
                <div class="label">Причина блокировки</div>
                <div class="value">@state.LiquidityReason</div>
            </div>

            <div class="block">
                <div class="label">Soft Entry</div>
                <div class="value">@state.SoftEntry</div>
            </div>

            <div class="block">
                <div class="label">Blocked By Liquidity</div>
                <div class="value">@state.BlockedByLiquidity</div>
            </div>

            <div class="block">
                <div class="label">Последнее обновление</div>
                <div class="value">@state.LastUpdate.ToLocalTime()</div>
            </div>
        </div>
    }
</div>

@code {
    private EngineStateModel? state;

    protected override void OnInitialized()
    {
      
        Load();
        var timer = new System.Timers.Timer(2000);
        timer.Elapsed += (_, _) => InvokeAsync(Load);
        timer.Start();
    }

    private void Load()
    {
        
        state = EngineService.Load();
        StateHasChanged();
    }
}
