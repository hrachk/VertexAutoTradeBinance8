@page "/engine"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@inject EngineStateService EngineService
@implements IDisposable

<div class="vt-page-title">
    <div>
        <h1>Engine State</h1>
        <p>Live snapshot from @EngineService.FilePath</p>
    </div>
    <button class="vt-btn" @onclick="Refresh">↻ Refresh</button>
</div>

@if (state == null)
{
    <div class="vt-card">
        <div class="vt-empty">
            <div class="ico">◎</div>
            Нет данных от движка. Убедись, что worker пишет engine_state.json.
        </div>
    </div>
}
else
{
    <div class="vt-grid vt-grid-4" style="margin-bottom:14px;">
        <div class="vt-card tight"><div class="vt-kpi"><span class="label">Status</span><span class="value" style="font-size:18px;">@state.Status</span></div></div>
        <div class="vt-card tight"><div class="vt-kpi yellow"><span class="label">Balance</span><span class="value">@state.BalanceUsdt.ToString("0.##")</span></div></div>
        <div class="vt-card tight"><div class="vt-kpi blue"><span class="label">Symbol</span><span class="value" style="font-size:16px;">@state.Symbol</span><span class="sub">@state.Timeframe</span></div></div>
        <div class="vt-card tight"><div class="vt-kpi"><span class="label">Confidence</span><span class="value">@state.Confidence%</span></div></div>
    </div>

    <div class="vt-grid vt-grid-3" style="margin-bottom:14px;">
        <div class="vt-card">
            <div class="vt-card-title">Regimes</div>
            <table class="vt-table">
                <tbody>
                    <tr><td class="sym">Mode</td><td>@state.Mode</td></tr>
                    <tr><td class="sym">Base</td><td>@state.MarketRegime</td></tr>
                    <tr><td class="sym">Smart</td><td>@state.SmartRegime</td></tr>
                </tbody>
            </table>
        </div>
        <div class="vt-card">
            <div class="vt-card-title">Market metrics</div>
            <table class="vt-table">
                <tbody>
                    <tr><td class="sym">Slope</td><td>@state.Slope</td></tr>
                    <tr><td class="sym">Volatility</td><td>@state.Volatility</td></tr>
                    <tr><td class="sym">Updated</td><td>@state.LastUpdate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                </tbody>
            </table>
        </div>
        <div class="vt-card">
            <div class="vt-card-title">Guards</div>
            <div class="vt-status-strip">
                <span class="vt-badge @(state.LiquidityDanger?"err":"ok")">Liquidity @(state.LiquidityDanger?"DANGER":"OK")</span>
                <span class="vt-badge @(state.SoftEntry?"warn":"neutral")">SoftEntry @(state.SoftEntry?"ON":"OFF")</span>
                <span class="vt-badge @(state.BlockedByLiquidity?"err":"ok")">@(state.BlockedByLiquidity?"BLOCKED":"ALLOW")</span>
            </div>
            <div class="vt-hint">@(string.IsNullOrEmpty(state.LiquidityReason)?"—":state.LiquidityReason)</div>
        </div>
    </div>
}

@code {
    private EngineStateModel? state;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void Refresh() => state = EngineService.Load();
    public void Dispose() => _timer?.Dispose();
}
