@page "/engine"
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Services
@inject EngineStateService EngineState

<h2 class="page-title">Vertex Engine — Реальное состояние</h2>

@if (_state == null)
{
    <div class="state-card danger">
        Engine state not available (engine writing / not started)
    </div>
}
else
{
    <div class="engine-grid">

        <!-- ===================== CORE STATUS ===================== -->
        <div class="state-card">
            <div class="label">Статус</div>
            <div class="value">@_state.Status</div>
        </div>

        <div class="state-card">
            <div class="label">Режим</div>
            <div class="value">@_state.Mode</div>
        </div>

        <div class="state-card">
            <div class="label">Баланс USDT</div>
            <div class="value">@_state.BalanceUsdt.ToString("F2")</div>
        </div>

        <div class="state-card">
            <div class="label">TF</div>
            <div class="value">@_state.Timeframe</div>
        </div>

        <!-- ===================== MARKET ===================== -->
        <div class="state-card">
            <div class="label">Символ</div>
            <div class="value">@_state.Symbol</div>
        </div>

        <div class="state-card">
            <div class="label">Base Regime</div>
            <div class="value">@_state.MarketRegime</div>
        </div>

        <div class="state-card">
            <div class="label">Smart Regime</div>
            <div class="value">@_state.SmartRegime</div>
        </div>

        <div class="state-card">
            <div class="label">Confidence</div>
            <div class="value">
                @_state.ConfidencePercent%
                <span class="badge @ConfidenceCss(_state.ConfidenceLevel)">
                    @_state.ConfidenceLevel
                </span>
            </div>
        </div>

        <div class="state-card wide">
            <div class="label">Confidence (history)</div>
            <svg class="sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline fill="none"
                          stroke="@ConfidenceSparklineColor"
                          stroke-width="2"
                          points="@ConfidenceSparklinePoints" />
            </svg>
        </div>

        <!-- ===================== MARKET METRICS ===================== -->
        <div class="state-card">
            <div class="label">Slope</div>
            <div class="value mono">@_state.Slope.ToString("F6")</div>
        </div>

        <div class="state-card">
            <div class="label">Volatility</div>
            <div class="value mono">@_state.Volatility.ToString("F6")</div>
        </div>

        <!-- ===================== ENGINE HEARTBEAT ===================== -->
        <div class="state-card heartbeat @EngineHeartbeatCss">
            <div class="label">Engine Status</div>
            <div class="value">@EngineHeartbeatText</div>
        </div>

        <div class="state-card">
            <div class="label">Cycles / min</div>
            <div class="value">@_state.CyclesPerMinute</div>
        </div>

        <!-- ===================== SUPERVISOR ===================== -->
        <div class="state-card @(SupervisorAlive ? "ok" : "warn")">
            <div class="label">Supervisor</div>
            <div class="value">checks/min: @_state.SupervisorChecksLastMinute</div>
        </div>

        <div class="state-card wide">
            <div class="label">Последнее действие Supervisor</div>
            <div class="value mono">@_state.LastSupervisorMessage</div>
        </div>

        <!-- ===================== STRATEGY ===================== -->
        <div class="state-card wide decision">
            <div class="label">Последнее решение Strategy</div>
            <div class="value mono decision-tooltip">
                @_state.LastEntryDecision
                <span class="time">(@DecisionAge sec)</span>
                <div class="tooltip">
                    @DecisionDescription(_state.LastEntryDecision)
                </div>
            </div>
        </div>

        <!-- ===================== UNIVERSE ===================== -->
        <div class="state-card">
            <div class="label">Tracked Symbols</div>
            <div class="value">@_state.TrackedSymbols</div>
        </div>

        <div class="state-card">
            <div class="label">Universe Size</div>
            <div class="value">@_state.UniverseSize</div>
        </div>

        <div class="state-card @( _state.OpenPositions > 0 ? "ok" : "warn")">
            <div class="label">Open Positions</div>
            <div class="value">@_state.OpenPositions</div>
        </div>

        <!-- ===================== LIQUIDITY ===================== -->
        <div class="state-card @( _state.LiquidityDanger ? "danger" : "ok")">
            <div class="label">Liquidity Danger</div>
            <div class="value">
                @_state.LiquidityDanger
                @if (_state.LiquidityDanger)
                {
                    <div class="sub">@_state.LiquidityReason</div>
                }
            </div>
        </div>

        <!-- ===================== LAST UPDATE ===================== -->
        <div class="state-card wide">
            <div class="label">Последнее обновление</div>
            <div class="value">@_state.LastUpdate.ToLocalTime()</div>
        </div>

    </div>
}
@code {
    private EngineStateModel? _state;
    private PeriodicTimer? _timer;

    // ================= CONFIDENCE HISTORY =================
    private readonly Queue<int> _confidenceHistory = new();
    private const int ConfidenceHistoryMax = 30;

    protected override void OnInitialized()
    {
        Load();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Tick();
    }

    private async Task Tick()
    {
        while (_timer != null && await _timer.WaitForNextTickAsync())
        {
            Load();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Load()
    {
        _state = EngineState.Load();

        if (_state != null)
        {
            _confidenceHistory.Enqueue(_state.ConfidencePercent);
            while (_confidenceHistory.Count > ConfidenceHistoryMax)
                _confidenceHistory.Dequeue();
        }
    }

    // ================= HEARTBEAT =================
    private double EngineSilenceSeconds
    {
        get
        {
            if (_state == null)
                return double.MaxValue;

            return (DateTime.UtcNow - _state.LastEngineTick).TotalSeconds;
        }
    }

    private string EngineHeartbeatText
    {
        get
        {
            if (EngineSilenceSeconds < 5)
                return $"LIVE · {EngineSilenceSeconds:F1}s";

            if (EngineSilenceSeconds < 15)
                return $"STALLED · {EngineSilenceSeconds:F1}s";

            return $"DEAD · {EngineSilenceSeconds:F1}s";
        }
    }

    private string EngineHeartbeatCss
    {
        get
        {
            if (EngineSilenceSeconds < 5)
                return "live";

            if (EngineSilenceSeconds < 15)
                return "stalled";

            return "dead";
        }
    }

    private bool SupervisorAlive
    {
        get
        {
            if (_state == null)
                return false;

            return (DateTime.UtcNow - _state.LastSupervisorAction) < TimeSpan.FromSeconds(30);
        }
    }

    private int DecisionAge
    {
        get
        {
            if (_state == null)
                return 0;

            return (int)(DateTime.UtcNow - _state.LastDecisionTime).TotalSeconds;
        }
    }

    // ================= CONFIDENCE =================
    private string ConfidenceCss(string level)
    {
        switch (level)
        {
            case "HIGH": return "badge-high";
            case "MEDIUM": return "badge-mid";
            default: return "badge-low";
        }
    }

    private string ConfidenceSparklinePoints
    {
        get
        {
            if (_confidenceHistory.Count < 2)
                return "";

            var values = _confidenceHistory.ToArray();

            return string.Join(" ",
                values.Select((v, i) =>
                {
                    var x = (i / (double)(values.Length - 1)) * 100;
                    var y = 30 - (v / 100.0) * 28;
                    return $"{x:F1},{y:F1}";
                }));
        }
    }

    private string ConfidenceSparklineColor
    {
        get
        {
            if (_confidenceHistory.Count == 0)
                return "#64748b";

            var avg = _confidenceHistory.Average();

            if (avg >= 70) return "#22c55e";
            if (avg >= 45) return "#f59e0b";
            return "#ef4444";
        }
    }

    // ================= DECISION =================
    private string DecisionDescription(string decision)
    {
        switch (decision)
        {
            case "LOW_CONFIDENCE":
                return "AI уверен слишком слабо. Рынок шумный.";
            case "WAITING_PULLBACK":
                return "Тренд есть, но ждём откат.";
            case "BLOCKED_LIQUIDITY":
                return "Опасная ликвидность / стоп-хант.";
            case "SOFT_ENTRY":
                return "Мягкий пробный вход.";
            case "ENTER_ALLOWED":
                return "Полноценный вход разрешён.";
            default:
                return "Анализ рынка.";
        }
    }
}
