@page "/executed-signals"

@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Models
@using Microsoft.AspNetCore.SignalR.Client
@inject ExecutedSignalUiService ExecService
@inject NavigationManager Nav

<div class="missed-container">

    <div class="missed-title">Исполненные сигналы</div>
    <div class="missed-sub">
        Все сигналы, по которым были созданы ордера / открыты позиции
    </div>

    <!-- === FILTER PANEL === -->
    <div class="filter-chips">
        <div class="@ChipClass("ALL")" @onclick="@(() => SetFilter("ALL"))">Все</div>
        <div class="@ChipClass("OPEN")" @onclick="@(() => SetFilter("OPEN"))">Открытые</div>
        <div class="@ChipClass("CLOSED")" @onclick="@(() => SetFilter("CLOSED"))">Закрытые</div>
        <div class="@ChipClass("TP")" @onclick="@(() => SetFilter("TP"))">TP</div>
        <div class="@ChipClass("SL")" @onclick="@(() => SetFilter("SL"))">SL</div>
        <div class="@ChipClass("ERR")" @onclick="@(() => SetFilter("ERR"))">Ошибки</div>
    </div>

    <div class="missed-cards-grid">
        @if (filtered == null || filtered.Count == 0)
        {
            <div class="empty-state">
                Пока нет исполненных сигналов для отображения.
            </div>
        }
        else
        {
            @foreach (var r in filtered)
            {
                <ExecutedSignalCard Record="r" />
            }
        }
    </div>
</div>

@code {
    private List<ExecutedSignalRecord> all = new();
    private List<ExecutedSignalRecord> filtered = new();
    private string currentFilter = "ALL";

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        all = ExecService.GetAll();
        ApplyFilter();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/executedSignals"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("ExecutedSignalsUpdated", () =>
        {
            all = ExecService.GetAll();
            ApplyFilter();
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private void SetFilter(string key)
    {
        currentFilter = key;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<ExecutedSignalRecord> q = all;

        switch (currentFilter)
        {
            case "OPEN":
                q = all.Where(x =>
                    x.Status == TradeExecutionStatus.OrderCreated ||
                    x.Status == TradeExecutionStatus.OrderPartiallyFilled ||
                    x.Status == TradeExecutionStatus.PositionOpened);
                break;

            case "CLOSED":
                q = all.Where(x =>
                    x.Status == TradeExecutionStatus.PositionClosedTp ||
                    x.Status == TradeExecutionStatus.PositionClosedSl ||
                    x.Status == TradeExecutionStatus.PositionClosedManual);
                break;

            case "TP":
                q = all.Where(x => x.Status == TradeExecutionStatus.PositionClosedTp);
                break;

            case "SL":
                q = all.Where(x => x.Status == TradeExecutionStatus.PositionClosedSl);
                break;

            case "ERR":
                q = all.Where(x =>
                    x.Status == TradeExecutionStatus.PositionError ||
                    x.Status == TradeExecutionStatus.Cancelled);
                break;

            case "ALL":
            default:
                break;
        }

        filtered = q.ToList();
    }

    private string ChipClass(string key)
    {
        return currentFilter == key ? "chip chip-active" : "chip";
    }
}
