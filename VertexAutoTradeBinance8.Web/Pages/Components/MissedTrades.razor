@page "/missed-trades"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Models
@inject MissedTradeFileService MissedService

<PageTitle>Missed Trades — Vertex</PageTitle>

<div class="mt">

    <!-- HEADER -->
    <div class="mt-header">
        <div class="mt-title-block">
            <span class="mt-icon">📡</span>
            <div>
                <div class="mt-title">MISSED TRADES</div>
                <div class="mt-sub">Signal analysis · Block reasons · Opportunity log</div>
            </div>
        </div>
        <div class="mt-hstats">
            <div class="mt-hs"><div class="mt-hv">@_all.Count</div><div class="mt-hl">TOTAL</div></div>
            <div class="mt-hs up"><div class="mt-hv">@_all.Count(r=>r.Side=="Buy")</div><div class="mt-hl">LONG</div></div>
            <div class="mt-hs dn"><div class="mt-hv">@_all.Count(r=>r.Side=="Sell")</div><div class="mt-hl">SHORT</div></div>
            <div class="mt-hs hi"><div class="mt-hv">@_all.Count(r=>r.Confidence>=70)</div><div class="mt-hl">HIGH CONF</div></div>
            <div class="mt-hs"><div class="mt-hv">@_symGroups.Count</div><div class="mt-hl">SYMBOLS</div></div>
            <div class="mt-hs warn"><div class="mt-hv">@_all.Count(r=>r.Reason.Contains("Exec"))</div><div class="mt-hl">EXEC FAIL</div></div>
        </div>
    </div>

    <!-- FILTER + SEARCH -->
    <div class="mt-toolbar">
        <div class="mt-filters">
            @foreach (var f in _filters)
            {
                <button class="mt-chip @(_activeFilter==f.Key?"mt-chip-on":"")"
                        @onclick="()=>SetFilter(f.Key)">
                    @f.Label
                    <span class="mt-chip-n">@f.Count</span>
                </button>
            }
        </div>
        <div class="mt-search-wrap">
            <input class="mt-search" placeholder="🔍 symbol or reason..." 
                   @bind="_search" @bind:event="oninput" />
            <select class="mt-sort" @onchange="OnSort">
                <option value="time">Latest first</option>
                <option value="conf">High confidence</option>
                <option value="sym">By symbol</option>
            </select>
        </div>
    </div>

    @if (_all.Count == 0)
    {
        <div class="mt-empty">
            <div style="font-size:40px">📭</div>
            <div>No missed trades recorded yet</div>
            <div class="dim">Records appear when signals are blocked or fail to execute</div>
        </div>
    }
    else
    {
        <div class="mt-layout">

            <!-- LEFT: SIGNAL LIST -->
            <div class="mt-list-col">

                <!-- SUMMARY BAR -->
                <div class="mt-summary">
                    <span class="mt-sum-item">
                        <span class="dim">Top symbol</span>
                        <span class="hi bold">@(_symGroups.FirstOrDefault().Key ?? "—")</span>
                    </span>
                    <span class="mt-sum-sep">·</span>
                    <span class="mt-sum-item">
                        <span class="dim">Top block</span>
                        <span class="warn bold">@ShortReason(_topReason)</span>
                    </span>
                    <span class="mt-sum-sep">·</span>
                    <span class="mt-sum-item">
                        <span class="dim">Showing</span>
                        <span class="bold">@Math.Min(_visible.Count,50) / @_visible.Count</span>
                    </span>
                    @if (!string.IsNullOrEmpty(_search) || _activeFilter != "ALL")
                    {
                        <button class="mt-clear" @onclick="ClearFilters">✕ clear</button>
                    }
                </div>

                <!-- CARDS -->
                <div class="mt-cards">
                    @foreach (var r in _visible.Take(50))
                    {
                        bool isLong = r.Side == "Buy";
                        bool isSel  = _selKey == Key(r);
                        string regStr = RegimeStr(r.Regime);
                        string confCls = r.Confidence >= 70 ? "hi" : r.Confidence >= 50 ? "mid" : "lo";

                        <div class="mt-card @(isSel?"mt-card-sel":"")" @onclick="()=>Select(r)">

                            <!-- ROW 1: symbol + side + reason + time -->
                            <div class="mt-card-top">
                                <div class="mt-card-left">
                                    <span class="mt-sym @(isLong?"up":"dn")">@r.Symbol</span>
                                    <span class="mt-badge @(isLong?"badge-long":"badge-short")">
                                        @(isLong?"▲ LONG":"▼ SHORT")
                                    </span>
                                    <span class="mt-stage dim">@r.Stage</span>
                                </div>
                                <div class="mt-card-right">
                                    <span class="mt-block @BlockCls(r.Reason)" title="@r.Reason">
                                        @ShortReason(r.Reason)
                                    </span>
                                    <span class="mt-time dim">@r.Time.ToLocalTime().ToString("dd.MM  HH:mm:ss")</span>
                                </div>
                            </div>

                            <!-- CONFIDENCE BAR -->
                            <div class="mt-conf-bar">
                                <div class="mt-conf-fill @confCls" style="width:@r.Confidence%"></div>
                                <span class="mt-conf-lbl @confCls">@r.Confidence%</span>
                            </div>

                            <!-- ROW 2: key metrics in one readable line -->
                            <div class="mt-metrics">
                                <div class="mt-m">
                                    <span class="mt-ml">ENTRY</span>
                                    <span class="mt-mv mono">@FmtP(r.Entry)</span>
                                </div>
                                <div class="mt-m">
                                    <span class="mt-ml">SL</span>
                                    <span class="mt-mv mono dn">@FmtP(r.StopLoss)</span>
                                </div>
                                @if (r.TakeProfits.Count > 0)
                                {
                                    <div class="mt-m">
                                        <span class="mt-ml">TP1</span>
                                        <span class="mt-mv mono hi">
                                            @FmtP(r.TakeProfits[0])
                                            @if (r.Entry > 0)
                                            {
                                                <span class="mt-pct">+@(Math.Abs(r.TakeProfits[0]-r.Entry)/r.Entry*100m).ToString("F1")%</span>
                                            }
                                        </span>
                                    </div>
                                }
                                <div class="mt-m">
                                    <span class="mt-ml">ATR</span>
                                    <span class="mt-mv mono">@r.ATR.ToString("G3")</span>
                                </div>
                                <div class="mt-m">
                                    <span class="mt-ml">REGIME</span>
                                    <span class="mt-mv @RegimeCls(r.Regime)">@regStr</span>
                                </div>
                                <div class="mt-m">
                                    <span class="mt-ml">BAL</span>
                                    <span class="mt-mv mono @(r.FreeBalance<5?"lo":"")">$@r.FreeBalance.ToString("F1")</span>
                                </div>
                                <div class="mt-m">
                                    <span class="mt-ml">VOL</span>
                                    <span class="mt-mv mono">@r.Vol.ToString("P1")</span>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT: PANELS -->
            <div class="mt-right">

                <!-- TOP SYMBOLS -->
                <div class="mt-panel">
                    <div class="mt-ph">📊 TOP SYMBOLS</div>
                    @foreach (var g in _symGroups.Take(12))
                    {
                        var pct = _all.Count > 0 ? (double)g.Value.Count / _all.Count * 100 : 0;
                        var avgConf = g.Value.Count > 0 ? (int)g.Value.Average(x=>x.Confidence) : 0;
                        var isSym = _symFilter == g.Key;
                        <div class="mt-sym-row @(isSym?"mt-sym-sel":"")" @onclick="()=>FilterSym(g.Key)">
                            <span class="mt-sr-sym">@g.Key</span>
                            <div class="mt-sr-bar">
                                <div class="mt-sr-fill @(avgConf>=70?"hi":avgConf>=50?"mid":"lo")"
                                     style="width:@Math.Min(100,pct*3)%"></div>
                            </div>
                            <span class="mt-sr-cnt">@g.Value.Count</span>
                            <span class="mt-sr-conf @(avgConf>=70?"hi":avgConf>=50?"mid":"lo")">@avgConf%</span>
                        </div>
                    }
                </div>

                <!-- BLOCK REASONS -->
                <div class="mt-panel">
                    <div class="mt-ph">🚫 BLOCK REASONS</div>
                    @foreach (var g in _reasonGroups)
                    {
                        var pct = _all.Count > 0 ? (double)g.Count / _all.Count * 100 : 0;
                        <div class="mt-rr">
                            <span class="mt-rr-name @BlockCls(g.Reason)" title="@g.Reason">@ShortReason(g.Reason)</span>
                            <div class="mt-rr-bar">
                                <div class="mt-rr-fill" style="width:@Math.Min(100,pct*3)%"></div>
                            </div>
                            <span class="mt-rr-cnt dim">@g.Count</span>
                        </div>
                    }
                </div>

                <!-- DETAIL PANEL -->
                @if (_sel != null)
                {
                    <div class="mt-panel mt-detail">
                        <div class="mt-ph">
                            🔍 DETAIL
                            <button class="mt-close-btn" @onclick="()=>_sel=null">✕</button>
                        </div>

                        <div class="mt-detail-top">
                            <span class="mt-sym @(_sel.Side=="Buy"?"up":"dn") big">@_sel.Symbol</span>
                            <span class="mt-badge @(_sel.Side=="Buy"?"badge-long":"badge-short")">
                                @(_sel.Side=="Buy"?"▲ LONG":"▼ SHORT")
                            </span>
                        </div>

                        <div class="mt-detail-time">
                            🕐 @_sel.Time.ToLocalTime().ToString("dd MMMM yyyy  HH:mm:ss")
                        </div>

                        <div class="mt-block-box @BlockCls(_sel.Reason)">
                            🚫 @_sel.Reason
                        </div>

                        <div class="mt-drows">
                            <div class="mt-drow"><span class="mt-dl">Stage</span><span class="mt-dv">@_sel.Stage</span></div>
                            <div class="mt-drow"><span class="mt-dl">Entry</span><span class="mt-dv mono">@FmtP(_sel.Entry)</span></div>
                            <div class="mt-drow"><span class="mt-dl">Stop Loss</span><span class="mt-dv mono dn">@FmtP(_sel.StopLoss)</span></div>
                            <div class="mt-drow"><span class="mt-dl">Confidence</span><span class="mt-dv @(_sel.Confidence>=70?"hi":_sel.Confidence>=50?"mid":"lo")">@_sel.Confidence%</span></div>
                            <div class="mt-drow"><span class="mt-dl">Regime</span><span class="mt-dv @RegimeCls(_sel.Regime)">@RegimeStr(_sel.Regime)</span></div>
                            <div class="mt-drow"><span class="mt-dl">ATR</span><span class="mt-dv mono">@_sel.ATR.ToString("G4")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Volatility</span><span class="mt-dv mono">@_sel.Vol.ToString("P2")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Slope</span><span class="mt-dv mono">@_sel.Slope.ToString("G3")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Balance</span><span class="mt-dv mono @(_sel.FreeBalance<5?"lo":"")">$@_sel.FreeBalance.ToString("F2")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Notional</span><span class="mt-dv mono">$@_sel.AttemptNotional.ToString("F2")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Min Notional</span><span class="mt-dv mono">$@_sel.RequiredMinNotional.ToString("F2")</span></div>
                            <div class="mt-drow"><span class="mt-dl">Smart Type</span><span class="mt-dv">@(_sel.SmartType.Length>0?_sel.SmartType:"—")</span></div>
                        </div>

                        @if (_sel.TakeProfits.Count > 0)
                        {
                            <div class="mt-tps">
                                <div class="mt-dl" style="margin-bottom:6px">TAKE PROFITS</div>
                                @foreach (var (tp, idx) in _sel.TakeProfits.Select((v,i)=>(v,i)))
                                {
                                    var pct2 = _sel.Entry > 0 ? Math.Abs(tp - _sel.Entry) / _sel.Entry * 100m : 0m;
                                    <div class="mt-tp-row">
                                        <span class="dim">TP@(idx+1)</span>
                                        <span class="mono mid">@FmtP(tp)</span>
                                        <span class="hi">+@pct2.ToString("F2")%</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-ai-hint">
                            <span style="font-size:16px">🤖</span>
                            <span>@AiHint(_sel)</span>
                        </div>
                    </div>
                }

            </div>
        </div>
    }
</div>

<style>
:root{--bg:#0a0d12;--bg2:#111520;--bg3:#1a1f2e;--bdr:#1e2535;--acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#eab308;--txt:#e2e8f0;--dim:#64748b;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt);}
.mt{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:40px;}
.up{color:var(--grn)!important;}.dn{color:var(--red)!important;}.hi{color:var(--grn)!important;}
.mid{color:var(--acc)!important;}.lo{color:var(--red)!important;}.warn{color:var(--yel)!important;}
.dim{color:var(--dim)!important;}.bold{font-weight:700;}.mono{font-family:var(--mono);}

/* HEADER */
.mt-header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.mt-title-block{display:flex;align-items:center;gap:12px;}
.mt-icon{font-size:26px;}
.mt-title{font-family:var(--mono);font-size:16px;font-weight:700;letter-spacing:2px;color:var(--acc);}
.mt-sub{font-size:11px;color:var(--dim);margin-top:2px;}
.mt-hstats{display:flex;gap:20px;}
.mt-hs{text-align:center;}
.mt-hv{font-family:var(--mono);font-size:20px;font-weight:700;}
.mt-hl{font-size:10px;letter-spacing:1px;color:var(--dim);}

/* TOOLBAR */
.mt-toolbar{display:flex;align-items:center;justify-content:space-between;padding:10px 24px;background:var(--bg2);border-bottom:1px solid var(--bdr);gap:12px;flex-wrap:wrap;}
.mt-filters{display:flex;gap:6px;flex-wrap:wrap;}
.mt-chip{display:flex;align-items:center;gap:5px;padding:4px 12px;background:var(--bg3);border:1px solid var(--bdr);border-radius:20px;color:var(--dim);font-size:12px;cursor:pointer;transition:all .15s;}
.mt-chip:hover{border-color:var(--acc);color:var(--txt);}
.mt-chip-on{background:rgba(59,130,246,.15);border-color:var(--acc);color:var(--txt);}
.mt-chip-n{background:var(--bg);border-radius:10px;padding:1px 5px;font-size:10px;}
.mt-search-wrap{display:flex;gap:8px;}
.mt-search{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:5px 12px;border-radius:6px;font-size:12px;width:200px;}
.mt-search::placeholder{color:var(--dim);}
.mt-sort{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:5px 10px;border-radius:6px;font-size:12px;}

/* EMPTY */
.mt-empty{display:flex;flex-direction:column;align-items:center;gap:10px;padding:60px;color:var(--dim);text-align:center;}

/* LAYOUT */
.mt-layout{display:grid;grid-template-columns:1fr 300px;gap:1px;background:var(--bdr);min-height:calc(100vh - 120px);}
.mt-list-col{background:var(--bg);padding:0;}
.mt-right{background:var(--bg);display:flex;flex-direction:column;gap:1px;}

/* SUMMARY */
.mt-summary{display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--bg2);border-bottom:1px solid var(--bdr);font-size:12px;flex-wrap:wrap;}
.mt-sum-item{display:flex;align-items:center;gap:6px;}
.mt-sum-sep{color:var(--bdr);}
.mt-clear{margin-left:auto;padding:2px 10px;background:none;border:1px solid var(--bdr);border-radius:10px;color:var(--dim);font-size:11px;cursor:pointer;transition:all .15s;}
.mt-clear:hover{border-color:var(--red);color:var(--red);}

/* CARDS */
.mt-cards{display:flex;flex-direction:column;gap:0;}
.mt-card{padding:14px 16px;border-bottom:1px solid var(--bdr);cursor:pointer;transition:background .12s;border-left:3px solid transparent;}
.mt-card:hover{background:var(--bg2);}
.mt-card-sel{background:var(--bg2)!important;border-left-color:var(--acc);}

/* CARD TOP */
.mt-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.mt-card-left{display:flex;align-items:center;gap:8px;}
.mt-card-right{display:flex;align-items:center;gap:10px;}
.mt-sym{font-family:var(--mono);font-size:15px;font-weight:700;}
.mt-sym.big{font-size:18px;}
.mt-badge{font-size:10px;font-weight:700;letter-spacing:1px;padding:2px 8px;border-radius:4px;}
.badge-long{background:rgba(34,197,94,.12);color:var(--grn);border:1px solid rgba(34,197,94,.25);}
.badge-short{background:rgba(239,68,68,.12);color:var(--red);border:1px solid rgba(239,68,68,.25);}
.mt-stage{font-size:10px;}
.mt-block{font-size:11px;padding:2px 8px;border-radius:4px;font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.block-exec{background:rgba(239,68,68,.15);color:var(--red);}
.block-bal{background:rgba(239,68,68,.1);color:#f97316;}
.block-min{background:rgba(234,179,8,.12);color:var(--yel);}
.block-other{background:var(--bg3);color:var(--dim);}

/* TIME — bigger and readable */
.mt-time{font-family:var(--mono);font-size:12px;letter-spacing:0.5px;}

/* CONFIDENCE BAR */
.mt-conf-bar{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.mt-conf-bar > div:first-child{flex:1;height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;position:relative;}
.mt-conf-fill{height:100%;border-radius:2px;transition:width .3s;}
.mt-conf-fill.hi{background:var(--grn);}
.mt-conf-fill.mid{background:var(--acc);}
.mt-conf-fill.lo{background:var(--red);}
.mt-conf-lbl{font-family:var(--mono);font-size:11px;font-weight:700;min-width:30px;text-align:right;}

/* METRICS GRID */
.mt-metrics{display:flex;gap:16px;flex-wrap:wrap;}
.mt-m{display:flex;flex-direction:column;gap:2px;}
.mt-ml{font-size:9px;letter-spacing:1px;color:var(--dim);font-weight:600;text-transform:uppercase;}
.mt-mv{font-size:12px;font-weight:600;}
.mt-pct{font-size:10px;color:var(--grn);margin-left:3px;}

/* REGIME CLASSES */
.rc-bull{color:var(--grn)!important;}
.rc-bear{color:var(--red)!important;}
.rc-range{color:var(--yel)!important;}
.rc-squeeze{color:var(--acc)!important;}

/* RIGHT PANELS */
.mt-panel{background:var(--bg2);padding:14px 16px;border-bottom:1px solid var(--bdr);}
.mt-ph{font-family:var(--mono);font-size:10px;letter-spacing:2px;color:var(--dim);font-weight:700;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
.mt-close-btn{background:none;border:none;color:var(--dim);cursor:pointer;font-size:14px;padding:0 2px;transition:color .15s;}
.mt-close-btn:hover{color:var(--red);}

/* SYMBOL ROWS */
.mt-sym-row{display:flex;align-items:center;gap:8px;padding:5px 4px;border-radius:4px;cursor:pointer;transition:background .1s;}
.mt-sym-row:hover{background:var(--bg3);}
.mt-sym-sel{background:rgba(59,130,246,.1)!important;}
.mt-sr-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--acc);min-width:100px;}
.mt-sr-bar{flex:1;height:4px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.mt-sr-fill{height:100%;border-radius:2px;transition:width .4s;}
.mt-sr-fill.hi{background:var(--grn);}
.mt-sr-fill.mid{background:var(--acc);}
.mt-sr-fill.lo{background:var(--red);}
.mt-sr-cnt{font-family:var(--mono);font-size:12px;min-width:28px;text-align:right;}
.mt-sr-conf{font-family:var(--mono);font-size:11px;min-width:32px;text-align:right;}

/* REASON ROWS */
.mt-rr{display:flex;align-items:center;gap:8px;padding:4px 0;}
.mt-rr-name{font-size:11px;min-width:110px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.mt-rr-bar{flex:1;height:4px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.mt-rr-fill{height:100%;background:var(--red);border-radius:2px;opacity:.7;}
.mt-rr-cnt{font-family:var(--mono);font-size:11px;min-width:28px;text-align:right;}

/* DETAIL */
.mt-detail-top{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.mt-detail-time{font-family:var(--mono);font-size:12px;color:var(--txt);background:var(--bg3);padding:6px 10px;border-radius:6px;margin-bottom:8px;letter-spacing:.5px;}
.mt-block-box{font-size:11px;font-weight:600;padding:6px 10px;border-radius:6px;margin-bottom:10px;word-break:break-all;}
.mt-block-box.block-exec{background:rgba(239,68,68,.12);color:var(--red);border:1px solid rgba(239,68,68,.2);}
.mt-block-box.block-bal{background:rgba(249,115,22,.1);color:#f97316;border:1px solid rgba(249,115,22,.2);}
.mt-block-box.block-min{background:rgba(234,179,8,.1);color:var(--yel);border:1px solid rgba(234,179,8,.2);}
.mt-block-box.block-other{background:var(--bg3);color:var(--txt);border:1px solid var(--bdr);}
.mt-drows{display:flex;flex-direction:column;gap:0;margin-bottom:10px;}
.mt-drow{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--bdr);}
.mt-dl{font-size:11px;color:var(--dim);}
.mt-dv{font-size:12px;}
.mt-tps{margin-bottom:10px;}
.mt-tp-row{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--bdr);font-size:12px;}
.mt-ai-hint{display:flex;gap:8px;background:var(--bg3);border-radius:6px;padding:10px;font-size:12px;color:var(--dim);line-height:1.6;}

@@media(max-width:1000px){.mt-layout{grid-template-columns:1fr;}}
@@media(max-width:700px){.mt-header{flex-direction:column;gap:12px;}.mt-hstats{gap:14px;}}
</style>

@code {
    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> _all = new();
    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> _visible = new();
    VertexAutoTradeBinance8.Web.Models.MissedTradeRecord? _sel;
    string _selKey = "";
    string _activeFilter = "ALL";
    string _search = "";
    string _symFilter = "";
    string _sort = "time";
    string _topReason = "";
    Dictionary<string, List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord>> _symGroups = new();
    List<(string Reason, int Count)> _reasonGroups = new();
    record FilterDef(string Key, string Label, int Count);
    List<FilterDef> _filters = new();
    System.Threading.Timer? _timer;

    string Key(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
        => $"{r.Symbol}_{r.Time:yyyyMMddHHmmssfff}";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        }, null, 5000, 5000);
    }

    async Task Load()
    {
        var data = await MissedService.LoadAsync();
        if (data == null) return;
        _all = data.ToList();
        Rebuild();
    }

    void Rebuild()
    {
        _symGroups = _all.GroupBy(r=>r.Symbol)
            .OrderByDescending(g=>g.Count())
            .ToDictionary(g=>g.Key, g=>g.ToList());

        _reasonGroups = _all.GroupBy(r=>r.Reason)
            .Select(g=>(g.Key, g.Count()))
            .OrderByDescending(g=>g.Item2).ToList();

        _topReason = _reasonGroups.FirstOrDefault().Key ?? "";

        _filters = new()
        {
            new("ALL",   "All",         _all.Count),
            new("LONG",  "▲ Long",      _all.Count(r=>r.Side=="Buy")),
            new("SHORT", "▼ Short",     _all.Count(r=>r.Side=="Sell")),
            new("HIGH",  "Conf ≥70",    _all.Count(r=>r.Confidence>=70)),
            new("EXEC",  "Exec Fail",   _all.Count(r=>r.Reason.Contains("Exec"))),
            new("BAL",   "Low Balance", _all.Count(r=>r.Reason.Contains("Balance")||r.Reason.Contains("balance"))),
        };
        ApplyFilter();
    }

    void ApplyFilter()
    {
        var q = _all.AsEnumerable();
        if (!string.IsNullOrEmpty(_symFilter))
            q = q.Where(r=>r.Symbol==_symFilter);
        else if (!string.IsNullOrEmpty(_search))
        {
            var s = _search.ToUpperInvariant();
            q = q.Where(r=>r.Symbol.Contains(s)||r.Reason.ToUpperInvariant().Contains(s));
        }
        q = _activeFilter switch
        {
            "LONG"  => q.Where(r=>r.Side=="Buy"),
            "SHORT" => q.Where(r=>r.Side=="Sell"),
            "HIGH"  => q.Where(r=>r.Confidence>=70),
            "EXEC"  => q.Where(r=>r.Reason.Contains("Exec")),
            "BAL"   => q.Where(r=>r.Reason.Contains("Balance")||r.Reason.Contains("balance")),
            _       => q
        };
        _visible = (_sort switch
        {
            "conf" => q.OrderByDescending(r=>r.Confidence),
            "sym"  => q.OrderBy(r=>r.Symbol),
            _      => q.OrderByDescending(r=>r.Time)
        }).ToList();
    }

    void SetFilter(string f) { _activeFilter=f; _symFilter=""; ApplyFilter(); }
    void FilterSym(string s) { _symFilter=_symFilter==s?"":s; ApplyFilter(); }
    void ClearFilters() { _activeFilter="ALL"; _search=""; _symFilter=""; ApplyFilter(); }
    void OnSort(ChangeEventArgs e) { _sort=e.Value?.ToString()??"time"; ApplyFilter(); }

    void Select(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
    {
        if (_selKey==Key(r)){_sel=null;_selKey="";}
        else{_sel=r;_selKey=Key(r);}
    }

    // ── FORMATTING ────────────────────────────────────────
    string FmtP(decimal v)
    {
        if(v<=0) return "—";
        if(v>=1000) return v.ToString("F2");
        if(v>=1)    return v.ToString("F4");
        return v.ToString("G5");
    }

    string RegimeStr(MarketRegime r) => r switch
    {
        MarketRegime.StrongUpTrend   => "↑↑ Strong Bull",
        MarketRegime.UpTrend         => "↑ Bull",
        MarketRegime.StrongDownTrend => "↓↓ Strong Bear",
        MarketRegime.DownTrend       => "↓ Bear",
        MarketRegime.Squeeze         => "⊞ Squeeze",
        MarketRegime.Range           => "↔ Range",
        _ => "— Unknown"
    };

    string RegimeCls(MarketRegime r) => r switch
    {
        MarketRegime.StrongUpTrend or MarketRegime.UpTrend       => "rc-bull",
        MarketRegime.StrongDownTrend or MarketRegime.DownTrend   => "rc-bear",
        MarketRegime.Squeeze                                      => "rc-squeeze",
        MarketRegime.Range                                        => "rc-range",
        _ => "dim"
    };

    string BlockCls(string r)
    {
        if(r.Contains("Exec")||r.Contains("EXEC")||r.Contains("Failed")) return "block-exec";
        if(r.Contains("Balance")||r.Contains("balance")||r.Contains("BAL")) return "block-bal";
        if(r.Contains("Notional")||r.Contains("TOO_SMALL")||r.Contains("MIN")) return "block-min";
        return "block-other";
    }

    string ShortReason(string r) => r switch
    {
        var x when x.Contains("ExecFailed") || x.Contains("Exec Failed") || x.Contains("EXECUTION_FAILED") => "Exec Failed",
        var x when x.Contains("Balance is zero") || x.Contains("BalanceZero") => "Balance Zero",
        var x when x.Contains("InsufficientBalance") || x.Contains("INSUFFICIENT") => "Low Balance",
        var x when x.Contains("MinNotional") || x.Contains("TOO_SMALL") => "Min Notional",
        var x when x.Contains("DRY_RUN") => "Dry Run",
        var x when x.Contains("Cooldown") || x.Contains("COOLDOWN") => "Cooldown",
        var x when x.Contains("LiquidityGuard") => "Liq Guard",
        var x when x.Contains("SIDE_NOT") => "Side Blocked",
        var x when x.Contains("AI_BLOCK") || x.Contains("AI_PNL") => "AI Block",
        var x when x.Contains("OrderBookImbalance") => "OB Imbalance",
        var x when x.Contains("ADJUSTED_QTY") => "Qty Adjusted",
        var x when x.Contains("StaleLimit") => "Stale Limit",
        var x when x.Contains("EntryError") => "Entry Error",
        _ => r.Length > 22 ? r[..22] + "…" : r
    };

    string AiHint(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
    {
        var h = new System.Text.StringBuilder();
        if(r.Confidence>=80) h.Append("Strong signal. ");
        else if(r.Confidence>=60) h.Append("Decent setup. ");
        else h.Append("Weak signal. ");
        h.Append(r.Regime switch {
            MarketRegime.StrongUpTrend => "Strong bull trend — momentum favors long. ",
            MarketRegime.UpTrend => "Uptrend in play. ",
            MarketRegime.StrongDownTrend => "Strong bear trend. ",
            MarketRegime.Range => "Range market — mean reversion setup. ",
            MarketRegime.Squeeze => "Squeeze — breakout expected soon. ",
            _ => ""
        });
        if(r.Reason.Contains("Exec")) h.Append("Order failed at execution — may be API issue or balance.");
        else if(r.Reason.Contains("Balance")) h.Append("Blocked by low balance — deposit more USDT to catch this.");
        else if(r.Reason.Contains("Notional")) h.Append("Min notional not met — this symbol needs larger capital per trade.");
        return h.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
