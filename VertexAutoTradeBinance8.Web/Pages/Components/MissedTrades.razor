@page "/missed-trades"

@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject MissedTradeFileService MissedService

<div class="missed-container">

    <div class="missed-title">Пропущенные сделки</div>
    <div class="missed-sub">Последние пропущенные попытки входа</div>

    <!-- === FILTER PANEL === -->
    <div class="filter-chips">

        <div class="@ChipClass("ALL")"
             @onclick="@(() => SetFilter("ALL"))">
            Все
        </div>

        <div class="@ChipClass("BAL")"
             @onclick="@(() => SetFilter("BAL"))">
            Недостаточно баланса
        </div>

        <div class="@ChipClass("MIN")"
             @onclick="@(() => SetFilter("MIN"))">
            MinNotional
        </div>

        <div class="@ChipClass("LONG")"
             @onclick="@(() => SetFilter("LONG"))">
            LONG
        </div>

        <div class="@ChipClass("SHORT")"
             @onclick="@(() => SetFilter("SHORT"))">
            SHORT
        </div>

        <div class="@ChipClass("HIGH")"
             @onclick="@(() => SetFilter("HIGH"))">
            Score > 70
        </div>

    </div>




    @if (_records == null)
    {
        <div>Загрузка...</div>
    }
    else if (_records.Count == 0)
    {
        <div>Файл пуст.</div>
    }
    else
    {
        <div class="layout-grid">

            <!-- === LEFT SIDE — CARDS === -->
            <div class="left-cards">

                @{
                    // счётчики по символам для компакт-режима
                    var perSymbolIndex = new Dictionary<string, int>();
                }

                <div class="missed-grid">
                    @foreach (var r in FilteredRecords
                                    .OrderByDescending(x => x.Time)   // всегда самые свежие
                                    .Take(15))                         // показываем только 10 (можешь поменять)
                    {
                        var score = CalcScore(r);

                        // номер записи для данного символа
                        var idx = perSymbolIndex.TryGetValue(r.Symbol, out var val) ? val : 0;
                        perSymbolIndex[r.Symbol] = idx + 1;

                        var totalForSymbol = SymbolCounts.TryGetValue(r.Symbol, out var total) ? total : 0;
                        var isCompact = totalForSymbol > 3 && idx >= 3;

                        var cardClasses =
                        "missed-card " +
                        (isCompact ? "missed-card-compact " : "") +
                        (NewFlash.Contains(Key(r)) ? "flash-new" : "");

                        
                            <div class="@cardClasses ai-hint" title="@AiHint(r.Score)">

                            <div class="missed-header">
                                <div>
                                    <div class="missed-symbol">@r.Symbol</div>
                                    <div class="missed-date">@r.Time.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                                </div>

                                <span class="badge @(r.Reason == "BelowMinNotional" ? "badge-yellow" : "badge-red")">
                                    @TranslateReason(r.Reason)
                                </span>
                            </div>

                            <!-- SCORE BADGE -->
                            <div class="score-block @ScoreColor(r.Score)">
                                Opportunity Score: <b>@r.Score</b>/100
                            </div>

                            <!-- LIQUIDITY RISK BLOCK (большая полоса) -->
                            <div class="liquidity-block @LiquidityColor(r)">
                                <div class="liq-title">
                                    ⚠ Liquidity Danger (@LiquiditySeverity(r))
                                </div>

                                <div class="liq-bar">
                                    @for (var i = 0; i < LiquidityBars(r); i++)
                                    {
                                        <span class="liq-bar-fill"></span>
                                    }
                                    @for (var i = LiquidityBars(r); i < 10; i++)
                                    {
                                        <span class="liq-bar-empty"></span>
                                    }
                                </div>

                                <div class="liq-tip">
                                    (Наведи мышку, чтобы увидеть детали)
                                </div>
                            </div>

                            <div class="missed-body">

                                <!-- SIDE -->
                                <div class="value-block">
                                    <span class="v-label">Side:</span>
                                    @if (r.Side == "Buy")
                                    {
                                        <span class="tag-long">LONG</span>
                                    }
                                    else
                                    {
                                        <span class="tag-short">SHORT</span>
                                    }
                                </div>

                                <!-- Entry / SL -->
                                <div class="value-block">
                                    <span class="v-label">Вход:</span>
                                    <span class="v-val">@F(r.Symbol, r.Entry)</span>
                                </div>

                                <div class="value-block">
                                    <span class="v-label">SL:</span>
                                    <span class="v-sl">@F(r.Symbol, r.StopLoss)</span>
                                </div>
                                <!-- ATR / Vol -->
                                <div class="value-block mt-1">
                                    <span class="v-label">ATR:</span>
                                    <span class="v-atr">@r.ATR.ToString("F2")</span>
                                </div>

                                <div class="value-block">
                                    <span class="v-label">Vol:</span>
                                    <span class="v-vol">@($"{r.Vol:P2}")</span>   <!-- 1.23% -->
                                </div>

                                <!-- TPs -->
                                <div class="value-block mt-2">
                                    <div class="v-label">TPs:</div>
                                    <div class="tp-list">
                                        @foreach (var tp in r.TakeProfits)
                                        {
                                            <span>@F(r.Symbol, tp)</span>
                                        }
                                    </div>
                                </div>

                                <!-- === LIQUIDITY + SMART REGIME + CONFIDENCE TAGS === -->
                                <div class="flex gap-2 mt-3">

                                    @{
                                        var sev = LiquiditySeverity(r);         // HIGH / MEDIUM / LOW
                                        var liqClass = LiquidityClass(sev);    // CSS класс для цвета
                                    }

                                    <!-- Ликвидность tag -->
                                    <span class="@liqClass">
                                        Liquidity: @sev
                                    </span>

                                    <!-- Smart regime tag -->
                                    <span class="@SmartClass(r.Regime)">
                                        @r.Regime
                                    </span>
                                </div>

                                <!-- CONFIDENCE BAR -->
                                <div class="conf-bar mt-2">
                                    <div class="conf-fill" style="width:@r.Confidence%"></div>
                                </div>

                                <!-- INTENSITY / SPARKLINE -->
                                <div class="value-block mt-2">
                                    <div class="v-label">Интенсивность попытки:</div>
                                    <div class="sparkline">
                                        @{
                                            var ratio = r.RequiredMinNotional > 0
                                            ? (double)(r.AttemptNotional / r.RequiredMinNotional)
                                            : 0.0;
                                            var bars = Math.Clamp((int)Math.Round(ratio * 3), 1, 5);
                                        }
                                        @for (var i = 0; i < bars; i++)
                                        {
                                            <span class="spark-bar"></span>
                                        }
                                    </div>
                                </div>

                                <!-- BALANCE -->
                                <div class="balance-info mt-3">
                                    Баланс: <b>@Money(r.FreeBalance)</b><br />
                                    Попытка Notional: <b class="notional">@Money(r.AttemptNotional)</b><br />
                                    Min Binance: <b class="min-notional">@Money(r.RequiredMinNotional)</b>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- === RIGHT SIDE — AI SUMMARY === -->
            <div class="ai-summary">
                <div class="summary-title">AI Summary (24h)</div>

                <div class="summary-item">
                    Всего пропусков: <b>@_records.Count</b>
                </div>

                <div class="summary-item">
                    High-Score (&gt;70): <b>@_records.Count(x => CalcScore(x) > 70)</b>
                </div>

                <div class="summary-item">
                    Лучшая упущенная сделка:
                    <b>@BestSymbol</b> (Score @BestScore)
                </div>

                <div class="summary-item">
                    Наиболее частый символ:
                    <b>@TopSymbol</b>
                </div>

                <div class="summary-item">
                    Основная причина:
                    <b>@TranslateReason(TopReason)</b>
                </div>
            </div>

        </div>
    }
</div>


@code {
    private List<MissedTradeRecord>? _records;
    private List<MissedTradeRecord> FilteredRecords = new();
    private Dictionary<string, int> SymbolCounts = new();

    private HashSet<string> _known = new();
    private HashSet<string> NewFlash = new();
    private System.Threading.Timer? _timer;

    private string CurrentFilter = "ALL";

    string Key(MissedTradeRecord r) => $"{r.Symbol}-{r.Time:yyyyMMddHHmmss.ffff}";
    string LiquiditySeverity(MissedTradeRecord r)
    {
        if (r.ATR > 200 && r.Vol < 0.01m) return "HIGH";   // опасно
        if (r.ATR > 100 && r.Vol < 0.02m) return "MEDIUM";
        return "LOW";
    }

    string LiquidityClass(string sev)
    {
        return sev switch
        {
            "HIGH" => "liq-high",
            "MEDIUM" => "liq-med",
            _ => "liq-low"
        };
    }

  
    string AiHint(int score)
    {
        if (score >= 80)
            return "AI: Отличный сигнал. Сильный тренд и низкие риски. Такой вход обоснован.";

        if (score >= 65)
            return "AI: В целом хороший сигнал. Можно рассматривать вход с аккуратным стопом.";

        if (score >= 50)
            return "AI: Сигнал среднего качества. Лучше дождаться более чёткого подтверждения.";

        if (score >= 35)
            return "AI: Сигнал слабый. Условия неидеальные. Вход не рекомендуется.";

        return "AI: Высокие риски. Лучше избегать этот вход.";
    }


    string LiquidityColor(MissedTradeRecord r)
    {
        var sev = LiquiditySeverity(r);
        return sev switch
        {
            "HIGH" => "liq-high",
            "MEDIUM" => "liq-med",
            _ => "liq-low",
        };
    }

    string SmartClass(string t)
    {
        if (t.Contains("StrongTrend")) return "smart-strong";
        if (t.Contains("Squeeze")) return "smart-squeeze";
        if (t.Contains("Chop")) return "smart-chop";
        return "smart-strong";
    }

    int LiquidityBars(MissedTradeRecord r)
    {
        // Нормализуем уровень ликвидности от 1 до 10
        double LQ = (double)(r.ATR / (r.Vol + 0.0001m));

        if (LQ > 300) return 10;
        if (LQ > 200) return 8;
        if (LQ > 150) return 6;
        if (LQ > 100) return 4;
        if (LQ > 50) return 2;
        return 1;
    }

    protected override async Task OnInitializedAsync()
    {

        await LoadData();

        _timer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await Refresh();
                    ApplyFilter();
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        _records = await MissedService.LoadAsync() ?? new List<MissedTradeRecord>();

        foreach (var r in _records)
            _known.Add(Key(r));

        RebuildSymbolCounts();
        ApplyFilter();
    }

    private async Task Refresh()
    {
        var newRecords = await MissedService.LoadAsync();
        if (newRecords == null) return;

        var newOnes = newRecords.Where(r => !_known.Contains(Key(r))).ToList();

        if (newOnes.Count > 0)
        {
            foreach (var r in newOnes)
                _known.Add(Key(r));

            NewFlash = newOnes.Select(r => Key(r)).ToHashSet();
        }

        _records = newRecords;
        RebuildSymbolCounts();
        ApplyFilter();
    }

    private void RebuildSymbolCounts()
    {
        if (_records == null)
        {
            SymbolCounts = new();
            return;
        }

        SymbolCounts = _records
            .GroupBy(x => x.Symbol)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private void ApplyFilter()
    {
        if (_records == null)
        {
            FilteredRecords = new();
            return;
        }

        FilteredRecords = CurrentFilter switch
        {
            "BAL" => _records.Where(x => x.Reason.Contains("InsufficientBalance")).ToList(),
            "MIN" => _records.Where(x => x.Reason.Contains("MinNotional")).ToList(),
            "LONG" => _records.Where(x => x.Side == "Buy").ToList(),
            "SHORT" => _records.Where(x => x.Side == "Sell").ToList(),
            "HIGH" => _records.Where(x => x.Score > 70).ToList(),
            _ => _records
        };



    }
    int CalcScore(MissedTradeRecord r)
    {
        int score = 0;

        if (r.TakeProfits.Count >= 2) score += 20;
        if (r.AttemptNotional > r.RequiredMinNotional * 3) score += 20;
        if (r.Side == "Buy") score += 10;
        if (r.Reason.Contains("InsufficientBalance")) score += 20;
        if (r.AttemptNotional > 10) score += 30;

        return Math.Clamp(score, 0, 100);
    }
    void SetFilter(string f)
    {
        CurrentFilter = f;
        ApplyFilter();
    }
    string ChipClass(string f)
    {
        bool active = CurrentFilter == f;

        return "chip " + (active ? "chip-active" : "");
    }
    string GetFilterClass(string key)
    {
        return CurrentFilter == key ? "active" : "";
    }


    
 

    string ScoreColor(int score)
    {
        if (score >= 80) return "score-green";
        if (score >= 60) return "score-blue";
        if (score >= 40) return "score-yellow";
        return "score-red";
    }

    string BestSymbol => _records?.OrderByDescending(x => CalcScore(x)).FirstOrDefault()?.Symbol ?? "-";
    int BestScore => _records?.Max(x => CalcScore(x)) ?? 0;
    string TopSymbol => _records?.GroupBy(x => x.Symbol).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "-";
    string TopReason => _records?.GroupBy(x => x.Reason).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "-";

    string TranslateReason(string r) => r switch
    {
        "BelowMinNotional" => "Сумма ниже MinNotional",
        "InsufficientBalance" => "Недостаточно баланса",
        "InsufficientBalanceForMinNotional" => "Недостаточно для MinNotional",
        _ => r
    };

    string F(decimal v)
    {
        if (v >= 1) return v.ToString("F4");
        return v.ToString("0.00000000");
    }

    string Money(decimal v)
    {
        if (v >= 1) return v.ToString("F2") + " USDT";
        return v.ToString("0.00000000");
    }

    string F(string symbol, decimal v) => F(v);

  

}
