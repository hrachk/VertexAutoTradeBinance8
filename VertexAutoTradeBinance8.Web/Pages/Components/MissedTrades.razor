@page "/missed-trades"

@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject MissedTradeFileService MissedService

<h2 class="text-3xl font-bold mb-6">Пропущенные сделки</h2>

@if (_records == null)
{
    <div>Загрузка...</div>
    return;
}

@if (_records.Count == 0)
{
    <div>Файл пуст.</div>
    return;
}

<!-- ==== КАРТОЧКИ ПОСЛЕДНИХ СДЕЛОК ==== -->
<h3 class="text-2xl font-bold mb-3 mt-10">Последние пропущенные сделки</h3>

<div class="missed-grid">
    @foreach (var r in _records.OrderByDescending(x => x.Time).Take(40))
    {
        <div class="missed-card @(NewFlash.Contains(Key(r)) ? "flash-new" : "")">
            <div class="missed-header">
                <div>
                    <div class="missed-symbol">@r.Symbol</div>
                    <div class="value-time">@r.Time.ToLocalTime()</div>
                </div>

                <span class="missed-badge @(r.Reason == "BelowMinNotional" ? "badge-min" : "badge-balance")">
                    <span class="badge-reason">@TranslateReason(r.Reason)</span>
                </span>
            </div>

            <div class="missed-body">
                <div>
                    Side:
                    @if (r.Side == "Buy")
                    {
                        <span class="side-long">LONG</span>
                    }
                    else
                    {
                        <span class="side-short">SHORT</span>
                    }
                </div>

               
                <div>Вход: <b class="value-entry">@F(r.Symbol, r.Entry)</b></div>
                <div>SL: <b class="value-sl">@F(r.Symbol, r.StopLoss)</b></div>
                <!-- TPs -->
                <div class="mt-2">
                    <div class="text-gray-400 text-xs">TPs:</div>
                    <div class="flex flex-wrap gap-2 mt-1">
                        @foreach (var tp in r.TakeProfits)
                        {
                            <span class="value-tp">@F(r.Symbol, tp)</span>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    Баланс: <span class="value-balance">@Money(r.FreeBalance)</span>
                    Попытка Notional:
                    <span class="value-notional-orange">@Money(r.AttemptNotional)</span>
                    Min Binance:
                    <span class="value-notional-yellow">@Money(r.RequiredMinNotional)</span>


                </div>
            </div>
        </div>
    }
</div>


<!-- ==== ГРУППИРОВКА ==== -->
<h3 class="text-2xl font-bold mb-3 mt-10">По символам</h3>

<div class="space-y-4">
    @foreach (var kv in GroupedBySymbol)
    {
        var symbol = kv.Key;
        var list = kv.Value;

        <div class="missed-expand">
            <button class="w-full flex justify-between items-center text-left"
                    @onclick="@(() => Toggle(symbol))">
                <div class="missed-symbol">@symbol</div>
                <div class="missed-time">@list.Count пропусков</div>
            </button>

            @if (Expanded.Contains(symbol))
            {
                <div class="mt-4">
                    @foreach (var r in list.OrderByDescending(x => x.Time))
                    {
                        <div class="missed-expand-entry">
                            <div class="missed-time">@r.Time.ToLocalTime()</div>

                            <!-- SIDE -->
                            <div>
                                @if (r.Side == "Buy")
                                {
                                    <span class="value-green font-bold">LONG</span>
                                }
                                else
                                {
                                    <span class="value-red font-bold">SHORT</span>
                                }
                            </div>

                            <!-- BASIS -->
                            <div class="value-red">@TranslateReason(r.Reason)</div>

                            <div>Entry: <b>@F(r.Entry)</b></div>
                            <div>SL: <b>@F(r.StopLoss)</b></div>

                            <!-- TPs -->
                            <div class="mt-2 flex flex-wrap gap-2">
                                @foreach (var tp in r.TakeProfits)
                                {
                                    <span class="px-2 py-1 bg-gray-700 text-green-300 rounded text-xs"><b>@F(tp)</b></span>
                                }
                            </div>

                            <div>Balance: <b class="value-green">@F(r.FreeBalance)</b></div>
                            <div>Attempt: <b class="value-yellow">@F(r.AttemptNotional)</b></div>
                            <div>MinNeeded: <b class="value-red">@F(r.RequiredMinNotional)</b></div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MissedTradeRecord>? _records;
    private Dictionary<string, List<MissedTradeRecord>> GroupedBySymbol;
    private HashSet<string> Expanded = new();
    private Dictionary<string, decimal> TickSizes = new();
    private System.Threading.Timer? _timer;
    private HashSet<string> _knownTradeIds = new(); // уникальные подписи

    private HashSet<string> _known = new(); // ID всех известных записей
    private HashSet<string> NewFlash = new();

    string Key(MissedTradeRecord r)
        => $"{r.Symbol}-{r.Time:yyyyMMddHHmmss.ffff}";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        // === AUTO-REFRESH EVERY 5 SECONDS ===
        _timer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await Refresh();
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
      
    }
    private async Task LoadData()
    {
        _records = await MissedService.LoadAsync();

        // регистрируем все существующие записи (чтобы они не мигали как новые)
        foreach (var r in _records)
            _known.Add(Key(r));

        GroupedBySymbol = _records
            .GroupBy(x => x.Symbol)
            .ToDictionary(g => g.Key, g => g.ToList());
    }
    private async Task Refresh()
    {
        var newRecords = await MissedService.LoadAsync();
        if (newRecords == null || newRecords.Count == 0)
            return;

        // ищем новые записи
        var newOnes = newRecords
            .Where(r => !_known.Contains(Key(r)))
            .ToList();

        if (newOnes.Count > 0)
        {
            // регистрируем
            foreach (var r in newOnes)
                _known.Add(Key(r));

            // запускаем анимацию только для новых карточек
            NewFlash = newOnes
                .Select(r => Key(r))
                .ToHashSet();
        }

        _records = newRecords;

        GroupedBySymbol = _records
            .GroupBy(x => x.Symbol)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    void Toggle(string symbol)
    {
        if (!Expanded.Add(symbol))
            Expanded.Remove(symbol);
    }

    string TranslateReason(string r)
        => r switch
        {
            "BelowMinNotional" => "Меньше минимальная сумма сделки",
            "InsufficientBalance" => "Недостаточно баланса",
            "InsufficientBalanceForMinNotional" => "Недостаточно средств для минимальной сделки",
            _ => r
        };

    string F(decimal v)
    {
        if (v >= 1000)
            return v.ToString("F2");      // напр. 3047.03

        if (v >= 1)
            return v.ToString("F4");      // напр. 47.1234

        if (v >= 0.01m)
            return v.ToString("F6");      // напр. 0.123456

        return v.ToString("0.##########"); // мелкие значения
    }
    string Money(decimal v)
    {
        if (v >= 1)
            return v.ToString("F2") + " USDT";

        return v.ToString("0.00000000");
    }

    decimal GetTick(string symbol)
    {
        if (TickSizes.TryGetValue(symbol, out var tick))
            return tick;

        return 0.0001m; // fallback
    }
    string F(string symbol, decimal v)
    {
        decimal tick = GetTick(symbol);

        if (tick > 0)
        {
            int precision =
                tick switch
                {
                    >= 1m => 0,
                    >= 0.1m => 1,
                    >= 0.01m => 2,
                    >= 0.001m => 3,
                    >= 0.0001m => 4,
                    >= 0.00001m => 5,
                    >= 0.000001m => 6,
                    _ => 8
                };

            return Math.Round(v, precision).ToString($"F{precision}");
        }

        // fallback
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1) return v.ToString("F4");
        if (v >= 0.01m) return v.ToString("F6");

        return v.ToString("0.##########");
    }

}
