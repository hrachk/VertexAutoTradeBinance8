@page "/missed-trades"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Models
@inject MissedTradeFileService MissedService

<PageTitle>Signal Intelligence — Vertex</PageTitle>

<div class="si">

    <!-- HEADER -->
    <div class="si-header">
        <div class="si-title-block">
            <span class="si-icon">📡</span>
            <div>
                <div class="si-title">SIGNAL INTELLIGENCE</div>
                <div class="si-sub">Missed opportunities · Entry analysis · Pattern recognition</div>
            </div>
        </div>
        <div class="si-header-stats">
            <div class="si-hs"><div class="si-hs-val">@Total</div><div class="si-hs-lab">TOTAL SIGNALS</div></div>
            <div class="si-hs"><div class="si-hs-val hi">@HighConf</div><div class="si-hs-lab">HIGH CONF</div></div>
            <div class="si-hs"><div class="si-hs-val mid">@LongCount</div><div class="si-hs-lab">LONG</div></div>
            <div class="si-hs"><div class="si-hs-val bear">@ShortCount</div><div class="si-hs-lab">SHORT</div></div>
            <div class="si-hs"><div class="si-hs-val">@UniqueSymbols</div><div class="si-hs-lab">SYMBOLS</div></div>
            <div class="si-hs"><div class="si-hs-val lo">@BalBlocked</div><div class="si-hs-lab">BAL BLOCKED</div></div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="si-filters">
        @foreach (var f in Filters)
        {
            <button class="si-chip @(ActiveFilter == f.Key ? "si-chip-on" : "")"
                    @onclick="() => SetFilter(f.Key)">
                @f.Label
                @if (f.Count > 0)
                {
                    <span class="si-chip-cnt">@f.Count</span>
                }
            </button>
        }
        <div class="si-sort">
            <select @onchange="OnSortChange">
                <option value="time">Latest first</option>
                <option value="conf">High confidence</option>
                <option value="symbol">By symbol</option>
            </select>
        </div>
        <div class="si-search-wrap">
            <input class="si-search" placeholder="Search symbol..." @bind="_search" @bind:event="oninput" />
        </div>
    </div>

    @if (_records == null)
    {
        <div class="si-loading">
            <div class="si-spinner"></div>
            Loading signal data...
        </div>
    }
    else if (!Visible.Any())
    {
        <div class="si-empty">No signals match the filter</div>
    }
    else
    {
        <div class="si-layout">

            <!-- LEFT: SIGNAL CARDS -->
            <div class="si-cards-col">

                <!-- SUMMARY ROW -->
                <div class="si-summary-row">
                    <div class="si-sum-item">
                        <span class="si-sum-lab">Best missed</span>
                        <span class="si-sum-val hi">@BestSymbol</span>
                    </div>
                    <div class="si-sum-item">
                        <span class="si-sum-lab">Top reason</span>
                        <span class="si-sum-val warn">@ShortReason(TopReason)</span>
                    </div>
                    <div class="si-sum-item">
                        <span class="si-sum-lab">Most active</span>
                        <span class="si-sum-val mid">@TopSymbol</span>
                    </div>
                    <div class="si-sum-item">
                        <span class="si-sum-lab">Showing</span>
                        <span class="si-sum-val">@Math.Min(Visible.Count, 40) / @Visible.Count</span>
                    </div>
                </div>

                <!-- CARDS -->
                @foreach (var r in Visible.Take(40))
                {
                    bool isNew = NewFlash.Contains(Key(r));
                    bool isLong = r.Side == "Buy";
                    string regClass = RegClass(r.Regime);

                    <div class="si-card @(isNew ? "si-card-new" : "") @(SelectedRecord == Key(r) ? "si-card-sel" : "")"
                         @onclick="() => SelectCard(r)">

                        <!-- CARD TOP -->
                        <div class="si-card-top">
                            <div class="si-card-left">
                                <span class="si-csym @(isLong ? "bull" : "bear")">@r.Symbol</span>
                                <span class="si-ctime">@r.Time.ToLocalTime().ToString("MM/dd HH:mm:ss")</span>
                            </div>
                            <div class="si-card-right">
                                <span class="si-side @(isLong ? "lng" : "sht")">@(isLong?"LONG":"SHORT")</span>
                                <span class="si-reason @ReasonClass(r.Reason)">@ShortReason(r.Reason)</span>
                                @if (isNew) { <span class="si-new-badge">NEW</span> }
                            </div>
                        </div>

                        <!-- CONFIDENCE BAR -->
                        <div class="si-cbar-wrap">
                            <div class="si-cbar" style="width:@r.Confidence%;background:@ConfColor(r.Confidence)"></div>
                        </div>

                        <!-- CARD METRICS -->
                        <div class="si-card-metrics">
                            <div class="si-cm">
                                <span class="si-cm-lab">ENTRY</span>
                                <span class="si-cm-val">@Fmt(r.Entry)</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">SL</span>
                                <span class="si-cm-val lo">@Fmt(r.StopLoss)</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">CONF</span>
                                <span class="si-cm-val @ConfClass(r.Confidence)">@r.Confidence%</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">ATR</span>
                                <span class="si-cm-val">@r.ATR.ToString("F2")</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">VOL</span>
                                <span class="si-cm-val">@r.Vol.ToString("P1")</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">REGIME</span>
                                <span class="si-cm-val @regClass">@RegShort(r.Regime)</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">BAL</span>
                                <span class="si-cm-val">$@r.FreeBalance.ToString("F1")</span>
                            </div>
                            <div class="si-cm">
                                <span class="si-cm-lab">TPs</span>
                                <span class="si-cm-val hi">@r.TakeProfits.Count</span>
                            </div>
                        </div>

                        <!-- TP levels -->
                        @if (r.TakeProfits.Any())
                        {
                            <div class="si-tps">
                                @foreach (var (tp, i) in r.TakeProfits.Select((v,i)=>(v,i)))
                                {
                                    var pct = r.Entry > 0
                                        ? Math.Abs(tp - r.Entry) / r.Entry * 100m * (isLong ? 1 : -1)
                                        : 0m;
                                    <span class="si-tp @(i==0?"si-tp1":"")">
                                        TP@(i+1) @Fmt(tp)
                                        <span class="si-tp-pct">+@pct.ToString("F2")%</span>
                                    </span>
                                }
                            </div>
                        }

                    </div>
                }
            </div>

            <!-- RIGHT: DETAIL + STATS -->
            <div class="si-right-col">

                <!-- SYMBOL BREAKDOWN -->
                <div class="si-panel">
                    <div class="si-ph">📊 TOP SYMBOLS</div>
                    @foreach (var g in SymbolGroups.Take(10))
                    {
                        var pct = Total > 0 ? (double)g.Count / Total * 100 : 0;
                        var avgConf = (int)g.Items.Average(x => x.Confidence);
                        <div class="si-sym-row" @onclick="() => FilterBySymbol(g.Symbol)">
                            <span class="si-sg-sym">@g.Symbol</span>
                            <div class="si-sg-bar">
                                <div class="si-sg-fill @(avgConf>=70?"fill-hi":avgConf>=50?"fill-mid":"fill-lo")"
                                     style="width:@pct%"></div>
                            </div>
                            <span class="si-sg-cnt">@g.Count</span>
                            <span class="si-sg-conf @ConfClass(avgConf)">@avgConf%</span>
                        </div>
                    }
                </div>

                <!-- REASON BREAKDOWN -->
                <div class="si-panel">
                    <div class="si-ph">🚫 BLOCK REASONS</div>
                    @foreach (var g in ReasonGroups)
                    {
                        var pct = Total > 0 ? (double)g.Count / Total * 100 : 0;
                        <div class="si-reason-row">
                            <span class="si-rr-name @ReasonClass(g.Reason)">@ShortReason(g.Reason)</span>
                            <div class="si-rr-bar">
                                <div class="si-rr-fill" style="width:@pct%"></div>
                            </div>
                            <span class="si-rr-cnt">@g.Count</span>
                        </div>
                    }
                </div>

                <!-- SELECTED DETAIL -->
                @if (_selected is not null)
                {
                    <div class="si-panel si-detail">
                        <div class="si-ph">
                            🔍 SIGNAL DETAIL
                            <button class="si-close" @onclick="ClearSelected">✕</button>
                        </div>
                        <div class="si-detail-grid">
                            <div class="si-drow"><span class="si-dl">Symbol</span><span class="si-dv blue">@_selected.Symbol</span></div>
                            <div class="si-drow"><span class="si-dl">Time</span><span class="si-dv">@_selected.Time.ToLocalTime().ToString("dd.MM HH:mm:ss")</span></div>
                            <div class="si-drow"><span class="si-dl">Side</span>
                                <span class="si-dv @(_selected.Side=="Buy"?"bull":"bear")">@(_selected.Side=="Buy"?"LONG":"SHORT")</span></div>
                            <div class="si-drow"><span class="si-dl">Reason</span><span class="si-dv warn">@_selected.Reason</span></div>
                            <div class="si-drow"><span class="si-dl">Stage</span><span class="si-dv">@_selected.Stage</span></div>
                            <div class="si-drow"><span class="si-dl">Entry</span><span class="si-dv">@Fmt(_selected.Entry)</span></div>
                            <div class="si-drow"><span class="si-dl">Stop Loss</span><span class="si-dv lo">@Fmt(_selected.StopLoss)</span></div>
                            <div class="si-drow"><span class="si-dl">Confidence</span><span class="si-dv @ConfClass(_selected.Confidence)">@_selected.Confidence%</span></div>
                            <div class="si-drow"><span class="si-dl">Regime</span><span class="si-dv @RegClass(_selected.Regime)">@_selected.Regime</span></div>
                            <div class="si-drow"><span class="si-dl">ATR</span><span class="si-dv">@_selected.ATR.ToString("F4")</span></div>
                            <div class="si-drow"><span class="si-dl">Volatility</span><span class="si-dv">@_selected.Vol.ToString("P2")</span></div>
                            <div class="si-drow"><span class="si-dl">Slope</span><span class="si-dv">@_selected.Slope.ToString("F4")</span></div>
                            <div class="si-drow"><span class="si-dl">Balance</span><span class="si-dv">$@_selected.FreeBalance.ToString("F2")</span></div>
                            <div class="si-drow"><span class="si-dl">Notional</span><span class="si-dv">$@_selected.AttemptNotional.ToString("F2")</span></div>
                            <div class="si-drow"><span class="si-dl">Min Notional</span><span class="si-dv">$@_selected.RequiredMinNotional.ToString("F2")</span></div>
                        </div>
                        @if (_selected!.TakeProfits.Any())
                        {
                            <div class="si-detail-tps">
                                <div class="si-dl" style="margin-bottom:6px">TAKE PROFITS</div>
                                @foreach (var tpItem in _selected!.TakeProfits.Select((v,idx)=>new{v,idx}))
                                {
                                    var tp = tpItem.v; var i = tpItem.idx;
                                    var pct = _selected!.Entry > 0
                                        ? Math.Abs(tp - _selected!.Entry) / _selected!.Entry * 100m
                                        : 0m;
                                    <div class="si-dtp">
                                        <span>TP@(i+1)</span>
                                        <span class="blue">@Fmt(tp)</span>
                                        <span class="hi">+@pct.ToString("F2")%</span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="si-ai-hint">
                            <div class="si-ai-icon">🤖</div>
                            <div class="si-ai-text">@AiHint(_selected!)</div>
                        </div>
                    </div>
                }

            </div>
        </div>
    }

</div>

<style>
:root{--bg:#0a0d12;--bg2:#111520;--bg3:#1a1f2e;--bdr:#1e2535;--acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#eab308;--txt:#e2e8f0;--dim:#64748b;--mono:'JetBrains Mono','Fira Code',monospace;}
html,body{background:var(--bg)!important;color:var(--txt);}
.si{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:40px;}

/* HEADER */
.si-header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.si-title-block{display:flex;align-items:center;gap:14px;}
.si-icon{font-size:28px;}
.si-title{font-family:var(--mono);font-size:17px;font-weight:700;letter-spacing:2px;color:var(--acc);}
.si-sub{font-size:11px;color:var(--dim);margin-top:3px;}
.si-header-stats{display:flex;gap:24px;}
.si-hs{text-align:center;}
.si-hs-val{font-family:var(--mono);font-size:20px;font-weight:700;}
.si-hs-lab{font-size:10px;letter-spacing:1px;color:var(--dim);}
.hi{color:var(--grn)!important;}
.mid{color:var(--acc)!important;}
.lo{color:var(--red)!important;}
.warn{color:var(--yel)!important;}
.bear{color:var(--red)!important;}
.bull{color:var(--grn)!important;}
.blue{color:var(--acc)!important;}

/* FILTERS */
.si-filters{display:flex;align-items:center;gap:8px;padding:12px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);flex-wrap:wrap;}
.si-chip{padding:5px 14px;background:var(--bg3);border:1px solid var(--bdr);border-radius:20px;color:var(--dim);font-size:12px;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:6px;}
.si-chip:hover{border-color:var(--acc);color:var(--txt);}
.si-chip-on{background:rgba(59,130,246,.15);border-color:var(--acc);color:var(--txt);}
.si-chip-cnt{background:var(--bg);border-radius:10px;padding:1px 6px;font-size:10px;}
.si-sort select{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:5px 10px;border-radius:6px;font-size:12px;}
.si-search{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:5px 12px;border-radius:6px;font-size:12px;width:150px;}
.si-search::placeholder{color:var(--dim);}

/* LOADING */
.si-loading{display:flex;align-items:center;gap:12px;padding:40px;color:var(--dim);}
.si-spinner{width:20px;height:20px;border:2px solid var(--bdr);border-top-color:var(--acc);border-radius:50%;animation:spin .8s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg);}}
.si-empty{text-align:center;padding:40px;color:var(--dim);}

/* LAYOUT */
.si-layout{display:grid;grid-template-columns:1fr 320px;gap:1px;background:var(--bdr);margin-top:1px;}
.si-cards-col{background:var(--bg);padding:16px 20px;display:flex;flex-direction:column;gap:10px;}
.si-right-col{background:var(--bg);display:flex;flex-direction:column;gap:1px;}

/* SUMMARY ROW */
.si-summary-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--bdr);border-radius:6px;overflow:hidden;margin-bottom:4px;}
.si-sum-item{background:var(--bg2);padding:10px 14px;display:flex;flex-direction:column;gap:3px;}
.si-sum-lab{font-size:10px;color:var(--dim);letter-spacing:1px;}
.si-sum-val{font-family:var(--mono);font-size:14px;font-weight:700;}

/* CARD */
.si-card{background:var(--bg2);border:1px solid var(--bdr);border-radius:8px;padding:14px;cursor:pointer;transition:all .15s;border-left:3px solid transparent;}
.si-card:hover{background:var(--bg3);border-color:#2a3550;}
.si-card-sel{border-left-color:var(--acc)!important;background:var(--bg3)!important;}
.si-card-new{animation:flashNew .8s ease;}
@@keyframes flashNew{0%,100%{background:var(--bg2);}50%{background:rgba(34,197,94,.08);}}
.si-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;}
.si-card-left{display:flex;flex-direction:column;gap:3px;}
.si-csym{font-family:var(--mono);font-size:15px;font-weight:700;}
.si-ctime{font-size:11px;color:var(--dim);}
.si-card-right{display:flex;align-items:center;gap:8px;}
.si-side{font-size:11px;font-weight:700;letter-spacing:1px;padding:2px 8px;border-radius:4px;}
.lng{background:rgba(34,197,94,.15);color:var(--grn);}
.sht{background:rgba(239,68,68,.15);color:var(--red);}
.si-reason{font-size:11px;padding:2px 8px;border-radius:4px;background:var(--bg3);}
.si-new-badge{background:var(--grn);color:#000;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;}

/* CONFIDENCE BAR */
.si-cbar-wrap{height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;margin-bottom:10px;}
.si-cbar{height:100%;border-radius:2px;transition:width .4s;}

/* CARD METRICS */
.si-card-metrics{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;margin-bottom:8px;}
.si-cm{display:flex;flex-direction:column;gap:2px;}
.si-cm-lab{font-size:9px;color:var(--dim);letter-spacing:.5px;}
.si-cm-val{font-family:var(--mono);font-size:11px;font-weight:600;}

/* TP LEVELS */
.si-tps{display:flex;gap:8px;flex-wrap:wrap;}
.si-tp{font-size:11px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);padding:2px 8px;border-radius:4px;color:var(--grn);}
.si-tp1{background:rgba(34,197,94,.2);border-color:rgba(34,197,94,.4);}
.si-tp-pct{color:var(--grn);margin-left:4px;font-size:10px;}

/* RIGHT PANELS */
.si-panel{background:var(--bg2);padding:16px 18px;border-bottom:1px solid var(--bdr);}
.si-ph{font-family:var(--mono);font-size:11px;letter-spacing:1.5px;color:var(--dim);font-weight:700;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;}
.si-close{background:none;border:none;color:var(--dim);cursor:pointer;font-size:14px;padding:0;}
.si-close:hover{color:var(--red);}

/* SYMBOL GROUPS */
.si-sym-row{display:flex;align-items:center;gap:8px;padding:5px 0;cursor:pointer;transition:background .1s;border-radius:4px;}
.si-sym-row:hover{background:var(--bg3);padding:5px 6px;}
.si-sg-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--acc);min-width:90px;}
.si-sg-bar{flex:1;height:4px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.si-sg-fill{height:100%;border-radius:2px;}
.fill-hi{background:var(--grn);}
.fill-mid{background:var(--acc);}
.fill-lo{background:var(--red);}
.si-sg-cnt{font-size:11px;color:var(--txt);min-width:24px;text-align:right;}
.si-sg-conf{font-family:var(--mono);font-size:11px;min-width:32px;text-align:right;}

/* REASON GROUPS */
.si-reason-row{display:flex;align-items:center;gap:8px;padding:5px 0;}
.si-rr-name{font-size:11px;min-width:100px;}
.si-rr-bar{flex:1;height:4px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.si-rr-fill{height:100%;background:var(--red);border-radius:2px;}
.si-rr-cnt{font-size:11px;color:var(--dim);}

/* DETAIL */
.si-detail-grid{display:flex;flex-direction:column;gap:6px;margin-bottom:12px;}
.si-drow{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid var(--bdr);}
.si-dl{font-size:11px;color:var(--dim);}
.si-dv{font-family:var(--mono);font-size:12px;}
.si-detail-tps{margin-bottom:12px;}
.si-dtp{display:flex;justify-content:space-between;padding:4px 0;font-size:12px;border-bottom:1px solid var(--bdr);}
.si-ai-hint{display:flex;gap:10px;background:var(--bg3);border-radius:6px;padding:10px;font-size:12px;color:var(--dim);line-height:1.5;}
.si-ai-icon{font-size:18px;}

/* REASON COLORS */
.rc-bal{color:var(--red);}
.rc-min{color:var(--yel);}
.rc-exec{color:var(--red);}
.rc-ok{color:var(--grn);}

@@media(max-width:1100px){.si-layout{grid-template-columns:1fr;}}
@@media(max-width:700px){.si-header{flex-direction:column;gap:12px;}.si-card-metrics{grid-template-columns:repeat(4,1fr);}}
</style>

@code {
    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord>? _records;
    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> Visible = new();
    VertexAutoTradeBinance8.Web.Models.MissedTradeRecord? _selected;
    string SelectedRecord = "";

    HashSet<string> _known = new();
    HashSet<string> NewFlash = new();
    System.Threading.Timer? _timer;

    string ActiveFilter = "ALL";
    string _sort = "time";
    string _search = "";
    string _symbolFilter = "";

    record FilterDef(string Key, string Label, int Count);
    List<FilterDef> Filters = new();

    record SymbolGroup(string Symbol, int Count, List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> Items);
    record ReasonGroup(string Reason, int Count);
    List<SymbolGroup> SymbolGroups = new();
    List<ReasonGroup> ReasonGroups = new();

    // stats
    int Total, HighConf, LongCount, ShortCount, UniqueSymbols, BalBlocked;
    string BestSymbol = "—", TopSymbol = "—", TopReason = "—";

    string Key(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r) => $"{r.Symbol}-{r.Time:yyyyMMddHHmmss.fff}";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    async Task LoadData()
    {
        _records = await MissedService.LoadAsync() ?? new();
        foreach (var r in _records) _known.Add(Key(r));
        Rebuild();
    }

    async Task Refresh()
    {
        var fresh = await MissedService.LoadAsync();
        if (fresh == null) return;
        var newOnes = fresh.Where(r => !_known.Contains(Key(r))).ToList();
        if (newOnes.Count > 0)
        {
            foreach (var r in newOnes) _known.Add(Key(r));
            NewFlash = newOnes.Select(Key).ToHashSet();
        }
        _records = fresh;
        Rebuild();
    }

    void Rebuild()
    {
        if (_records == null) return;

        // Stats
        Total = _records.Count;
        HighConf = _records.Count(r => r.Confidence >= 70);
        LongCount = _records.Count(r => r.Side == "Buy");
        ShortCount = _records.Count(r => r.Side == "Sell");
        UniqueSymbols = _records.Select(r => r.Symbol).Distinct().Count();
        BalBlocked = _records.Count(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance"));
        BestSymbol = _records.OrderByDescending(r => r.Confidence).FirstOrDefault()?.Symbol ?? "—";
        TopSymbol = _records.GroupBy(r => r.Symbol).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "—";
        TopReason = _records.GroupBy(r => r.Reason).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "—";

        // Filters
        Filters = new()
        {
            new("ALL",   "All",         Total),
            new("LONG",  "Long ▲",      LongCount),
            new("SHORT", "Short ▼",     ShortCount),
            new("HIGH",  "Conf > 70",   HighConf),
            new("BAL",   "Bal blocked", BalBlocked),
            new("MIN",   "MinNotional", _records.Count(r => r.Reason.Contains("MinNotional"))),
        };

        // Groups
        SymbolGroups = _records.GroupBy(r => r.Symbol)
            .Select(g => new SymbolGroup(g.Key, g.Count(), g.ToList()))
            .OrderByDescending(g => g.Count).ToList();

        ReasonGroups = _records.GroupBy(r => r.Reason)
            .Select(g => new ReasonGroup(g.Key, g.Count()))
            .OrderByDescending(g => g.Count).ToList();

        ApplyFilter();
    }

    void ApplyFilter()
    {
        if (_records == null) { Visible = new(); return; }

        var q = _records.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_symbolFilter))
            q = q.Where(r => r.Symbol == _symbolFilter);
        else if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(r => r.Symbol.Contains(_search.ToUpper()));

        q = ActiveFilter switch
        {
            "LONG"  => q.Where(r => r.Side == "Buy"),
            "SHORT" => q.Where(r => r.Side == "Sell"),
            "HIGH"  => q.Where(r => r.Confidence >= 70),
            "BAL"   => q.Where(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance")),
            "MIN"   => q.Where(r => r.Reason.Contains("MinNotional")),
            _       => q
        };

        Visible = (_sort switch
        {
            "conf"   => q.OrderByDescending(r => r.Confidence),
            "symbol" => q.OrderBy(r => r.Symbol),
            _        => q.OrderByDescending(r => r.Time)
        }).ToList();
    }

    void SetFilter(string f)
    {
        ActiveFilter = f;
        _symbolFilter = "";
        ApplyFilter();
    }

    void FilterBySymbol(string s)
    {
        _symbolFilter = _symbolFilter == s ? "" : s;
        ApplyFilter();
    }

    void OnSortChange(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "time";
        ApplyFilter();
    }

    void SelectCard(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
    {
        if (SelectedRecord == Key(r)) { _selected = null; SelectedRecord = ""; }
        else { _selected = r; SelectedRecord = Key(r); }
    }

    void ClearSelected() { _selected = null; SelectedRecord = ""; }

    string Fmt(decimal v) => v >= 1 ? v.ToString("F4") : v.ToString("0.00000000");

    string ConfColor(int c) => c >= 75 ? "#22c55e" : c >= 50 ? "#3b82f6" : "#ef4444";
    string ConfClass(int c) => c >= 75 ? "hi" : c >= 50 ? "mid" : "lo";

    string RegClass(MR r) => r switch
    {
        MarketRegime.StrongUpTrend or MarketRegime.UpTrend => "bull",
        MarketRegime.StrongDownTrend or MarketRegime.DownTrend => "bear",
        _ => "warn"
    };

    string RegShort(MR r) => r switch
    {
        MarketRegime.StrongUpTrend => "↑↑",
        MarketRegime.UpTrend => "↑",
        MarketRegime.StrongDownTrend => "↓↓",
        MarketRegime.DownTrend => "↓",
        MarketRegime.Squeeze => "⊞",
        MarketRegime.Range => "↔",
        _ => "?"
    };

    string ReasonClass(string r)
    {
        if (r.Contains("Balance") || r.Contains("balance")) return "rc-bal";
        if (r.Contains("MinNotional") || r.Contains("minNotional")) return "rc-min";
        if (r.Contains("EXEC") || r.Contains("FAIL")) return "rc-exec";
        return "";
    }

    string ShortReason(string r) => r switch
    {
        "BelowMinNotional" or "NO_BALANCE_OR_MIN_NOTIONAL"
            or "RISK:NO_BALANCE_OR_MIN_NOTIONAL" => "Min Notional",
        "InsufficientBalance" or "RISK:INSUFFICIENT_BALANCE" => "Low Balance",
        "InsufficientBalanceForMinNotional" => "Bal < MinNot",
        "EXECUTION_FAILED" or "EXEC:EXECUTION_FAILED" => "Exec Failed",
        "COOLDOWN_ACTIVE" => "Cooldown",
        "MAX_ACTIVE_ENTRIES" => "Max Entries",
        "GLOBAL_POSITION_CAP" => "Pos Cap",
        "DCA_CATCHING_KNIFE" => "Knife ⚠",
        "DCA_INSUFFICIENT_RETRACE" => "No Retrace",
        "GATE_0_5" => "Out of Range",
        "FUNDING_EXTREME_LONG_BLOCKED" => "Funding ⚠ L",
        "FUNDING_EXTREME_SHORT_BLOCKED" => "Funding ⚠ S",
        _ => r.Length > 20 ? r[..20] + "…" : r
    };

    string AiHint(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
    {
        var sb = new System.Text.StringBuilder();
        if (r.Confidence >= 80)
            sb.Append("Strong signal — high confidence entry. ");
        else if (r.Confidence >= 65)
            sb.Append("Good signal with decent setup. ");
        else if (r.Confidence >= 50)
            sb.Append("Mixed conditions — moderate quality. ");
        else
            sb.Append("Weak signal — better to wait. ");

        if (r.Regime == MarketRegime.StrongUpTrend || r.Regime == MarketRegime.UpTrend)
            sb.Append("Strong uptrend regime — momentum in favor. ");
        else if (r.Regime == MarketRegime.Range)
            sb.Append("Range regime — mean reversion play. ");
        else if (r.Regime == MarketRegime.Squeeze)
            sb.Append("Squeeze detected — breakout expected. ");

        if (r.Reason.Contains("Balance") || r.Reason.Contains("balance"))
            sb.Append("Blocked by insufficient balance — increase deposit to capture this.");
        else if (r.Reason.Contains("MinNotional"))
            sb.Append("Blocked by min notional — this symbol needs higher capital per trade.");

        return sb.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
