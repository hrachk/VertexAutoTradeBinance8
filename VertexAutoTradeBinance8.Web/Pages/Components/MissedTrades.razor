@page "/missed-trades"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Models
@inject MissedTradeFileService MissedService
@inject ExecutedSignalUiService ExecService
@implements IDisposable

<div class="vt-page-title">
    <div>
        <h1>Signals desk</h1>
        <p>Missed attempts · entered positions · auto 6s</p>
    </div>
    <span class="vt-badge ok">@_tick.ToLocalTime().ToString("HH:mm:ss")</span>
</div>

<div class="vt-card" style="margin-bottom:12px;">
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="vt-btn @(tab==0?"primary":"")" @onclick="() => tab=0">Missed (@_missed.Count)</button>
        <button class="vt-btn @(tab==1?"primary":"")" @onclick="() => tab=1">Entered (@_entered.Count)</button>
    </div>
</div>

@if (tab == 0)
{
    <div class="vt-card" style="margin-bottom:12px;">
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            @foreach (var f in new[] { "ALL", "BAL", "MIN", "LONG", "SHORT", "HIGH" })
            {
                <button class="vt-btn @(filter==f?"primary":"")" style="padding:4px 10px;font-size:12px;"
                        @onclick="() => SetFilter(f)">@f</button>
            }
        </div>
    </div>

    @if (FilteredMissed.Count() == 0)
    {
        <div class="vt-card"><div class="vt-empty"><div class="ico">○</div>Нет пропущенных сделок.</div></div>
    }
    else
    {
        <div class="sd-compact-grid">
            @foreach (var r in FilteredMissed.OrderByDescending(x => x.Time).Take(24))
            {
                var score = CalcScore(r);
                <div class="sd-mini">
                    <div class="sd-mini-h">
                        <strong>@r.Symbol</strong>
                        <span class="@(IsLong(r)?"pos":"neg")">@(IsLong(r)?"L":"S")</span>
                        <span class="vt-hint">@r.Time.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    <div class="sd-mini-b">
                        <span>sc @score</span>
                        <span class="vt-hint">@ShortReason(r)</span>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (_entered.Count == 0)
    {
        <div class="vt-card"><div class="vt-empty"><div class="ico">◎</div>Пока нет входов в позицию.</div></div>
    }
    else
    {
        <div class="sd-enter-grid">
            @foreach (var r in _entered.OrderByDescending(x => x.Time).Take(30))
            {
                <div class="sd-enter">
                    <div class="sd-enter-h">
                        <div>
                            <div class="sd-sym">@r.Symbol</div>
                            <div class="vt-hint">@r.Time.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                        </div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;">
                            <span class="vt-badge @(r.Side==SignalSide.Buy?"ok":"warn")">@(r.Side==SignalSide.Buy?"LONG":"SHORT")</span>
                            <span class="vt-badge info">@r.Status</span>
                        </div>
                    </div>
                    <div class="sd-prices">
                        <div><span class="lbl">Entry</span><span class="val">@r.Entry</span></div>
                        <div><span class="lbl">SL</span><span class="val">@r.StopLoss</span></div>
                        <div><span class="lbl">TP1</span><span class="val">@TpAt(r,0)</span></div>
                        <div><span class="lbl">TP2</span><span class="val">@TpAt(r,1)</span></div>
                        <div><span class="lbl">TP3</span><span class="val">@TpAt(r,2)</span></div>
                        <div><span class="lbl">Qty</span><span class="val">@r.Qty</span></div>
                    </div>
                    <div class="sd-meta">
                        <span>Notional @r.Notional.ToString("F2") USDT</span>
                        <span>Score @r.OpportunityScore/100</span>
                        <span>ATR @r.Atr.ToString("0.####")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.Reason))
                    {
                        <div class="sd-reason">@r.Reason</div>
                    }
                    @if (IsClosed(r))
                    {
                        <div class="sd-pnl @(((r.PnL??0)>=0)?"pos":"neg")">
                            PnL @((r.PnL??0).ToString("F4")) USDT
                            @if ((r.ExitPrice??0)>0) { <span>· exit @r.ExitPrice</span> }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

<style>
.sd-compact-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:8px; }
.sd-mini { background:var(--vt-bg-card); border:1px solid var(--vt-border); border-radius:8px; padding:8px 10px; }
.sd-mini-h { display:flex; gap:8px; align-items:center; font-size:13px; }
.sd-mini-b { display:flex; justify-content:space-between; margin-top:4px; font-size:11px; color:var(--vt-text-muted); }
.sd-enter-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; }
.sd-enter { background:var(--vt-bg-card); border:1px solid var(--vt-border); border-radius:12px; padding:14px 16px; display:flex; flex-direction:column; gap:10px; }
.sd-enter-h { display:flex; justify-content:space-between; gap:10px; }
.sd-sym { font-weight:700; font-size:16px; }
.sd-prices { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.sd-prices .lbl { display:block; font-size:10px; color:var(--vt-text-dim); text-transform:uppercase; }
.sd-prices .val { font-family:var(--vt-mono); font-size:13px; }
.sd-meta { display:flex; flex-wrap:wrap; gap:10px; font-size:11px; color:var(--vt-text-muted); }
.sd-reason { font-size:12px; color:var(--vt-text-muted); border-top:1px solid var(--vt-border-soft); padding-top:8px; }
.sd-pnl { font-weight:600; font-size:13px; }
.pos { color:var(--vt-green); font-weight:600; }
.neg { color:var(--vt-red); font-weight:600; }
</style>

@code {
    private int tab;
    private string filter = "ALL";
    private List<MissedTradeRecord> _missed = new();
    private List<ExecutedSignalRecord> _entered = new();
    private CancellationTokenSource? _cts;
    private DateTime _tick = DateTime.UtcNow;

    private IEnumerable<MissedTradeRecord> FilteredMissed => filter switch
    {
        "BAL" => _missed.Where(x => (x.Reason ?? "").Contains("balance", StringComparison.OrdinalIgnoreCase)
                                 || (x.Reason ?? "").Contains("баланс", StringComparison.OrdinalIgnoreCase)),
        "MIN" => _missed.Where(x => (x.Reason ?? "").Contains("notional", StringComparison.OrdinalIgnoreCase)
                                 || (x.Reason ?? "").Contains("MinNotional", StringComparison.OrdinalIgnoreCase)),
        "LONG" => _missed.Where(IsLong),
        "SHORT" => _missed.Where(x => !IsLong(x)),
        "HIGH" => _missed.Where(x => CalcScore(x) > 70),
        _ => _missed
    };

    protected override void OnInitialized()
    {
        Reload();
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }

    private async Task Loop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(6000, ct);
                Reload();
                _tick = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { break; }
            catch { }
        }
    }

    private void Reload()
    {
        try { _missed = MissedService.Load().ToList(); } catch { _missed = new(); }
        try
        {
            _entered = ExecService.GetAll()
                .Where(x => x.Status is TradeExecutionStatus.OrderCreated
                    or TradeExecutionStatus.OrderPartiallyFilled
                    or TradeExecutionStatus.PositionOpened
                    or TradeExecutionStatus.PositionClosedTp
                    or TradeExecutionStatus.PositionClosedSl
                    or TradeExecutionStatus.PositionClosedManual)
                .ToList();
        }
        catch { _entered = new(); }
    }

    private void SetFilter(string f) => filter = f;
    private static bool IsLong(MissedTradeRecord r)
    {
        var s = (r.Side ?? "").ToUpperInvariant();
        return s.Contains("BUY") || s.Contains("LONG");
    }
    private static int CalcScore(MissedTradeRecord r) => r.Score > 0 ? r.Score : r.Confidence;
    private static string ShortReason(MissedTradeRecord r)
    {
        var s = r.Reason ?? "";
        return s.Length <= 28 ? s : s[..28] + "…";
    }
    private static string TpAt(ExecutedSignalRecord r, int i)
        => r.TakeProfits != null && r.TakeProfits.Count > i ? r.TakeProfits[i].ToString("0.########") : "—";
    private static bool IsClosed(ExecutedSignalRecord r) =>
        r.Status is TradeExecutionStatus.PositionClosedTp
            or TradeExecutionStatus.PositionClosedSl
            or TradeExecutionStatus.PositionClosedManual;
    public void Dispose()
    {
        try { _cts?.Cancel(); _cts?.Dispose(); } catch { }
    }
}
