@page "/missed-trades"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@using MissedRec = VertexAutoTradeBinance8.Web.Models.MissedTradeRecord
@inject MissedTradeFileService Svc
@inject LiveSignalFileService LiveSignalSvc
@inject IConfiguration AppConfig
@inject VertexAutoTradeBinance8.Web.Services.ClientDataService ClientData
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject VertexAutoTradeBinance8.Web.Services.Auth.AuthSessionService Auth
@implements IDisposable

<PageTitle>Signal Log — Vertex</PageTitle>

<div class="sl">

    <!-- ═══ HEADER ══════════════════════════════════════════════ -->
    <div class="sl-header">
        <div class="sl-header-left">
            <div class="sl-title">📡 SIGNAL LOG</div>
            <div class="sl-sub">Blocked & failed trade signals · Auto-refresh 5s</div>
        </div>
        <div class="sl-header-stats">
            <div class="sl-hs">
                <div class="sl-hs-val">@_all.Count</div>
                <div class="sl-hs-lab">TOTAL</div>
            </div>
            <div class="sl-hs sl-hs-up">
                <div class="sl-hs-val">@_all.Count(r=>r.Side=="Buy")</div>
                <div class="sl-hs-lab">LONG ▲</div>
            </div>
            <div class="sl-hs sl-hs-dn">
                <div class="sl-hs-val">@_all.Count(r=>r.Side=="Sell")</div>
                <div class="sl-hs-lab">SHORT ▼</div>
            </div>
            <div class="sl-hs sl-hs-hi">
                <div class="sl-hs-val">@_all.Count(r=>r.Confidence>=70)</div>
                <div class="sl-hs-lab">HIGH CONF</div>
            </div>
            <div class="sl-hs sl-hs-err">
                <div class="sl-hs-val">@_execFail</div>
                <div class="sl-hs-lab">EXEC FAIL</div>
            </div>
        </div>
    </div>

    <!-- ═══ TOOLBAR ═════════════════════════════════════════════ -->
    <div class="sl-toolbar">
        <div class="sl-chips">
            @foreach (var f in _filters)
            {
                <button class="sl-chip @(_fKey==f.Key?"sl-chip-on":"")"
                        @onclick="()=>{_fKey=f.Key;_symFilter=string.Empty;Refilter();}">
                    @f.Label
                    <span class="sl-chip-n">@f.N</span>
                </button>
            }
        </div>
        <div class="sl-tools">
            <div class="sl-search-box">
                <span>⌕</span>
                <input class="sl-search" placeholder="Search symbol or reason..."
                       value="@_q" @oninput="OnSearch" />
                @if (!string.IsNullOrEmpty(_q) || !string.IsNullOrEmpty(_symFilter))
                {
                    <button class="sl-clear" @onclick="ClearSearch">✕</button>
                }
            </div>
            <select class="sl-select" @onchange="OnSort">
                <option value="time">Newest first</option>
                <option value="conf">Highest confidence</option>
                <option value="sym">By symbol</option>
            </select>
        </div>
    </div>

    <!-- ═══ BODY ═════════════════════════════════════════════════ -->
    @if (!_all.Any())
    {
        <div class="sl-empty">
            <div class="sl-empty-icon">📭</div>
            <div class="sl-empty-title">No signals recorded yet</div>
            <div class="sl-empty-sub">Blocked and failed signals appear here automatically as the bot runs</div>
        </div>
    }
    else
    {
        <div class="sl-layout">

            <!-- ── FEED ──────────────────────────── -->
            <div class="sl-feed">

                <!-- Symbol filter banner -->
                @if (!string.IsNullOrEmpty(_symFilter))
                {
                    <div class="sl-banner">
                        Showing only <b>@_symFilter</b> — @_filtered.Count signals
                        <button @onclick="()=>{_symFilter=string.Empty;Refilter();}">✕ Clear</button>
                    </div>
                }

                <div class="sl-feed-meta">
                    Showing <b>@Math.Min(_filtered.Count, 60)</b> of <b>@_filtered.Count</b> signals
                    @if (_filtered.Count > 60) { <span class="sl-dim"> · use filters to narrow down</span> }
                </div>

                @foreach (var r in _filtered.Take(60))
                {
                    bool isLong = r.Side == "Buy";
                    bool isSel  = _selId == SigId(r);
                    string ccls = r.Confidence >= 70 ? "cc-hi" : r.Confidence >= 50 ? "cc-mid" : "cc-lo";

                    <div class="sl-card @(isSel?"sl-sel":"") @(isLong?"sl-long":"sl-short")"
                         @onclick="()=>Toggle(r)">

                        <!-- ── ROW 1: Symbol + Side + Time + Reason ── -->
                        <div class="sl-row1">
                            <div class="sl-row1-left">
                                <!-- Symbol — biggest text, most important -->
                                <span class="sl-sym @(isLong?"sl-up":"sl-dn")">@r.Symbol</span>
                                <!-- Side badge -->
                                <span class="sl-side @(isLong?"side-l":"side-s")">
                                    @(isLong ? "▲ LONG" : "▼ SHORT")
                                </span>
                                <!-- Stage -->
                                <span class="sl-stage">@r.Stage</span>
                            </div>
                            <div class="sl-row1-right">
                                @if (r.Reason != null && r.Reason.Contains("_VWAP"))
                                {
                                    <span class="sl-confirm-badge" title="This signal's direction was confirmed by VWAP">VWAP✓</span>
                                }
                                @if (r.Reason != null && r.Reason.Contains("_HTF"))
                                {
                                    <span class="sl-confirm-badge" title="This signal's direction was confirmed by the higher-timeframe structure of the same symbol">HTF✓</span>
                                }
                                <!-- Block reason — color coded -->
                                <span class="sl-reason-badge @RCls(CleanReason(r.Reason))" title="@r.Reason">
                                    @SR(CleanReason(r.Reason))
                                </span>
                                <!-- Time — readable size -->
                                <span class="sl-time">@r.Time.ToLocalTime().ToString("dd.MM  HH:mm:ss")</span>
                            </div>
                        </div>

                        <!-- ── ROW 2: Confidence bar + Regime ── -->
                        <div class="sl-row2">
                            <div class="sl-conf-wrap">
                                <div class="sl-conf-track">
                                    <div class="sl-conf-bar @ccls" style="width:@r.Confidence%"></div>
                                </div>
                                <span class="sl-conf-pct @ccls">@r.Confidence%</span>
                            </div>
                            <span class="sl-regime @RegCls(r.Regime)">@RegStr(r.Regime)</span>
                        </div>

                        <!-- ── ROW 3: Key numbers ── -->
                        <div class="sl-nums">
                            <div class="sl-num">
                                <div class="sl-nl">Entry Price</div>
                                <div class="sl-nv">
                                    @FP(r.Entry)
                                    @if (r.EntryRangeLow.HasValue && r.EntryRangeHigh.HasValue)
                                    {
                                        <span class="sl-entry-range" title="Acceptable entry zone">(@FP(r.EntryRangeLow.Value)–@FP(r.EntryRangeHigh.Value))</span>
                                    }
                                </div>
                            </div>
                            <div class="sl-num">
                                <div class="sl-nl">Stop Loss</div>
                                <div class="sl-nv sl-dn">@FP(r.StopLoss)</div>
                            </div>
                            @if (r.TakeProfits.Count > 0)
                            {
                                var tp1 = r.TakeProfits[0];
                                var pct = r.Entry > 0 ? Math.Abs(tp1 - r.Entry) / r.Entry * 100m : 0m;
                                <div class="sl-num">
                                    <div class="sl-nl">TP1</div>
                                    <div class="sl-nv sl-up">@FP(tp1) <span class="sl-tpct">+@pct.ToString("F1")%</span></div>
                                </div>
                            }
                            <div class="sl-num">
                                <div class="sl-nl">ATR</div>
                                <div class="sl-nv">@r.ATR.ToString("G3")</div>
                            </div>
                            <div class="sl-num">
                                <div class="sl-nl">Volatility</div>
                                <div class="sl-nv">@r.Vol.ToString("P1")</div>
                            </div>
                            <div class="sl-num">
                                <div class="sl-nl">Balance</div>
                                <div class="sl-nv @(r.FreeBalance<5?"sl-dn":"")">$@r.FreeBalance.ToString("F1")</div>
                            </div>
                        </div>

                        <!-- ── EXPANDED DETAIL ── -->
                        @if (isSel)
                        {
                            <div class="sl-detail" @onclick:stopPropagation="true">
                                <div class="sl-detail-grid">
                                    <div class="sl-dr"><span class="sl-dl">Block Reason</span><span class="sl-dv @RCls(r.Reason)">@r.Reason</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Regime</span><span class="sl-dv @RegCls(r.Regime)">@RegStr(r.Regime)</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Slope</span><span class="sl-dv mono">@r.Slope.ToString("G4")</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Deviation</span><span class="sl-dv mono">@r.Deviation.ToString("G3")</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Notional</span><span class="sl-dv mono">$@r.AttemptNotional.ToString("F2")</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Min Notional</span><span class="sl-dv mono">$@r.RequiredMinNotional.ToString("F2")</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Smart Type</span><span class="sl-dv">@(r.SmartType.Length > 0 ? r.SmartType : "—")</span></div>
                                    <div class="sl-dr"><span class="sl-dl">Stage</span><span class="sl-dv">@r.Stage</span></div>
                                </div>
                                @if (r.TakeProfits.Count > 0)
                                {
                                    <div class="sl-tps">
                                        @foreach (var item in r.TakeProfits.Select((v, i) => new { v, i }))
                                        {
                                            var p2 = r.Entry > 0 ? Math.Abs(item.v - r.Entry) / r.Entry * 100m : 0m;
                                            <span class="sl-tp @(item.i==0?"sl-tp1":"")">
                                                TP@(item.i+1) @FP(item.v) <b>+@p2.ToString("F2")%</b>
                                            </span>
                                        }
                                    </div>
                                }
                                <div class="sl-hint">🤖 @Hint(r)</div>
                            </div>
                        }

                    </div>
                }
            </div>

            <!-- ── SIDEBAR ───────────────────────── -->
            <div class="sl-sidebar">

                <!-- TOP SYMBOLS -->
                <div class="sl-side-box">
                    <div class="sl-side-title">📊 TOP SYMBOLS</div>
                    @foreach (var g in _bySymbol.Take(12))
                    {
                        var pct = _all.Count > 0 ? g.Count * 100.0 / _all.Count : 0;
                        var cc  = g.AvgConf >= 70 ? "cc-hi" : g.AvgConf >= 50 ? "cc-mid" : "cc-lo";
                        <div class="sl-sr @(_symFilter==g.Symbol?"sl-sr-sel":"")"
                             @onclick="()=>ToggleSym(g.Symbol)">
                            <span class="sl-sr-sym">@g.Symbol</span>
                            <div class="sl-sr-track">
                                <div class="sl-sr-bar @cc" style="width:@Math.Min(100.0,pct*4)%"></div>
                            </div>
                            <span class="sl-sr-n">@g.Count</span>
                            <span class="sl-sr-conf @cc">@g.AvgConf%</span>
                        </div>
                    }
                </div>

                <!-- BLOCK REASONS -->
                <div class="sl-side-box">
                    <div class="sl-side-title">🚫 BLOCK REASONS</div>
                    @foreach (var g in _byReason.Take(10))
                    {
                        var pct = _all.Count > 0 ? g.Count * 100.0 / _all.Count : 0;
                        <div class="sl-rr">
                            <span class="sl-rr-name @RCls(g.Reason)" title="@g.Reason">@SR(g.Reason)</span>
                            <div class="sl-rr-track">
                                <div class="sl-rr-fill @RFill(g.Reason)" style="width:@Math.Min(100.0,pct*4)%"></div>
                            </div>
                            <span class="sl-rr-pct sl-dim">@pct.ToString("F0")%</span>
                            <span class="sl-rr-n">@g.Count</span>
                        </div>
                    }
                </div>

            </div>
        </div>
    }
</div>

<style>
:root{
    --bg:#0d1117;--bg2:#161b22;--bg3:#21262d;--bdr:#30363d;
    --grn:#3fb950;--red:#f85149;--acc:#1f6feb;--yel:#e3b341;
    --txt:#e6edf3;--dim:#8b949e;
    --mono:'JetBrains Mono','Fira Code',monospace;
}
html,body{background:var(--bg)!important;color:var(--txt);font-size:14px;}
.sl{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:48px;}
.sl-up{color:var(--grn)!important;}.sl-dn{color:var(--red)!important;}.sl-dim{color:var(--dim)!important;}.mono{font-family:var(--mono)!important;}
.cc-hi{color:var(--grn)!important;}.cc-mid{color:var(--acc)!important;}.cc-lo{color:var(--red)!important;}

/* HEADER */
.sl-header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.sl-title{font-size:20px;font-weight:700;letter-spacing:.5px;}
.sl-sub{font-size:12px;color:var(--dim);margin-top:3px;}
.sl-header-stats{display:flex;gap:20px;}
.sl-hs{text-align:center;padding:8px 16px;background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;min-width:80px;}
.sl-hs-val{font-family:var(--mono);font-size:22px;font-weight:700;}
.sl-hs-lab{font-size:10px;color:var(--dim);letter-spacing:1px;margin-top:2px;}
.sl-hs-up .sl-hs-val{color:var(--grn);}
.sl-hs-dn .sl-hs-val{color:var(--red);}
.sl-hs-hi .sl-hs-val{color:var(--grn);}
.sl-hs-err .sl-hs-val{color:var(--yel);}

/* TOOLBAR */
.sl-toolbar{display:flex;align-items:center;justify-content:space-between;padding:12px 28px;background:var(--bg2);border-bottom:1px solid var(--bdr);gap:12px;flex-wrap:wrap;}
.sl-chips{display:flex;gap:6px;flex-wrap:wrap;}
.sl-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 14px;background:var(--bg3);border:1px solid var(--bdr);border-radius:20px;color:var(--dim);font-size:13px;cursor:pointer;transition:all .15s;}
.sl-chip:hover{border-color:var(--acc);color:var(--txt);}
.sl-chip-on{background:rgba(31,111,235,.15);border-color:var(--acc);color:var(--txt);}
.sl-chip-n{font-family:var(--mono);font-size:11px;background:var(--bg);border-radius:10px;padding:1px 6px;}
.sl-tools{display:flex;gap:8px;}
.sl-search-box{display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;padding:0 10px;}
.sl-search{background:transparent;border:none;color:var(--txt);padding:7px 2px;font-size:13px;width:200px;outline:none;}
.sl-search::placeholder{color:var(--dim);}
.sl-clear{background:none;border:none;color:var(--dim);cursor:pointer;font-size:13px;padding:0 4px;}
.sl-clear:hover{color:var(--red);}
.sl-select{background:var(--bg3);border:1px solid var(--bdr);color:var(--txt);padding:7px 12px;border-radius:8px;font-size:13px;}

/* EMPTY */
.sl-empty{display:flex;flex-direction:column;align-items:center;gap:12px;padding:80px 20px;color:var(--dim);text-align:center;}
.sl-empty-icon{font-size:48px;}
.sl-empty-title{font-size:18px;font-weight:600;color:var(--txt);}
.sl-empty-sub{font-size:13px;}

/* LAYOUT */
.sl-layout{display:grid;grid-template-columns:1fr 280px;min-height:calc(100vh - 130px);}
.sl-feed{background:var(--bg);border-right:1px solid var(--bdr);}
.sl-sidebar{background:var(--bg);}

/* BANNER + META */
.sl-banner{display:flex;align-items:center;gap:8px;padding:10px 20px;background:rgba(31,111,235,.08);border-bottom:1px solid var(--bdr);font-size:13px;color:var(--dim);}
.sl-banner b{color:var(--acc);}
.sl-banner button{background:none;border:1px solid var(--bdr);border-radius:10px;color:var(--dim);padding:1px 8px;font-size:12px;cursor:pointer;margin-left:auto;}
.sl-feed-meta{padding:10px 20px 6px;font-size:12px;color:var(--dim);border-bottom:1px solid var(--bdr);}
.sl-feed-meta b{color:var(--txt);}

/* ── SIGNAL CARD ──────────────────────────────── */
.sl-card{
    padding:14px 20px;border-bottom:1px solid var(--bdr);
    cursor:pointer;transition:background .1s;
    border-left:3px solid transparent;
}
.sl-card:hover{background:rgba(255,255,255,.02);}
.sl-sel{background:var(--bg2)!important;}
.sl-long:hover,.sl-sel.sl-long{border-left-color:var(--grn);}
.sl-short:hover,.sl-sel.sl-short{border-left-color:var(--red);}

/* ROW 1 */
.sl-row1{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:6px;}
.sl-row1-left{display:flex;align-items:center;gap:10px;}
.sl-row1-right{display:flex;align-items:center;gap:12px;}

/* Symbol — big and bold, most important */
.sl-sym{font-family:var(--mono);font-size:18px;font-weight:700;}

/* Side badge */
.sl-side{font-size:11px;font-weight:700;letter-spacing:.5px;padding:3px 10px;border-radius:4px;}
.side-l{background:rgba(63,185,80,.12);color:var(--grn);border:1px solid rgba(63,185,80,.2);}
.side-s{background:rgba(248,81,73,.12);color:var(--red);border:1px solid rgba(248,81,73,.2);}

/* Stage */
.sl-stage{font-size:11px;color:var(--dim);background:var(--bg3);padding:2px 7px;border-radius:4px;}

/* Reason badge */
.sl-reason-badge{font-size:12px;font-weight:600;padding:3px 10px;border-radius:6px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sl-confirm-badge{font-size:10px;font-weight:700;background:rgba(34,197,94,.12);color:#22c55e;padding:2px 7px;border-radius:5px;cursor:help;}
.sl-entry-range{font-size:10px;color:var(--dim,#64748b);margin-left:5px;font-weight:500;cursor:help;}
.rc-exec{background:rgba(248,81,73,.12);color:var(--red);border:1px solid rgba(248,81,73,.2);}
.rc-bal{background:rgba(227,179,65,.1);color:var(--yel);border:1px solid rgba(227,179,65,.2);}
.rc-min{background:rgba(227,179,65,.08);color:var(--yel);border:1px solid rgba(227,179,65,.15);}
.rc-other{background:var(--bg3);color:var(--dim);border:1px solid var(--bdr);}

/* Time — clear and readable */
.sl-time{font-family:var(--mono);font-size:13px;color:var(--txt);opacity:.8;white-space:nowrap;letter-spacing:.3px;}

/* ROW 2 - confidence */
.sl-row2{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.sl-conf-wrap{display:flex;align-items:center;gap:8px;flex:1;}
.sl-conf-track{flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;}
.sl-conf-bar{height:100%;border-radius:3px;transition:width .3s;}
.sl-conf-bar.cc-hi{background:var(--grn);}
.sl-conf-bar.cc-mid{background:var(--acc);}
.sl-conf-bar.cc-lo{background:var(--red);}
.sl-conf-pct{font-family:var(--mono);font-size:14px;font-weight:700;min-width:38px;text-align:right;}
.sl-regime{font-size:12px;font-weight:600;padding:2px 8px;border-radius:4px;background:var(--bg3);white-space:nowrap;}
.rc-bull{color:var(--grn)!important;}.rc-bear{color:var(--red)!important;}.rc-range{color:var(--yel)!important;}.rc-sq{color:var(--acc)!important;}

/* ROW 3 - numbers */
.sl-nums{display:flex;gap:24px;flex-wrap:wrap;}
.sl-num{display:flex;flex-direction:column;gap:2px;}
.sl-nl{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--dim);font-weight:600;}
.sl-nv{font-family:var(--mono);font-size:14px;font-weight:600;}
.sl-tpct{font-size:11px;color:var(--grn);margin-left:4px;}

/* EXPANDED DETAIL */
.sl-detail{margin-top:14px;padding-top:14px;border-top:1px dashed var(--bdr);}
.sl-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-bottom:12px;border:1px solid var(--bdr);border-radius:6px;overflow:hidden;}
.sl-dr{display:flex;justify-content:space-between;align-items:center;padding:7px 12px;border-bottom:1px solid var(--bdr);gap:8px;font-size:13px;}
.sl-dr:nth-child(odd){background:rgba(255,255,255,.015);}
.sl-dr:last-child,.sl-dr:nth-last-child(2):nth-child(odd){border-bottom:none;}
.sl-dl{color:var(--dim);white-space:nowrap;}
.sl-dv{font-family:var(--mono);font-size:12px;text-align:right;word-break:break-all;}
.sl-tps{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;}
.sl-tp{font-family:var(--mono);font-size:12px;background:rgba(63,185,80,.08);border:1px solid rgba(63,185,80,.2);color:var(--grn);padding:3px 10px;border-radius:4px;}
.sl-tp1{background:rgba(63,185,80,.15);font-weight:600;}
.sl-tp b{color:var(--grn);margin-left:4px;}
.sl-hint{font-size:12px;color:var(--dim);background:var(--bg3);border-radius:6px;padding:10px 12px;line-height:1.6;border:1px solid var(--bdr);}

/* SIDEBAR */
.sl-side-box{padding:16px 18px;border-bottom:1px solid var(--bdr);}
.sl-side-title{font-size:11px;font-weight:700;letter-spacing:2px;color:var(--dim);text-transform:uppercase;margin-bottom:12px;}

/* Symbol rows */
.sl-sr{display:flex;align-items:center;gap:8px;padding:7px 4px;border-radius:6px;cursor:pointer;transition:background .1s;font-size:13px;}
.sl-sr:hover{background:var(--bg3);}
.sl-sr-sel{background:rgba(31,111,235,.1)!important;}
.sl-sr-sym{font-family:var(--mono);font-weight:700;font-size:13px;color:var(--acc);min-width:96px;}
.sl-sr-track{flex:1;height:5px;background:var(--bdr);border-radius:3px;overflow:hidden;}
.sl-sr-bar{height:100%;border-radius:3px;}
.sl-sr-bar.cc-hi{background:var(--grn);}.sl-sr-bar.cc-mid{background:var(--acc);}.sl-sr-bar.cc-lo{background:var(--red);}
.sl-sr-n{font-family:var(--mono);font-size:12px;color:var(--dim);min-width:26px;text-align:right;}
.sl-sr-conf{font-family:var(--mono);font-size:12px;min-width:34px;text-align:right;}

/* Reason rows */
.sl-rr{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:13px;}
.sl-rr-name{font-weight:600;min-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;}
.sl-rr-track{flex:1;height:5px;background:var(--bdr);border-radius:3px;overflow:hidden;}
.sl-rr-fill{height:100%;border-radius:3px;opacity:.7;}
.sl-rr-fill.rc-exec{background:var(--red);}.sl-rr-fill.rc-bal{background:var(--yel);}.sl-rr-fill.rc-other{background:var(--dim);}
.sl-rr-pct{font-family:var(--mono);font-size:11px;min-width:28px;text-align:right;}
.sl-rr-n{font-family:var(--mono);font-size:12px;font-weight:600;min-width:26px;text-align:right;}

@@media(max-width:1000px){.sl-layout{grid-template-columns:1fr;}.sl-sidebar{border-top:1px solid var(--bdr);}}
@@media(max-width:700px){.sl-header{flex-direction:column;gap:12px;}.sl-header-stats{flex-wrap:wrap;gap:8px;}.sl-toolbar{flex-direction:column;}}
</style>

@code {
    record SymG(string Symbol, int Count, int AvgConf);
    record ReasonG(string Reason, int Count);
    record FDef(string Key, string Label, int N);

    List<MissedRec> _all      = new();
    List<MissedRec> _filtered = new();
    List<SymG>    _bySymbol = new();
    List<ReasonG> _byReason = new();
    List<FDef>    _filters  = new();
    int _execFail;

    string _fKey = "ALL", _q = string.Empty, _symFilter = string.Empty, _sort = "time", _selId = string.Empty;
    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new System.Threading.Timer(async _ =>
            await InvokeAsync(async () => { await Load(); StateHasChanged(); }),
            null, 5000, 5000);
    }

    async Task Load()
    {
        // Resolve root: client folder first, then SharedData:Root (engine writes here)
        var root = ClientData?.Root;
        if (string.IsNullOrWhiteSpace(root))
            root = AppConfig["SharedData:Root"];
        if (string.IsNullOrWhiteSpace(root))
            root = AppContext.BaseDirectory;

        // PRIMARY: missed_trades.json (engine rejects + live_signal mirrors)
        var data = await Svc.LoadFromPathAsync(Svc.GetPathForRoot(root));
        _all = data?.ToList() ?? new();

        // If client path empty, also try global SharedData missed_trades
        try
        {
            var shared = AppConfig["SharedData:Root"];
            if (!string.IsNullOrWhiteSpace(shared)
                && !string.Equals(shared, root, StringComparison.OrdinalIgnoreCase))
            {
                var extra = await Svc.LoadFromPathAsync(Svc.GetPathForRoot(shared));
                if (extra != null)
                {
                    foreach (var r in extra)
                    {
                        if (!_all.Any(x => x.Symbol == r.Symbol && x.Time == r.Time && x.Entry == r.Entry))
                            _all.Add(r);
                    }
                }
            }
        }
        catch { }

        // ALSO: live_signals.json — same source /market uses as primary
        // (so page is not empty when only live_signals is populated)
        try
        {
            var live = await LiveSignalSvc.ForRoot(root!).LoadAsync();
            // Also try SharedData root for live_signals if different
            if ((live == null || live.Count == 0) && !string.IsNullOrWhiteSpace(AppConfig["SharedData:Root"]))
            {
                var sharedLive = await LiveSignalSvc.ForRoot(AppConfig["SharedData:Root"]!).LoadAsync();
                if (sharedLive != null && sharedLive.Count > 0) live = sharedLive;
            }

            if (live != null && live.Count > 0)
            {
                foreach (var ls in live)
                {
                    // de-dupe by symbol+time+entry
                    bool exists = _all.Any(r =>
                        r.Symbol == ls.Symbol
                        && Math.Abs((r.Time - ls.Time).TotalSeconds) < 2
                        && r.Entry == ls.Entry);
                    if (exists) continue;

                    _all.Add(new MissedRec
                    {
                        Event = "SIGNAL",
                        Symbol = ls.Symbol ?? "",
                        Side = ls.Side ?? "",
                        Time = ls.Time,
                        Entry = ls.Entry,
                        StopLoss = ls.StopLoss,
                        TakeProfits = ls.TakeProfits ?? new(),
                        Confidence = ls.Confidence,
                        Score = ls.Score,
                        Reason = string.IsNullOrEmpty(ls.Reason) ? "LIVE_SIGNAL" : ls.Reason,
                         ATR = ls.Atr 
                    });
                }
                _all = _all.OrderByDescending(r => r.Time).ToList();
            }
        }
        catch { /* non-fatal */ }

        _execFail = _all.Count(r => (r.Reason ?? "").Contains("Exec") || (r.Reason ?? "").Contains("EXEC") || (r.Reason ?? "").Contains("Failed"));
        Rebuild();
    }

    void Rebuild()
    {
        _bySymbol = _all
            .GroupBy(r => r.Symbol)
            .Select(g => new SymG(g.Key, g.Count(), (int)g.Average(x => x.Confidence)))
            .OrderByDescending(g => g.Count).ToList();

        _byReason = _all
            .GroupBy(r => string.IsNullOrEmpty(r.Reason) ? "Unknown" : r.Reason)
            .Select(g => new ReasonG(g.Key, g.Count()))
            .OrderByDescending(g => g.Count).ToList();

        _filters = new()
        {
            new("ALL",   "All",          _all.Count),
            new("LONG",  "▲ Long",       _all.Count(r => r.Side == "Buy")),
            new("SHORT", "▼ Short",      _all.Count(r => r.Side == "Sell")),
            new("HIGH",  "Conf ≥ 70",    _all.Count(r => r.Confidence >= 70)),
            new("EXEC",  "Exec Failed",  _execFail),
            new("BAL",   "Low Balance",  _all.Count(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance"))),
            new("MIN",   "Min Notional", _all.Count(r => r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL"))),
        };

        Refilter();
    }

    void Refilter()
    {
        var q = _all.AsEnumerable();
        if (!string.IsNullOrEmpty(_symFilter))
            q = q.Where(r => r.Symbol == _symFilter);
        else if (!string.IsNullOrEmpty(_q))
        {
            var up = _q.ToUpperInvariant();
            q = q.Where(r => r.Symbol.Contains(up) || r.Reason.ToUpperInvariant().Contains(up) || r.Stage.ToUpperInvariant().Contains(up));
        }
        q = _fKey switch
        {
            "LONG"  => q.Where(r => r.Side == "Buy"),
            "SHORT" => q.Where(r => r.Side == "Sell"),
            "HIGH"  => q.Where(r => r.Confidence >= 70),
            "EXEC"  => q.Where(r => r.Reason.Contains("Exec") || r.Reason.Contains("EXEC") || r.Reason.Contains("Failed")),
            "BAL"   => q.Where(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance")),
            "MIN"   => q.Where(r => r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL")),
            _       => q
        };
        _filtered = (_sort switch
        {
            "conf" => q.OrderByDescending(r => r.Confidence),
            "sym"  => q.OrderBy(r => r.Symbol).ThenByDescending(r => r.Time),
            _      => q.OrderByDescending(r => r.Time)
        }).ToList();
    }

    void OnSearch(ChangeEventArgs e) { _q = e.Value?.ToString() ?? string.Empty; _symFilter = string.Empty; Refilter(); }
    void OnSort(ChangeEventArgs e) { _sort = e.Value?.ToString() ?? "time"; Refilter(); }
    void ClearSearch() { _q = string.Empty; _symFilter = string.Empty; Refilter(); }
    void ToggleSym(string s) { _symFilter = _symFilter == s ? string.Empty : s; _fKey = "ALL"; Refilter(); }
    void Toggle(MissedRec r)
    {
        var id = SigId(r);
        _selId = _selId == id ? string.Empty : id;
    }

    string SigId(MissedRec r)
        => $"{r.Symbol}_{r.Time:yyyyMMddHHmmssfff}";

    string FP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1)    return v.ToString("F4");
        return v.ToString("G5");
    }

    string RegStr(VertexAutoTradeBinance8.Models.MarketRegime r) => r switch
    {
        VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend   => "↑↑ Strong Bull",
        VertexAutoTradeBinance8.Models.MarketRegime.UpTrend         => "↑ Bull",
        VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend => "↓↓ Strong Bear",
        VertexAutoTradeBinance8.Models.MarketRegime.DownTrend       => "↓ Bear",
        VertexAutoTradeBinance8.Models.MarketRegime.Range           => "↔ Range",
        VertexAutoTradeBinance8.Models.MarketRegime.Squeeze         => "⊞ Squeeze",
        _ => "— Unknown"
    };

    string RegCls(VertexAutoTradeBinance8.Models.MarketRegime r) => r switch
    {
        VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend or VertexAutoTradeBinance8.Models.MarketRegime.UpTrend     => "rc-bull",
        VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend or VertexAutoTradeBinance8.Models.MarketRegime.DownTrend => "rc-bear",
        VertexAutoTradeBinance8.Models.MarketRegime.Range           => "rc-range",
        VertexAutoTradeBinance8.Models.MarketRegime.Squeeze         => "rc-sq",
        _ => "sl-dim"
    };

    string RCls(string r)
    {
        if (r.Contains("Exec") || r.Contains("EXEC") || r.Contains("Failed")) return "rc-exec";
        if (r.Contains("Balance") || r.Contains("balance"))                    return "rc-bal";
        if (r.Contains("Notional") || r.Contains("TOO_SMALL"))                 return "rc-min";
        return "rc-other";
    }

    string RFill(string r)
    {
        if (r.Contains("Exec") || r.Contains("EXEC") || r.Contains("Failed")) return "rc-exec";
        if (r.Contains("Balance") || r.Contains("Notional"))                   return "rc-bal";
        return "rc-other";
    }

    // Strips the _VWAP/_HTF confirmation suffixes (added when those
    // optional filters pass) before the reason text goes through SR()'s
    // truncation/pattern matching — without this, a reason like
    // "PULLBACK_EMA21_LONG_V2_VWAP_HTF" would truncate mid-tag into
    // something unreadable instead of showing the clean base reason
    // plus the dedicated VWAP✓/HTF✓ badges shown separately.
    string CleanReason(string? reason)
    {
        if (string.IsNullOrEmpty(reason)) return reason ?? "";
        return reason.Replace("_VWAP", "").Replace("_HTF", "");
    }

    string SR(string r) => r switch
    {
        _ when r.Contains("EXECUTION_FAILED") || r.Contains("ExecFailed") || r.Contains("ENTRY_FAILED") => "Exec Failed",
        _ when r.Contains("Balance is zero")                          => "Balance Zero",
        _ when r.Contains("InsufficientBalance") || r.Contains("INSUFFICIENT") => "Insufficient Bal",
        _ when r.Contains("MinNotional") || r.Contains("TOO_SMALL")  => "Min Notional",
        _ when r.Contains("DRY_RUN")                                  => "Dry Run",
        _ when r.Contains("COOLDOWN")                                 => "Cooldown",
        _ when r.Contains("AI_BLOCK") || r.Contains("AI_PNL")        => "AI Block",
        _ when r.Contains("SIDE_NOT")                                 => "Side Blocked",
        _ when r.Contains("OrderBook")                                => "OB Imbalance",
        _ when r.Contains("TRAP")                                     => "Trap Detected",
        _ when string.IsNullOrEmpty(r)                                => "Unknown",
        _ => r.Length > 20 ? r[..20] + "…" : r
    };

    string Hint(MissedRec r)
    {
        var sb = new System.Text.StringBuilder();
        if      (r.Confidence >= 80) sb.Append("Strong signal setup. ");
        else if (r.Confidence >= 60) sb.Append("Decent setup. ");
        else                          sb.Append("Weak signal — better to skip. ");
        sb.Append(r.Regime switch {
            VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend   => "Strong bull trend — momentum in favour. ",
            VertexAutoTradeBinance8.Models.MarketRegime.UpTrend         => "Uptrend — direction clear. ",
            VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend => "Strong bear trend — short opportunity. ",
            VertexAutoTradeBinance8.Models.MarketRegime.Range           => "Range market — mean reversion play. ",
            VertexAutoTradeBinance8.Models.MarketRegime.Squeeze         => "Squeeze — breakout expected. ",
            _ => ""
        });
        if      (r.Reason.Contains("Exec") || r.Reason.Contains("Failed"))
            sb.Append("Blocked at execution — likely API or balance issue.");
        else if (r.Reason.Contains("Balance") || r.Reason.Contains("balance"))
            sb.Append("Insufficient balance — add USDT to capture this setup.");
        else if (r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL"))
            sb.Append("Min notional not met — this symbol requires larger position size.");
        else if (r.Reason.Contains("TRAP"))
            sb.Append("AI detected potential trap pattern — entry blocked to avoid false move.");
        else if (r.Reason.Contains("Cooldown"))
            sb.Append("Symbol in cooldown after recent trade.");
        return sb.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
