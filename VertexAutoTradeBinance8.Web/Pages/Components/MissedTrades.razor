@page "/missed-trades"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject MissedTradeFileService Svc
@implements IDisposable

<PageTitle>Signal Log — Vertex</PageTitle>

<div class="sl">

    <!-- TOP BAR -->
    <div class="sl-bar">
        <div class="sl-bar-left">
            <span class="sl-title">SIGNAL LOG</span>
            <span class="sl-count">@_filtered.Count signals</span>
        </div>
        <div class="sl-bar-right">
            <div class="sl-stat @(_all.Count(r=>r.Side=="Buy")>_all.Count(r=>r.Side=="Sell")?"sl-stat-up":"sl-stat-dn")">
                <span>▲ @_all.Count(r=>r.Side=="Buy") Long</span>
            </div>
            <div class="sl-stat sl-stat-dn">
                <span>▼ @_all.Count(r=>r.Side=="Sell") Short</span>
            </div>
            <div class="sl-stat">
                <span>🎯 @_all.Count(r=>r.Confidence>=70) High conf</span>
            </div>
            <div class="sl-stat sl-stat-err">
                <span>⚠ @_all.Count(r=>r.Reason.Contains("Exec")||r.Reason.Contains("Failed")) Exec fail</span>
            </div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="sl-toolbar">
        <!-- Filter chips -->
        <div class="sl-chips">
            @foreach (var f in _filters)
            {
                <button class="sl-chip @(_fKey==f.Key?"sl-chip-on":"")"
                        @onclick="()=>{_fKey=f.Key;_symFilter=string.Empty;Refilter();}">
                    @f.Label
                    <span class="sl-chip-n">@f.N</span>
                </button>
            }
        </div>
        <!-- Search + sort -->
        <div class="sl-tools">
            <div class="sl-search-box">
                <span class="sl-search-icon">⌕</span>
                <input class="sl-search" placeholder="symbol, reason..."
                       value="@_q" @oninput="OnSearch" />
                @if (!string.IsNullOrEmpty(_q) || !string.IsNullOrEmpty(_symFilter))
                {
                    <button class="sl-search-clear" @onclick="ClearSearch">✕</button>
                }
            </div>
            <select class="sl-select" @onchange="OnSort">
                <option value="time">Newest first</option>
                <option value="conf">Highest confidence</option>
                <option value="sym">By symbol A→Z</option>
            </select>
        </div>
    </div>

    @if (_all.Count == 0)
    {
        <div class="sl-empty">
            <div class="sl-empty-icon">📭</div>
            <div class="sl-empty-title">No signals recorded</div>
            <div class="sl-empty-sub">Blocked and failed signals appear here automatically</div>
        </div>
    }
    else
    {
        <div class="sl-body">

            <!-- SIGNAL CARDS -->
            <div class="sl-feed">
                @if (_symFilter != "")
                {
                    <div class="sl-feed-banner">
                        Filtering: <b>@_symFilter</b>
                        <button @onclick="()=>{_symFilter=string.Empty;Refilter();}">✕ clear</button>
                    </div>
                }

                @foreach (var r in _filtered.Take(60))
                {
                    bool isLong = r.Side == "Buy";
                    bool isSel  = _selId == SigId(r);
                    var  regStr = RegStr(r.Regime);
                    var  confCls = r.Confidence >= 70 ? "c-hi" : r.Confidence >= 50 ? "c-mid" : "c-lo";

                    <div class="sl-card @(isSel?"sl-card-sel":"") @(isLong?"sl-card-long":"sl-card-short")"
                         @onclick="()=>Toggle(r)">

                        <!-- LINE 1: symbol · side · time · block reason -->
                        <div class="sl-card-head">
                            <span class="sl-csym @(isLong?"cu":"cd")">@r.Symbol</span>
                            <span class="sl-cside @(isLong?"badge-l":"badge-s")">
                                @(isLong?"▲ LONG":"▼ SHORT")
                            </span>
                            <span class="sl-cstage">@r.Stage</span>
                            <div class="sl-head-right">
                                <span class="sl-creason @ReasonCls(r.Reason)">@RShort(r.Reason)</span>
                                <span class="sl-ctime">@r.Time.ToLocalTime().ToString("dd.MM.yy  HH:mm:ss")</span>
                            </div>
                        </div>

                        <!-- LINE 2: confidence bar -->
                        <div class="sl-conf-row">
                            <div class="sl-conf-track">
                                <div class="sl-conf-fill @confCls" style="width:@r.Confidence%"></div>
                            </div>
                            <span class="sl-conf-val @confCls">@r.Confidence%</span>
                            <span class="sl-regime @RegimeCls(r.Regime)">@regStr</span>
                        </div>

                        <!-- LINE 3: key numbers -->
                        <div class="sl-nums">
                            <div class="sl-num">
                                <span class="sl-nl">Entry</span>
                                <span class="sl-nv">@FP(r.Entry)</span>
                            </div>
                            <div class="sl-num">
                                <span class="sl-nl">SL</span>
                                <span class="sl-nv cd">@FP(r.StopLoss)</span>
                            </div>
                            @if (r.TakeProfits.Count > 0)
                            {
                                var pct = r.Entry > 0
                                    ? (Math.Abs(r.TakeProfits[0] - r.Entry) / r.Entry * 100m).ToString("F1") + "%"
                                    : "";
                                <div class="sl-num">
                                    <span class="sl-nl">TP1</span>
                                    <span class="sl-nv cu">@FP(r.TakeProfits[0]) <span class="sl-tpct">+@pct</span></span>
                                </div>
                            }
                            <div class="sl-num">
                                <span class="sl-nl">ATR</span>
                                <span class="sl-nv">@r.ATR.ToString("G3")</span>
                            </div>
                            <div class="sl-num">
                                <span class="sl-nl">Vol%</span>
                                <span class="sl-nv">@r.Vol.ToString("P1")</span>
                            </div>
                            <div class="sl-num">
                                <span class="sl-nl">Balance</span>
                                <span class="sl-nv @(r.FreeBalance<5?"cd":"")">$@r.FreeBalance.ToString("F1")</span>
                            </div>
                            @if (r.TakeProfits.Count > 1)
                            {
                                <div class="sl-num">
                                    <span class="sl-nl">TPs</span>
                                    <span class="sl-nv">@r.TakeProfits.Count</span>
                                </div>
                            }
                        </div>

                        <!-- EXPANDED DETAIL -->
                        @if (isSel)
                        {
                            <div class="sl-detail" @onclick:stopPropagation="true">
                                <div class="sl-detail-grid">
                                    <div class="sl-drow"><span class="sl-dl">Stage</span><span class="sl-dv">@r.Stage</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Regime</span><span class="sl-dv @RegimeCls(r.Regime)">@RegStr(r.Regime)</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Smart Type</span><span class="sl-dv">@(r.SmartType.Length>0?r.SmartType:"—")</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Slope</span><span class="sl-dv">@r.Slope.ToString("G3")</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Deviation</span><span class="sl-dv">@r.Deviation.ToString("G3")</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Notional</span><span class="sl-dv">$@r.AttemptNotional.ToString("F2")</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Min Notional</span><span class="sl-dv">$@r.RequiredMinNotional.ToString("F2")</span></div>
                                    <div class="sl-drow"><span class="sl-dl">Block reason</span><span class="sl-dv @ReasonCls(r.Reason)">@r.Reason</span></div>
                                </div>
                                @if (r.TakeProfits.Count > 0)
                                {
                                    <div class="sl-tp-list">
                                        @foreach (var (tp, i) in r.TakeProfits.Select((v,i)=>(v,i)))
                                        {
                                            var p = r.Entry>0 ? $"+{Math.Abs(tp-r.Entry)/r.Entry*100m:F2}%" : "";
                                            <span class="sl-tp-item">TP@(i+1) @FP(tp) <b>@p</b></span>
                                        }
                                    </div>
                                }
                                <div class="sl-hint">🤖 @Hint(r)</div>
                            </div>
                        }

                    </div>
                }

                @if (_filtered.Count > 60)
                {
                    <div class="sl-more">Showing 60 of @_filtered.Count · use filters to narrow down</div>
                }
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="sl-sidebar">

                <!-- TOP SYMBOLS -->
                <div class="sl-side-section">
                    <div class="sl-side-title">TOP SYMBOLS</div>
                    @foreach (var g in _bySymbol.Take(15))
                    {
                        var c = g.AvgConf;
                        var pct = _all.Count > 0 ? g.Count * 100.0 / _all.Count : 0;
                        <div class="sl-sym-row @(_symFilter==g.Symbol?"sl-sym-sel":"")"
                             @onclick="()=>ToggleSym(g.Symbol)">
                            <span class="sl-sym-name">@g.Symbol</span>
                            <div class="sl-sym-bar">
                                <div class="sl-sym-fill @(c>=70?"c-hi":c>=50?"c-mid":"c-lo")"
                                     style="width:@Math.Min(100.0,pct*4)%"></div>
                            </div>
                            <span class="sl-sym-n">@g.Count</span>
                            <span class="sl-sym-conf @(c>=70?"cu":c>=50?"sl-dim":"cd")">@c%</span>
                        </div>
                    }
                </div>

                <!-- BLOCK REASONS -->
                <div class="sl-side-section">
                    <div class="sl-side-title">BLOCK REASONS</div>
                    @foreach (var g in _byReason.Take(12))
                    {
                        var pct = _all.Count > 0 ? g.Count * 100.0 / _all.Count : 0;
                        <div class="sl-reason-row">
                            <span class="sl-reason-name @ReasonCls(g.Reason)" title="@g.Reason">
                                @RShort(g.Reason)
                            </span>
                            <div class="sl-reason-bar">
                                <div class="sl-reason-fill" style="width:@Math.Min(100.0,pct*4)%"></div>
                            </div>
                            <span class="sl-reason-n sl-dim">@g.Count</span>
                        </div>
                    }
                </div>

            </div>
        </div>
    }

</div>

<style>
:root {
    --bg: #0a0d12; --bg2: #111520; --bg3: #1a1f2e; --bdr: #1e2535;
    --acc: #3b82f6; --grn: #22c55e; --red: #ef4444; --yel: #eab308;
    --txt: #e2e8f0; --dim: #64748b;
    --mono: 'JetBrains Mono','Fira Code','Courier New',monospace;
}
html,body { background:var(--bg)!important; color:var(--txt); }

.sl { font-family:'Inter','Segoe UI',sans-serif; background:var(--bg); min-height:100vh; }
.cu { color:var(--grn)!important; }
.cd { color:var(--red)!important; }
.sl-dim { color:var(--dim)!important; }
.c-hi  { color:var(--grn)!important; background:rgba(34,197,94,.15)!important; }
.c-mid { color:var(--acc)!important; background:rgba(59,130,246,.15)!important; }
.c-lo  { color:var(--red)!important; background:rgba(239,68,68,.15)!important; }

/* ── BAR ─────────────────────────────────────────────── */
.sl-bar {
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 24px; background:var(--bg2); border-bottom:1px solid var(--bdr);
}
.sl-bar-left { display:flex; align-items:baseline; gap:14px; }
.sl-title { font-family:var(--mono); font-size:15px; font-weight:700; letter-spacing:2px; color:var(--acc); }
.sl-count { font-size:12px; color:var(--dim); }
.sl-bar-right { display:flex; gap:10px; flex-wrap:wrap; }
.sl-stat { font-size:12px; padding:4px 12px; background:var(--bg3); border:1px solid var(--bdr); border-radius:20px; color:var(--dim); }
.sl-stat-up { color:var(--grn); border-color:rgba(34,197,94,.3); }
.sl-stat-dn { color:var(--red); border-color:rgba(239,68,68,.3); }
.sl-stat-err { color:var(--yel); border-color:rgba(234,179,8,.3); }

/* ── TOOLBAR ─────────────────────────────────────────── */
.sl-toolbar {
    display:flex; align-items:center; gap:12px; padding:10px 24px;
    background:var(--bg2); border-bottom:1px solid var(--bdr); flex-wrap:wrap;
}
.sl-chips { display:flex; gap:6px; flex-wrap:wrap; flex:1; }
.sl-chip {
    display:inline-flex; align-items:center; gap:5px; padding:4px 11px;
    background:var(--bg3); border:1px solid var(--bdr); border-radius:20px;
    color:var(--dim); font-size:12px; cursor:pointer; transition:all .15s;
}
.sl-chip:hover { border-color:var(--acc); color:var(--txt); }
.sl-chip-on  { background:rgba(59,130,246,.12); border-color:var(--acc); color:var(--txt); }
.sl-chip-n { font-family:var(--mono); font-size:10px; background:var(--bg); border-radius:10px; padding:0 5px; }
.sl-tools { display:flex; gap:8px; }
.sl-search-box {
    position:relative; display:flex; align-items:center;
    background:var(--bg3); border:1px solid var(--bdr); border-radius:6px; overflow:hidden;
}
.sl-search-icon { padding:0 8px; color:var(--dim); font-size:14px; }
.sl-search { background:transparent; border:none; color:var(--txt); padding:5px 4px 5px 0; font-size:12px; width:180px; outline:none; }
.sl-search::placeholder { color:var(--dim); }
.sl-search-clear { background:none; border:none; color:var(--dim); padding:0 8px; cursor:pointer; font-size:12px; }
.sl-search-clear:hover { color:var(--red); }
.sl-select { background:var(--bg3); border:1px solid var(--bdr); color:var(--txt); padding:5px 10px; border-radius:6px; font-size:12px; }

/* ── EMPTY ───────────────────────────────────────────── */
.sl-empty { display:flex; flex-direction:column; align-items:center; gap:12px; padding:80px 20px; color:var(--dim); text-align:center; }
.sl-empty-icon { font-size:44px; }
.sl-empty-title { font-size:16px; font-weight:600; color:var(--txt); }
.sl-empty-sub { font-size:13px; }

/* ── BODY ────────────────────────────────────────────── */
.sl-body { display:grid; grid-template-columns:1fr 280px; min-height:calc(100vh - 108px); }
.sl-feed { background:var(--bg); border-right:1px solid var(--bdr); }

.sl-feed-banner {
    display:flex; align-items:center; gap:10px; padding:8px 16px;
    background:rgba(59,130,246,.08); border-bottom:1px solid var(--bdr);
    font-size:12px; color:var(--dim);
}
.sl-feed-banner b { color:var(--acc); }
.sl-feed-banner button { background:none; border:1px solid var(--bdr); border-radius:10px; color:var(--dim); padding:1px 8px; font-size:11px; cursor:pointer; }

/* ── CARDS ───────────────────────────────────────────── */
.sl-card {
    padding:12px 16px; border-bottom:1px solid var(--bdr);
    cursor:pointer; transition:background .1s;
    border-left:3px solid transparent;
}
.sl-card:hover { background:var(--bg2); }
.sl-card-long:hover  { border-left-color:rgba(34,197,94,.4); }
.sl-card-short:hover { border-left-color:rgba(239,68,68,.4); }
.sl-card-sel { background:var(--bg2)!important; }
.sl-card-sel.sl-card-long  { border-left-color:var(--grn); }
.sl-card-sel.sl-card-short { border-left-color:var(--red); }

/* card head */
.sl-card-head {
    display:flex; align-items:center; gap:8px; margin-bottom:7px; flex-wrap:wrap;
}
.sl-csym { font-family:var(--mono); font-size:15px; font-weight:700; }
.sl-cside { font-size:10px; font-weight:700; padding:2px 7px; border-radius:3px; letter-spacing:.5px; }
.badge-l { background:rgba(34,197,94,.12); color:var(--grn); border:1px solid rgba(34,197,94,.2); }
.badge-s { background:rgba(239,68,68,.12); color:var(--red); border:1px solid rgba(239,68,68,.2); }
.sl-cstage { font-size:10px; color:var(--dim); background:var(--bg3); padding:1px 6px; border-radius:3px; }
.sl-head-right { margin-left:auto; display:flex; align-items:center; gap:10px; }
.sl-creason { font-size:11px; font-weight:600; padding:2px 8px; border-radius:4px; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.reason-exec  { background:rgba(239,68,68,.12); color:var(--red); }
.reason-bal   { background:rgba(249,115,22,.1); color:#f97316; }
.reason-min   { background:rgba(234,179,8,.1); color:var(--yel); }
.reason-other { background:var(--bg3); color:var(--dim); }

/* time — readable */
.sl-ctime { font-family:var(--mono); font-size:12px; color:var(--txt); opacity:.7; white-space:nowrap; }

/* confidence */
.sl-conf-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.sl-conf-track { flex:1; height:3px; background:var(--bdr); border-radius:2px; overflow:hidden; }
.sl-conf-fill { height:100%; border-radius:2px; }
.sl-conf-fill.c-hi  { background:var(--grn); }
.sl-conf-fill.c-mid { background:var(--acc); }
.sl-conf-fill.c-lo  { background:var(--red); }
.sl-conf-val { font-family:var(--mono); font-size:11px; font-weight:700; padding:1px 6px; border-radius:3px; min-width:36px; text-align:center; }
.sl-regime { font-size:11px; padding:1px 7px; border-radius:3px; background:var(--bg3); }
.regime-bull { color:var(--grn)!important; }
.regime-bear { color:var(--red)!important; }
.regime-range { color:var(--yel)!important; }
.regime-squeeze { color:var(--acc)!important; }

/* numbers */
.sl-nums { display:flex; gap:20px; flex-wrap:wrap; }
.sl-num { display:flex; flex-direction:column; gap:2px; }
.sl-nl { font-size:9px; text-transform:uppercase; letter-spacing:1px; color:var(--dim); font-weight:600; }
.sl-nv { font-family:var(--mono); font-size:12px; font-weight:600; }
.sl-tpct { font-size:10px; color:var(--grn); margin-left:3px; }

/* expanded detail */
.sl-detail {
    margin-top:12px; padding-top:12px;
    border-top:1px dashed var(--bdr);
}
.sl-detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:0; margin-bottom:10px; }
.sl-drow { display:flex; justify-content:space-between; padding:5px 6px; border-bottom:1px solid var(--bdr); gap:8px; }
.sl-drow:nth-child(odd) { background:rgba(255,255,255,.01); }
.sl-dl { font-size:11px; color:var(--dim); white-space:nowrap; }
.sl-dv { font-family:var(--mono); font-size:11px; text-align:right; word-break:break-all; }
.sl-tp-list { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
.sl-tp-item { font-family:var(--mono); font-size:11px; background:rgba(34,197,94,.08); border:1px solid rgba(34,197,94,.2); color:var(--grn); padding:2px 8px; border-radius:4px; }
.sl-tp-item b { color:var(--grn); margin-left:4px; }
.sl-hint { font-size:11px; color:var(--dim); background:var(--bg3); border-radius:6px; padding:8px 10px; line-height:1.5; }

.sl-more { text-align:center; padding:16px; font-size:12px; color:var(--dim); }

/* ── SIDEBAR ─────────────────────────────────────────── */
.sl-sidebar { background:var(--bg2); }
.sl-side-section { padding:14px 16px; border-bottom:1px solid var(--bdr); }
.sl-side-title { font-family:var(--mono); font-size:10px; letter-spacing:2px; color:var(--dim); font-weight:700; margin-bottom:10px; }

/* symbol rows */
.sl-sym-row {
    display:flex; align-items:center; gap:8px; padding:5px 4px;
    border-radius:4px; cursor:pointer; transition:background .1s;
}
.sl-sym-row:hover { background:var(--bg3); }
.sl-sym-sel { background:rgba(59,130,246,.1)!important; }
.sl-sym-name { font-family:var(--mono); font-size:12px; font-weight:700; color:var(--acc); min-width:90px; }
.sl-sym-bar { flex:1; height:4px; background:var(--bdr); border-radius:2px; overflow:hidden; }
.sl-sym-fill { height:100%; border-radius:2px; transition:width .4s; }
.sl-sym-fill.c-hi  { background:var(--grn); }
.sl-sym-fill.c-mid { background:var(--acc); }
.sl-sym-fill.c-lo  { background:var(--red); }
.sl-sym-n    { font-family:var(--mono); font-size:11px; min-width:24px; text-align:right; }
.sl-sym-conf { font-family:var(--mono); font-size:11px; min-width:30px; text-align:right; }

/* reason rows */
.sl-reason-row { display:flex; align-items:center; gap:8px; padding:4px 0; }
.sl-reason-name { font-size:11px; font-weight:600; min-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.sl-reason-bar { flex:1; height:4px; background:var(--bdr); border-radius:2px; overflow:hidden; }
.sl-reason-fill { height:100%; background:var(--red); opacity:.65; border-radius:2px; }
.sl-reason-n { font-family:var(--mono); font-size:11px; min-width:24px; text-align:right; }

@@media(max-width:900px){ .sl-body { grid-template-columns:1fr; } }
@@media(max-width:700px){ .sl-bar { flex-direction:column; gap:10px; } .sl-toolbar { flex-direction:column; } }
</style>

@code {
    record SymG(string Symbol, int Count, int AvgConf);
    record ReasonG(string Reason, int Count);
    record FDef(string Key, string Label, int N);

    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> _all      = new();
    List<VertexAutoTradeBinance8.Web.Models.MissedTradeRecord> _filtered = new();
    List<SymG>    _bySymbol = new();
    List<ReasonG> _byReason = new();
    List<FDef>    _filters  = new();

    string _fKey = "ALL", _q = "", _symFilter = "", _sort = "time", _selId = "";
    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        }, null, 5000, 5000);
    }

    async Task Load()
    {
        var data = await Svc.LoadAsync();
        _all = data ?? new();
        Rebuild();
    }

    void Rebuild()
    {
        _bySymbol = _all
            .GroupBy(r => r.Symbol)
            .Select(g => new SymG(g.Key, g.Count(), (int)g.Average(x => x.Confidence)))
            .OrderByDescending(g => g.Count).ToList();

        _byReason = _all
            .GroupBy(r => r.Reason)
            .Select(g => new ReasonG(g.Key, g.Count()))
            .OrderByDescending(g => g.Count).ToList();

        _filters = new()
        {
            new("ALL",   "All",         _all.Count),
            new("LONG",  "▲ Long",      _all.Count(r => r.Side == "Buy")),
            new("SHORT", "▼ Short",     _all.Count(r => r.Side == "Sell")),
            new("HIGH",  "Conf ≥ 70",   _all.Count(r => r.Confidence >= 70)),
            new("EXEC",  "Exec Failed", _all.Count(r => r.Reason.Contains("Exec") || r.Reason.Contains("Failed"))),
            new("BAL",   "Low Balance", _all.Count(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance"))),
            new("MIN",   "Min Notional",_all.Count(r => r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL"))),
        };

        Refilter();
    }

    void Refilter()
    {
        var q = _all.AsEnumerable();

        if (!string.IsNullOrEmpty(_symFilter))
            q = q.Where(r => r.Symbol == _symFilter);
        else if (!string.IsNullOrEmpty(_q))
        {
            var up = _q.ToUpperInvariant();
            q = q.Where(r => r.Symbol.Contains(up) ||
                              r.Reason.ToUpperInvariant().Contains(up) ||
                              r.Stage.ToUpperInvariant().Contains(up));
        }

        q = _fKey switch
        {
            "LONG"  => q.Where(r => r.Side == "Buy"),
            "SHORT" => q.Where(r => r.Side == "Sell"),
            "HIGH"  => q.Where(r => r.Confidence >= 70),
            "EXEC"  => q.Where(r => r.Reason.Contains("Exec") || r.Reason.Contains("Failed")),
            "BAL"   => q.Where(r => r.Reason.Contains("Balance") || r.Reason.Contains("balance")),
            "MIN"   => q.Where(r => r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL")),
            _       => q
        };

        _filtered = (_sort switch
        {
            "conf" => q.OrderByDescending(r => r.Confidence),
            "sym"  => q.OrderBy(r => r.Symbol).ThenByDescending(r => r.Time),
            _      => q.OrderByDescending(r => r.Time)
        }).ToList();
    }

    void OnSearch(ChangeEventArgs e) { _q = e.Value?.ToString() ?? ""; _symFilter = ""; Refilter(); }
    void OnSort(ChangeEventArgs e)   { _sort = e.Value?.ToString() ?? "time"; Refilter(); }
    void ClearSearch() { _q = ""; _symFilter = ""; Refilter(); }
    void ToggleSym(string s) { _symFilter = _symFilter == s ? "" : s; _fKey = "ALL"; Refilter(); }
    void Toggle(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r) { var id = SigId(r); _selId = _selId == id ? "" : id; }

    string SigId(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r) => $"{r.Symbol}_{r.Time:yyyyMMddHHmmssfff}";

    // ── FORMAT ────────────────────────────────────────────
    string FP(decimal v)
    {
        if (v <= 0) return "—";
        if (v >= 1000) return v.ToString("F2");
        if (v >= 1)    return v.ToString("F4");
        return v.ToString("G5");
    }

    string RegStr(VertexAutoTradeBinance8.Models.MarketRegime r) => r switch
    {
        VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend   => "↑↑ Strong Bull",
        VertexAutoTradeBinance8.Models.MarketRegime.UpTrend         => "↑ Bull",
        VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend => "↓↓ Strong Bear",
        VertexAutoTradeBinance8.Models.MarketRegime.DownTrend       => "↓ Bear",
        VertexAutoTradeBinance8.Models.MarketRegime.Squeeze         => "⊞ Squeeze",
        VertexAutoTradeBinance8.Models.MarketRegime.Range           => "↔ Range",
        _                            => "— Unknown"
    };

    string RegimeCls(VertexAutoTradeBinance8.Models.MarketRegime r) => r switch
    {
        VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend or VertexAutoTradeBinance8.Models.MarketRegime.UpTrend       => "sl-regime regime-bull",
        VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend or VertexAutoTradeBinance8.Models.MarketRegime.DownTrend   => "sl-regime regime-bear",
        VertexAutoTradeBinance8.Models.MarketRegime.Squeeze                                      => "sl-regime regime-squeeze",
        VertexAutoTradeBinance8.Models.MarketRegime.Range                                        => "sl-regime regime-range",
        _                                                         => "sl-regime sl-dim"
    };

    string ReasonCls(string r)
    {
        if (r.Contains("Exec") || r.Contains("Failed") || r.Contains("ENTRY"))  return "sl-creason reason-exec";
        if (r.Contains("Balance") || r.Contains("balance") || r.Contains("BAL")) return "sl-creason reason-bal";
        if (r.Contains("Notional") || r.Contains("TOO_SMALL") || r.Contains("MIN")) return "sl-creason reason-min";
        return "sl-creason reason-other";
    }

    string RShort(string r) => r switch
    {
        _ when r.Contains("ExecFailed") || r.Contains("Exec Failed") || r.Contains("EXECUTION_FAILED") || r.Contains("ENTRY_FAILED") => "Exec Failed",
        _ when r.Contains("Balance is zero") || r.Contains("BalanceZero")   => "Balance Zero",
        _ when r.Contains("InsufficientBalance") || r.Contains("INSUFFICIENT") => "Insufficient Bal",
        _ when r.Contains("MinNotional") || r.Contains("TOO_SMALL")         => "Min Notional",
        _ when r.Contains("DRY_RUN")                                         => "Dry Run",
        _ when r.Contains("COOLDOWN") || r.Contains("Cooldown")             => "Cooldown",
        _ when r.Contains("LiquidityGuard")                                  => "Liq Guard",
        _ when r.Contains("SIDE_NOT")                                        => "Side Blocked",
        _ when r.Contains("AI_BLOCK") || r.Contains("AI_PNL")               => "AI Block",
        _ when r.Contains("OrderBookImbalance")                              => "OB Imbalance",
        _ when r.Contains("ADJUSTED_QTY")                                    => "Qty Adjusted",
        _ when r.Contains("StaleLimit")                                      => "Stale Limit",
        _ when r.Contains("EntryError") || r.Contains("ENTRY_FAILED")       => "Entry Error",
        _ when r.Contains("TRAP")                                            => "Trap",
        _ => r.Length > 20 ? r[..20] + "…" : r
    };

    string Hint(VertexAutoTradeBinance8.Web.Models.MissedTradeRecord r)
    {
        var sb = new System.Text.StringBuilder();
        if      (r.Confidence >= 80) sb.Append("Strong signal. ");
        else if (r.Confidence >= 60) sb.Append("Decent setup. ");
        else                          sb.Append("Weak signal. ");

        sb.Append(r.Regime switch {
            VertexAutoTradeBinance8.Models.MarketRegime.StrongUpTrend   => "Strong bull — momentum in favour. ",
            VertexAutoTradeBinance8.Models.MarketRegime.UpTrend         => "Uptrend — direction clear. ",
            VertexAutoTradeBinance8.Models.MarketRegime.StrongDownTrend => "Strong bear — shorting opportunity. ",
            VertexAutoTradeBinance8.Models.MarketRegime.Range           => "Range market — mean reversion play. ",
            VertexAutoTradeBinance8.Models.MarketRegime.Squeeze         => "Squeeze — breakout expected soon. ",
            _ => ""
        });

        if      (r.Reason.Contains("Exec") || r.Reason.Contains("Failed"))
            sb.Append("Blocked at execution — check API errors or balance.");
        else if (r.Reason.Contains("Balance") || r.Reason.Contains("balance"))
            sb.Append("Low balance — add USDT to capture similar setups.");
        else if (r.Reason.Contains("Notional") || r.Reason.Contains("TOO_SMALL"))
            sb.Append("Min notional not met — this symbol needs a larger position size.");
        else if (r.Reason.Contains("TRAP"))
            sb.Append("AI detected a potential trap — entry was blocked to avoid false move.");
        else if (r.Reason.Contains("Cooldown"))
            sb.Append("Symbol was in cooldown after a recent trade.");

        return sb.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
