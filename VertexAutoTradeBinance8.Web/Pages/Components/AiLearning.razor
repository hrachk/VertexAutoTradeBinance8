@page "/ai-learning"

@using VertexAutoTradeBinance8.Services
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Models
@using VertexAutoTradeBinance8.Web.Models
@inject AiLearningFileService AiLearnService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="vt-page-title">
    <div>
        <h1>AI Learning</h1>
        <p>Как бот «учится» на рынке: score, режимы, блокировки и симуляции</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <button class="vt-btn" @onclick="() => _showHelp = true">? Как читать</button>
        <button class="vt-btn" @onclick="RefreshNow">↻ Обновить</button>
    </div>
</div>

@if (_showHelp)
{
    <div class="ai-help-backdrop" @onclick="() => _showHelp = false"></div>
    <div class="ai-help-modal">
        <div class="ai-help-head">
            <span>Как читать AI Learning</span>
            <button class="vt-btn" @onclick="() => _showHelp = false">✕</button>
        </div>
        <div class="ai-help-body">
            <div class="ai-help-grid">
                <div>
                    <div class="ai-help-tag" style="background:rgba(30,144,255,.15);color:#5eb3ff;">Score</div>
                    <p>Общая «оценка ситуации» 0–100. Чем стабильнее линия, тем спокойнее рынок для бота. Резкие провалы = шум / смена режима.</p>
                </div>
                <div>
                    <div class="ai-help-tag" style="background:rgba(14,203,129,.15);color:var(--vt-green);">Confidence</div>
                    <p>Уверенность SmartRegime в текущем режиме (тренд / флэт / хаос). Низкая confidence → бот осторожнее.</p>
                </div>
                <div>
                    <div class="ai-help-tag" style="background:rgba(155,89,255,.15);color:#c9a0ff;">Slope ×8000</div>
                    <p>Наклон тренда, увеличенный для графика. Большие пики = сильный тренд. Около нуля = боковик.</p>
                </div>
                <div>
                    <div class="ai-help-tag" style="background:rgba(240,185,11,.15);color:var(--vt-yellow);">Volatility %</div>
                    <p>Волатильность. Высокая → шире SL, меньше размер, больше шансов на стоп-хант.</p>
                </div>
                <div>
                    <div class="ai-help-tag" style="background:rgba(246,70,93,.15);color:var(--vt-red);">Liquidity Danger</div>
                    <p>Красные всплески = опасная стена в стакане. Такие входы бот часто блокирует.</p>
                </div>
                <div>
                    <div class="ai-help-tag" style="background:rgba(94,102,115,.2);color:var(--vt-text-muted);">Причины (Reason)</div>
                    <p><b>BASE_REGIME</b> — обычный анализ режима · <b>SOFT_ENTRY</b> — мягкий вход по тренду · <b>LIQUIDITY_DANGER</b> — блок по стакану · <b>RR_BLOCK</b> — плохой Risk/Reward · <b>PERIODIC_30s</b> — фоновый скан.</p>
                </div>
            </div>
            <p class="ai-help-note">Таблица «Последние симуляции» — это <b>не реальные сделки</b>, а обучающие эпизоды (что бот «увидел»). Реальные сделки смотри в Executed / Positions.</p>
        </div>
    </div>
}

<!-- KPI -->
<div class="vt-kpi-grid">
    <div class="vt-kpi">
        <div class="vt-kpi-label">Записей в фильтре</div>
        <div class="vt-kpi-value">@_filtered.Count</div>
        <div class="vt-kpi-sub">из @_all.Count всего</div>
    </div>
    <div class="vt-kpi">
        <div class="vt-kpi-label">Символов</div>
        <div class="vt-kpi-value">@_uniqueSymbols</div>
        <div class="vt-kpi-sub">уникальных в выборке</div>
    </div>
    <div class="vt-kpi">
        <div class="vt-kpi-label">Последнее событие</div>
        <div class="vt-kpi-value" style="font-size:16px;">
            @(_filtered.Count == 0 ? "—" : _filtered.Max(x => x.Time).ToLocalTime().ToString("dd.MM HH:mm"))
        </div>
        <div class="vt-kpi-sub">локальное время</div>
    </div>
    <div class="vt-kpi">
        <div class="vt-kpi-label">Средний Score</div>
        <div class="vt-kpi-value @ScoreClass()">
            @(_filtered.Count == 0 ? "—" : _filtered.Average(x => x.Score).ToString("0.0"))
        </div>
        <div class="vt-kpi-sub">порог фильтра ≥ @_minScore</div>
    </div>
</div>

<!-- Filters + Chart -->
<div class="vt-card" style="margin-top:14px;">
    <div class="vt-card-title" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;">
        <span>График обучения</span>
        <div class="ai-filters">
            <div class="ai-seg">
                <button class="ai-seg-btn @(_timeFilter == TimeFilter.Last24h ? "active" : "")" @onclick="() => SetTimeFilter(TimeFilter.Last24h)">24ч</button>
                <button class="ai-seg-btn @(_timeFilter == TimeFilter.Last7d ? "active" : "")" @onclick="() => SetTimeFilter(TimeFilter.Last7d)">7д</button>
                <button class="ai-seg-btn @(_timeFilter == TimeFilter.Last30d ? "active" : "")" @onclick="() => SetTimeFilter(TimeFilter.Last30d)">30д</button>
                <button class="ai-seg-btn @(_timeFilter == TimeFilter.All ? "active" : "")" @onclick="() => SetTimeFilter(TimeFilter.All)">Всё</button>
            </div>
            <label class="ai-filter-label">
                Min Score
                <input type="range" min="0" max="100" step="5" value="@_minScore"
                       @oninput="OnMinScoreInput" class="ai-range" />
                <span class="ai-range-val">@_minScore</span>
            </label>
            <label class="ai-filter-label">
                Символ
                <select class="vt-input ai-select" value="@(_selectedSymbol ?? "")" @onchange="OnSymbolChanged">
                    <option value="">Все</option>
                    @foreach (var s in _allSymbols)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="ai-legend">
        <span><i class="lg lg-score"></i> Score</span>
        <span><i class="lg lg-conf"></i> Confidence</span>
        <span><i class="lg lg-slope"></i> Slope ×8000</span>
        <span><i class="lg lg-vol"></i> Volatility %</span>
        <span><i class="lg lg-liq"></i> Liquidity Danger</span>
    </div>

    <div class="ai-chart-box">
        <LearningChart />
        @if (_chartPoints.Count == 0)
        {
            <div class="ai-chart-empty">Нет точек для графика — снизь Min Score или смени период/символ</div>
        }
    </div>
</div>

<!-- Sims + reasons -->
<div class="ai-two-col">
    <div class="vt-card">
        <div class="vt-card-title">Симулированные сделки
            <span class="vt-hint" style="margin-left:8px;font-weight:400;">результат «что было бы», не ордера на бирже</span>
        </div>
        @if (_snapshot != null)
        {
            <div class="vt-table-wrap ai-trade-wrap">
                <TradeTable Trades="_snapshot.Trades" />
            </div>
        }
        else
        {
            <div class="vt-hint">Снапшот ещё не загружен</div>
        }
    </div>

    <div class="vt-card">
        <div class="vt-card-title">Топ причин (что бот чаще всего «видел»)</div>
        <div class="ai-reason-list">
            @if (_reasonStats.Count == 0)
            {
                <div class="vt-hint">Нет статистики</div>
            }
            else
            {
                @foreach (var r in _reasonStats.Take(10))
                {
                    <div class="ai-reason-row">
                        <div class="ai-reason-top">
                            <span class="reason">@r.Reason</span>
                            <span class="mono">@r.Count · score @r.AvgScore.ToString("0.0")</span>
                        </div>
                        <div class="ai-bar"><div class="ai-bar-fill" style="width:@(r.PercentOfMax)%"></div></div>
                        <div class="vt-hint">Conf ~ @r.AvgConf.ToString("0.0")%</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Market episodes -->
<div class="vt-card" style="margin-top:14px;">
    <div class="vt-card-title">Последние рыночные наблюдения
        <span class="vt-hint" style="margin-left:8px;font-weight:400;">MarketStates — режимы и score по символам</span>
    </div>
    <div class="vt-table-wrap">
        <table class="vt-table">
            <thead>
                <tr>
                    <th>Время</th>
                    <th>Символ</th>
                    <th>Режим</th>
                    <th>Score</th>
                    <th>Conf</th>
                    <th>Vol %</th>
                    <th>Slope %</th>
                    <th>Причина</th>
                </tr>
            </thead>
            <tbody>
            @if (_filtered.Count == 0)
            {
                <tr><td colspan="8" class="vt-hint">Нет данных под фильтры</td></tr>
            }
            else
            {
                @foreach (var x in _filtered.Take(50))
                {
                    <tr>
                        <td class="mono">@x.Time.ToLocalTime().ToString("dd.MM HH:mm")</td>
                        <td><span class="sym">@x.Symbol</span></td>
                        <td><span class="pill @RegimePill(x.Regime)">@ShortRegime(x.Regime)</span></td>
                        <td class="mono">@x.Score</td>
                        <td class="mono">@x.Confidence%</td>
                        <td class="mono">@x.VolatilityPercent.ToString("0.00")</td>
                        <td class="mono">@x.TrendSlopePercent.ToString("0.00")</td>
                        <td><span class="reason">@x.Reason</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Symbols table -->
<div class="vt-card" style="margin-top:14px;">
    <div class="vt-card-title">Символы с наибольшим числом обучающих эпизодов</div>
    <div class="vt-table-wrap">
        <table class="vt-table">
            <thead>
                <tr>
                    <th>Символ</th>
                    <th>Эпизодов</th>
                    <th>Avg Score</th>
                    <th>Avg Conf</th>
                    <th>Частый режим</th>
                    <th>Частая причина</th>
                </tr>
            </thead>
            <tbody>
            @if (_symbolStats.Count == 0)
            {
                <tr><td colspan="6" class="vt-hint">Нет данных</td></tr>
            }
            else
            {
                @foreach (var s in _symbolStats.Take(20))
                {
                    <tr>
                        <td><span class="sym">@s.Symbol</span></td>
                        <td class="mono">@s.Count</td>
                        <td class="mono">@s.AvgScore.ToString("0.0")</td>
                        <td class="mono">@s.AvgConf.ToString("0.0")</td>
                        <td><span class="pill @RegimePill(s.TopRegime)">@ShortRegime(s.TopRegime)</span></td>
                        <td><span class="reason">@s.TopSmartType</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<style>
.ai-filters { display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
.ai-seg { display:inline-flex; background:var(--vt-bg); border:1px solid var(--vt-border); border-radius:8px; overflow:hidden; }
.ai-seg-btn { background:transparent; border:0; color:var(--vt-text-muted); padding:6px 12px; font-size:12px; cursor:pointer; }
.ai-seg-btn.active { background:var(--vt-bg-hover); color:var(--vt-text); font-weight:600; }
.ai-filter-label { display:flex; align-items:center; gap:8px; color:var(--vt-text-muted); font-size:12px; }
.ai-range { width:100px; accent-color:var(--vt-accent); }
.ai-range-val { font-family:var(--vt-mono); min-width:24px; color:var(--vt-text); }
.ai-select { width:140px; padding:6px 8px; font-size:12px; }
.ai-legend { display:flex; flex-wrap:wrap; gap:14px; padding:8px 0 4px; font-size:11px; color:var(--vt-text-muted); }
.ai-legend .lg { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; vertical-align:middle; }
.lg-score { background:#1e90ff; }
.lg-conf { background:#0ecb81; }
.lg-slope { background:#9b59ff; }
.lg-vol { background:#f0b90b; }
.lg-liq { background:#f6465d; }
.ai-chart-box { position:relative; min-height:280px; background:var(--vt-bg); border-radius:8px; border:1px solid var(--vt-border-soft); padding:8px; }
.ai-chart-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:var(--vt-text-dim); pointer-events:none; }
.ai-two-col { display:grid; grid-template-columns:1.4fr 1fr; gap:14px; margin-top:14px; }
@media (max-width:1100px){ .ai-two-col { grid-template-columns:1fr; } }
.mono { font-family:var(--vt-mono); font-size:12px; }
.sym { font-weight:600; letter-spacing:.02em; }
.reason { font-family:var(--vt-mono); font-size:11px; color:var(--vt-text-muted); }
.pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; }
.pill-up { background:var(--vt-green-dim); color:var(--vt-green); }
.pill-down { background:var(--vt-red-dim); color:var(--vt-red); }
.pill-flat { background:rgba(94,102,115,.25); color:var(--vt-text-muted); }
.pill-chop { background:var(--vt-yellow-dim); color:var(--vt-yellow); }
.ai-reason-list { display:flex; flex-direction:column; gap:12px; }
.ai-reason-top { display:flex; justify-content:space-between; gap:8px; margin-bottom:4px; font-size:12px; }
.ai-bar { height:6px; background:var(--vt-bg); border-radius:4px; overflow:hidden; }
.ai-bar-fill { height:100%; background:linear-gradient(90deg, var(--vt-green), var(--vt-blue)); border-radius:4px; }
.ai-help-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:200; }
.ai-help-modal { position:fixed; z-index:210; top:50%; left:50%; transform:translate(-50%,-50%); width:min(720px,92vw); max-height:80vh; overflow:auto; background:var(--vt-bg-card); border:1px solid var(--vt-border); border-radius:12px; box-shadow:var(--vt-shadow); }
.ai-help-head { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--vt-border); font-weight:600; }
.ai-help-body { padding:16px; }
.ai-help-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
@media (max-width:700px){ .ai-help-grid { grid-template-columns:1fr; } }
.ai-help-tag { display:inline-block; padding:3px 8px; border-radius:6px; font-size:11px; font-weight:700; margin-bottom:6px; }
.ai-help-body p { margin:0; color:var(--vt-text-muted); font-size:12.5px; line-height:1.5; }
.ai-help-note { margin-top:16px; padding:10px 12px; background:var(--vt-yellow-dim); border-radius:8px; color:var(--vt-text); font-size:12.5px; }
.score-good { color:var(--vt-green); }
.score-mid { color:var(--vt-yellow); }
.score-low { color:var(--vt-red); }
</style>


@code {

    private enum TimeFilter
    {
        Last24h,
        Last7d,
        Last30d,
        All
    }

    private bool _showHelp = false;

    // 🔥 выбранный символ
    private string? _selectedSymbol = null;

    // 🔥 список всех символов для дропа
    private List<string> _allSymbols = new();

    // Сырые записи (для таблиц/статистики)
    private List<AiLearningRecord> _all = new();
    private AiLearningSnapshot? _snapshot;
    private List<AiLearningRecord> _filtered = new();

    // Точки для графика
    private List<AiLearningPointModel> _chartPoints = new();

    private int _uniqueSymbols;
    private TimeFilter _timeFilter = TimeFilter.Last7d;
    private int _minScore = 50;

    private List<ReasonStat> _reasonStats = new();
    private List<SymbolStat> _symbolStats = new();

    private bool _needsChartUpdate;

    // 🔁 автообновление каждые 3 сек
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private Task? _refreshTask;

    protected override async Task OnInitializedAsync()
    {
        var snap = await AiLearnService.GetAllAsync();

        if (snap != null)
        {
            _snapshot = snap;
            BuildFromSnapshot(snap);
        }

        ApplyFilters();
        StartAutoRefresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _needsChartUpdate)
        {
            _needsChartUpdate = false;

            if (_chartPoints.Count > 0)
            {
                await JS.InvokeVoidAsync("VertexLearningChart.renderData", _chartPoints);
            }
        }
    }

    private void StartAutoRefresh()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _refreshTask = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (_timer != null && await _timer.WaitForNextTickAsync(token))
            {
                var snap = await AiLearnService.GetAllAsync();
                if (snap == null) continue;

                await InvokeAsync(() =>
                {
                    _snapshot = snap;
                    BuildFromSnapshot(snap);
                    ApplyFilters();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void BuildFromSnapshot(AiLearningSnapshot snap)
    {
        _all = snap.MarketStates
            .Select(ms => new AiLearningRecord
            {
                Symbol = ms.Symbol,
                Time = ms.Time,
                Reason = ms.Reason ?? "-",
                SmartType = ms.Reason ?? "-",
                Regime = ms.Regime.ToString(),
                Confidence = (int)(ms.Confidence * 100m),
                Score = (int)(ms.Confidence * 100m),
                VolatilityPercent = ms.VolatilityPercent * 100m,
                TrendSlopePercent = ms.TrendSlopePercent * 100m,
                Atr = ms.Atr
            })
            .OrderByDescending(x => x.Time)
            .ToList();

        _allSymbols = _all
            .Select(x => x.Symbol)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private void SetTimeFilter(TimeFilter filter)
    {
        _timeFilter = filter;
        ApplyFilters();
    }

    // 🔥 смена символа из select
    private void OnSymbolChanged(ChangeEventArgs e)
    {
        _selectedSymbol = e.Value?.ToString();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _all.AsEnumerable();

        // 0) Фильтр по символу
        if (!string.IsNullOrWhiteSpace(_selectedSymbol))
        {
            query = query.Where(x =>
                x.Symbol.Equals(_selectedSymbol, StringComparison.OrdinalIgnoreCase));
        }

        // 1) Фильтр по времени
        if (_timeFilter != TimeFilter.All && _all.Count > 0)
        {
            var now = DateTime.UtcNow;
            DateTime from = _timeFilter switch
            {
                TimeFilter.Last24h => now.AddDays(-1),
                TimeFilter.Last7d => now.AddDays(-7),
                TimeFilter.Last30d => now.AddDays(-30),
                _ => now.AddYears(-10)
            };

            query = query.Where(x => x.Time >= from);
        }

        // 2) Фильтр по минимальному Score
        query = query.Where(x => x.Score >= _minScore);

        _filtered = query
            .OrderByDescending(x => x.Time)
            .ToList();

        _uniqueSymbols = _filtered
            .Select(x => x.Symbol)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        // === Статистика причин/символов ===
        BuildReasonStats();
        BuildSymbolStats();
        _needsChartUpdate = true;

        // === Точки для графика ===
        _chartPoints = _filtered
            .OrderBy(x => x.Time)
            .Select(x => new AiLearningPointModel
            {
                Time = x.Time,
                Symbol = x.Symbol,
                Score = x.Score,                    // 0–100
                Slope = x.TrendSlopePercent / 100m, // 0.x, JS сам умножит
                Volatility = x.VolatilityPercent / 100m,
                LiquidityDanger = false,
                Confidence = x.Confidence / 100m    // 0–1
            })
            .ToList();

        _needsChartUpdate = true;
        StateHasChanged();
    }

    private void BuildReasonStats()
    {
        _reasonStats.Clear();
        if (_filtered.Count == 0) return;

        var groups = _filtered
            .GroupBy(x => x.Reason ?? "Unknown")
            .ToList();

        var maxCount = groups.Max(g => g.Count());

        foreach (var g in groups.OrderByDescending(g => g.Count()).Take(10))
        {
            var avgScore = g.Average(x => x.Score);
            var avgConf = g.Average(x => (double)x.Confidence);

            _reasonStats.Add(new ReasonStat
            {
                Reason = g.Key,
                Count = g.Count(),
                AvgScore = (decimal)avgScore,
                AvgConf = (decimal)avgConf,
                PercentOfMax = maxCount == 0 ? 0 : (int)(g.Count() * 100.0 / maxCount)
            });
        }
    }

    private void BuildSymbolStats()
    {
        _symbolStats.Clear();
        if (_filtered.Count == 0) return;

        var groups = _filtered
            .GroupBy(x => x.Symbol)
            .ToList();

        foreach (var g in groups
                     .OrderByDescending(g => g.Count())
                     .Take(20))
        {
            var avgScore = g.Average(x => x.Score);
            var avgConf = g.Average(x => (double)x.Confidence);

            var topRegime = g.Where(x => !string.IsNullOrEmpty(x.Regime))
                             .GroupBy(x => x.Regime)
                             .OrderByDescending(gg => gg.Count())
                             .Select(gg => gg.Key)
                             .FirstOrDefault() ?? "-";

            var topSmart = g.Where(x => !string.IsNullOrEmpty(x.SmartType))
                            .GroupBy(x => x.SmartType)
                            .OrderByDescending(gg => gg.Count())
                            .Select(gg => gg.Key)
                            .FirstOrDefault() ?? "-";

            _symbolStats.Add(new SymbolStat
            {
                Symbol = g.Key,
                Count = g.Count(),
                AvgScore = (decimal)avgScore,
                AvgConf = (decimal)avgConf,
                TopRegime = topRegime,
                TopSmartType = topSmart
            });
        }
    }

    private string ChipClass(TimeFilter f)
        => _timeFilter == f ? "ai-chip ai-chip-active" : "ai-chip";

    private class ReasonStat
    {
        public string Reason { get; set; } = string.Empty;
        public int Count { get; set; }
        public decimal AvgScore { get; set; }
        public decimal AvgConf { get; set; }
        public int PercentOfMax { get; set; }
    }

    private class SymbolStat
    {
        public string Symbol { get; set; } = string.Empty;
        public int Count { get; set; }
        public decimal AvgScore { get; set; }
        public decimal AvgConf { get; set; }
        public string TopRegime { get; set; } = string.Empty;
        public string TopSmartType { get; set; } = string.Empty;
    }

    
    private async Task RefreshNow()
    {
        var snap = await AiLearnService.GetAllAsync();
        if (snap != null)
        {
            _snapshot = snap;
            BuildFromSnapshot(snap);
            ApplyFilters();
        }
    }

    private void OnMinScoreInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _minScore = v;
            ApplyFilters();
        }
    }

    private string ScoreClass()
    {
        if (_filtered.Count == 0) return "";
        var avg = _filtered.Average(x => x.Score);
        if (avg >= 65) return "score-good";
        if (avg >= 45) return "score-mid";
        return "score-low";
    }

    private static string ShortRegime(string? r)
    {
        if (string.IsNullOrEmpty(r)) return "—";
        return r
            .Replace("StrongUpTrend", "↑ Strong")
            .Replace("StrongDownTrend", "↓ Strong")
            .Replace("UpTrend", "↑ Trend")
            .Replace("DownTrend", "↓ Trend")
            .Replace("VolatileChop", "⚡ Chop")
            .Replace("Range", "↔ Range");
    }

    private static string RegimePill(string? r)
    {
        if (string.IsNullOrEmpty(r)) return "pill-flat";
        if (r.Contains("Up", StringComparison.OrdinalIgnoreCase)) return "pill-up";
        if (r.Contains("Down", StringComparison.OrdinalIgnoreCase)) return "pill-down";
        if (r.Contains("Chop", StringComparison.OrdinalIgnoreCase) || r.Contains("Volatile", StringComparison.OrdinalIgnoreCase)) return "pill-chop";
        return "pill-flat";
    }

public async ValueTask DisposeAsync()
    {
        if (_timer != null)
        {
            _cts?.Cancel();
            _timer.Dispose();
        }

        if (_refreshTask != null)
        {
            try { await _refreshTask; } catch { }
        }
    }
}
