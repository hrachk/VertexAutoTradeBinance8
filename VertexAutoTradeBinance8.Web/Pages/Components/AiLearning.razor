@page "/ai-learning"
@using System.Globalization
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject AiLearningFileService AiFile
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(LangRu ? "Окно обучения" : "Learning Window") · Vertex</PageTitle>

<div class="vxl">

    <!-- TOP BAR -->
    <div class="vxl-top">
        <div class="vxl-badge">
            <span class="vxl-badge-dot"></span>
            @(LangRu ? "ДИАГНОСТИКА · НЕ GATE" : "DIAGNOSTICS · NOT A GATE")
        </div>
        <div class="vxl-lang">
            <button type="button" class="@(!LangRu ? "on" : null)" @onclick="() => SetLang(false)">EN</button>
            <span class="vxl-lang-sep">|</span>
            <button type="button" class="@(LangRu ? "on" : null)" @onclick="() => SetLang(true)">RU</button>
        </div>
    </div>

    <!-- HERO -->
    <header class="vxl-hero">
        <div class="vxl-hero-text">
            <h1 class="vxl-title">
                <span class="vxl-diamond">◆</span>
                @(LangRu ? "Окно обучения" : "Learning Window")
            </h1>
            <p class="vxl-lead">
                @if (LangRu)
                {
                    <text>Это снимок состояния рынка из <code>ai_learning.json</code>, а не стратегия или мозг AI.</text>
                }
                else
                {
                    <text>Engine market-state snapshot (<code>ai_learning.json</code>). Transparency — not the strategy brain.</text>
                }
            </p>
            <div class="vxl-nav">
                <a href="/help" class="vxl-chip">💬 Help</a>
                <a href="/ai-dashboard" class="vxl-chip">◈ AI Dashboard</a>
                <a href="/market" class="vxl-chip">▣ Market</a>
            </div>
        </div>

        <div class="vxl-kpis">
            <div class="vxl-kpi">
                <div class="vxl-kpi-ico blue">▣</div>
                <div class="vxl-kpi-v">@TotalEvents</div>
                <div class="vxl-kpi-l">@(LangRu ? "Точки" : "Points")</div>
            </div>
            <div class="vxl-kpi">
                <div class="vxl-kpi-ico cyan">◎</div>
                <div class="vxl-kpi-v">@UniqueSymbols</div>
                <div class="vxl-kpi-l">@(LangRu ? "Символы" : "Symbols")</div>
            </div>
            <div class="vxl-kpi">
                <div class="vxl-kpi-ico yellow">★</div>
                <div class="vxl-kpi-v @(ScoreTone(AvgScore))">@AvgScore</div>
                <div class="vxl-kpi-l">@(LangRu ? "Ср. score" : "Avg score")</div>
            </div>
            <div class="vxl-kpi">
                <div class="vxl-kpi-ico green">✓</div>
                <div class="vxl-kpi-v @(AvgConf >= 0.7m ? "hi" : "mid")">@((AvgConf * 100m).ToString("F0", Culture))%</div>
                <div class="vxl-kpi-l">Conf</div>
            </div>
        </div>
    </header>

    <div class="vxl-meta">
        <span>@(LangRu ? "Последнее" : "Last") <b>@(LastEventUtc.HasValue ? LastEventUtc.Value.ToLocalTime().ToString("dd.MM HH:mm") : "—")</b></span>
        <span class="vxl-dot-sep">·</span>
        <span>@(LangRu ? "Топ" : "Top") <b class="acc">@TopSymbol</b></span>
        <span class="vxl-dot-sep">·</span>
        <span>@(LangRu ? "обновл." : "refresh") <b>2s</b></span>
    </div>

    @if (!RecentPoints.Any())
    {
        <section class="vxl-empty-wrap">
            <div class="vxl-empty">
                <div class="vxl-empty-gem">◆</div>
                <h2>@(LangRu ? "Снимок пуст" : "Snapshot empty")</h2>
                <p>
                    @if (LangRu)
                    {
                        <text>Файл <code>ai-models/ai_learning.json</code> не найден или не содержит данных.
                        Система продолжает работать — <b class="acc">торговля не заблокирована</b>.</text>
                    }
                    else
                    {
                        <text>File <code>ai-models/ai_learning.json</code> missing or empty.
                        System keeps running — <b class="acc">trading is not blocked</b>.</text>
                    }
                </p>
                <div class="vxl-steps">
                    <div class="vxl-step">
                        <span class="vxl-step-n">1</span>
                        <div>
                            <b>@(LangRu ? "Движок записывает снимок" : "Engine writes snapshot")</b>
                            <small>@(LangRu ? "Состояние сохраняется в Root." : "State saved under Root.")</small>
                        </div>
                    </div>
                    <div class="vxl-step">
                        <span class="vxl-step-n">2</span>
                        <div>
                            <b>@(LangRu ? "Веб-интерфейс читает Root" : "Web reads same Root")</b>
                            <small>@(LangRu ? "Получает тот же снимок." : "Same snapshot path.")</small>
                        </div>
                    </div>
                    <div class="vxl-step">
                        <span class="vxl-step-n">3</span>
                        <div>
                            <b>@(LangRu ? "Точки появятся здесь" : "Points appear here")</b>
                            <small>@(LangRu ? "После успешной записи snapshot." : "After a successful snapshot write.")</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <!-- ROW: activity + distribution -->
        <section class="vxl-grid2">
            <div class="vxl-panel">
                <div class="vxl-panel-h">
                    
                    <span class="vxl-panel-t">@(LangRu ? "АКТИВНОСТЬ СНИМКА" : "SNAPSHOT ACTIVITY")</span>
                    <div class="vxl-legend">
                        <span><i class="c-score"></i> Score (0–100)</span>
                        <span><i class="c-conf"></i> Confidence (%)</span>
                        <span><i class="c-vol"></i> Volatility (norm.)</span>
                    </div>
                </div>
                <div class="vxl-chart-box">
                    <div class="vxl-y-left">
                        <span>100</span><span>75</span><span>50</span><span>25</span><span>0</span>
                    </div>
                    <div class="vxl-chart-main">
                        <svg class="vxl-svg" viewBox="0 0 600 160" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="gScore" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35"/>
                                    <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            @for (var g = 0; g <= 4; g++)
                            {
                                var y = g * 40;
                                <line x1="0" y1="@y" x2="600" y2="@y" class="vxl-grid-line" />
                            }
                            <polyline class="vxl-line vol" points="@VolPolyline" />
                            <polyline class="vxl-line conf" points="@ConfPolyline" />
                            <polyline class="vxl-line score" points="@ScorePolyline" />
                        </svg>
                        <div class="vxl-x-axis">
                            @foreach (var t in ChartTimeLabels)
                            {
                                <span>@t</span>
                            }
                        </div>
                    </div>
                    <div class="vxl-y-right">
                        <span>100%</span><span>75%</span><span>50%</span><span>25%</span><span>0%</span>
                    </div>
                </div>
            </div>

            <div class="vxl-panel">
                <div class="vxl-panel-h">
                    <span class="vxl-panel-t">@(LangRu ? "РАСПРЕДЕЛЕНИЕ SCORE" : "SCORE DISTRIBUTION")</span>
                </div>
                <div class="vxl-bars">
                    <div class="vxl-bar-row">
                        <span class="vxl-bar-lab"><span class="vxl-tag low">◎</span> Low</span>
                        <div class="vxl-bar-track"><div class="vxl-bar-fill low" style="width:@DistLo%"></div></div>
                        <span class="vxl-bar-pct">@DistLo%</span>
                    </div>
                    <div class="vxl-bar-row">
                        <span class="vxl-bar-lab"><span class="vxl-tag mid">—</span> Mid</span>
                        <div class="vxl-bar-track"><div class="vxl-bar-fill mid" style="width:@DistMid%"></div></div>
                        <span class="vxl-bar-pct">@DistMid%</span>
                    </div>
                    <div class="vxl-bar-row">
                        <span class="vxl-bar-lab"><span class="vxl-tag high">↗</span> High</span>
                        <div class="vxl-bar-track"><div class="vxl-bar-fill high" style="width:@DistHi%"></div></div>
                        <span class="vxl-bar-pct">@DistHi%</span>
                    </div>
                </div>
                <div class="vxl-stat3">
                    <div>
                        <div class="vxl-stat3-l">@(LangRu ? "Средний score" : "Avg score")</div>
                        <div class="vxl-stat3-v mid">@AvgScore</div>
                        <div class="vxl-spark mid"></div>
                    </div>
                    <div>
                        <div class="vxl-stat3-l">@(LangRu ? "Медиана score" : "Median score")</div>
                        <div class="vxl-stat3-v">@MedianScore</div>
                        <div class="vxl-spark cyan"></div>
                    </div>
                    <div>
                        <div class="vxl-stat3-l">@(LangRu ? "Стд. отклонение" : "Std. deviation")</div>
                        <div class="vxl-stat3-v acc">@StdScore.ToString("F1", Culture)</div>
                        <div class="vxl-spark cyan"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ROW: matrix + stream -->
        <section class="vxl-grid2">
            <div class="vxl-panel">
                <div class="vxl-panel-h">
                    <span class="vxl-panel-t">@(LangRu ? "МАТРИЦА СИМВОЛОВ" : "SYMBOL MATRIX")</span>
                    <span class="vxl-panel-s">@(LangRu ? "клик = фильтр ленты" : "click = filter stream")</span>
                </div>
                <div class="vxl-matrix">
                    @foreach (var e in Exposure.Take(16))
                    {
                        <div class="vxl-mrow @(SelectedSymbol == e.Symbol ? "sel" : null)" @onclick="() => SelectSymbol(e.Symbol)">
                            <span class="vxl-msym">@ShortSym(e.Symbol)</span>
                            <span class="vxl-mreg @RegClass(e.Regime)">@e.Regime</span>
                            <div class="vxl-mbar">
                                <div style="width:@(Math.Clamp(e.Score,0,100))%;background:@ScoreHex(e.Score)"></div>
                            </div>
                            <span class="vxl-msc" style="color:@ScoreHex(e.Score)">@e.Score</span>
                        </div>
                    }
                </div>
            </div>

            <div class="vxl-panel">
                <div class="vxl-panel-h">
                    <span class="vxl-panel-t">@(LangRu ? "ЛЕНТА СОБЫТИЙ" : "EVENT STREAM")</span>
                    <span class="vxl-panel-s">
                        @(SelectedSymbol != null
                            ? (LangRu ? $"фильтр: {ShortSym(SelectedSymbol)}" : $"filter: {ShortSym(SelectedSymbol)}")
                            : (LangRu ? "последние точки" : "latest points"))
                    </span>
                </div>
                <div class="vxl-stream">
                    @{
                        var stream = (SelectedSymbol == null
                            ? RecentPoints
                            : RecentPoints.Where(p => p.Symbol == SelectedSymbol))
                            .OrderByDescending(p => p.Time)
                            .Take(14)
                            .ToList();
                    }
                    @foreach (var p in stream)
                    {
                        var sc = (int)p.Score;
                        var confPct = (int)(p.Confidence * 100m);
                        var regime = SimplifyRegime(p.Regime);
                        <div class="vxl-srow">
                            <span class="vxl-st">@p.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span class="vxl-ss">@ShortSym(p.Symbol)</span>
                            <span class="vxl-ssc" style="color:@ScoreHex(sc)">@sc</span>
                            <span class="vxl-sreg @RegClass(regime)">@regime</span>
                            <span class="vxl-scf">@confPct%</span>
                            <span class="vxl-sarr @(sc >= 60 ? "up" : "dn")">@(sc >= 60 ? "↑" : "↓")</span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="vxl-foot">
            <div class="vxl-foot-card">
                <div class="vxl-foot-h">
                    <span class="vxl-shield">🛡</span>
                    @(LangRu ? "Прозрачность, а не альфа" : "Transparency, not alpha")
                </div>
                <p>
                    @if (LangRu)
                    {
                        <text>Этот модуль показывает, что модель видит прямо сейчас.
                        Никаких сигналов, никаких рекомендаций — только данные и контекст.</text>
                    }
                    else
                    {
                        <text>This module shows what the engine currently sees.
                        No signals, no trade recommendations — data and context only.</text>
                    }
                </p>
            </div>
            <div class="vxl-foot-card">
                <div class="vxl-foot-h">
                    <span>🧊</span>
                    @(LangRu ? "Данные из ai_learning.json" : "Data from ai_learning.json")
                </div>
                <p>
                    @if (LangRu)
                    {
                        <text>Снимок рынка в реальном времени. Используйте этот дашборд для понимания, а не для торговли.</text>
                    }
                    else
                    {
                        <text>Live market snapshot. Use this dashboard for understanding — not for placing trades.</text>
                    }
                </p>
            </div>
        </footer>
    }
</div>

<style>
/* ═══ /ai-learning — 1:1 VERTEX dark neon glass (mockup) ═══ */
.vxl {
  --bg: #070b12;
  --panel: rgba(10, 16, 26, 0.92);
  --line: rgba(0, 212, 255, 0.14);
  --line2: rgba(0, 212, 255, 0.08);
  --acc: #00d4ff;
  --blue: #3b82f6;
  --green: #22c55e;
  --yellow: #eab308;
  --red: #ef4444;
  --txt: #e6eef8;
  --dim: #7d8ea3;
  --mono: ui-monospace, "SF Mono", "JetBrains Mono", Consolas, monospace;
  min-height: 100%;
  padding: 18px 24px 40px;
  background:
    radial-gradient(ellipse 70% 45% at 15% 0%, rgba(0, 180, 255, 0.07), transparent 55%),
    radial-gradient(ellipse 50% 35% at 90% 5%, rgba(34, 197, 94, 0.04), transparent 50%),
    var(--bg);
  color: var(--txt);
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
}

.vxl-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}
.vxl-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
  color: var(--acc);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 14px;
  background: rgba(0, 212, 255, 0.06);
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.08);
}
.vxl-badge-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--acc);
  box-shadow: 0 0 10px var(--acc);
  animation: vxl-pulse 1.6s ease-in-out infinite;
}
@@keyframes vxl-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}
.vxl-lang {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}
.vxl-lang button {
  background: none;
  border: none;
  color: var(--dim);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
}
.vxl-lang button.on {
  color: var(--acc);
  background: rgba(0, 212, 255, 0.12);
}
.vxl-lang-sep { color: var(--dim); opacity: 0.5; }

.vxl-hero {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: start;
  margin-bottom: 10px;
}
.vxl-title {
  margin: 0 0 8px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: 0.3px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.vxl-diamond {
  color: var(--acc);
  font-size: 22px;
  filter: drop-shadow(0 0 12px rgba(0, 212, 255, 0.7));
}
.vxl-lead {
  margin: 0 0 14px;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--dim);
  max-width: 480px;
}
.vxl-lead code {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--acc);
  background: rgba(0, 212, 255, 0.08);
  padding: 1px 6px;
  border-radius: 4px;
}
.vxl-nav { display: flex; gap: 8px; flex-wrap: wrap; }
.vxl-chip {
  text-decoration: none;
  font-size: 12px;
  color: var(--txt);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 7px 14px;
  background: rgba(0, 212, 255, 0.05);
  transition: 0.15s;
}
.vxl-chip:hover {
  border-color: rgba(0, 212, 255, 0.4);
  background: rgba(0, 212, 255, 0.12);
  color: var(--acc);
}

.vxl-kpis {
  display: grid;
  grid-template-columns: repeat(4, 108px);
  gap: 10px;
}
.vxl-kpi {
  text-align: center;
  padding: 14px 8px 12px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(14, 22, 36, 0.95), rgba(8, 12, 20, 0.9));
  box-shadow: 0 0 24px rgba(0, 212, 255, 0.05), inset 0 1px 0 rgba(255,255,255,0.04);
}
.vxl-kpi-ico {
  width: 28px; height: 28px;
  margin: 0 auto 8px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}
.vxl-kpi-ico.blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
.vxl-kpi-ico.cyan { background: rgba(0, 212, 255, 0.12); color: var(--acc); }
.vxl-kpi-ico.yellow { background: rgba(234, 179, 8, 0.12); color: var(--yellow); }
.vxl-kpi-ico.green { background: rgba(34, 197, 94, 0.12); color: var(--green); font-size: 11px; }
.vxl-kpi-v {
  font-family: var(--mono);
  font-size: 22px;
  font-weight: 800;
  line-height: 1.1;
}
.vxl-kpi-v.hi { color: var(--green); }
.vxl-kpi-v.mid { color: var(--yellow); }
.vxl-kpi-v.lo { color: var(--red); }
.vxl-kpi-l {
  margin-top: 4px;
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 0.3px;
}

.vxl-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  font-size: 12px;
  color: var(--dim);
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line2);
}
.vxl-meta b { color: var(--txt); font-weight: 600; }
.vxl-meta b.acc, .acc { color: var(--acc); }
.vxl-dot-sep { opacity: 0.4; }

.vxl-grid2 {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}
.vxl-panel {
  background: linear-gradient(165deg, rgba(12, 20, 34, 0.95), rgba(8, 12, 22, 0.92));
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px 16px 16px;
  box-shadow:
    0 0 0 1px rgba(0, 212, 255, 0.04),
    0 8px 32px rgba(0, 0, 0, 0.35),
    0 0 40px rgba(0, 212, 255, 0.06),
    inset 0 1px 0 rgba(255,255,255,0.04);
  backdrop-filter: blur(14px);
  position: relative;
  overflow: hidden;
}
.vxl-panel::before {
  content: "";
  position: absolute;
  top: 0; left: 12%; right: 12%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0,212,255,0.45), transparent);
  pointer-events: none;
}
.vxl-panel-h {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}
.vxl-panel-t {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.6px;
  color: var(--acc);
}
.vxl-panel-s { font-size: 11px; color: var(--dim); margin-left: auto; }
.vxl-legend {
  display: flex;
  gap: 14px;
  margin-left: auto;
  font-size: 10px;
  color: var(--dim);
}
.vxl-legend i {
  display: inline-block;
  width: 10px; height: 3px;
  border-radius: 2px;
  margin-right: 4px;
  vertical-align: middle;
}
.vxl-legend i.c-score { background: var(--blue); box-shadow: 0 0 6px var(--blue); }
.vxl-legend i.c-conf { background: var(--green); box-shadow: 0 0 6px var(--green); }
.vxl-legend i.c-vol { background: var(--yellow); box-shadow: 0 0 6px var(--yellow); }

.vxl-chart-box {
  display: grid;
  grid-template-columns: 28px 1fr 36px;
  gap: 4px;
  align-items: stretch;
  height: 200px;
}
.vxl-y-left, .vxl-y-right {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 9px;
  color: var(--dim);
  font-family: var(--mono);
  padding: 2px 0 18px;
}
.vxl-y-right { text-align: right; }
.vxl-chart-main { display: flex; flex-direction: column; min-width: 0; }
.vxl-svg {
  flex: 1;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 8px;
  border: 1px solid var(--line2);
}
.vxl-grid-line { stroke: rgba(255,255,255,0.04); stroke-width: 1; }
.vxl-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.vxl-line.score { stroke: #3b82f6; filter: drop-shadow(0 0 4px rgba(59,130,246,0.6)); }
.vxl-line.conf { stroke: #22c55e; filter: drop-shadow(0 0 4px rgba(34,197,94,0.5)); }
.vxl-line.vol { stroke: #eab308; filter: drop-shadow(0 0 4px rgba(234,179,8,0.45)); }
.vxl-x-axis {
  display: flex;
  justify-content: space-between;
  font-size: 9px;
  color: var(--dim);
  font-family: var(--mono);
  margin-top: 4px;
  padding: 0 2px;
}

.vxl-bars { display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; }
.vxl-bar-row {
  display: grid;
  grid-template-columns: 72px 1fr 40px;
  gap: 10px;
  align-items: center;
}
.vxl-bar-lab { font-size: 12px; color: var(--dim); display: flex; align-items: center; gap: 6px; }
.vxl-tag {
  width: 18px; height: 18px; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 9px;
}
.vxl-tag.low { background: rgba(239,68,68,0.15); color: var(--red); }
.vxl-tag.mid { background: rgba(234,179,8,0.15); color: var(--yellow); }
.vxl-tag.high { background: rgba(34,197,94,0.15); color: var(--green); }
.vxl-bar-track {
  height: 10px;
  border-radius: 5px;
  background: rgba(255,255,255,0.05);
  overflow: hidden;
}
.vxl-bar-fill { height: 100%; border-radius: 5px; transition: width .4s ease; }
.vxl-bar-fill.low { background: linear-gradient(90deg, #dc2626, #f87171); box-shadow: 0 0 10px rgba(239,68,68,0.4); }
.vxl-bar-fill.mid { background: linear-gradient(90deg, #ca8a04, #facc15); box-shadow: 0 0 10px rgba(234,179,8,0.35); }
.vxl-bar-fill.high { background: linear-gradient(90deg, #16a34a, #4ade80); box-shadow: 0 0 10px rgba(34,197,94,0.4); }
.vxl-bar-pct { font-family: var(--mono); font-size: 12px; text-align: right; font-weight: 600; }

.vxl-stat3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  border-top: 1px solid var(--line2);
  padding-top: 14px;
}
.vxl-stat3 > div { text-align: center; }
.vxl-stat3-l { font-size: 10px; color: var(--dim); margin-bottom: 4px; }
.vxl-stat3-v {
  font-family: var(--mono);
  font-size: 22px;
  font-weight: 800;
}
.vxl-stat3-v.mid { color: var(--yellow); }
.vxl-stat3-v.acc { color: var(--acc); }
.vxl-spark {
  height: 18px;
  margin-top: 6px;
  border-radius: 4px;
  opacity: 0.7;
  background:
    repeating-linear-gradient(90deg, transparent, transparent 4px, currentColor 4px, currentColor 5px);
  mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
}
.vxl-spark.mid { color: var(--yellow); background: linear-gradient(90deg, transparent, rgba(234,179,8,0.5), transparent); height: 3px; margin: 10px auto 0; width: 70%; }
.vxl-spark.cyan { color: var(--acc); background: linear-gradient(90deg, transparent, rgba(0,212,255,0.5), transparent); height: 3px; margin: 10px auto 0; width: 70%; }

.vxl-matrix { display: flex; flex-direction: column; gap: 6px; max-height: 340px; overflow-y: auto; }
.vxl-mrow {
  display: grid;
  grid-template-columns: 56px 72px 1fr 36px;
  gap: 8px;
  align-items: center;
  padding: 8px 10px;
  border-radius: 10px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: 0.12s;
}
.vxl-mrow:hover { background: rgba(0, 212, 255, 0.05); }
.vxl-mrow.sel {
  background: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.35);
}
.vxl-msym { font-family: var(--mono); font-weight: 700; font-size: 12px; color: var(--acc); }
.vxl-mreg {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
}
.vxl-mreg.bull { color: var(--green); background: rgba(34, 197, 94, 0.12); }
.vxl-mreg.bear { color: var(--red); background: rgba(239, 68, 68, 0.12); }
.vxl-mreg.rng { color: var(--yellow); background: rgba(234, 179, 8, 0.12); }
.vxl-mbar {
  height: 6px;
  border-radius: 3px;
  background: rgba(255,255,255,0.06);
  overflow: hidden;
}
.vxl-mbar > div { height: 100%; border-radius: 3px; }
.vxl-msc { font-family: var(--mono); font-weight: 700; font-size: 13px; text-align: right; }

.vxl-stream { max-height: 340px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
.vxl-srow {
  display: grid;
  grid-template-columns: 62px 56px 28px 64px 36px 16px;
  gap: 6px;
  align-items: center;
  padding: 7px 8px;
  border-radius: 8px;
  font-family: var(--mono);
  font-size: 11px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}
.vxl-srow:hover { background: rgba(0, 212, 255, 0.04); }
.vxl-st { color: var(--dim); }
.vxl-ss { color: var(--acc); font-weight: 700; }
.vxl-ssc { font-weight: 700; }
.vxl-sreg { font-size: 10px; padding: 1px 6px; border-radius: 4px; }
.vxl-scf { color: var(--dim); }
.vxl-sarr.up { color: var(--green); }
.vxl-sarr.dn { color: var(--red); }

.vxl-foot {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 4px;
}
.vxl-foot-card {
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px 16px;
  background: rgba(8, 14, 24, 0.75);
}
.vxl-foot-h {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  color: var(--acc);
  margin-bottom: 8px;
}
.vxl-foot-card p {
  margin: 0;
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--dim);
}

/* empty */
.vxl-empty-wrap { padding: 32px 0; }
.vxl-empty {
  max-width: 520px;
  margin: 0 auto;
  text-align: center;
  padding: 36px 28px;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: rgba(10, 16, 26, 0.95);
  box-shadow: 0 0 48px rgba(0, 212, 255, 0.08);
}
.vxl-empty-gem {
  font-size: 40px;
  color: var(--acc);
  filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.6));
  margin-bottom: 12px;
}
.vxl-empty h2 { margin: 0 0 12px; font-size: 22px; }
.vxl-empty p { margin: 0 0 22px; font-size: 13px; color: var(--dim); line-height: 1.55; }
.vxl-empty code {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--acc);
  background: rgba(0, 212, 255, 0.08);
  padding: 1px 6px;
  border-radius: 4px;
}
.vxl-steps { text-align: left; display: flex; flex-direction: column; gap: 12px; max-width: 360px; margin: 0 auto; }
.vxl-step { display: flex; gap: 12px; align-items: flex-start; }
.vxl-step-n {
  width: 28px; height: 28px; border-radius: 8px;
  border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-size: 12px; color: var(--acc); flex-shrink: 0;
  background: rgba(0, 212, 255, 0.06);
}
.vxl-step b { display: block; font-size: 13px; margin-bottom: 2px; }
.vxl-step small { color: var(--dim); font-size: 11px; }

@@media (max-width: 1100px) {
  .vxl-hero { grid-template-columns: 1fr; }
  .vxl-kpis { grid-template-columns: repeat(4, 1fr); width: 100%; }
  .vxl-grid2, .vxl-foot { grid-template-columns: 1fr; }
}
@@media (max-width: 640px) {
  .vxl { padding: 12px 12px 32px; }
  .vxl-kpis { grid-template-columns: repeat(2, 1fr); }
  .vxl-mrow { grid-template-columns: 48px 64px 1fr 32px; }
  .vxl-srow { grid-template-columns: 52px 48px 24px 56px 32px 14px; font-size: 10px; }
}
</style>

@code {
    static readonly CultureInfo Culture = CultureInfo.InvariantCulture;

    bool LangRu = true;

    int TotalEvents, UniqueSymbols, AvgScore, MedianScore;
    int DistLo, DistMid, DistHi;
    double StdScore;
    decimal AvgConf;
    string TopSymbol = "—";
    DateTime? LastEventUtc;
    string? SelectedSymbol;

    string ScorePolyline = "";
    string ConfPolyline = "";
    string VolPolyline = "";
    List<string> ChartTimeLabels = new() { "—", "—", "—", "—", "—" };

    List<ExposureVm> Exposure = new();
    List<AiLearningPointModel> RecentPoints = new();

    CancellationTokenSource? _cts;
    bool _disposed;

    void SetLang(bool ru) => LangRu = ru;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadData();
        _ = LoopAsync(_cts.Token);
    }

    async Task LoadData()
    {
        try
        {
            var pts = (await AiFile.LoadAsync()).ToList();
            if (!pts.Any())
            {
                RecentPoints = new();
                TotalEvents = UniqueSymbols = AvgScore = MedianScore = 0;
                AvgConf = 0;
                StdScore = 0;
                ScorePolyline = ConfPolyline = VolPolyline = "";
                await InvokeAsync(StateHasChanged);
                return;
            }

            RecentPoints = pts.OrderBy(p => p.Time).ToList();
            TotalEvents = pts.Count;
            UniqueSymbols = pts.Select(p => p.Symbol).Distinct().Count();
            AvgScore = (int)Math.Round(pts.Average(p => (double)p.Score));
            AvgConf = pts.Average(p => p.Confidence);
            LastEventUtc = pts.Max(p => p.Time);

            var orderedScores = pts.Select(p => (double)p.Score).OrderBy(x => x).ToList();
            MedianScore = (int)Math.Round(orderedScores[orderedScores.Count / 2]);
            var mean = orderedScores.Average();
            StdScore = orderedScores.Count > 1
                ? Math.Sqrt(orderedScores.Sum(x => (x - mean) * (x - mean)) / (orderedScores.Count - 1))
                : 0;

            int lo = pts.Count(p => p.Score < 50);
            int mid = pts.Count(p => p.Score >= 50 && p.Score < 75);
            int hi = pts.Count(p => p.Score >= 75);
            int total = Math.Max(1, lo + mid + hi);
            DistLo = Math.Max(1, lo * 100 / total);
            DistMid = Math.Max(1, mid * 100 / total);
            DistHi = Math.Max(1, hi * 100 / total);
            // normalize visual to ~100
            var dsum = DistLo + DistMid + DistHi;
            if (dsum > 0)
            {
                DistLo = DistLo * 100 / dsum;
                DistMid = DistMid * 100 / dsum;
                DistHi = 100 - DistLo - DistMid;
            }

            Exposure = pts.GroupBy(p => p.Symbol)
                .Select(g =>
                {
                    var last = g.OrderByDescending(x => x.Time).First();
                    return new ExposureVm
                    {
                        Symbol = g.Key,
                        Score = (int)Math.Round(g.Average(p => (double)p.Score)),
                        AvgConf = g.Average(p => p.Confidence),
                        Count = g.Count(),
                        Regime = SimplifyRegime(last.Regime)
                    };
                })
                .OrderByDescending(e => e.Score)
                .ToList();

            TopSymbol = Exposure.FirstOrDefault()?.Symbol ?? "—";

            BuildChartPolylines(RecentPoints);

            await InvokeAsync(StateHasChanged);
        }
        catch { /* keep last frame */ }
    }

    void BuildChartPolylines(List<AiLearningPointModel> pts)
    {
        // Sample last N points for SVG 600x160 (y inverted: 0 top)
        const int n = 48;
        var sample = pts.Count <= n ? pts : pts.Skip(pts.Count - n).ToList();
        if (sample.Count < 2)
        {
            ScorePolyline = ConfPolyline = VolPolyline = "0,80 600,80";
            return;
        }

        double MapY(double v01to100) => 160 - Math.Clamp(v01to100, 0, 100) / 100.0 * 160;

        var sbS = new System.Text.StringBuilder();
        var sbC = new System.Text.StringBuilder();
        var sbV = new System.Text.StringBuilder();
        for (int i = 0; i < sample.Count; i++)
        {
            double x = i * 600.0 / (sample.Count - 1);
            double sc = (double)sample[i].Score;
            double cf = (double)sample[i].Confidence * 100.0;
            double vl = Math.Clamp((double)sample[i].Volatility * 100.0, 0, 100);
            sbS.Append(x.ToString("F1", Culture)).Append(',').Append(MapY(sc).ToString("F1", Culture)).Append(' ');
            sbC.Append(x.ToString("F1", Culture)).Append(',').Append(MapY(cf).ToString("F1", Culture)).Append(' ');
            sbV.Append(x.ToString("F1", Culture)).Append(',').Append(MapY(vl).ToString("F1", Culture)).Append(' ');
        }
        ScorePolyline = sbS.ToString().Trim();
        ConfPolyline = sbC.ToString().Trim();
        VolPolyline = sbV.ToString().Trim();

        var t0 = sample.First().Time.ToLocalTime();
        var t1 = sample.Last().Time.ToLocalTime();
        var span = t1 - t0;
        ChartTimeLabels = new List<string>();
        for (int i = 0; i < 5; i++)
        {
            var t = t0 + TimeSpan.FromTicks(span.Ticks * i / 4);
            ChartTimeLabels.Add(t.ToString("HH:mm"));
        }
    }

    async Task LoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_disposed) break;
                await LoadData();
            }
        }
        catch (OperationCanceledException) { }
    }

    void SelectSymbol(string s) => SelectedSymbol = SelectedSymbol == s ? null : s;

    static string ShortSym(string s) =>
        string.IsNullOrEmpty(s) ? "—" : s.Replace("USDT", "", StringComparison.OrdinalIgnoreCase);

    static string RegClass(string regime) => regime.ToLowerInvariant() switch
    {
        "uptrend" or "stronguptrend" => "bull",
        "downtrend" or "strongdowntrend" => "bear",
        _ => "rng"
    };

    static string ScoreHex(int score) =>
        score >= 75 ? "#22c55e" : score >= 50 ? "#eab308" : "#ef4444";

    static string ScoreTone(int score) =>
        score >= 70 ? "hi" : score >= 50 ? "mid" : "lo";

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }

    sealed class ExposureVm
    {
        public string Symbol { get; set; } = "";
        public string Regime { get; set; } = "";
        public int Score { get; set; }
        public decimal AvgConf { get; set; }
        public int Count { get; set; }
    }
}
