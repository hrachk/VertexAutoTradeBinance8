@page "/ai-learning"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject AiLearningFileService AiFile
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>AI Learning — Vertex</PageTitle>

<div class="al">

    <!-- HEADER -->
    <div class="al-header">
        <div class="al-title-block">
            <span class="al-icon">🧠</span>
            <div>
                <div class="al-title">AI LEARNING ENGINE</div>
                <div class="al-subtitle">Neural pattern recognition · Real-time market adaptation</div>
            </div>
        </div>
        <div class="al-header-stats">
            <div class="al-hstat">
                <div class="al-hstat-val">@TotalEvents</div>
                <div class="al-hstat-lab">DATA POINTS</div>
            </div>
            <div class="al-hstat">
                <div class="al-hstat-val">@UniqueSymbols</div>
                <div class="al-hstat-lab">SYMBOLS</div>
            </div>
            <div class="al-hstat">
                <div class="al-hstat-val @(AvgScore >= 70 ? "hi" : AvgScore >= 50 ? "mid" : "lo")">@AvgScore%</div>
                <div class="al-hstat-lab">AVG SCORE</div>
            </div>
            <div class="al-hstat">
                <div class="al-hstat-val @(AvgConf >= 0.7m ? "hi" : "mid")">@((AvgConf*100m).ToString("F0"))%</div>
                <div class="al-hstat-lab">CONFIDENCE</div>
            </div>
        </div>
    </div>

    <!-- NEURAL PULSE CANVAS -->
    <div class="al-pulse-wrap">
        <div class="al-pulse-label">
            <span class="al-pulse-title">NEURAL ACTIVITY</span>
            <span class="al-pulse-sub">live signal processing · 1s refresh</span>
        </div>
        <canvas id="alCanvas" class="al-canvas"></canvas>
        <div class="al-pulse-footer">
            <div class="al-pf-item">
                <span class="al-pf-dot" style="background:#3b82f6"></span>
                <span>Score</span>
            </div>
            <div class="al-pf-item">
                <span class="al-pf-dot" style="background:#22c55e"></span>
                <span>Confidence</span>
            </div>
            <div class="al-pf-item">
                <span class="al-pf-dot" style="background:#eab308"></span>
                <span>Volatility</span>
            </div>
            <div class="al-pf-item al-pf-val">
                VOL <b>@UiVolatility%</b>
            </div>
            <div class="al-pf-item al-pf-val">
                LAST <b>@(LastEventUtc.HasValue ? LastEventUtc.Value.ToString("HH:mm:ss") : "—")</b>
            </div>
        </div>
    </div>

    <div class="al-body">

        <!-- SYMBOL MATRIX -->
        <div class="al-panel">
            <div class="al-panel-hdr">
                <span>📊 SYMBOL MATRIX</span>
                <span class="al-badge">@Exposure.Count symbols</span>
            </div>
            <div class="al-matrix">
                @foreach (var e in Exposure)
                {
                    var barColor = e.Score >= 75 ? "#22c55e" : e.Score >= 50 ? "#3b82f6" : "#ef4444";
                    var liqClass = e.HasLiqDanger ? "liq-danger" : "";
                    <div class="al-matrix-row @(SelectedSymbol == e.Symbol ? "al-sel" : "")"
                         @onclick="() => SelectSymbol(e.Symbol)">
                        <div class="al-mr-left">
                            <span class="al-sym @liqClass">@e.Symbol</span>
                            <span class="al-reg @RegClass(e.Regime)">@e.Regime</span>
                            @if (e.HasLiqDanger)
                            {
                                <span class="al-liq-warn">⚠ LIQ</span>
                            }
                        </div>
                        <div class="al-mr-bar">
                            <div class="al-mr-fill" style="width:@e.Score%;background:@barColor"></div>
                        </div>
                        <div class="al-mr-right">
                            <span class="al-score" style="color:@barColor">@e.Score%</span>
                            <span class="al-conf">@((e.AvgConf*100m).ToString("F0"))%</span>
                        </div>
                    </div>
                }
                @if (!Exposure.Any())
                {
                    <div class="al-empty">Waiting for AI learning data...</div>
                }
            </div>
        </div>

        <!-- SIGNAL STREAM -->
        <div class="al-panel">
            <div class="al-panel-hdr">
                <span>⚡ SIGNAL STREAM</span>
                <span class="al-badge">@(SelectedSymbol ?? "all symbols")</span>
            </div>

            @if (SelectedSymbol != null)
            {
                var sym = Exposure.FirstOrDefault(e => e.Symbol == SelectedSymbol);
                @if (sym != null)
                {
                    <div class="al-detail">
                        <div class="al-detail-row">
                            <span class="al-dl">Symbol</span>
                            <span class="al-dv blue">@sym.Symbol</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Regime</span>
                            <span class="al-dv @RegClass(sym.Regime)">@sym.Regime</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">AI Score</span>
                            <span class="al-dv @(sym.Score>=75?"hi":sym.Score>=50?"mid":"lo")">@sym.Score%</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Confidence</span>
                            <span class="al-dv">@((sym.AvgConf*100m).ToString("F1"))%</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Volatility</span>
                            <span class="al-dv">@sym.AvgVol.ToString("F2")%</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Events</span>
                            <span class="al-dv">@sym.Count</span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Liq Danger</span>
                            <span class="al-dv @(sym.HasLiqDanger?"lo":"hi")">
                                @(sym.HasLiqDanger ? "⚠ YES" : "✓ NO")
                            </span>
                        </div>
                        <div class="al-detail-row">
                            <span class="al-dl">Last Seen</span>
                            <span class="al-dv">@sym.LastTime.ToString("HH:mm:ss")</span>
                        </div>
                    </div>

                    <!-- Mini signal bars -->
                    <div class="al-minibars">
                        @foreach (var pt in RecentPoints.Where(p => p.Symbol == SelectedSymbol).TakeLast(20))
                        {
                            var h = Math.Max(4, (int)(pt.Score / 100m * 60));
                            var c = pt.Score >= 75 ? "#22c55e" : pt.Score >= 50 ? "#3b82f6" : "#ef4444";
                            <div class="al-minibar" style="height:@(h)px;background:@c"
                                 title="@pt.Time.ToString("HH:mm:ss") score=@pt.Score"></div>
                        }
                    </div>
                }
            }
            else
            {
                <!-- Recent events feed -->
                <div class="al-feed">
                    @foreach (var pt in RecentPoints.TakeLast(15).Reverse())
                    {
                        var scoreColor = pt.Score >= 75 ? "hi" : pt.Score >= 50 ? "mid" : "lo";
                        <div class="al-feed-row">
                            <span class="al-feed-time">@pt.Time.ToString("HH:mm:ss")</span>
                            <span class="al-feed-sym">@pt.Symbol</span>
                            <span class="al-feed-score @scoreColor">@pt.Score.ToString("F0")</span>
                            <div class="al-feed-bar">
                                <div class="al-feed-fill" style="width:@pt.Score%"></div>
                            </div>
                            <span class="al-feed-conf">@((pt.Confidence*100m).ToString("F0"))%</span>
                        </div>
                    }
                    @if (!RecentPoints.Any())
                    {
                        <div class="al-empty">No events yet</div>
                    }
                </div>
            }

            @if (SelectedSymbol != null)
            {
                <button class="al-clear-btn" @onclick="() => SelectedSymbol = null">← All symbols</button>
            }
        </div>

        <!-- STATS PANEL -->
        <div class="al-panel al-stats-panel">
            <div class="al-panel-hdr">
                <span>🔬 LEARNING STATS</span>
            </div>

            <div class="al-stat-grid">
                <div class="al-stat-card">
                    <div class="al-stat-val hi">@TopSymbol</div>
                    <div class="al-stat-lab">TOP SYMBOL</div>
                </div>
                <div class="al-stat-card">
                    <div class="al-stat-val @(AvgScore>=70?"hi":AvgScore>=50?"mid":"lo")">@AvgScore%</div>
                    <div class="al-stat-lab">AVG SCORE</div>
                </div>
                <div class="al-stat-card">
                    <div class="al-stat-val mid">@UiVolatility%</div>
                    <div class="al-stat-lab">AVG VOLATILITY</div>
                </div>
                <div class="al-stat-card">
                    <div class="al-stat-val @(LiqDangerPct>30?"lo":"hi")">@LiqDangerPct%</div>
                    <div class="al-stat-lab">LIQ DANGER</div>
                </div>
                <div class="al-stat-card">
                    <div class="al-stat-val hi">@HighConfCount</div>
                    <div class="al-stat-lab">HIGH CONF EVENTS</div>
                </div>
                <div class="al-stat-card">
                    <div class="al-stat-val mid">@UniqueSymbols</div>
                    <div class="al-stat-lab">SYMBOLS TRACKED</div>
                </div>
            </div>

            <!-- Score distribution -->
            <div class="al-dist-title">SCORE DISTRIBUTION</div>
            <div class="al-dist">
                <div class="al-dist-bar lo" style="height:@DistLo%">
                    <span>@DistLo%</span>
                </div>
                <div class="al-dist-bar mid" style="height:@DistMid%">
                    <span>@DistMid%</span>
                </div>
                <div class="al-dist-bar hi" style="height:@DistHi%">
                    <span>@DistHi%</span>
                </div>
            </div>
            <div class="al-dist-labels">
                <span>LOW &lt;50</span>
                <span>MID 50-75</span>
                <span>HIGH 75+</span>
            </div>
        </div>

    </div>
</div>

<style>
:root {
    --bg:#0a0d12;--bg2:#111520;--bg3:#1a1f2e;--bdr:#1e2535;
    --acc:#3b82f6;--grn:#22c55e;--red:#ef4444;--yel:#eab308;
    --txt:#e2e8f0;--dim:#64748b;
    --mono:'JetBrains Mono','Fira Code',monospace;
}
html,body{background:var(--bg)!important;color:var(--txt);}
.al{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding-bottom:40px;}

/* HEADER */
.al-header{display:flex;align-items:center;justify-content:space-between;padding:24px 28px 20px;background:var(--bg2);border-bottom:1px solid var(--bdr);}
.al-title-block{display:flex;align-items:center;gap:16px;}
.al-icon{font-size:32px;}
.al-title{font-family:var(--mono);font-size:18px;font-weight:700;letter-spacing:2px;color:var(--acc);}
.al-subtitle{font-size:12px;color:var(--dim);margin-top:3px;}
.al-header-stats{display:flex;gap:32px;}
.al-hstat{text-align:center;}
.al-hstat-val{font-family:var(--mono);font-size:24px;font-weight:700;color:var(--txt);}
.al-hstat-lab{font-size:10px;letter-spacing:1.5px;color:var(--dim);margin-top:2px;}

/* PULSE */
.al-pulse-wrap{background:var(--bg2);border-bottom:1px solid var(--bdr);padding:16px 28px 12px;}
.al-pulse-label{display:flex;align-items:baseline;gap:12px;margin-bottom:8px;}
.al-pulse-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--acc);font-weight:700;}
.al-pulse-sub{font-size:11px;color:var(--dim);}
.al-canvas{width:100%;height:120px;display:block;border-radius:6px;background:#070a0f;}
.al-pulse-footer{display:flex;align-items:center;gap:20px;margin-top:8px;font-size:12px;color:var(--dim);}
.al-pf-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px;}
.al-pf-item{display:flex;align-items:center;}
.al-pf-val b{color:var(--txt);margin-left:4px;}

/* BODY */
.al-body{display:grid;grid-template-columns:1fr 1fr 320px;gap:1px;background:var(--bdr);margin-top:1px;}
.al-panel{background:var(--bg2);padding:18px 20px;}
.al-panel-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--bdr);font-size:12px;font-weight:600;letter-spacing:1px;color:var(--dim);}
.al-badge{background:var(--bg3);border-radius:10px;padding:2px 8px;font-size:11px;}
.al-empty{color:var(--dim);text-align:center;padding:20px;font-size:13px;}

/* MATRIX */
.al-matrix{display:flex;flex-direction:column;gap:6px;}
.al-matrix-row{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:6px;cursor:pointer;transition:background .15s;border:1px solid transparent;}
.al-matrix-row:hover{background:var(--bg3);}
.al-sel{background:var(--bg3)!important;border-color:var(--acc)!important;}
.al-mr-left{display:flex;align-items:center;gap:8px;min-width:140px;}
.al-sym{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--acc);}
.al-sym.liq-danger{color:var(--red);}
.al-reg{font-size:10px;padding:1px 6px;border-radius:3px;background:var(--bg3);}
.al-liq-warn{font-size:10px;color:var(--red);font-weight:700;}
.al-mr-bar{flex:1;height:4px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.al-mr-fill{height:100%;border-radius:2px;transition:width .4s;}
.al-mr-right{display:flex;align-items:center;gap:8px;min-width:70px;justify-content:flex-end;}
.al-score{font-family:var(--mono);font-size:13px;font-weight:700;}
.al-conf{font-size:11px;color:var(--dim);}

/* COLORS */
.hi{color:var(--grn)!important;}
.mid{color:var(--acc)!important;}
.lo{color:var(--red)!important;}
.blue{color:var(--acc)!important;}
.bull{color:var(--grn)!important;}
.bear{color:var(--red)!important;}
.rng{color:var(--yel)!important;}

/* DETAIL */
.al-detail{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
.al-detail-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--bdr);}
.al-dl{font-size:11px;color:var(--dim);}
.al-dv{font-family:var(--mono);font-size:13px;}
.al-clear-btn{margin-top:12px;padding:6px 14px;background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;color:var(--dim);font-size:12px;cursor:pointer;transition:all .2s;}
.al-clear-btn:hover{border-color:var(--acc);color:var(--txt);}

/* MINI BARS */
.al-minibars{display:flex;align-items:flex-end;gap:3px;height:64px;background:var(--bg3);border-radius:6px;padding:6px 8px;margin-top:8px;}
.al-minibar{width:8px;border-radius:2px 2px 0 0;transition:height .3s;cursor:pointer;opacity:.85;}
.al-minibar:hover{opacity:1;}

/* FEED */
.al-feed{display:flex;flex-direction:column;gap:4px;}
.al-feed-row{display:flex;align-items:center;gap:8px;padding:5px 4px;border-radius:4px;transition:background .1s;}
.al-feed-row:hover{background:var(--bg3);}
.al-feed-time{font-family:var(--mono);font-size:11px;color:var(--dim);min-width:54px;}
.al-feed-sym{font-family:var(--mono);font-size:11px;color:var(--acc);min-width:72px;font-weight:600;}
.al-feed-score{font-family:var(--mono);font-size:13px;font-weight:700;min-width:36px;}
.al-feed-bar{flex:1;height:3px;background:var(--bdr);border-radius:2px;overflow:hidden;}
.al-feed-fill{height:100%;background:var(--acc);border-radius:2px;}
.al-feed-conf{font-size:11px;color:var(--dim);min-width:36px;text-align:right;}

/* STATS */
.al-stats-panel{background:var(--bg2);}
.al-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;}
.al-stat-card{background:var(--bg3);border:1px solid var(--bdr);border-radius:6px;padding:12px;text-align:center;}
.al-stat-val{font-family:var(--mono);font-size:18px;font-weight:700;}
.al-stat-lab{font-size:10px;color:var(--dim);letter-spacing:1px;margin-top:3px;}
.al-dist-title{font-size:10px;letter-spacing:1.5px;color:var(--dim);margin-bottom:8px;font-weight:600;}
.al-dist{display:flex;gap:8px;align-items:flex-end;height:80px;background:var(--bg3);border-radius:6px;padding:8px;}
.al-dist-bar{flex:1;border-radius:4px 4px 0 0;display:flex;align-items:flex-start;justify-content:center;padding-top:4px;font-size:11px;font-weight:700;transition:height .5s;min-height:8px;}
.al-dist-bar.lo{background:rgba(239,68,68,.3);color:var(--red);}
.al-dist-bar.mid{background:rgba(59,130,246,.3);color:var(--acc);}
.al-dist-bar.hi{background:rgba(34,197,94,.3);color:var(--grn);}
.al-dist-labels{display:flex;gap:8px;margin-top:4px;}
.al-dist-labels span{flex:1;text-align:center;font-size:10px;color:var(--dim);}

@@media(max-width:1100px){.al-body{grid-template-columns:1fr 1fr;}.al-stats-panel{grid-column:span 2;}}
@@media(max-width:700px){.al-body{grid-template-columns:1fr;}.al-header{flex-direction:column;gap:16px;}.al-header-stats{gap:16px;}}
</style>

@code {
    int TotalEvents, UniqueSymbols, AvgScore, UiVolatility, LiqDangerPct, HighConfCount;
    int DistLo, DistMid, DistHi;
    decimal AvgConf;
    string TopSymbol = "—";
    DateTime? LastEventUtc;
    string? SelectedSymbol;

    List<ExposureVm> Exposure = new();
    List<AiLearningPointModel> RecentPoints = new();

    CancellationTokenSource? _cts;
    bool _disposed;
    bool _canvasReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("alPulse.init", "alCanvas"); _canvasReady = true; }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadData();
        _ = LoopAsync(_cts.Token);
    }

    async Task LoadData()
    {
        try
        {
            var pts = await AiFile.LoadAsync() ?? new();
            if (!pts.Any()) return;

            RecentPoints = pts.OrderBy(p => p.Time).ToList();
            TotalEvents = pts.Count;
            UniqueSymbols = pts.Select(p => p.Symbol).Distinct().Count();
            AvgScore = (int)Math.Round(pts.Average(p => p.Score));
            AvgConf = pts.Average(p => p.Confidence);
            UiVolatility = (int)Math.Min(100, pts.Average(p => p.Volatility) * 100);
            LastEventUtc = pts.Max(p => p.Time);
            LiqDangerPct = pts.Any() ? (int)(pts.Count(p => p.LiquidityDanger) * 100.0 / pts.Count) : 0;
            HighConfCount = pts.Count(p => p.Confidence >= 0.7m);

            // Distribution
            int lo = pts.Count(p => p.Score < 50);
            int mid = pts.Count(p => p.Score >= 50 && p.Score < 75);
            int hi = pts.Count(p => p.Score >= 75);
            int total = Math.Max(1, lo + mid + hi);
            DistLo  = Math.Max(5, lo  * 100 / total);
            DistMid = Math.Max(5, mid * 100 / total);
            DistHi  = Math.Max(5, hi  * 100 / total);

            Exposure = pts.GroupBy(p => p.Symbol)
                .Select(g => new ExposureVm
                {
                    Symbol      = g.Key,
                    Score       = (int)Math.Round(g.Average(p => p.Score)),
                    AvgConf     = g.Average(p => p.Confidence),
                    AvgVol      = g.Average(p => p.Volatility) * 100m,
                    Count       = g.Count(),
                    LastTime    = g.Max(p => p.Time),
                    HasLiqDanger = g.Any(p => p.LiquidityDanger),
                    Regime = g.Average(p => p.Confidence) > 0.70m ? "UpTrend"
                           : g.Average(p => p.Confidence) > 0.50m ? "Range"
                           : "DownTrend"
                })
                .OrderByDescending(e => e.Score)
                .ToList();

            TopSymbol = Exposure.FirstOrDefault()?.Symbol ?? "—";

            // Push to canvas
            if (_canvasReady)
            {
                try
                {
                    await JS.InvokeVoidAsync("alPulse.push",
                        AvgScore, (int)(AvgConf * 100), UiVolatility);
                }
                catch { }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    async Task LoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_disposed) break;
                await LoadData();
            }
        }
        catch (OperationCanceledException) { }
    }

    void SelectSymbol(string s) => SelectedSymbol = (SelectedSymbol == s) ? null : s;

    string RegClass(string regime) => regime.ToLower() switch
    {
        "uptrend" or "stronguptrend" => "bull",
        "downtrend" or "strongdowntrend" => "bear",
        _ => "rng"
    };

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }

    public class ExposureVm
    {
        public string Symbol { get; set; } = "";
        public string Regime { get; set; } = "";
        public int Score { get; set; }
        public decimal AvgConf { get; set; }
        public decimal AvgVol { get; set; }
        public int Count { get; set; }
        public DateTime LastTime { get; set; }
        public bool HasLiqDanger { get; set; }
    }
}
