@page "/ai-marketheatmap"
@using VertexAutoTradeBinance8.Services
@using VertexAutoTradeBinance8.Models   <!-- Важно для AiLearningSnapshot -->
@inject AiSelfLearningService AiLearning

<h3>Market Heatmap (1m Regime)</h3>

<style>
    .heatmap-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 8px;
    }

    .heatmap-cell {
        padding: 10px;
        border-radius: 8px;
        color: white;
        text-align: center;
    }

    .StrongUpTrend {
        background: #0a8f3d;
    }

    .StrongDownTrend {
        background: #c01818;
    }

    .Range {
        background: #777;
    }

    .UpTrend {
        background: #3498db;
    }

    .DownTrend {
        background: #e67e22;
    }
</style>

@if (States == null)
{
    <p>Loading heatmap...</p>
}
else if (States.Symbols == null || States.Symbols.Count == 0)
{
    <p>Нет данных для визуализации.</p>
}
else
{
    <div class="heatmap-grid">
        @foreach (var s in States.Symbols)
        {
            var reg = s.Regimes?.LastOrDefault();

            string css = reg?.Regime.ToString() ?? "Range";

            <div class="heatmap-cell @css">
                <b>@s.Symbol</b><br />
                <small>@reg?.Regime</small>
            </div>
        }
    </div>
}

@code {
    private AiLearningSnapshot? States;

    protected override Task OnInitializedAsync()
    {
        // Синхронный вызов — без await
        States = AiLearning.ExportState();
        return Task.CompletedTask;
    }
}
