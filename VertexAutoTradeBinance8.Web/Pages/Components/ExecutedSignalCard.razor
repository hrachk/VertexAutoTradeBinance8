@using VertexAutoTradeBinance8.Models
@using VertexAutoTradeBinance8.Web.Services
@inherits ComponentBase
@inject LivePnlService LivePnl
@inject ExecutedSignalUiService  signalUiService

<div class="bn-card">

    <!-- TOP -->
    <div class="bn-top">
        <div class="bn-left">
            <div class="bn-symbol">
                <span class="bn-badge @(Record.Side == SignalSide.Buy ? "bn-long" : "bn-short")">
                    @(Record.Side == SignalSide.Buy ? "L" : "S")
                </span>
                <span class="bn-ticker">@Record.Symbol</span>
                <span class="bn-mini">PERP</span>
                <span class="bn-mini">@Fmt0(LivePos?.Leverage)</span>
            </div>

            <div class="bn-sub">
                @Record.Time.ToLocalTime():dd.MM.yyyy HH:mm:ss
                <span class="bn-dot">•</span>
                <span class="bn-status @StatusCss()">@StatusText()</span>
            </div>
        </div>

        <div class="bn-right">
            <div class="bn-roi @(LiveRoi >= 0 ? "bn-plus" : "bn-minus")">
                @FmtSignedPct(LiveRoi)
            </div>
        </div>
    </div>

    <!-- MAIN -->
    <div class="bn-main">
        <div class="bn-pnl">
            <div class="bn-pnl-label">PnL (USDT)</div>
            <div class="bn-pnl-val @(LiveUnrealizedPnl >= 0 ? "bn-plus" : "bn-minus")">
                @FmtSigned(LiveUnrealizedPnl)
            </div>
        </div>

        <div class="bn-grid">
            <div class="bn-item">
                <div class="k">Size (USDT)</div>
                <div class="v">@Fmt2(LiveNotional)</div>
            </div>

            <div class="bn-item">
                <div class="k">Margin</div>
                <div class="v">@Fmt2(LivePos?.IsolatedMargin)</div>
            </div>

            <div class="bn-item">
                <div class="k">Entry</div>
                <div class="v">@Fmt(Record.Entry)</div>
            </div>

            <div class="bn-item">
                <div class="k">Mark</div>
                <div class="v">@Fmt(LivePos?.MarkPrice)</div>
            </div>

            <div class="bn-item">
                <div class="k">Liq. Price</div>
                <div class="v">@Fmt(LivePos?.LiquidationPrice)</div>
            </div>
        </div>
    </div>

    <!-- FOOT -->
    <div class="bn-foot">
        <span class="muted">Reason:</span> @Record.Reason
    </div>
</div>

@code {
    [Parameter] public ExecutedSignalRecord Record { get; set; } = default!;

    string PosSide => Record.Side == SignalSide.Buy ? "LONG" : "SHORT";

    LivePnlService.LivePos? LivePos =>
        Record.IsOpen ? LivePnl.Get(Record.Symbol, PosSide) : null;

    decimal LiveUnrealizedPnl =>
       LivePos != null
           ? LivePos.UnrealizedPnl
           : (Record.Side == SignalSide.Buy
               ? (MarkPrice - Record.Entry) * Record.Qty
               : (Record.Entry - MarkPrice) * Record.Qty);

    decimal LiveNotional =>
        LivePos != null
            ? Math.Abs(LivePos.PositionAmt) * LivePos.MarkPrice
        : Record.Notional;
 

            decimal MarkPrice =>
    LivePos?.MarkPrice
?? signalUiService.GetPrice(Record.Symbol);



decimal LiveRoi =>
    LivePos?.IsolatedMargin > 0
        ? (LiveUnrealizedPnl / LivePos.IsolatedMargin.Value) * 100m
        : (Record.Notional > 0
            ? (LiveUnrealizedPnl / Record.Notional) * 100m
            : 0m);



    static string Fmt(decimal? v)
        => v.HasValue && v.Value != 0 ? v.Value.ToString("0.########") : "—";

    static string Fmt2(decimal? v)
        => v.HasValue && v.Value != 0 ? v.Value.ToString("0.00") : "—";

    static string Fmt0(int? v) => v.HasValue && v > 0 ? v.ToString() : "--";

    static string FmtSigned(decimal v)
        => v > 0 ? $"+{v:0.00}" : v.ToString("0.00");

    static string FmtSignedPct(decimal v)
        => v > 0 ? $"+{v:0.00}%" : $"{v:0.00}%";

    string StatusText() => Record.Status.ToString();
    string StatusCss() => Record.Status switch
    {
        TradeExecutionStatus.PositionOpened => "st-open",
        TradeExecutionStatus.PositionClosedTp => "st-tp",
        TradeExecutionStatus.PositionClosedSl => "st-sl",
        TradeExecutionStatus.PositionClosedManual => "st-closed",
        TradeExecutionStatus.PositionError => "st-error",
        _ => "st-signal"
    };
}
