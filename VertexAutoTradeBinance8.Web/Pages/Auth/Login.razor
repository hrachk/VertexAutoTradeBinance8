@page "/login"
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject AuthSessionService Auth
@inject NavigationManager Nav
@layout VertexAutoTradeBinance8.Web.Shared.AuthLayout

<PageTitle>Vertex AI — Вход</PageTitle>

<style>
  .login-wrap{min-height:100vh;display:flex;align-items:center;
    justify-content:center;background:#050a12;}
</style>

@* Show LoginModal immediately as standalone page *@
<LoginModal Visible="true"
            VisibleChanged="OnVisibleChanged"
            ReturnUrl="@ReturnUrl" />

@code {
  [SupplyParameterFromQuery] string? ReturnUrl { get; set; }

  protected override void OnInitialized()
  {
    if (Auth.IsAuthenticated)
      Nav.NavigateTo(ReturnUrl ?? "/dashboard", replace: true);
  }

  void OnVisibleChanged(bool visible)
  {
    // If user closes modal on login page — go back
    if (!visible && !Auth.IsAuthenticated)
      Nav.NavigateTo("/", replace: true);
  }
}
