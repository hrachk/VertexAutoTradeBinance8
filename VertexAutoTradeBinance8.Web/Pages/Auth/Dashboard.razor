@page "/dashboard"
@using VertexAutoTradeBinance8.Web.Services.Auth
@using VertexAutoTradeBinance8.Web.Services
@inject AuthSessionService Auth
@inject NavigationManager Nav
@inject ClientDbService Db
@inject MarketDataLiveState LiveState

<PageTitle>Vertex AI — Дашборд</PageTitle>

<style>
.dash{display:flex;flex-direction:column;gap:20px;padding:24px;max-width:1100px;margin:0 auto;}
.dash-welcome{font-size:22px;font-weight:800;color:#f0f6ff;}
.dash-welcome span{color:#38bdf8;}
.dash-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;}
.dash-card{background:#0a1220;border:1px solid #1a2e44;border-radius:10px;padding:20px;}
.dash-card-title{font-size:11px;font-weight:700;letter-spacing:1.5px;color:#334e68;text-transform:uppercase;margin-bottom:10px;}
.dash-card-val{font-size:28px;font-weight:900;color:#f0f6ff;font-family:monospace;}
.dash-card-sub{font-size:11px;color:#6e90b2;margin-top:4px;}
.plan-badge{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 10px;
  border-radius:4px;font-size:11px;font-weight:800;}
.plan-demo{background:rgba(249,115,22,.1);border:1px solid rgba(249,115,22,.3);color:#fb923c;}
.plan-live{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#34d399;}
.dash-actions{display:flex;gap:10px;flex-wrap:wrap;}
.dash-btn{height:40px;padding:0 20px;border-radius:7px;border:none;font-size:13px;
  font-weight:700;cursor:pointer;transition:all .15s;text-decoration:none;
  display:inline-flex;align-items:center;gap:6px;}
.dash-btn-primary{background:#3b82f6;color:#fff;}
.dash-btn-primary:hover{background:#2563eb;}
.dash-btn-demo{background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.3);color:#fb923c;}
.dash-btn-demo:hover{background:rgba(249,115,22,.25);}
.dash-btn-outline{background:transparent;border:1px solid #1a2e44;color:#6e90b2;}
.dash-btn-outline:hover{border-color:#3b82f6;color:#f0f6ff;}
.dash-section-title{font-size:13px;font-weight:700;color:#6e90b2;margin-bottom:8px;}
.api-status{display:flex;align-items:center;gap:8px;font-size:13px;color:#6e90b2;}
.dot-ok{width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;}
.dot-no{width:8px;height:8px;border-radius:50%;background:#475569;}
</style>

@if (!Auth.IsAuthenticated)
{
  <div style="padding:40px;text-align:center">
    <a href="/login" style="color:#3b82f6">Войдите в систему</a>
  </div>
}
else
{
  var c = Auth.CurrentClient!;
  <div class="dash">

    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
      <div>
        <div class="dash-welcome">Добро пожаловать, <span>@c.DisplayName</span></div>
        <div style="font-size:12px;color:#334e68;margin-top:2px;">@c.Email · ID: @c.Id</div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="plan-badge @(c.Plan=="demo"?"plan-demo":"plan-live")">
          @(c.Plan.ToUpperInvariant()) PLAN
        </span>
        <button class="dash-btn dash-btn-outline" @onclick="Logout">Выйти</button>
      </div>
    </div>

    <!-- Stats cards -->
    <div class="dash-grid">
      <div class="dash-card">
        <div class="dash-card-title">Demo-баланс</div>
        <div class="dash-card-val" style="color:#fb923c">$@c.DemoBalance.ToString("N2")</div>
        <div class="dash-card-sub">Виртуальные USDT для Demo-торговли</div>
      </div>
      <div class="dash-card">
        <div class="dash-card-title">Тарифный план</div>
        <div class="dash-card-val" style="font-size:20px;margin-top:4px;">@c.Plan.ToUpperInvariant()</div>
        <div class="dash-card-sub">
          @if (c.Plan == "demo") { <span>Demo — живые цены, виртуальный баланс</span> }
          else { <span>Live — реальные ордера на Binance</span> }
        </div>
      </div>
      <div class="dash-card">
        <div class="dash-card-title">Binance API</div>
        <div class="api-status" style="margin-top:8px;">
          @if (c.IsLiveEnabled)
          {
            <div class="dot-ok"></div>
            <span style="color:#34d399;font-weight:700;">Подключено</span>
          }
          else
          {
            <div class="dot-no"></div>
            <span>Не настроено</span>
          }
        </div>
        <div class="dash-card-sub" style="margin-top:6px;">
          @(c.IsLiveEnabled ? "Live-торговля доступна" : "Подключите ключи для Live")
        </div>
      </div>
      <div class="dash-card">
        <div class="dash-card-title">Аккаунт создан</div>
        <div class="dash-card-val" style="font-size:18px;margin-top:6px;">
          @c.CreatedAt.ToString("dd MMM yyyy")
        </div>
        <div class="dash-card-sub">
          Последний вход: @(c.LastLoginAt?.ToString("dd.MM HH:mm") ?? "—")
        </div>
      </div>
    </div>

    <!-- Quick actions -->
    <div>
      <div class="dash-section-title">Быстрые действия</div>
      <div class="dash-actions">
        <a href="/market" class="dash-btn dash-btn-primary">📊 Перейти на Market</a>
        <a href="/market/multi" class="dash-btn dash-btn-primary">⊞ Multi-Chart</a>
        <a href="/dashboard/settings" class="dash-btn dash-btn-demo">🔑 Binance API ключи</a>
        <a href="/statistics" class="dash-btn dash-btn-outline">📈 Статистика</a>
        @if (c.Plan == "demo")
        {
          <button class="dash-btn" style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#34d399;"
                  @onclick="ResetDemoBalance">🔄 Сбросить Demo-баланс</button>
        }
      </div>
    </div>

    <!-- Demo mode info -->
    @if (c.Plan == "demo")
    {
      <div style="background:#0c1a2e;border:1px solid #1e3a5f;border-left:3px solid #f97316;
                  border-radius:8px;padding:14px 18px;">
        <div style="font-size:13px;font-weight:700;color:#fb923c;margin-bottom:6px;">
          🎮 Вы в Demo-режиме
        </div>
        <div style="font-size:12px;color:#6e90b2;line-height:1.6;">
          Торгуйте на живых ценах Binance с виртуальным балансом $@c.DemoBalance.ToString("N0").
          AI-сигналы, SL/TP и все функции работают полностью — без риска потерять реальные деньги.
          Для перехода в Live-режим подключите Binance API ключи.
        </div>
      </div>
    }

  </div>
}

@code {
  protected override void OnInitialized()
  {
    if (!Auth.IsAuthenticated) Nav.NavigateTo("/login");
    Auth.OnChange += StateHasChanged;
  }

  public void Dispose() => Auth.OnChange -= StateHasChanged;

  void Logout()
  {
    Auth.Logout();
    Nav.NavigateTo("/login");
  }

  async Task ResetDemoBalance()
  {
    if (Auth.CurrentClient == null) return;
    await Db.UpdateDemoBalanceAsync(Auth.CurrentClient.Id, 10_000m);
    await Auth.RefreshAsync();
  }
}
