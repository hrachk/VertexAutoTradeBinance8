@page "/register"
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject AuthSessionService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject OAuthService OAuth
@layout VertexAutoTradeBinance8.Web.Shared.AuthLayout

<PageTitle>Vertex AI — Регистрация</PageTitle>

<div class="auth-card">
<div class="auth-oauth" style="margin:16px 0;display:flex;flex-direction:column;gap:8px;">
  <button type="button" class="auth-btn" style="background:#fff;color:#111;" @onclick="StartGoogle" disabled="@_busy">
    🔵 Продолжить с Google
  </button>
  <button type="button" class="auth-btn" style="background:#229ED9;color:#fff;" @onclick="StartTelegram" disabled="@_busy">
    ✈️ Telegram
  </button>
  <div style="text-align:center;font-size:12px;color:#6e90b2;margin:4px 0;">или email</div>
</div>

  <div class="auth-logo">VERTEX <span>AI</span></div>
  <div class="auth-title">Создать аккаунт</div>
  <div class="auth-sub">Начни торговать с Demo-режима бесплатно</div>

  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="auth-error">⚠ @_error</div>
  }
  @if (!string.IsNullOrEmpty(_success))
  {
    <div class="auth-success">✓ @_success</div>
  }

  <div class="auth-field">
    <label>Имя / Никнейм</label>
    <input type="text"
           value="@_displayName"
           @oninput="e => _displayName = e.Value?.ToString() ?? string.Empty"
           placeholder="Trader123" maxlength="40"
           disabled="@_busy" />
  </div>
  <div class="auth-field">
    <label>Email</label>
    <input type="email"
           value="@_email"
           @oninput="e => _email = e.Value?.ToString() ?? string.Empty"
           placeholder="you@example.com"
           disabled="@_busy" />
  </div>
  <div class="auth-field">
    <label>Пароль</label>
    <input type="password"
           value="@_password"
           @oninput="e => _password = e.Value?.ToString() ?? string.Empty"
           placeholder="Минимум 6 символов"
           disabled="@_busy" />
  </div>
  <div class="auth-field">
    <label>Повторите пароль</label>
    <input type="password"
           value="@_password2"
           @oninput="e => _password2 = e.Value?.ToString() ?? string.Empty"
           placeholder="Повторите пароль"
           @onkeydown="OnKeyDown"
           disabled="@_busy" />
  </div>

  <button class="auth-btn" disabled="@_busy" @onclick="DoRegister">
    @if (_busy)
    {
      <span>Регистрация…</span>
    }
    else
    {
      <span>Создать аккаунт</span>
    }
  </button>

  <div class="auth-demo-note">
    🎮 После регистрации — сразу <b>$10 000 Demo</b> на живых ценах Binance
  </div>

  <div class="auth-link">
    Уже есть аккаунт? <a href="/login">Войти</a>
  </div>
</div>

<style>
.auth-success{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);
  border-radius:6px;padding:10px 14px;font-size:12px;color:#34d399;
  margin-bottom:14px;text-align:center;}
</style>

@code {
  [SupplyParameterFromQuery] string? ReturnUrl { get; set; }

  string _email = "", _password = "", _password2 = "", _displayName = "";
  string _error = "", _success = "";
  bool _busy;

  protected override void OnInitialized()
  {
    if (Auth.IsAuthenticated)
      Nav.NavigateTo(ReturnUrl ?? "/dashboard", replace: true);
  }

  async Task DoRegister()
  {
    _error   = "";
    _success = "";

    // Validate on client before calling server
    var email = _email.Trim();
    var pwd   = _password;
    var pwd2  = _password2;
    var name  = _displayName.Trim();

    if (string.IsNullOrEmpty(email))   { _error = "Введите email."; return; }
    if (!email.Contains('@'))          { _error = "Неверный формат email."; return; }
    if (pwd.Length < 6)                { _error = "Пароль минимум 6 символов."; return; }
    if (pwd != pwd2)                   { _error = "Пароли не совпадают."; return; }

    _busy = true;
    StateHasChanged(); // show spinner immediately

    try
    {
      var (ok, error, emailSent, displayCode) = await Auth.RegisterAsync(email, pwd, name);
      if (ok)
      {
        if (emailSent)
          _success = "Аккаунт создан! Проверь email — отправили код подтверждения.";
        else
          _success = "Аккаунт создан. Письмо не ушло (SMTP не настроен) — код покажем на следующем шаге.";
        StateHasChanged();
        await Task.Delay(900);
        var q = new List<string>();
        if (ReturnUrl != null) q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        if (!string.IsNullOrEmpty(displayCode)) q.Add($"hint={Uri.EscapeDataString(displayCode)}");
        var dest = "/verify-email" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
        Nav.NavigateTo(dest, replace: true);
      }
      else
      {
        _error = error;
      }
    }
    catch (Exception ex)
    {
      _error = $"Ошибка: {ex.Message}";
    }
    finally
    {
      _busy = false;
    }
  }

  async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter") await DoRegister();
  }
}
