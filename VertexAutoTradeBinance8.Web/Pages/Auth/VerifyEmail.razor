@page "/verify-email"
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject AuthSessionService Auth
@inject NavigationManager Nav
@layout VertexAutoTradeBinance8.Web.Shared.AuthLayout

<PageTitle>Vertex AI — Подтверждение email</PageTitle>

<div class="auth-card">
  <div class="auth-logo">VERTEX <span>AI</span></div>
  <div class="auth-title">Подтверди email</div>
  <div class="auth-sub">
    Мы отправили 6-значный код на<br>
    <strong style="color:#f0f6ff">@(Auth.CurrentClient?.Email ?? "твой email")</strong>
  </div>

  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="auth-error">⚠ @_error</div>
  }
  @if (!string.IsNullOrEmpty(_success))
  {
    <div class="auth-success">✓ @_success</div>
  }

  @if (!string.IsNullOrEmpty(_shownCode))
  {
    <div style="margin:12px 0;padding:12px 14px;border-radius:8px;background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.25);color:#7dd3fc;font-size:13px;">
      <div style="font-weight:700;margin-bottom:4px;">Ваш код подтверждения</div>
      <div style="font-size:26px;font-weight:900;letter-spacing:8px;font-family:monospace;color:#38bdf8;">@_shownCode</div>
      <div style="margin-top:6px;opacity:.85;font-size:11px;line-height:1.4;">
        Письмо не доставлено (SMTP не настроен или ошибка отправки).
        Введите код выше. Для реальной почты укажите Email:Provider в appsettings.web.json
        (gmail / mailru / yandex + app-password).
      </div>
    </div>
  }

  <div class="code-inputs">
    @for (int i = 0; i < 6; i++)
    {
      var idx = i;
      <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
             class="code-digit"
             id="digit-@idx"
             value="@_digits[idx]"
             @oninput="e => OnDigitInput(idx, e)"
             @onkeydown="e => OnDigitKey(idx, e)"
             @onfocus="e => OnDigitFocus(idx)"
             disabled="@_busy" />
    }
  </div>

  <button class="auth-btn" disabled="@(_busy || CodeLength < 6)" @onclick="DoVerify">
    @if (_busy) { <span>Проверка…</span> }
    else        { <span>Подтвердить</span> }
  </button>

  <div style="text-align:center;margin-top:8px">
    @if (_resendCooldown > 0)
    {
      <span style="font-size:12px;color:#6e90b2">Повторная отправка через @_resendCooldown сек.</span>
    }
    else
    {
      <button class="auth-resend" @onclick="DoResend" disabled="@_resendBusy">
        @(_resendBusy ? "Отправляем…" : "Отправить код повторно")
      </button>
    }
  </div>

  <div class="auth-link" style="margin-top:16px;display:flex;flex-direction:column;gap:8px;align-items:center;">
    <a href="/login">Войти через Google / Telegram</a>
    <a href="/register">← Зарегистрироваться заново</a>
  </div>
</div>

<style>
.code-inputs { display:flex; gap:8px; justify-content:center; margin:20px 0 16px; }
.code-digit {
  width:44px; height:54px; text-align:center;
  font-size:24px; font-weight:900; font-family:monospace;
  background:#050a12; border:2px solid #1a2e44;
  border-radius:8px; color:#38bdf8; outline:none;
}
.code-digit:focus { border-color:#3b82f6; background:#070f1c; }
.code-digit:disabled { opacity:.5; }
.auth-resend {
  background:transparent; border:none; color:#3b82f6;
  font-size:12px; cursor:pointer; text-decoration:underline; font-family:inherit;
}
.auth-resend:disabled { color:#334e68; cursor:not-allowed; text-decoration:none; }
</style>

@code {
  [SupplyParameterFromQuery] string? ReturnUrl { get; set; }
  [SupplyParameterFromQuery(Name = "hint")] string? HintCode { get; set; }

  string[] _digits = new string[6];
  string _error = "", _success = "";
  string? _shownCode;
  bool _busy, _resendBusy;
  int _resendCooldown;
  System.Threading.Timer? _cooldownTimer;

  int CodeLength => _digits.Count(d => !string.IsNullOrEmpty(d));

  protected override void OnInitialized()
  {
    if (Auth.CurrentClient == null)
    {
      Nav.NavigateTo("/register", replace: true);
      return;
    }
    if (Auth.CurrentClient.IsEmailVerified)
    {
      Nav.NavigateTo(ReturnUrl ?? "/dashboard", replace: true);
      return;
    }
    _shownCode = !string.IsNullOrEmpty(HintCode) ? HintCode : Auth.PeekVerificationCode();
  }

  async Task DoVerify()
  {
    _error = "";
    var code = string.Concat(_digits);
    if (code.Length != 6) { _error = "Введите 6 цифр."; return; }
    _busy = true;
    try
    {
      var (ok, err) = await Auth.ConfirmEmailAsync(code);
      if (ok)
      {
        _success = "Email подтверждён!";
        StateHasChanged();
        await Task.Delay(700);
        Nav.NavigateTo(ReturnUrl ?? "/dashboard", replace: true);
      }
      else _error = err;
    }
    catch (Exception ex) { _error = ex.Message; }
    finally { _busy = false; }
  }

  async Task DoResend()
  {
    _resendBusy = true; _error = "";
    try
    {
      var (ok, newCode) = await Auth.ResendVerificationCodeAsync();
      if (ok)
      {
        _success = string.IsNullOrEmpty(newCode)
          ? "Код отправлен повторно на email."
          : "Новый код сгенерирован (показан ниже).";
        if (!string.IsNullOrEmpty(newCode)) _shownCode = newCode;
        _resendCooldown = 60;
        _cooldownTimer?.Dispose();
        _cooldownTimer = new System.Threading.Timer(_ =>
        {
          if (_resendCooldown > 0) { _resendCooldown--; InvokeAsync(StateHasChanged); }
        }, null, 1000, 1000);
      }
      else _error = "Не удалось отправить код. Попробуйте снова.";
    }
    catch (Exception ex) { _error = ex.Message; }
    finally { _resendBusy = false; }
  }

  void OnDigitInput(int idx, ChangeEventArgs e)
  {
    var v = e.Value?.ToString() ?? "";
    _digits[idx] = v.Length > 0 ? v[^1].ToString() : "";
    if (_digits[idx].Length == 1 && idx < 5)
      _ = InvokeAsync(async () => { try { await JS.InvokeVoidAsync("eval", $"document.getElementById('digit-{idx+1}')?.focus()"); } catch { } });
  }
  void OnDigitKey(int idx, KeyboardEventArgs e)
  {
    if (e.Key == "Backspace" && string.IsNullOrEmpty(_digits[idx]) && idx > 0)
      _digits[idx - 1] = "";
  }
  void OnDigitFocus(int idx) { }

  [Inject] IJSRuntime JS { get; set; } = default!;

  public void Dispose() => _cooldownTimer?.Dispose();
}
