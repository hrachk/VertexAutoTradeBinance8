@page "/ai-dashboard"

@using VertexAutoTradeBinance8.Models
@using VertexAutoTradeBinance8.Services
@using VertexAutoTradeBinance8.Web.Services
@inject AiLearningFileService FileLoader

@implements IDisposable

<div class="px-6 py-4">

    <h2 class="text-3xl font-bold mb-6">AI Dashboard</h2>

    @if (Stats == null)
    {
        <div class="text-red-400 text-lg">⚠ JSON не загружен</div>
    }
    else
    {
        <!-- SUMMARY GRID -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">

            @SummaryCard("Символов", Stats.Meta.Symbols.ToString())
            @SummaryCard("MarketStates", Stats.Meta.MarketStates.ToString())
            @SummaryCard("Trades", Stats.Meta.Trades.ToString())

            @SnapshotAgeCard()

        </div>

    
        <!-- WINRATE SECTION -->
        <div class="p-5 bg-slate-900/50 rounded-xl border border-slate-700 mb-8">

            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-xl">WinRate по Market Regime</h3>
                <span class="text-xs text-slate-400">Symbols: @Stats.Symbols.Count</span>
            </div>

            @if (Stats.Symbols.Count == 0)
            {
                <div class="text-slate-400">Нет данных по сделкам.</div>
            }
            else
            {
                <div class="wr-grid">
                    @foreach (var s in Stats.Symbols)
                    {
                        <div class="wr-card">

                            <div class="font-bold text-lg mb-2">@s.Symbol</div>

                            <div class="space-y-2 text-sm">
                                @foreach (var r in s.Regimes.OrderByDescending(x => x.Trades))
                                {
                                    var wr = r.Trades > 0 ? (double)r.Wins / r.Trades * 100.0 : 0;

                                    <div class="flex justify-between items-center">
                                        <div class="flex flex-col leading-tight">
                                            <span class="font-semibold">@r.Regime</span>
                                            <span class="text-slate-400 text-xs">@r.Trades trades</span>
                                        </div>

                                        <div class="text-right font-bold @(wr >= 55 ? "text-emerald-400" : wr >= 45 ? "text-amber-400" : "text-red-400")">
                                            @wr.ToString("F1")%
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    }
                </div>
            }
        </div>


        <!-- MARKET STATES -->
        <div class="p-5 bg-slate-900/50 rounded-xl border border-slate-700 mb-8">

            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-xl">Live Market States</h3>
                <span class="text-xs text-slate-400">последние @MarketStates.Count</span>
            </div>

            <button @onclick="ToggleMarket"
                    class="px-3 py-1 mb-3 text-xs rounded bg-slate-800 hover:bg-slate-700 border border-slate-600">
                @(ShowMarket ? "Свернуть" : "Развернуть")
            </button>

            @if (ShowMarket)
            {
                <div class="market-grid">

                    @foreach (var st in MarketStates)
                    {
                        <div class="market-card">

                            <div class="flex justify-between mb-2">
                                <div>
                                    <b>@st.Symbol</b>
                                    <span class="text-slate-400 text-xs">(@st.Timeframe)</span>
                                </div>

                                <span class="reason-badge">@st.Reason</span>
                            </div>

                            <div class="text-xs space-y-1">
                                <div>Slope: <b>@st.TrendSlopePercent.ToString("F3")</b></div>
                                <div>Vol: <b>@st.VolatilityPercent.ToString("F3")</b></div>
                                <div>ATR: <b>@st.Atr.ToString("F2")</b></div>
                                <div>Conf: <b>@st.Confidence.ToString("P0")</b></div>
                            </div>

                            <div class="timestamp">
                                @st.Time.ToLocalTime()
                            </div>

                        </div>
                    }

                </div>
            }
        </div>

 
        <!-- TRADES -->
        <div class="p-5 bg-slate-900/50 rounded-xl border border-slate-700 mb-8">

            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-xl">Последние сделки</h3>
                <span class="text-xs text-slate-400">всего @Trades.Count</span>

                <button @onclick="ToggleTrades"
                        class="px-3 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 ml-3">
                    @(ShowTrades ? "Свернуть" : "Развернуть")
                </button>
            </div>

            @if (ShowTrades)
            {
                @if (Trades.Count == 0)
                {
                    <div class="text-slate-400">Сделок нет.</div>
                }
                else
                {
                    <div class="trade-grid">
                        @foreach (var t in Trades)
                        {
                            var isWin = t.Pnl >= 0;

                            <div class="trade-card">

                                <div class="flex justify-between mb-1 items-center">
                                    <span class="trade-symbol">@t.Symbol</span>
                                    <span class="side-badge @(t.Side == SignalSide.Buy ? "buy-badge" : "sell-badge")">
                                        @t.Side
                                    </span>
                                </div>

                                <div class="text-xs space-y-1">
                                    <div>Entry: <b>@t.Entry.ToString("F4")</b></div>
                                    <div>Exit: <b>@t.Exit.ToString("F4")</b></div>
                                    <div>
                                        PnL:
                                        <b class="@(isWin ? "text-emerald-400" : "text-red-400")">
                                            @t.Pnl.ToString("F4")
                                        </b>
                                    </div>
                                    <div>Regime: <b>@t.Regime</b></div>
                                </div>

                                <div class="trade-timestamp">@t.Time.ToLocalTime()</div>

                            </div>
                        }
                    </div>
                }
            }
        </div>

    }
</div>

@code {

    bool ShowMarket = true;

    void ToggleMarket()
    {
        ShowMarket = !ShowMarket;
    }

    bool ShowTrades = true;

    void ToggleTrades()
    {
        ShowTrades = !ShowTrades;
    }

    private AiLearningSnapshot? Stats;
    private List<AiSelfLearningService.MarketState> MarketStates = new();
    private List<AiSelfLearningService.TradeHistoryEntry> Trades = new();



    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = AutoRefreshLoop();
    }

    private async Task AutoRefreshLoop()
    {
        while (await _timer!.WaitForNextTickAsync(_cts.Token))
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task LoadAsync()
    {
        var snap = FileLoader.LoadSnapshot();
        if (snap == null) return Task.CompletedTask;

        Stats = snap;
        MarketStates = snap.MarketStates.OrderByDescending(x => x.Time).Take(150).ToList(); 

        Trades = snap.Trades.OrderByDescending(x => x.Time).Take(150).ToList();

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
    }

    RenderFragment SummaryCard(string title, string value) => __builder =>
    {
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <div class="text-xs text-slate-400">@title</div>
            <div class="text-2xl font-bold">@value</div>
        </div>
        ;
    };

    RenderFragment SnapshotAgeCard() => __builder =>
    {
        var age = DateTime.UtcNow - Stats!.CreatedAtUtc;

        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <div class="text-xs text-slate-400">Возраст snapshot</div>
            <div class="text-2xl font-bold">@((int)age.TotalMinutes) мин</div>
            <div class="text-xs text-slate-400">v@Stats.SnapshotVersion — @Stats.Meta.Engine</div>
        </div>
        ;
    };
}
