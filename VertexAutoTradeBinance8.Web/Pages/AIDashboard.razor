@code {
    AiRuntimeState? State => Runtime.Current;

    List<BrainSymbolGroup> BrainSymbols = new();
    HashSet<string> PinnedSymbols = new();
    HashSet<string> ExpandedSymbols = new();

    string _brainFilter = "All";
    readonly string[] _brainFilters = { "All", "🔥 Hot", "💭 Thinking", "👁 Watching", "📌 Pinned" };

    int _hotCount, _thinkingCount, _watchCount, _totalWins, _totalLosses, _winRatePct;
    int _runtimeSec;

    decimal _shadowActualPf, _shadowFiltPf, _shadowDeltaPf;
    decimal _shadowActualDd, _shadowFiltDd, _shadowDeltaDd;
    decimal _shadowActualWr, _shadowFiltWr;
    int _shadowActualN, _shadowFiltN;
    bool _shadowRecommend;
    List<(int aH, int fH)> _shadowBars = new();
    List<NewsTapeItem> _newsTape = new();
    List<decimal> _equityActual = new();
    List<decimal> _equityFiltered = new();
    decimal _equityScale = 1m;

    bool IsExpanded(string s) => ExpandedSymbols.Contains(s);
    bool IsPinned(string s) => PinnedSymbols.Contains(s);

    IEnumerable<BrainSymbolGroup> FilteredNeurons => _brainFilter switch
    {
        "🔥 Hot"       => BrainSymbols.Where(x => NeuronLevel(NeuronPower(x.Strongest)) == 3),
        "💭 Thinking"  => BrainSymbols.Where(x => NeuronLevel(NeuronPower(x.Strongest)) == 2),
        "👁 Watching"  => BrainSymbols.Where(x => NeuronLevel(NeuronPower(x.Strongest)) == 1),
        "📌 Pinned"    => BrainSymbols.Where(x => IsPinned(x.Symbol)),
        _              => BrainSymbols
    };

    string StatusLabel(int lvl) => lvl switch
    {
        3 => "🔥 ACTIVE",
        2 => "💭 THINKING",
        1 => "👁 WATCHING",
        _ => "😴 SLEEPING"
    };

    protected override void OnInitialized()
    {
        Runtime.OnUpdated += Refresh;
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await DrawCanvas();
    }

    void Refresh()
    {
        RecomputeShadowKpi();
        RefreshInner();
    }

    void RefreshInner()
    {
        RebuildBrainSymbols();
        CalcStats();
        _runtimeSec = (int)(DateTime.UtcNow - (State?.LoadedAtUtc ?? DateTime.UtcNow)).TotalSeconds;
        InvokeAsync(async () => { StateHasChanged(); await DrawCanvas(); });
    }

    void RebuildBrainSymbols()
    {
        if (State == null || State.MarketStates.Count == 0) { BrainSymbols.Clear(); return; }
        BrainSymbols = State.MarketStates
            .GroupBy(x => x.Symbol)
            .Select(g =>
            {
                var strongest = g.OrderByDescending(s => NeuronPower(s)).First();
                return new BrainSymbolGroup
                {
                    Symbol   = g.Key,
                    Strongest = strongest,
                    All = g.OrderByDescending(s => NeuronPower(s)).ToList()
                };
            })
            .OrderByDescending(x => NeuronPower(x.Strongest))
            .ToList();

        _hotCount      = BrainSymbols.Count(x => NeuronLevel(NeuronPower(x.Strongest)) == 3);
        _thinkingCount = BrainSymbols.Count(x => NeuronLevel(NeuronPower(x.Strongest)) == 2);
        _watchCount    = BrainSymbols.Count(x => NeuronLevel(NeuronPower(x.Strongest)) == 1);
    }


    void RecomputeShadowKpi()
    {
        try
        {
            var clientId = Cfg["SharedData:DefaultClientId"] ?? "client_001";
            var trades = Journal.GetRecentEntries(clientId, null, 500)?.ToList()
                         ?? new List<VertexAutoTradeBinance8.Services.Learning.TradeJournalEntry>();
            var ordered = trades.OrderBy(x => x.ClosedAtUtc).ToList();

            (decimal pf, decimal wr, decimal dd, int n, List<decimal> curve) Compute(List<VertexAutoTradeBinance8.Services.Learning.TradeJournalEntry> list)
            {
                decimal gw = 0, gl = 0, eq = 0, peak = 0, maxDd = 0;
                int wins = 0;
                var curve = new List<decimal>();
                foreach (var tr in list)
                {
                    var p = tr.RealizedPnl;
                    if (p > 0) { gw += p; wins++; } else gl += Math.Abs(p);
                    eq += p;
                    if (eq > peak) peak = eq;
                    var d = peak - eq;
                    if (d > maxDd) maxDd = d;
                    curve.Add(eq);
                }
                decimal pf = gl > 0 ? gw / gl : (gw > 0 ? 99m : 0m);
                decimal wr = list.Count > 0 ? (decimal)wins / list.Count : 0m;
                return (pf, wr, maxDd, list.Count, curve);
            }

            var actual = Compute(ordered);
            var filtered = ordered.Where(tr =>
            {
                var r = (tr.CloseReason ?? "").ToUpperInvariant();
                return !(r.Contains("NEWS") || r.Contains("MACRO") || r.Contains("CATALYST"));
            }).ToList();
            var filt = Compute(filtered);

            _shadowActualPf = actual.pf; _shadowFiltPf = filt.pf;
            _shadowDeltaPf = filt.pf - actual.pf;
            _shadowActualDd = actual.dd; _shadowFiltDd = filt.dd;
            _shadowDeltaDd = filt.dd - actual.dd;
            _shadowActualWr = actual.wr; _shadowFiltWr = filt.wr;
            _shadowActualN = actual.n; _shadowFiltN = filt.n;
            _equityActual = actual.curve;
            _equityFiltered = filt.curve;
            _equityScale = Math.Max(
                actual.curve.DefaultIfEmpty(1).Select(Math.Abs).DefaultIfEmpty(1m).Max(),
                filt.curve.DefaultIfEmpty(1).Select(Math.Abs).DefaultIfEmpty(1m).Max());
            if (_equityScale < 1) _equityScale = 1;
            _shadowBars = new List<(int aH, int fH)>();
            int nPts = Math.Max(_equityActual.Count, _equityFiltered.Count);
            if (nPts > 0)
            {
                int step = Math.Max(1, nPts / 48);
                for (int i = 0; i < nPts; i += step)
                {
                    decimal a = i < _equityActual.Count ? _equityActual[i] : 0m;
                    decimal f = i < _equityFiltered.Count ? _equityFiltered[i] : 0m;
                    int aH = (int)Math.Clamp((double)(Math.Abs(a) / _equityScale * 90m) + 4, 4, 100);
                    int fH = (int)Math.Clamp((double)(Math.Abs(f) / _equityScale * 90m) + 4, 4, 100);
                    _shadowBars.Add((aH, fH));
                }
            }
            _shadowRecommend = actual.n >= 50 && _shadowDeltaPf >= 0.15m && _shadowFiltDd <= _shadowActualDd;
            LoadNewsTape();
        }
        catch
        {
            _shadowRecommend = false;
            LoadNewsTape();
        }
    }

    void LoadNewsTape()
    {
        try
        {
            var root = Cfg["SharedData:Root"];
            if (string.IsNullOrWhiteSpace(root))
            {
                _newsTape = new();
                return;
            }
            var path = Path.Combine(root, "news_tape.jsonl");
            // fallback: decisions file may have headline
            if (!File.Exists(path))
                path = Path.Combine(root, "news_shadow_decisions.jsonl");
            if (!File.Exists(path))
            {
                _newsTape = new();
                return;
            }
            var lines = File.ReadAllLines(path);
            var items = new List<NewsTapeItem>();
            for (int i = lines.Length - 1; i >= 0 && items.Count < 10; i--)
            {
                var line = lines[i];
                if (string.IsNullOrWhiteSpace(line)) continue;
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(line);
                    var r = doc.RootElement;
                    if (!r.TryGetProperty("headline", out var hlEl)) continue;
                    var hl = hlEl.GetString() ?? "";
                    if (string.IsNullOrWhiteSpace(hl)) continue;
                    // skip pure entry_eval without headline context
                    if (r.TryGetProperty("type", out var ty) && ty.GetString() == "entry_eval") continue;

                    DateTime utc = DateTime.UtcNow;
                    if (r.TryGetProperty("utc", out var u))
                    {
                        if (u.ValueKind == System.Text.Json.JsonValueKind.String &&
                            DateTime.TryParse(u.GetString(), null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
                            utc = parsed.ToUniversalTime();
                    }
                    string vector = r.TryGetProperty("vector", out var v) ? (v.GetString() ?? "") : "";
                    string cat = r.TryGetProperty("category", out var c) ? (c.GetString() ?? "") : "";
                    string src = r.TryGetProperty("source", out var s) ? (s.GetString() ?? "") : "";
                    var syms = new List<string>();
                    if (r.TryGetProperty("symbols", out var sy) && sy.ValueKind == System.Text.Json.JsonValueKind.Array)
                    {
                        foreach (var el in sy.EnumerateArray())
                        {
                            var ss = el.GetString();
                            if (!string.IsNullOrEmpty(ss)) syms.Add(ss!);
                        }
                    }
                    var age = DateTime.UtcNow - utc;
                    string ago = age.TotalMinutes < 1 ? "только что"
                        : age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes}м назад"
                        : age.TotalHours < 24 ? $"{(int)age.TotalHours}ч назад"
                        : $"{(int)age.TotalDays}д назад";

                    string vecIcon = vector.Contains("Bull", StringComparison.OrdinalIgnoreCase) ? "🟢↑"
                        : vector.Contains("Bear", StringComparison.OrdinalIgnoreCase) ? "🔴↓" : "⚪";
                    string catLabel = cat switch
                    {
                        "MacroHigh" => "МАКРО",
                        "TokenSpecific" => "ТОКЕН",
                        "Infrastructure" => "ИНФРА",
                        _ => string.IsNullOrEmpty(cat) ? "NEWS" : cat.ToUpperInvariant()
                    };
                    string css = vector.Contains("Bull", StringComparison.OrdinalIgnoreCase) ? "nf-bull"
                        : vector.Contains("Bear", StringComparison.OrdinalIgnoreCase) ? "nf-bear" : "nf-neu";

                    items.Add(new NewsTapeItem
                    {
                        Headline = hl.Length > 160 ? hl[..160] + "…" : hl,
                        Source = src,
                        CategoryLabel = catLabel,
                        VecIcon = vecIcon,
                        TimeAgo = ago,
                        Symbols = syms.Take(5).ToList(),
                        Css = css
                    });
                }
                catch { }
            }
            _newsTape = items;
        }
        catch
        {
            _newsTape = new();
        }
    }

    sealed class NewsTapeItem
    {
        public string Headline { get; set; } = "";
        public string Source { get; set; } = "";
        public string CategoryLabel { get; set; } = "";
        public string VecIcon { get; set; } = "";
        public string TimeAgo { get; set; } = "";
        public List<string> Symbols { get; set; } = new();
        public string Css { get; set; } = "";
    }

    void CalcStats()
    {
        if (State?.Trades == null) return;
        _totalWins   = State.Trades.Count(t => t.PnlPct >= 0);
        _totalLosses = State.Trades.Count(t => t.PnlPct < 0);
        var total    = _totalWins + _totalLosses;
        _winRatePct  = total > 0 ? (int)(_totalWins * 100.0 / total) : 0;
    }

    async Task DrawCanvas()
    {
        if (!BrainSymbols.Any()) return;
        try
        {
            var pwrs = BrainSymbols.Select(x => NeuronPower(x.Strongest)).Take(60).ToArray();
            await JS.InvokeVoidAsync("aiNeuralCanvas", "neuralCanvas", pwrs);
        }
        catch { }
    }

    void FocusSymbol(string s)
    {
        PinnedSymbols.Add(s);
        ExpandedSymbols.Add(s);
        _brainFilter = "All";
        StateHasChanged();
        _ = JS.InvokeVoidAsync("uiScrollToSymbol", s);
    }

    void TogglePin(string s) { if (!PinnedSymbols.Add(s)) PinnedSymbols.Remove(s); }
    void ToggleExpand(string s) { if (!ExpandedSymbols.Add(s)) ExpandedSymbols.Remove(s); }

    // ── HELPERS ──────────────────────────────────────────
    double NeuronPower(AiSelfLearningService.MarketState s)
    {
        var conf  = Math.Clamp((double)s.Confidence, 0, 1);
        var slope = Math.Min(Math.Abs((double)s.TrendSlopePercent) / 0.30, 1.0);
        var vol   = (double)s.VolatilityPercent;
        var volSc = vol < 0.3 ? 0.5 : 1.0;
        return Math.Clamp(conf * 0.6 + slope * 0.25 + volSc * 0.15, 0, 1);
    }

    int NeuronLevel(double p) => p >= 0.75 ? 3 : p >= 0.50 ? 2 : p >= 0.25 ? 1 : 0;

    string FP(decimal v) => v >= 1000 ? v.ToString("F2") : v >= 1 ? v.ToString("F4") : v.ToString("G5");

    string RegCls(MarketRegime r) => r switch
    {
        MarketRegime.StrongUpTrend or MarketRegime.UpTrend     => "rc-bull",
        MarketRegime.StrongDownTrend or MarketRegime.DownTrend => "rc-bear",
        MarketRegime.Range                                      => "rc-rng",
        MarketRegime.Squeeze                                    => "rc-sq",
        _ => "ab-dim"
    };

    string RegShort(MarketRegime r) => r switch
    {
        MarketRegime.StrongUpTrend   => "↑↑",
        MarketRegime.UpTrend         => "↑",
        MarketRegime.StrongDownTrend => "↓↓",
        MarketRegime.DownTrend       => "↓",
        MarketRegime.Range           => "↔",
        MarketRegime.Squeeze         => "⊞",
        _ => "—"
    };

    string TfShort(string tf) => tf switch
    {
        "OneMinute" => "1m", "FiveMinutes" => "5m",
        "FifteenMinutes" => "15m", "OneHour" => "1h",
        "FourHour" => "4h", "OneDay" => "1D", _ => tf
    };

    public void Dispose()
    {
        Runtime.OnUpdated -= Refresh;
    }

    class BrainSymbolGroup
    {
        public string Symbol { get; set; } = "";
        public AiSelfLearningService.MarketState Strongest { get; set; } = null!;
        public List<AiSelfLearningService.MarketState> All { get; set; } = new();
    }
}
