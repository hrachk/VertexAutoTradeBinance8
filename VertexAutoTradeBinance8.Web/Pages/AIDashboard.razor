@page "/ai-dashboard"
@using VertexAutoTradeBinance8.Models
@using VertexAutoTradeBinance8.Services
@using VertexAutoTradeBinance8.Web.Services
@inject AiLearningFileService FileLoader
@implements IDisposable

<div class="vt-page-title">
    <div>
        <h1>AI Dashboard</h1>
        <p>Learning snapshot · regimes · recent states · auto 5s</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        @if (Stats != null)
        {
            <span class="vt-badge ok">v@(Stats.SnapshotVersion)</span>
            <span class="vt-hint">age @AgeMin мин · @_tick.ToLocalTime().ToString("HH:mm:ss")</span>
        }
        else
        {
            <span class="vt-badge warn">no snapshot</span>
        }
    </div>
</div>

@if (Stats == null)
{
    <div class="vt-card">
        <div class="vt-empty">
            <div class="ico">◆</div>
            <div>AI snapshot не загружен (ai_learning / ai-model json).</div>
            <div class="vt-hint" style="margin-top:8px;">Бот пишет снапшот при работе — страница обновится сама.</div>
        </div>
    </div>
}
else
{
    <div class="ad-kpi">
        <div class="ad-kpi-card"><div class="lbl">Symbols</div><div class="val">@Stats.Meta.Symbols</div></div>
        <div class="ad-kpi-card"><div class="lbl">Market states</div><div class="val">@Stats.Meta.MarketStates</div></div>
        <div class="ad-kpi-card"><div class="lbl">Trades</div><div class="val">@Stats.Meta.Trades</div></div>
        <div class="ad-kpi-card"><div class="lbl">Engine</div><div class="val" style="font-size:16px;">@(Stats.Meta.Engine ?? "—")</div></div>
    </div>

    <div class="vt-card" style="margin-bottom:14px;">
        <div class="vt-card-title" style="margin-bottom:12px;">WinRate по символам / regime</div>
        @if (Stats.Symbols == null || Stats.Symbols.Count == 0)
        {
            <div class="vt-hint">Нет агрегированной статистики по символам.</div>
        }
        else
        {
            <div class="ad-sym-grid">
                @foreach (var s in Stats.Symbols.Take(24))
                {
                    <div class="ad-sym">
                        <div class="ad-sym-name">@s.Symbol</div>
                        @if (s.Regimes != null && s.Regimes.Count > 0)
                        {
                            @foreach (var r in s.Regimes.OrderByDescending(x => x.Trades).Take(4))
                            {
                                var wr = r.Trades > 0 ? (100.0 * r.Wins / r.Trades) : 0;
                                <div class="ad-reg">
                                    <span>@r.Regime · @r.Trades</span>
                                    <span class="@(wr>=55?"pos":wr>=45?"mid":"neg")">@wr.ToString("F0")%</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="vt-hint">no regimes</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="vt-card" style="margin-bottom:14px;">
        <div class="vt-card-title" style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <span>Live market states</span>
            <button class="vt-btn" style="padding:4px 10px;font-size:12px;" @onclick="ToggleMarket">@(ShowMarket?"Hide":"Show")</button>
        </div>
        @if (ShowMarket)
        {
            @if (MarketStates.Count == 0)
            {
                <div class="vt-hint">Пока нет market states в snapshot.</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="vt-table" style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead>
                            <tr style="text-align:left;color:var(--vt-text-muted);border-bottom:1px solid var(--vt-border);">
                                <th style="padding:8px 10px;">Time</th>
                                <th style="padding:8px 10px;">Symbol</th>
                                <th style="padding:8px 10px;">TF</th>
                                <th style="padding:8px 10px;">Regime</th>
                                <th style="padding:8px 10px;">Slope</th>
                                <th style="padding:8px 10px;">Vol</th>
                                <th style="padding:8px 10px;">Conf</th>
                                <th style="padding:8px 10px;">Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in MarketStates.Take(80))
                            {
                                <tr style="border-bottom:1px solid var(--vt-border-soft);">
                                    <td style="padding:7px 10px;color:var(--vt-text-muted);font-family:var(--vt-mono);">@m.Time.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td style="padding:7px 10px;font-weight:600;">@m.Symbol</td>
                                    <td style="padding:7px 10px;">@m.Timeframe</td>
                                    <td style="padding:7px 10px;">@m.Regime</td>
                                    <td style="padding:7px 10px;font-family:var(--vt-mono);">@((m.TrendSlopePercent*100).ToString("F2"))%</td>
                                    <td style="padding:7px 10px;font-family:var(--vt-mono);">@((m.VolatilityPercent*100).ToString("F2"))%</td>
                                    <td style="padding:7px 10px;">@((m.Confidence*100).ToString("F0"))%</td>
                                    <td style="padding:7px 10px;color:var(--vt-text-muted);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@m.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    <div class="vt-card">
        <div class="vt-card-title" style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <span>Recent trades (learning)</span>
            <button class="vt-btn" style="padding:4px 10px;font-size:12px;" @onclick="ToggleTrades">@(ShowTrades?"Hide":"Show")</button>
        </div>
        @if (ShowTrades)
        {
            @if (Trades.Count == 0)
            {
                <div class="vt-hint">Нет сделок в snapshot (trades=0).</div>
            }
            else
            {
                <div class="ad-trade-grid">
                    @foreach (var t in Trades.Take(40))
                    {
                        <div class="ad-trade">
                            <div class="ad-trade-h">
                                <strong>@t.Symbol</strong>
                                <span class="@(t.Side == SignalSide.Buy ? "pos" : "neg")">@(t.Side == SignalSide.Buy ? "LONG" : "SHORT")</span>
                            </div>
                            <div class="ad-trade-b">
                                <span>@t.Entry → @t.Exit</span>
                                <span class="@((t.Pnl>=0)?"pos":"neg")">@t.Pnl.ToString("F2")</span>
                            </div>
                            <div class="vt-hint">@t.Regime · @t.Time.ToLocalTime().ToString("dd.MM HH:mm")</div>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

<style>
.ad-kpi { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; margin-bottom:14px; }
.ad-kpi-card { background:var(--vt-bg-card); border:1px solid var(--vt-border); border-radius:var(--vt-radius); padding:14px 16px; }
.ad-kpi-card .lbl { font-size:11px; color:var(--vt-text-muted); text-transform:uppercase; }
.ad-kpi-card .val { font-size:24px; font-weight:700; margin-top:4px; }
.ad-sym-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; }
.ad-sym { background:var(--vt-bg-elevated); border:1px solid var(--vt-border-soft); border-radius:8px; padding:10px 12px; }
.ad-sym-name { font-weight:700; margin-bottom:6px; }
.ad-reg { display:flex; justify-content:space-between; font-size:12px; padding:2px 0; color:var(--vt-text-muted); }
.ad-trade-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px; }
.ad-trade { background:var(--vt-bg-elevated); border:1px solid var(--vt-border-soft); border-radius:8px; padding:10px 12px; }
.ad-trade-h, .ad-trade-b { display:flex; justify-content:space-between; margin-bottom:4px; }
.pos { color:var(--vt-green); font-weight:600; }
.neg { color:var(--vt-red); font-weight:600; }
.mid { color:var(--vt-yellow); font-weight:600; }
</style>

@code {
    bool ShowMarket = true;
    bool ShowTrades = true;
    void ToggleMarket() => ShowMarket = !ShowMarket;
    void ToggleTrades() => ShowTrades = !ShowTrades;

    private AiLearningSnapshot? Stats;
    private List<AiSelfLearningService.MarketState> MarketStates = new();
    private List<AiSelfLearningService.TradeHistoryEntry> Trades = new();
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();
    private DateTime _tick = DateTime.UtcNow;
    private int AgeMin => Stats == null ? 0 : (int)(DateTime.UtcNow - Stats.CreatedAtUtc).TotalMinutes;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = AutoRefreshLoop();
    }

    private async Task AutoRefreshLoop()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                _tick = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private Task LoadAsync()
    {
        try
        {
            var snap = FileLoader.LoadSnapshot();
            if (snap == null) return Task.CompletedTask;
            Stats = snap;
            MarketStates = (snap.MarketStates ?? new())
                .OrderByDescending(x => x.Time).Take(150).ToList();
            Trades = (snap.Trades ?? new())
                .OrderByDescending(x => x.Time).Take(150).ToList();
        }
        catch { }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        try { _cts.Cancel(); _timer?.Dispose(); } catch { }
    }
}
