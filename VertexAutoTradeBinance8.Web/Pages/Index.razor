@page "/"
@using VertexAutoTradeBinance8.Models
@using VertexAutoTradeBinance8.Configuration
@using VertexAutoTradeBinance8.Web.Shared.Ui
@inject TerminalDataService Data
@inject TradingOptions Opt
@implements IDisposable

<PageTitle>Vertex · Dashboard</PageTitle>

<div class="vt-page-title">
    <div>
        <h1>Dashboard</h1>
        <p>Портфель, риск и активность бота · обновление каждые 5 с</p>
    </div>
    <div class="vt-page-actions">
        <span class="vt-hint mono">@(s == null ? "" : Fmt.Local(s.AtUtc, "HH:mm:ss"))</span>
        <a class="vt-btn sm" href="trades">Журнал</a>
        <a class="vt-btn sm primary" href="positions">Позиции</a>
    </div>
</div>

@if (s == null)
{
    <div class="vt-card"><div class="vt-empty">Загрузка…</div></div>
}
else
{
    var st = s.Stats;
    var dailyLimit = s.Wallet * Opt.MaxDailyLossPercent / 100m;
    var dailyUsed = st.TodayPnl < 0 && dailyLimit > 0 ? Math.Min(1m, -st.TodayPnl / dailyLimit) : 0m;
    var maxOpen = Opt.MaxOpenPositions > 0 ? Opt.MaxOpenPositions : 4;

    <div class="vt-kpi-grid" style="margin-bottom:16px">
        <div class="vt-kpi">
            <span class="label">Equity</span>
            <span class="value">@Fmt.Money(s.Equity)</span>
            <span class="sub">wallet @Fmt.Money(s.Wallet) · USDT</span>
            <Sparkline Values="@spark" />
        </div>
        <div class="vt-kpi @(st.NetPnl >= 0 ? "green" : "red")">
            <span class="label">Net PnL</span>
            <span class="value">@Fmt.Signed(st.NetPnl)</span>
            <span class="sub">7d @Fmt.Signed(st.WeekPnl) · fees @Fmt.Money(st.Fees)</span>
        </div>
        <div class="vt-kpi @(st.TodayPnl >= 0 ? "green" : "red")">
            <span class="label">Today</span>
            <span class="value">@Fmt.Signed(st.TodayPnl)</span>
            <span class="sub">@st.TodayTrades сделок · UTC день</span>
        </div>
        <div class="vt-kpi">
            <span class="label">Win rate</span>
            <span class="value">@Fmt.Pct(st.WinRate)</span>
            <span class="sub">@st.Wins W / @st.Losses L · @st.Trades всего</span>
        </div>
        <div class="vt-kpi @(st.ProfitFactor >= 1.3m ? "green" : st.ProfitFactor >= 1m ? "yellow" : "red")">
            <span class="label">Profit factor</span>
            <span class="value">@(st.Trades == 0 ? "—" : st.ProfitFactor.ToString("0.00"))</span>
            <span class="sub">avg W @Fmt.Signed(st.AvgWin) · avg L @Fmt.Signed(st.AvgLoss)</span>
        </div>
        <div class="vt-kpi red">
            <span class="label">Max drawdown</span>
            <span class="value">@Fmt.Money(st.MaxDrawdown)</span>
            <span class="sub">по реализованному PnL</span>
        </div>
    </div>

    <div class="vt-grid vt-grid-12" style="margin-bottom:16px">
        <div class="vt-card span-8">
            <div class="vt-card-header">
                <div class="vt-card-title"><span class="dot"></span>Equity curve · realized</div>
                <span class="vt-badge @(st.NetPnl >= 0 ? "ok" : "err")">@Fmt.Signed(st.NetPnl) USDT</span>
            </div>
            <EquityChart Points="@st.Curve" Height="250" />
        </div>

        <div class="vt-card span-4">
            <div class="vt-card-header">
                <div class="vt-card-title"><span class="dot"></span>Risk & engine</div>
                <span class="vt-badge @(s.EngineAlive ? "ok" : "warn")">@(s.EngineAlive ? "online" : "offline")</span>
            </div>

            <div class="vt-stack" style="gap:14px">
                <div class="vt-row"><span class="muted">Trading</span><span class="vt-spacer"></span>
                    <span class="vt-badge @(s.TradingEnabled ? "ok" : "err")">@(s.TradingEnabled ? "ON" : "OFF")</span></div>
                <div class="vt-row"><span class="muted">Session</span><span class="vt-spacer"></span>
                    <span class="vt-badge @(s.SessionOpen ? "info" : "warn")" title="@s.SessionReason">@(s.SessionOpen ? "open" : "observe")</span></div>
                <div class="vt-row"><span class="muted">Engine heartbeat</span><span class="vt-spacer"></span>
                    <span class="mono">@Fmt.Ago(s.EngineHeartbeat) ago</span></div>
                <div class="vt-row"><span class="muted">Last scan</span><span class="vt-spacer"></span>
                    <span class="mono">@(string.IsNullOrEmpty(s.EngineSymbol) ? "—" : s.EngineSymbol) · @s.EngineRegime</span></div>

                <div>
                    <div class="vt-row" style="margin-bottom:6px"><span class="muted">Open positions</span><span class="vt-spacer"></span>
                        <span class="mono">@s.Positions.Count / @maxOpen</span></div>
                    <div class="vt-meter"><span style="width:@(Math.Min(100, s.Positions.Count * 100 / Math.Max(1, maxOpen)))%"></span></div>
                </div>
                <div>
                    <div class="vt-row" style="margin-bottom:6px"><span class="muted">Daily loss limit (@Opt.MaxDailyLossPercent%)</span><span class="vt-spacer"></span>
                        <span class="mono">@Fmt.Money(Math.Max(0, -st.TodayPnl)) / @Fmt.Money(dailyLimit)</span></div>
                    <div class="vt-meter red"><span style="width:@((int)(dailyUsed * 100))%"></span></div>
                </div>
                <div class="vt-row"><span class="muted">Risk / trade</span><span class="vt-spacer"></span>
                    <span class="mono">@Opt.BaseRiskPercent% (max @Opt.MaxRiskPercent%) · @(Opt.Leverage)x</span></div>
            </div>
        </div>
    </div>

    <div class="vt-grid vt-grid-12">
        <div class="vt-card flush span-7">
            <div class="vt-card-header">
                <div class="vt-card-title"><span class="dot"></span>Open positions</div>
                <a class="vt-btn sm ghost" href="positions">Все →</a>
            </div>
            @if (s.Positions.Count == 0)
            {
                <div class="vt-empty"><div>Нет открытых позиций</div><div class="vt-hint">Бот ищет сетапы по активным символам</div></div>
            }
            else
            {
                <div class="vt-table-wrap">
                    <table class="vt-table">
                        <thead><tr><th>Symbol</th><th>Side</th><th class="r">Size</th><th class="r">Entry</th><th class="r">Mark</th><th class="r">uPnL</th><th class="r">R</th><th>Stage</th></tr></thead>
                        <tbody>
                            @foreach (var p in s.Positions)
                            {
                                <tr>
                                    <td class="sym">@p.Symbol @if (!p.Managed) { <span class="vt-badge neutral" style="margin-left:6px">manual</span> }</td>
                                    <td><span class="vt-badge @(p.IsLong ? "long" : "short")">@p.Side @(p.Leverage)x</span></td>
                                    <td class="r">@Fmt.Money(p.Notional)</td>
                                    <td class="r">@Fmt.Price(p.Entry)</td>
                                    <td class="r">@Fmt.Price(p.Mark)</td>
                                    <td class="r @Fmt.Cls(p.UnrealizedPnl)">@Fmt.Signed(p.UnrealizedPnl)</td>
                                    <td class="r @Fmt.Cls(p.RMultiple ?? 0)">@(p.RMultiple?.ToString("0.00") ?? "—")</td>
                                    <td><span class="vt-stage"><i class="@(p.Stage >= 0 && p.Managed ? "on" : "")"></i><i class="@(p.Stage >= 1 ? "on" : "")"></i><i class="@(p.Stage >= 2 ? "on" : "")"></i></span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="vt-card flush span-5">
            <div class="vt-card-header">
                <div class="vt-card-title"><span class="dot"></span>Recent closes</div>
                <a class="vt-btn sm ghost" href="trades">Журнал →</a>
            </div>
            @if (s.RecentClosed.Count == 0)
            {
                <div class="vt-empty">Закрытых сделок пока нет</div>
            }
            else
            {
                <div class="vt-table-wrap">
                    <table class="vt-table">
                        <thead><tr><th>Time</th><th>Symbol</th><th>Side</th><th class="r">PnL</th><th>Exit</th></tr></thead>
                        <tbody>
                            @foreach (var r in s.RecentClosed)
                            {
                                <tr>
                                    <td class="dim">@Fmt.Local(r.EffectiveCloseTime)</td>
                                    <td class="sym">@r.Symbol</td>
                                    <td><span class="vt-badge @(r.Side == SignalSide.Buy ? "long" : "short")">@(r.Side == SignalSide.Buy ? "L" : "S")</span></td>
                                    <td class="r @Fmt.Cls(r.PnL ?? 0)">@Fmt.Signed(r.PnL ?? 0)</td>
                                    <td class="dim" style="font-family:var(--vt-font)">@(r.CloseReason ?? r.Status.ToString())</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private TerminalSnapshot? s;
    private List<decimal> spark = new();
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new Timer(async _ => { await Load(); await InvokeAsync(StateHasChanged); }, null, 5000, 5000);
    }

    private async Task Load()
    {
        try
        {
            s = await Data.GetAsync();
            var curve = s.Stats.Curve;
            spark = curve.Skip(Math.Max(0, curve.Count - 40)).Select(x => x.equity).ToList();
        }
        catch { }
    }

    public void Dispose() => _timer?.Dispose();
}
