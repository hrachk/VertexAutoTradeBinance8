@page "/"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@inject EngineStateService EngineState
@inject LivePnlService PnlService
@implements IDisposable

<PageTitle>Vertex AI — Live</PageTitle>

<div class="vx">

    <!-- TOP BAR -->
    <div class="vx-bar">
        <span class="vx-logo">⬡ VERTEX AI</span>
        <div class="vx-bar-mid">
            <span class="vx-pill @(_s != null ? "pill-on" : "pill-off")">
                <span class="dot"></span>@(_s != null ? "LIVE" : "OFFLINE")
            </span>
            @if (_s != null)
            {
                <span class="vx-tag @RegimeClass">@_s.MarketRegime</span>
                <span class="vx-dim">|</span>
                <span class="vx-dim">@_s.Mode</span>
                <span class="vx-dim">|</span>
                <span class="vx-sym">@_s.Symbol</span>
                <span class="vx-dim">@_s.Timeframe</span>
            }
        </div>
        <span class="vx-clock">@DateTime.Now.ToString("HH:mm:ss")</span>
    </div>

    <!-- METRICS -->
    <div class="vx-metrics">

        <div class="vx-m">
            <div class="vx-m-label">BALANCE</div>
            <div class="vx-m-val blue">@(_s != null ? $"${_s.BalanceUsdt:F2}" : "—")</div>
            <div class="vx-m-sub">USDT</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">REALIZED PNL</div>
            <div class="vx-m-val @PnlClass">
                @(_s != null ? $"{(_s.RealizedPnlUsd>=0?"+":"")}{_s.RealizedPnlUsd:F2}$" : "—")
            </div>
            <div class="vx-m-sub">Session</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">POSITIONS</div>
            <div class="vx-m-val yellow">
                @_positions.Count<span class="vx-cap">/4</span>
            </div>
            <div class="vx-m-sub">Open</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">UNREALIZED</div>
            <div class="vx-m-val @UnrClass">
                @(_unrPnl>=0?"+":"")@_unrPnl.ToString("F2")$
            </div>
            <div class="vx-m-sub">Total PnL</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">CONFIDENCE</div>
            <div class="vx-conf-wrap">
                <div class="vx-conf-bar" style="width:@ConfPct%"></div>
            </div>
            <div class="vx-m-val blue">
                @(_s != null ? $"{_s.ConfidencePercent}%" : "—")
            </div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">LAST DECISION</div>
            <div class="vx-m-val sm @(_s?.LastEntryDecision?.Contains("BLOCK")==true?"warn":"")">
                @(_s?.LastEntryDecision ?? "—")
            </div>
            <div class="vx-m-sub">@(_s?.ConfidenceLevel ?? "—")</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">UNIVERSE</div>
            <div class="vx-m-val yellow">@(_s?.UniverseSize ?? 0)</div>
            <div class="vx-m-sub">Symbols tracked</div>
        </div>

        <div class="vx-m">
            <div class="vx-m-label">CYCLES/MIN</div>
            <div class="vx-m-val blue">@(_s?.CyclesPerMinute ?? 0)</div>
            <div class="vx-m-sub">Engine speed</div>
        </div>

    </div>

    <!-- POSITIONS TABLE -->
    <div class="vx-section">
        <div class="vx-sh">
            <span class="vx-st">POSITIONS</span>
            <span class="vx-sb">@_positions.Count active</span>
            @if (_unrPnl != 0)
            {
                <span class="vx-sb @UnrClass">Net: @(_unrPnl>=0?"+":"")@_unrPnl.ToString("F2")$</span>
            }
        </div>

        @if (!_positions.Any())
        {
            <div class="vx-empty">No open positions — scanning @(_s?.UniverseSize ?? 0) symbols</div>
        }
        else
        {
            <table class="vx-tbl">
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Side</th>
                        <th>Qty</th>
                        <th>Entry</th>
                        <th>Mark</th>
                        <th>PnL $</th>
                        <th>PnL %</th>
                        <th>Liq</th>
                        <th>Buffer</th>
                        <th>Margin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _positions)
                    {
                        var isLong = p.PositionSide == "LONG";
                        var pnlPct = p.EntryPrice > 0
                            ? (p.MarkPrice - p.EntryPrice) / p.EntryPrice * (isLong ? 1 : -1) * 100m : 0m;
                        var liqBuf = p.LiquidationPrice.HasValue && p.MarkPrice > 0
                            ? Math.Abs(p.MarkPrice - p.LiquidationPrice.Value) / p.MarkPrice * 100m
                            : (decimal?)null;
                        var liqCls = liqBuf.HasValue
                            ? (liqBuf < 4 ? "danger" : liqBuf < 8 ? "warn" : "safe") : "";

                        <tr>
                            <td class="sym">@p.Symbol</td>
                            <td><span class="side @(isLong?"lng":"sht")">@p.PositionSide</span></td>
                            <td>@p.PositionAmt.ToString("G6")</td>
                            <td>@p.EntryPrice.ToString("G6")</td>
                            <td>@p.MarkPrice.ToString("G6")</td>
                            <td class="@(p.UnrealizedPnl>=0?"grn":"red")">
                                @(p.UnrealizedPnl>=0?"+":"")@p.UnrealizedPnl.ToString("F2")$
                            </td>
                            <td class="@(pnlPct>=0?"grn":"red")">
                                @(pnlPct>=0?"+":"")@pnlPct.ToString("F2")%
                            </td>
                            <td class="@liqCls">
                                @(p.LiquidationPrice.HasValue ? p.LiquidationPrice.Value.ToString("G6") : "—")
                            </td>
                            <td class="@liqCls">
                                @(liqBuf.HasValue ? $"{liqBuf.Value:F1}%" : "—")
                            </td>
                            <td>@(p.IsolatedMargin.HasValue ? $"${p.IsolatedMargin.Value:F2}" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ENGINE STATE -->
    @if (_s != null)
    {
        <div class="vx-section">
            <div class="vx-sh"><span class="vx-st">ENGINE STATE</span></div>
            <div class="vx-cards">
                <div class="vx-card"><div class="vx-cl">Status</div><div class="vx-cv">@_s.Status</div></div>
                <div class="vx-card"><div class="vx-cl">Mode</div><div class="vx-cv">@_s.Mode</div></div>
                <div class="vx-card"><div class="vx-cl">Symbol</div><div class="vx-cv blue">@_s.Symbol</div></div>
                <div class="vx-card"><div class="vx-cl">Timeframe</div><div class="vx-cv">@_s.Timeframe</div></div>
                <div class="vx-card"><div class="vx-cl">Market Regime</div><div class="vx-cv @RegimeClass">@_s.MarketRegime</div></div>
                <div class="vx-card"><div class="vx-cl">Smart Regime</div><div class="vx-cv">@_s.SmartRegime</div></div>
                <div class="vx-card"><div class="vx-cl">Slope</div><div class="vx-cv">@_s.Slope.ToString("F4")</div></div>
                <div class="vx-card"><div class="vx-cl">Volatility</div><div class="vx-cv">@_s.Volatility.ToString("F4")</div></div>
                <div class="vx-card"><div class="vx-cl">Confidence</div><div class="vx-cv blue">@_s.ConfidencePercent% (@_s.ConfidenceLevel)</div></div>
                <div class="vx-card"><div class="vx-cl">Last Decision</div>
                    <div class="vx-cv @(_s.LastEntryDecision?.Contains("BLOCK")==true?"warn":"")">@(_s.LastEntryDecision ?? "—")</div></div>
                <div class="vx-card"><div class="vx-cl">Liquidity</div>
                    <div class="vx-cv @(_s.LiquidityDanger?"danger":"safe")">@(_s.LiquidityDanger ? $"⚠ {_s.LiquidityReason}" : "OK")</div></div>
                <div class="vx-card"><div class="vx-cl">Open Positions</div><div class="vx-cv yellow">@_s.OpenPositions / 4</div></div>
                <div class="vx-card"><div class="vx-cl">Universe Size</div><div class="vx-cv">@_s.UniverseSize</div></div>
                <div class="vx-card"><div class="vx-cl">Supervisor</div><div class="vx-cv sm">@(_s.LastSupervisorMessage ?? "—")</div></div>
                <div class="vx-card"><div class="vx-cl">Last Update</div><div class="vx-cv sm">@_s.LastUpdate.ToString("HH:mm:ss")</div></div>
                <div class="vx-card"><div class="vx-cl">Cycles/min</div><div class="vx-cv">@_s.CyclesPerMinute</div></div>
            </div>
        </div>
    }

    <!-- NAV LINKS -->
    <div class="vx-nav">
        <a href="/engine">⚙ Engine</a>
        <a href="/ai-dashboard">🤖 AI Dashboard</a>
        <a href="/positions">📊 Positions</a>
        <a href="/missed-trades">📡 Signals</a>
        <a href="/ai-learning">📈 Learning</a>
    </div>

</div>

<style>
:root {
    --bg: #0a0d12; --bg2: #111520; --bg3: #1a1f2e;
    --bdr: #1e2535; --acc: #3b82f6; --grn: #22c55e;
    --red: #ef4444; --yel: #eab308; --txt: #e2e8f0;
    --dim: #64748b; --mono: 'JetBrains Mono','Fira Code',monospace;
}
html,body{background:var(--bg)!important;color:var(--txt);}
.vx{font-family:'Inter','Segoe UI',sans-serif;background:var(--bg);min-height:100vh;padding:0 0 40px;}

/* BAR */
.vx-bar{display:flex;align-items:center;justify-content:space-between;background:var(--bg2);border-bottom:1px solid var(--bdr);padding:10px 24px;position:sticky;top:0;z-index:100;}
.vx-logo{font-family:var(--mono);font-size:18px;font-weight:700;color:var(--acc);letter-spacing:3px;}
.vx-bar-mid{display:flex;align-items:center;gap:10px;font-size:13px;}
.vx-clock{font-family:var(--mono);font-size:14px;color:var(--dim);}
.vx-dim{color:var(--bdr);}
.vx-sym{color:var(--acc);font-weight:600;}
.vx-tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:4px;background:var(--bg3);}
.vx-pill{display:flex;align-items:center;gap:6px;padding:3px 12px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:1px;}
.pill-on{background:rgba(34,197,94,.15);color:var(--grn);border:1px solid rgba(34,197,94,.3);}
.pill-off{background:rgba(239,68,68,.15);color:var(--red);border:1px solid rgba(239,68,68,.3);}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;animation:pulse 1.5s infinite;}
@@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

/* METRICS */
.vx-metrics{display:grid;grid-template-columns:repeat(8,1fr);gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.vx-m{background:var(--bg2);padding:18px 16px 14px;display:flex;flex-direction:column;gap:4px;}
.vx-m-label{font-size:10px;letter-spacing:1.5px;color:var(--dim);font-weight:600;}
.vx-m-val{font-family:var(--mono);font-size:20px;font-weight:700;}
.vx-m-val.sm{font-size:12px;word-break:break-all;}
.vx-m-sub{font-size:11px;color:var(--dim);}
.vx-cap{font-size:13px;color:var(--dim);}
.blue{color:var(--acc)!important;}
.yellow{color:var(--yel)!important;}
.grn{color:var(--grn)!important;}
.red{color:var(--red)!important;}
.warn{color:var(--yel)!important;}
.safe{color:var(--grn)!important;}
.danger{color:var(--red)!important;font-weight:700!important;}

/* CONFIDENCE */
.vx-conf-wrap{height:4px;background:var(--bg3);border-radius:2px;overflow:hidden;margin:4px 0;}
.vx-conf-bar{height:100%;background:var(--acc);border-radius:2px;transition:width .5s;}

/* REGIME */
.bull{color:var(--grn)!important;}
.bear{color:var(--red)!important;}
.rng{color:var(--yel)!important;}

/* SECTION */
.vx-section{padding:20px 24px 8px;}
.vx-sh{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--bdr);}
.vx-st{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--dim);font-weight:700;}
.vx-sb{font-size:11px;padding:2px 8px;background:var(--bg3);border-radius:10px;color:var(--dim);}
.vx-empty{text-align:center;padding:32px;color:var(--dim);background:var(--bg2);border-radius:8px;border:1px dashed var(--bdr);}

/* TABLE */
.vx-tbl{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:13px;}
.vx-tbl th{text-align:left;padding:7px 12px;font-size:10px;letter-spacing:1px;color:var(--dim);border-bottom:1px solid var(--bdr);font-family:'Inter',sans-serif;font-weight:600;}
.vx-tbl td{padding:9px 12px;border-bottom:1px solid var(--bdr);}
.vx-tbl tr:hover td{background:var(--bg3);}
.sym{color:var(--acc);font-weight:700;}
.side{padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;letter-spacing:1px;}
.lng{background:rgba(34,197,94,.15);color:var(--grn);}
.sht{background:rgba(239,68,68,.15);color:var(--red);}

/* CARDS */
.vx-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.vx-card{background:var(--bg2);border:1px solid var(--bdr);border-radius:6px;padding:12px 14px;}
.vx-cl{font-size:10px;letter-spacing:1.5px;color:var(--dim);margin-bottom:5px;font-weight:600;}
.vx-cv{font-family:var(--mono);font-size:13px;word-break:break-all;}
.vx-cv.sm{font-size:11px;}

/* NAV */
.vx-nav{display:flex;gap:10px;padding:20px 24px 0;flex-wrap:wrap;}
.vx-nav a{padding:7px 16px;background:var(--bg2);border:1px solid var(--bdr);border-radius:6px;color:var(--dim);font-size:13px;text-decoration:none;transition:all .2s;}
.vx-nav a:hover{border-color:var(--acc);color:var(--txt);}

@@media(max-width:1400px){.vx-metrics{grid-template-columns:repeat(4,1fr);}}
@@media(max-width:900px){.vx-metrics{grid-template-columns:repeat(2,1fr);}.vx-cards{grid-template-columns:repeat(2,1fr);}.vx-bar-mid{display:none;}}
</style>

@code {
    private EngineStateModel? _s;
    private IReadOnlyList<LivePositionModel> _positions = Array.Empty<LivePositionModel>();
    private decimal _unrPnl;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        PnlService.Start(null, 1000);
        PnlService.Updated += OnUpdated;

        _timer = new System.Threading.Timer(_ =>
        {
            _s = EngineState.Load();
            InvokeAsync(StateHasChanged);
        }, null, 0, 2000);
    }

    private void OnUpdated()
    {
        _positions = PnlService.GetPositions();
        _unrPnl = _positions.Sum(p => p.UnrealizedPnl);
        InvokeAsync(StateHasChanged);
    }

    private string PnlClass  => _s?.RealizedPnlUsd >= 0 ? "grn" : "red";
    private string UnrClass   => _unrPnl >= 0 ? "grn" : "red";
    private double ConfPct    => _s != null ? Math.Min(100, (double)_s.ConfidencePercent) : 0;
    private string RegimeClass => _s?.MarketRegime?.ToLower() switch
    {
        "stronguptrend" or "uptrend"     => "bull",
        "strongdowntrend" or "downtrend" => "bear",
        "range" or "sideways"            => "rng",
        _ => ""
    };

    public void Dispose()
    {
        PnlService.Updated -= OnUpdated;
        PnlService.Stop();
        _timer?.Dispose();
    }
}
