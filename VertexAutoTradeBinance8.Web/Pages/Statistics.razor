@page "/statistics"
@using VertexAutoTradeBinance8.Web.Services
@using VertexAutoTradeBinance8.Web.Models
@using VertexAutoTradeBinance8.Web.Demo
@using VertexAutoTradeBinance8.Services
@using VertexAutoTradeBinance8.Configuration
@using Microsoft.Extensions.Options
@inject MissedTradeFileService MissedSvc
@inject VertexAutoTradeBinance8.Web.Services.ClientDataService ClientData
@using VertexAutoTradeBinance8.Web.Services.Auth
@inject VertexAutoTradeBinance8.Web.Services.Auth.AuthSessionService Auth
@inject DemoAccountService DemoAccount
@inject BinanceClientFactory Factory
@inject RealDcaHistoryReader RealDcaHistory
@inject IOptionsMonitor<DcaOptions> DcaOpts
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Vertex AI — Statistics</PageTitle>

<div class="st-root">

<!-- ══ HEADER ══════════════════════════════════════════════════════ -->
<div class="st-header">
    <div class="st-header-left">
        <div class="st-title-block">
            <h1 class="st-title">@(_activeTab == "dca" ? "DCA Report" : "Performance")</h1>
            <span class="st-mode-badge @(_demoMode ? "st-mode-demo" : "st-mode-live")">
                @(_demoMode ? "DEMO" : "LIVE")
            </span>
        </div>
    </div>
    <div class="st-header-right">
        <div class="st-ctrl-group">
            <button class="st-tab-btn @(_activeTab == "trading" ? "st-tab-on" : "")" @onclick='() => SetTab("trading")'>Trading</button>
            <button class="st-tab-btn @(_activeTab == "dca"     ? "st-tab-on" : "")" @onclick='() => SetTab("dca")'>DCA Report</button>
        </div>
        <div class="st-ctrl-sep"></div>
        <div class="st-ctrl-group">
            <button class="st-mode-btn @(!_demoMode ? "st-mode-on" : "")" @onclick="() => SetMode(false)">Live</button>
            <button class="st-mode-btn @(_demoMode  ? "st-mode-on" : "")" @onclick="() => SetMode(true)">Demo</button>
        </div>
        <div class="st-ctrl-sep"></div>
        <div class="st-ctrl-group">
            @foreach (var r in _ranges)
            {
                <button class="st-range-btn @(_range == r.Key ? "st-range-on" : "")"
                        @onclick="() => SetRange(r.Key)">@r.Value</button>
            }
        </div>
        <div class="st-ctrl-sep"></div>
        <div class="st-date-group">
            <input class="st-date-input" type="date" @bind="_dateFrom" @bind:after="LoadData" title="From" />
            <span class="st-date-dash">—</span>
            <input class="st-date-input" type="date" @bind="_dateTo"   @bind:after="LoadData" title="To" />
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="st-loading">
        <div class="st-spinner"></div>
        <span>Loading statistics…</span>
    </div>
}
else if (_activeTab == "trading")
{
    <!-- ══ KPI STRIP ═══════════════════════════════════════════════ -->
    <div class="st-kpi-row">
        <div class="st-kpi st-kpi-hero">
            <div class="st-kpi-label">Net PnL</div>
            <div class="st-kpi-value @(_stats.NetPnl >= 0 ? "st-up" : "st-dn")">
                @(_stats.NetPnl >= 0 ? "+" : "")@_stats.NetPnl.ToString("F2")
                <span class="st-kpi-unit">USDT</span>
            </div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Win Rate</div>
            <div class="st-kpi-value @(_stats.WinRate >= 50 ? "st-up" : "st-dn")">
                @_stats.WinRate.ToString("F1")<span class="st-kpi-unit">%</span>
            </div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Total Trades</div>
            <div class="st-kpi-value">@_stats.TotalTrades</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Avg Win</div>
            <div class="st-kpi-value st-up">+@_stats.AvgWin.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Avg Loss</div>
            <div class="st-kpi-value st-dn">@_stats.AvgLoss.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Profit Factor</div>
            <div class="st-kpi-value @(_stats.ProfitFactor >= 1 ? "st-up" : "st-dn")">@_stats.ProfitFactor.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Max Drawdown</div>
            <div class="st-kpi-value st-dn">@_stats.MaxDrawdown.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Best Trade</div>
            <div class="st-kpi-value st-up">+@_stats.BestTrade.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Worst Trade</div>
            <div class="st-kpi-value st-dn">@_stats.WorstTrade.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Avg Duration</div>
            <div class="st-kpi-value">@_stats.AvgDuration</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Expectancy</div>
            @{
                var exp = _stats.TotalTrades > 0
                    ? (_stats.WinRate/100m * _stats.AvgWin) + ((1m-_stats.WinRate/100m) * _stats.AvgLoss)
                    : 0m;
            }
            <div class="st-kpi-value @(exp >= 0 ? "st-up" : "st-dn")">@(exp >= 0?"+":"")@exp.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Avg R:R</div>
            @{
                var rr = _stats.AvgLoss != 0 ? _stats.AvgWin / Math.Abs(_stats.AvgLoss) : 0m;
            }
            <div class="st-kpi-value @(rr >= 1 ? "st-up" : "st-dn")">@rr.ToString("F2")</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Consec. Wins</div>
            <div class="st-kpi-value st-up">@_stats.MaxConsecWins</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Consec. Loss</div>
            <div class="st-kpi-value st-dn">@_stats.MaxConsecLosses</div>
        </div>
    </div>

    <!-- ══ BODY GRID ════════════════════════════════════════════════ -->
    <div class="st-body">
        <!-- LEFT COLUMN -->
        <div class="st-col">
            <!-- Cumulative PnL -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:220px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">📈</span>
                    <span class="st-card-title">Cumulative PnL</span>
                </div>
                <div class="st-chart-wrap">
                    @if (_cumulativePnl.Count > 0)
                    {
                        var isPos = _stats.NetPnl >= 0;
                        var lineColor = isPos ? "#22c55e" : "#ef4444";
                        var fillColor = isPos ? "rgba(34,197,94,.10)" : "rgba(239,68,68,.10)";
                        var pts = BuildCurvePts(_cumulativePnl, _svgW, _svgH);
                        var zeroY = PnlToY(0, _cumulativePnl, _svgH);
                        <svg class="st-svg" viewBox="0 0 @_svgW @_svgH" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="pnlGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="@lineColor" stop-opacity="0.25"/>
                                    <stop offset="100%" stop-color="@lineColor" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            <path d="@BuildFillPath(pts, _svgW, _svgH)" fill="url(#pnlGrad)" />
                            <line x1="0" y1="@zeroY" x2="@_svgW" y2="@zeroY"
                                  stroke="rgba(255,255,255,.08)" stroke-width="1" stroke-dasharray="4 3"/>
                            <polyline points="@pts" fill="none" stroke="@lineColor"
                                      stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
                        </svg>
                    }
                    else { <div class="st-empty">No trade history in selected range</div> }
                </div>
            </div>

            <!-- Calendar heatmap — month-by-month like Binance -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:180px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">🗓</span>
                    <span class="st-card-title">Daily PnL Calendar</span>
                </div>
                <div class="st-calendar">
                    @{
                        // Build list of months to show based on selected date range
                        var calMonths = new System.Collections.Generic.List<DateTime>();
                        var mCursor  = new DateTime(_dateFrom.Year, _dateFrom.Month, 1);
                        var mEnd     = new DateTime(_dateTo.Year,   _dateTo.Month,   1);
                        while (mCursor <= mEnd) { calMonths.Add(mCursor); mCursor = mCursor.AddMonths(1); }
                    }
                    <div class="st-cal-months">
                    @foreach (var month in calMonths)
                    {
                        var daysInMonth  = DateTime.DaysInMonth(month.Year, month.Month);
                        var startDow = ((int)new DateTime(month.Year, month.Month, 1).DayOfWeek + 6) % 7; // Mon=0
                        var monthPnl     = Enumerable.Range(1, daysInMonth)
                                            .Select(d => new DateTime(month.Year, month.Month, d))
                                            .Where(d => _dailyPnl.ContainsKey(d))
                                            .Sum(d => _dailyPnl[d]);
                        var mpSign       = monthPnl > 0 ? "+" : "";
                        var mpColor      = monthPnl > 0 ? "var(--st-up)" : monthPnl < 0 ? "var(--st-dn)" : "var(--st-dim)";

                        <div class="st-cal-month">
                            <!-- Month header -->
                            <div class="st-cal-mhd">
                                <span class="st-cal-mname">@month.ToString("MMMM yyyy")</span>
                                @if (monthPnl != 0)
                                {
                                    <span class="st-cal-mtotal" style="color:@mpColor">
                                        @mpSign@monthPnl.ToString("F2") USDT
                                    </span>
                                }
                            </div>
                            <!-- Day-of-week header -->
                            <div class="st-cal-grid">
                                @foreach (var dow in new[] { "Mo","Tu","We","Th","Fr","Sa","Su" })
                                { <div class="st-cal-dow">@dow</div> }
                                @* Empty cells before month start *@
                                @for (int i = 0; i < startDow; i++) { <div class="st-cal-empty"></div> }
                                @* Day cells *@
                                @for (int d = 1; d <= daysInMonth; d++)
                                {
                                    var day = new DateTime(month.Year, month.Month, d);
                                    if (day > _dateTo) { <div class="st-cal-empty"></div> continue; }
                                    var pnl = _dailyPnl.TryGetValue(day, out var v) ? v : 0m;
                                    var isToday = day.Date == DateTime.Today;
                                    var intensity = pnl != 0
                                        ? (double)Math.Min(Math.Abs(pnl) / Math.Max(_maxDayAbsPnl, 1m), 1m)
                                        : 0.0;
                                    // opacity: 0.18 (min) → 0.92 (max) — low trades still visible
                                    var alpha = pnl != 0 ? 0.18 + intensity * 0.74 : 0.0;
                                    var bg = pnl > 0 ? $"rgba(16,185,129,{alpha:F2})"
                                           : pnl < 0 ? $"rgba(239,68,68,{alpha:F2})"
                                           : "rgba(255,255,255,0.03)";
                                    var border = isToday ? "1px solid rgba(59,130,246,.7)" : "none";
                                    var pnlStr = pnl == 0 ? "" :
                                        (pnl > 0 ? "+" : "") +
                                        (Math.Abs(pnl) >= 100 ? ((int)Math.Abs(pnl)).ToString() :
                                         Math.Abs(pnl) >= 10  ? Math.Abs(pnl).ToString("F1") :
                                                                  Math.Abs(pnl).ToString("F2"));
                                    var tip = $"{day:ddd MMM d}: {(pnl >= 0 ? "+" : "")}{pnl:F2} USDT";
                                    <div class="st-cal-day @(isToday ? "st-cal-today" : "")"
                                         style="background:@bg;border:@border"
                                         title="@tip">
                                        <span class="st-cal-num">@d</span>
                                        @if (pnl != 0)
                                        {
                                            <span class="st-cal-pnl @(pnl > 0 ? "st-cal-pos" : "st-cal-neg")">@pnlStr</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    </div>
                </div>
            </div>

            <!-- Long vs Short -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:140px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">⚖️</span>
                    <span class="st-card-title">Long vs Short</span>
                </div>
                <div class="st-split-row">
                    <div class="st-split-side">
                        <div class="st-split-label">LONG</div>
                        <div class="st-split-val @(_stats.LongPnl >= 0 ? "st-up" : "st-dn")">
                            @(_stats.LongPnl >= 0 ? "+" : "")@_stats.LongPnl.ToString("F2")
                        </div>
                        <div class="st-split-meta">@_stats.LongWins W / @_stats.LongLosses L</div>
                        <div class="st-split-wr">Win rate: @(_stats.LongTrades > 0 ? (100m * _stats.LongWins / _stats.LongTrades).ToString("F1") : "—")%</div>
                    </div>
                    <div class="st-split-divider"></div>
                    <div class="st-split-side">
                        <div class="st-split-label">SHORT</div>
                        <div class="st-split-val @(_stats.ShortPnl >= 0 ? "st-up" : "st-dn")">
                            @(_stats.ShortPnl >= 0 ? "+" : "")@_stats.ShortPnl.ToString("F2")
                        </div>
                        <div class="st-split-meta">@_stats.ShortWins W / @_stats.ShortLosses L</div>
                        <div class="st-split-wr">Win rate: @(_stats.ShortTrades > 0 ? (100m * _stats.ShortWins / _stats.ShortTrades).ToString("F1") : "—")%</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="st-col">
            <!-- By Symbol -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:200px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">🪙</span>
                    <span class="st-card-title">By Symbol</span>
                </div>
                <div class="st-sym-list">
                    @foreach (var row in _bySymbol)
                    {
                        var barW = _bySymbol.Count > 0 && _bySymbol[0].AbsPnl > 0
                            ? (int)(100 * row.AbsPnl / _bySymbol[0].AbsPnl) : 0;
                        <div class="st-sym-row">
                            <span class="st-sym-name">@row.Symbol</span>
                            <div class="st-sym-bar-wrap">
                                <div class="st-sym-bar @(row.Pnl >= 0 ? "st-bar-pos" : "st-bar-neg")"
                                     style="width:@barW%"></div>
                            </div>
                            <span class="st-sym-pnl @(row.Pnl >= 0 ? "st-up" : "st-dn")">
                                @(row.Pnl >= 0 ? "+" : "")@row.Pnl.ToString("F2")
                            </span>
                            <span class="st-sym-cnt">@row.Count tr.</span>
                        </div>
                    }
                    @if (_bySymbol.Count == 0) { <div class="st-empty">No data</div> }
                </div>
            </div>

            <!-- Close Reasons -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:120px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">🏁</span>
                    <span class="st-card-title">Close Reasons</span>
                </div>
                <div class="st-reason-list">
                    @foreach (var r in _byReason)
                    {
                        var pct = _stats.TotalTrades > 0 ? (int)(100m * r.Value / _stats.TotalTrades) : 0;
                        <div class="st-reason-row">
                            <span class="st-reason-lbl">@r.Key</span>
                            <div class="st-reason-bar-wrap">
                                <div class="st-reason-bar" style="width:@(Math.Min(100,pct))%"></div>
                            </div>
                            <span class="st-reason-cnt">@r.Value</span>
                            <span class="st-reason-pct">@pct%</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Trade Log -->
            <div class="st-card st-card-log" style="resize:vertical;overflow:hidden;min-height:260px;">
                <div class="st-card-hd" style="flex-wrap:wrap;gap:10px;">
                    <span class="st-card-icon">📋</span>
                    <span class="st-card-title">
                        Trade Log
                        <span class="st-badge">@SortedTrades.Count()</span>
                        @if (_trades.Count != SortedTrades.Count()) {
                            <span class="st-badge" style="background:rgba(245,158,11,.15);color:#fbbf24;border-color:rgba(245,158,11,.3);">
                                of @_trades.Count
                            </span>
                        }
                    </span>
                    <div class="st-tlog-filters" style="margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                        @* Symbol search *@
                        <input class="st-filter-input" type="text" placeholder="Symbol…"
                               @bind="_filterSymbol" @bind:event="oninput" @bind:after="ApplyFilter"
                               style="width:90px;" />
                        @* Side filter *@
                        <div class="st-filter-chips">
                            <button class="st-fchip @(_filterSide==""?"st-fchip-on":"")"   @onclick='()=>{_filterSide="";ApplyFilter();}'>All</button>
                            <button class="st-fchip st-fchip-l @(_filterSide=="LONG"?"st-fchip-on":"")"  @onclick='()=>{_filterSide="LONG";ApplyFilter();}'>▲ Long</button>
                            <button class="st-fchip st-fchip-s @(_filterSide=="SHORT"?"st-fchip-on":"")" @onclick='()=>{_filterSide="SHORT";ApplyFilter();}'>▼ Short</button>
                        </div>
                        @* Result filter *@
                        <div class="st-filter-chips">
                            <button class="st-fchip @(_filterResult==""?"st-fchip-on":"")"    @onclick='()=>{_filterResult="";}'>All</button>
                            <button class="st-fchip st-fchip-w @(_filterResult=="WIN"?"st-fchip-on":"")"  @onclick='()=>{_filterResult="WIN";}'>W</button>
                            <button class="st-fchip st-fchip-l2 @(_filterResult=="LOSS"?"st-fchip-on":"")" @onclick='()=>{_filterResult="LOSS";}'>L</button>
                        </div>
                        @* Reset *@
                        @if (!string.IsNullOrEmpty(_filterSide) || !string.IsNullOrEmpty(_filterResult) || !string.IsNullOrEmpty(_filterSymbol))
                        {
                            <button class="st-fchip" @onclick='()=>{_filterSide="";_filterResult="";_filterSymbol="";ApplyFilter();}' title="Clear filters">✕</button>
                        }
                    </div>
                </div>
                <div class="st-tbl-wrap">
                    <table class="st-tbl">
                        <thead>
                            <tr>
                                <th @onclick='() => SetTradeSort("time")'>Time @SortArrow("time")</th>
                                <th @onclick='() => SetTradeSort("sym")'>Symbol @SortArrow("sym")</th>
                                <th>Side</th>
                                <th @onclick='() => SetTradeSort("pnl")'>PnL @SortArrow("pnl")</th>
                                <th>Entry</th>
                                <th>Exit</th>
                                <th>Duration</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in SortedTrades.Take(200))
                            {
                                <tr>
                                    <td class="st-mono st-tc-dim">@t.ClosedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                    <td class="st-tc-sym">@t.Symbol</td>
                                    <td class="@(t.Side == "LONG" ? "st-up" : "st-dn") st-tc-side">@t.Side</td>
                                    <td class="st-mono @(t.Pnl >= 0 ? "st-up" : "st-dn")">@(t.Pnl >= 0 ? "+" : "")@t.Pnl.ToString("F2")</td>
                                    <td class="st-mono st-tc-dim">@t.EntryPrice.ToString("G6")</td>
                                    <td class="st-mono st-tc-dim">@t.ExitPrice.ToString("G6")</td>
                                    <td class="st-tc-dim">@FormatDuration(t.OpenedAt, t.ClosedAt)</td>
                                    <td><span class="st-pill @ReasonClass(t.CloseReason)">@t.CloseReason</span></td>
                                </tr>
                            }
                            @if (!_trades.Any())
                            {
                                <tr><td colspan="8" class="st-empty">No closed trades in selected range</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else if (_activeTab == "dca")
{
    <!-- DCA Config Banner -->
    <div class="dca-banner">
        <div class="dca-banner-item">
            <span class="dca-banner-lbl">Schedule</span>
            <span class="dca-freq-badge dca-freq-@_dcaConfig.Frequency.ToLower()">@_dcaConfig.Frequency.ToUpper()</span>
        </div>
        <div class="dca-banner-item">
            <span class="dca-banner-lbl">Budget / cycle</span>
            <span class="dca-banner-val"><strong>@_dcaConfig.Budget.ToString("F0")</strong> USDT</span>
        </div>
        <div class="dca-banner-item">
            <span class="dca-banner-lbl">Symbols</span>
            <span class="dca-banner-val">
                @foreach (var s in _dcaConfig.Symbols)
                { <span class="dca-chip">@s</span> }
                @if (!_dcaConfig.Symbols.Any()) { <span class="st-tc-dim">None configured</span> }
            </span>
        </div>
        <div class="dca-banner-item">
            <span class="dca-banner-lbl">DCA</span>
            <span class="@(_dcaConfig.Enabled ? "st-up" : "st-dn") dca-banner-val">@(_dcaConfig.Enabled ? "ENABLED" : "DISABLED")</span>
        </div>
        <div class="dca-banner-item">
            <span class="dca-banner-lbl">Dip Bonus</span>
            <span class="dca-banner-val @(_dcaConfig.DipBonusEnabled ? "st-up" : "st-tc-dim")">
                @(_dcaConfig.DipBonusEnabled ? $"×{_dcaConfig.DipBonusMultiplier:F1} on -{_dcaConfig.DipDropPct:F0}% dip" : "Off")
            </span>
        </div>
    </div>

    <!-- DCA KPIs -->
    <div class="st-kpi-row">
        <div class="st-kpi st-kpi-hero">
            <div class="st-kpi-label">Total Invested</div>
            <div class="st-kpi-value">@_dcaStats.TotalInvested.ToString("F2") <span class="st-kpi-unit">USDT</span></div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Purchases</div>
            <div class="st-kpi-value">@_dcaStats.TotalPurchases</div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Avg / Cycle</div>
            <div class="st-kpi-value">@_dcaStats.AvgPerCycle.ToString("F2") <span class="st-kpi-unit">USDT</span></div>
        </div>
        <div class="st-kpi">
            <div class="st-kpi-label">Dip Buys</div>
            <div class="st-kpi-value @(_dcaStats.DipBonusCount > 0 ? "st-up" : "")">@_dcaStats.DipBonusCount</div>
        </div>
        @foreach (var kv in _dcaStats.AvgPriceBySymbol)
        {
            <div class="st-kpi">
                <div class="st-kpi-label">Avg @kv.Key.Replace("USDT","")</div>
                <div class="st-kpi-value st-mono" style="font-size:15px">@kv.Value.ToString("F2")</div>
            </div>
        }
        <div class="st-kpi">
            <div class="st-kpi-label">Period</div>
            <div class="st-kpi-value" style="font-size:13px">@_dcaStats.FirstDate.ToString("MMM d") — @_dcaStats.LastDate.ToString("MMM d yy")</div>
        </div>
    </div>

    <div class="st-body">
        <div class="st-col">
            <!-- DCA Cumulative chart -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:220px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">📊</span>
                    <span class="st-card-title">
                        Cumulative Invested
                        <div class="dca-legend">
                            @foreach (var sym in _dcaChartSeries.Keys)
                            {
                                var clr = SymbolColor(sym);
                                <span class="dca-legend-dot" style="background:@clr"></span>
                                <span class="dca-legend-lbl">@sym.Replace("USDT","")</span>
                            }
                        </div>
                    </span>
                </div>
                <div class="st-chart-wrap">
                    @if (_dcaChartSeries.Any())
                    {
                        <svg class="st-svg" viewBox="0 0 @_svgW @_svgH" preserveAspectRatio="none">
                            @foreach (var kvSeries in _dcaChartSeries)
                            {
                                var clr = SymbolColor(kvSeries.Key);
                                var spts = BuildCurvePts(kvSeries.Value, _svgW, _svgH);
                                @if (!string.IsNullOrEmpty(spts))
                                {
                                    <polyline points="@spts" fill="none" stroke="@clr"
                                              stroke-width="2" stroke-linejoin="round" opacity="0.9"/>
                                }
                            }
                        </svg>
                    }
                    else { <div class="st-empty">No DCA purchases in selected range</div> }
                </div>
            </div>

            <!-- Periodic Report -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:220px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">📅</span>
                    <span class="st-card-title">
                        Periodic Report
                        <div class="dca-period-tabs">
                            <button class="dca-ptab @(_dcaPeriod == "daily"   ? "dca-ptab-on" : "")" @onclick='() => SetDcaPeriod("daily")'>Daily</button>
                            <button class="dca-ptab @(_dcaPeriod == "weekly"  ? "dca-ptab-on" : "")" @onclick='() => SetDcaPeriod("weekly")'>Weekly</button>
                            <button class="dca-ptab @(_dcaPeriod == "monthly" ? "dca-ptab-on" : "")" @onclick='() => SetDcaPeriod("monthly")'>Monthly</button>
                        </div>
                    </span>
                </div>
                <div class="st-tbl-wrap" style="max-height:240px;">
                    <table class="st-tbl">
                        <thead><tr>
                            <th>Period</th><th>Buys</th><th>Invested</th><th>Avg Price</th><th>Dip</th><th>Symbols</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var row in _dcaPeriodRows)
                            {
                                <tr>
                                    <td class="st-mono dca-period-label">@row.Label</td>
                                    <td class="st-mono">@row.Count</td>
                                    <td class="st-mono dca-tc-inv">@row.Invested.ToString("F2") <span class="st-tc-dim">USDT</span></td>
                                    <td class="st-mono st-tc-dim">@(row.AvgPrice > 0 ? row.AvgPrice.ToString("F2") : "—")</td>
                                    <td class="@(row.DipCount > 0 ? "st-up" : "st-tc-dim")">@(row.DipCount > 0 ? row.DipCount.ToString() : "—")</td>
                                    <td>@foreach (var s in row.Symbols) { <span class="dca-chip dca-chip-sm">@s.Replace("USDT","")</span> }</td>
                                </tr>
                            }
                            @if (!_dcaPeriodRows.Any()) { <tr><td colspan="6" class="st-empty">No data in selected range</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="st-col">
            <!-- DCA By Symbol -->
            <div class="st-card" style="resize:vertical;overflow:auto;min-height:180px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">🪙</span>
                    <span class="st-card-title">By Symbol</span>
                </div>
                <div class="st-sym-list">
                    @foreach (var row in _dcaBySymbol)
                    {
                        var maxInv = _dcaBySymbol.Count > 0 ? _dcaBySymbol.Max(r => r.TotalInvested) : 1m;
                        var barW2  = maxInv > 0 ? (int)(100 * row.TotalInvested / maxInv) : 0;
                        var clr2   = SymbolColor(row.Symbol);
                        <div class="st-sym-row">
                            <span class="st-sym-name">@row.Symbol.Replace("USDT","")</span>
                            <div class="st-sym-bar-wrap">
                                <div class="st-sym-bar" style="width:@barW2%;background:@clr2"></div>
                            </div>
                            <span class="st-sym-pnl" style="color:@clr2">
                                @row.TotalInvested.ToString("F0") <span class="st-tc-dim" style="font-size:10px">USDT</span>
                            </span>
                            <span class="st-sym-cnt">@row.Count×</span>
                        </div>
                        <div class="dca-sym-detail">
                            <span class="st-tc-dim">Avg cost: <strong>@row.AvgPrice.ToString("F2")</strong></span>
                            <span class="st-tc-dim"> · Qty: <strong>@row.TotalQty.ToString("F5")</strong></span>
                            @if (row.DipCount > 0) { <span class="st-up"> · @row.DipCount dip buys</span> }
                        </div>
                    }
                    @if (!_dcaBySymbol.Any()) { <div class="st-empty">No data</div> }
                </div>
            </div>

            <!-- Purchase Log -->
            <div class="st-card st-card-log" style="resize:vertical;overflow:hidden;min-height:260px;">
                <div class="st-card-hd">
                    <span class="st-card-icon">🛒</span>
                    <span class="st-card-title">
                        Purchase Log
                        <span class="st-badge">@_dcaPurchases.Count</span>
                    </span>
                </div>
                <div class="st-tbl-wrap">
                    <table class="st-tbl">
                        <thead><tr>
                            <th>Time</th><th>Symbol</th><th>Price</th><th>Qty</th><th>Spent</th><th>Dip</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var p in _dcaPurchases.OrderByDescending(x => x.TimeUtc).Take(300))
                            {
                                <tr class="@(p.DipBonusApplied ? "dca-row-dip" : "")">
                                    <td class="st-mono st-tc-dim">@p.TimeUtc.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                    <td class="st-tc-sym">@p.Symbol.Replace("USDT","")</td>
                                    <td class="st-mono">@p.Price.ToString("F2")</td>
                                    <td class="st-mono">@p.Qty.ToString("F5")</td>
                                    <td class="st-mono dca-tc-inv">@p.UsdtSpent.ToString("F2")</td>
                                    <td class="@(p.DipBonusApplied ? "st-up" : "st-tc-dim")">@(p.DipBonusApplied ? "DIP ✦" : "—")</td>
                                </tr>
                            }
                            @if (!_dcaPurchases.Any()) { <tr><td colspan="6" class="st-empty">No DCA purchases in selected range</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

</div>

<style>
/* ── TOKENS ──────────────────────────────────────────────────────── */
:root {
    --st-bg:   #04060e;
    --st-bg2:  #080d1a;
    --st-bg3:  #0c1220;
    --st-bg4:  #111827;
    --st-bdr:  #1a2840;
    --st-bdr2: #223050;
    --st-acc:  #3b82f6;
    --st-acc2: #1d4ed8;
    --st-cyan: #22d3ee;
    --st-dim:  #475569;
    --st-dim2: #334155;
    --st-t2:   #94a3b8;
    --st-txt:  #e2e8f0;
    --st-up:   #10b981;
    --st-dn:   #ef4444;
    --st-up2:  rgba(16,185,129,.12);
    --st-dn2:  rgba(239,68,68,.12);
}

/* ── RESET / ROOT ─────────────────────────────────────────────────── */
* { scrollbar-width: none !important; }
*::-webkit-scrollbar { display: none !important; }

.st-root {
    color: var(--st-txt);
    font-family: 'Segoe UI', system-ui, sans-serif;
    padding: 20px 28px 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    background: var(--st-bg);
}

/* ── HEADER ───────────────────────────────────────────────────────── */
.st-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
}
.st-header-left { display: flex; align-items: center; gap: 14px; }
.st-title-block { display: flex; align-items: center; gap: 12px; }
.st-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--st-txt);
    margin: 0;
    letter-spacing: -.6px;
    line-height: 1;
}
.st-mode-badge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 3px 10px;
    border-radius: 20px;
}
.st-mode-live { background: rgba(16,185,129,.14); color: #10b981; border: 1px solid rgba(16,185,129,.3); }
.st-mode-demo { background: rgba(234,179,8,.12);  color: #eab308; border: 1px solid rgba(234,179,8,.3); }

.st-header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.st-ctrl-group { display: flex; align-items: center; gap: 3px; }
.st-ctrl-sep {
    width: 1px; height: 22px;
    background: var(--st-bdr);
    margin: 0 4px;
}

/* shared button base */
.st-tab-btn, .st-mode-btn, .st-range-btn {
    padding: 6px 14px;
    border-radius: 7px;
    border: 1px solid var(--st-bdr);
    background: transparent;
    color: var(--st-dim);
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: all .14s;
    white-space: nowrap;
}
.st-tab-btn:hover, .st-mode-btn:hover, .st-range-btn:hover {
    color: var(--st-txt);
    border-color: var(--st-bdr2);
    background: rgba(255,255,255,.03);
}
.st-tab-on {
    background: rgba(59,130,246,.12) !important;
    border-color: rgba(59,130,246,.5) !important;
    color: #60a5fa !important;
}
.st-mode-on, .st-range-on {
    background: var(--st-acc) !important;
    border-color: var(--st-acc) !important;
    color: #fff !important;
    box-shadow: 0 2px 10px rgba(59,130,246,.35);
}

.st-date-group { display: flex; align-items: center; gap: 6px; }
.st-date-dash { color: var(--st-dim); font-size: 14px; }
.st-date-input {
    background: var(--st-bg3);
    border: 1px solid var(--st-bdr);
    color: var(--st-txt);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 13px;
    cursor: pointer;
    transition: border-color .14s;
}
.st-date-input:focus { outline: none; border-color: var(--st-acc); }

/* ── LOADING ──────────────────────────────────────────────────────── */
.st-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 240px;
    color: var(--st-t2);
    font-size: 15px;
}
/* ── TRADE LOG FILTERS ────────────────────────────────────────────── */
.st-filter-input {
    height: 26px;
    padding: 0 8px;
    background: var(--st-bg3);
    border: 1px solid var(--st-bdr);
    border-radius: 5px;
    color: var(--st-txt);
    font-size: 11px;
    outline: none;
}
.st-filter-input:focus { border-color: var(--st-bdr2); }
.st-filter-chips { display: flex; gap: 2px; }
.st-fchip {
    padding: 3px 9px;
    height: 26px;
    border-radius: 5px;
    border: 1px solid var(--st-bdr);
    background: transparent;
    color: var(--st-dim);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all .12s;
    white-space: nowrap;
}
.st-fchip:hover { color: var(--st-txt); border-color: var(--st-bdr2); }
.st-fchip-on {
    background: rgba(59,130,246,.12) !important;
    border-color: rgba(59,130,246,.45) !important;
    color: #60a5fa !important;
}
.st-fchip-l.st-fchip-on  { background: rgba(16,185,129,.1) !important; border-color: rgba(16,185,129,.4) !important; color: #34d399 !important; }
.st-fchip-s.st-fchip-on  { background: rgba(239,68,68,.1) !important;  border-color: rgba(239,68,68,.4) !important;  color: #f87171 !important; }
.st-fchip-w.st-fchip-on  { background: rgba(16,185,129,.1) !important; border-color: rgba(16,185,129,.4) !important; color: #34d399 !important; }
.st-fchip-l2.st-fchip-on { background: rgba(239,68,68,.1) !important;  border-color: rgba(239,68,68,.4) !important;  color: #f87171 !important; }

/* ── ADDITIONAL KPI ────────────────────────────────────────────────── */
.st-kpi-row { flex-wrap: wrap; }
.st-kpi { min-width: 80px; }

.st-spinner {
    width: 22px; height: 22px;
    border: 2px solid var(--st-bdr);
    border-top-color: var(--st-acc);
    border-radius: 50%;
    animation: st-spin .7s linear infinite;
    flex-shrink: 0;
}
@@keyframes st-spin { to { transform: rotate(360deg); } }

/* ── KPI ROW ──────────────────────────────────────────────────────── */
.st-kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
}
.st-kpi {
    background: var(--st-bg2);
    border: 1px solid var(--st-bdr);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    transition: border-color .15s;
}
.st-kpi:hover { border-color: var(--st-bdr2); }
.st-kpi-hero { border-color: rgba(59,130,246,.3); background: rgba(59,130,246,.05); }
.st-kpi-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--st-dim);
}
.st-kpi-value {
    font-size: 20px;
    font-weight: 800;
    font-family: 'Cascadia Code', 'Fira Code', monospace;
    line-height: 1.1;
}
.st-kpi-unit { font-size: 11px; font-weight: 600; opacity: .55; }
.st-up  { color: var(--st-up)  !important; }
.st-dn  { color: var(--st-dn)  !important; }
.st-mono { font-family: monospace; }

/* ── BODY GRID ────────────────────────────────────────────────────── */
.st-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
}
@@media (max-width: 1080px) { .st-body { grid-template-columns: 1fr; } }
.st-col { display: flex; flex-direction: column; gap: 16px; }

/* ── CARDS ────────────────────────────────────────────────────────── */
.st-card {
    background: var(--st-bg2);
    border: 1px solid var(--st-bdr);
    border-radius: 14px;
    padding: 18px 20px;
    transition: border-color .15s;
    box-sizing: border-box;
}
.st-card:hover { border-color: var(--st-bdr2); }

/* resize handle styling */
.st-card[style*="resize"] {
    resize: vertical;
    overflow: auto;
}

.st-card-hd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}
.st-card-icon { font-size: 15px; line-height: 1; }
.st-card-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--st-t2);
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    flex-wrap: wrap;
}
.st-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--st-bg4);
    border: 1px solid var(--st-bdr);
    color: var(--st-t2);
    border-radius: 20px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
}
.st-empty {
    text-align: center;
    color: var(--st-dim);
    font-size: 13px;
    padding: 28px 0;
}

/* ── PNL CHART ────────────────────────────────────────────────────── */
.st-chart-wrap {
    height: 160px;
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
}
.st-svg { width: 100%; height: 100%; display: block; }

/* ── CALENDAR ─────────────────────────────────────────────────────── */
.st-calendar { overflow-x: auto; }
/* Month-by-month layout */
.st-cal-months{display:flex;flex-direction:column;gap:28px;padding:4px 0}
    .st-cal-month{display:flex;flex-direction:column;gap:0}
    .st-cal-mhd{display:flex;align-items:baseline;justify-content:space-between;
      margin-bottom:10px;padding:0 2px}
    .st-cal-mname{font-size:13px;font-weight:800;color:var(--st-t1)}
    .st-cal-mtotal{font-size:12px;font-weight:700;font-family:monospace}
    .st-cal-grid{
      display:grid;
      grid-template-columns:repeat(7,1fr);
      gap:4px;
    }
    .st-cal-dow{
      font-size:10px;font-weight:700;color:var(--st-t3);
      text-align:center;padding-bottom:6px;text-transform:uppercase;letter-spacing:.5px;
    }
    .st-cal-empty{min-height:52px}
    .st-cal-day{
      min-height:52px;border-radius:6px;padding:6px 6px 4px;
      display:flex;flex-direction:column;justify-content:space-between;
      cursor:default;transition:opacity .12s;position:relative;
      background:rgba(255,255,255,.04);
    }
    .st-cal-day:hover{opacity:.85}
    .st-cal-today{outline:2px solid rgba(59,130,246,.7);outline-offset:-1px}
    .st-cal-num{
      font-size:12px;font-weight:700;color:var(--st-t2);line-height:1;
      align-self:flex-start;
    }
    .st-cal-win .st-cal-num{color:rgba(255,255,255,.7)}
    .st-cal-loss .st-cal-num{color:rgba(255,255,255,.7)}
    .st-cal-pnl{
      font-size:11px;font-weight:800;font-family:monospace;
      color:#fff;line-height:1;align-self:flex-end;text-align:right;
      text-shadow:0 1px 3px rgba(0,0,0,.5);
    }
