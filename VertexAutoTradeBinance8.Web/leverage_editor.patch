+    // ── Leverage editor ─────────────────────────────────────────
+    PosRow? _posLevPos;
+    int _posLevVal, _posLevMax = 125;
+    bool _posLevSaving;
+    string _posLevErr = "";
+
+    async Task OpenLevEditorPos(PosRow p)
+    {
+        _posLevPos = p; _posLevVal = p.Leverage; _posLevErr = ""; _posLevMax = 125;
+        try
+        {
+            var c = Factory.TryCreateRestClient();
+            if (c != null)
+            {
+                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+                var br = await c.UsdFuturesApi.Account.GetBracketsAsync(p.Symbol, ct: cts.Token);
+                if (br.Success && br.Data != null)
+                {
+                    var s = br.Data.FirstOrDefault(b => b.Symbol == p.Symbol);
+                    if (s?.Brackets?.Length > 0) _posLevMax = s.Brackets.Max(b => b.InitialLeverage);
+                }
+            }
+        }
+        catch { }
+        StateHasChanged();
+    }
+
+    void OnPosLevInput(ChangeEventArgs e)
+        => _posLevVal = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 1, _posLevMax) : _posLevVal;
+
+    async Task SaveLevPos()
+    {
+        if (_posLevPos == null) return;
+        _posLevSaving = true; _posLevErr = ""; StateHasChanged();
+        try
+        {
+            var c = Factory.TryCreateRestClient();
+            if (c == null) { _posLevErr = "No API credentials"; return; }
+            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+            var r = await c.UsdFuturesApi.Account.ChangeInitialLeverageAsync(_posLevPos.Symbol, _posLevVal, ct: cts.Token);
+            if (r.Success)
+            {
+                var sym = _posLevPos.Symbol; var side = _posLevPos.Side; var lev = _posLevVal;
+                _positions = _positions.Select(p => p.Symbol == sym && p.Side == side ? p with { Leverage = lev } : p).ToList();
+                _posLevPos = null;
+            }
+            else _posLevErr = r.Error?.Message ?? "Failed";
+        }
+        catch (Exception ex) { _posLevErr = ex.Message; }
+        finally { _posLevSaving = false; StateHasChanged(); }
+    }
