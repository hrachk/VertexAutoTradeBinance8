    // FIX: LivePnlService calls its own AccountStateController
    // (/api/state/positions) over HTTP rather than in-process, using
    // an HttpClient whose BaseAddress falls back to
    // "http://localhost:5253" in code (Program.cs) when this key is
    // absent. 5253 is leftover from launchSettings.json's dev-only
    // "http" launch profile — nothing in this real deployment listens
    // there. The actual Kestrel port is 5101 (set above), so without
    // this explicit override every LivePnlService poll (every ~900ms)
    // was failing with "actively refused", flooding the log with
    // SocketException stack traces and leaving Open Positions PnL data
    // permanently empty.
    "ApiBaseUrl": "http://127.0.0.1:5101",
  


