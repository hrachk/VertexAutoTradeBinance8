@using VertexAutoTradeBinance8.Web.Services.Auth
@inject AuthSessionService Auth
@inject NavigationManager Nav

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Не найдено · Vertex AI</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div style="display:flex;flex-direction:column;align-items:center;
                        justify-content:center;min-height:60vh;gap:12px;color:#6e90b2;">
                <div style="font-size:48px;">404</div>
                <div style="font-size:18px;font-weight:700;color:#f0f6ff;">Страница не найдена</div>
                <a href="/market" style="color:#3b82f6;">← На Market</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
