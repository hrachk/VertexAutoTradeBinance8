     // ── State ─────────────────────────────────────────────────
+    // ── Live prices (from SignalR) ───────────────────────────
+    readonly Dictionary<string, decimal> _livePrices = new();
+    readonly Dictionary<string, List<decimal>> _sparklines = new();
+    const int SparkMax = 60; // last 60 live ticks per symbol
+
+    decimal GetLivePrice(string sym)
+        => _livePrices.TryGetValue(sym, out var p) ? p : 0m;
+
+    List<decimal> GetSparkline(string sym)
+        => _sparklines.TryGetValue(sym, out var s) ? s : new();
+
+    void OnLivePriceTick(string sym, decimal price)
+    {
+        _livePrices[sym] = price;
+        if (!_sparklines.ContainsKey(sym))
+            _sparklines[sym] = new List<decimal>();
+        var s = _sparklines[sym];
+        s.Add(price);
+        if (s.Count > SparkMax) s.RemoveAt(0);
+        // Only re-render if this symbol is in open positions
+        if (_positions.Any(p => p.Symbol == sym))
+            _ = InvokeAsync(StateHasChanged);
+    }
+
