# Переменные окружения (альтернатива appsettings.Local.json). Двойное подчёркивание = секция.
Binance__ApiKey=PASTE_NEW_KEY
Binance__SecretKey=PASTE_NEW_SECRET
# Live | Testnet | Demo
Binance__Environment=Testnet
# Общая папка данных бота и Web (по умолчанию C:\VertexShared / ~/VertexShared)
VERTEX_DATA_DIR=C:\VertexShared
# Пароль входа в Web-терминал
Web__AccessKey=change-me-long-random
# Токен для торговых эндпоинтов API (X-Vertex-Token)
Api__Token=change-me-long-random-24+
